{
  "schemaVersion": 1,
  "id": "m08-opening-ceremony",
  "moduleId": "M08",
  "title": "M8_09 — Opening Ceremony",
  "locationId": "world_main_arena",
  "entryNodeId": "ceremony_entry",
  "conditions": {
    "all": [
      {
        "path": "world.flags.m7_complete",
        "eq": true
      },
      {
        "path": "world.flags.m08_unlocked",
        "eq": true
      },
      {
        "path": "world.flags.world_qualified",
        "eq": true
      },
      {
        "path": "world.flags.m8_active",
        "eq": true
      },
      {
        "path": "world.flags.m8_world_registration_complete",
        "eq": true
      },
      {
        "path": "world.flags.m8_world_village_arrived",
        "eq": true
      },
      {
        "path": "world.flags.m8_media_day_complete",
        "eq": true
      }
    ]
  },
  "nodes": {
    "ceremony_entry": {
      "stitches": [
        {
          "id": "s1",
          "text": "Le luci si abbassano nell'arena e un applauso attraversa gli spalti. Atleti, staff e pubblico guardano lo stesso palco, ciascuno con aspettative differenti."
        }
      ],
      "choices": [
        {
          "id": "entry_hub",
          "text": "Entro nella cerimonia.",
          "goto": "ceremony_hub"
        },
        {
          "id": "entry_field",
          "text": "Osservo il field senza anticipare il draw.",
          "goto": "field_view"
        },
        {
          "id": "entry_rules",
          "text": "Rileggo cosa la cerimonia non può decidere.",
          "goto": "rules_guard"
        }
      ]
    },
    "ceremony_hub": {
      "stitches": [
        {
          "id": "s1",
          "text": "Puoi osservare gli allenatori, ascoltare i discorsi ufficiali o restare in disparte per concentrarti sui prossimi giorni."
        }
      ],
      "choices": [
        {
          "id": "hub_field",
          "text": "Osservo il field qualificato.",
          "goto": "field_view"
        },
        {
          "id": "hub_astrid",
          "text": "Guardo come viene presentata Astrid.",
          "goto": "astrid_view"
        },
        {
          "id": "hub_friends",
          "text": "Controllo come appaiono i rapporti personali in questo contesto.",
          "goto": "friend_view"
        }
      ]
    },
    "field_view": {
      "stitches": [
        {
          "id": "s1",
          "text": "Fra le delegazioni riconosci volti e simboli di molte regioni. Nessuno sa ancora chi finirà nel tuo gruppo."
        }
      ],
      "choices": [
        {
          "id": "field_stage",
          "text": "Seguo la presentazione sul palco.",
          "goto": "stage"
        },
        {
          "id": "field_draw",
          "text": "Controllo il confine fra field e sorteggio.",
          "goto": "draw_guard"
        }
      ]
    },
    "friend_view": {
      "stitches": [
        {
          "id": "s1",
          "text": "Cerchi fra i partecipanti qualcuno degli amici. Se è qui può avere i propri impegni; se non c'è, una cerimonia non lo farà apparire."
        }
      ],
      "choices": [
        {
          "id": "friend_media",
          "text": "Ricollego il momento al Media Day.",
          "goto": "media_view"
        },
        {
          "id": "friend_hub",
          "text": "Torno alla cerimonia.",
          "goto": "ceremony_hub"
        }
      ]
    },
    "astrid_view": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il presentatore annuncia Astrid Vahl come campionessa in carica. Lei saluta con sobrietà: quest'anno dovrà guadagnarsi ogni partita come gli altri."
        }
      ],
      "choices": [
        {
          "id": "astrid_stage",
          "text": "Torno alla presentazione centrale.",
          "goto": "stage"
        },
        {
          "id": "astrid_guard",
          "text": "Rivedo il guardrail competitivo.",
          "goto": "rules_guard"
        }
      ]
    },
    "media_view": {
      "stitches": [
        {
          "id": "s1",
          "text": "Telecamere e fotografi seguono i volti dei partecipanti. La luce dei riflettori rende il momento più solenne, non decide le gare."
        }
      ],
      "choices": [
        {
          "id": "media_stage",
          "text": "Torno al palco.",
          "goto": "stage"
        },
        {
          "id": "media_hub",
          "text": "Torno alla cerimonia.",
          "goto": "ceremony_hub"
        }
      ]
    },
    "rules_guard": {
      "stitches": [
        {
          "id": "s1",
          "text": "La cerimonia presenta il torneo e le sue regole. Gli abbinamenti arriveranno soltanto con il sorteggio."
        }
      ],
      "choices": [
        {
          "id": "rules_draw",
          "text": "Passo al guardrail del sorteggio.",
          "goto": "draw_guard"
        },
        {
          "id": "rules_hub",
          "text": "Torno alla cerimonia.",
          "goto": "ceremony_hub"
        }
      ]
    },
    "draw_guard": {
      "stitches": [
        {
          "id": "s1",
          "text": "I grandi schermi mostrano il numero dei gruppi ancora vuoti. I nomi verranno assegnati nel prossimo evento ufficiale."
        }
      ],
      "choices": [
        {
          "id": "draw_commit",
          "text": "Sono pronto a chiudere la cerimonia senza inventare il draw.",
          "goto": "ceremony_commit"
        },
        {
          "id": "draw_field",
          "text": "Torno a osservare il field.",
          "goto": "field_view"
        }
      ]
    },
    "stage": {
      "stitches": [
        {
          "id": "s1",
          "text": "Dal palco si parla delle regioni rappresentate e del percorso fatto dai qualificati. Nessuno pronuncia già il nome del prossimo campione."
        }
      ],
      "choices": [
        {
          "id": "stage_wait",
          "text": "Resto fino alla fine della finestra pubblica.",
          "goto": "wait_window"
        },
        {
          "id": "stage_commit",
          "text": "Passo alla chiusura della cerimonia.",
          "goto": "ceremony_commit"
        }
      ]
    },
    "wait_window": {
      "stitches": [
        {
          "id": "s1",
          "text": "Segui la cerimonia fino alla fine. Passa mezz'ora mentre gli atleti rientrano alle rispettive attività."
        }
      ],
      "choices": [
        {
          "id": "wait_half",
          "text": "Lascio passare mezz'ora e torno al palco.",
          "goto": "stage",
          "timeCostMinutes": 30
        },
        {
          "id": "wait_commit",
          "text": "Chiudo la cerimonia ora.",
          "goto": "ceremony_commit"
        }
      ]
    },
    "ceremony_commit": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il presentatore ringrazia il pubblico. Le delegazioni lasciano il palco e attendono il sorteggio."
        }
      ],
      "choices": [
        {
          "id": "commit_now",
          "text": "Registro la cerimonia d'apertura.",
          "goto": "ceremony_close",
          "effects": [
            {
              "type": "set_flag",
              "key": "m8_opening_ceremony_complete",
              "value": true
            }
          ]
        },
        {
          "id": "commit_review",
          "text": "Rivedo il confine con il sorteggio.",
          "goto": "draw_guard"
        }
      ]
    },
    "ceremony_close": {
      "stitches": [
        {
          "id": "s1",
          "text": "Si riaccendono le luci. Il prossimo appuntamento stabilirà finalmente i gruppi."
        }
      ],
      "choices": [
        {
          "id": "close_draw",
          "text": "Passo al WORLD_DRAW canonico.",
          "goto": "m08-world-draw#draw_entry"
        },
        {
          "id": "close_hub",
          "text": "Resto nell'area del venue senza generare il sorteggio.",
          "goto": "m08-world-village#village_hub"
        }
      ]
    }
  }
}
