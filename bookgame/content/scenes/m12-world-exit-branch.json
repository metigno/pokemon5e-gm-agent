{
  "schemaVersion": 1,
  "id": "m12-world-exit-branch",
  "moduleId": "M12",
  "title": "M12_00 — World Exit Branch",
  "locationId": "world_village",
  "entryNodeId": "world_exit_entry",
  "conditions": {
    "all": [
      {
        "path": "world.flags.m12_unlocked",
        "eq": true
      },
      {
        "any": [
          {
            "path": "world.flags.world_champion",
            "eq": true
          },
          {
            "path": "world.flags.world_eliminated",
            "eq": true
          },
          {
            "path": "world.flags.worlds_missed",
            "eq": true
          }
        ]
      }
    ]
  },
  "nodes": {
    "world_exit_entry": {
      "stitches": [
        {
          "id": "s1",
          "text": "L'ultima giornata di questa stagione è finita, per te o per il torneo stesso. I corridoi conducono tutti fuori dallo stadio, ma non raccontano la stessa storia a chi li attraversa."
        }
      ],
      "choices": [
        {
          "id": "enter_champion",
          "text": "Lascio lo stadio con il titolo mondiale.",
          "goto": "route_champion",
          "conditions": {
            "path": "world.flags.world_champion",
            "eq": true
          }
        },
        {
          "id": "enter_eliminated",
          "text": "Lascio lo stadio ripensando alla partita che mi ha fermato.",
          "goto": "route_eliminated",
          "conditions": {
            "path": "world.flags.world_eliminated",
            "eq": true
          }
        },
        {
          "id": "enter_missed",
          "text": "Riparto dopo aver mancato la qualificazione.",
          "goto": "route_missed",
          "conditions": {
            "path": "world.flags.worlds_missed",
            "eq": true
          }
        },
        {
          "id": "context_1",
          "text": "Confronto questo dettaglio con un altro pezzo del percorso.",
          "goto": "route_eliminated"
        }
      ]
    },
    "route_champion": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il tuo nome rimane sull'albo d'oro. La coppa attira sguardi diversi; qualcuno vuole congratularsi, qualcun altro vuole soltanto capire come hai vinto. Non sei obbligato a sentirti come gli altri si aspettano."
        }
      ],
      "choices": [
        {
          "id": "champion_accept",
          "text": "Registro il ramo World Champion senza riscrivere E5.",
          "goto": "result_integrity",
          "effects": [
            {
              "type": "set_flag",
              "key": "m12_world_exit_route",
              "value": "world_champion"
            }
          ]
        },
        {
          "id": "champion_record",
          "text": "Controllo il record prima di partire.",
          "goto": "world_record"
        },
        {
          "id": "context_2",
          "text": "Confronto questo dettaglio con un altro pezzo del percorso.",
          "goto": "result_integrity"
        }
      ]
    },
    "route_eliminated": {
      "stitches": [
        {
          "id": "s1",
          "text": "Se sei stato eliminato durante il Mondiale, il referto conserva il turno preciso in cui la corsa si è interrotta. Puoi lasciare l'arena alle spalle senza fingere che quell'incontro sia finito diversamente."
        }
      ],
      "choices": [
        {
          "id": "eliminated_accept",
          "text": "Registro il ramo Eliminated mantenendo il round reale.",
          "goto": "result_integrity",
          "effects": [
            {
              "type": "set_flag",
              "key": "m12_world_exit_route",
              "value": "world_eliminated"
            }
          ]
        },
        {
          "id": "eliminated_record",
          "text": "Controllo il record prima di partire.",
          "goto": "world_record"
        },
        {
          "id": "context_3",
          "text": "Confronto questo dettaglio con un altro pezzo del percorso.",
          "goto": "roster_state"
        }
      ]
    },
    "route_missed": {
      "stitches": [
        {
          "id": "s1",
          "text": "Hai seguito il Mondiale da fuori. La tua stagione ha preso un'altra direzione; i risultati degli altri sono reali, ma non diventano ricordi di incontri che non hai disputato."
        }
      ],
      "choices": [
        {
          "id": "missed_accept",
          "text": "Registro Worlds Missed senza inventare risultati.",
          "goto": "result_integrity",
          "effects": [
            {
              "type": "set_flag",
              "key": "m12_world_exit_route",
              "value": "worlds_missed"
            }
          ]
        },
        {
          "id": "missed_world",
          "text": "Controllo cosa è successo nel mondo mentre il circuito proseguiva.",
          "goto": "e6_contract"
        }
      ]
    },
    "result_integrity": {
      "stitches": [
        {
          "id": "s1",
          "text": "Le classifiche restano esposte all'uscita. Ogni riga ha un avversario, una giornata e un risultato. Nessuna versione più comoda prenderà il posto di questi fatti."
        }
      ],
      "choices": [
        {
          "id": "continue",
          "text": "Proseguo seguendo questo filo.",
          "goto": "world_record"
        },
        {
          "id": "review",
          "text": "Rileggo il passaggio collegato.",
          "goto": "route_missed"
        }
      ]
    },
    "world_record": {
      "stitches": [
        {
          "id": "s1",
          "text": "Sfogli il giornale sportivo: accanto alle tue partite ci sono quelle disputate quando eri altrove. Anche il torneo ha avuto una vita fuori dal tuo sguardo."
        }
      ],
      "choices": [
        {
          "id": "continue",
          "text": "Proseguo seguendo questo filo.",
          "goto": "roster_state"
        },
        {
          "id": "review",
          "text": "Rileggo il passaggio collegato.",
          "goto": "result_integrity"
        }
      ]
    },
    "roster_state": {
      "stitches": [
        {
          "id": "s1",
          "text": "Raccogli l'equipaggiamento e controlli i Pokémon. Alcuni hanno ancora addosso i segni dell'ultima sfida; nessun addetto li farà sparire soltanto perché state partendo."
        }
      ],
      "choices": [
        {
          "id": "continue",
          "text": "Proseguo seguendo questo filo.",
          "goto": "resource_state"
        },
        {
          "id": "review",
          "text": "Rileggo il passaggio collegato.",
          "goto": "world_record"
        }
      ]
    },
    "resource_state": {
      "stitches": [
        {
          "id": "s1",
          "text": "Riconti le monete rimaste e sistemi l'inventario. I biglietti, le cure e le decisioni prese lungo il viaggio hanno avuto un costo."
        }
      ],
      "choices": [
        {
          "id": "continue",
          "text": "Proseguo seguendo questo filo.",
          "goto": "npc_state"
        },
        {
          "id": "review",
          "text": "Rileggo il passaggio collegato.",
          "goto": "roster_state"
        }
      ]
    },
    "npc_state": {
      "stitches": [
        {
          "id": "s1",
          "text": "Cerchi i volti conosciuti tra la folla. Non tutti sono ancora qui: c'è chi è già partito, chi sta lavorando e chi preferisce rispondere a distanza."
        }
      ],
      "choices": [
        {
          "id": "continue",
          "text": "Proseguo seguendo questo filo.",
          "goto": "quest_state"
        },
        {
          "id": "review",
          "text": "Rileggo il passaggio collegato.",
          "goto": "resource_state"
        }
      ]
    },
    "quest_state": {
      "stitches": [
        {
          "id": "s1",
          "text": "Le notizie delle regioni attraversate continuano ad arrivare. Alcuni problemi sono stati risolti, altri sono peggiorati e qualcun altro ha dovuto scegliere quando tu eri lontano."
        }
      ],
      "choices": [
        {
          "id": "continue",
          "text": "Proseguo seguendo questo filo.",
          "goto": "reputation"
        },
        {
          "id": "review",
          "text": "Rileggo il passaggio collegato.",
          "goto": "npc_state"
        }
      ]
    },
    "reputation": {
      "stitches": [
        {
          "id": "s1",
          "text": "Qualcuno riconosce il tuo volto e reagisce al risultato mondiale. In un altro luogo, però, potrebbero ricordarsi soprattutto ciò che hai fatto per loro quando non c'erano telecamere."
        }
      ],
      "choices": [
        {
          "id": "continue",
          "text": "Proseguo seguendo questo filo.",
          "goto": "no_hierarchy"
        },
        {
          "id": "review",
          "text": "Rileggo il passaggio collegato.",
          "goto": "quest_state"
        }
      ]
    },
    "no_hierarchy": {
      "stitches": [
        {
          "id": "s1",
          "text": "Vincere il trofeo, perdere un turno decisivo o non qualificarsi significa tornare con storie diverse. Nessuna autorizza il mondo a riscrivere il valore delle tue decisioni."
        }
      ],
      "choices": [
        {
          "id": "continue",
          "text": "Proseguo seguendo questo filo.",
          "goto": "travel_decision"
        },
        {
          "id": "review",
          "text": "Rileggo il passaggio collegato.",
          "goto": "reputation"
        }
      ]
    },
    "travel_decision": {
      "stitches": [
        {
          "id": "s1",
          "text": "La direzione è chiara: Asteria. Devi ancora scegliere come organizzare il ritorno; nessuna cerimonia può percorrere la strada al tuo posto."
        }
      ],
      "choices": [
        {
          "id": "continue",
          "text": "Proseguo seguendo questo filo.",
          "goto": "callback_contract"
        },
        {
          "id": "review",
          "text": "Rileggo il passaggio collegato.",
          "goto": "no_hierarchy"
        }
      ]
    },
    "callback_contract": {
      "stitches": [
        {
          "id": "s1",
          "text": "Al ritorno troverai persone che sanno cosa hai fatto e persone che non lo sanno. Non tutte avranno dimenticato un favore, una promessa o un'assenza."
        }
      ],
      "choices": [
        {
          "id": "continue",
          "text": "Proseguo seguendo questo filo.",
          "goto": "time_passage"
        },
        {
          "id": "review",
          "text": "Rileggo il passaggio collegato.",
          "goto": "travel_decision"
        }
      ]
    },
    "time_passage": {
      "stitches": [
        {
          "id": "s1",
          "text": "Partire richiede ore. Mentre viaggi, i negozi aprono e chiudono, gli allenatori si spostano e le notizie continuano a circolare."
        }
      ],
      "choices": [
        {
          "id": "continue",
          "text": "Proseguo seguendo questo filo.",
          "goto": "e6_contract"
        },
        {
          "id": "review",
          "text": "Rileggo il passaggio collegato.",
          "goto": "callback_contract"
        }
      ]
    },
    "e6_contract": {
      "stitches": [
        {
          "id": "s1",
          "text": "Le città non sono rimaste in attesa del tuo rientro. Se un problema è cambiato in tua assenza, ne vedrai i segni quando arriverai."
        }
      ],
      "choices": [
        {
          "id": "continue",
          "text": "Proseguo seguendo questo filo.",
          "goto": "commit_guard"
        },
        {
          "id": "review",
          "text": "Rileggo il passaggio collegato.",
          "goto": "time_passage"
        }
      ]
    },
    "commit_guard": {
      "stitches": [
        {
          "id": "s1",
          "text": "Al banco partenze riconsegni l'accredito. La persona dall'altra parte controlla il nominativo e ti indica la via d'uscita."
        }
      ],
      "choices": [
        {
          "id": "commit_now",
          "text": "Riconsegno l'accredito e preparo il viaggio di ritorno.",
          "goto": "committed",
          "conditions": {
            "path": "world.flags.m12_world_exit_branch_complete",
            "ne": true
          },
          "effects": [
            {
              "type": "set_flag",
              "key": "m12_world_exit_branch_complete",
              "value": true
            },
            {
              "type": "set_flag",
              "key": "m12_world_exit_resolved",
              "value": true
            },
            {
              "type": "set_flag",
              "key": "m12_active",
              "value": true
            }
          ]
        },
        {
          "id": "commit_existing",
          "text": "Ho già riconsegnato l'accredito: posso partire.",
          "goto": "committed",
          "conditions": {
            "path": "world.flags.m12_world_exit_branch_complete",
            "eq": true
          }
        }
      ]
    },
    "committed": {
      "stitches": [
        {
          "id": "s1",
          "text": "La porta si apre sul traffico dei viaggiatori. Ora il Mondiale è qualcosa che ti porti dietro, non il posto in cui devi rimanere."
        }
      ],
      "choices": [
        {
          "id": "to_handoff",
          "text": "Preparo il ritorno ad Asteria.",
          "goto": "handoff"
        },
        {
          "id": "audit_resources",
          "text": "Ripenso alle conseguenze delle mie scelte.",
          "goto": "resource_state"
        }
      ]
    },
    "handoff": {
      "stitches": [
        {
          "id": "s1",
          "text": "Davanti a te c'è il viaggio verso Asteria: stessa squadra, relazioni non sempre semplici e un mondo che ha continuato a muoversi."
        }
      ],
      "choices": [
        {
          "id": "return_asteria",
          "text": "Lascio il circuito mondiale e inizio il viaggio.",
          "goto": "m12-return-asteria#return_entry"
        },
        {
          "id": "last_world_review",
          "text": "Ripercorro un'ultima volta il congedo dal Mondiale.",
          "goto": "result_integrity"
        }
      ]
    }
  }
}
