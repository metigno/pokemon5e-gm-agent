{
  "schemaVersion": 1,
  "id": "m08-friend-beat-08",
  "moduleId": "M08",
  "title": "M8_06 — Friend Beat 08",
  "locationId": "world_village",
  "entryNodeId": "friend_entry",
  "conditions": {
    "all": [
      {
        "path": "world.flags.m7_complete",
        "eq": true
      },
      {
        "path": "world.flags.m08_unlocked",
        "eq": true
      },
      {
        "path": "world.flags.world_qualified",
        "eq": true
      },
      {
        "path": "world.flags.m8_active",
        "eq": true
      },
      {
        "path": "world.flags.m8_world_registration_complete",
        "eq": true
      },
      {
        "path": "world.flags.m8_world_village_arrived",
        "eq": true
      },
      {
        "path": "world.flags.astrid_met",
        "eq": true
      },
      {
        "path": "world.flags.friend_beat_08_available",
        "eq": true
      }
    ]
  },
  "nodes": {
    "friend_entry": {
      "stitches": [
        {
          "id": "s1",
          "text": "Nel World Village, o attraverso lo schermo di un telefono, riesci a sentire uno degli amici. La distanza fra le vostre carriere si nota più che mai."
        }
      ],
      "choices": [
        {
          "id": "entry_status",
          "text": "Controllo chi è stato selezionato e in quale modalità.",
          "goto": "selector_status"
        },
        {
          "id": "entry_contact",
          "text": "Apro il contatto disponibile.",
          "goto": "dispatch"
        }
      ]
    },
    "selector_status": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il nome di {{world.flags.friend_beat_08_friend_id}} compare sul display. La voce è la stessa delle prime strade, anche se intorno a voi il mondo è diventato molto più grande."
        }
      ],
      "choices": [
        {
          "id": "status_dispatch",
          "text": "Passo al contatto selezionato.",
          "goto": "dispatch"
        },
        {
          "id": "status_callback",
          "text": "Rivedo la continuità dei Friend Beat.",
          "goto": "callback"
        },
        {
          "id": "status_wait",
          "text": "Posso scegliere quando rispondere al contatto.",
          "goto": "wait_contact"
        }
      ]
    },
    "dispatch": {
      "stitches": [
        {
          "id": "s1",
          "text": "Aprite il discorso dal punto in cui lo avevate lasciato, non da una presentazione formale. Nessuno deve fingere di aver seguito ogni minuto della stagione altrui."
        }
      ],
      "choices": [
        {
          "id": "dispatch_luke",
          "text": "Rispondo a Luke.",
          "goto": "luke_contact",
          "conditions": {
            "path": "world.flags.friend_beat_08_friend_id",
            "eq": "Luke"
          }
        },
        {
          "id": "dispatch_mattew",
          "text": "Rispondo a Mattew.",
          "goto": "mattew_contact",
          "conditions": {
            "path": "world.flags.friend_beat_08_friend_id",
            "eq": "Mattew"
          }
        },
        {
          "id": "dispatch_daniel",
          "text": "Rispondo a Daniel.",
          "goto": "daniel_contact",
          "conditions": {
            "path": "world.flags.friend_beat_08_friend_id",
            "eq": "Daniel"
          }
        },
        {
          "id": "dispatch_edward",
          "text": "Rispondo a Edward.",
          "goto": "edward_contact",
          "conditions": {
            "path": "world.flags.friend_beat_08_friend_id",
            "eq": "Edward"
          }
        },
        {
          "id": "dispatch_fab",
          "text": "Rispondo a Fab.",
          "goto": "fab_contact",
          "conditions": {
            "path": "world.flags.friend_beat_08_friend_id",
            "eq": "Fab"
          }
        }
      ]
    },
    "luke_contact": {
      "stitches": [
        {
          "id": "s1",
          "text": "«Bel posto, eh?» Luke guarda verso i campi. «Tutta questa gente importante che ti spiega cosa dovresti usare. Io rimango con i miei. Se vogliono fermarmi, si facciano avanti.»"
        }
      ],
      "choices": [
        {
          "id": "luke_physical",
          "text": "Parliamo di persona nel World Village.",
          "goto": "physical_context",
          "conditions": {
            "path": "world.flags.friend_beat_08_contact_mode",
            "eq": "physical"
          },
          "effects": [
            {
              "type": "npc_relationship_adjust",
              "npcId": "Luke",
              "delta": 1
            }
          ]
        },
        {
          "id": "luke_remote",
          "text": "Parliamo a distanza.",
          "goto": "remote_context",
          "conditions": {
            "path": "world.flags.friend_beat_08_contact_mode",
            "eq": "remote"
          },
          "effects": [
            {
              "type": "npc_relationship_adjust",
              "npcId": "Luke",
              "delta": 1
            }
          ]
        }
      ]
    },
    "mattew_contact": {
      "stitches": [
        {
          "id": "s1",
          "text": "Mattew sta sistemando gli appunti accanto a Eevee. «La cosa divertente è che tutti parlano del sorteggio come se lo conoscessero già.» Sorride. «Aspetto almeno che escano i nomi prima di preoccuparmi seriamente.»"
        }
      ],
      "choices": [
        {
          "id": "mattew_physical",
          "text": "Parliamo di persona nel World Village.",
          "goto": "physical_context",
          "conditions": {
            "path": "world.flags.friend_beat_08_contact_mode",
            "eq": "physical"
          },
          "effects": [
            {
              "type": "npc_relationship_adjust",
              "npcId": "Mattew",
              "delta": 1
            }
          ]
        },
        {
          "id": "mattew_remote",
          "text": "Parliamo a distanza.",
          "goto": "remote_context",
          "conditions": {
            "path": "world.flags.friend_beat_08_contact_mode",
            "eq": "remote"
          },
          "effects": [
            {
              "type": "npc_relationship_adjust",
              "npcId": "Mattew",
              "delta": 1
            }
          ]
        }
      ]
    },
    "daniel_contact": {
      "stitches": [
        {
          "id": "s1",
          "text": "«Non chiamare destino ciò che ancora non sai», dice Daniel. «È soltanto un sorteggio.» Poi aggiunge, con una calma sospetta: «Però se finisci nel mio gruppo, prometto di non ridere troppo.»"
        }
      ],
      "choices": [
        {
          "id": "daniel_physical",
          "text": "Parliamo di persona nel World Village.",
          "goto": "physical_context",
          "conditions": {
            "path": "world.flags.friend_beat_08_contact_mode",
            "eq": "physical"
          },
          "effects": [
            {
              "type": "npc_relationship_adjust",
              "npcId": "Daniel",
              "delta": 1
            }
          ]
        },
        {
          "id": "daniel_remote",
          "text": "Parliamo a distanza.",
          "goto": "remote_context",
          "conditions": {
            "path": "world.flags.friend_beat_08_contact_mode",
            "eq": "remote"
          },
          "effects": [
            {
              "type": "npc_relationship_adjust",
              "npcId": "Daniel",
              "delta": 1
            }
          ]
        }
      ]
    },
    "edward_contact": {
      "stitches": [
        {
          "id": "s1",
          "text": "Edward si sistema la giacca davanti a un riflesso. «Se devo farmi vedere da mezzo mondo, tanto vale farlo bene.» Un Pokémon lo strattona fuori inquadratura. «Ehi! Aspetta il tuo turno.»"
        }
      ],
      "choices": [
        {
          "id": "edward_physical",
          "text": "Parliamo di persona nel World Village.",
          "goto": "physical_context",
          "conditions": {
            "path": "world.flags.friend_beat_08_contact_mode",
            "eq": "physical"
          },
          "effects": [
            {
              "type": "npc_relationship_adjust",
              "npcId": "Edward",
              "delta": 1
            }
          ]
        },
        {
          "id": "edward_remote",
          "text": "Parliamo a distanza.",
          "goto": "remote_context",
          "conditions": {
            "path": "world.flags.friend_beat_08_contact_mode",
            "eq": "remote"
          },
          "effects": [
            {
              "type": "npc_relationship_adjust",
              "npcId": "Edward",
              "delta": 1
            }
          ]
        }
      ]
    },
    "fab_contact": {
      "stitches": [
        {
          "id": "s1",
          "text": "Fab è con Koffing e sembra più interessato a impedirgli di infilarsi nella borsa che al pass per il Village. «Se mi chiedono un'intervista, mando lui. Almeno sarà sincero.»"
        }
      ],
      "choices": [
        {
          "id": "fab_physical",
          "text": "Parliamo di persona nel World Village.",
          "goto": "physical_context",
          "conditions": {
            "path": "world.flags.friend_beat_08_contact_mode",
            "eq": "physical"
          },
          "effects": [
            {
              "type": "npc_relationship_adjust",
              "npcId": "Fab",
              "delta": 1
            }
          ]
        },
        {
          "id": "fab_remote",
          "text": "Parliamo a distanza.",
          "goto": "remote_context",
          "conditions": {
            "path": "world.flags.friend_beat_08_contact_mode",
            "eq": "remote"
          },
          "effects": [
            {
              "type": "npc_relationship_adjust",
              "npcId": "Fab",
              "delta": 1
            }
          ]
        }
      ]
    },
    "physical_context": {
      "stitches": [
        {
          "id": "s1",
          "text": "Se vi incontrate di persona, le battute arrivano fra il passaggio degli altri concorrenti. Stare nello stesso Village non significa sapere chi incontrerete nel girone."
        }
      ],
      "choices": [
        {
          "id": "physical_world",
          "text": "Parliamo di cosa cambia entrando nel venue.",
          "goto": "world_talk",
          "effects": [
            {
              "type": "set_flag",
              "key": "friend_beat_08_type",
              "value": "physical_world_village"
            }
          ]
        },
        {
          "id": "physical_pressure",
          "text": "Parliamo della pressione prima del draw.",
          "goto": "shared_pressure",
          "effects": [
            {
              "type": "set_flag",
              "key": "friend_beat_08_type",
              "value": "physical_world_village"
            }
          ]
        },
        {
          "id": "physical_state",
          "text": "Confrontiamo solo ciò che sappiamo davvero delle nostre carriere.",
          "goto": "uncertain_friend",
          "effects": [
            {
              "type": "set_flag",
              "key": "friend_beat_08_type",
              "value": "physical_world_village"
            }
          ]
        }
      ]
    },
    "remote_context": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il display restituisce la faccia dell'amico e un pezzo della città in cui si trova. Non siete necessariamente tutti arrivati al Mondiale."
        }
      ],
      "choices": [
        {
          "id": "remote_world",
          "text": "Parliamo di cosa significa vivere questo momento da luoghi diversi.",
          "goto": "worlds_apart",
          "effects": [
            {
              "type": "set_flag",
              "key": "friend_beat_08_type",
              "value": "remote_world_contact"
            }
          ]
        },
        {
          "id": "remote_pressure",
          "text": "Parliamo della pressione a distanza.",
          "goto": "shared_pressure",
          "effects": [
            {
              "type": "set_flag",
              "key": "friend_beat_08_type",
              "value": "remote_world_contact"
            }
          ]
        },
        {
          "id": "remote_state",
          "text": "Gli chiedo soltanto come sta andando davvero.",
          "goto": "uncertain_friend",
          "effects": [
            {
              "type": "set_flag",
              "key": "friend_beat_08_type",
              "value": "remote_world_contact"
            }
          ]
        }
      ]
    },
    "world_talk": {
      "stitches": [
        {
          "id": "s1",
          "text": "Guardate il tabellone ancora incompleto. I nomi dei gruppi usciranno solo al sorteggio; per ora potete scherzare sui pronostici."
        }
      ],
      "choices": [
        {
          "id": "world_gap",
          "text": "Parliamo della differenza fra essere qui e sapere già cosa succederà.",
          "goto": "qualification_gap"
        },
        {
          "id": "world_pressure",
          "text": "Torniamo alla pressione condivisa.",
          "goto": "shared_pressure"
        }
      ]
    },
    "qualification_gap": {
      "stitches": [
        {
          "id": "s1",
          "text": "Essere qui e guardare il torneo da fuori sono due esperienze diverse. Il contatto non finge che tutti abbiano ricevuto lo stesso accredito."
        }
      ],
      "choices": [
        {
          "id": "gap_uncertain",
          "text": "Mantengo l'incertezza dove lo stato non è pubblico.",
          "goto": "uncertain_friend"
        },
        {
          "id": "gap_relationship",
          "text": "Parliamo del rapporto fra le nostre carriere separate.",
          "goto": "relationship"
        }
      ]
    },
    "shared_pressure": {
      "stitches": [
        {
          "id": "s1",
          "text": "Vi scambiate un consiglio e una presa in giro. La pressione resta quella reale di una gara che ancora non è cominciata."
        }
      ],
      "choices": [
        {
          "id": "pressure_relationship",
          "text": "Rispondo sul piano personale.",
          "goto": "relationship"
        },
        {
          "id": "pressure_callback",
          "text": "Ricollego il momento ai Friend Beat precedenti.",
          "goto": "callback"
        }
      ]
    },
    "uncertain_friend": {
      "stitches": [
        {
          "id": "s1",
          "text": "Se alcune notizie non sono ancora pubbliche, l'amico non le indovina. «Te lo dirò quando lo saprò anch'io» è una risposta possibile."
        }
      ],
      "choices": [
        {
          "id": "uncertain_world",
          "text": "Torniamo a ciò che sappiamo del Mondiale.",
          "goto": "world_talk"
        },
        {
          "id": "uncertain_pressure",
          "text": "Restiamo sulla pressione comune.",
          "goto": "shared_pressure"
        }
      ]
    },
    "worlds_apart": {
      "stitches": [
        {
          "id": "s1",
          "text": "Per qualche secondo vi accorgete di essere lontani. Una battuta alleggerisce la cosa, senza farla sparire."
        }
      ],
      "choices": [
        {
          "id": "apart_relationship",
          "text": "Parliamo di come restare in contatto senza sincronizzare le carriere.",
          "goto": "relationship"
        },
        {
          "id": "apart_world",
          "text": "Torniamo al tema del Mondiale.",
          "goto": "world_talk"
        }
      ]
    },
    "relationship": {
      "stitches": [
        {
          "id": "s1",
          "text": "La confidenza può rendere una provocazione affettuosa oppure fastidiosa. La vostra storia precedente decide come suona."
        }
      ],
      "choices": [
        {
          "id": "relationship_record",
          "text": "Registro il momento condiviso.",
          "goto": "result_record"
        },
        {
          "id": "relationship_more",
          "text": "Resto ancora sul tema della pressione.",
          "goto": "shared_pressure"
        }
      ]
    },
    "callback": {
      "stitches": [
        {
          "id": "s1",
          "text": "Un piccolo riferimento alle prime avventure basta per interrompere il tono solenne degli annunci. Era da tempo che non parlavate così."
        }
      ],
      "choices": [
        {
          "id": "callback_contact",
          "text": "Torno al contatto corrente.",
          "goto": "dispatch"
        },
        {
          "id": "callback_record",
          "text": "Chiudo il callback e registro il beat.",
          "goto": "result_record"
        }
      ]
    },
    "wait_contact": {
      "stitches": [
        {
          "id": "s1",
          "text": "Aspettare un'ora non significa trovare automaticamente l'amico lì dove vorresti. Ognuno ha ancora impegni propri."
        }
      ],
      "choices": [
        {
          "id": "wait_hour",
          "text": "Aspetto un'ora e ricontrollo il contatto.",
          "goto": "selector_status",
          "timeCostMinutes": 60
        },
        {
          "id": "wait_dispatch",
          "text": "Rispondo senza altra attesa.",
          "goto": "dispatch"
        }
      ]
    },
    "result_record": {
      "stitches": [
        {
          "id": "s1",
          "text": "Riagganci senza sapere più del sorteggio di quanto sia stato annunciato. La vostra conversazione non ha cambiato i partecipanti."
        }
      ],
      "choices": [
        {
          "id": "record_complete",
          "text": "Segno FRIEND_BEAT_08 come completato.",
          "goto": "friend_close",
          "effects": [
            {
              "type": "set_flag",
              "key": "friend_beat_08_complete",
              "value": true
            }
          ]
        }
      ]
    },
    "friend_close": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il corridoio conduce alla sala allenamento. Il Village continua a riempirsi di persone e possibilità."
        }
      ],
      "choices": [
        {
          "id": "close_training",
          "text": "Passo alla Training Hall.",
          "goto": "m08-training-hall#training_entry"
        }
      ]
    }
  }
}
