{
  "schemaVersion": 1,
  "id": "m08-world-arrival",
  "moduleId": "M08",
  "title": "M8_00 — World Arrival",
  "locationId": "meridiana_international_station",
  "entryNodeId": "world_entry",
  "conditions": {
    "all": [
      {
        "path": "world.flags.m7_complete",
        "eq": true
      },
      {
        "path": "world.flags.m08_unlocked",
        "eq": true
      },
      {
        "path": "world.flags.world_qualified",
        "eq": true
      },
      {
        "path": "world.flags.m7_before_lights_complete",
        "eq": true
      }
    ]
  },
  "nodes": {
    "world_entry": {
      "stitches": [
        {
          "id": "s1",
          "text": "Hai conquistato un posto al Mondiale e ora puoi presentarti al grande complesso internazionale. Al valico controllano la tua licenza e il documento di qualificazione."
        }
      ],
      "choices": [
        {
          "id": "activate_m8",
          "text": "Attivo M8 mantenendo intatto l'esito della qualificazione.",
          "goto": "handoff",
          "conditions": {
            "path": "world.flags.m8_active",
            "ne": true
          },
          "effects": [
            {
              "type": "set_flag",
              "key": "m8_active",
              "value": true
            }
          ]
        },
        {
          "id": "review_m8",
          "text": "M8 è già attivo: rivedo il passaggio verso il venue.",
          "goto": "handoff",
          "conditions": {
            "path": "world.flags.m8_active",
            "eq": true
          }
        }
      ]
    },
    "handoff": {
      "stitches": [
        {
          "id": "s1",
          "text": "Prima di partire guardi il calendario, i bagagli e le condizioni della squadra. Il nuovo viaggio porterà emozioni diverse, non una squadra nuova."
        }
      ],
      "choices": [
        {
          "id": "handoff_carry",
          "text": "Controllo lo stato ereditato.",
          "goto": "carryover"
        },
        {
          "id": "handoff_travel",
          "text": "Preparo il trasferimento internazionale.",
          "goto": "travel"
        },
        {
          "id": "handoff_preview",
          "text": "Guardo cosa mi aspetta al venue.",
          "goto": "venue_preview"
        }
      ]
    },
    "carryover": {
      "stitches": [
        {
          "id": "s1",
          "text": "Le Poké Ball, gli oggetti e i referti precedenti sono ancora con te. Nulla si rimette a posto soltanto attraversando il confine."
        }
      ],
      "choices": [
        {
          "id": "carry_history",
          "text": "Rivedo la storia competitiva che mi ha portato qui.",
          "goto": "history"
        },
        {
          "id": "carry_roster",
          "text": "Rivedo il roster senza modificarlo.",
          "goto": "roster"
        }
      ]
    },
    "history": {
      "stitches": [
        {
          "id": "s1",
          "text": "Nel dossier è riportato il modo in cui hai ottenuto il pass mondiale: Qualifier oppure ultima selezione. Non puoi scegliere una versione diversa della storia."
        }
      ],
      "choices": [
        {
          "id": "history_guard",
          "text": "Controllo il guardrail della qualificazione.",
          "goto": "qualification_guard"
        },
        {
          "id": "history_handoff",
          "text": "Torno al passaggio di modulo.",
          "goto": "handoff"
        }
      ]
    },
    "roster": {
      "stitches": [
        {
          "id": "s1",
          "text": "Controlli i Pokémon preparati per il viaggio. Chi è stanco o infortunato lo è ancora, anche lontano da Meridiana."
        }
      ],
      "choices": [
        {
          "id": "roster_medical",
          "text": "Controllo la continuità medica.",
          "goto": "medical_continuity"
        },
        {
          "id": "roster_handoff",
          "text": "Torno al passaggio di modulo.",
          "goto": "handoff"
        }
      ]
    },
    "qualification_guard": {
      "stitches": [
        {
          "id": "s1",
          "text": "La qualificazione ti concede l'ingresso fra i partecipanti. Non ti indica ancora il gruppo né promette una vittoria."
        }
      ],
      "choices": [
        {
          "id": "guard_credentials",
          "text": "Passo alle credenziali di ingresso.",
          "goto": "world_credentials"
        },
        {
          "id": "guard_handoff",
          "text": "Torno al riepilogo.",
          "goto": "handoff"
        }
      ]
    },
    "world_credentials": {
      "stitches": [
        {
          "id": "s1",
          "text": "L'organizzazione annuncia i controlli d'ingresso, la visita medica e la registrazione. Dovrai affrontarli come gli altri concorrenti."
        }
      ],
      "choices": [
        {
          "id": "credentials_travel",
          "text": "Procedo verso il trasferimento.",
          "goto": "travel"
        },
        {
          "id": "credentials_handoff",
          "text": "Torno al riepilogo.",
          "goto": "handoff"
        }
      ]
    },
    "travel": {
      "stitches": [
        {
          "id": "s1",
          "text": "La strada attraversa stazioni e trasferimenti. Nel frattempo gli allenatori, gli amici e le città continuano con i propri impegni."
        }
      ],
      "choices": [
        {
          "id": "travel_depart",
          "text": "Parto per il World Championship venue.",
          "goto": "venue_preview",
          "timeCostMinutes": 120
        },
        {
          "id": "travel_check",
          "text": "Prima verifico che nessun risultato futuro sia già scritto.",
          "goto": "direct_check"
        },
        {
          "id": "travel_defer",
          "text": "Rimando la partenza.",
          "goto": "defer"
        }
      ]
    },
    "direct_check": {
      "stitches": [
        {
          "id": "s1",
          "text": "Prima del sorteggio non puoi conoscere con certezza il gruppo o l'ordine degli avversari. Le bacheche mostrano soltanto i nomi ammessi."
        }
      ],
      "choices": [
        {
          "id": "check_travel",
          "text": "Torno alla partenza.",
          "goto": "travel"
        },
        {
          "id": "check_guard",
          "text": "Rileggo il guardrail della qualificazione.",
          "goto": "qualification_guard"
        }
      ]
    },
    "defer": {
      "stitches": [
        {
          "id": "s1",
          "text": "Puoi rimandare la partenza, sapendo che gli appuntamenti del torneo hanno scadenze che non dipendono da te."
        }
      ],
      "choices": [
        {
          "id": "defer_wait",
          "text": "Lascio passare un'ora.",
          "goto": "wait",
          "timeCostMinutes": 60
        },
        {
          "id": "defer_travel",
          "text": "Riconsidero la partenza.",
          "goto": "travel"
        }
      ]
    },
    "wait": {
      "stitches": [
        {
          "id": "s1",
          "text": "Trascorre un'ora. I viaggiatori cambiano e alcuni servizi chiudono, ma nessuno ti consegna un sorteggio prima della cerimonia prevista."
        }
      ],
      "choices": [
        {
          "id": "wait_travel",
          "text": "Torno alla partenza.",
          "goto": "travel"
        },
        {
          "id": "wait_preview",
          "text": "Rileggo la struttura del venue.",
          "goto": "venue_preview"
        }
      ]
    },
    "venue_preview": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il complesso riunisce arena, villaggio atleti, sale stampa, allenamento e servizi sanitari. Segnali multilingue indicano le diverse aree."
        }
      ],
      "choices": [
        {
          "id": "preview_gates",
          "text": "Controllo gli ingressi atleti.",
          "goto": "gates"
        },
        {
          "id": "preview_village",
          "text": "Guardo il World Village.",
          "goto": "village_preview"
        },
        {
          "id": "preview_security",
          "text": "Controllo i livelli di accesso.",
          "goto": "security"
        }
      ]
    },
    "gates": {
      "stitches": [
        {
          "id": "s1",
          "text": "Personale e atleti passano attraverso ingressi diversi. La qualifica ti apre il controllo, non tutte le porte senza accredito."
        }
      ],
      "choices": [
        {
          "id": "gates_accredit",
          "text": "Vedo cosa servirà all'accredito.",
          "goto": "accreditation_hint"
        },
        {
          "id": "gates_preview",
          "text": "Torno alla panoramica.",
          "goto": "venue_preview"
        }
      ]
    },
    "village_preview": {
      "stitches": [
        {
          "id": "s1",
          "text": "Oltre le vetrate scorrono gruppi di allenatori con bagagli e Pokémon. Il Village è già pieno di persone con orari e abitudini proprie."
        }
      ],
      "choices": [
        {
          "id": "village_arrival",
          "text": "Preparo l'arrivo fisico al venue.",
          "goto": "arrival_commit"
        },
        {
          "id": "village_preview_back",
          "text": "Torno alla panoramica.",
          "goto": "venue_preview"
        }
      ]
    },
    "security": {
      "stitches": [
        {
          "id": "s1",
          "text": "Un addetto controlla il pass prima di lasciarti attraversare un corridoio riservato. Alcune zone resteranno chiuse fino agli appuntamenti previsti."
        }
      ],
      "choices": [
        {
          "id": "security_accredit",
          "text": "Rivedo il passaggio di accredito.",
          "goto": "accreditation_hint"
        },
        {
          "id": "security_preview",
          "text": "Torno alla panoramica.",
          "goto": "venue_preview"
        }
      ]
    },
    "accreditation_hint": {
      "stitches": [
        {
          "id": "s1",
          "text": "La prima tappa è il banco accrediti, dove verificheranno identità e accessi. Il tuo gruppo sarà annunciato soltanto più avanti."
        }
      ],
      "choices": [
        {
          "id": "accredit_arrival",
          "text": "Vado al commit di arrivo.",
          "goto": "arrival_commit"
        },
        {
          "id": "accredit_gates",
          "text": "Torno agli ingressi.",
          "goto": "gates"
        }
      ]
    },
    "medical_continuity": {
      "stitches": [
        {
          "id": "s1",
          "text": "Le condizioni della squadra devono ancora essere valutate. L'arrivo non ha riparato ferite o restituito energie."
        }
      ],
      "choices": [
        {
          "id": "medical_carry",
          "text": "Torno allo stato ereditato.",
          "goto": "carryover"
        },
        {
          "id": "medical_arrival",
          "text": "Sono pronto ad arrivare senza reset.",
          "goto": "arrival_commit"
        }
      ]
    },
    "arrival_commit": {
      "stitches": [
        {
          "id": "s1",
          "text": "Al varco un addetto timbra l'ingresso. Sei arrivato fisicamente alla sede mondiale, non hai ancora disputato alcuna partita."
        }
      ],
      "choices": [
        {
          "id": "arrival_now",
          "text": "Registro l'arrivo al World Championship venue.",
          "goto": "commit_now"
        },
        {
          "id": "arrival_review",
          "text": "Prima rivedo il venue.",
          "goto": "venue_preview"
        }
      ]
    },
    "commit_now": {
      "stitches": [
        {
          "id": "s1",
          "text": "Consegni il documento al controllo e ricevi indicazioni per gli accrediti. Il viaggio si conclude davvero qui."
        }
      ],
      "choices": [
        {
          "id": "commit_arrival",
          "text": "Confermo l'arrivo.",
          "goto": "arrival_complete",
          "effects": [
            {
              "type": "set_flag",
              "key": "m8_world_arrived",
              "value": true
            },
            {
              "type": "set_flag",
              "key": "world_venue_discovered",
              "value": true
            },
            {
              "type": "set_location",
              "locationId": "world_championship_venue"
            }
          ]
        },
        {
          "id": "commit_back",
          "text": "Rileggo ancora il passaggio.",
          "goto": "arrival_commit"
        }
      ]
    },
    "arrival_complete": {
      "stitches": [
        {
          "id": "s1",
          "text": "Ti trovi fra i partecipanti qualificati. Ora dovrai completare le procedure prima del sorteggio."
        }
      ],
      "choices": [
        {
          "id": "complete_accredit",
          "text": "Passo all'accredito.",
          "goto": "m08-accreditation#accreditation_entry"
        },
        {
          "id": "complete_hub",
          "text": "Resto nell'atrio del venue.",
          "goto": "venue_hub"
        }
      ]
    },
    "venue_hub": {
      "stitches": [
        {
          "id": "s1",
          "text": "Nell'atrio segui i cartelli per accrediti, servizi e Village. Ogni area ha il proprio personale e le proprie regole."
        }
      ],
      "choices": [
        {
          "id": "hub_gates",
          "text": "Torno agli ingressi.",
          "goto": "gates"
        },
        {
          "id": "hub_village",
          "text": "Rivedo il Village.",
          "goto": "village_preview"
        },
        {
          "id": "hub_accredit",
          "text": "Vado all'accredito.",
          "goto": "m08-accreditation#accreditation_entry"
        }
      ]
    }
  }
}
