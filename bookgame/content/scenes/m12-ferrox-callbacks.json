{
  "schemaVersion": 1,
  "id": "m12-ferrox-callbacks",
  "moduleId": "M12",
  "title": "M12_04 — Ferrox Callbacks",
  "locationId": "fer_city",
  "entryNodeId": "callback_entry",
  "conditions": {
    "path": "world.flags.m12_bruma_callbacks_complete",
    "eq": true
  },
  "nodes": {
    "callback_entry": {
      "stitches": [
        {
          "id": "s1",
          "text": "A Ferrox il rumore delle officine copre a tratti quello dei treni. L'incidente delle gallerie non è una leggenda: basta guardare i percorsi del personale e le aree ancora segnate."
        }
      ],
      "choices": [
        {
          "id": "continue",
          "text": "Proseguo seguendo questo filo.",
          "goto": "city_now"
        },
        {
          "id": "review",
          "text": "Rileggo il passaggio collegato.",
          "goto": "city_now"
        },
        {
          "id": "context_1",
          "text": "Confronto questo dettaglio con un altro pezzo del percorso.",
          "goto": "rescue_state"
        }
      ]
    },
    "city_now": {
      "stitches": [
        {
          "id": "s1",
          "text": "I turni sono cambiati e alcune deviazioni sembrano ormai abituali. La città ha continuato a lavorare mentre tu eri lontano."
        }
      ],
      "choices": [
        {
          "id": "continue",
          "text": "Proseguo seguendo questo filo.",
          "goto": "rescue_state"
        },
        {
          "id": "review",
          "text": "Rileggo il passaggio collegato.",
          "goto": "callback_entry"
        },
        {
          "id": "context_2",
          "text": "Confronto questo dettaglio con un altro pezzo del percorso.",
          "goto": "people_first"
        }
      ]
    },
    "rescue_state": {
      "stitches": [
        {
          "id": "s1",
          "text": "All'ufficio tecnico ritrovi il fascicolo dell'incidente. Ogni nome, ferita e sezione isolata corrisponde alle scelte e ai soccorsi di quel giorno."
        }
      ],
      "choices": [
        {
          "id": "continue",
          "text": "Proseguo seguendo questo filo.",
          "goto": "best_contained"
        },
        {
          "id": "review",
          "text": "Rileggo il passaggio collegato.",
          "goto": "city_now"
        },
        {
          "id": "context_3",
          "text": "Confronto questo dettaglio con un altro pezzo del percorso.",
          "goto": "support_limited"
        }
      ]
    },
    "best_contained": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il rapporto ricorda che le squadre riuscirono a contenere gran parte del danno. Le ferite e le interruzioni subite, però, non spariscono dal ricordo dei lavoratori."
        }
      ],
      "choices": [
        {
          "id": "continue",
          "text": "Proseguo seguendo questo filo.",
          "goto": "people_first"
        },
        {
          "id": "review",
          "text": "Rileggo il passaggio collegato.",
          "goto": "rescue_state"
        }
      ]
    },
    "people_first": {
      "stitches": [
        {
          "id": "s1",
          "text": "La priorità data all'evacuazione è ricordata da chi uscì dalle gallerie. Una parte delle strutture ne pagò il prezzo e richiese lavori successivi."
        }
      ],
      "choices": [
        {
          "id": "continue",
          "text": "Proseguo seguendo questo filo.",
          "goto": "structure_first"
        },
        {
          "id": "review",
          "text": "Rileggo il passaggio collegato.",
          "goto": "best_contained"
        }
      ]
    },
    "structure_first": {
      "stitches": [
        {
          "id": "s1",
          "text": "Le squadre rallentarono per mettere in sicurezza i supporti. Le persone furono recuperate, ma chi c'era ricorda le ore e la tensione di quell'attesa."
        }
      ],
      "choices": [
        {
          "id": "continue",
          "text": "Proseguo seguendo questo filo.",
          "goto": "support_limited"
        },
        {
          "id": "review",
          "text": "Rileggo il passaggio collegato.",
          "goto": "people_first"
        }
      ]
    },
    "support_limited": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il tuo contributo aiutò a orientare il lavoro degli specialisti. Furono le squadre interne a operare nei tunnel: il rapporto distingue i ruoli."
