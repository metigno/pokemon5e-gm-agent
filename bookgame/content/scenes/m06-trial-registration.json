{
  "schemaVersion": 1,
  "id": "m06-trial-registration",
  "moduleId": "M06",
  "title": "M6_11 — Trial Registration A→S",
  "locationId": "far_ruins_gate",
  "entryNodeId": "trial_info",
  "conditions": {
    "all": [
      {
        "path": "world.flags.m5_complete",
        "eq": true
      },
      {
        "path": "world.flags.m06_unlocked",
        "eq": true
      },
      {
        "path": "world.flags.m6_active",
        "eq": true
      },
      {
        "path": "competition.rank",
        "eq": "A"
      },
      {
        "path": "world.flags.m6_first_lighthouse_return_complete",
        "eq": true
      }
    ]
  },
  "nodes": {
    "trial_info": {
      "stitches": [
        {
          "id": "s1",
          "text": "Al banco del Faro, un arbitro indica il regolamento della prova per il grado S. «Incontro singolo, sei Pokémon ufficiali. Qui si decide la promozione, non nella Continental Cup»."
        }
      ],
      "choices": [
        {
          "id": "info_audit",
          "text": "Verifico eligibility e stato E5.",
          "goto": "eligibility_audit"
        },
        {
          "id": "info_examiner",
          "text": "Leggo il profilo pubblico dell'esaminatore.",
          "goto": "examiner_review"
        },
        {
          "id": "info_identity",
          "text": "Rivedo cosa valuta questo Gate.",
          "goto": "master_identity"
        },
        {
          "id": "info_defer",
          "text": "Rimando senza consumare la finestra.",
          "goto": "postponed"
        }
      ]
    },
    "eligibility_audit": {
      "stitches": [
        {
          "id": "s1",
          "text": "L'addetta confronta la tua licenza con l'elenco dei candidati e controlla la squadra. «Per iscriverti devi avere il grado A e sei Pokémon disponibili»."
        }
      ],
      "choices": [
        {
          "id": "audit_sync",
          "text": "Sincronizzo RANK_A_TO_S con E5.",
          "goto": "trial_desk",
          "conditions": {
            "path": "competition.trials.RANK_A_TO_S.available",
            "ne": true
          },
          "effects": [
            {
              "type": "competition_trial_available",
              "checkpointId": "RANK_A_TO_S",
              "fromRank": "A",
              "toRank": "S",
              "requiredRosterSize": 6,
              "retryable": true
            }
          ]
        },
        {
          "id": "audit_ready",
          "text": "Il checkpoint E5 è già disponibile.",
          "goto": "trial_desk",
          "conditions": {
            "path": "competition.trials.RANK_A_TO_S.available",
            "eq": true
          }
        },
        {
          "id": "audit_rank",
          "text": "Rivedo perché nessun risultato Masters/Cup può sostituire il Gate.",
          "goto": "rank_gate_review"
        }
      ]
    },
    "trial_desk": {
      "stitches": [
        {
          "id": "s1",
          "text": "Lo sportello è sobrio: un registro, un orologio e un elenco di turni. L'addetta verifica la squadra senza toccare le Poké Ball. «Presentati nelle condizioni in cui intendi combattere»."
        }
      ],
      "choices": [
        {
          "id": "desk_register",
          "text": "Registro l'Official Six per A→S.",
          "goto": "registered",
          "conditions": {
            "all": [
              {
                "path": "competition.trials.RANK_A_TO_S.available",
                "eq": true
              },
              {
                "path": "competition.trials.RANK_A_TO_S.registered",
                "ne": true
              },
              {
                "path": "player.roster.length",
                "gte": 6
              }
            ]
          },
          "effects": [
            {
              "type": "competition_trial_register",
              "checkpointId": "RANK_A_TO_S"
            }
          ]
        },
        {
          "id": "desk_roster",
          "text": "Controllo il requisito dei sei Pokémon.",
          "goto": "roster_review"
        },
        {
          "id": "desk_examiner",
          "text": "Rivedo l'esaminatore fisso del Gate.",
          "goto": "examiner_review"
        },
        {
          "id": "desk_strategy",
          "text": "Rivedo il tema dell'esame Master completo.",
          "goto": "master_identity"
        }
      ]
    },
    "roster_review": {
      "stitches": [
        {
          "id": "s1",
          "text": "Conti i Pokémon che puoi schierare. Il personale ne verifica il numero, ma non interviene sulle loro condizioni o sull'ordine della squadra."
        }
      ],
      "choices": [
        {
          "id": "roster_register",
          "text": "Ho sei Pokémon: registro.",
          "goto": "registered",
          "conditions": {
            "all": [
              {
                "path": "competition.trials.RANK_A_TO_S.available",
                "eq": true
              },
              {
                "path": "competition.trials.RANK_A_TO_S.registered",
                "ne": true
              },
              {
                "path": "player.roster.length",
                "gte": 6
              }
            ]
          },
          "effects": [
            {
              "type": "competition_trial_register",
              "checkpointId": "RANK_A_TO_S"
            }
          ]
        },
        {
          "id": "roster_short",
          "text": "Non ho ancora sei Pokémon: devo prepararmi.",
          "goto": "postponed",
          "conditions": {
            "path": "player.roster.length",
            "lt": 6
          }
        },
        {
          "id": "roster_back",
          "text": "Torno al desk senza cambiare il roster.",
          "goto": "trial_desk"
        }
      ]
    },
    "examiner_review": {
      "stitches": [
        {
          "id": "s1",
          "text": "Sul cartellone è esposto il nome dell'esaminatore e la sua squadra ufficiale di sei Pokémon. «Affronterai quella squadra», precisa l'arbitro. «Non una scelta costruita apposta per te»."
        }
      ],
      "choices": [
        {
          "id": "examiner_identity",
          "text": "Collego il profilo al tema del Gate.",
          "goto": "master_identity"
        },
        {
          "id": "examiner_desk",
          "text": "Torno al desk.",
          "goto": "trial_desk"
        }
      ]
    },
    "master_identity": {
      "stitches": [
        {
          "id": "s1",
          "text": "Un veterano in attesa accanto al banco scuote la testa. «Sei Pokémon sono tanti quando inizi a perdere risorse. Non basta avere una buona apertura»."
        }
      ],
      "choices": [
        {
          "id": "identity_resources",
          "text": "Controllo lo stato reale delle risorse.",
          "goto": "resource_state"
        },
        {
          "id": "identity_attempts",
          "text": "Controllo retry e tentativi.",
          "goto": "attempt_history"
        }
      ]
    },
    "attempt_history": {
      "stitches": [
        {
          "id": "s1",
          "text": "L'addetta mostra il registro dei tentativi. «Se perdi, potrai ripresentarti. Ma il tempo passato e gli incontri disputati non spariscono»."
        }
      ],
      "choices": [
        {
          "id": "attempt_cutoff",
          "text": "Controllo come il retry interagisce col cutoff.",
          "goto": "cutoff_review"
        },
        {
          "id": "attempt_back",
          "text": "Torno al desk.",
          "goto": "trial_desk"
        }
      ]
    },
    "resource_state": {
      "stitches": [
        {
          "id": "s1",
          "text": "Prima di iscriverti, controlli la squadra e gli oggetti che porti. Il banco non offre cure né rifornimenti: ciò che hai adesso sarà ciò con cui dovrai fare i conti."
        }
      ],
      "choices": [
        {
          "id": "resource_prep",
          "text": "Definisco solo un focus mentale, senza bonus.",
          "goto": "prep_focus"
        }
      ]
    },
    "cutoff_review": {
      "stitches": [
        {
          "id": "s1",
          "text": "Accanto al calendario degli esami compare la data di chiusura della classifica stagionale. L'addetta la indica: «La prova resta la stessa, ma il calendario non aspetta nessuno»."
        }
      ],
      "choices": [
        {
          "id": "cutoff_lighthouse",
          "text": "Ricollego il cutoff al contesto del Faro.",
          "goto": "lighthouse_context"
        },
        {
          "id": "cutoff_back",
          "text": "Torno al desk.",
          "goto": "trial_desk"
        }
      ]
    },
    "red_context": {
      "stitches": [
        {
          "id": "s1",
          "text": "Ti tornano in mente le parole asciutte di Red sui piani che non funzionano. Davanti all'esame, non offrono risposte facili: sta a te decidere cosa cambiare."
        }
      ],
      "choices": [
        {
          "id": "red_ready",
          "text": "Tengo il principio come prospettiva.",
          "goto": "registered_status",
          "conditions": {
            "path": "world.flags.red_met",
            "eq": true
          },
          "effects": [
            {
              "type": "set_flag",
              "key": "m6_trial_red_context",
              "value": true
            }
          ]
        },
        {
          "id": "red_identity",
          "text": "Rileggo il tema Master senza bonus.",
          "goto": "master_identity"
        }
      ]
    },
    "registered": {
      "stitches": [
        {
          "id": "s1",
          "text": "L'addetta firma il modulo e lo inserisce nel registro. «Iscrizione confermata. Quando entrerai nell'arena, l'esaminatore ti aspetterà»."
        }
      ],
      "choices": [
        {
          "id": "registered_status",
          "text": "Controllo cosa è stato registrato.",
          "goto": "registered_status"
        },
        {
          "id": "registered_red",
          "text": "Rileggo il Gate attraverso Red.",
          "goto": "red_context",
          "conditions": {
            "path": "world.flags.red_met",
            "eq": true
          }
        },
        {
          "id": "registered_enter",
          "text": "Entro nel Promotion Trial A→S.",
          "goto": "trial_ready",
          "conditions": {
            "path": "competition.trials.RANK_A_TO_S.registered",
            "eq": true
          }
        }
      ]
    },
    "registered_status": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il tuo nome compare fra i candidati iscritti. Sul cartello della prova sono riportati grado A, squadra di sei Pokémon e possibilità di ripresentarsi dopo un esito negativo."
        }
      ],
      "choices": [
        {
          "id": "status_enter",
          "text": "Lo stato è corretto: vado al Gate.",
          "goto": "trial_ready"
        },
        {
          "id": "status_back",
          "text": "Resto al desk.",
          "goto": "registered"
        }
      ]
    },
    "postponed": {
      "stitches": [
        {
          "id": "s1",
          "text": "Lasci il banco senza iniziare la prova. Il vento continua a battere sulle rovine e gli annunci degli altri eventi arrivano da lontano."
        }
      ],
      "choices": [
        {
          "id": "postponed_lighthouse",
          "text": "Torno al perimetro del Faro.",
          "goto": "m06-first-lighthouse-return#ruins_boundary"
        },
        {
          "id": "postponed_return",
          "text": "Cambio idea e torno alle informazioni del Trial.",
          "goto": "trial_info"
        }
      ]
    },
    "rank_gate_review": {
      "stitches": [
        {
          "id": "s1",
          "text": "L'arbitro indica il sigillo del grado S sopra l'ingresso. «Per ottenerlo devi vincere contro l'esaminatore. I titoli conquistati altrove non sostituiscono questa prova»."
        }
      ],
      "choices": [
        {
          "id": "rank_audit",
          "text": "Torno all'audit E5.",
          "goto": "eligibility_audit"
        },
        {
          "id": "rank_context",
          "text": "Rivedo il ruolo del Faro nella progressione.",
          "goto": "lighthouse_context"
        }
      ]
    },
    "trial_ready": {
      "stitches": [
        {
          "id": "s1",
          "text": "L'arbitro apre la porta dell'arena. La registrazione è stata accettata, ma l'incontro deve ancora cominciare."
        }
      ],
      "choices": [
        {
          "id": "ready_enter",
          "text": "Entro nel Gate del Faro.",
          "goto": "m06-promotion-trial-a-s#trial_gate_call"
        }
      ]
    },
    "lighthouse_context": {
      "stitches": [
        {
          "id": "s1",
          "text": "Dietro lo sportello, le mura antiche del Faro portano ancora i segni del tempo. Poco più in là, l'arena degli esami è pronta ad accogliere i candidati."
        }
      ],
      "choices": [
        {
          "id": "lighthouse_trial",
          "text": "Torno alle informazioni del Trial.",
          "goto": "trial_info"
        }
      ]
    },
    "prep_focus": {
      "stitches": [
        {
          "id": "s1",
          "text": "Ti fermi a osservare il campo. Puoi riflettere sui cambi, sul ritmo e sulle risorse della squadra prima di entrare, senza sapere come agirà l'esaminatore."
        }
      ],
      "choices": [
        {
          "id": "prep_depth",
          "text": "Focus: preservare profondità del team.",
          "goto": "trial_desk",
          "effects": [
            {
              "type": "set_flag",
              "key": "trial_a_s_prep_focus",
              "value": "depth"
            }
          ]
        },
        {
          "id": "prep_adaptation",
          "text": "Focus: adattare ritmo e switch.",
          "goto": "trial_desk",
          "effects": [
            {
              "type": "set_flag",
              "key": "trial_a_s_prep_focus",
              "value": "adaptation"
            }
          ]
        }
      ]
    }
  }
}
