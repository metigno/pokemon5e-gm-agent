    "fauna_geodude": {
      "stitches": [
        {
          "id": "fg1",
          "text": "Un Geodude resta quasi indistinguibile dalla pietra finché non cambia posizione. Il suo movimento conferma quanto la fauna locale sfrutti ripari e pareti."
        }
      ],
      "choices": [
        {
          "id": "geodude_engage",
