{
  "schemaVersion": 1,
  "id": "m05-fulgore-ascent",
  "moduleId": "M05",
  "title": "M5_05 — Fulgore Ascent",
  "locationId": "alt_town_gate",
  "entryNodeId": "ascent_gate",
  "conditions": {
    "all": [
      {
        "path": "world.flags.m4_complete",
        "eq": true
      },
      {
        "path": "world.flags.m05_unlocked",
        "eq": true
      },
      {
        "path": "world.flags.m5_active",
        "eq": true
      },
      {
        "path": "competition.rank",
        "eq": "B"
      },
      {
        "path": "world.flags.altacima_discovered",
        "eq": true
      },
      {
        "path": "world.flags.m5_fulgore_departure_ready",
        "eq": true
      }
    ]
  },
  "nodes": {
    "ascent_gate": {
      "stitches": [
        {
          "id": "g1",
          "text": "Al posto di controllo di Altacima confrontano la tua rotta con il bollettino più recente. Oltre la sbarra, le nuvole corrono veloci: il cielo della partenza non promette nulla per l'arrivo."
        }
      ],
      "choices": [
        {
          "id": "gate_direct",
          "text": "Parto sulla direttrice principale.",
          "conditions": {
            "path": "world.flags.m5_fulgore_route_plan",
            "eq": "direct"
          },
          "timeCostMinutes": 45,
          "goto": "direct_route",
          "effects": [
            {
              "type": "set_location",
              "locationId": "ful_ascent"
            }
          ]
        },
        {
          "id": "gate_sheltered",
          "text": "Parto sulla variante riparata.",
          "conditions": {
            "path": "world.flags.m5_fulgore_route_plan",
            "eq": "sheltered"
          },
          "timeCostMinutes": 60,
          "goto": "sheltered_route",
          "effects": [
            {
              "type": "set_location",
              "locationId": "ful_ascent"
            }
          ]
        },
        {
          "id": "gate_recheck",
          "text": "Ricontrollo il margine prima di impegnarmi.",
          "goto": "checkpoint"
        },
        {
          "id": "gate_cancel",
          "text": "Rinuncio alla partenza e torno ad Altacima.",
          "goto": "m05-altacima#town_hub",
          "effects": [
            {
              "type": "set_location",
              "locationId": "alt_town"
            }
          ]
        }
      ]
    },
    "direct_route": {
      "stitches": [
        {
          "id": "d1",
          "text": "La via diretta prende quota in fretta e attraversa un tratto esposto. Il vantaggio è il tempo; il costo è avere meno ripari se il vento gira."
        }
      ],
      "choices": [
        {
          "id": "direct_read",
          "text": "Leggo le raffiche prima della cresta. (CT Survival)",
          "check": {
            "ability": "WIS",
            "skill": "Survival",
            "dc": 14
          },
          "outcomes": {
            "success": {
              "goto": "storm_ridge",
              "effects": [
                {
                  "type": "set_flag",
                  "key": "m5_fulgore_direct_read",
                  "value": "clear"
                }
              ]
            },
            "failure": {
              "goto": "storm_ridge",
              "effects": [
                {
                  "type": "set_flag",
                  "key": "m5_fulgore_direct_read",
                  "value": "uncertain"
                }
              ]
            }
          }
        },
        {
          "id": "direct_fauna",
          "text": "Uso un tratto protetto per osservare la fauna.",
          "goto": "fauna_view"
        },
        {
          "id": "direct_retreat",
          "text": "Il margine non mi convince: torno al punto di scelta.",
          "timeCostMinutes": 30,
          "goto": "retreat_point"
        }
      ]
    },
    "sheltered_route": {
      "stitches": [
        {
          "id": "s1",
          "text": "La variante protetta segue muri di roccia e vecchi paletti del servizio meteo. È più lunga, ma permette di interrompere la salita senza dover attraversare subito la cresta."
        }
      ],
      "choices": [
        {
          "id": "shelter_continue",
          "text": "Continuo mantenendo il margine.",
          "timeCostMinutes": 45,
          "goto": "plateau_edge"
        },
        {
          "id": "shelter_fauna",
          "text": "Mi fermo a osservare il corridoio faunistico.",
          "goto": "fauna_view"
        },
        {
          "id": "shelter_lance",
          "text": "Ripenso al criterio di Lance prima dell'ultimo tratto.",
          "conditions": {
            "path": "world.flags.lance_met",
            "eq": true
          },
          "goto": "lance_callback"
        }
      ]
    },
    "storm_ridge": {
      "stitches": [
        {
          "id": "r1",
          "text": "Sulla cresta il vento arriva a impulsi e riduce il margine d'errore. Puoi insistere, deviare o arretrare, sapendo che la via più rapida lascia meno tempo per reagire."
        }
      ],
      "choices": [
        {
          "id": "ridge_push",
          "text": "Attraverso il tratto esposto ora. (CT CON)",
          "check": {
            "ability": "CON",
            "dc": 13
          },
          "outcomes": {
            "success": {
              "goto": "plateau_edge",
              "effects": [
                {
                  "type": "set_flag",
                  "key": "m5_fulgore_ridge_result",
                  "value": "steady"
                }
              ]
            },
            "failure": {
              "goto": "retreat_point",
              "effects": [
                {
                  "type": "set_flag",
                  "key": "m5_fulgore_ridge_result",
                  "value": "forced_pause"
                }
              ]
            }
          }
        },
        {
          "id": "ridge_deviate",
          "text": "Devio verso la variante riparata.",
          "timeCostMinutes": 30,
          "goto": "sheltered_route",
          "effects": [
            {
              "type": "set_flag",
              "key": "m5_fulgore_midcourse_deviation",
              "value": true
            }
          ]
        },
        {
          "id": "ridge_retreat",
          "text": "Rientro al riparo prima che il margine si chiuda.",
          "timeCostMinutes": 30,
          "goto": "retreat_point"
        }
      ]
    },
    "fauna_view": {
      "stitches": [
        {
          "id": "f1",
          "text": "Il vento porta odore d'erba fredda e ozono. Piccoli movimenti fra rocce e ciuffi ricordano che Fulgore è un habitat, non un corridoio competitivo."
        }
      ],
      "choices": [
        {
          "id": "observe_fulgore_fauna",
          "text": "Osservo senza inseguire.",
          "timeCostMinutes": 20,
          "ecology": {
            "requestId": "M5_FULGORE_OBSERVATION_01",
            "zoneId": "FUL-PLATEAU",
            "method": "wild_observation",
            "allowedSpecies": [
              "riolu",
              "geodude",
              "machop"
            ],
            "returnNodes": {
              "noEncounter": "fauna_none",
              "riolu": "fauna_riolu",
              "geodude": "fauna_geodude",
              "machop": "fauna_machop"
            }
          }
        },
        {
          "id": "fauna_skip",
          "text": "Non interferisco e continuo.",
          "goto": "plateau_edge"
        }
      ]
    },
    "fauna_none": {
      "stitches": [
        {
          "id": "fn1",
          "text": "Non compare nulla di abbastanza vicino da identificare. L'assenza di incontro resta un esito valido."
        }
      ],
      "choices": [
        {
          "id": "none_continue",
          "text": "Continuo verso l'altopiano.",
          "goto": "plateau_edge"
        }
      ]
    },
    "plateau_edge": {
      "stitches": [
        {
          "id": "p1",
          "text": "Il terreno finalmente si apre. Davanti a te l'Altopiano Fulgore è una distesa spezzata da piloni meteorologici, rocce nere e linee di scarica lontane."
        }
      ],
      "choices": [
        {
          "id": "edge_enter",
          "text": "Entro nell'altopiano.",
          "timeCostMinutes": 20,
          "goto": "plateau_arrival",
          "effects": [
            {
              "type": "set_location",
              "locationId": "ful_plateau"
            }
          ]
        },
        {
          "id": "edge_checkpoint",
          "text": "Mi fermo a registrare il percorso prima di entrare.",
          "goto": "checkpoint"
        },
        {
          "id": "edge_retreat",
          "text": "Decido che oggi il margine non basta.",
          "goto": "retreat_point"
        }
      ]
    },
    "retreat_point": {
      "stitches": [
        {
          "id": "rt1",
          "text": "Arretrare non è una sconfitta. Conservi il Rank B e potrai cercare un'altra finestra per raggiungere Fulgore."
        }
      ],
      "choices": [
        {
          "id": "retreat_altacima",
          "text": "Torno ad Altacima.",
          "timeCostMinutes": 60,
          "goto": "m05-altacima#town_hub",
          "effects": [
            {
              "type": "set_location",
              "locationId": "alt_town"
            }
          ]
        },
        {
          "id": "retreat_reassess",
          "text": "Resto al riparo e rivaluto.",
          "timeCostMinutes": 30,
          "goto": "checkpoint"
        }
      ]
    },
    "lance_callback": {
      "stitches": [
        {
          "id": "lc1",
          "text": "Ti torna in mente ciò che Lance ti ha detto sul rischio: vale la pena esporsi soltanto quando sai perché lo fai e come tornare indietro."
        }
      ],
      "choices": [
        {
          "id": "lance_continue",
          "text": "Mantengo il piano e continuo.",
          "goto": "plateau_edge",
          "effects": [
            {
              "type": "set_flag",
              "key": "m5_lance_ascent_callback",
              "value": true
            }
          ]
        },
        {
          "id": "lance_retreat",
          "text": "Il margine non compra abbastanza: arretrato.",
          "goto": "retreat_point",
          "effects": [
            {
              "type": "set_flag",
              "key": "m5_lance_ascent_callback",
              "value": true
            }
          ]
        }
      ]
    },
    "checkpoint": {
      "stitches": [
        {
          "id": "c1",
          "text": "Il check di percorso conserva rotta, tempo e informazioni raccolte. Non cura la squadra e non trasforma una lettura incerta in certezza."
        }
      ],
      "choices": [
        {
          "id": "checkpoint_continue",
          "text": "Proseguo verso il bordo dell'altopiano.",
          "goto": "plateau_edge"
        },
        {
          "id": "checkpoint_back",
          "text": "Rientro ad Altacima e ripianifico.",
          "timeCostMinutes": 45,
          "goto": "m05-altacima#town_hub",
          "effects": [
            {
              "type": "set_location",
              "locationId": "alt_town"
            }
          ]
        }
      ]
    },
    "ascent_close": {
      "stitches": [
        {
          "id": "ac1",
          "text": "Solo quando raggiungi davvero Fulgore puoi considerare conclusa la salita. La strada percorsa e le decisioni prese restano parte della tua esperienza della montagna."
        }
      ],
      "choices": [
        {
          "id": "close_trace",
          "text": "L'anomalia di Fulgore è attiva: la seguo.",
          "conditions": {
            "all": [
              {
                "path": "world.flags.a5_trace_available",
                "eq": true
              },
              {
                "path": "world.flags.m5_ancient_trace_complete",
                "ne": true
              }
            ]
          },
          "goto": "m05-ancient-trace#trace_entry"
        },
        {
          "id": "close_altacima",
          "text": "Per ora torno ad Altacima.",
          "timeCostMinutes": 60,
          "goto": "m05-altacima#town_hub",
          "effects": [
            {
              "type": "set_location",
              "locationId": "alt_town"
            }
          ]
        }
      ]
    },
    "plateau_arrival": {
      "stitches": [
        {
          "id": "pa1",
          "text": "Sei sull'Altopiano Fulgore. Il cielo sembra più grande, il vento più netto e il rumore delle scariche arriva con un leggero ritardo. Tra rocce e quota c'è qualcosa che merita di essere osservato con attenzione."
        }
      ],
      "choices": [
        {
          "id": "arrival_complete",
          "text": "Registro l'arrivo reale a Fulgore.",
          "goto": "ascent_close",
          "effects": [
            {
              "type": "set_flag",
              "key": "fulgore_visited",
              "value": true
            },
            {
              "type": "set_flag",
              "key": "m5_fulgore_ascent_complete",
              "value": true
            },
            {
              "type": "trainer_milestone_level",
              "milestoneId": "M05_FULGORE_ASCENT",
              "level": 13
            },
            {
              "type": "set_location",
              "locationId": "ful_plateau"
            }
          ]
        }
      ]
    },
    "fauna_riolu": {
      "stitches": [
        {
          "id": "fr1",
          "text": "Un Riolu si muove lungo il margine del pendio, fermandosi nei punti in cui la roccia spezza il vento. Non mostra interesse a trasformare l'incontro in uno scontro."
        }
      ],
      "choices": [
        {
          "id": "riolu_engage",
          "text": "Resto sul percorso e affronto Riolu.",
          "combat": {
