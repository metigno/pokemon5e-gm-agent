    "wild_combat_handoff": {
      "text": "Il Pokémon selvatico reagisce alla tua presenza e il confronto comincia."
    },
    "wild_win": {
      "stitches": [
        {
          "id": "ww1",
          "text": "Il Pokémon selvatico cede. Quando il confronto termina, la tua squadra conserva ferite, energie e condizioni lasciate dallo scontro."
        }
      ],
      "choices": [
        {
          "id": "wild_win_continue",
