            {
              "type": "set_flag",
              "key": "m5_fulgore_fauna_seen",
              "value": "geodude"
            }
          ]
        }
      ]
    },
    "fauna_machop": {
      "stitches": [
        {
          "id": "fm1",
          "text": "Un Machop attraversa un tratto aperto solo dopo aver atteso una pausa nelle raffiche, poi scompare dietro un costone."
        }
      ],
      "choices": [
        {
          "id": "machop_engage",
          "text": "Resto sul percorso e affronto Machop.",
          "combat": {
            "encounterId": "M5_WILD_MACHOP_001",
