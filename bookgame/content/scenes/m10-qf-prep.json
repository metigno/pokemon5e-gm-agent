{
  "schemaVersion": 1,
  "id": "m10-qf-prep",
  "moduleId": "M10",
  "title": "M10_06 — QF Prep",
  "locationId": "world_knockout_hall",
  "entryNodeId": "prep_entry",
  "conditions": {
    "all": [
      {
        "path": "world.flags.m10_friend_beat_10_complete",
        "eq": true
      },
      {
        "path": "world.flags.world_r16_won",
        "eq": true
      },
      {
        "path": "competition.world.top8Locked",
        "eq": true
      },
      {
        "path": "competition.world.knockout.playerAdvancedToQf",
        "eq": true
      }
    ]
  },
  "nodes": {
    "prep_entry": {
      "stitches": [
        {
          "id": "s1",
          "text": "La preparazione per l'quarto comincia dalle condizioni in cui hai lasciato il campo precedente. Non tutte le fatiche sono state cancellate dal calendario."
        }
      ],
      "choices": [
        {
          "id": "entry_roster",
          "text": "Controllo la squadra reale.",
          "goto": "roster_state"
        },
        {
          "id": "entry_time",
          "text": "Valuto quanto tempo spendere.",
          "goto": "time_budget"
        },
        {
          "id": "entry_opponent",
          "text": "Rivedo il QF opponent derivato.",
          "goto": "opponent_read"
        }
      ]
    },
    "roster_state": {
      "stitches": [
        {
          "id": "s1",
          "text": "Dopo gli ottavi controlli i sei Pokémon e ciò che hanno consumato. Una nuova giornata non li rende automaticamente guariti."
        }
      ],
      "choices": [
        {
          "id": "roster_medical",
          "text": "Distinguo valutazione da cura reale.",
          "goto": "medical_boundary"
        },
        {
          "id": "roster_plan",
          "text": "Costruisco il piano sulle risorse esistenti.",
          "goto": "tactical_plan"
        }
      ]
    },
    "medical_boundary": {
      "stitches": [
        {
          "id": "s1",
          "text": "Un medico può leggere il referto degli ottavi e suggerire cure, ma recuperare richiede tempo e servizi reali."
        }
      ],
      "choices": [
        {
          "id": "medical_time",
          "text": "Valuto se spendere tempo.",
          "goto": "time_budget"
        },
        {
          "id": "medical_ready",
          "text": "Accetto lo stato reale e continuo.",
          "goto": "readiness"
        }
      ]
    },
    "time_budget": {
      "stitches": [
        {
          "id": "s1",
          "text": "Gli appuntamenti continuano a scorrere mentre ti prepari per l'quarto. Il nome del tuo avversario è già sul tabellone."
        }
      ],
      "choices": [
        {
          "id": "time_short",
          "text": "Dedico 15 minuti alla revisione tattica.",
          "goto": "tactical_plan",
          "timeCostMinutes": 15
        },
        {
          "id": "time_long",
          "text": "Dedico 30 minuti al controllo roster.",
          "goto": "roster_state",
          "timeCostMinutes": 30
        },
        {
          "id": "time_now",
          "text": "Entro subito nella readiness.",
          "goto": "readiness"
        }
      ]
    },
    "opponent_read": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il tuo prossimo avversario è {{competition.world.knockout.playerQfOpponent.name}}. Puoi esaminare informazioni pubbliche, senza fingere di conoscere le scelte che farà."
        }
      ],
      "choices": [
        {
          "id": "opponent_callbacks",
          "text": "Controllo i precedenti leciti.",
          "goto": "callbacks"
        },
        {
          "id": "opponent_plan",
          "text": "Adatto il piano a ciò che so davvero.",
          "goto": "tactical_plan"
        }
      ]
    },
    "callbacks": {
      "stitches": [
        {
          "id": "s1",
          "text": "Se vi siete già affrontati, la memoria dell'incontro può suggerire domande utili. Non svela mosse tenute segrete."
        }
      ],
      "choices": [
        {
          "id": "callbacks_plan",
          "text": "Traduco il contesto in piano.",
          "goto": "tactical_plan"
        },
        {
          "id": "callbacks_ready",
          "text": "Passo alla readiness.",
          "goto": "readiness"
        }
      ]
    },
    "tactical_plan": {
      "stitches": [
        {
          "id": "s1",
          "text": "Puoi decidere di attaccare subito, studiare il campo o conservare risorse per i momenti decisivi. Nessun piano vale come un colpo già riuscito."
        }
      ],
      "choices": [
        {
          "id": "plan_risk",
          "text": "Valuto il rischio del Top8.",
          "goto": "risk"
        },
        {
          "id": "plan_ready",
          "text": "Porto il piano alla readiness.",
          "goto": "readiness"
        }
      ]
    },
    "risk": {
      "stitches": [
        {
          "id": "s1",
          "text": "Una sconfitta nell'quarto ti eliminerebbe. Puoi prepararti con prudenza o correre rischi, ma sarà il combattimento a decidere."
        }
      ],
      "choices": [
        {
          "id": "risk_rules",
          "text": "Rileggo il regolamento ufficiale.",
          "goto": "match_rules"
        },
        {
          "id": "risk_ready",
          "text": "Accetto il rischio e continuo.",
          "goto": "readiness"
        }
      ]
    },
    "match_rules": {
      "stitches": [
        {
          "id": "s1",
          "text": "L'arbitro ricorda il formato: Singles e sei Pokémon ufficiali. Non ci sarà una seconda partita per cancellare una sconfitta."
        }
      ],
      "choices": [
        {
          "id": "rules_roster",
          "text": "Rivedo il roster.",
          "goto": "roster_state"
        },
        {
          "id": "rules_ready",
          "text": "Procedo alla readiness.",
          "goto": "readiness"
        }
      ]
    },
    "readiness": {
      "stitches": [
        {
          "id": "s1",
          "text": "Prima della chiamata finale verifichi l'accredito e i Pokémon. La tua preparazione non ha ancora prodotto un risultato."
        }
      ],
      "choices": [
        {
          "id": "ready_commit",
          "text": "Chiudo la QF Prep.",
          "goto": "commit"
        },
        {
          "id": "ready_opponent",
          "text": "Ultima lettura dell'avversario.",
          "goto": "opponent_read"
        },
        {
          "id": "ready_rules",
          "text": "Ultimo controllo regole.",
          "goto": "match_rules"
        }
      ]
    },
    "commit": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il personale conferma la tua presenza per l'quarto. La squadra è ancora quella che hai deciso di portare in campo."
        }
      ],
      "choices": [
        {
          "id": "commit_now",
          "text": "Confermo la preparazione.",
          "goto": "handoff",
          "effects": [
            {
              "type": "set_flag",
              "key": "m10_qf_prep_complete",
              "value": true
            }
          ]
        },
        {
          "id": "commit_review",
          "text": "Rivedo la readiness.",
          "goto": "readiness"
        }
      ]
    },
    "handoff": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il corridoio conduce al campo dove ti aspetta {{competition.world.knockout.playerQfOpponent.name}}. Fra poco l'arbitro darà il segnale."
        }
      ],
      "choices": [
        {
          "id": "handoff_match",
          "text": "Entro nel World QF.",
          "goto": "m10-world-qf#qf_entry"
        },
        {
          "id": "handoff_rules",
          "text": "Rivedo le regole.",
          "goto": "match_rules"
        }
      ]
    }
  }
}
