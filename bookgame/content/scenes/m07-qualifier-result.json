{
  "schemaVersion": 1,
  "id": "m07-qualifier-result",
  "moduleId": "M07",
  "title": "M7_08 — Qualifier Result",
  "locationId": "meridiana_grand_hall",
  "entryNodeId": "result_entry",
  "conditions": {
    "all": [
      {
        "path": "world.flags.m6_complete",
        "eq": true
      },
      {
        "path": "world.flags.m07_unlocked",
        "eq": true
      },
      {
        "path": "world.flags.m7_active",
        "eq": true
      },
      {
        "path": "competition.rank",
        "eq": "S"
      },
      {
        "path": "world.flags.m7_qualifier_complete",
        "eq": true
      }
    ]
  },
  "nodes": {
    "result_entry": {
      "stitches": [
        {
          "id": "s1",
          "text": "Al banco dei risultati, un ufficiale consulta il tabellone ormai chiuso. Non ci sono altri incontri da disputare: resta da confermare ciò che è successo in campo."
        }
      ],
      "choices": [
        {
          "id": "entry_classify",
          "text": "Classifico il risultato reale.",
          "goto": "classify"
        },
        {
          "id": "entry_history",
          "text": "Rivedo prima la registro degli incontri.",
          "goto": "history"
        },
        {
          "id": "entry_guard",
          "text": "Controllo il risultato ufficiale.",
          "goto": "world_guard"
        }
      ]
    },
    "classify": {
      "stitches": [
        {
          "id": "s1",
          "text": "L'ufficiale indica tre righe sul registro: due vittorie e qualificazione, eliminazione al primo turno, oppure sconfitta nell'incontro decisivo."
        }
      ],
      "choices": [
        {
          "id": "classify_qualified",
          "text": "La percorso di gara è stata vinta.",
          "goto": "qualified_summary",
          "conditions": {
            "path": "world.flags.m7_qualifier_bracket_result",
            "eq": "qualified"
          }
        },
        {
          "id": "classify_r1",
          "text": "Sono uscito al Round 1.",
          "goto": "eliminated_r1",
          "conditions": {
            "path": "world.flags.m7_qualifier_bracket_result",
            "eq": "eliminated_round1"
          }
        },
        {
          "id": "classify_final",
          "text": "Sono uscito nel Qualifying Match.",
          "goto": "eliminated_final",
          "conditions": {
            "path": "world.flags.m7_qualifier_bracket_result",
            "eq": "eliminated_qualifying_match"
          }
        }
      ]
    },
    "qualified_summary": {
      "stitches": [
        {
          "id": "s1",
          "text": "«Due vittorie», conferma l'ufficiale, confrontando le firme degli arbitri. «È il risultato che serviva per ottenere il posto.»"
        }
      ],
      "choices": [
        {
          "id": "qualified_guard",
          "text": "Verifico il requisiti prima di scrivere qualificazione al Mondiale.",
          "goto": "world_guard"
        },
        {
          "id": "qualified_record",
          "text": "Registro la qualificazione persistente.",
          "goto": "qualified_record"
        },
        {
          "id": "qualified_history",
          "text": "Rivedo le due vittorie in registro degli incontri.",
          "goto": "history"
        }
      ]
    },
    "eliminated_r1": {
      "stitches": [
        {
          "id": "s1",
          "text": "La sconfitta del primo turno compare accanto al tuo nome. Il percorso si interrompe lì, senza un secondo incontro."
        }
      ],
      "choices": [
        {
          "id": "r1_record",
          "text": "Registro eliminazione Round 1.",
          "goto": "eliminated_record",
          "effects": [
            {
              "type": "set_flag",
              "key": "m7_qualifier_result",
              "value": "eliminated_round1"
            }
          ]
        },
        {
          "id": "r1_history",
          "text": "Rivedo la registro degli incontri del primo match.",
          "goto": "history"
        }
      ]
    },
    "eliminated_final": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il registro mostra la tua vittoria iniziale e la sconfitta nell'ultima sfida. Essere arrivato vicino non cambia il posto assegnato."
        }
      ],
      "choices": [
        {
          "id": "final_record",
          "text": "Registro eliminazione nel Qualifying Match.",
          "goto": "eliminated_record",
          "effects": [
            {
              "type": "set_flag",
              "key": "m7_qualifier_result",
              "value": "eliminated_qualifying_match"
            }
          ]
        },
        {
          "id": "final_history",
          "text": "Rivedo entrambi i match.",
          "goto": "history"
        }
      ]
    },
    "history": {
      "stitches": [
        {
          "id": "s1",
          "text": "L'ufficiale sfoglia il registro degli incontri. Ogni pagina riporta avversari, data e risultato, senza spazi per correzioni arbitrarie."
        }
      ],
      "choices": [
        {
          "id": "history_classify",
          "text": "Torno alla classificazione.",
          "goto": "classify"
        },
        {
          "id": "history_cynthia",
          "text": "Rileggo il risultato attraverso il benchmark di Cynthia.",
          "goto": "cynthia_callback"
        },
        {
          "id": "history_friend",
          "text": "Controllo il ricordo del incontro con un amico.",
          "goto": "friend_callback"
        }
      ]
    },
    "world_guard": {
      "stitches": [
        {
          "id": "s1",
          "text": "La licenza Rank S è ancora nel tuo portafoglio, ma il posto al Mondiale dipende dai risultati appena certificati."
        }
      ],
      "choices": [
        {
          "id": "guard_qualified",
          "text": "La percorso di gara è qualificata: posso registrarla.",
          "goto": "qualified_record",
          "conditions": {
            "path": "world.flags.m7_qualifier_bracket_result",
            "eq": "qualified"
          }
        },
        {
          "id": "guard_classify",
          "text": "Torno alla classificazione.",
          "goto": "classify"
        }
      ]
    },
    "cynthia_callback": {
      "stitches": [
        {
          "id": "s1",
          "text": "Ripensi alle parole di Cynthia sul rischio e sulle risorse. Il tabellone, però, registra ciò che è accaduto, non ciò che avresti potuto fare."
        }
      ],
      "choices": [
        {
          "id": "cynthia_pressure",
          "text": "Rifletto su come gestire il risultato pubblico.",
          "goto": "pressure_response"
        },
        {
          "id": "cynthia_classify",
          "text": "Torno alla classificazione.",
          "goto": "classify"
        }
      ]
    },
    "friend_callback": {
      "stitches": [
        {
          "id": "s1",
          "text": "Sul telefono appare una notifica del gruppo. Ognuno dei tuoi amici ha ancora il proprio calendario e i propri risultati."
        }
      ],
      "choices": [
        {
          "id": "friend_pressure",
          "text": "Rifletto sulla divergenza fra carriere.",
          "goto": "pressure_response"
        },
        {
          "id": "friend_history",
          "text": "Torno alla registro degli incontri.",
          "goto": "history"
        }
      ]
    },
    "media_callback": {
      "stitches": [
        {
          "id": "s1",
          "text": "Fuori dallo sportello, i giornalisti attendono la comunicazione. Gli sponsor possono commentarla, non modificarla."
        }
      ],
      "choices": [
        {
          "id": "media_pressure",
          "text": "Gestisco la conseguenza pubblica.",
          "goto": "pressure_response"
        },
        {
          "id": "media_classify",
          "text": "Torno alla classificazione.",
          "goto": "classify"
        }
      ]
    },
    "qualified_record": {
      "stitches": [
        {
          "id": "s1",
          "text": "L'ufficiale firma la conferma e ti consegna il documento che attesta la qualificazione."
        }
      ],
      "choices": [
        {
          "id": "qualified_commit",
          "text": "Segno qualificazione al Mondiale=true.",
          "goto": "qualified_close",
          "conditions": {
            "path": "world.flags.m7_qualifier_bracket_result",
            "eq": "qualified"
          },
          "effects": [
            {
              "type": "set_flag",
              "key": "world_qualified",
              "value": true
            },
            {
              "type": "set_flag",
              "key": "m7_qualifier_result",
              "value": "qualified"
            },
            {
              "type": "set_flag",
              "key": "last_chance_eligible",
              "value": false
            },
            {
              "type": "set_flag",
              "key": "m7_qualifier_result_resolved",
              "value": true
            }
          ]
        },
        {
          "id": "qualified_back",
          "text": "Rivedo la classificazione prima di confermare.",
          "goto": "classify"
        }
      ]
    },
    "eliminated_record": {
      "stitches": [
        {
          "id": "s1",
          "text": "L'ufficiale chiude la pratica del percorso principale. Se esiste un'ultima occasione prevista dal calendario, sarà una competizione diversa."
        }
      ],
      "choices": [
        {
          "id": "elimination_confirm",
          "text": "Registro l'eliminazione e l'requisiti Last Chance.",
          "goto": "last_chance_explain",
          "effects": [
            {
              "type": "set_flag",
              "key": "world_qualified",
              "value": false
            },
            {
              "type": "set_flag",
              "key": "last_chance_eligible",
              "value": true
            },
            {
              "type": "set_flag",
              "key": "m7_qualifier_result_resolved",
              "value": true
            }
          ]
        },
        {
          "id": "elimination_back",
          "text": "Rivedo la registro degli incontri prima di confermare.",
          "goto": "history"
        }
      ]
    },
    "last_chance_explain": {
      "stitches": [
        {
          "id": "s1",
          "text": "«L'ultima occasione è un evento a parte», precisa l'addetto. «Non cancella la sconfitta di oggi e non si ripete.»"
        }
      ],
      "choices": [
        {
          "id": "lastchance_gate",
          "text": "Passo al gate Last Chance.",
          "goto": "eliminated_close"
        },
        {
          "id": "lastchance_media",
          "text": "Prima affronto la conseguenza pubblica.",
          "goto": "media_callback"
        }
      ]
    },
    "pressure_response": {
      "stitches": [
        {
          "id": "s1",
          "text": "Le telecamere si accendono davanti al banco. Qualcuno chiede una dichiarazione; il risultato è già visibile alle tue spalle."
        }
      ],
      "choices": [
        {
          "id": "pressure_media",
          "text": "Ricollego media e sponsor al risultato.",
          "goto": "media_callback"
        },
        {
          "id": "pressure_save",
          "text": "Controllo che lo stato sia ormai persistente.",
          "goto": "save_guard"
        }
      ]
    },
    "save_guard": {
      "stitches": [
        {
          "id": "s1",
          "text": "L'ufficiale appone il timbro definitivo. «Questo incontro è già stato registrato. Non si apre una seconda pratica per lo stesso risultato.»"
        }
      ],
      "choices": [
        {
          "id": "save_classify",
          "text": "Rivedo la classificazione.",
          "goto": "classify"
        },
        {
          "id": "save_close",
          "text": "Chiudo il riepilogo corrente.",
          "goto": "result_close"
        }
      ]
    },
    "qualified_close": {
      "stitches": [
        {
          "id": "s1",
          "text": "La conferma del posto al Mondiale è nelle tue mani. Non hai motivo di entrare nel torneo di ultima occasione."
        }
      ],
      "choices": [
        {
          "id": "qualified_gate",
          "text": "Passo comunque al gate di instradamento.",
          "goto": "m07-last-chance-gate#gate_entry"
        },
        {
          "id": "qualified_pressure",
          "text": "Gestisco prima l'attenzione pubblica.",
          "goto": "pressure_response"
        }
      ]
    },
    "eliminated_close": {
      "stitches": [
        {
          "id": "s1",
          "text": "La corsa principale è terminata. Sul calendario compare ancora, se accessibile, l'evento di ultima occasione."
        }
      ],
      "choices": [
        {
          "id": "eliminated_gate",
          "text": "Passo al gate Last Chance.",
          "goto": "m07-last-chance-gate#gate_entry"
        },
        {
          "id": "eliminated_history",
          "text": "Rivedo il percorso prima di uscire.",
          "goto": "history"
        }
      ]
    },
    "result_close": {
      "stitches": [
        {
          "id": "s1",
          "text": "Lasci lo sportello mentre gli addetti chiamano il prossimo allenatore. Il tabellone alle tue spalle non cambia."
        }
      ],
      "choices": [
        {
          "id": "close_gate",
          "text": "Passo al gate di instradamento.",
          "goto": "m07-last-chance-gate#gate_entry"
        },
        {
          "id": "close_history",
          "text": "Rileggo la registro degli incontri.",
          "goto": "history"
        }
      ]
    }
  }
}
