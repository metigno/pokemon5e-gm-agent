{
  "schemaVersion": 1,
  "id": "m07-qualifier-result",
  "moduleId": "M07",
  "title": "M7_08 — Qualifier Result",
  "locationId": "meridiana_grand_hall",
  "entryNodeId": "result_entry",
  "conditions": {
    "all": [
      {
        "path": "world.flags.m6_complete",
        "eq": true
      },
      {
        "path": "world.flags.m07_unlocked",
        "eq": true
      },
      {
        "path": "world.flags.m7_active",
        "eq": true
      },
      {
        "path": "competition.rank",
        "eq": "S"
      },
      {
        "path": "world.flags.m7_qualifier_complete",
        "eq": true
      }
    ]
  },
  "nodes": {
    "result_entry": {
      "stitches": [
        {
          "id": "s1",
          "text": "Dopo gli incontri torni al grande tabellone del Qualifier. Il personale aggiorna i risultati davanti a tutti i partecipanti."
        }
      ],
      "choices": [
        {
          "id": "entry_classify",
          "text": "Classifico il risultato reale.",
          "goto": "classify"
        },
        {
          "id": "entry_history",
          "text": "Rivedo prima la history E5.",
          "goto": "history"
        },
        {
          "id": "entry_guard",
          "text": "Controllo il guardrail world_qualified.",
          "goto": "world_guard"
        }
      ]
    },
    "classify": {
      "stitches": [
        {
          "id": "s1",
          "text": "Sul registro puoi vedere se hai conquistato il posto mondiale, perso al primo turno oppure raggiunto senza successo la partita decisiva."
        }
      ],
      "choices": [
        {
          "id": "classify_qualified",
          "text": "La lane è stata vinta.",
          "goto": "qualified_summary",
          "conditions": {
            "path": "world.flags.m7_qualifier_bracket_result",
            "eq": "qualified"
          }
        },
        {
          "id": "classify_r1",
          "text": "Sono uscito al Round 1.",
          "goto": "eliminated_r1",
          "conditions": {
            "path": "world.flags.m7_qualifier_bracket_result",
            "eq": "eliminated_round1"
          }
        },
        {
          "id": "classify_final",
          "text": "Sono uscito nel Qualifying Match.",
          "goto": "eliminated_final",
          "conditions": {
            "path": "world.flags.m7_qualifier_bracket_result",
            "eq": "eliminated_qualifying_match"
          }
        }
      ]
    },
    "qualified_summary": {
      "stitches": [
        {
          "id": "s1",
          "text": "Hai vinto entrambe le partite della selezione. L'addetta prepara il documento che conferma il posto conquistato al Mondiale."
        }
      ],
      "choices": [
        {
          "id": "qualified_guard",
          "text": "Verifico il guardrail prima di scrivere world_qualified.",
          "goto": "world_guard"
        },
        {
          "id": "qualified_record",
          "text": "Registro la qualificazione persistente.",
          "goto": "qualified_record"
        },
        {
          "id": "qualified_history",
          "text": "Rivedo le due vittorie in history.",
          "goto": "history"
        }
      ]
    },
    "eliminated_r1": {
      "stitches": [
        {
          "id": "s1",
          "text": "La sconfitta al primo turno è accanto al tuo nome. L'avversario è passato avanti; la tua prima corsa si chiude qui."
        }
      ],
      "choices": [
        {
          "id": "r1_record",
          "text": "Registro eliminazione Round 1.",
          "goto": "eliminated_record",
          "effects": [
            {
              "type": "set_flag",
              "key": "m7_qualifier_result",
              "value": "eliminated_round1"
            }
          ]
        },
        {
          "id": "r1_history",
          "text": "Rivedo la history del primo match.",
          "goto": "history"
        }
      ]
    },
    "eliminated_final": {
      "stitches": [
        {
          "id": "s1",
          "text": "Hai superato un avversario, ma il secondo incontro ti ha fermato. Arrivare vicino alla qualificazione non equivale a conquistarla."
        }
      ],
      "choices": [
        {
          "id": "final_record",
          "text": "Registro eliminazione nel Qualifying Match.",
          "goto": "eliminated_record",
          "effects": [
            {
              "type": "set_flag",
              "key": "m7_qualifier_result",
              "value": "eliminated_qualifying_match"
            }
          ]
        },
        {
          "id": "final_history",
          "text": "Rivedo entrambi i match.",
          "goto": "history"
        }
      ]
    },
    "history": {
      "stitches": [
        {
          "id": "s1",
          "text": "I referti mostrano incontri, avversari e verdetti. Non puoi cambiare una sconfitta correggendo il racconto che ne fai."
        }
      ],
      "choices": [
        {
          "id": "history_classify",
          "text": "Torno alla classificazione.",
          "goto": "classify"
        },
        {
          "id": "history_cynthia",
          "text": "Rileggo il risultato attraverso il benchmark di Cynthia.",
          "goto": "cynthia_callback"
        },
        {
          "id": "history_friend",
          "text": "Controllo il callback del Friend Beat 07.",
          "goto": "friend_callback"
        }
      ]
    },
    "world_guard": {
      "stitches": [
        {
          "id": "s1",
          "text": "L'accredito mondiale viene consegnato soltanto a chi ha vinto il percorso previsto. Una buona licenza non sostituisce le due vittorie."
        }
      ],
      "choices": [
        {
          "id": "guard_qualified",
          "text": "La lane è qualificata: posso registrarla.",
          "goto": "qualified_record",
          "conditions": {
            "path": "world.flags.m7_qualifier_bracket_result",
            "eq": "qualified"
          }
        },
        {
          "id": "guard_classify",
          "text": "Torno alla classificazione.",
          "goto": "classify"
        }
      ]
    },
    "cynthia_callback": {
      "stitches": [
        {
          "id": "s1",
          "text": "Se ripensi a Cynthia, forse consideri quali risorse sono rimaste e quali hai speso. Il suo consiglio non muta il tabellone."
        }
      ],
      "choices": [
        {
          "id": "cynthia_pressure",
          "text": "Rifletto su come gestire il risultato pubblico.",
          "goto": "pressure_response"
        },
        {
          "id": "cynthia_classify",
          "text": "Torno alla classificazione.",
          "goto": "classify"
        }
      ]
    },
    "friend_callback": {
      "stitches": [
        {
          "id": "s1",
          "text": "Un amico può averti scritto dopo la gara. La sua stagione può essere più fortunata, meno fortunata o semplicemente diversa dalla tua."
        }
      ],
      "choices": [
        {
          "id": "friend_pressure",
          "text": "Rifletto sulla divergenza fra carriere.",
          "goto": "pressure_response"
        },
        {
          "id": "friend_history",
          "text": "Torno alla history.",
          "goto": "history"
        }
      ]
    },
    "media_callback": {
      "stitches": [
        {
          "id": "s1",
          "text": "Le telecamere chiedono un commento al verdetto. Le tue parole saranno pubbliche; il risultato è già stato registrato."
        }
      ],
      "choices": [
        {
          "id": "media_pressure",
          "text": "Gestisco la conseguenza pubblica.",
          "goto": "pressure_response"
        },
        {
          "id": "media_classify",
          "text": "Torno alla classificazione.",
          "goto": "classify"
        }
      ]
    },
    "qualified_record": {
      "stitches": [
        {
          "id": "s1",
          "text": "Un funzionario controlla i referti e firma l'ammissione al Mondiale. Ora il tuo nome entra fra i partecipanti."
        }
      ],
      "choices": [
        {
          "id": "qualified_commit",
          "text": "Segno world_qualified=true.",
          "goto": "qualified_close",
          "conditions": {
            "path": "world.flags.m7_qualifier_bracket_result",
            "eq": "qualified"
          },
          "effects": [
            {
              "type": "set_flag",
              "key": "world_qualified",
              "value": true
            },
            {
              "type": "set_flag",
              "key": "m7_qualifier_result",
              "value": "qualified"
            },
            {
              "type": "set_flag",
              "key": "last_chance_eligible",
              "value": false
            },
            {
              "type": "set_flag",
              "key": "m7_qualifier_result_resolved",
              "value": true
            }
          ]
        },
        {
          "id": "qualified_back",
          "text": "Rivedo la classificazione prima di confermare.",
          "goto": "classify"
        }
      ]
    },
    "eliminated_record": {
      "stitches": [
        {
          "id": "s1",
          "text": "La segretaria archivia l'eliminazione della prima selezione. Se esiste un'ultima possibilità, verrà annunciata separatamente."
        }
      ],
      "choices": [
        {
          "id": "elimination_confirm",
          "text": "Registro l'eliminazione e l'eligibility Last Chance.",
          "goto": "last_chance_explain",
          "effects": [
            {
              "type": "set_flag",
              "key": "world_qualified",
              "value": false
            },
            {
              "type": "set_flag",
              "key": "last_chance_eligible",
              "value": true
            },
            {
              "type": "set_flag",
              "key": "m7_qualifier_result_resolved",
              "value": true
            }
          ]
        },
        {
          "id": "elimination_back",
          "text": "Rivedo la history prima di confermare.",
          "goto": "history"
        }
      ]
    },
    "last_chance_explain": {
      "stitches": [
        {
          "id": "s1",
          "text": "Sulla bacheca compare un avviso per una selezione straordinaria riservata agli aventi diritto. Non ripeterà le partite che hai già giocato."
        }
      ],
      "choices": [
        {
          "id": "lastchance_gate",
          "text": "Passo al gate Last Chance.",
          "goto": "eliminated_close"
        },
        {
          "id": "lastchance_media",
          "text": "Prima affronto la conseguenza pubblica.",
          "goto": "media_callback"
        }
      ]
    },
    "pressure_response": {
      "stitches": [
        {
          "id": "s1",
          "text": "Attorno a te alcuni festeggiano, altri lasciano l'arena in silenzio. Puoi decidere come presentarti agli altri senza essere obbligato a sentirti in un certo modo."
        }
      ],
      "choices": [
        {
          "id": "pressure_media",
          "text": "Ricollego media e sponsor al risultato.",
          "goto": "media_callback"
        },
        {
          "id": "pressure_save",
          "text": "Controllo che lo stato sia ormai persistente.",
          "goto": "save_guard"
        }
      ]
    },
    "save_guard": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il referto porta data, firme e nomi degli arbitri. Una seconda consultazione non cambia quanto è accaduto."
        }
      ],
      "choices": [
        {
          "id": "save_classify",
          "text": "Rivedo la classificazione.",
          "goto": "classify"
        },
        {
          "id": "save_close",
          "text": "Chiudo il riepilogo corrente.",
          "goto": "result_close"
        }
      ]
    },
    "qualified_close": {
      "stitches": [
        {
          "id": "s1",
          "text": "La qualificazione è ufficiale. Un altro tentativo riservato agli esclusi non ti riguarda."
        }
      ],
      "choices": [
        {
          "id": "qualified_gate",
          "text": "Passo comunque al gate di instradamento.",
          "goto": "m07-last-chance-gate#gate_entry"
        },
        {
          "id": "qualified_pressure",
          "text": "Gestisco prima l'attenzione pubblica.",
          "goto": "pressure_response"
        }
      ]
    },
    "eliminated_close": {
      "stitches": [
        {
          "id": "s1",
          "text": "La selezione principale è terminata. Se il tuo nome comparirà nell'ultima convocazione potrai giocare ancora una volta."
        }
      ],
      "choices": [
        {
          "id": "eliminated_gate",
          "text": "Passo al gate Last Chance.",
          "goto": "m07-last-chance-gate#gate_entry"
        },
        {
          "id": "eliminated_history",
          "text": "Rivedo il percorso prima di uscire.",
          "goto": "history"
        }
      ]
    },
    "result_close": {
      "stitches": [
        {
          "id": "s1",
          "text": "Lasci il tabellone con un esito reale. La prossima strada dipende da quel verdetto."
        }
      ],
      "choices": [
        {
          "id": "close_gate",
          "text": "Passo al gate di instradamento.",
          "goto": "m07-last-chance-gate#gate_entry"
        },
        {
          "id": "close_history",
          "text": "Rileggo la history.",
          "goto": "history"
        }
      ]
    }
  }
}
