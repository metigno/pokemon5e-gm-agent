{
  "schemaVersion": 1,
  "id": "m10-world-qf",
  "moduleId": "M10",
  "title": "M10_07 — World QF",
  "locationId": "world_knockout_hall",
  "entryNodeId": "qf_entry",
  "conditions": {
    "all": [
      {
        "path": "world.flags.m10_qf_prep_complete",
        "eq": true
      },
      {
        "path": "competition.world.knockout.playerAdvancedToQf",
        "eq": true
      },
      {
        "path": "competition.world.knockout.playerQfMatchId",
        "exists": true
      }
    ]
  },
  "nodes": {
    "qf_entry": {
      "stitches": [
        {
          "id": "s1",
          "text": "È il giorno dei quarti. L'arena si prepara a un incontro senza ripescaggio: chi perde dovrà abbandonare la corsa al titolo."
        }
      ],
      "choices": [
        {
          "id": "entry_opponent",
          "text": "Apro la scheda dell'avversario reale.",
          "goto": "opponent_card"
        },
        {
          "id": "entry_rules",
          "text": "Rileggo le regole ufficiali.",
          "goto": "rules"
        },
        {
          "id": "entry_pressure",
          "text": "Guardo la pressione degli altri quarti.",
          "goto": "world_pressure"
        }
      ]
    },
    "opponent_card": {
      "stitches": [
        {
          "id": "s1",
          "text": "Sul tabellone è scritto il tuo avversario: {{competition.world.knockout.playerQfOpponent.name}}. È il nome uscito dagli incontri precedenti, non quello scelto per creare uno spettacolo."
        }
      ],
      "choices": [
        {
          "id": "opponent_callback",
          "text": "Controllo i precedenti leciti.",
          "goto": "opponent_callback"
        },
        {
          "id": "opponent_roster",
          "text": "Controllo il mio roster.",
          "goto": "roster_state"
        },
        {
          "id": "opponent_ready",
          "text": "Passo alla readiness.",
          "goto": "readiness"
        }
      ]
    },
    "opponent_callback": {
      "stitches": [
        {
          "id": "s1",
          "text": "Se vi siete già incontrati, potreste riconoscere gesti e abitudini. Il passato può rendere il saluto più teso, non cambiare il verdetto."
        }
      ],
      "choices": [
        {
          "id": "callback_pressure",
          "text": "Ragiono sulla pressione del duello.",
          "goto": "pressure"
        },
        {
          "id": "callback_ready",
          "text": "Chiudo il callback.",
          "goto": "readiness"
        }
      ]
    },
    "rules": {
      "stitches": [
        {
          "id": "s1",
          "text": "L'arbitro ricorda il formato Singles, sei Pokémon ufficiali. Una vittoria apre la strada alle semifinali; una sconfitta chiude il percorso."
        }
      ],
      "choices": [
        {
          "id": "rules_roster",
          "text": "Controllo la squadra.",
          "goto": "roster_state"
        },
        {
          "id": "rules_integrity",
          "text": "Controllo l'idempotenza.",
          "goto": "match_integrity"
        },
        {
          "id": "rules_ready",
          "text": "Passo alla readiness.",
          "goto": "readiness"
        }
      ]
    },
    "roster_state": {
      "stitches": [
        {
          "id": "s1",
          "text": "Prima di entrare conti i sei Pokémon idonei. Nessuno viene sostituito o guarito per il solo fatto di essere arrivato fin qui."
        }
      ],
      "choices": [
        {
          "id": "roster_resources",
          "text": "Controllo HP/PP persistenti.",
          "goto": "resources_before"
        },
        {
          "id": "roster_ready",
          "text": "Procedo alla readiness.",
          "goto": "readiness"
        }
      ]
    },
    "resources_before": {
      "stitches": [
        {
          "id": "s1",
          "text": "La squadra conserva la fatica delle gare precedenti e delle cure effettivamente fatte. Controlli cosa puoi ancora usare."
        }
      ],
      "choices": [
        {
          "id": "resources_risk",
          "text": "Valuto il rischio di entrare così.",
          "goto": "pressure"
        },
        {
          "id": "resources_ready",
          "text": "Accetto lo stato.",
          "goto": "readiness"
        }
      ]
    },
    "pressure": {
      "stitches": [
        {
          "id": "s1",
          "text": "Gli spalti sono pieni e il margine d'errore è minimo. La pressione si sente nei gesti e nelle scelte, non cambia magicamente la forza dei Pokémon."
        }
      ],
      "choices": [
        {
          "id": "pressure_world",
          "text": "Guardo gli altri quarti.",
          "goto": "world_pressure"
        },
        {
          "id": "pressure_ready",
          "text": "Torno al mio match.",
          "goto": "readiness"
        }
      ]
    },
    "world_pressure": {
      "stitches": [
        {
          "id": "s1",
          "text": "Sugli altri campi sono previsti anche gli altri incontri dei quarti. Le loro vittorie e sconfitte non aspettano il tuo consenso."
        }
      ],
      "choices": [
        {
          "id": "world_integrity",
          "text": "Controllo come evitare doppi risultati.",
          "goto": "match_integrity"
        },
        {
          "id": "world_ready",
          "text": "Torno alla readiness.",
          "goto": "readiness"
        }
      ]
    },
    "match_integrity": {
      "stitches": [
        {
          "id": "s1",
          "text": "L'ufficiale controlla il referto. Se questa partita è già stata giocata non può essere ripetuta per ottenere un risultato diverso."
        }
      ],
      "choices": [
        {
          "id": "integrity_rules",
          "text": "Rivedo le regole.",
          "goto": "rules"
        },
        {
          "id": "integrity_handoff",
          "text": "Passo al bridge.",
          "goto": "match_handoff"
        }
      ]
    },
    "readiness": {
      "stitches": [
        {
          "id": "s1",
          "text": "Alla chiamata dell'arbitro confermi accredito e squadra. Il prossimo passo è presentarti sul terreno di gara."
        }
      ],
      "choices": [
        {
          "id": "ready_handoff",
          "text": "Avvio la procedura ufficiale.",
          "goto": "match_handoff"
        },
        {
          "id": "ready_back",
          "text": "Torno all'avversario.",
          "goto": "opponent_card"
        },
        {
          "id": "ready_pressure",
          "text": "Rileggo il rischio.",
          "goto": "pressure"
        }
      ]
    },
    "match_handoff": {
      "stitches": [
        {
          "id": "s1",
          "text": "{{competition.world.knockout.playerQfOpponent.name}} si schiera dall'altra parte. L'arbitro solleva il braccio: lo scontro comincia."
        }
      ],
      "choices": [
        {
          "id": "fight_qf",
          "text": "Combatto il quarto di finale.",
          "combat": {
            "encounterId": "WORLD_QF_PLAYER",
            "opponentRegistered": true,
            "competition": {
              "type": "official_match",
              "matchId": "WORLD_QF_PLAYER",
              "format": "Singles",
              "officialRosterSize": 6,
              "difficulty": "ELITE",
              "worldKnockoutRound": "QF"
            },
            "returnNodes": {
              "win": "win_return",
              "lose": "loss_return"
            },
            "goto": "match_handoff"
          },
          "conditions": {
            "path": "world.flags.world_qf_resolved",
            "ne": true
          }
        },
        {
          "id": "handoff_back",
          "text": "Non entro ancora: torno alla readiness.",
          "goto": "readiness"
        }
      ]
    },
    "win_return": {
      "stitches": [
        {
          "id": "s1",
          "text": "Hai vinto. Gli spalti reagiscono e il tabellone ti avvicina alle semifinali, mentre gli altri incontri devono ancora concludersi."
        }
      ],
      "choices": [
        {
          "id": "win_record",
          "text": "Registro la chiusura narrativa del mio QF.",
          "goto": "result_record",
          "effects": [
            {
              "type": "set_flag",
              "key": "m10_world_qf_complete",
              "value": true
            }
          ]
        },
        {
          "id": "win_resources",
          "text": "Controllo ciò che resta al team.",
          "goto": "resources_after",
          "effects": [
            {
              "type": "set_flag",
              "key": "m10_world_qf_complete",
              "value": true
            }
          ]
        }
      ]
    },
    "loss_return": {
      "stitches": [
        {
          "id": "s1",
          "text": "Hai perso ai quarti. Il verdetto chiude la tua corsa al titolo in questa edizione; i tuoi amici e gli altri allenatori proseguiranno secondo i propri risultati."
        }
      ],
      "choices": [
        {
          "id": "loss_record",
          "text": "Registro la chiusura narrativa del QF.",
          "goto": "result_record",
          "effects": [
            {
              "type": "set_flag",
              "key": "m10_world_qf_complete",
              "value": true
            }
          ]
        },
        {
          "id": "loss_resources",
          "text": "Controllo lo stato del team.",
          "goto": "resources_after",
          "effects": [
            {
              "type": "set_flag",
              "key": "m10_world_qf_complete",
              "value": true
            }
          ]
        }
      ]
    },
    "result_record": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il personale firma il referto della partita, con entrambi i nomi e il risultato effettivo."
        }
      ],
      "choices": [
        {
          "id": "record_outcome",
          "text": "Leggo la conseguenza competitiva.",
          "goto": "outcome_meaning"
        },
        {
          "id": "record_resources",
          "text": "Controllo le risorse persistenti.",
          "goto": "resources_after"
        },
        {
          "id": "record_world",
          "text": "Guardo gli altri QF.",
          "goto": "other_qf"
        }
      ]
    },
    "outcome_meaning": {
      "stitches": [
        {
          "id": "s1",
          "text": "Se hai vinto puoi prepararti per il Final Four; se hai perso, il torneo continuerà senza di te. Nessun commento della stampa cambia l'esito."
        }
      ],
      "choices": [
        {
          "id": "outcome_other",
          "text": "Passo agli altri risultati QF.",
          "goto": "other_qf"
        },
        {
          "id": "outcome_history",
          "text": "Rileggo l'audit history.",
          "goto": "history_audit"
        }
      ]
    },
    "resources_after": {
      "stitches": [
        {
          "id": "s1",
          "text": "Al termine controlli i Pokémon. Le ferite e le risorse consumate rimangono reali, qualunque sia il risultato."
        }
      ],
      "choices": [
        {
          "id": "resources_history",
          "text": "Controllo il record unico.",
          "goto": "history_audit"
        },
        {
          "id": "resources_next",
          "text": "Passo al gate dell'aftermath.",
          "goto": "aftermath_gate"
        }
      ]
    },
    "other_qf": {
      "stitches": [
        {
          "id": "s1",
          "text": "Gli altri tre quarti si giocano senza protezioni per nomi famosi o amicizie. Ogni partecipante deve conquistare la semifinale."
        }
      ],
      "choices": [
        {
          "id": "other_friend",
          "text": "Controllo il caso di un amico nel Top8.",
          "goto": "friend_context"
        },
        {
          "id": "other_gate",
          "text": "Vado al gate dell'aftermath.",
          "goto": "aftermath_gate"
        }
      ]
    },
    "friend_context": {
      "stitches": [
        {
          "id": "s1",
          "text": "Un amico ancora in gara potrà avanzare o fermarsi secondo il suo incontro. Se l'avversario sei stato tu, conta il risultato appena ottenuto."
        }
      ],
      "choices": [
        {
          "id": "friend_world",
          "text": "Torno al quadro dei quarti.",
          "goto": "other_qf"
        },
        {
          "id": "friend_gate",
          "text": "Procedo al gate.",
          "goto": "aftermath_gate"
        }
      ]
    },
    "history_audit": {
      "stitches": [
        {
          "id": "s1",
          "text": "Rileggi il referto conservato dall'organizzazione. La partita compare una volta sola, accanto agli incontri già disputati."
        }
      ],
      "choices": [
        {
          "id": "history_integrity",
          "text": "Rileggo l'idempotenza.",
          "goto": "match_integrity"
        },
        {
          "id": "history_gate",
          "text": "Passo al gate.",
          "goto": "aftermath_gate"
        }
      ]
    },
    "aftermath_gate": {
      "stitches": [
        {
          "id": "s1",
          "text": "La segreteria attende il verdetto di questa partita prima di chiudere tutti gli incontri dei quarti."
        }
      ],
      "choices": [
        {
          "id": "gate_aftermath",
          "text": "Apro il QF Aftermath.",
          "goto": "m10-qf-aftermath#aftermath_entry"
        },
        {
          "id": "gate_review",
          "text": "Rivedo il record.",
          "goto": "qf_complete"
        }
      ]
    },
    "qf_complete": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il tuo incontro dei quarti è terminato. Restano i risultati sugli altri campi prima dell'annuncio del turno successivo."
        }
      ],
      "choices": [
        {
          "id": "complete_gate",
          "text": "Procedo all'aftermath.",
          "goto": "aftermath_gate"
        },
        {
          "id": "complete_history",
          "text": "Rileggo l'history.",
          "goto": "history_audit"
        }
      ]
    }
  }
}
