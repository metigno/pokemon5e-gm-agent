{
  "schemaVersion": 1,
  "id": "m08-registration",
  "moduleId": "M08",
  "title": "M8_03 — Registration",
  "locationId": "world_registration_desk",
  "entryNodeId": "registration_entry",
  "conditions": {
    "all": [
      {
        "path": "world.flags.m7_complete",
        "eq": true
      },
      {
        "path": "world.flags.m08_unlocked",
        "eq": true
      },
      {
        "path": "world.flags.world_qualified",
        "eq": true
      },
      {
        "path": "world.flags.m7_before_lights_complete",
        "eq": true
      },
      {
        "path": "world.flags.m8_active",
        "eq": true
      },
      {
        "path": "world.flags.m8_world_arrived",
        "eq": true
      },
      {
        "path": "world.flags.m8_accreditation_complete",
        "eq": true
      },
      {
        "path": "world.flags.m8_medical_control_complete",
        "eq": true
      }
    ]
  },
  "nodes": {
    "registration_entry": {
      "stitches": [
        {
          "id": "s1",
          "text": "Al banco iscrizioni del Mondiale gli addetti raccolgono i documenti degli allenatori già qualificati. Il tuo nome è sul registro, ma serve ancora la firma definitiva."
        }
      ],
      "choices": [
        {
          "id": "entry_eligibility",
          "text": "Controllo l'eligibility amministrativa.",
          "goto": "eligibility"
        },
        {
          "id": "entry_rules",
          "text": "Rileggo formato e lock.",
          "goto": "rules"
        },
        {
          "id": "entry_defer",
          "text": "Rimando la registrazione.",
          "goto": "defer"
        }
      ]
    },
    "eligibility": {
      "stitches": [
        {
          "id": "s1",
          "text": "La segretaria controlla qualificazione, visita medica e sei Pokémon idonei. Nessun requisito può essere sostituito da una promessa."
        }
      ],
      "choices": [
        {
          "id": "eligibility_qualified",
          "text": "Verifico la qualificazione salvata.",
          "goto": "qualification_status"
        },
        {
          "id": "eligibility_roster",
          "text": "Verifico il roster reale.",
          "goto": "roster_review"
        },
        {
          "id": "eligibility_medical",
          "text": "Verifico il gate medico.",
          "goto": "medical_gate"
        }
      ]
    },
    "qualification_status": {
      "stitches": [
        {
          "id": "s1",
          "text": "Mostri il documento ottenuto a Meridiana. La funzionaria ne verifica l'autenticità senza modificare come lo hai conquistato."
        }
      ],
      "choices": [
        {
          "id": "qualified_roster",
          "text": "Passo al roster.",
          "goto": "roster_review"
        },
        {
          "id": "qualified_rules",
          "text": "Torno alle regole.",
          "goto": "rules"
        }
      ]
    },
    "roster_review": {
      "stitches": [
        {
          "id": "s1",
          "text": "Gli addetti contano i Pokémon presenti. Sul campo potranno scendere soltanto quelli che possiedi e puoi effettivamente schierare."
        }
      ],
      "choices": [
        {
          "id": "roster_ready",
          "text": "Con almeno sei Pokémon passo al desk finale.",
          "goto": "registration_desk",
          "conditions": {
            "path": "player.roster.length",
            "gte": 6
          }
        },
        {
          "id": "roster_missing",
          "text": "Con meno di sei Pokémon non posso chiudere la registrazione.",
          "goto": "defer",
          "conditions": {
            "path": "player.roster.length",
            "lt": 6
          }
        }
      ]
    },
    "medical_gate": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il timbro della clinica prova che hai fatto la visita. Non significa che tutte le ferite siano guarite."
        }
      ],
      "choices": [
        {
          "id": "medical_desk",
          "text": "Passo al desk finale.",
          "goto": "registration_desk"
        },
        {
          "id": "medical_rules",
          "text": "Torno alle regole.",
          "goto": "rules"
        }
      ]
    },
    "rules": {
      "stitches": [
        {
          "id": "s1",
          "text": "L'ufficiale ripete il formato mondiale: Singles con sei Pokémon ufficiali. La squadra deve rispettare gli stessi requisiti degli altri concorrenti."
        }
      ],
      "choices": [
        {
          "id": "rules_lock",
          "text": "Capisco cosa significa lock amministrativo.",
          "goto": "lock_explainer"
        },
        {
          "id": "rules_eligibility",
          "text": "Torno all'eligibility.",
          "goto": "eligibility"
        }
      ]
    },
    "lock_explainer": {
      "stitches": [
        {
          "id": "s1",
          "text": "«Registriamo ciò che presenta davvero», spiega la segretaria. «Non ciò che vorrebbe avere con sé il giorno della partita.»"
        }
      ],
      "choices": [
        {
          "id": "lock_desk",
          "text": "Vado al desk finale.",
          "goto": "registration_desk"
        },
        {
          "id": "lock_rules",
          "text": "Torno alle regole.",
          "goto": "rules"
        }
      ]
    },
    "registration_desk": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il personale confronta tutte le autorizzazioni prima di chiudere la pratica. Se manca un requisito, dovrai risolverlo prima di iscriverti."
        }
      ],
      "choices": [
        {
          "id": "desk_confirm",
          "text": "Procedo alla conferma.",
          "goto": "confirmation",
          "conditions": {
            "all": [
              {
                "path": "world.flags.world_qualified",
                "eq": true
              },
              {
                "path": "world.flags.m8_medical_control_complete",
                "eq": true
              },
              {
                "path": "player.roster.length",
                "gte": 6
              }
            ]
          }
        },
        {
          "id": "desk_rules",
          "text": "Rivedo le regole.",
          "goto": "rules"
        },
        {
          "id": "desk_defer",
          "text": "Non firmo ancora.",
          "goto": "defer"
        }
      ]
    },
    "confirmation": {
      "stitches": [
        {
          "id": "s1",
          "text": "Firmi la partecipazione a questa edizione. Il nome del tuo futuro gruppo non è ancora stato annunciato."
        }
      ],
      "choices": [
        {
          "id": "confirm_register",
          "text": "Confermo la registrazione al Mondiale.",
          "goto": "registered",
          "conditions": {
            "all": [
              {
                "path": "world.flags.world_qualified",
                "eq": true
              },
              {
                "path": "world.flags.m8_medical_control_complete",
                "eq": true
              },
              {
                "path": "player.roster.length",
                "gte": 6
              },
              {
                "path": "world.flags.m8_world_registration_complete",
                "ne": true
              }
            ]
          },
          "effects": [
            {
              "type": "set_flag",
              "key": "m8_world_registration_complete",
              "value": true
            },
            {
              "type": "set_flag",
              "key": "m8_world_roster_registered",
              "value": true
            }
          ]
        },
        {
          "id": "confirm_back",
          "text": "Torno al desk senza firmare.",
          "goto": "registration_desk"
        }
      ]
    },
    "registered": {
      "stitches": [
        {
          "id": "s1",
          "text": "L'addetta ti consegna la conferma. Sei ufficialmente iscritto; il sorteggio e le partite devono ancora arrivare."
        }
      ],
      "choices": [
        {
          "id": "registered_village",
          "text": "Passo al World Village.",
          "goto": "complete"
        },
        {
          "id": "registered_rules",
          "text": "Rivedo il lock.",
          "goto": "lock_explainer"
        }
      ]
    },
    "defer": {
      "stitches": [
        {
          "id": "s1",
          "text": "Ti allontani dal banco senza firmare. La qualificazione resta tua, ma la pratica non è stata completata."
        }
      ],
      "choices": [
        {
          "id": "defer_hour",
          "text": "Aspetto un'ora e ricontrollo.",
          "goto": "registration_entry",
          "timeCostMinutes": 60
        },
        {
          "id": "defer_rules",
          "text": "Rileggo le regole prima di decidere.",
          "goto": "rules"
        }
      ]
    },
    "complete": {
      "stitches": [
        {
          "id": "s1",
          "text": "Esci con la registrazione in regola. Fuori ti aspettano le strade del Village e il programma dei prossimi giorni."
        }
      ],
      "choices": [
        {
          "id": "complete_village",
          "text": "Entro nel World Village.",
          "goto": "m08-world-village#village_entry"
        },
        {
          "id": "complete_registered",
          "text": "Resto allo stato registrato.",
          "goto": "registered"
        }
      ]
    }
  }
}
