{
  "schemaVersion": 1,
  "id": "m08-world-draw",
  "moduleId": "M08",
  "title": "M8_10 — World Draw",
  "locationId": "world_draw_hall",
  "entryNodeId": "draw_entry",
  "conditions": {
    "all": [
      {
        "path": "world.flags.m7_complete",
        "eq": true
      },
      {
        "path": "world.flags.m08_unlocked",
        "eq": true
      },
      {
        "path": "world.flags.world_qualified",
        "eq": true
      },
      {
        "path": "world.flags.m8_active",
        "eq": true
      },
      {
        "path": "world.flags.m8_world_registration_complete",
        "eq": true
      },
      {
        "path": "world.flags.m8_opening_ceremony_complete",
        "eq": true
      },
      {
        "path": "world.flags.friend_beat_08_complete",
        "eq": true
      }
    ]
  },
  "nodes": {
    "draw_entry": {
      "stitches": [
        {
          "id": "s1",
          "text": "Gli schermi del Grand Hall mostrano trentadue partecipanti e otto gruppi ancora vuoti. La sala tace quando comincia il sorteggio."
        }
      ],
      "choices": [
        {
          "id": "entry_authority",
          "text": "Controllo quale sistema possiede il sorteggio.",
          "goto": "authority"
        },
        {
          "id": "entry_field",
          "text": "Controllo da dove arrivano i 32 partecipanti.",
          "goto": "field_source"
        },
        {
          "id": "entry_ready",
          "text": "Passo alla preparazione del sorteggio.",
          "goto": "draw_preview"
        }
      ]
    },
    "authority": {
      "stitches": [
        {
          "id": "s1",
          "text": "Gli ufficiali controllano l'elenco degli ammessi e conducono l'estrazione davanti al pubblico. Nessuna intervista decide dove finiranno i nomi."
        }
      ],
      "choices": [
        {
          "id": "authority_actual",
          "text": "Controllo come vengono rispettati gli esiti reali.",
          "goto": "actual_state"
        },
        {
          "id": "authority_preview",
          "text": "Torno alla preparazione.",
          "goto": "draw_preview"
        }
      ]
    },
    "field_source": {
      "stitches": [
        {
          "id": "s1",
          "text": "Fra i trentadue compaiono allenatori del roster mondiale di quest'edizione. Il loro accesso dipende dalle qualificazioni realmente completate."
        }
      ],
      "choices": [
        {
          "id": "field_roster",
          "text": "Controllo la policy del roster canonico.",
          "goto": "roster_policy"
        },
        {
          "id": "field_friends",
          "text": "Controllo perché gli amici non sono garantiti.",
          "goto": "friend_policy"
        }
      ]
    },
    "actual_state": {
      "stitches": [
        {
          "id": "s1",
          "text": "Alcuni posti sono stati conquistati con gare già concluse; gli ultimi risultati arrivano dagli altri circuiti. Chi non si è qualificato non viene chiamato."
        }
      ],
      "choices": [
        {
          "id": "actual_anchor",
          "text": "Controllo le garanzie pre-Mondiale degli Anchor.",
          "goto": "anchor_policy"
        },
        {
          "id": "actual_integrity",
          "text": "Passo all'audit d'integrità.",
          "goto": "integrity"
        }
      ]
    },
    "roster_policy": {
      "stitches": [
        {
          "id": "s1",
          "text": "Sul grande schermo scorrono i nomi degli allenatori, non nuove squadre inventate per il sorteggio. Ognuno resta con i propri Pokémon."
        }
      ],
      "choices": [
        {
          "id": "roster_seed",
          "text": "Passo alla logica di seed.",
          "goto": "seed_policy"
        },
        {
          "id": "roster_field",
          "text": "Torno alla provenienza del field.",
          "goto": "field_source"
        }
      ]
    },
    "anchor_policy": {
      "stitches": [
        {
          "id": "s1",
          "text": "I nomi famosi ricevono applausi, ma non il diritto di scegliere gli avversari o di essere protetti dalle sconfitte."
        }
      ],
      "choices": [
        {
          "id": "anchor_seed",
          "text": "Passo alla logica di seed e gruppi.",
          "goto": "seed_policy"
        },
        {
          "id": "anchor_actual",
          "text": "Torno allo stato reale.",
          "goto": "actual_state"
        }
      ]
    },
    "friend_policy": {
      "stitches": [
        {
          "id": "s1",
          "text": "Cerchi Luke, Mattew, Daniel, Edward e Fab nell'elenco degli ammessi. Soltanto chi si è qualificato può comparire fra i trentadue."
        }
      ],
      "choices": [
        {
          "id": "friend_callbacks",
          "text": "Ricollego il Friend Beat senza alterare il field.",
          "goto": "callbacks"
        },
        {
          "id": "friend_field",
          "text": "Torno alla provenienza del field.",
          "goto": "field_source"
        }
      ]
    },
    "seed_policy": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il personale verifica la procedura di estrazione e ne conserva il verbale. Tornare a guardarlo non produrrà un gruppo differente."
        }
      ],
      "choices": [
        {
          "id": "seed_preview",
          "text": "Passo alla preview finale.",
          "goto": "draw_preview"
        },
        {
          "id": "seed_wait",
          "text": "Valuto se rimandare prima del lock.",
          "goto": "wait_window"
        }
      ]
    },
    "draw_preview": {
      "stitches": [
        {
          "id": "s1",
          "text": "Prima dell'estrazione definitiva puoi osservare l'elenco dei partecipanti. Presto gli accoppiamenti saranno ufficiali per questa edizione."
        }
      ],
      "choices": [
        {
          "id": "preview_field",
          "text": "Rivedo il field dei candidati.",
          "goto": "field_source"
        },
        {
          "id": "preview_integrity",
          "text": "Eseguo l'audit prima del lock.",
          "goto": "integrity"
        },
        {
          "id": "preview_commit",
          "text": "Vado al commit guard.",
          "goto": "commit_guard"
        }
      ]
    },
    "commit_guard": {
      "stitches": [
        {
          "id": "s1",
          "text": "Gli organizzatori attendono conferma delle iscrizioni, della cerimonia e dei documenti prima di dare inizio all'estrazione."
        }
      ],
      "choices": [
        {
          "id": "guard_execute",
          "text": "Eseguo il WORLD_DRAW canonico.",
          "goto": "execute_draw",
          "conditions": {
            "path": "competition.world.drawComplete",
            "eq": false
          }
        },
        {
          "id": "guard_existing",
          "text": "Il draw è già chiuso: apro lo stato lockato.",
          "goto": "draw_locked",
          "conditions": {
            "path": "competition.world.drawComplete",
            "eq": true
          }
        },
        {
          "id": "guard_preview",
          "text": "Torno alla preview.",
          "goto": "draw_preview"
        }
      ]
    },
    "execute_draw": {
      "stitches": [
        {
          "id": "s1",
          "text": "Una pallina viene estratta, poi un'altra. I nomi riempiono gli otto gruppi finché ognuno contiene quattro allenatori."
        }
      ],
      "choices": [
        {
          "id": "execute_now",
          "text": "Confermo il sorteggio una sola volta.",
          "goto": "draw_locked",
          "effects": [
            {
              "type": "competition_world_draw",
