          "text": "Non confermo ancora.",
          "goto": "commit_guard"
        }
      ]
    },
    "draw_locked": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il sorteggio è ora persistente: 32 partecipanti, otto gruppi, un gruppo player e tre avversari. Ricaricare non lo rigenera."
        }
      ],
      "choices": [
        {
          "id": "locked_summary",
          "text": "Controllo il riepilogo del gruppo.",
          "goto": "group_summary"
        },
        {
          "id": "locked_integrity",
          "text": "Verifico che il field resti a 32.",
          "goto": "integrity"
        },
        {
          "id": "locked_close",
          "text": "Passo alla chiusura del draw.",
          "goto": "draw_close"
        }
      ]
    },
    "group_summary": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il player è stato assegnato al Gruppo {{competition.world.playerGroup}}. I tre avversari sono già nello stato E5 ma verranno presentati nel blocco successivo."
        }
      ],
      "choices": [
        {
          "id": "summary_preview",
          "text": "Controllo il significato del gruppo.",
          "goto": "player_group_preview"
        },
        {
          "id": "summary_close",
          "text": "Passo alla chiusura del draw.",
          "goto": "draw_close"
        }
      ]
    },
    "player_group_preview": {
      "stitches": [
        {
          "id": "s1",
          "text": "Un gruppo da quattro produce esattamente tre match nel modulo M9. L'ordine degli avversari deriva dal draw persistente, non dalla narrazione."
        }
      ],
      "choices": [
        {
          "id": "group_integrity",
          "text": "Controllo ancora l'integrità del sorteggio.",
          "goto": "integrity"
        },
        {
          "id": "group_summary",
          "text": "Torno al riepilogo.",
          "goto": "group_summary"
        }
      ]
    },
    "integrity": {
      "stitches": [
        {
          "id": "s1",
          "text": "L'audit richiede field=32, seedOrder=32, gruppo player definito e tre avversari. Nessun duplicato o quarto avversario può essere aggiunto dal testo."
        }
      ],
      "choices": [
        {
          "id": "integrity_callbacks",
          "text": "Controllo i callback senza modificare il draw.",
          "goto": "callbacks"
        },
        {
          "id": "integrity_commit",
          "text": "Torno al commit guard.",
          "goto": "commit_guard"
        }
      ]
    },
    "callbacks": {
      "stitches": [
        {
          "id": "s1",
          "text": "Astrid, Friend Beat e media possono cambiare il tono della rivelazione. Non possono cambiare chi è stato sorteggiato."
        }
      ],
      "choices": [
        {
          "id": "callbacks_friend",
          "text": "Rileggo la policy sugli amici.",
          "goto": "friend_policy"
        },
        {
          "id": "callbacks_preview",
          "text": "Torno alla preview.",
          "goto": "draw_preview"
        }
      ]
    },
    "wait_window": {
      "stitches": [
        {
          "id": "s1",
          "text": "Rimandare consuma un'ora e lascia muovere il mondo, ma il seed della stessa carriera/edizione resta stabile."
        }
      ],
      "choices": [
        {
          "id": "wait_hour",
          "text": "Aspetto un'ora e torno al commit guard.",
          "goto": "commit_guard",
          "timeCostMinutes": 60
        },
        {
          "id": "wait_seed",
          "text": "Torno alla spiegazione del seed.",
          "goto": "seed_policy"
        }
      ]
    },
    "draw_close": {
      "stitches": [
        {
          "id": "s1",
          "text": "WORLD_DRAW è completo soltanto quando E5 conferma field e gruppi. Ora può iniziare la rivelazione formale del gruppo del player."
        }
      ],
      "choices": [
        {
          "id": "close_reveal",
          "text": "Passo al Group Reveal.",
          "goto": "m08-group-reveal#reveal_entry",
          "conditions": {
            "all": [
              {
                "path": "competition.world.drawComplete",
                "eq": true
              },
              {
                "path": "competition.world.fieldLocked",
                "eq": true
              },
              {
                "path": "competition.world.field.length",
                "eq": 32
              },
              {
                "path": "competition.world.playerOpponents.length",
                "eq": 3
              }
            ]
          }
        },
        {
          "id": "close_review",
          "text": "Rivedo il gruppo senza modificarlo.",
          "goto": "group_summary"
        }
      ]
