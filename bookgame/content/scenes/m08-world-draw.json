{
  "schemaVersion": 1,
  "id": "m08-world-draw",
  "moduleId": "M08",
  "title": "M8_10 — World Draw",
  "locationId": "world_draw_hall",
  "entryNodeId": "draw_entry",
  "conditions": {
    "all": [
      {
        "path": "world.flags.m7_complete",
        "eq": true
      },
      {
        "path": "world.flags.m08_unlocked",
        "eq": true
      },
      {
        "path": "world.flags.world_qualified",
        "eq": true
      },
      {
        "path": "world.flags.m8_active",
        "eq": true
      },
      {
        "path": "world.flags.m8_world_registration_complete",
        "eq": true
      },
      {
        "path": "world.flags.m8_opening_ceremony_complete",
        "eq": true
      },
      {
        "path": "world.flags.friend_beat_08_complete",
        "eq": true
      }
    ]
  },
  "nodes": {
    "draw_entry": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il WORLD_DRAW è l'ultimo checkpoint pre-M9. Deve congelare un field reale di 32 e generare gruppi una sola volta attraverso E5."
        }
      ],
      "choices": [
        {
          "id": "entry_authority",
          "text": "Controllo quale sistema possiede il sorteggio.",
          "goto": "authority"
        },
        {
          "id": "entry_field",
          "text": "Controllo da dove arrivano i 32 partecipanti.",
          "goto": "field_source"
        },
        {
          "id": "entry_ready",
          "text": "Passo alla preparazione del sorteggio.",
          "goto": "draw_preview"
        }
      ]
    },
    "authority": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il sorteggio appartiene al Competition subsystem E5. I flag narrativi possono soltanto riflettere lo stato strutturato, non sostituirlo."
        }
      ],
      "choices": [
        {
          "id": "authority_actual",
          "text": "Controllo come vengono rispettati gli esiti reali.",
          "goto": "actual_state"
        },
        {
          "id": "authority_preview",
          "text": "Torno alla preparazione.",
          "goto": "draw_preview"
        }
      ]
    },
    "field_source": {
      "stitches": [
        {
          "id": "s1",
          "text": "La base è il roster canonico 2060. Il field finale non copia risultati storici: usa qualificazioni NPC già note e simula solo le qualificazioni off-screen ancora irrisolte."
        }
      ],
      "choices": [
        {
          "id": "field_roster",
          "text": "Controllo la policy del roster canonico.",
          "goto": "roster_policy"
        },
        {
          "id": "field_friends",
          "text": "Controllo perché gli amici non sono garantiti.",
          "goto": "friend_policy"
        }
      ]
    },
    "actual_state": {
      "stitches": [
        {
          "id": "s1",
          "text": "Un NPC con worldQualified=true entra nel field; con false resta fuori. Solo gli stati ancora sconosciuti vengono risolti deterministicamente dal layer competitivo."
        }
      ],
      "choices": [
        {
          "id": "actual_anchor",
          "text": "Controllo le garanzie pre-Mondiale degli Anchor.",
          "goto": "anchor_policy"
        },
        {
          "id": "actual_integrity",
          "text": "Passo all'audit d'integrità.",
          "goto": "integrity"
        }
      ]
    },
    "roster_policy": {
      "stitches": [
        {
          "id": "s1",
          "text": "I team non vengono rigenerati dal draw. Il sorteggio conserva solo identità competitive; i roster di battaglia restano quelli persistenti del Trainer Encounter System."
        }
      ],
      "choices": [
        {
          "id": "roster_seed",
          "text": "Passo alla logica di seed.",
          "goto": "seed_policy"
        },
        {
          "id": "roster_field",
          "text": "Torno alla provenienza del field.",
          "goto": "field_source"
        }
      ]
    },
    "anchor_policy": {
      "stitches": [
        {
          "id": "s1",
          "text": "La macrotraiettoria può garantire prima del Mondiale alcuni Anchor necessari al payoff. Dal momento del draw in poi nessun Anchor è protetto da sconfitte o eliminazioni."
        }
      ],
      "choices": [
        {
          "id": "anchor_seed",
          "text": "Passo alla logica di seed e gruppi.",
          "goto": "seed_policy"
        },
        {
          "id": "anchor_actual",
          "text": "Torno allo stato reale.",
          "goto": "actual_state"
        }
      ]
    },
    "friend_policy": {
      "stitches": [
        {
          "id": "s1",
          "text": "Luke, Mattew, Daniel, Edward e Fab non vengono inseriti per fanservice. Se il loro stato dice fuori, restano fuori; se è irrisolto competono nella stessa simulazione off-screen degli altri."
        }
      ],
      "choices": [
        {
          "id": "friend_callbacks",
          "text": "Ricollego il Friend Beat senza alterare il field.",
          "goto": "callbacks"
        },
        {
          "id": "friend_field",
          "text": "Torno alla provenienza del field.",
          "goto": "field_source"
        }
      ]
    },
    "seed_policy": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il draw usa un seed deterministico legato a carriera ed edizione. Aspettare o ricaricare la stessa carriera non crea un nuovo gruppo."
        }
      ],
      "choices": [
        {
          "id": "seed_preview",
          "text": "Passo alla preview finale.",
          "goto": "draw_preview"
        },
        {
          "id": "seed_wait",
          "text": "Valuto se rimandare prima del lock.",
          "goto": "wait_window"
        }
      ]
    },
    "draw_preview": {
      "stitches": [
        {
          "id": "s1",
          "text": "Prima del commit puoi rivedere field, policy e conseguenze. Dopo il commit field e gruppi sono immutabili per questa edizione."
        }
      ],
      "choices": [
        {
          "id": "preview_field",
          "text": "Rivedo il field dei candidati.",
          "goto": "field_source"
        },
        {
          "id": "preview_integrity",
          "text": "Eseguo l'audit prima del lock.",
          "goto": "integrity"
        },
        {
          "id": "preview_commit",
          "text": "Vado al commit guard.",
          "goto": "commit_guard"
        }
      ]
    },
    "commit_guard": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il commit richiede qualificazione player, registrazione World, Friend Beat 08 e cerimonia completata. Nessun risultato di match viene creato."
        }
      ],
      "choices": [
        {
          "id": "guard_execute",
          "text": "Eseguo il WORLD_DRAW canonico.",
          "goto": "execute_draw",
          "conditions": {
            "path": "competition.world.drawComplete",
            "eq": false
          }
        },
        {
          "id": "guard_existing",
          "text": "Il draw è già chiuso: apro lo stato lockato.",
          "goto": "draw_locked",
          "conditions": {
            "path": "competition.world.drawComplete",
            "eq": true
          }
        },
        {
          "id": "guard_preview",
          "text": "Torno alla preview.",
          "goto": "draw_preview"
        }
      ]
    },
    "execute_draw": {
      "stitches": [
        {
          "id": "s1",
          "text": "E5 sta per risolvere qualificazioni off-screen residue, lockare i 32 e assegnare otto gruppi da quattro."
        }
      ],
      "choices": [
        {
          "id": "execute_now",
          "text": "Confermo il sorteggio una sola volta.",
          "goto": "draw_locked",
          "effects": [
            {
              "type": "competition_world_draw",
              "eventId": "WORLD_DRAW",
              "groupCount": 8,
