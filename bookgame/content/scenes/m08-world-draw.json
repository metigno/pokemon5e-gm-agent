          "text": "Non confermo ancora.",
          "goto": "commit_guard"
        }
      ]
    },
    "draw_locked": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il segretario firma il verbale: trentadue partecipanti, otto gruppi. I tabelloni vengono pubblicati senza lasciare spazio a nuove estrazioni."
        }
      ],
      "choices": [
        {
          "id": "locked_summary",
          "text": "Controllo il riepilogo del gruppo.",
          "goto": "group_summary"
        },
        {
          "id": "locked_integrity",
          "text": "Verifico che il field resti a 32.",
          "goto": "integrity"
        },
        {
          "id": "locked_close",
          "text": "Passo alla chiusura del draw.",
          "goto": "draw_close"
        }
      ]
    },
    "group_summary": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il tuo nome compare nel Gruppo {{competition.world.playerGroup}}. Gli altri tre partecipanti saranno annunciati con il riepilogo ufficiale."
        }
      ],
      "choices": [
        {
          "id": "summary_preview",
          "text": "Controllo il significato del gruppo.",
          "goto": "player_group_preview"
        },
        {
          "id": "summary_close",
          "text": "Passo alla chiusura del draw.",
          "goto": "draw_close"
        }
      ]
    },
    "player_group_preview": {
      "stitches": [
        {
          "id": "s1",
          "text": "Ogni gruppo ha quattro allenatori: affronterai tre avversari nelle giornate previste dal calendario."
        }
      ],
      "choices": [
        {
          "id": "group_integrity",
          "text": "Controllo ancora l'integrità del sorteggio.",
          "goto": "integrity"
        },
        {
          "id": "group_summary",
          "text": "Torno al riepilogo.",
          "goto": "group_summary"
        }
      ]
    },
    "integrity": {
      "stitches": [
        {
          "id": "s1",
          "text": "Gli ufficiali confrontano i nomi per evitare duplicazioni o gruppi incompleti. Il tabellone definitivo ne mostra quattro per girone."
        }
      ],
      "choices": [
        {
          "id": "integrity_callbacks",
          "text": "Controllo i callback senza modificare il draw.",
          "goto": "callbacks"
        },
        {
          "id": "integrity_commit",
          "text": "Torno al commit guard.",
          "goto": "commit_guard"
        }
      ]
    },
    "callbacks": {
      "stitches": [
        {
          "id": "s1",
          "text": "Un amico o un rivale può reagire al sorteggio quando ne conosce i nomi. Nessuna reazione sposta gli accoppiamenti."
        }
      ],
      "choices": [
        {
          "id": "callbacks_friend",
          "text": "Rileggo la policy sugli amici.",
          "goto": "friend_policy"
        },
        {
          "id": "callbacks_preview",
          "text": "Torno alla preview.",
          "goto": "draw_preview"
        }
      ]
    },
    "wait_window": {
      "stitches": [
        {
          "id": "s1",
          "text": "Se rimandi, trascorre un'ora. La stessa edizione seguirà la procedura già annunciata, non una versione fatta su misura."
        }
      ],
      "choices": [
        {
          "id": "wait_hour",
          "text": "Aspetto un'ora e torno al commit guard.",
          "goto": "commit_guard",
          "timeCostMinutes": 60
        },
        {
          "id": "wait_seed",
          "text": "Torno alla spiegazione del seed.",
          "goto": "seed_policy"
        }
      ]
    },
    "draw_close": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il sorteggio è terminato. Ora puoi leggere i nomi e le giornate del tuo gruppo."
        }
      ],
      "choices": [
        {
          "id": "close_reveal",
          "text": "Passo al Group Reveal.",
          "goto": "m08-group-reveal#reveal_entry",
          "conditions": {
            "all": [
              {
                "path": "competition.world.drawComplete",
                "eq": true
              },
              {
                "path": "competition.world.fieldLocked",
                "eq": true
              },
              {
                "path": "competition.world.field.length",
                "eq": 32
              },
              {
                "path": "competition.world.playerOpponents.length",
                "eq": 3
              }
            ]
          }
        },
        {
          "id": "close_review",
          "text": "Rivedo il gruppo senza modificarlo.",
          "goto": "group_summary"
        }
      ]
