    "callback_entry": {
      "stitches": [
        {
          "id": "s1",
          "text": "A Valedarsena ritrovi il profilo delle banchine e i muretti della strada. La città ha continuato a correre anche quando la tua carriera ti ha portato lontano."
        }
      ],
      "choices": [
        {
          "id": "continue",
          "text": "Proseguo seguendo questo filo.",
          "goto": "city_now"
        },
        {
          "id": "review",
          "text": "Rileggo il passaggio collegato.",
          "goto": "city_now"
        },
        {
          "id": "context_1",
          "text": "Confronto questo dettaglio con un altro pezzo del percorso.",
          "goto": "m1_pressure"
        }
      ]
    },
    "city_now": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il Centro Pokémon e l'Arena sono ancora punti di riferimento. Davanti ai loro ingressi vedi persone nuove e vecchie abitudini."
