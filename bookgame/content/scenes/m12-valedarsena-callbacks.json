      "choices": [
        {
          "id": "continue",
          "text": "Proseguo seguendo questo filo.",
          "goto": "city_now"
        },
        {
          "id": "review",
          "text": "Rileggo il passaggio collegato.",
          "goto": "city_now"
        },
        {
          "id": "context_1",
          "text": "Confronto questo dettaglio con un altro pezzo del percorso.",
          "goto": "m1_pressure"
        }
      ]
    },
    "city_now": {
      "stitches": [
        {
          "id": "s1",
          "text": "Le strade, il Centro e l'Arena sono familiari, ma il contesto locale dipende dagli esiti registrati mesi prima."
