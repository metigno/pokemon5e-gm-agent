    "tutorial_choice": {
      "stitches": [
        {
          "id": "sheet_ready",
          "text": "La licenza viene registrata. Prima di uscire dal Campus puoi seguire il briefing guidato oppure dichiarare di conoscere già le basi."
        }
      ],
      "choices": [
        {
          "id": "play_tutorial",
          "text": "Faccio il briefing guidato.",
          "effects": [
            {
              "type": "set_flag",
              "key": "tutorial_skipped",
              "value": false
            }
          ],
          "goto": "tutorial_rules"
        },
        {
          "id": "skip_tutorial",
          "text": "Salto volontariamente il briefing.",
          "effects": [
            {
              "type": "set_flag",
              "key": "tutorial_skipped",
              "value": true
            }
          ],
          "goto": "release"
        }
      ]
    },
    "tutorial_rules": {
      "stitches": [
        {
          "id": "checks",
          "text": "Quando una situazione richiede una prova, contano le tue caratteristiche, le competenze che possiedi e il tiro ottenuto. Non tutte le azioni riescono nello stesso modo."
        },
        {
          "id": "combat",
          "text": "Negli scontri dovrai rispettare iniziativa, azioni disponibili, movimento, PP, condizioni e regole di cattura. Ogni scelta ha conseguenze reali sul combattimento."
        },
        {
          "id": "world",
          "text": "Il tempo continua a passare anche quando scegli di occuparti d'altro. Persone, fauna, lavori e opportunità possono cambiare mentre sei altrove."
        }
      ],
      "choices": [
        {
          "id": "finish_tutorial",
          "text": "Ho capito. Esco nel mondo.",
          "effects": [
            {
              "type": "set_flag",
              "key": "tutorial_complete",
              "value": true
            }
          ],
          "goto": "release"
        }
      ]
    },
    "release": {
      "stitches": [
        {
          "id": "release",
          "text": "Il cancello del Campus è davanti a te. Da questo momento le indicazioni finiscono: la prima strada la scegli tu."
        }
      ],
      "choices": [
        {
          "id": "enter_m1",
          "text": "Esco dal Campus.",
          "effects": [
            {
              "type": "set_flag",
              "key": "intro_complete",
              "value": true
            },
            {
              "type": "set_flag",
