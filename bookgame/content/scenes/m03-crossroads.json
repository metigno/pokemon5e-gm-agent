{
  "schemaVersion": 1,
  "id": "m03-crossroads",
  "moduleId": "M03",
  "title": "M3_09 — Crossroads",
  "locationId": "fer_city",
  "entryNodeId": "crossroads",
  "conditions": {
    "all": [
      {
        "path": "world.flags.m2_complete",
        "eq": true
      },
      {
        "path": "world.flags.m03_unlocked",
        "eq": true
      },
      {
        "path": "world.flags.m3_active",
        "eq": true
      },
      {
        "path": "world.flags.a3_crossroads_available",
        "eq": true
      },
      {
        "path": "world.flags.a3_crossroads_complete",
        "ne": true
      },
      {
        "path": "competition.rankOrder",
        "gte": 2
      }
    ]
  },
  "nodes": {
    "crossroads": {
      "stitches": [
        {
          "id": "crossroads_1",
          "text": "A Ferravia più cose reclamano tempo nello stesso momento. Ferrox non ha ancora consegnato un bilancio definitivo; uno degli altri Five prova a raggiungerti; all'Arena compaiono gli orari del Trial D→C e, quando le iscrizioni sono aperte, quelli della Regional Cup."
        },
        {
          "id": "crossroads_2",
          "text": "Sul tabellone gli orari non si spostano per farti spazio. Puoi occuparti di una cosa adesso e tornare alle altre dopo, ma il tempo che spendi appartiene comunque alla giornata."
        }
      ],
      "choices": [
        {
          "id": "review_rescue_priority",
          "text": "Prima voglio sapere come sta andando Ferrox.",
          "conditions": {
            "path": "world.flags.ferrox_rescue_state",
            "exists": true
          },
          "goto": "rescue_priority"
        },
        {
          "id": "review_friend_priority",
          "text": "Prima rispondo al mio amico.",
          "conditions": {
            "all": [
              {
                "path": "world.flags.a3_friend_call_available",
                "eq": true
              },
              {
                "path": "world.flags.friend_beat_03_complete",
                "ne": true
              }
            ]
          },
          "goto": "friend_priority"
        },
        {
          "id": "review_trial_priority",
          "text": "Prima mi occupo del Trial D→C.",
          "conditions": {
            "path": "world.flags.a3_rank_trial_d_c_available",
            "eq": true
          },
          "goto": "trial_priority"
        },
        {
          "id": "review_cup_priority",
          "text": "Prima controllo la Regional Cup.",
          "conditions": {
            "path": "world.flags.a3_regional_cup_available",
            "eq": true
          },
          "goto": "cup_priority"
        },
        {
          "id": "review_technical_priority",
          "text": "Prima voglio capire meglio cosa collega cava, mappe e Ferrox.",
          "goto": "technical_priority"
        },
        {
          "id": "defer_crossroads",
          "text": "Non decido ancora. Torno per Ferravia.",
          "timeCostMinutes": 15,
          "goto": "m03-ferravia-arrival#city_hub",
          "effects": [
            {
              "type": "set_flag",
              "key": "a3_crossroads_deferred",
              "value": true
            },
            {
              "type": "set_location",
              "locationId": "fer_city"
            }
          ]
        }
      ]
    },
    "rescue_priority": {
      "stitches": [
        {
          "id": "rescue_priority_1",
          "text": "Ferrox resta a pochi minuti di distanza. Tecnici e soccorritori stanno ancora ricostruendo l'accaduto, mentre all'Arena gli incontri continuano come sempre."
        }
      ],
      "choices": [
        {
          "id": "review_rescue_success",
          "text": "Rileggo ciò che ha funzionato nel soccorso.",
          "conditions": {
            "path": "world.flags.ferrox_rescue_state",
            "in": [
              "evacuation_supported",
              "stabilization_supported",
              "balanced_support",
              "support_only"
            ]
          },
          "goto": "rescue_success_context"
        },
        {
          "id": "review_rescue_failure",
          "text": "Affronto il fatto di aver rifiutato o perso la finestra.",
          "conditions": {
            "path": "world.flags.ferrox_rescue_state",
            "in": [
              "declined",
              "missed"
            ]
          },
          "goto": "rescue_failure_context"
        },
        {
          "id": "commit_rescue_priority",
          "text": "Ferrox resta la mia priorità principale.",
          "goto": "crossroads_close",
          "effects": [
            {
              "type": "set_flag",
              "key": "a3_crossroads_priority",
              "value": "ferrox"
            },
            {
              "type": "set_flag",
              "key": "a3_crossroads_complete",
              "value": true
            },
            {
              "type": "set_flag",
              "key": "crossroads_rescue_followup",
              "value": true
            }
          ]
        },
        {
          "id": "rescue_reconsider",
          "text": "Riconsidero le altre priorità.",
          "goto": "crossroads"
        }
      ]
    },
    "rescue_success_context": {
      "stitches": [
        {
          "id": "rescue_success_context_1",
          "text": "Sai quale parte dell'intervento hai visto e dove hai dato una mano. Per il resto devi aspettare che le squadre rientrino, controllino il settore e pubblichino un bilancio."
        }
      ],
      "choices": [
        {
          "id": "success_commit_rescue",
          "text": "Mantengo Ferrox al primo posto.",
          "goto": "crossroads_close",
          "effects": [
            {
              "type": "set_flag",
              "key": "a3_crossroads_priority",
              "value": "ferrox"
            },
            {
              "type": "set_flag",
              "key": "a3_crossroads_complete",
              "value": true
            },
            {
              "type": "set_flag",
              "key": "crossroads_rescue_followup",
              "value": true
            }
          ]
        },
        {
          "id": "success_back_crossroads",
          "text": "Torno al bivio delle priorità.",
          "goto": "crossroads"
        }
      ]
    },
    "rescue_failure_context": {
      "stitches": [
        {
          "id": "rescue_failure_context_1",
          "text": "Quando hai potuto intervenire, hai scelto di non farlo oppure sei arrivato dopo la fase utile. Tornare ora non cambia quelle ore; può però dirti che cosa è successo e cosa resta da affrontare."
        }
      ],
      "choices": [
        {
          "id": "failure_commit_rescue",
          "text": "Torno a Ferrox e affronto quello che è successo.",
          "goto": "crossroads_close",
          "effects": [
            {
              "type": "set_flag",
              "key": "a3_crossroads_priority",
              "value": "ferrox"
            },
            {
              "type": "set_flag",
              "key": "a3_crossroads_complete",
              "value": true
            },
            {
              "type": "set_flag",
              "key": "crossroads_rescue_accountability",
              "value": true
            }
          ]
        },
        {
          "id": "failure_back_crossroads",
          "text": "Torno al bivio delle priorità.",
          "goto": "crossroads"
        }
      ]
    },
    "friend_priority": {
      "stitches": [
        {
          "id": "friend_priority_1",
          "text": "Il nome del tuo amico è ancora sullo schermo. Potrebbe essere dall'altra parte della regione o abbastanza vicino da incontrarti: in ogni caso, anche la sua giornata sta andando avanti."
        }
      ],
      "choices": [
        {
          "id": "commit_friend_priority",
          "text": "Rispondo adesso: questa relazione viene prima del prossimo impegno.",
          "goto": "m03-friend-beat-03#friend_call",
          "effects": [
            {
              "type": "set_flag",
              "key": "a3_crossroads_priority",
              "value": "friend"
            },
            {
              "type": "set_flag",
              "key": "a3_crossroads_complete",
              "value": true
            }
          ]
        },
        {
          "id": "friend_note_then_back",
          "text": "Non rispondo ancora. Prima controllo gli altri impegni.",
          "goto": "crossroads",
          "effects": [
            {
              "type": "set_flag",
              "key": "crossroads_friend_considered",
              "value": true
            }
          ]
        }
      ]
    },
    "trial_priority": {
      "stitches": [
        {
          "id": "trial_priority_1",
          "text": "Al banco dell'Arena il Trial D→C ha un'iscrizione propria. Il foglio esposto indica tre Pokémon da dichiarare e un incontro da vincere sul campo."
        }
      ],
      "choices": [
        {
          "id": "review_trial_requirements",
          "text": "Ripasso ciò che so del formato e dei requisiti.",
          "goto": "trial_context"
        },
        {
          "id": "commit_trial_priority",
          "text": "Comincio dal Trial.",
          "goto": "crossroads_close",
          "effects": [
            {
              "type": "set_flag",
              "key": "a3_crossroads_priority",
              "value": "trial"
            },
            {
              "type": "set_flag",
              "key": "a3_crossroads_complete",
              "value": true
            },
            {
              "type": "set_flag",
              "key": "crossroads_trial_focus",
              "value": true
            }
          ]
        },
        {
          "id": "trial_reconsider",
          "text": "Non mi impegno ancora sul Trial.",
          "goto": "crossroads"
        }
      ]
    },
    "trial_context": {
      "stitches": [
        {
          "id": "trial_context_1",
          "text": "Il regolamento affisso al banco non cambia: iscrizione separata, tre Pokémon dichiarati, promozione soltanto dopo una vittoria. Accanto, gli orari disponibili occupano finestre precise della giornata."
        }
      ],
      "choices": [
        {
          "id": "trial_context_commit",
          "text": "Confermo il Trial come priorità.",
          "goto": "crossroads_close",
          "effects": [
            {
              "type": "set_flag",
              "key": "a3_crossroads_priority",
              "value": "trial"
            },
            {
              "type": "set_flag",
              "key": "a3_crossroads_complete",
              "value": true
            },
            {
              "type": "set_flag",
              "key": "crossroads_trial_focus",
              "value": true
            }
          ]
        },
        {
          "id": "trial_context_back",
          "text": "Torno alle altre priorità.",
          "goto": "crossroads"
        }
      ]
    },
    "cup_priority": {
      "stitches": [
        {
          "id": "cup_priority_1",
          "text": "La Regional Cup ha il proprio banco e il proprio calendario. Non sostituisce il Trial D→C: parteciparvi significa aggiungere altri incontri e altre ore a una giornata che ne ha già poche."
        }
      ],
      "choices": [
        {
          "id": "review_cup_tradeoff",
          "text": "Controllo gli orari della Coppa prima di decidere.",
          "goto": "cup_context"
        },
        {
          "id": "commit_cup_priority",
          "text": "Comincio dalla Regional Cup.",
          "goto": "crossroads_close",
          "effects": [
            {
              "type": "set_flag",
              "key": "a3_crossroads_priority",
              "value": "regional_cup"
            },
            {
              "type": "set_flag",
              "key": "a3_crossroads_complete",
              "value": true
            },
            {
              "type": "set_flag",
              "key": "crossroads_cup_focus",
              "value": true
            }
          ]
        },
        {
          "id": "cup_reconsider",
          "text": "La Cup può aspettare; torno al bivio.",
          "goto": "crossroads"
        }
      ]
    },
    "cup_context": {
      "stitches": [
        {
          "id": "cup_context_1",
          "text": "Sul tabellone della Coppa ogni turno occupa una fascia precisa. Se ti iscrivi, durante quelle ore Ferrox, Ferravia e gli altri impegni non smettono di esistere."
        }
      ],
      "choices": [
        {
          "id": "cup_context_commit",
          "text": "Mi iscrivo alla Coppa sapendo quanto tempo richiederà.",
          "goto": "crossroads_close",
          "effects": [
            {
              "type": "set_flag",
              "key": "a3_crossroads_priority",
              "value": "regional_cup"
            },
            {
              "type": "set_flag",
              "key": "a3_crossroads_complete",
              "value": true
            },
            {
              "type": "set_flag",
              "key": "crossroads_cup_focus",
              "value": true
            }
          ]
        },
        {
          "id": "cup_context_back",
          "text": "Torno alle altre priorità.",
          "goto": "crossroads"
        }
      ]
    },
    "technical_priority": {
      "stitches": [
        {
          "id": "technical_priority_1",
          "text": "Puoi anche restare fuori dall'Arena. Archivio, cava e perimetro Ferrox hanno ancora documenti, persone e dettagli che non hai seguito fino in fondo."
        }
      ],
      "choices": [
        {
          "id": "technical_review_archive",
          "text": "Riparto dalle mappe e dagli indizi che ho già raccolto.",
          "goto": "technical_context"
        },
        {
          "id": "commit_technical_priority",
          "text": "Continuo l'indagine prima di tornare alla competizione.",
          "goto": "crossroads_close",
          "effects": [
            {
              "type": "set_flag",
              "key": "a3_crossroads_priority",
              "value": "technical"
            },
            {
              "type": "set_flag",
              "key": "a3_crossroads_complete",
              "value": true
            },
            {
              "type": "set_flag",
              "key": "crossroads_technical_focus",
              "value": true
            }
          ]
        },
        {
          "id": "technical_reconsider",
          "text": "Torno al bivio prima di impegnarmi.",
          "goto": "crossroads"
        }
      ]
    },
    "technical_context": {
      "stitches": [
        {
          "id": "technical_context_1",
          "text": "Quello che hai visto finora non punta a una causa unica: vecchie mappe, manutenzione, produzione e decisioni prese in momenti diversi si sovrappongono. Altri documenti o testimonianze potrebbero chiarire i collegamenti, oppure lasciarli incompleti."
        }
      ],
      "choices": [
        {
          "id": "technical_context_commit",
          "text": "Confermo questa come priorità.",
          "goto": "crossroads_close",
          "effects": [
            {
              "type": "set_flag",
              "key": "a3_crossroads_priority",
              "value": "technical"
            },
            {
              "type": "set_flag",
              "key": "a3_crossroads_complete",
              "value": true
            },
            {
              "type": "set_flag",
              "key": "crossroads_technical_focus",
              "value": true
            }
          ]
        },
        {
          "id": "technical_context_back",
          "text": "Torno alle altre priorità.",
          "goto": "crossroads"
        }
      ]
    },
    "crossroads_close": {
      "stitches": [
        {
          "id": "crossroads_close_1",
          "text": "Hai deciso cosa viene prima, almeno per adesso. Intorno a te Ferravia non cambia ritmo: i treni rispettano gli orari, l'Arena chiama gli incontri e dal lato industriale continuano ad arrivare mezzi."
        }
      ],
      "choices": [
        {
          "id": "crossroads_to_hub",
          "text": "Torno in città e mi muovo verso ciò che ho scelto.",
          "goto": "m03-ferravia-arrival#city_hub",
          "effects": [
            {
              "type": "set_location",
              "locationId": "fer_city"
            }
          ]
        }
      ]
    }
  }
}
