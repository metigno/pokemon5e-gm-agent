{
  "schemaVersion": 1,
  "id": "m05-interregional-license",
  "moduleId": "M05",
  "title": "M5_07 — Interregional License",
  "locationId": "alt_town_crest",
  "entryNodeId": "license_entry",
  "conditions": {
    "all": [
      {
        "path": "world.flags.m4_complete",
        "eq": true
      },
      {
        "path": "world.flags.m05_unlocked",
        "eq": true
      },
      {
        "path": "world.flags.m5_active",
        "eq": true
      },
      {
        "path": "competition.rank",
        "eq": "B"
      },
      {
        "path": "world.flags.a5_interregional_available",
        "eq": true
      }
    ]
  },
  "nodes": {
    "license_entry": {
      "stitches": [
        {
          "id": "e1",
          "text": "La Sala della Cresta apre lo sportello interregionale ai Rank B. La licenza non promuove di Rank: certifica accesso a tratte e servizi competitivi che attraversano più aree del circuito."
        }
      ],
      "choices": [
        {
          "id": "entry_eligibility",
          "text": "Verifico i requisiti.",
          "goto": "eligibility"
        },
        {
          "id": "entry_routes",
          "text": "Chiedo quali servizi apre davvero la licenza.",
          "goto": "route_services"
        },
        {
          "id": "entry_rules",
          "text": "Leggo le regole dell'assessment ufficiale.",
          "goto": "rules"
        },
        {
          "id": "entry_defer",
          "text": "Rimando la pratica.",
          "goto": "defer"
        }
      ]
    },
    "eligibility": {
      "stitches": [
        {
          "id": "el1",
          "text": "Il requisito principale è il Rank B reale. L'ufficio legge lo stato strutturato e non accetta reputazione, titoli opzionali o amicizie come sostituti."
        }
      ],
      "choices": [
        {
          "id": "eligible_register",
          "text": "Sono Rank B: apro la pratica.",
          "goto": "registration"
        },
        {
          "id": "eligible_roster",
          "text": "Chiedo come verrà usato il roster nell'assessment.",
          "goto": "rules"
        },
        {
          "id": "eligible_routes",
          "text": "Prima voglio capire il valore della licenza.",
          "goto": "route_services"
        }
      ]
    },
    "route_services": {
      "stitches": [
        {
          "id": "rs1",
          "text": "La licenza permette di prenotare servizi e trasferte interregionali compatibili con il tuo Rank e con il calendario. Non apre zone riservate ai Rank superiori e, naturalmente, non elimina distanze o tempi di viaggio."
        }
      ],
      "choices": [
        {
          "id": "routes_record",
          "text": "Registro la distinzione fra licenza e Rank.",
          "goto": "registration",
          "effects": [
            {
              "type": "set_flag",
              "key": "m5_interregional_rules_known",
              "value": true
            }
          ]
        },
        {
          "id": "routes_fulgore",
          "text": "Chiedo se Fulgore conta già come tratta interregionale.",
          "goto": "travel_rights"
        }
      ]
    },
    "rules": {
      "stitches": [
        {
          "id": "r1",
          "text": "L'assessment è un match ufficiale di calibrazione: serve a registrare il profilo competitivo per la rete interregionale, non a decidere il Rank. Il risultato resta persistente in entrambi i casi."
        }
      ],
      "choices": [
        {
          "id": "rules_prepare",
          "text": "Accetto il formato e preparo il roster.",
          "goto": "prep"
        },
        {
          "id": "rules_back",
          "text": "Torno alla verifica dei requisiti.",
          "goto": "eligibility"
        }
      ]
    },
    "registration": {
      "stitches": [
        {
          "id": "reg1",
          "text": "L'addetta apre una pratica distinta dal Promotion Trial B→A: ottenere questa licenza non cambia il tuo Rank."
        }
      ],
      "choices": [
        {
          "id": "register_now",
          "text": "Registro l'assessment interregionale.",
          "goto": "prep",
          "effects": [
            {
              "type": "set_flag",
              "key": "interregional_registration_complete",
              "value": true
            }
          ]
        },
        {
          "id": "register_rules",
          "text": "Rileggo il formato prima di confermare.",
          "goto": "rules"
        },
        {
          "id": "register_defer",
          "text": "Lascio la pratica aperta e torno più tardi.",
          "goto": "defer",
          "effects": [
            {
              "type": "set_flag",
              "key": "interregional_registration_started",
              "value": true
            }
          ]
        }
      ]
    },
    "prep": {
      "stitches": [
        {
          "id": "p1",
          "text": "La preparazione usa il roster reale e non aggiunge Pokémon, cure o livelli. L'avversaria dell'ufficio usa una formazione fissa per questa fascia, senza scaling invisibile."
        }
      ],
      "choices": [
        {
          "id": "prep_assess",
          "text": "Sono pronto per l'assessment.",
          "goto": "assessment_offer"
        },
        {
          "id": "prep_routes",
          "text": "Controllo ancora cosa sbloccherà la licenza.",
          "goto": "travel_rights"
        },
        {
          "id": "prep_defer",
          "text": "Rinvio il match senza perdere Rank B.",
          "goto": "defer"
        }
      ]
    },
    "assessment_offer": {
      "stitches": [
        {
          "id": "ao1",
          "text": "Mira, ufficiale del Circuito, conferma un Singles di calibrazione. Vincere o perdere cambia il risultato registrato; completare il match chiude l'assessment."
        }
      ],
      "choices": [
        {
          "id": "assessment_begin",
          "text": "Inizio il match ufficiale.",
          "goto": "assessment_handoff"
        },
        {
          "id": "assessment_wait",
          "text": "Non sono pronto: torno alla preparazione.",
          "goto": "prep"
        }
      ]
    },
    "assessment_handoff": {
      "stitches": [
        {
          "id": "ah1",
          "text": "Il combattimento viene registrato secondo le normali regole del Circuito. Nessuno al banco può deciderne l'esito in anticipo."
        }
      ],
      "choices": [
        {
          "id": "fight_assessment",
          "text": "Combatto l'assessment interregionale.",
          "combat": {
            "encounterId": "M5_INTERREGIONAL_ASSESSMENT",
            "opponentRegistered": true,
            "competition": {
              "type": "official_match",
              "matchId": "A5_INTERREGIONAL_ASSESSMENT",
              "format": "Singles",
              "officialRosterSize": 3,
              "difficulty": "HARD",
              "opponentTrainerId": "ALT_LICENSE_MIRA"
            },
            "returnNodes": {
              "win": "assessment_win",
              "lose": "assessment_loss"
            },
            "opponentTrainerId": "ALT_LICENSE_MIRA",
            "opponent": {
              "species": "Luxio",
              "level": 11,
              "abilityId": "intimidate",
              "trainerId": "ALT_LICENSE_MIRA"
            },
            "opponentBench": [
              {
                "species": "Noctowl",
                "level": 11,
                "abilityId": "keen-eye",
                "trainerId": "ALT_LICENSE_MIRA"
              },
              {
                "species": "Roselia",
                "level": 11,
                "abilityId": "natural-cure",
                "trainerId": "ALT_LICENSE_MIRA"
              }
            ],
            "goto": "assessment_handoff"
          }
        }
      ]
    },
    "assessment_win": {
      "stitches": [
        {
          "id": "aw1",
          "text": "La vittoria entra nel tuo profilo interregionale. È un risultato utile, ma non vale una promozione di Rank."
        }
      ],
      "choices": [
        {
          "id": "win_record",
          "text": "Registro la vittoria e chiudo l'assessment.",
          "goto": "result_review",
          "effects": [
            {
              "type": "set_flag",
              "key": "interregional_assessment_result",
              "value": "win"
            },
            {
              "type": "set_flag",
              "key": "interregional_assessment_complete",
              "value": true
            }
          ]
        },
        {
          "id": "win_review",
          "text": "Rivedo cosa significa prima della licenza.",
          "goto": "result_review",
          "effects": [
            {
              "type": "set_flag",
              "key": "interregional_assessment_result",
              "value": "win"
            },
            {
              "type": "set_flag",
              "key": "interregional_assessment_complete",
              "value": true
            }
          ]
        }
      ]
    },
    "assessment_loss": {
      "stitches": [
        {
          "id": "al1",
          "text": "La sconfitta resta tale, ma il combattimento ha comunque fornito la valutazione richiesta. Il tuo Rank non cambia."
        }
      ],
      "choices": [
        {
          "id": "loss_record",
          "text": "Registro la sconfitta reale e chiudo l'assessment.",
          "goto": "result_review",
          "effects": [
            {
              "type": "set_flag",
              "key": "interregional_assessment_result",
              "value": "loss"
            },
            {
              "type": "set_flag",
              "key": "interregional_assessment_complete",
              "value": true
            }
          ]
        },
        {
          "id": "loss_review",
          "text": "Rivedo perché il risultato non blocca il Rank.",
          "goto": "result_review",
          "effects": [
            {
              "type": "set_flag",
              "key": "interregional_assessment_result",
              "value": "loss"
            },
            {
              "type": "set_flag",
              "key": "interregional_assessment_complete",
              "value": true
            }
          ]
        }
      ]
    },
    "result_review": {
      "stitches": [
        {
          "id": "rr1",
          "text": "Il profilo interregionale conserva il risultato senza confonderlo con RANK_B_TO_A. L'assessment misura e registra; il Promotion Trial promuove."
        }
      ],
      "choices": [
        {
          "id": "result_issue",
          "text": "L'assessment è completo: richiedo la licenza.",
          "conditions": {
            "path": "world.flags.interregional_assessment_complete",
            "eq": true
          },
          "goto": "license_issue"
        },
        {
          "id": "result_routes",
          "text": "Rileggo i diritti di viaggio associati.",
          "goto": "travel_rights"
        },
        {
          "id": "result_prep",
          "text": "Se il match non è stato ancora risolto, torno alla preparazione.",
          "conditions": {
            "path": "world.flags.interregional_assessment_complete",
            "ne": true
          },
          "goto": "prep"
        }
      ]
    },
    "license_issue": {
      "stitches": [
        {
          "id": "li1",
          "text": "L'ufficio emette la licenza sullo stato persistente. Non cambia Rank, non apre le aree A/S e non crea risultati di competizioni future."
        }
      ],
      "choices": [
        {
          "id": "issue_license",
          "text": "Registro la licenza interregionale.",
          "goto": "license_close",
          "effects": [
            {
              "type": "set_flag",
              "key": "interregional_license",
              "value": true
            },
            {
              "type": "set_flag",
              "key": "m5_interregional_complete",
              "value": true
            }
          ]
        },
        {
          "id": "issue_review",
          "text": "Prima rileggo i limiti della licenza.",
          "goto": "travel_rights"
        }
      ]
    },
    "travel_rights": {
      "stitches": [
        {
          "id": "tr1",
          "text": "Con la licenza puoi usare i servizi interregionali disponibili per il tuo Rank e nel calendario corrente. Ogni destinazione continua però ad avere requisiti, tempi di viaggio e condizioni proprie."
        }
      ],
      "choices": [
        {
          "id": "travel_understood",
          "text": "Tengo separati accesso di rete e access band.",
          "goto": "license_issue",
          "conditions": {
            "path": "world.flags.interregional_assessment_complete",
            "eq": true
          }
        },
        {
          "id": "travel_back",
          "text": "Torno alla pratica.",
          "goto": "registration"
        }
      ]
    },
    "defer": {
      "stitches": [
        {
          "id": "d1",
          "text": "Rinviare è legale. La finestra resta nel mondo finché non viene risolta o finché una futura regola di calendario non la chiude."
        }
      ],
      "choices": [
        {
          "id": "defer_hub",
          "text": "Torno ad Altacima.",
          "goto": "m05-altacima#town_hub",
          "effects": [
            {
              "type": "set_location",
              "locationId": "alt_town"
            }
          ]
        }
      ]
    },
    "license_close": {
      "stitches": [
        {
          "id": "lc1",
          "text": "La licenza è attiva con il risultato reale dell'assessment. M5 può ora usare tratte interregionali senza alterare Rank B o anticipare il Masters Circuit."
        }
      ],
      "choices": [
        {
          "id": "close_reunion",
          "text": "La finestra dei Five è aperta: raggiungo la reunion.",
          "conditions": {
            "all": [
              {
                "path": "world.flags.a5_five_cross_available",
                "eq": true
              },
              {
                "path": "world.flags.five_cross_complete",
                "ne": true
              }
            ]
          },
          "goto": "m05-five-cross-again#reunion_entry",
          "effects": [
            {
              "type": "set_location",
              "locationId": "alt_town"
            }
          ]
        },
        {
          "id": "close_hub",
          "text": "Torno alla piazza di Altacima.",
          "goto": "m05-altacima#town_hub",
          "effects": [
            {
              "type": "set_location",
              "locationId": "alt_town"
            }
          ]
        }
      ]
    }
  }
}
