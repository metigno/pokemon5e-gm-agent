{
  "schemaVersion": 1,
  "id": "m08-world-village",
  "moduleId": "M08",
  "title": "M8_04 — World Village",
  "locationId": "world_village",
  "entryNodeId": "village_entry",
  "conditions": {
    "all": [
      {
        "path": "world.flags.m7_complete",
        "eq": true
      },
      {
        "path": "world.flags.m08_unlocked",
        "eq": true
      },
      {
        "path": "world.flags.world_qualified",
        "eq": true
      },
      {
        "path": "world.flags.m7_before_lights_complete",
        "eq": true
      },
      {
        "path": "world.flags.m8_active",
        "eq": true
      },
      {
        "path": "world.flags.m8_world_arrived",
        "eq": true
      },
      {
        "path": "world.flags.m8_world_registration_complete",
        "eq": true
      }
    ]
  },
  "nodes": {
    "village_entry": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il World Village è un intreccio di valigie, lingue diverse e Pokémon che accompagnano i propri allenatori. Tutti hanno impegni, e nessuno è qui soltanto per incontrare te."
        }
      ],
      "choices": [
        {
          "id": "entry_register",
          "text": "Registro l'ingresso fisico nel Village.",
          "goto": "village_hub",
          "conditions": {
            "path": "world.flags.m8_world_village_arrived",
            "ne": true
          },
          "effects": [
            {
              "type": "set_flag",
              "key": "m8_world_village_arrived",
              "value": true
            },
            {
              "type": "set_flag",
              "key": "world_village_discovered",
              "value": true
            },
            {
              "type": "set_location",
              "locationId": "world_village"
            }
          ]
        },
        {
          "id": "entry_return",
          "text": "Sono già nel Village: torno all'hub.",
          "goto": "village_hub",
          "conditions": {
            "path": "world.flags.m8_world_village_arrived",
            "eq": true
          }
        },
        {
          "id": "entry_observe",
          "text": "Osservo il flusso dei partecipanti prima di muovermi.",
          "goto": "observation_deck"
        }
      ]
    },
    "village_hub": {
      "stitches": [
        {
          "id": "s1",
          "text": "La mappa indica alloggi, mensa, aree comuni, recupero e navette per l'arena. Ogni spostamento occupa parte della giornata."
        }
      ],
      "choices": [
        {
          "id": "hub_lodging",
          "text": "Controllo l'area alloggi.",
          "goto": "lodging"
        },
        {
          "id": "hub_common",
          "text": "Vado nelle aree comuni.",
          "goto": "common_room"
        },
        {
          "id": "hub_services",
          "text": "Rivedo i servizi del Village.",
          "goto": "services"
        }
      ]
    },
    "lodging": {
      "stitches": [
        {
          "id": "s1",
          "text": "Nella stanza assegnata puoi sistemare la squadra e ritagliarti un momento tranquillo. Riposare richiede tempo; varcare la soglia non cancella da sé la stanchezza."
        }
      ],
      "choices": [
        {
          "id": "lodging_quiet",
          "text": "Cerco una zona tranquilla.",
          "goto": "quiet_walk"
        },
        {
          "id": "lodging_hub",
          "text": "Torno all'hub.",
          "goto": "village_hub"
        }
      ]
    },
    "dining": {
      "stitches": [
        {
          "id": "s1",
          "text": "In mensa gli allenatori condividono tavoli e abitudini diverse. Qualcuno parla delle qualificazioni, altri preferiscono occuparsi dei propri Pokémon."
        }
      ],
      "choices": [
        {
          "id": "dining_social",
          "text": "Osservo le dinamiche sociali.",
          "goto": "social_crossroads"
        },
        {
          "id": "dining_hub",
          "text": "Torno all'hub.",
          "goto": "village_hub"
        }
      ]
    },
    "common_room": {
      "stitches": [
        {
          "id": "s1",
          "text": "La sala comune è piena di conversazioni e partite trasmesse sugli schermi. Potresti incontrare qualcuno che conosci, se i suoi impegni lo portano davvero qui."
        }
      ],
      "choices": [
        {
          "id": "common_social",
          "text": "Controllo chi è plausibilmente presente.",
          "goto": "social_crossroads"
        },
        {
          "id": "common_dining",
          "text": "Passo alla mensa.",
          "goto": "dining"
        }
      ]
    },
    "athlete_quarter": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il quartiere atleti collega alloggi, servizi di recupero e sale di preparazione. Nei corridoi si incrociano programmi diversi."
        }
      ],
      "choices": [
        {
          "id": "athlete_recovery",
          "text": "Vado verso l'area recovery.",
          "goto": "recovery_zone"
        },
        {
          "id": "athlete_training",
          "text": "Controllo gli avvisi della Training Hall.",
          "goto": "training_notice"
        },
        {
          "id": "athlete_transit",
          "text": "Controllo i collegamenti al venue.",
          "goto": "transit"
        }
      ]
    },
    "recovery_zone": {
      "stitches": [
        {
          "id": "s1",
          "text": "L'area riposo è meno rumorosa. Puoi chiedere informazioni sulle cure e sui tempi, ma nessun lettino ripristina da solo energie e ferite."
        }
      ],
      "choices": [
        {
          "id": "recovery_quiet",
          "text": "Mi sposto nella zona tranquilla.",
          "goto": "quiet_walk"
        },
        {
          "id": "recovery_athlete",
          "text": "Torno al quartiere atleti.",
          "goto": "athlete_quarter"
        }
      ]
    },
    "training_notice": {
      "stitches": [
        {
          "id": "s1",
          "text": "Una bacheca indica gli orari della Training Hall. Le sessioni sono prenotabili; allenarsi sarà una decisione, non un premio per aver visitato la stanza."
        }
      ],
      "choices": [
        {
          "id": "training_board",
          "text": "Controllo la schedule board.",
          "goto": "schedule_board"
        },
        {
          "id": "training_athlete",
          "text": "Torno al quartiere atleti.",
          "goto": "athlete_quarter"
        }
      ]
    },
    "transit": {
      "stitches": [
        {
          "id": "s1",
          "text": "Le navette collegano Village, arena, sala stampa e clinica. Il viaggio continua a richiedere tempo, anche dentro il complesso."
        }
      ],
      "choices": [
        {
          "id": "transit_services",
          "text": "Rivedo i servizi collegati.",
          "goto": "services"
        },
        {
          "id": "transit_athlete",
          "text": "Torno al quartiere atleti.",
          "goto": "athlete_quarter"
        }
      ]
    },
    "services": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il personale aiuta i partecipanti a orientarsi. Per competere servono ancora documenti, controlli e Pokémon idonei."
        }
      ],
      "choices": [
        {
          "id": "services_sponsor",
          "text": "Passo alla sponsor row.",
          "goto": "sponsor_row"
        },
        {
          "id": "services_athlete",
          "text": "Passo al quartiere atleti.",
          "goto": "athlete_quarter"
        }
      ]
    },
    "sponsor_row": {
      "stitches": [
        {
          "id": "s1",
          "text": "Gli sponsor hanno allestito piccoli stand. Se hai firmato un accordo in precedenza, qualcuno potrebbe ricordarti gli impegni previsti."
        }
      ],
      "choices": [
        {
          "id": "sponsor_callbacks",
          "text": "Rivedo come il passato viene letto qui.",
          "goto": "callback_wall"
        },
        {
          "id": "sponsor_services",
          "text": "Torno ai servizi.",
          "goto": "services"
        }
      ]
    },
    "quiet_walk": {
      "stitches": [
        {
          "id": "s1",
          "text": "Lungo un vialetto appartato senti finalmente meno voci. La tranquillità può esserti utile, anche se significa perdere qualche incontro casuale."
        }
      ],
      "choices": [
        {
          "id": "quiet_observe",
          "text": "Salgo al punto di osservazione.",
          "goto": "observation_deck"
        },
        {
          "id": "quiet_lodging",
          "text": "Torno agli alloggi.",
          "goto": "lodging"
        }
      ]
    },
    "observation_deck": {
      "stitches": [
        {
          "id": "s1",
          "text": "Dalla terrazza osservi l'arena e gli spazi comuni. Sai quanti allenatori sono arrivati, ma non quali finiranno nel tuo gruppo."
        }
      ],
      "choices": [
        {
          "id": "observe_schedule",
          "text": "Controllo la bacheca schedule.",
          "goto": "schedule_board"
        },
        {
          "id": "observe_hub",
          "text": "Scendo verso l'hub.",
          "goto": "village_hub"
        }
      ]
    },
    "schedule_board": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il programma elenca allenamenti, interviste e cerimonia. Il sorteggio non è ancora avvenuto."
        }
      ],
      "choices": [
        {
          "id": "schedule_social",
          "text": "Uso la schedule per capire quali incontri sono plausibili.",
          "goto": "social_crossroads"
        },
        {
          "id": "schedule_training",
          "text": "Torno agli avvisi training.",
          "goto": "training_notice"
        }
      ]
    },
    "callback_wall": {
      "stitches": [
        {
          "id": "s1",
          "text": "Fra le fotografie del circuito riconosci luoghi e persone del tuo viaggio. Non tutte le immagini riguardano eventi a cui hai partecipato."
        }
      ],
      "choices": [
        {
          "id": "callback_social",
          "text": "Porto questi callback nelle interazioni sociali.",
          "goto": "social_crossroads"
        },
        {
          "id": "callback_legendary",
          "text": "Rileggo la pista personale raccolta prima del Mondiale, senza inseguire alcun Pokémon.",
          "goto": "social_crossroads",
          "conditions": {
            "any": [
              {
                "all": [
                  {
                    "path": "player.name",
                    "eq": "Luke"
                  },
                  {
                    "path": "world.flags.legendary_m08_qualified_luke",
                    "eq": true
                  }
                ]
              },
              {
                "all": [
                  {
                    "path": "player.name",
                    "eq": "Mattew"
                  },
                  {
                    "path": "world.flags.legendary_m08_qualified_mattew",
                    "eq": true
                  }
                ]
              },
              {
                "all": [
                  {
                    "path": "player.name",
                    "eq": "Daniel"
                  },
                  {
                    "path": "world.flags.legendary_m08_qualified_daniel",
                    "eq": true
                  }
                ]
              },
              {
                "all": [
                  {
                    "path": "player.name",
                    "eq": "Edward"
                  },
                  {
                    "path": "world.flags.legendary_m08_qualified_edward",
                    "eq": true
                  }
                ]
              },
              {
                "all": [
                  {
                    "path": "player.name",
                    "eq": "Fab"
                  },
                  {
                    "path": "world.flags.legendary_m08_qualified_fab",
                    "eq": true
                  }
                ]
              }
            ]
          },
          "effects": [
            {
              "type": "set_flag",
              "key": "legendary_m08_village_reflection",
              "value": true
            }
          ]
        }
      ]
    },
    "social_crossroads": {
      "stitches": [
        {
          "id": "s1",
          "text": "Puoi cercare una conversazione oppure proseguire per conto tuo. Le persone raggiungibili dipendono da dove si trovano adesso."
        }
      ],
      "choices": [
        {
          "id": "social_friend",
          "text": "Controllo se uno dei Four potrebbe essere presente.",
          "goto": "friend_presence_hint"
        },
        {
          "id": "social_anchor",
          "text": "Controllo se l'Anchor del modulo può essere presente.",
          "goto": "anchor_presence_hint"
        },
        {
          "id": "social_wait",
          "text": "Aspetto e lascio cambiare i flussi.",
          "goto": "wait_window"
        }
      ]
    },
    "friend_presence_hint": {
      "stitches": [
        {
          "id": "s1",
          "text": "Se uno degli amici è nel Village potreste incrociarvi; altrimenti potrai provare a chiamarlo. Non tutti hanno seguito la tua stessa rotta."
        }
      ],
      "choices": [
        {
          "id": "friend_social",
          "text": "Torno alle interazioni sociali.",
          "goto": "social_crossroads"
        },
        {
          "id": "friend_commit",
          "text": "Registro il criterio di causalità.",
          "goto": "village_commit",
          "effects": [
            {
              "type": "set_flag",
              "key": "m8_friend_presence_rule_known",
              "value": true
            }
          ]
        }
      ]
    },
    "anchor_presence_hint": {
      "stitches": [
        {
          "id": "s1",
          "text": "Fra i nomi del programma compare Astrid Vahl. La campionessa ha orari propri e non aspetta sempre nelle aree comuni."
        }
      ],
      "choices": [
        {
          "id": "anchor_social",
          "text": "Torno alle interazioni sociali.",
          "goto": "social_crossroads"
        },
        {
          "id": "anchor_commit",
          "text": "Registro il criterio di presenza dell'Anchor.",
          "goto": "village_commit",
          "effects": [
            {
              "type": "set_flag",
              "key": "m8_astrid_presence_rule_known",
              "value": true
            }
          ]
        }
      ]
    },
    "wait_window": {
      "stitches": [
        {
          "id": "s1",
          "text": "Passa un'ora. Alcuni atleti rientrano, altri partono per allenarsi e gli spazi cambiano volto."
        }
      ],
      "choices": [
        {
          "id": "wait_hour",
          "text": "Aspetto un'ora e torno alle interazioni.",
          "goto": "social_crossroads",
          "timeCostMinutes": 60
        },
        {
          "id": "wait_commit",
          "text": "Chiudo l'orientamento senza altra attesa.",
          "goto": "village_commit"
        }
      ]
    },
    "village_commit": {
      "stitches": [
        {
          "id": "s1",
          "text": "Ora conosci gli spazi principali del Village e sai dove cercare servizi o contatti possibili."
        }
      ],
      "choices": [
        {
          "id": "commit_now",
          "text": "Registro l'orientamento al Village.",
          "goto": "village_complete",
          "effects": [
            {
              "type": "set_flag",
              "key": "m8_world_village_orientation_complete",
              "value": true
            },
            {
              "type": "set_location",
              "locationId": "world_village"
            }
          ]
        },
        {
          "id": "commit_social",
          "text": "Torno alle aree comuni.",
          "goto": "social_crossroads"
        }
      ]
    },
    "village_complete": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il Village rimane il tuo punto di riferimento mentre prosegui verso gli incontri con Astrid e gli amici."
        }
      ],
      "choices": [
        {
          "id": "complete_astrid",
          "text": "Proseguo verso l'incontro disponibile con Astrid.",
          "goto": "m08-astrid-enters#astrid_entry",
          "conditions": {
            "path": "world.flags.m8_astrid_available",
            "eq": true
          }
        },
        {
          "id": "complete_hub",
          "text": "Resto libero nel World Village.",
          "goto": "village_hub"
        },
        {
          "id": "complete_schedule",
          "text": "Rivedo la schedule prima del prossimo blocco.",
          "goto": "schedule_board"
        }
      ]
    }
  }
}
