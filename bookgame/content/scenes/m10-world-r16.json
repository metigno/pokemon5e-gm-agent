{
  "schemaVersion": 1,
  "id": "m10-world-r16",
  "moduleId": "M10",
  "title": "M10_03 — World R16",
  "locationId": "world_knockout_hall",
  "entryNodeId": "r16_entry",
  "conditions": {
    "all": [
      {
        "path": "world.flags.m10_r16_prep_complete",
        "eq": true
      },
      {
        "path": "competition.world.knockout.opened",
        "eq": true
      }
    ]
  },
  "nodes": {
    "r16_entry": {
      "stitches": [
        {
          "id": "s1",
          "text": "È il giorno dei ottavi. L'arena si prepara a un incontro senza ripescaggio: chi perde dovrà abbandonare la corsa al titolo."
        }
      ],
      "choices": [
        {
          "id": "entry_opponent",
          "text": "Apro la scheda dell'avversario reale.",
          "goto": "opponent_card"
        },
        {
          "id": "entry_rules",
          "text": "Rileggo le regole ufficiali.",
          "goto": "rules"
        },
        {
          "id": "entry_pressure",
          "text": "Guardo il contesto degli altri ottavi.",
          "goto": "world_pressure"
        }
      ]
    },
    "opponent_card": {
      "stitches": [
        {
          "id": "s1",
          "text": "Sul tabellone è scritto il tuo avversario: {{competition.world.knockout.playerR16Opponent.name}}. È il nome uscito dagli incontri precedenti, non quello scelto per creare uno spettacolo."
        }
      ],
      "choices": [
        {
          "id": "opponent_callback",
          "text": "Controllo i precedenti leciti.",
          "goto": "opponent_callback"
        },
        {
          "id": "opponent_roster",
          "text": "Controllo il mio roster prima del bridge.",
          "goto": "roster_state"
        },
        {
          "id": "opponent_ready",
          "text": "Passo alla readiness.",
          "goto": "readiness"
        }
      ]
    },
    "opponent_callback": {
      "stitches": [
        {
          "id": "s1",
          "text": "Se vi siete già incontrati, potreste riconoscere gesti e abitudini. Il passato può rendere il saluto più teso, non cambiare il verdetto."
        }
      ],
      "choices": [
        {
          "id": "callback_pressure",
          "text": "Ragiono sulla pressione del duello.",
          "goto": "pressure"
        },
        {
          "id": "callback_ready",
          "text": "Chiudo il callback e continuo.",
          "goto": "readiness"
        }
      ]
    },
    "rules": {
      "stitches": [
        {
          "id": "s1",
          "text": "L'arbitro ricorda il formato Singles, sei Pokémon ufficiali. Una vittoria apre la strada ai quarti; una sconfitta chiude il percorso."
        }
      ],
      "choices": [
        {
          "id": "rules_roster",
          "text": "Controllo la squadra registrata.",
          "goto": "roster_state"
        },
        {
          "id": "rules_integrity",
          "text": "Controllo l'idempotenza del match.",
          "goto": "match_integrity"
        },
        {
          "id": "rules_ready",
          "text": "Passo alla readiness.",
          "goto": "readiness"
        }
      ]
    },
    "roster_state": {
      "stitches": [
        {
          "id": "s1",
          "text": "Prima di entrare conti i sei Pokémon idonei. Nessuno viene sostituito o guarito per il solo fatto di essere arrivato fin qui."
        }
      ],
      "choices": [
        {
          "id": "roster_resources",
          "text": "Controllo HP/PP persistenti.",
          "goto": "resources_before"
        },
        {
          "id": "roster_ready",
          "text": "Procedo verso la readiness.",
          "goto": "readiness"
        }
      ]
    },
    "resources_before": {
      "stitches": [
        {
          "id": "s1",
          "text": "La squadra conserva la fatica delle gare precedenti e delle cure effettivamente fatte. Controlli cosa puoi ancora usare."
        }
      ],
      "choices": [
        {
          "id": "resources_risk",
          "text": "Valuto il rischio di entrare così.",
          "goto": "pressure"
        },
        {
          "id": "resources_ready",
          "text": "Accetto lo stato e procedo.",
          "goto": "readiness"
        }
      ]
    },
    "pressure": {
      "stitches": [
        {
          "id": "s1",
          "text": "Gli spalti sono pieni e il margine d'errore è minimo. La pressione si sente nei gesti e nelle scelte, non cambia magicamente la forza dei Pokémon."
        }
      ],
      "choices": [
        {
          "id": "pressure_world",
          "text": "Guardo cosa succede negli altri ottavi.",
          "goto": "world_pressure"
        },
        {
          "id": "pressure_ready",
          "text": "Passo alla readiness.",
          "goto": "readiness"
        }
      ]
    },
    "world_pressure": {
      "stitches": [
        {
          "id": "s1",
          "text": "Sugli altri campi sono previsti anche gli altri incontri dei ottavi. Le loro vittorie e sconfitte non aspettano il tuo consenso."
        }
      ],
      "choices": [
        {
          "id": "world_integrity",
          "text": "Controllo come evitare doppi risultati.",
          "goto": "match_integrity"
        },
        {
          "id": "world_ready",
          "text": "Torno al mio match.",
          "goto": "readiness"
        }
      ]
    },
    "match_integrity": {
      "stitches": [
        {
          "id": "s1",
          "text": "L'ufficiale controlla il referto. Se questa partita è già stata giocata non può essere ripetuta per ottenere un risultato diverso."
        }
      ],
      "choices": [
        {
          "id": "integrity_rules",
          "text": "Rivedo le regole.",
          "goto": "rules"
        },
        {
          "id": "integrity_handoff",
          "text": "Passo al bridge.",
          "goto": "match_handoff"
        }
      ]
    },
    "readiness": {
      "stitches": [
        {
          "id": "s1",
          "text": "Alla chiamata dell'arbitro confermi accredito e squadra. Il prossimo passo è presentarti sul terreno di gara."
        }
      ],
      "choices": [
        {
          "id": "ready_handoff",
          "text": "Avvio la procedura ufficiale.",
          "goto": "match_handoff"
        },
        {
          "id": "ready_back",
          "text": "Torno alla scheda dell'avversario.",
          "goto": "opponent_card"
        },
        {
          "id": "ready_pressure",
          "text": "Rileggo il rischio del single elimination.",
          "goto": "pressure"
        }
      ]
    },
    "match_handoff": {
      "stitches": [
        {
          "id": "s1",
          "text": "{{competition.world.knockout.playerR16Opponent.name}} si schiera dall'altra parte. L'arbitro solleva il braccio: lo scontro comincia."
        }
      ],
      "choices": [
        {
          "id": "fight_r16",
          "text": "Combatto l'ottavo di finale.",
          "combat": {
            "encounterId": "WORLD_R16_PLAYER",
            "opponentRegistered": true,
            "competition": {
              "type": "official_match",
              "matchId": "WORLD_R16_PLAYER",
              "format": "Singles",
              "officialRosterSize": 6,
              "difficulty": "ELITE",
              "worldKnockoutRound": "R16"
            },
            "returnNodes": {
              "win": "win_return",
              "lose": "loss_return"
            },
            "goto": "match_handoff"
          },
          "conditions": {
            "path": "world.flags.world_r16_resolved",
            "ne": true
          }
        },
        {
          "id": "handoff_back",
          "text": "Non entro ancora: torno alla readiness.",
          "goto": "readiness"
        }
      ]
    },
    "win_return": {
      "stitches": [
        {
          "id": "s1",
          "text": "Hai vinto. Gli spalti reagiscono e il tabellone ti avvicina ai quarti, mentre gli altri incontri devono ancora concludersi."
        }
      ],
      "choices": [
        {
          "id": "win_record",
          "text": "Registro la chiusura narrativa del mio ottavo.",
          "goto": "result_record",
          "effects": [
            {
              "type": "set_flag",
              "key": "m10_world_r16_complete",
              "value": true
            }
          ]
        },
        {
          "id": "win_resources",
          "text": "Controllo cosa il match ha lasciato al team.",
          "goto": "resources_after",
          "effects": [
            {
              "type": "set_flag",
              "key": "m10_world_r16_complete",
              "value": true
            }
          ]
        }
      ]
    },
    "loss_return": {
      "stitches": [
        {
          "id": "s1",
          "text": "Hai perso ai ottavi. Il verdetto chiude la tua corsa al titolo in questa edizione; i tuoi amici e gli altri allenatori proseguiranno secondo i propri risultati."
        }
      ],
      "choices": [
        {
          "id": "loss_record",
          "text": "Registro la chiusura narrativa del mio ottavo.",
          "goto": "result_record",
          "effects": [
            {
              "type": "set_flag",
              "key": "m10_world_r16_complete",
              "value": true
            }
          ]
        },
        {
          "id": "loss_resources",
          "text": "Controllo lo stato del team dopo l'eliminazione.",
          "goto": "resources_after",
          "effects": [
            {
              "type": "set_flag",
              "key": "m10_world_r16_complete",
              "value": true
            }
          ]
        }
      ]
    },
    "result_record": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il personale firma il referto della partita, con entrambi i nomi e il risultato effettivo."
        }
      ],
      "choices": [
        {
          "id": "record_outcome",
          "text": "Leggo la conseguenza competitiva.",
          "goto": "outcome_meaning"
        },
        {
          "id": "record_resources",
          "text": "Controllo le risorse persistenti.",
          "goto": "resources_after"
        },
        {
          "id": "record_world",
          "text": "Guardo gli altri ottavi ancora da chiudere.",
          "goto": "other_r16"
        }
      ]
    },
    "outcome_meaning": {
      "stitches": [
        {
          "id": "s1",
          "text": "Se hai vinto puoi prepararti per i quarti; se hai perso, il torneo continuerà senza di te. Nessun commento della stampa cambia l'esito."
        }
      ],
      "choices": [
        {
          "id": "outcome_other",
          "text": "Passo agli altri risultati R16.",
          "goto": "other_r16"
        },
        {
          "id": "outcome_history",
          "text": "Rileggo l'audit del record.",
          "goto": "history_audit"
        }
      ]
    },
    "resources_after": {
      "stitches": [
        {
          "id": "s1",
          "text": "Al termine controlli i Pokémon. Le ferite e le risorse consumate rimangono reali, qualunque sia il risultato."
        }
      ],
      "choices": [
        {
          "id": "resources_history",
          "text": "Controllo che il match sia stato registrato una sola volta.",
          "goto": "history_audit"
        },
        {
          "id": "resources_next",
          "text": "Passo alla chiusura dell'ottavo.",
          "goto": "aftermath_gate"
        }
      ]
    },
    "other_r16": {
      "stitches": [
        {
          "id": "s1",
          "text": "Gli altri sette ottavi si giocano con i rispettivi partecipanti. Nessun vecchio campione ha diritto a passare senza vincere."
        }
      ],
      "choices": [
        {
          "id": "other_silas",
          "text": "Controllo il caso di Silas senza proteggerlo.",
          "goto": "silas_result_context"
        },
        {
          "id": "other_gate",
          "text": "Vado al gate dell'aftermath.",
          "goto": "aftermath_gate"
        }
      ]
    },
    "silas_result_context": {
      "stitches": [
        {
          "id": "s1",
          "text": "Se Silas è ancora negli ottavi, il suo risultato sarà quello del suo incontro. La reputazione non vale come qualificazione."
        }
      ],
      "choices": [
        {
          "id": "silas_world",
          "text": "Torno al quadro degli altri ottavi.",
          "goto": "other_r16"
        },
        {
          "id": "silas_gate",
          "text": "Procedo al gate dell'aftermath.",
          "goto": "aftermath_gate"
        }
      ]
    },
    "history_audit": {
      "stitches": [
        {
          "id": "s1",
          "text": "Rileggi il referto conservato dall'organizzazione. La partita compare una volta sola, accanto agli incontri già disputati."
        }
      ],
      "choices": [
        {
          "id": "history_integrity",
          "text": "Rileggo l'idempotenza.",
          "goto": "match_integrity"
        },
        {
          "id": "history_gate",
          "text": "Passo al gate di chiusura.",
          "goto": "aftermath_gate"
        }
      ]
    },
    "aftermath_gate": {
      "stitches": [
        {
          "id": "s1",
          "text": "La segreteria attende il verdetto di questa partita prima di chiudere tutti gli incontri dei ottavi."
        }
      ],
      "choices": [
        {
          "id": "gate_aftermath",
          "text": "Apro l'aftermath R16.",
          "goto": "m10-r16-aftermath#aftermath_entry"
        },
        {
          "id": "gate_review",
          "text": "Rivedo il record prima di uscire.",
          "goto": "r16_complete"
        }
      ]
    },
    "r16_complete": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il tuo incontro dei ottavi è terminato. Restano i risultati sugli altri campi prima dell'annuncio del turno successivo."
        }
      ],
      "choices": [
        {
          "id": "complete_gate",
          "text": "Procedo all'aftermath.",
          "goto": "aftermath_gate"
        },
        {
          "id": "complete_history",
          "text": "Rileggo l'history ufficiale.",
          "goto": "history_audit"
        }
      ]
    }
  }
}
