{
  "schemaVersion": 1,
  "id": "m09-matchday-two",
  "moduleId": "M09",
  "title": "M9_04 — Matchday Two",
  "locationId": "world_group_arena",
  "entryNodeId": "matchday_entry",
  "conditions": {
    "all": [
      {
        "path": "world.flags.m9_interday_one_complete",
        "eq": true
      },
      {
        "path": "world.flags.m9_kaia_thread_complete",
        "eq": true
      },
      {
        "path": "world.flags.world_group_md1_resolved",
        "eq": true
      },
      {
        "path": "competition.world.groupStage.playerMatches.0.outcome",
        "exists": true
      }
    ]
  },
  "nodes": {
    "matchday_entry": {
      "stitches": [
        {
          "id": "s1",
          "text": "È il giorno della seconda partita del girone. Il tabellone indica {{competition.world.playerOpponents.1.name}} come tuo avversario: le porte dell'arena si stanno aprendo."
        }
      ],
      "choices": [
        {
          "id": "entry_opponent",
          "text": "Apro la scheda del secondo avversario.",
          "goto": "opponent_card"
        },
        {
          "id": "entry_rules",
          "text": "Rileggo formato e vincoli.",
          "goto": "rules"
        },
        {
          "id": "entry_table",
          "text": "Guardo la classifica prima del secondo match.",
          "goto": "standings_before"
        }
      ]
    },
    "opponent_card": {
      "stitches": [
        {
          "id": "s1",
          "text": "{{competition.world.playerOpponents.1.name}} entra nella zona riservata agli allenatori. Puoi consultare i dati pubblici della sua squadra, non anticipare le scelte che farà."
        }
      ],
      "choices": [
        {
          "id": "card_schedule",
          "text": "Controllo il lock del Matchday 2.",
          "goto": "schedule_lock"
        },
        {
          "id": "card_roster",
          "text": "Controllo il mio Official Six dopo il primo match.",
          "goto": "roster_state"
        },
        {
          "id": "card_callbacks",
          "text": "Rivedo eventuali precedenti senza alterare il risultato.",
          "goto": "opponent_callback"
        }
      ]
    },
    "rules": {
      "stitches": [
        {
          "id": "s1",
          "text": "L'arbitro ricorda il formato: Singles, sei Pokémon registrati e verdetto sul campo. Non sono previsti incontri ripetuti per cambiare risultato."
        }
      ],
      "choices": [
        {
          "id": "rules_roster",
          "text": "Controllo la disponibilità della squadra.",
          "goto": "roster_state"
        },
        {
          "id": "rules_schedule",
          "text": "Controllo il calendario lockato.",
          "goto": "schedule_lock"
        },
        {
          "id": "rules_ready",
          "text": "Passo alla preparazione finale.",
          "goto": "readiness"
        }
      ]
    },
    "schedule_lock": {
      "stitches": [
        {
          "id": "s1",
          "text": "L'orario della seconda giornata è fissato. Se hai già disputato questa partita, sul tabellone compare il referto, non una nuova convocazione."
        }
      ],
      "choices": [
        {
          "id": "schedule_table",
          "text": "Rileggo la tabella pre-match.",
          "goto": "standings_before"
        },
        {
          "id": "schedule_ready",
          "text": "Procedo verso la conferma.",
          "goto": "readiness"
        }
      ]
    },
    "standings_before": {
      "stitches": [
        {
          "id": "s1",
          "text": "Le giornate precedenti hanno già prodotto punti che nessuna nuova gara cancellerà. Guardi la classifica prima di entrare: il verdetto definitivo arriverà soltanto alla fine del girone."
        }
      ],
      "choices": [
        {
          "id": "table_world",
          "text": "Controllo l'altro incontro previsto oggi.",
          "goto": "world_pressure"
        },
        {
          "id": "table_ready",
          "text": "Passo alla readiness.",
          "goto": "readiness"
        }
      ]
    },
    "roster_state": {
      "stitches": [
        {
          "id": "s1",
          "text": "Controlli i sei Pokémon disponibili. Nessun addetto ti presta membri mancanti o elimina le conseguenze degli incontri precedenti."
        }
      ],
      "choices": [
        {
          "id": "roster_medical",
          "text": "Controllo il rischio residuo.",
          "goto": "medical_state"
        },
        {
          "id": "roster_ready",
          "text": "Passo alla conferma del secondo match.",
          "goto": "readiness"
        }
      ]
    },
    "medical_state": {
      "stitches": [
        {
          "id": "s1",
          "text": "Se un Pokémon è stanco o ferito, devi considerarlo prima del match. Le eventuali cure richiedono servizi e tempi reali."
        }
      ],
      "choices": [
        {
          "id": "medical_roster",
          "text": "Torno al roster.",
          "goto": "roster_state"
        },
        {
          "id": "medical_ready",
          "text": "Accetto lo stato reale e continuo.",
          "goto": "readiness"
        }
      ]
    },
    "readiness": {
      "stitches": [
        {
          "id": "s1",
          "text": "Alla chiamata dell'arbitro mostri l'accredito e la squadra. Una volta verificata la presenza, raggiungi la tua postazione."
        }
      ],
      "choices": [
        {
          "id": "ready_handoff",
          "text": "Avvio la procedura ufficiale.",
          "goto": "match_handoff"
        },
        {
          "id": "ready_back",
          "text": "Non entro ancora: torno alle regole.",
          "goto": "rules"
        }
      ]
    },
    "match_handoff": {
      "stitches": [
        {
          "id": "s1",
          "text": "{{competition.world.playerOpponents.1.name}} si dispone dall'altro lato del campo. L'arbitro alza il braccio e dà il segnale d'inizio."
        }
      ],
      "choices": [
        {
          "id": "fight_matchday_two",
          "text": "Combatto il Matchday 2.",
          "combat": {
            "encounterId": "WORLD_GROUP_MD2",
            "opponentRegistered": true,
            "competition": {
              "type": "official_match",
              "matchId": "WORLD_GROUP_MD2",
              "format": "Singles",
              "officialRosterSize": 6,
              "difficulty": "ELITE",
              "worldOpponentIndex": 1,
              "worldMatchday": 2
            },
            "returnNodes": {
              "win": "win_return",
              "lose": "loss_return"
            },
            "goto": "match_handoff"
          },
          "conditions": {
            "path": "world.flags.world_group_md2_resolved",
            "ne": true
          }
        }
      ]
    },
    "win_return": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il segnale finale conferma la vittoria contro {{competition.world.playerOpponents.1.name}}. Il risultato entrerà nella classifica insieme a quello dell'altra gara del gruppo."
        }
      ],
      "choices": [
        {
          "id": "win_record",
          "text": "Registro la chiusura narrativa del secondo Matchday.",
          "goto": "result_record",
          "effects": [
            {
              "type": "set_flag",
              "key": "m9_matchday_two_complete",
              "value": true
            }
          ]
        },
        {
          "id": "win_table",
          "text": "Guardo subito la classifica aggiornata.",
          "goto": "standings_after",
          "effects": [
            {
              "type": "set_flag",
              "key": "m9_matchday_two_complete",
              "value": true
            }
          ]
        }
      ]
    },
    "loss_return": {
      "stitches": [
        {
          "id": "s1",
          "text": "La partita contro {{competition.world.playerOpponents.1.name}} è finita con una sconfitta. Non puoi cancellarla, ma restano ancora giornate da disputare prima del verdetto finale."
        }
      ],
      "choices": [
        {
          "id": "loss_record",
          "text": "Registro la chiusura narrativa del secondo Matchday.",
          "goto": "result_record",
          "effects": [
            {
              "type": "set_flag",
              "key": "m9_matchday_two_complete",
              "value": true
            }
          ]
        },
        {
          "id": "loss_resources",
          "text": "Controllo le risorse rimaste.",
          "goto": "resources_after",
          "effects": [
            {
              "type": "set_flag",
              "key": "m9_matchday_two_complete",
              "value": true
            }
          ]
        }
      ]
    },
    "result_record": {
      "stitches": [
        {
          "id": "s1",
          "text": "L'addetto registra il risultato della seconda giornata con il nome del tuo avversario. Le gare precedenti rimangono nel referto."
        }
      ],
      "choices": [
        {
          "id": "record_offscreen",
          "text": "Controllo l'altro match della seconda giornata.",
          "goto": "offscreen_result"
        },
        {
          "id": "record_table",
          "text": "Apro la nuova classifica.",
          "goto": "standings_after"
        },
        {
          "id": "record_resources",
          "text": "Controllo cosa resta per il prossimo blocco.",
          "goto": "resources_after"
        }
      ]
    },
    "offscreen_result": {
      "stitches": [
        {
          "id": "s1",
          "text": "Nel frattempo si è disputata anche l'altra partita del gruppo. I suoi allenatori hanno avuto un risultato proprio, che può influenzare la classifica."
        }
      ],
      "choices": [
        {
          "id": "offscreen_table",
          "text": "Vedo l'effetto sulla classifica.",
          "goto": "standings_after"
        },
        {
          "id": "offscreen_world",
          "text": "Guardo la pressione del torneo nel suo insieme.",
          "goto": "world_pressure"
        }
      ]
    },
    "standings_after": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il risultato della seconda giornata si aggiunge ai precedenti senza cancellarli. Il tabellone si aggiorna davanti al pubblico; il piazzamento rimane provvisorio."
        }
      ],
      "choices": [
        {
          "id": "after_resources",
          "text": "Controllo le risorse residue.",
          "goto": "resources_after"
        },
        {
          "id": "after_window",
          "text": "Passo alla pressione tra seconda e terza giornata.",
          "goto": "next_window"
        },
        {
          "id": "after_offscreen",
          "text": "Rivedo l'altro risultato.",
          "goto": "offscreen_result"
        }
      ]
    },
    "resources_after": {
      "stitches": [
        {
          "id": "s1",
          "text": "Fuori dal campo ritrovi i Pokémon nelle condizioni lasciate dallo scontro. Una vittoria non restituisce automaticamente energie, una sconfitta non le cancella."
        }
      ],
      "choices": [
        {
          "id": "resources_medical",
          "text": "Rileggo il principio di persistenza.",
          "goto": "medical_state"
        },
        {
          "id": "resources_next",
          "text": "Passo alla finestra successiva.",
          "goto": "next_window"
        }
      ]
    },
    "opponent_callback": {
      "stitches": [
        {
          "id": "s1",
          "text": "Se conoscevi già l'avversario, un saluto o una reazione può ricordare quel rapporto. L'incontro appena giocato mantiene comunque il proprio verdetto."
        }
      ],
      "choices": [
        {
          "id": "callback_card",
          "text": "Torno alla scheda dell'avversario.",
          "goto": "opponent_card"
        },
        {
          "id": "callback_ready",
          "text": "Chiudo il callback e preparo il match.",
          "goto": "readiness"
        }
      ]
    },
    "world_pressure": {
      "stitches": [
        {
          "id": "s1",
          "text": "Mentre tu giocavi, negli altri gironi sono continuate gare e carriere. Il Mondiale non è rimasto in attesa del tuo prossimo passo."
        }
      ],
      "choices": [
        {
          "id": "pressure_table",
          "text": "Torno alla mia classifica.",
          "goto": "standings_after"
        },
        {
          "id": "pressure_window",
          "text": "Entro nella finestra dopo il secondo match.",
          "goto": "next_window"
        }
      ]
    },
    "next_window": {
      "stitches": [
        {
          "id": "s1",
          "text": "Fra la seconda e la terza giornata restano possibili incontri con amici e scelte di recupero. I punti già ottenuti non si possono negoziare."
        }
      ],
      "choices": [
        {
          "id": "window_gate",
          "text": "Controllo il gate di chiusura del secondo Matchday.",
          "goto": "friend_beat_gate"
        },
        {
          "id": "window_table",
          "text": "Prima rileggo i punti attuali.",
          "goto": "standings_after"
        }
      ]
    },
    "friend_beat_gate": {
      "stitches": [
        {
          "id": "s1",
          "text": "Puoi provare a contattare un amico che sia davvero raggiungibile, prima dell'ultima partita del gruppo."
        }
      ],
      "choices": [
        {
          "id": "gate_complete",
          "text": "Chiudo formalmente M9_04.",
          "goto": "matchday_complete"
        },
        {
          "id": "gate_review",
          "text": "Rivedo il record della seconda giornata.",
          "goto": "result_record"
        }
      ]
    },
    "matchday_complete": {
      "stitches": [
        {
          "id": "s1",
          "text": "La seconda giornata è conclusa. Il risultato rimane sul tabellone e la squadra conserva ciò che ha consumato."
        }
      ],
      "choices": [
        {
          "id": "complete_hold",
          "text": "Passo a FRIEND_BEAT_09 senza modificare la classifica.",
          "goto": "m09-friend-beat-09#friend_entry"
        }
      ]
    }
  }
}
