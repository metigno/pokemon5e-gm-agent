{
  "schemaVersion": 1,
  "id": "m09-matchday-two",
  "moduleId": "M09",
  "title": "M9_04 — Matchday Two",
  "locationId": "world_group_arena",
  "entryNodeId": "matchday_entry",
  "conditions": {
    "all": [
      {
        "path": "world.flags.m9_interday_one_complete",
        "eq": true
      },
      {
        "path": "world.flags.m9_kaia_thread_complete",
        "eq": true
      },
      {
        "path": "world.flags.world_group_md1_resolved",
        "eq": true
      },
      {
        "path": "competition.world.groupStage.playerMatches.0.outcome",
        "exists": true
      }
    ]
  },
  "nodes": {
    "matchday_entry": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il secondo Matchday legge l'indice 1 dello stesso draw lockato. Oggi giochi contro {{competition.world.playerOpponents.1.name}}; il primo risultato resta nello storico."
        }
      ],
      "choices": [
        {
          "id": "entry_opponent",
          "text": "Apro la scheda del secondo avversario.",
          "goto": "opponent_card"
        },
        {
          "id": "entry_rules",
          "text": "Rileggo formato e vincoli.",
          "goto": "rules"
        },
        {
          "id": "entry_table",
          "text": "Guardo la classifica prima del secondo match.",
          "goto": "standings_before"
        }
      ]
    },
    "opponent_card": {
      "stitches": [
        {
          "id": "s1",
          "text": "{{competition.world.playerOpponents.1.name}} è il secondo avversario persistente del tuo gruppo. Il roster regolamentato viene materializzato una volta e conserva la propria identità di match."
        }
      ],
      "choices": [
        {
          "id": "card_schedule",
          "text": "Controllo il lock del Matchday 2.",
          "goto": "schedule_lock"
        },
        {
          "id": "card_roster",
          "text": "Controllo il mio Official Six dopo il primo match.",
          "goto": "roster_state"
        },
        {
          "id": "card_callbacks",
          "text": "Rivedo eventuali precedenti senza alterare il risultato.",
          "goto": "opponent_callback"
        }
      ]
    },
    "rules": {
      "stitches": [
        {
          "id": "s1",
          "text": "Formato ancora Singles Official Six. La prima giornata non concede retry né vantaggi nascosti: il secondo match parte dallo stato che hai realmente conservato."
        }
      ],
      "choices": [
        {
          "id": "rules_roster",
          "text": "Controllo la disponibilità della squadra.",
          "goto": "roster_state"
        },
        {
          "id": "rules_schedule",
          "text": "Controllo il calendario lockato.",
          "goto": "schedule_lock"
        },
        {
          "id": "rules_ready",
          "text": "Passo alla preparazione finale.",
          "goto": "readiness"
        }
      ]
    },
    "schedule_lock": {
      "stitches": [
        {
          "id": "s1",
          "text": "E5 associa WORLD_GROUP_MD2 al secondo nome del draw. WORLD_GROUP_MD1 rimane intatto e un doppio avvio del Matchday 2 viene rifiutato."
        }
      ],
      "choices": [
        {
          "id": "schedule_table",
          "text": "Rileggo la tabella pre-match.",
          "goto": "standings_before"
        },
        {
          "id": "schedule_ready",
          "text": "Procedo verso la conferma.",
          "goto": "readiness"
        }
      ]
    },
    "standings_before": {
      "stitches": [
        {
          "id": "s1",
          "text": "I punti prima del Matchday 2 includono entrambi i match della prima giornata. La posizione è provvisoria e non concede ancora accesso agli ottavi."
        }
      ],
      "choices": [
        {
          "id": "table_world",
          "text": "Controllo l'altro incontro previsto oggi.",
          "goto": "world_pressure"
        },
        {
          "id": "table_ready",
          "text": "Passo alla readiness.",
          "goto": "readiness"
        }
      ]
    },
    "roster_state": {
      "stitches": [
        {
          "id": "s1",
          "text": "La squadra entra con lo stato realmente lasciato da Matchday 1 e Interday 1. Nessuna scelta qui aggiunge HP, PP o Pokémon."
        }
      ],
      "choices": [
        {
          "id": "roster_medical",
          "text": "Controllo il rischio residuo.",
          "goto": "medical_state"
        },
        {
          "id": "roster_ready",
          "text": "Passo alla conferma del secondo match.",
          "goto": "readiness"
        }
      ]
    },
    "medical_state": {
      "stitches": [
        {
          "id": "s1",
          "text": "Eventuale recupero deve essere già avvenuto tramite i sistemi appropriati. Il gate del Matchday legge il roster, non lo corregge."
        }
      ],
      "choices": [
        {
          "id": "medical_roster",
          "text": "Torno al roster.",
          "goto": "roster_state"
        },
        {
          "id": "medical_ready",
          "text": "Accetto lo stato reale e continuo.",
          "goto": "readiness"
        }
      ]
    },
    "readiness": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il Matchday 2 richiede sei Pokémon e un secondo risultato ancora assente. Da qui il battle bridge risolve il partecipante E5 con indice 1."
        }
      ],
      "choices": [
        {
          "id": "ready_handoff",
          "text": "Avvio la procedura ufficiale.",
          "goto": "match_handoff"
        },
        {
          "id": "ready_back",
          "text": "Non entro ancora: torno alle regole.",
          "goto": "rules"
        }
      ]
    },
    "match_handoff": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il bridge usa il secondo avversario del draw e il suo roster persistente; nessun nome o team alternativo viene selezionato dalla scena."
        }
      ],
      "choices": [
        {
          "id": "fight_matchday_two",
          "text": "Combatto il Matchday 2.",
          "combat": {
            "encounterId": "WORLD_GROUP_MD2",
            "opponentRegistered": true,
            "competition": {
              "type": "official_match",
              "matchId": "WORLD_GROUP_MD2",
              "format": "Singles",
              "officialRosterSize": 6,
              "difficulty": "ELITE",
              "worldOpponentIndex": 1,
              "worldMatchday": 2
            },
            "returnNodes": {
              "win": "win_return",
              "lose": "loss_return"
            },
            "goto": "match_handoff"
          },
          "conditions": {
            "path": "world.flags.world_group_md2_resolved",
            "ne": true
          }
        }
      ]
    },
    "win_return": {
      "stitches": [
        {
          "id": "s1",
          "text": "La seconda vittoria viene aggiunta alla history E5 senza riscrivere il Matchday 1. La nuova classifica include quattro match complessivi del gruppo."
        }
      ],
      "choices": [
        {
          "id": "win_record",
          "text": "Registro la chiusura narrativa del secondo Matchday.",
          "goto": "result_record",
          "effects": [
            {
              "type": "set_flag",
              "key": "m9_matchday_two_complete",
              "value": true
            }
          ]
        },
        {
          "id": "win_table",
          "text": "Guardo subito la classifica aggiornata.",
          "goto": "standings_after",
          "effects": [
            {
              "type": "set_flag",
              "key": "m9_matchday_two_complete",
              "value": true
            }
          ]
        }
      ]
    },
    "loss_return": {
      "stitches": [
        {
          "id": "s1",
          "text": "La sconfitta del Matchday 2 resta insieme al primo risultato. Non elimina automaticamente il player: il terzo incontro deve ancora essere giocato."
        }
      ],
      "choices": [
        {
          "id": "loss_record",
          "text": "Registro la chiusura narrativa del secondo Matchday.",
          "goto": "result_record",
          "effects": [
            {
              "type": "set_flag",
              "key": "m9_matchday_two_complete",
              "value": true
            }
          ]
        },
        {
          "id": "loss_resources",
          "text": "Controllo le risorse rimaste.",
          "goto": "resources_after",
          "effects": [
            {
              "type": "set_flag",
              "key": "m9_matchday_two_complete",
              "value": true
            }
          ]
        }
      ]
    },
    "result_record": {
      "stitches": [
        {
          "id": "s1",
          "text": "E5 conserva ora due risultati player e due match off-screen. La scena legge questa storia, ma non può editarne punti o avversari."
        }
      ],
      "choices": [
        {
          "id": "record_offscreen",
          "text": "Controllo l'altro match della seconda giornata.",
          "goto": "offscreen_result"
        },
        {
          "id": "record_table",
          "text": "Apro la nuova classifica.",
          "goto": "standings_after"
        },
        {
          "id": "record_resources",
          "text": "Controllo cosa resta per il prossimo blocco.",
          "goto": "resources_after"
        }
      ]
    },
    "offscreen_result": {
      "stitches": [
        {
          "id": "s1",
          "text": "Anche l'altro incontro del Matchday 2 viene risolto una sola volta dal seed della carriera. Nessun partecipante viene favorito perché è famoso o narrativamente importante."
        }
      ],
      "choices": [
        {
          "id": "offscreen_table",
          "text": "Vedo l'effetto sulla classifica.",
          "goto": "standings_after"
        },
        {
          "id": "offscreen_world",
          "text": "Guardo la pressione del torneo nel suo insieme.",
          "goto": "world_pressure"
        }
      ]
    },
    "standings_after": {
      "stitches": [
        {
          "id": "s1",
          "text": "Dopo due giornate la classifica è più stretta, ma non è ancora finale. Un vantaggio o uno svantaggio può cambiare al Matchday 3."
        }
      ],
      "choices": [
        {
          "id": "after_resources",
          "text": "Controllo le risorse residue.",
          "goto": "resources_after"
        },
        {
          "id": "after_window",
          "text": "Passo alla pressione tra seconda e terza giornata.",
          "goto": "next_window"
        },
        {
          "id": "after_offscreen",
          "text": "Rivedo l'altro risultato.",
          "goto": "offscreen_result"
        }
      ]
    },
    "resources_after": {
      "stitches": [
        {
          "id": "s1",
          "text": "Le conseguenze meccaniche del secondo match restano sul roster. Il modulo non crea un reset speciale perché il girone è quasi finito."
        }
      ],
      "choices": [
        {
          "id": "resources_medical",
          "text": "Rileggo il principio di persistenza.",
          "goto": "medical_state"
        },
        {
          "id": "resources_next",
          "text": "Passo alla finestra successiva.",
          "goto": "next_window"
        }
      ]
    },
    "opponent_callback": {
      "stitches": [
        {
          "id": "s1",
          "text": "Un precedente incontro con questo trainer può cambiare dialogo o reputazione, non il pairing né l'esito. Il draw resta la source of truth."
        }
      ],
      "choices": [
        {
          "id": "callback_card",
          "text": "Torno alla scheda dell'avversario.",
          "goto": "opponent_card"
        },
        {
          "id": "callback_ready",
          "text": "Chiudo il callback e preparo il match.",
          "goto": "readiness"
        }
      ]
    },
    "world_pressure": {
      "stitches": [
        {
          "id": "s1",
          "text": "Gli altri gruppi e gli altri partecipanti continuano a muoversi. Due giornate non congelano il mondo in attesa del tuo Friend Beat."
        }
      ],
      "choices": [
        {
          "id": "pressure_table",
          "text": "Torno alla mia classifica.",
          "goto": "standings_after"
        },
        {
          "id": "pressure_window",
          "text": "Entro nella finestra dopo il secondo match.",
          "goto": "next_window"
        }
      ]
    },
    "next_window": {
      "stitches": [
        {
          "id": "s1",
          "text": "Tra Matchday 2 e 3 cresceranno pressione, Friend Beat e scenari di classifica. Questi scenari descrivono possibilità, non risultati futuri."
        }
      ],
      "choices": [
        {
          "id": "window_gate",
          "text": "Controllo il gate di chiusura del secondo Matchday.",
          "goto": "friend_beat_gate"
        },
        {
          "id": "window_table",
          "text": "Prima rileggo i punti attuali.",
          "goto": "standings_after"
        }
      ]
    },
    "friend_beat_gate": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il blocco successivo potrà selezionare un amico secondo stato reale e schedule. Non viene creato o teletrasportato da questo Matchday."
        }
      ],
      "choices": [
        {
          "id": "gate_complete",
          "text": "Chiudo formalmente M9_04.",
          "goto": "matchday_complete"
        },
        {
          "id": "gate_review",
          "text": "Rivedo il record della seconda giornata.",
          "goto": "result_record"
        }
      ]
    },
    "matchday_complete": {
      "stitches": [
        {
          "id": "s1",
          "text": "M9_04 è chiuso: due partite sono reali e persistenti. Il ciclo successivo partirà da FRIEND_BEAT_09 senza alterare la classifica già prodotta."
        }
      ],
      "choices": [
        {
          "id": "complete_hold",
          "text": "Resto nel World Village con lo stato attuale in attesa del prossimo blocco.",
          "goto": "standings_after"
        }
      ]
    }
  }
}
