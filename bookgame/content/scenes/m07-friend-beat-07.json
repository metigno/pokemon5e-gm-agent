{
  "schemaVersion": 1,
  "id": "m07-friend-beat-07",
  "moduleId": "M07",
  "title": "M7_05 — Friend Beat 07",
  "locationId": "meridiana_city",
  "entryNodeId": "friend_entry",
  "conditions": {
    "all": [
      {
        "path": "world.flags.m6_complete",
        "eq": true
      },
      {
        "path": "world.flags.m07_unlocked",
        "eq": true
      },
      {
        "path": "world.flags.m7_active",
        "eq": true
      },
      {
        "path": "competition.rank",
        "eq": "S"
      },
      {
        "path": "world.flags.m7_pro_preparation_complete",
        "eq": true
      },
      {
        "path": "world.flags.friend_beat_07_available",
        "eq": true
      }
    ]
  },
  "nodes": {
    "friend_entry": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il telefono vibra mentre attraversi Meridiana. Sullo schermo compare il nome di uno dei tuoi amici. Anche lui ha una giornata piena: per ora, questo è il momento in cui le vostre strade riescono a incrociarsi."
        }
      ],
      "choices": [
        {
          "id": "entry_status",
          "text": "Rileggo gli ultimi messaggi prima di rispondere.",
          "goto": "selector_status"
        },
        {
          "id": "entry_contact",
          "text": "Rispondo al messaggio.",
          "goto": "dispatch"
        }
      ]
    },
    "selector_status": {
      "stitches": [
        {
          "id": "s1",
          "text": "Scorri gli ultimi messaggi del gruppo. Non tutti sono nella stessa città, e qualcuno è impegnato in una gara. Il contatto che hai davanti è quello a cui puoi rispondere adesso."
        }
      ],
      "choices": [
        {
          "id": "status_dispatch",
          "text": "Apro la conversazione.",
          "goto": "dispatch"
        },
        {
          "id": "status_callback",
          "text": "Ripenso agli ultimi incontri con gli amici.",
          "goto": "callback"
        },
        {
          "id": "status_wait",
          "text": "Aspetto un momento prima di rispondere.",
          "goto": "wait_contact"
        }
      ]
    },
    "dispatch": {
      "stitches": [
        {
          "id": "s1",
          "text": "Apri la conversazione. Per un istante rivedi le battute scambiate negli anni, poi arriva un nuovo messaggio: «Allora, campione, sei ancora vivo?»"
        }
      ],
      "choices": [
        {
          "id": "dispatch_luke",
          "text": "Rispondo a Luke.",
          "goto": "luke_contact",
          "conditions": {
            "path": "world.flags.friend_beat_07_friend_id",
            "eq": "Luke"
          }
        },
        {
          "id": "dispatch_mattew",
          "text": "Rispondo a Mattew.",
          "goto": "mattew_contact",
          "conditions": {
            "path": "world.flags.friend_beat_07_friend_id",
            "eq": "Mattew"
          }
        },
        {
          "id": "dispatch_daniel",
          "text": "Rispondo a Daniel.",
          "goto": "daniel_contact",
          "conditions": {
            "path": "world.flags.friend_beat_07_friend_id",
            "eq": "Daniel"
          }
        },
        {
          "id": "dispatch_edward",
          "text": "Rispondo a Edward.",
          "goto": "edward_contact",
          "conditions": {
            "path": "world.flags.friend_beat_07_friend_id",
            "eq": "Edward"
          }
        },
        {
          "id": "dispatch_fab",
          "text": "Rispondo a Fab.",
          "goto": "fab_contact",
          "conditions": {
            "path": "world.flags.friend_beat_07_friend_id",
            "eq": "Fab"
          }
        }
      ]
    },
    "luke_contact": {
      "stitches": [
        {
          "id": "s1",
          "text": "Luke compare sullo schermo con un sorriso di sfida. «Tutti a dirmi quali Pokémon dovrei cambiare. Figurati. Piuttosto trovo il modo di farli funzionare insieme. E quando attacco, voglio che se ne accorgano.»"
        }
      ],
      "choices": [
        {
          "id": "luke_physical",
          "text": "Parliamo di persona.",
          "goto": "physical_context",
          "conditions": {
            "path": "world.flags.friend_beat_07_contact_mode",
            "eq": "physical"
          },
          "effects": [
            {
              "type": "npc_relationship_adjust",
              "npcId": "Luke",
              "delta": 1
            }
          ]
        },
        {
          "id": "luke_remote",
          "text": "Parliamo a distanza.",
          "goto": "remote_context",
          "conditions": {
            "path": "world.flags.friend_beat_07_contact_mode",
            "eq": "remote"
          },
          "effects": [
            {
              "type": "npc_relationship_adjust",
              "npcId": "Luke",
              "delta": 1
            }
          ]
        }
      ]
    },
    "mattew_contact": {
      "stitches": [
        {
          "id": "s1",
          "text": "Mattew ha un quaderno aperto accanto a sé. «Ho rivisto l'ultimo incontro tre volte», dice. «Non per copiarlo. Voglio capire dove ho sbagliato.» Poi sorride: «Tu quante volte l'hai rivisto, una mezza?»"
        }
      ],
      "choices": [
        {
          "id": "mattew_physical",
          "text": "Parliamo di persona.",
          "goto": "physical_context",
          "conditions": {
            "path": "world.flags.friend_beat_07_contact_mode",
            "eq": "physical"
          },
          "effects": [
            {
              "type": "npc_relationship_adjust",
              "npcId": "Mattew",
              "delta": 1
            }
          ]
        },
        {
          "id": "mattew_remote",
          "text": "Parliamo a distanza.",
          "goto": "remote_context",
          "conditions": {
            "path": "world.flags.friend_beat_07_contact_mode",
            "eq": "remote"
          },
          "effects": [
            {
              "type": "npc_relationship_adjust",
              "npcId": "Mattew",
              "delta": 1
            }
          ]
        }
      ]
    },
    "daniel_contact": {
      "stitches": [
        {
          "id": "s1",
          "text": "Daniel risponde dopo aver finito di parlare con un addetto. «Prima di discutere il tabellone, voglio essere sicuro che tutti abbiano ricevuto le stesse informazioni», dice. Poi aggiunge: «Sì, lo so. Sono sempre quello divertente del gruppo.»"
        }
      ],
      "choices": [
        {
          "id": "daniel_physical",
          "text": "Parliamo di persona.",
          "goto": "physical_context",
          "conditions": {
            "path": "world.flags.friend_beat_07_contact_mode",
            "eq": "physical"
          },
          "effects": [
            {
              "type": "npc_relationship_adjust",
              "npcId": "Daniel",
              "delta": 1
            }
          ]
        },
        {
          "id": "daniel_remote",
          "text": "Parliamo a distanza.",
          "goto": "remote_context",
          "conditions": {
            "path": "world.flags.friend_beat_07_contact_mode",
            "eq": "remote"
          },
          "effects": [
            {
              "type": "npc_relationship_adjust",
              "npcId": "Daniel",
              "delta": 1
            }
          ]
        }
      ]
    },
    "edward_contact": {
      "stitches": [
        {
          "id": "s1",
          "text": "Edward si sistema il colletto davanti alla telecamera. «Se devo finire sui manifesti, almeno che scelgano una foto decente.» Ride, poi indica il suo Pokémon: «E in campo voglio far parlare lui.»"
        }
      ],
      "choices": [
        {
          "id": "edward_physical",
          "text": "Parliamo di persona.",
          "goto": "physical_context",
          "conditions": {
            "path": "world.flags.friend_beat_07_contact_mode",
            "eq": "physical"
          },
          "effects": [
            {
              "type": "npc_relationship_adjust",
              "npcId": "Edward",
              "delta": 1
            }
          ]
        },
        {
          "id": "edward_remote",
          "text": "Parliamo a distanza.",
          "goto": "remote_context",
          "conditions": {
            "path": "world.flags.friend_beat_07_contact_mode",
            "eq": "remote"
          },
          "effects": [
            {
              "type": "npc_relationship_adjust",
              "npcId": "Edward",
              "delta": 1
            }
          ]
        }
      ]
    },
    "fab_contact": {
      "stitches": [
        {
          "id": "s1",
          "text": "Fab risponde con un Pokémon accoccolato vicino. «Stavamo facendo una pausa», dice. «Non so come andrà il Qualifier, ma finché siamo qui ci proviamo. E tu non montarti la testa, eh.»"
        }
      ],
      "choices": [
        {
          "id": "fab_physical",
          "text": "Parliamo di persona.",
          "goto": "physical_context",
          "conditions": {
            "path": "world.flags.friend_beat_07_contact_mode",
            "eq": "physical"
          },
          "effects": [
            {
              "type": "npc_relationship_adjust",
              "npcId": "Fab",
              "delta": 1
            }
          ]
        },
        {
          "id": "fab_remote",
          "text": "Parliamo a distanza.",
          "goto": "remote_context",
          "conditions": {
            "path": "world.flags.friend_beat_07_contact_mode",
            "eq": "remote"
          },
          "effects": [
            {
              "type": "npc_relationship_adjust",
              "npcId": "Fab",
              "delta": 1
            }
          ]
        }
      ]
    },
    "physical_context": {
      "stitches": [
        {
          "id": "s1",
          "text": "Vi incontrate fra il viavai degli allenatori. Il tuo amico si ferma abbastanza vicino da poter parlare senza alzare la voce. Sul tabellone scorrono i prossimi appuntamenti."
        }
      ],
      "choices": [
        {
          "id": "physical_qualifier",
          "text": "Parliamo del Qualifier senza simulare un match.",
          "goto": "qualifier_talk",
          "effects": [
            {
              "type": "set_flag",
              "key": "friend_beat_07_type",
              "value": "physical"
            }
          ]
        },
        {
          "id": "physical_pressure",
          "text": "Parliamo della pressione di Meridiana.",
          "goto": "shared_pressure",
          "effects": [
            {
              "type": "set_flag",
              "key": "friend_beat_07_type",
              "value": "physical"
            }
          ]
        },
        {
          "id": "physical_state",
          "text": "Confrontiamo soltanto lo stato reale delle nostre carriere.",
          "goto": "uncertain_friend",
          "effects": [
            {
              "type": "set_flag",
              "key": "friend_beat_07_type",
              "value": "physical"
            }
          ]
        }
      ]
    },
    "remote_context": {
      "stitches": [
        {
          "id": "s1",
          "text": "Dall'altro capo della chiamata arrivano rumori diversi da quelli di Meridiana. Il tuo amico si sposta per sentirti meglio: oggi siete lontani, ma avete trovato qualche minuto per parlare."
        }
      ],
      "choices": [
        {
          "id": "remote_qualifier",
          "text": "Parliamo del Qualifier a distanza.",
          "goto": "qualifier_talk",
          "effects": [
            {
              "type": "set_flag",
              "key": "friend_beat_07_type",
              "value": "remote"
            }
          ]
        },
        {
          "id": "remote_pressure",
          "text": "Parliamo di cosa significa non condividere la stessa finestra.",
          "goto": "shared_pressure",
          "effects": [
            {
              "type": "set_flag",
              "key": "friend_beat_07_type",
              "value": "remote"
            }
          ]
        },
        {
          "id": "remote_state",
          "text": "Mi limito a chiedere come sta andando davvero.",
          "goto": "uncertain_friend",
          "effects": [
            {
              "type": "set_flag",
              "key": "friend_beat_07_type",
              "value": "remote"
            }
          ]
        }
      ]
    },
    "qualifier_talk": {
      "stitches": [
        {
          "id": "s1",
          "text": "«Nessuno di noi sa già come finirà», dice il tuo amico. Per un momento il tono si fa serio. Poi arriva la battuta inevitabile: «Però se fai una figuraccia, questa te la ricordo per anni.»"
        }
      ],
      "choices": [
        {
          "id": "qualifier_qualified",
          "text": "Ragioniamo sul caso in cui uno dei due sia già avanti.",
          "goto": "qualified_friend"
        },
        {
          "id": "qualifier_eliminated",
          "text": "Ragioniamo sul peso di una possibile eliminazione.",
          "goto": "eliminated_friend"
        }
      ]
    },
    "eliminated_friend": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il tuo amico resta in silenzio per qualche secondo. Non cerca una frase eroica per cancellare la sconfitta. «È andata così», dice infine. «Domani vedrò cosa fare.»"
        }
      ],
      "choices": [
        {
          "id": "elim_pressure",
          "text": "Parliamo di come gestire il giorno dopo.",
          "goto": "shared_pressure"
        },
        {
          "id": "elim_record",
          "text": "Chiudo il confronto rispettando il risultato reale.",
          "goto": "relationship"
        }
      ]
    },
    "qualified_friend": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il tuo amico guarda il programma dei prossimi incontri. «Essere passato non significa che sia finita», dice. «E non posso giocare la tua partita al posto tuo.»"
        }
      ],
      "choices": [
        {
          "id": "qualified_pressure",
          "text": "Parliamo di cosa cambia quando l'attenzione aumenta.",
          "goto": "shared_pressure"
        },
        {
          "id": "qualified_record",
          "text": "Chiudo il confronto senza trasferire vantaggi.",
          "goto": "relationship"
        }
      ]
    },
    "uncertain_friend": {
      "stitches": [
        {
          "id": "s1",
          "text": "«Non so ancora come andrà», ammette il tuo amico. Si sente qualcuno chiamarlo in lontananza. «Appena ho notizie vere, te lo dico.»"
        }
      ],
      "choices": [
        {
          "id": "uncertain_qualifier",
          "text": "Torniamo al tema del Qualifier.",
          "goto": "qualifier_talk"
        },
        {
          "id": "uncertain_pressure",
          "text": "Parliamo della pressione comune.",
          "goto": "shared_pressure"
        }
      ]
    },
    "shared_pressure": {
      "stitches": [
        {
          "id": "s1",
          "text": "Per qualche secondo smettete di scherzare. Basta guardare il calendario per capire quanto può pesare una sola giornata. Poi uno dei due rompe il silenzio con una battuta."
        }
      ],
      "choices": [
        {
          "id": "pressure_relationship",
          "text": "Rispondo sul piano personale.",
          "goto": "relationship"
        },
        {
          "id": "pressure_callback",
          "text": "Ricollego questo momento ai Friend Beat precedenti.",
          "goto": "callback"
        }
      ]
    },
    "relationship": {
      "stitches": [
        {
          "id": "s1",
          "text": "La conversazione prende una piega più personale. Il tuo amico ascolta, ribatte e non ti lascia passare una provocazione senza restituirla."
        }
      ],
      "choices": [
        {
          "id": "relationship_record",
          "text": "Registro il momento condiviso.",
          "goto": "result_record"
        },
        {
          "id": "relationship_more",
          "text": "Resto ancora sul tema della pressione.",
          "goto": "shared_pressure"
        }
      ]
    },
    "callback": {
      "stitches": [
        {
          "id": "s1",
          "text": "Una vecchia battuta del gruppo torna fuori nel momento meno opportuno. Ridete, ma sotto la presa in giro resta il ricordo delle strade diverse che avete percorso."
        }
      ],
      "choices": [
        {
          "id": "callback_contact",
          "text": "Torno al contatto corrente.",
          "goto": "dispatch"
        },
        {
          "id": "callback_record",
          "text": "Chiudo il callback e registro il beat.",
          "goto": "result_record"
        }
      ]
    },
    "wait_contact": {
      "stitches": [
        {
          "id": "s1",
          "text": "Passa un'ora. La città cambia ritmo e sul telefono arrivano nuove notifiche. Non tutti gli impegni degli altri possono aspettare una tua risposta."
        }
      ],
      "choices": [
        {
          "id": "wait_hour",
          "text": "Aspetto un'ora e ricontrollo.",
          "goto": "selector_status",
          "timeCostMinutes": 60
        },
        {
          "id": "wait_dispatch",
          "text": "Rispondo senza altra attesa.",
          "goto": "dispatch"
        }
      ]
    },
    "result_record": {
      "stitches": [
        {
          "id": "s1",
          "text": "La conversazione si chiude con un'ultima battuta. Sullo schermo resta il nome del tuo amico e, per un momento, il rumore del circuito sembra più lontano."
        }
      ],
      "choices": [
        {
          "id": "record_complete",
          "text": "Saluto il mio amico e chiudo la conversazione.",
          "goto": "friend_close",
          "effects": [
            {
              "type": "set_flag",
              "key": "friend_beat_07_complete",
              "value": true
            }
          ]
        }
      ]
    },
    "friend_close": {
      "stitches": [
        {
          "id": "s1",
          "text": "Riponi il telefono. Davanti a te, il Grand Hall continua ad accogliere allenatori per le iscrizioni al Qualifier."
        }
      ],
      "choices": [
        {
          "id": "close_registration",
          "text": "Raggiungo lo sportello delle iscrizioni.",
          "goto": "m07-qualifier-registration#registration_entry"
        }
      ]
    }
  }
}
