{
  "schemaVersion": 1,
  "id": "m07-friend-beat-07",
  "moduleId": "M07",
  "title": "M7_05 — Friend Beat 07",
  "locationId": "meridiana_city",
  "entryNodeId": "friend_entry",
  "conditions": {
    "all": [
      {
        "path": "world.flags.m6_complete",
        "eq": true
      },
      {
        "path": "world.flags.m07_unlocked",
        "eq": true
      },
      {
        "path": "world.flags.m7_active",
        "eq": true
      },
      {
        "path": "competition.rank",
        "eq": "S"
      },
      {
        "path": "world.flags.m7_pro_preparation_complete",
        "eq": true
      },
      {
        "path": "world.flags.friend_beat_07_available",
        "eq": true
      }
    ]
  },
  "nodes": {
    "friend_entry": {
      "stitches": [
        {
          "id": "s1",
          "text": "Prima della qualificazione un nome familiare compare sul telefono. In mezzo al rumore degli allenamenti e delle iscrizioni, uno degli amici ha trovato il modo di farsi vivo."
        }
      ],
      "choices": [
        {
          "id": "entry_status",
          "text": "Controllo chi è stato selezionato e perché.",
          "goto": "selector_status"
        },
        {
          "id": "entry_contact",
          "text": "Apro il contatto disponibile.",
          "goto": "dispatch"
        }
      ]
    },
    "selector_status": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il messaggio arriva da {{world.flags.friend_beat_07_friend_id}}. Potreste riuscire a incontrarvi oppure dovervi accontentare di una chiamata, secondo dove vi hanno portato le vostre giornate."
        }
      ],
      "choices": [
        {
          "id": "status_dispatch",
          "text": "Passo al contatto selezionato.",
          "goto": "dispatch"
        },
        {
          "id": "status_callback",
          "text": "Rivedo come i Friend Beat precedenti pesano sulla rotazione.",
          "goto": "callback"
        },
        {
          "id": "status_wait",
          "text": "Se il contatto è remoto, posso comunque scegliere quando rispondere.",
          "goto": "wait_contact"
        }
      ]
    },
    "dispatch": {
      "stitches": [
        {
          "id": "s1",
          "text": "Apri il contatto con {{world.flags.friend_beat_07_friend_id}}. La sua stagione è andata avanti anche quando non vi siete sentiti."
        }
      ],
      "choices": [
        {
          "id": "dispatch_luke",
          "text": "Rispondo a Luke.",
          "goto": "luke_contact",
          "conditions": {
            "path": "world.flags.friend_beat_07_friend_id",
            "eq": "Luke"
          }
        },
        {
          "id": "dispatch_mattew",
          "text": "Rispondo a Mattew.",
          "goto": "mattew_contact",
          "conditions": {
            "path": "world.flags.friend_beat_07_friend_id",
            "eq": "Mattew"
          }
        },
        {
          "id": "dispatch_daniel",
          "text": "Rispondo a Daniel.",
          "goto": "daniel_contact",
          "conditions": {
            "path": "world.flags.friend_beat_07_friend_id",
            "eq": "Daniel"
          }
        },
        {
          "id": "dispatch_edward",
          "text": "Rispondo a Edward.",
          "goto": "edward_contact",
          "conditions": {
            "path": "world.flags.friend_beat_07_friend_id",
            "eq": "Edward"
          }
        },
        {
          "id": "dispatch_fab",
          "text": "Rispondo a Fab.",
          "goto": "fab_contact",
          "conditions": {
            "path": "world.flags.friend_beat_07_friend_id",
            "eq": "Fab"
          }
        }
      ]
    },
    "luke_contact": {
      "stitches": [
        {
          "id": "s1",
          "text": "Luke sbuffa. «Sono tutti convinti che al Qualifier dovresti cambiare squadra appena qualcuno critica i tuoi preferiti. Io non li mollo. Piuttosto trovo il modo di farli picchiare più forte.» Poi aggiunge: «E tu? Ti sei già arreso ai consigli degli altri?»"
        }
      ],
      "choices": [
        {
          "id": "luke_physical",
          "text": "Parliamo di persona.",
          "goto": "physical_context",
          "conditions": {
            "path": "world.flags.friend_beat_07_contact_mode",
            "eq": "physical"
          },
          "effects": [
            {
              "type": "npc_relationship_adjust",
              "npcId": "Luke",
              "delta": 1
            }
          ]
        },
        {
          "id": "luke_remote",
          "text": "Parliamo a distanza.",
          "goto": "remote_context",
          "conditions": {
            "path": "world.flags.friend_beat_07_contact_mode",
            "eq": "remote"
          },
          "effects": [
            {
              "type": "npc_relationship_adjust",
              "npcId": "Luke",
              "delta": 1
            }
          ]
        }
      ]
    },
    "mattew_contact": {
      "stitches": [
        {
          "id": "s1",
          "text": "Mattew ha il programma di Eevee sotto gli occhi. «Non chiamarlo noioso: se ripeti una cosa abbastanza bene, smette di essere un miracolo.» Fa una pausa. «Comunque potresti provare, per una volta, a prepararti prima di vantarti.»"
        }
      ],
      "choices": [
        {
          "id": "mattew_physical",
          "text": "Parliamo di persona.",
          "goto": "physical_context",
          "conditions": {
            "path": "world.flags.friend_beat_07_contact_mode",
            "eq": "physical"
          },
          "effects": [
            {
              "type": "npc_relationship_adjust",
              "npcId": "Mattew",
              "delta": 1
            }
          ]
        },
        {
          "id": "mattew_remote",
          "text": "Parliamo a distanza.",
          "goto": "remote_context",
          "conditions": {
            "path": "world.flags.friend_beat_07_contact_mode",
            "eq": "remote"
          },
          "effects": [
            {
              "type": "npc_relationship_adjust",
              "npcId": "Mattew",
              "delta": 1
            }
          ]
        }
      ]
    },
    "daniel_contact": {
      "stitches": [
        {
          "id": "s1",
          "text": "Daniel parla dopo aver messo in ordine le sue carte. «Puoi desiderare la vittoria senza inventarti delle scuse quando perdi. Sono due cose diverse.» Poi lascia filtrare un sorriso: «Lo so, non è la tua frase preferita.»"
        }
      ],
      "choices": [
        {
          "id": "daniel_physical",
          "text": "Parliamo di persona.",
          "goto": "physical_context",
          "conditions": {
            "path": "world.flags.friend_beat_07_contact_mode",
            "eq": "physical"
          },
          "effects": [
            {
              "type": "npc_relationship_adjust",
              "npcId": "Daniel",
              "delta": 1
            }
          ]
        },
        {
          "id": "daniel_remote",
          "text": "Parliamo a distanza.",
          "goto": "remote_context",
          "conditions": {
            "path": "world.flags.friend_beat_07_contact_mode",
            "eq": "remote"
          },
          "effects": [
            {
              "type": "npc_relationship_adjust",
              "npcId": "Daniel",
              "delta": 1
            }
          ]
        }
      ]
    },
    "edward_contact": {
      "stitches": [
        {
          "id": "s1",
          "text": "Edward ride dal primo istante. «Scegli un Pokémon che ti piace e fagli fare qualcosa di memorabile. Se qualcuno storce il naso, ancora meglio.» Dietro di lui si sente un colpo sordo; «Sì, sì, stiamo bene!»"
        }
      ],
      "choices": [
        {
          "id": "edward_physical",
          "text": "Parliamo di persona.",
          "goto": "physical_context",
          "conditions": {
            "path": "world.flags.friend_beat_07_contact_mode",
            "eq": "physical"
          },
          "effects": [
            {
              "type": "npc_relationship_adjust",
              "npcId": "Edward",
              "delta": 1
            }
          ]
        },
        {
          "id": "edward_remote",
          "text": "Parliamo a distanza.",
          "goto": "remote_context",
          "conditions": {
            "path": "world.flags.friend_beat_07_contact_mode",
            "eq": "remote"
          },
          "effects": [
            {
              "type": "npc_relationship_adjust",
              "npcId": "Edward",
              "delta": 1
            }
          ]
        }
      ]
    },
    "fab_contact": {
      "stitches": [
        {
          "id": "s1",
          "text": "Fab sembra sorpreso che il telefono stia squillando. «Stavo dando da mangiare a Koffing. Lui è convinto che sia una sessione strategica.» Ride. «In bocca al lupo per il Qualifier. Poi mi racconti, soprattutto se succede qualcosa di ridicolo.»"
        }
      ],
      "choices": [
        {
          "id": "fab_physical",
          "text": "Parliamo di persona.",
          "goto": "physical_context",
          "conditions": {
            "path": "world.flags.friend_beat_07_contact_mode",
            "eq": "physical"
          },
          "effects": [
            {
              "type": "npc_relationship_adjust",
              "npcId": "Fab",
              "delta": 1
            }
          ]
        },
        {
          "id": "fab_remote",
          "text": "Parliamo a distanza.",
          "goto": "remote_context",
          "conditions": {
            "path": "world.flags.friend_beat_07_contact_mode",
            "eq": "remote"
          },
          "effects": [
            {
              "type": "npc_relationship_adjust",
              "npcId": "Fab",
              "delta": 1
            }
          ]
        }
      ]
    },
    "physical_context": {
      "stitches": [
        {
          "id": "s1",
          "text": "Vi ritrovate davvero nello stesso luogo, per pochi minuti sottratti agli impegni. La prima battuta arriva prima di ogni domanda seria."
        }
      ],
      "choices": [
        {
          "id": "physical_qualifier",
          "text": "Parliamo del Qualifier senza simulare un match.",
          "goto": "qualifier_talk",
          "effects": [
            {
              "type": "set_flag",
              "key": "friend_beat_07_type",
              "value": "physical"
            }
          ]
        },
        {
          "id": "physical_pressure",
          "text": "Parliamo della pressione di Meridiana.",
          "goto": "shared_pressure",
          "effects": [
            {
              "type": "set_flag",
              "key": "friend_beat_07_type",
              "value": "physical"
            }
          ]
        },
        {
          "id": "physical_state",
          "text": "Confrontiamo soltanto lo stato reale delle nostre carriere.",
          "goto": "uncertain_friend",
          "effects": [
            {
              "type": "set_flag",
              "key": "friend_beat_07_type",
              "value": "physical"
            }
          ]
        }
      ]
    },
    "remote_context": {
      "stitches": [
        {
          "id": "s1",
          "text": "La voce arriva da un'altra città, con rumori che non riconosci. La distanza non impedisce agli amici di punzecchiarsi."
        }
      ],
      "choices": [
        {
          "id": "remote_qualifier",
          "text": "Parliamo del Qualifier a distanza.",
          "goto": "qualifier_talk",
          "effects": [
            {
              "type": "set_flag",
              "key": "friend_beat_07_type",
              "value": "remote"
            }
          ]
        },
        {
          "id": "remote_pressure",
          "text": "Parliamo di cosa significa non condividere la stessa finestra.",
          "goto": "shared_pressure",
          "effects": [
            {
              "type": "set_flag",
              "key": "friend_beat_07_type",
              "value": "remote"
            }
          ]
        },
        {
          "id": "remote_state",
          "text": "Mi limito a chiedere come sta andando davvero.",
          "goto": "uncertain_friend",
          "effects": [
            {
              "type": "set_flag",
              "key": "friend_beat_07_type",
              "value": "remote"
            }
          ]
        }
      ]
    },
    "qualifier_talk": {
      "stitches": [
        {
          "id": "s1",
          "text": "Fra scherzi e qualche consiglio vero, tornate alla qualificazione. Nessuno sa come finirà; qualcuno ha già concluso la propria prova, qualcun altro aspetta ancora."
        }
      ],
      "choices": [
        {
          "id": "qualifier_qualified",
          "text": "Ragioniamo sul caso in cui uno dei due sia già avanti.",
          "goto": "qualified_friend"
        },
        {
          "id": "qualifier_eliminated",
          "text": "Ragioniamo sul peso di una possibile eliminazione.",
          "goto": "eliminated_friend"
        }
      ]
    },
    "eliminated_friend": {
      "stitches": [
        {
          "id": "s1",
          "text": "Se l'amico è stato eliminato, la conversazione lascia spazio anche a quella delusione. Non sei obbligato a trasformarla in una lezione edificante."
        }
      ],
      "choices": [
        {
          "id": "elim_pressure",
          "text": "Parliamo di come gestire il giorno dopo.",
          "goto": "shared_pressure"
        },
        {
          "id": "elim_record",
          "text": "Chiudo il confronto rispettando il risultato reale.",
          "goto": "relationship"
        }
      ]
    },
    "qualified_friend": {
      "stitches": [
        {
          "id": "s1",
          "text": "Se l'amico si è qualificato, può permettersi una provocazione in più, ma non offrirti la propria posizione sul tabellone."
        }
      ],
      "choices": [
        {
          "id": "qualified_pressure",
          "text": "Parliamo di cosa cambia quando l'attenzione aumenta.",
          "goto": "shared_pressure"
        },
        {
          "id": "qualified_record",
          "text": "Chiudo il confronto senza trasferire vantaggi.",
          "goto": "relationship"
        }
      ]
    },
    "uncertain_friend": {
      "stitches": [
        {
          "id": "s1",
          "text": "Quando l'amico non conosce ancora il proprio esito, parla di ciò che può preparare davvero. Il futuro non entra nella conversazione come se fosse già accaduto."
        }
      ],
      "choices": [
        {
          "id": "uncertain_qualifier",
          "text": "Torniamo al tema del Qualifier.",
          "goto": "qualifier_talk"
        },
        {
          "id": "uncertain_pressure",
          "text": "Parliamo della pressione comune.",
          "goto": "shared_pressure"
        }
      ]
    },
    "shared_pressure": {
      "stitches": [
        {
          "id": "s1",
          "text": "Per un momento le battute si fermano. Una sola giornata può decidere mesi di preparazione; poi uno dei due trova il modo di rovinare la solennità con un'altra provocazione."
        }
      ],
      "choices": [
        {
          "id": "pressure_relationship",
          "text": "Rispondo sul piano personale.",
          "goto": "relationship"
        },
        {
          "id": "pressure_callback",
          "text": "Ricollego questo momento ai Friend Beat precedenti.",
          "goto": "callback"
        }
      ]
    },
    "relationship": {
      "stitches": [
        {
          "id": "s1",
          "text": "Quanto vi fidate l'uno dell'altro si sente dal modo in cui una battuta viene accolta. Non tutte le vecchie discussioni sono finite."
        }
      ],
      "choices": [
        {
          "id": "relationship_record",
          "text": "Registro il momento condiviso.",
          "goto": "result_record"
        },
        {
          "id": "relationship_more",
          "text": "Resto ancora sul tema della pressione.",
          "goto": "shared_pressure"
        }
      ]
    },
    "callback": {
      "stitches": [
        {
          "id": "s1",
          "text": "Una frase richiama uno degli incontri passati. Non tutti i ricordi sono gentili, ma sono vostri e non possono essere assegnati a un'altra persona."
        }
      ],
      "choices": [
        {
          "id": "callback_contact",
          "text": "Torno al contatto corrente.",
          "goto": "dispatch"
        },
        {
          "id": "callback_record",
          "text": "Chiudo il callback e registro il beat.",
          "goto": "result_record"
        }
      ]
    },
    "wait_contact": {
      "stitches": [
        {
          "id": "s1",
          "text": "Se aspetti, gli orari continuano a cambiare e l'amico può allontanarsi. Il tempo non si ferma per una chiamata."
        }
      ],
      "choices": [
        {
          "id": "wait_hour",
          "text": "Aspetto un'ora e ricontrollo.",
          "goto": "selector_status",
          "timeCostMinutes": 60
        },
        {
          "id": "wait_dispatch",
          "text": "Rispondo senza altra attesa.",
          "goto": "dispatch"
        }
      ]
    },
    "result_record": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il telefono si spegne lasciandoti con una conversazione reale, non con un nuovo piazzamento ottenuto sul tabellone."
        }
      ],
      "choices": [
        {
          "id": "record_complete",
          "text": "Segno FRIEND_BEAT_07 come completato.",
          "goto": "friend_close",
          "effects": [
            {
              "type": "set_flag",
              "key": "friend_beat_07_complete",
              "value": true
            }
          ]
        }
      ]
    },
    "friend_close": {
      "stitches": [
        {
          "id": "s1",
          "text": "Le iscrizioni al Qualifier ti aspettano. L'amico torna alla propria strada, e la prossima prova rimane da affrontare."
        }
      ],
      "choices": [
        {
          "id": "close_registration",
          "text": "Passo alla registrazione del World Qualifier.",
          "goto": "m07-qualifier-registration#registration_entry"
        }
      ]
    }
  }
}
