{
  "schemaVersion": 1,
  "id": "m10-module-outcome",
  "moduleId": "M10",
  "title": "M10_09 — Module Outcome",
  "locationId": "world_knockout_hall",
  "entryNodeId": "outcome_entry",
  "conditions": {
    "all": [
      {
        "path": "world.flags.m10_friend_beat_10_complete",
        "eq": true
      },
      {
        "any": [
          {
            "all": [
              {
                "path": "world.flags.world_eliminated",
                "eq": true
              },
              {
                "path": "world.flags.world_qf_resolved",
                "ne": true
              }
            ]
          },
          {
            "all": [
              {
                "path": "world.flags.m10_qf_aftermath_complete",
                "eq": true
              },
              {
                "any": [
                  {
                    "path": "world.flags.world_qf_won",
                    "eq": true
                  },
                  {
                    "path": "world.flags.world_eliminated",
                    "eq": true
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  },
  "nodes": {
    "outcome_entry": {
      "stitches": [
        {
          "id": "s1",
          "text": "Davanti al tabellone conclusivo degli ottavi e dei quarti puoi finalmente vedere dove si è fermata, oppure prosegue, la tua corsa."
        }
      ],
      "choices": [
        {
          "id": "entry_audit",
          "text": "Audito lo stato competitivo.",
          "goto": "state_audit"
        },
        {
          "id": "entry_history",
          "text": "Controllo la history ufficiale.",
          "goto": "history"
        },
        {
          "id": "entry_friend",
          "text": "Controllo che FRIEND_BEAT_10 sia persistente.",
          "goto": "friend_closure"
        }
      ]
    },
    "state_audit": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il personale confronta il tuo ultimo referto con l'elenco dei quattro semifinalisti. Il tuo posto dipende soltanto dall'incontro che hai giocato."
        }
      ],
      "choices": [
        {
          "id": "audit_elim",
          "text": "Leggo il contratto di eliminazione.",
          "goto": "eliminated_state",
          "conditions": {
            "path": "world.flags.world_eliminated",
            "eq": true
          }
        },
        {
          "id": "audit_top4",
          "text": "Leggo il contratto Final Four.",
          "goto": "top4_state",
          "conditions": {
            "path": "world.flags.world_qf_won",
            "eq": true
          }
        }
      ]
    },
    "eliminated_state": {
      "stitches": [
        {
          "id": "s1",
          "text": "Se sei stato eliminato, il Mondiale continuerà senza di te. Puoi tornare ad Asteria con la carriera e i risultati realmente ottenuti."
        }
      ],
      "choices": [
        {
          "id": "elim_contract",
          "text": "Controllo l'handoff M12.",
          "goto": "m12_contract"
        },
        {
          "id": "elim_resource",
          "text": "Verifico che la squadra non venga resettata.",
          "goto": "resource"
        }
      ]
    },
    "top4_state": {
      "stitches": [
        {
          "id": "s1",
          "text": "Se hai vinto i quarti, il tuo nome deve comparire fra i quattro. Soltanto allora puoi raggiungere le semifinali."
        }
      ],
      "choices": [
        {
          "id": "top4_contract",
          "text": "Controllo l'handoff M11.",
          "goto": "m11_contract"
        },
        {
          "id": "top4_resource",
          "text": "Verifico la persistenza del team.",
          "goto": "resource"
        }
      ]
    },
    "history": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il registro contiene gironi, ottavi e, se lo hai giocato, il quarto di finale. Nessuna partita è stata cancellata."
        }
      ],
      "choices": [
        {
          "id": "history_audit",
          "text": "Torno al classificatore.",
          "goto": "state_audit"
        },
        {
          "id": "history_friend",
          "text": "Controllo il Friend Beat.",
          "goto": "friend_closure"
        }
      ]
    },
    "friend_closure": {
      "stitches": [
        {
          "id": "s1",
          "text": "Riguardi gli ultimi messaggi degli amici. Un saluto o una rivalità non può cambiare il risultato di un incontro ufficiale."
        }
      ],
      "choices": [
        {
          "id": "friend_history",
          "text": "Torno alla history.",
          "goto": "history"
        },
        {
          "id": "friend_resource",
          "text": "Controllo lo conseguenze delle scelte.",
          "goto": "resource"
        }
      ]
    },
    "resource": {
      "stitches": [
        {
          "id": "s1",
          "text": "Controlli Pokémon, oggetti e provviste. Le ultime gare hanno lasciato conseguenze che porterai con te."
        }
      ],
      "choices": [
        {
          "id": "resource_m11",
          "text": "Valuto il contratto Final Four.",
          "goto": "m11_contract"
        },
        {
          "id": "resource_m12",
          "text": "Valuto il contratto World Exit.",
          "goto": "m12_contract"
        }
      ]
    },
    "m11_contract": {
      "stitches": [
        {
          "id": "s1",
          "text": "Per entrare fra i semifinalisti devi avere un quarto vinto e un posto nel programma del Final Four."
        }
      ],
      "choices": [
        {
          "id": "m11_commit",
          "text": "Passo al passaggio conclusivo.",
          "goto": "commit_guard",
          "conditions": {
            "all": [
              {
                "path": "world.flags.world_qf_won",
                "eq": true
              },
              {
                "path": "competition.world.top4Locked",
                "eq": true
              },
              {
                "path": "competition.world.knockout.playerAdvancedToSf",
                "eq": true
              }
            ]
          }
        },
        {
          "id": "m11_review",
          "text": "Rileggo il Top4.",
          "goto": "top4_state"
        }
      ]
    },
    "m12_contract": {
      "stitches": [
        {
          "id": "s1",
          "text": "Se hai perso agli ottavi o ai quarti, il banco partenze ti indica il viaggio di rientro. Non sei più iscritto alle partite successive."
        }
      ],
      "choices": [
        {
          "id": "m12_commit",
          "text": "Passo al passaggio conclusivo.",
          "goto": "commit_guard",
          "conditions": {
            "path": "world.flags.world_eliminated",
            "eq": true
          }
        },
        {
          "id": "m12_review",
          "text": "Rileggo l'eliminazione.",
          "goto": "eliminated_state"
        }
      ]
    },
    "commit_guard": {
      "stitches": [
        {
          "id": "s1",
          "text": "La segretaria può indicarti soltanto uno dei due percorsi: semifinali oppure ritorno. Il referto non ammette una terza versione."
        }
      ],
      "choices": [
        {
          "id": "commit_m11",
          "text": "Chiudo M10 e sblocco M11.",
          "goto": "committed",
          "conditions": {
            "all": [
              {
                "path": "world.flags.m10_qf_aftermath_complete",
                "eq": true
              },
              {
                "path": "world.flags.world_qf_won",
                "eq": true
              },
              {
                "path": "competition.world.top4Locked",
                "eq": true
              },
              {
                "path": "competition.world.knockout.playerAdvancedToSf",
                "eq": true
              }
            ]
          },
          "effects": [
            {
              "type": "set_flag",
              "key": "m10_complete",
              "value": true
            },
            {
              "type": "set_flag",
              "key": "m10_module_outcome_complete",
              "value": true
            },
            {
              "type": "set_flag",
              "key": "m10_outcome_route",
              "value": "final_four"
            },
            {
              "type": "set_flag",
              "key": "m11_unlocked",
              "value": true
            }
          ]
        },
        {
          "id": "commit_m12",
          "text": "Concludo questa tappa e preparo il ritorno.",
          "goto": "committed",
          "conditions": {
            "path": "world.flags.world_eliminated",
            "eq": true
          },
          "effects": [
            {
              "type": "set_flag",
              "key": "m10_complete",
              "value": true
            },
            {
              "type": "set_flag",
              "key": "m10_module_outcome_complete",
              "value": true
            },
            {
              "type": "set_flag",
              "key": "m10_outcome_route",
              "value": "world_exit"
            },
            {
              "type": "set_flag",
              "key": "m12_unlocked",
              "value": true
            }
          ]
        },
        {
          "id": "commit_review",
          "text": "Prima rivedo l'audit.",
          "goto": "state_audit"
        }
      ]
    },
    "committed": {
      "stitches": [
        {
          "id": "s1",
          "text": "L'addetta consegna le indicazioni per la prossima tappa. Il risultato è stato già deciso sul campo."
        }
      ],
      "choices": [
        {
          "id": "committed_complete",
          "text": "Registro la chiusura leggibile.",
          "goto": "complete"
        },
        {
          "id": "committed_m12",
          "text": "Riprendo il viaggio di ritorno.",
          "goto": "m12-world-exit-branch#world_exit_entry",
          "conditions": {
            "path": "world.flags.m12_unlocked",
            "eq": true
          }
        },
        {
          "id": "committed_m11",
          "text": "Entro nel Final Four già sbloccato.",
          "goto": "m11-final-four-lock#final_four_entry",
          "conditions": {
            "path": "world.flags.m11_unlocked",
            "eq": true
          }
        },
        {
          "id": "committed_history",
          "text": "Rivedo ancora la history persistente.",
          "goto": "history"
        }
      ]
    },
    "complete": {
      "stitches": [
        {
          "id": "s1",
          "text": "La fase a eliminazione diretta si è conclusa per te oppure ti ha portato fra gli ultimi quattro. In entrambi i casi conservi ciò che hai vissuto."
        }
      ],
      "choices": [
        {
          "id": "complete_state",
          "text": "Rileggo lo stato finale.",
          "goto": "state_audit"
        },
        {
          "id": "complete_m11",
          "text": "Entro nel Final Four.",
          "goto": "m11-final-four-lock#final_four_entry",
          "conditions": {
            "path": "world.flags.m11_unlocked",
            "eq": true
          }
        },
        {
          "id": "complete_friend",
          "text": "Rileggo il Friend Beat persistente.",
          "goto": "friend_closure"
        }
      ]
    }
  }
}
