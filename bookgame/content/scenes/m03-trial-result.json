{
  "schemaVersion": 1,
  "id": "m03-trial-result",
  "moduleId": "M03",
  "title": "M3_14 — Trial Result",
  "locationId": "fer_city_arena",
  "entryNodeId": "trial_win",
  "conditions": {
    "all": [
      {
        "path": "world.flags.m2_complete",
        "eq": true
      },
      {
        "path": "world.flags.m03_unlocked",
        "eq": true
      },
      {
        "path": "world.flags.m3_active",
        "eq": true
      }
    ]
  },
  "nodes": {
    "trial_win": {
      "stitches": [
        {
          "id": "win_1",
          "text": "Il tabellone registra la vittoria e la tua tessera passa al Rank C. Le nuove autorizzazioni sono valide, ma Ferravia non smette di esistere soltanto perché hai superato l'esame."
        }
      ],
      "choices": [
        {
          "id": "close_m3",
          "text": "Ritiro la tessera Rank C e preparo la partenza.",
          "conditions": {
            "all": [
              {
                "path": "competition.rank",
                "eq": "C"
              },
              {
                "path": "world.flags.steven_met",
                "eq": true
              },
              {
                "path": "world.flags.friend_beat_03_complete",
                "eq": true
              },
              {
                "path": "world.flags.ferrox_rescue_state",
                "exists": true
              },
              {
                "path": "world.flags.ferrox_rescue_outcome_complete",
                "eq": true
              },
              {
                "any": [
                  {
                    "path": "world.flags.regional_cup_registered",
                    "ne": true
                  },
                  {
                    "path": "world.flags.regional_cup_result",
                    "exists": true
                  }
                ]
              }
            ]
          },
          "goto": "m3_exit_confirmed",
          "effects": [
            {
              "type": "set_flag",
              "key": "m3_complete",
              "value": true
            },
            {
              "type": "set_flag",
              "key": "m04_unlocked",
              "value": true
            },
            {
              "type": "trainer_milestone_level",
              "milestoneId": "M03_COMPLETE",
              "level": 9
            }
          ]
        },
        {
          "id": "review_pending",
          "text": "Prima di partire, controllo cosa ho ancora lasciato in sospeso.",
          "conditions": {
            "all": [
              {
                "path": "competition.rank",
                "eq": "C"
              },
              {
                "not": {
                  "all": [
                    {
                      "path": "world.flags.steven_met",
                      "eq": true
                    },
                    {
                      "path": "world.flags.friend_beat_03_complete",
                      "eq": true
                    },
                    {
                      "path": "world.flags.ferrox_rescue_state",
                      "exists": true
                    },
                    {
                      "path": "world.flags.ferrox_rescue_outcome_complete",
                      "eq": true
                    },
                    {
                      "any": [
                        {
                          "path": "world.flags.regional_cup_registered",
                          "ne": true
                        },
                        {
                          "path": "world.flags.regional_cup_result",
                          "exists": true
                        }
                      ]
                    }
                  ]
                }
              }
            ]
          },
          "goto": "pending_items"
        },
        {
          "id": "review_win_debrief",
          "text": "Prima di chiudere, rileggo cosa cambia davvero con Rank C.",
          "goto": "win_debrief"
        }
      ]
    },
    "pending_items": {
      "stitches": [
        {
          "id": "pending_1",
          "text": "La promozione è valida, ma alcune questioni a Ferravia richiedono ancora la tua presenza prima della partenza."
        }
      ],
      "choices": [
        {
          "id": "pending_steven",
          "text": "Devo ancora incontrare Steven.",
          "conditions": {
            "path": "world.flags.steven_met",
            "ne": true
          },
          "goto": "m03-ferravia-arrival#city_hub",
          "effects": [
            {
              "type": "set_location",
              "locationId": "fer_city"
            }
          ]
        },
        {
          "id": "pending_friend",
          "text": "Prima di partire, cerco il mio amico.",
          "conditions": {
            "path": "world.flags.friend_beat_03_complete",
            "ne": true
          },
          "goto": "m03-ferravia-arrival#city_hub",
          "effects": [
            {
              "type": "set_location",
              "locationId": "fer_city"
            }
          ]
        },
        {
          "id": "pending_rescue",
          "text": "Controllo il rapporto conclusivo sull'emergenza Ferrox.",
          "conditions": {
            "path": "world.flags.ferrox_rescue_state",
            "exists": false
          },
          "goto": "m03-ferravia-arrival#city_hub",
          "effects": [
            {
              "type": "set_location",
              "locationId": "fer_city"
            }
          ]
        },
        {
          "id": "pending_outcome",
          "text": "Devo ancora chiudere il bilancio Ferrox.",
          "conditions": {
            "path": "world.flags.ferrox_rescue_outcome_complete",
            "ne": true
          },
          "goto": "m03-rescue-outcome#outcome_board",
          "effects": [
            {
              "type": "set_location",
              "locationId": "fer_city"
            }
          ]
        },
        {
          "id": "pending_cup",
          "text": "Mi sono iscritto alla Regional Cup ma non ho ancora un risultato.",
          "conditions": {
            "all": [
              {
                "path": "world.flags.regional_cup_registered",
                "eq": true
              },
              {
                "path": "world.flags.regional_cup_result",
                "exists": false
              }
            ]
          },
          "goto": "m03-regional-cup#cup_board",
          "effects": [
            {
              "type": "set_location",
              "locationId": "fer_city_arena"
            }
          ]
        },
        {
          "id": "pending_hub",
          "text": "Torno a Ferravia.",
          "goto": "m03-ferravia-arrival#city_hub",
          "effects": [
            {
              "type": "set_location",
              "locationId": "fer_city"
            }
          ]
        },
        {
          "id": "pending_review_steven",
          "text": "Ripenso all'ultimo incontro con Steven prima di partire.",
          "conditions": {
            "path": "world.flags.steven_met",
            "eq": true
          },
          "goto": "steven_callback"
        },
        {
          "id": "pending_review_friend",
          "text": "Rileggo la continuità con il Friend Beat 03.",
          "conditions": {
            "path": "world.flags.friend_beat_03_complete",
            "eq": true
          },
          "goto": "friend_callback"
        },
        {
          "id": "pending_review_ferrox",
          "text": "Rileggo il bilancio Ferrox che porterò avanti.",
          "conditions": {
            "path": "world.flags.ferrox_rescue_outcome_complete",
            "eq": true
          },
          "goto": "ferrox_callback"
        },
        {
          "id": "pending_review_cup",
          "text": "Rileggo il risultato della Regional Cup.",
          "conditions": {
            "path": "world.flags.regional_cup_result",
            "exists": true
          },
          "goto": "cup_callback"
        }
      ]
    },
    "m3_exit_confirmed": {
      "stitches": [
        {
          "id": "exit_1",
          "text": "Con il Rank C sulla tessera puoi lasciare Ferravia. La squadra, il denaro, i rapporti costruiti, il bilancio di Ferrox e l'eventuale risultato della Coppa restano parte del tuo viaggio."
        },
        {
          "id": "exit_2",
          "text": "Sul pannello delle partenze compare una nuova direttrice autorizzata dal Rank C. Il percorso prosegue oltre la regione industriale."
        }
      ],
      "choices": [
        {
          "id": "stay_ferravia",
          "text": "Resto a Ferravia prima di proseguire.",
          "goto": "m03-ferravia-arrival#city_hub",
          "effects": [
            {
              "type": "set_location",
              "locationId": "fer_city"
            }
          ]
        },
        {
          "id": "review_module_continuity",
          "text": "Prima di partire, controllo un'ultima volta ciò che lascio a Ferravia.",
          "conditions": {
            "path": "world.flags.m3_continuity_reviewed",
            "ne": true
          },
          "goto": "module_continuity"
        },
        {
          "id": "go_to_m04",
          "text": "Proseguo verso la nuova fascia Rank C.",
          "conditions": {
            "all": [
              {
                "path": "world.flags.m3_complete",
                "eq": true
              },
              {
                "path": "world.flags.m04_unlocked",
                "eq": true
              },
              {
                "path": "competition.rank",
                "eq": "C"
              }
            ]
          },
          "goto": "m04-handoff#m04_entry"
        }
      ]
    },
    "trial_loss": {
      "stitches": [
        {
          "id": "loss_1",
          "text": "Il tabellone assegna la vittoria all'esaminatore. Il tuo Rank resta D; al banco ti confermano che potrai registrarti di nuovo per un altro tentativo."
        }
      ],
      "choices": [
        {
          "id": "retry",
          "text": "Torno al banco per preparare un nuovo tentativo.",
          "conditions": {
            "all": [
              {
                "path": "competition.rank",
                "eq": "D"
              },
              {
                "path": "competition.trials.RANK_D_TO_C.available",
                "eq": true
              },
              {
                "path": "competition.trials.RANK_D_TO_C.registered",
                "ne": true
              }
            ]
          },
          "goto": "m03-trial-registration#trial_desk"
        },
        {
          "id": "rest_hub",
          "text": "Torno a Ferravia e preparo meglio la squadra.",
          "goto": "m03-ferravia-arrival#city_hub",
          "effects": [
            {
              "type": "set_location",
              "locationId": "fer_city"
            }
          ]
        },
        {
          "id": "review_attempt",
          "text": "Controllo il risultato dell'ultimo tentativo.",
          "goto": "loss_review"
        },
        {
          "id": "analyze_retry",
          "text": "Analizzo il tentativo prima di registrarmi di nuovo.",
          "goto": "retry_analysis"
        }
      ]
    },
    "loss_review": {
      "stitches": [
        {
          "id": "loss_review_1",
          "text": "Sul registro dell'Arena compare la sconfitta contro l'esaminatrice. Il risultato resta lì insieme alla data dell'incontro; puoi usarlo per prepararti diversamente quando deciderai di ripresentarti."
        }
      ],
      "choices": [
        {
          "id": "review_retry",
          "text": "Torno alla registrazione.",
          "goto": "m03-trial-registration#trial_desk"
        },
        {
          "id": "review_hub",
          "text": "Torno al centro di Ferravia.",
          "goto": "m03-ferravia-arrival#city_hub",
          "effects": [
            {
              "type": "set_location",
              "locationId": "fer_city"
            }
          ]
        },
        {
          "id": "review_retry_readiness",
          "text": "Controllo cosa richiede davvero un nuovo tentativo.",
          "goto": "retry_readiness"
        }
      ]
    },
    "win_debrief": {
      "stitches": [
        {
          "id": "win_debrief_1",
          "text": "La vittoria apre le destinazioni del Rank C. Dietro di te restano Ferravia, Ferrox, Steven, i tuoi amici e l'eventuale Coppa, ciascuno con le conseguenze che hai lasciato."
        }
      ],
      "choices": [
        {
          "id": "win_rank_access",
          "text": "Controllo cosa significa davvero Rank C.",
          "goto": "rank_c_access"
        },
        {
          "id": "win_history",
          "text": "Controllo come l'Arena ha registrato il Trial.",
          "goto": "trial_history"
        },
        {
          "id": "win_back",
          "text": "Torno al banco delle partenze.",
          "goto": "trial_win"
        }
      ]
    },
    "rank_c_access": {
      "stitches": [
        {
          "id": "rank_access_1",
          "text": "Sul pannello delle partenze, la tessera Rank C rende disponibili collegamenti che prima risultavano riservati. Le questioni lasciate aperte a Ferravia, però, restano dove le hai lasciate."
        }
      ],
      "choices": [
        {
          "id": "rank_access_back",
          "text": "Torno al banco delle partenze.",
          "goto": "trial_win",
          "effects": [
            {
              "type": "set_flag",
              "key": "rank_c_access_reviewed",
              "value": true
            }
          ]
        },
        {
          "id": "rank_access_pending",
          "text": "Controllo prima se ho ancora questioni aperte a Ferravia.",
          "goto": "pending_items"
        }
      ]
    },
    "trial_history": {
      "stitches": [
        {
          "id": "trial_history_1",
          "text": "Nel registro ufficiale trovi data, formato dell'incontro, esaminatrice e risultato. È la stessa voce che l'Arena conserverà quando controllerà i tuoi precedenti."
        }
      ],
      "choices": [
        {
          "id": "history_back_win",
          "text": "Torno al banco delle partenze.",
          "conditions": {
            "path": "competition.rank",
            "eq": "C"
          },
          "goto": "trial_win",
          "effects": [
            {
              "type": "set_flag",
              "key": "trial_d_c_history_reviewed",
              "value": true
            }
          ]
        },
        {
          "id": "history_back_loss",
          "text": "Torno all'analisi della sconfitta.",
          "conditions": {
            "path": "competition.rank",
            "eq": "D"
          },
          "goto": "loss_review",
          "effects": [
            {
              "type": "set_flag",
              "key": "trial_d_c_history_reviewed",
              "value": true
            }
          ]
        }
      ]
    },
    "steven_callback": {
      "stitches": [
        {
          "id": "steven_callback_1",
          "text": "Se incroci Steven prima di partire, nota la nuova lettera sulla tessera. «C, allora.» Il suo sguardo torna quasi subito verso il lato industriale. «Immagino che adesso avrai altre strade da scegliere. Le rocce, purtroppo, continueranno a essere qui quando torni.»"
        }
      ],
      "choices": [
        {
          "id": "steven_callback_note",
          "text": "Chiudo il confronto con Steven.",
          "goto": "pending_items",
          "effects": [
            {
              "type": "npc_state_set",
              "npcId": "Steven",
              "key": "rankCCallbackSeen",
              "value": true
            }
          ]
        }
      ]
    },
    "friend_callback": {
      "stitches": [
        {
          "id": "friend_callback_1",
          "text": "Il tuo amico ha ancora la propria strada, qualunque sia stato il risultato del Trial. Il contatto precedente non diventa più o meno vero perché sulla tua tessera ora compare una C."
        }
      ],
      "choices": [
        {
          "id": "friend_callback_note",
          "text": "Chiudo il contatto e torno alle ultime cose da sistemare.",
          "goto": "pending_items",
          "effects": [
            {
              "type": "set_flag",
              "key": "m3_friend_continuity_reviewed",
              "value": true
            }
          ]
        }
      ]
    },
    "ferrox_callback": {
      "stitches": [
        {
          "id": "ferrox_callback_1",
          "text": "Il bilancio Ferrox non scompare dopo la vittoria al Trial. Danni, responsabilità e riconoscimento locale restano quelli riportati nel rapporto conclusivo."
        }
      ],
      "choices": [
        {
          "id": "ferrox_callback_note",
          "text": "Mantengo il bilancio Ferrox nel passaggio a Rank C.",
          "goto": "pending_items",
          "effects": [
            {
              "type": "set_flag",
              "key": "m3_ferrox_continuity_reviewed",
              "value": true
            }
          ]
        }
      ]
    },
    "cup_callback": {
      "stitches": [
        {
          "id": "cup_callback_1",
          "text": "Il tabellone della Regional Cup conserva il proprio risultato e quello del Trial compare nel registro accanto. Sono due competizioni diverse, con due esiti separati."
        }
      ],
      "choices": [
        {
          "id": "cup_callback_note",
          "text": "Tengo distinti i risultati della Coppa e del Trial.",
          "goto": "pending_items",
          "effects": [
            {
              "type": "set_flag",
              "key": "m3_cup_continuity_reviewed",
              "value": true
            }
          ]
        }
      ]
    },
    "retry_analysis": {
      "stitches": [
        {
          "id": "retry_analysis_1",
          "text": "La sconfitta riguarda questo tentativo. Puoi rivedere come avevi preparato l'incontro, controllare la squadra e decidere se ripresentarti."
        }
      ],
      "choices": [
        {
          "id": "retry_history",
          "text": "Controllo il risultato ufficiale dell'incontro.",
          "goto": "trial_history"
        },
        {
          "id": "retry_registration",
          "text": "Torno direttamente alla registrazione.",
          "goto": "m03-trial-registration#trial_desk"
        },
        {
          "id": "retry_hub",
          "text": "Torno a Ferravia e mi preparo prima di riprovare.",
          "goto": "m03-ferravia-arrival#city_hub",
          "effects": [
            {
              "type": "set_location",
              "locationId": "fer_city"
            }
          ]
        }
      ]
    },
    "retry_readiness": {
      "stitches": [
        {
          "id": "retry_ready_1",
          "text": "Per affrontare di nuovo l'esaminatrice devi tornare al banco e presentare una nuova richiesta. Il risultato di oggi resta nel registro dell'Arena."
        }
      ],
      "choices": [
        {
          "id": "retry_ready_desk",
          "text": "Torno al banco per registrarmi di nuovo.",
          "goto": "m03-trial-registration#trial_desk"
        },
        {
          "id": "retry_ready_analysis",
          "text": "Analizzo ancora il tentativo.",
          "goto": "retry_analysis"
        }
      ]
    },
    "module_continuity": {
      "stitches": [
        {
          "id": "continuity_1",
          "text": "Prima di partire puoi ricontrollare quattro aspetti distinti del tuo passaggio a Ferravia: il Rank raggiunto, il bilancio Ferrox, i rapporti costruiti e l'eventuale risultato della Coppa."
        }
      ],
      "choices": [
        {
          "id": "continuity_exit",
          "text": "Ho finito qui: torno al punto di partenza.",
          "goto": "m3_exit_confirmed",
          "effects": [
            {
              "type": "set_flag",
              "key": "m3_continuity_reviewed",
              "value": true
            }
          ]
        },
        {
          "id": "continuity_hub",
          "text": "Resto ancora a Ferravia.",
          "goto": "m03-ferravia-arrival#city_hub",
          "effects": [
            {
              "type": "set_location",
              "locationId": "fer_city"
            }
          ]
        }
      ]
    }
  }
}
