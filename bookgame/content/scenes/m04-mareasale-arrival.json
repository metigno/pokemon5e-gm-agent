        }
      ]
    },
    "harbor_board": {
      "stitches": [
        {
          "id": "board_1",
          "text": "Il tabellone separa tre categorie: traffico merci, servizi costieri e partenze autorizzate verso la barriera. Alcune righe mostrano ritardi legati al vento; altre richiedono conferma dall'ufficio meteo."
        },
        {
          "id": "board_2",
          "text": "Un pannello del Circuito indica l'Arena del Molo, il prossimo torneo della fascia regionale superiore e, separatamente, le date utili per il Trial C→B. Per partecipare servirà presentarsi agli sportelli dedicati."
        }
      ],
      "choices": [
        {
          "id": "board_note_weather",
          "text": "Segno che le partenze costiere dipendono dal meteo.",
          "goto": "port_approach",
          "effects": [
            {
              "type": "set_flag",
              "key": "mareasale_departure_weather_noted",
              "value": true
            }
          ]
        },
        {
          "id": "board_enter",
          "text": "Entro in città con il quadro degli orari.",
          "goto": "city_hub",
          "effects": [
            {
              "type": "set_flag",
              "key": "mareasale_discovered",
              "value": true
            },
            {
              "type": "set_location",
              "locationId": "mar_city"
            }
          ]
        }
      ]
    },
    "city_hub": {
      "stitches": [
        {
          "id": "hub_1",
          "text": "Il cuore di Mareasale è una piazza allungata fra magazzini e acqua. Da qui raggiungi banchine, ufficio meteo, Arena del Molo, mercato portuale e una casa di riposo per trainer."
        },
        {
          "id": "hub_2",
          "text": "Il porto non è un menu statico: alcune partenze esistono soltanto in finestre compatibili con vento e visibilità. Gli addetti consultano continuamente pannelli e radio."
        },
        {
          "id": "hub_3",
          "text": "Più lontano, la Costa di Sale corre verso sud-ovest. La Barriera Azzurra non è una destinazione pedonale: richiederà accesso marittimo e condizioni adatte."
        }
      ],
      "choices": [
