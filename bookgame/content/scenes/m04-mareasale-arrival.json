    "dock_routes": {
      "stitches": [
        {
          "id": "routes_1",
          "text": "«Costa di Sale via strada e piccoli servizi costieri. Barriera Azzurra solo con partenza autorizzata e finestra marina compatibile. Nessuno sale perché 'ha il Rank giusto' se il mare non permette di uscire.»"
