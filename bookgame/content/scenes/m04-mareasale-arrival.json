  "nodes": {
    "port_approach": {
      "stitches": [
        {
          "id": "approach_1",
          "text": "Mareasale appare prima come odore che come skyline: sale, cordame bagnato e carburante da servizio. Poi la strada scende e il porto riempie l'orizzonte con moli, gru basse, pescherecci, traghetti e navi merci."
        },
        {
          "id": "approach_2",
          "text": "Mareasale vive intorno al traffico marittimo. Il Circuito è visibile ma non dominante: l'Arena del Molo occupa una banchina riadattata, mentre orari, vento e carichi decidono il ritmo della città."
        },
        {
          "id": "approach_3",
          "text": "Il tuo arrivo non ferma niente. Una sirena segnala una partenza, un rimorchiatore gira nel bacino e un addetto sposta un pannello meteo prima ancora che tu raggiunga il primo incrocio."
        }
      ],
      "choices": [
        {
          "id": "enter_mareasale",
          "text": "Entro nel porto e prendo confidenza con Mareasale.",
          "timeCostMinutes": 10,
          "goto": "city_hub",
          "effects": [
            {
              "type": "set_flag",
              "key": "mareasale_discovered",
              "value": true
            },
            {
              "type": "set_location",
              "locationId": "mar_city"
            }
          ]
        },
        {
          "id": "check_harbor_board",
          "text": "Prima controllo il tabellone degli arrivi, partenze e avvisi.",
          "timeCostMinutes": 10,
          "goto": "harbor_board"
        },
        {
          "id": "return_ferravia",
          "text": "Non entro ancora: torno verso Ferravia.",
