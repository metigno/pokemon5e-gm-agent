  "nodes": {
    "friend_call": {
      "stitches": [
        {
          "id": "s1",
          "text": "Tra i nomi comparsi sul tabellone ce n'è uno che conosci fin troppo bene. Hai un'occasione per cercarlo, ma non sai ancora se riuscirete a vedervi di persona."
        }
