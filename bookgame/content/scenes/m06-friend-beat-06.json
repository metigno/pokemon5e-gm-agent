    "physical_context": {
      "stitches": [
        {
          "id": "s1",
          "text": "Vi ritrovate nello stesso posto, fra allenatori di passaggio e annunci di partenze. Il tempo per parlare non è infinito, ma basta a riconoscere quanto siete cambiati dall'ultima volta."
        }
      ],
      "choices": [
        {
          "id": "physical_competition",
          "text": "Parliamo di come il circuito ci sta cambiando.",
          "goto": "competition_context"
        },
        {
          "id": "physical_result",
          "text": "Restiamo sul significato del risultato appena visto.",
          "goto": "result_context"
        }
      ]
    },
    "remote_context": {
      "stitches": [
        {
          "id": "s1",
          "text": "La voce arriva dall'altro capo della linea, con rumori di una città diversa sullo sfondo. Non potete vedervi adesso, ma il tono familiare rende la distanza meno ingombrante."
        }
      ],
      "choices": [
        {
          "id": "remote_career",
          "text": "Parliamo della direzione presa dalla sua carriera.",
          "goto": "career_context",
          "timeCostMinutes": 15
        },
        {
          "id": "remote_competition",
          "text": "Confrontiamo il peso dei risultati interregionali.",
          "goto": "competition_context",
          "timeCostMinutes": 10
        }
      ]
    },
    "luke_deep_context": {
      "stitches": [
        {
          "id": "s1",
          "text": "Luke sbuffa. «Cambiare ritmo? Certo. Cambiare squadra ogni volta che qualcuno mi mette in difficoltà? Neanche per sogno». Si sente il sorriso nella voce. «Preferisco trovare il modo di farli colpire più forte»."
        }
      ],
      "choices": [
        {
          "id": "luke_deep_record",
          "text": "Gli rispondo senza lasciargli l'ultima parola.",
          "goto": "career_context",
          "effects": [
            {
              "type": "npc_state_set",
              "npcId": "Luke",
              "key": "friendBeat06SharedContext",
              "value": true
            },
            {
              "type": "set_flag",
              "key": "friend_beat_06_result",
              "value": "luke_adaptive_pressure"
            }
          ]
        },
        {
          "id": "luke_deep_comp",
          "text": "Lo porto sul terreno competitivo.",
          "goto": "competition_context"
        }
      ]
    },
    "mattew_deep_context": {
      "stitches": [
        {
          "id": "s1",
          "text": "Mattew riflette prima di rispondere. «Se una strategia funziona soltanto contro un avversario, non l'hai capita abbastanza». Poi ti provoca: «Vuoi che te lo spieghi con calma o fai finta di aver già capito?»"
        }
      ],
      "choices": [
        {
          "id": "mattew_deep_record",
          "text": "Gli chiedo di spiegarmi il suo metodo.",
          "goto": "career_context",
          "effects": [
            {
              "type": "npc_state_set",
              "npcId": "Mattew",
              "key": "friendBeat06SharedContext",
              "value": true
            },
            {
              "type": "set_flag",
              "key": "friend_beat_06_result",
              "value": "mattew_method_shift"
            }
          ]
        },
        {
          "id": "mattew_deep_comp",
          "text": "Confrontiamo i risultati Masters.",
          "goto": "competition_context"
        }
      ]
    },
    "daniel_deep_context": {
      "stitches": [
        {
          "id": "s1",
          "text": "Daniel abbassa la voce. «Ogni trasferta costa tempo. E ogni scelta chiude qualche altra porta». Esita un istante. «Non voglio arrivare in cima scoprendo di aver ignorato tutto il resto»."
        }
      ],
      "choices": [
        {
          "id": "daniel_deep_record",
          "text": "Gli chiedo cosa ha dovuto rinunciare a fare.",
          "goto": "career_context",
          "effects": [
            {
              "type": "npc_state_set",
              "npcId": "Daniel",
              "key": "friendBeat06SharedContext",
              "value": true
            },
            {
              "type": "set_flag",
              "key": "friend_beat_06_result",
              "value": "daniel_opportunity_cost"
            }
          ]
        },
        {
          "id": "daniel_deep_comp",
          "text": "Parliamo della Continental Cup.",
          "goto": "competition_context"
        }
      ]
    },
    "edward_deep_context": {
      "stitches": [
        {
          "id": "s1",
          "text": "Edward si appoggia allo schienale. «Fuori regione cambia tutto, tranne una cosa: non userò Pokémon che non mi piacciono solo per fare bella figura». Sorride. «E se qualcuno ha da ridire, venga a sfidarmi»."
        }
      ],
      "choices": [
        {
          "id": "edward_deep_record",
          "text": "Gli dico cosa penso della sua scelta.",
          "goto": "career_context",
          "effects": [
            {
              "type": "npc_state_set",
              "npcId": "Edward",
              "key": "friendBeat06SharedContext",
              "value": true
            },
            {
              "type": "set_flag",
              "key": "friend_beat_06_result",
              "value": "edward_continuity"
            }
          ]
        },
        {
          "id": "edward_deep_comp",
          "text": "Torniamo al circuito.",
          "goto": "competition_context"
        }
      ]
    },
    "fab_deep_context": {
      "stitches": [
        {
          "id": "s1",
          "text": "Fab guarda il proprio Pokémon prima di rispondere. «Mi dicono sempre cosa dovrei cambiare per vincere. Magari hanno ragione, eh». Gli gratta la testa. «Ma voglio riuscirci insieme a loro, non sostituirli al primo ostacolo»."
        }
      ],
      "choices": [
        {
          "id": "fab_deep_record",
          "text": "Gli chiedo come stanno i suoi Pokémon.",
          "goto": "career_context",
          "effects": [
            {
              "type": "npc_state_set",
              "npcId": "Fab",
              "key": "friendBeat06SharedContext",
              "value": true
            },
            {
              "type": "set_flag",
              "key": "friend_beat_06_result",
              "value": "fab_style_identity"
            }
          ]
        },
        {
          "id": "fab_deep_comp",
          "text": "Confrontiamo la pressione del circuito.",
          "goto": "competition_context"
        }
      ]
    },
    "competition_context": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il discorso scivola sugli avversari incontrati e su quelli che potrebbero arrivare. Vi prendete in giro sui rispettivi risultati, ma nessuno dei due sa ancora come andrà il prossimo incontro."
        }
      ],
      "choices": [
        {
          "id": "competition_career",
          "text": "Porto il discorso sulla direzione di carriera.",
          "goto": "career_context"
        },
        {
          "id": "competition_result",
          "text": "Chiudo sul significato del risultato visibile.",
          "goto": "result_context"
        }
      ]
    },
    "career_context": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il tuo amico racconta ciò che è disposto a condividere del proprio percorso. Puoi essere d'accordo, discutere o semplicemente ascoltare: la scelta resta sua."
        }
      ],
      "choices": [
        {
          "id": "career_result",
          "text": "Gli chiedo cosa significhi per lui questa novità.",
          "goto": "result_context"
        }
      ]
    },
    "result_context": {
      "stitches": [
        {
          "id": "s1",
          "text": "La conversazione si avvia alla fine. Rimane una notizia concreta, qualche battuta e la sensazione che il prossimo incontro non sarà identico a questo."
        }
      ],
      "choices": [
        {
          "id": "result_close",
          "text": "Lo saluto e torno ai miei impegni.",
          "goto": "close",
          "effects": [
            {
              "type": "set_flag",
              "key": "friend_beat_06_complete",
              "value": true
            }
          ]
        }
      ]
    },
    "close": {
      "stitches": [
        {
          "id": "s1",
          "text": "Vi salutate promettendo di sentirvi quando gli impegni lo permetteranno. Intanto, sui monitor del circuito compaiono nuovi annunci per la Continental Cup."
        }
      ],
      "choices": [
        {
          "id": "close_route",
          "text": "Vado a informarmi sulla Continental Cup.",
          "goto": "route_link"
        }
      ]
    },
    "defer": {
      "stitches": [
        {
          "id": "s1",
          "text": "Non riesci a parlare adesso. Il contatto resta disponibile quando gli orari e gli impegni vi permetteranno di riprovarci."
        }
      ],
      "choices": [
        {
          "id": "defer_return",
          "text": "Torno al contatto selezionato.",
          "goto": "friend_call"
        }
      ]
    },
    "route_link": {
      "stitches": [
        {
          "id": "s1",
          "text": "All'ingresso del circuito, un cartello indica lo sportello della Continental Cup. La fila avanza lentamente sotto gli occhi degli addetti."
        }
      ],
      "choices": [
        {
          "id": "route_continental",
          "text": "Mi avvicino allo sportello della Continental Cup.",
          "goto": "m06-continental-entry#continental_entry"
