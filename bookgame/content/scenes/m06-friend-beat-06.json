          "effects": [
            {
              "type": "set_flag",
              "key": "friend_beat_06_type",
              "value": "remote"
            },
            {
              "type": "npc_relationship_adjust",
              "npcId": "Luke",
              "delta": 1
            },
            {
              "type": "set_flag",
              "key": "friend_beat_06_result",
              "value": "luke_remote"
            }
          ]
        },
        {
          "id": "luke_deep",
          "text": "Vado direttamente sul cambiamento di carriera che ho appena visto.",
          "goto": "luke_deep_context",
          "effects": [
            {
              "type": "npc_relationship_adjust",
              "npcId": "Luke",
              "delta": 2
            }
          ]
        }
      ]
    },
    "mattew_contact": {
      "stitches": [
        {
          "id": "s1",
          "text": "Mattew arriva al punto con precisione, ma non rinuncia a punzecchiarti. «Ho rivisto il modo in cui preparo gli incontri. Prima che tu lo chieda: sì, mi alleno ancora più di te»."
