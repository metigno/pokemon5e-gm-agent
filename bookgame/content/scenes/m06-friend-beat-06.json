      "choices": [
        {
          "id": "dispatch_luke",
          "text": "Il contatto è Luke.",
          "goto": "luke_contact",
          "conditions": {
            "path": "world.flags.friend_beat_06_friend_id",
            "eq": "Luke"
          }
        },
        {
          "id": "dispatch_mattew",
          "text": "Il contatto è Mattew.",
          "goto": "mattew_contact",
          "conditions": {
            "path": "world.flags.friend_beat_06_friend_id",
            "eq": "Mattew"
