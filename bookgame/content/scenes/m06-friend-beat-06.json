    "luke_contact": {
      "stitches": [
        {
          "id": "s1",
          "text": "Luke risponde con un tono di sfida che conosci bene. «Hai visto? E non ho nemmeno dovuto cambiare i miei Pokémon preferiti». Dopo una pausa aggiunge: «Tu come te la passi, campione?»"
        }
      ],
      "choices": [
        {
          "id": "luke_physical",
          "text": "Incontro Luke di persona.",
          "goto": "physical_context",
          "conditions": {
            "path": "world.flags.friend_beat_06_contact_mode",
            "eq": "physical"
          },
          "effects": [
            {
              "type": "set_flag",
              "key": "friend_beat_06_type",
              "value": "physical"
            },
            {
              "type": "npc_relationship_adjust",
              "npcId": "Luke",
              "delta": 2
            },
            {
              "type": "set_flag",
              "key": "friend_beat_06_result",
              "value": "luke_physical"
            }
          ]
        },
        {
          "id": "luke_remote",
          "text": "Contatto Luke a distanza.",
          "goto": "remote_context",
          "conditions": {
            "path": "world.flags.friend_beat_06_contact_mode",
            "eq": "remote"
