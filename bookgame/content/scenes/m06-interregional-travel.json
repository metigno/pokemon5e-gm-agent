{
  "schemaVersion": 1,
  "id": "m06-interregional-travel",
  "moduleId": "M06",
  "title": "M6_02 — Interregional Travel",
  "locationId": "alt_town_terminal",
  "entryNodeId": "travel_entry",
  "conditions": {
    "all": [
      {
        "path": "world.flags.m5_complete",
        "eq": true
      },
      {
        "path": "world.flags.m06_unlocked",
        "eq": true
      },
      {
        "path": "world.flags.m6_active",
        "eq": true
      },
      {
        "path": "competition.rank",
        "eq": "A"
      },
      {
        "path": "world.flags.m6_route_selection_complete",
        "eq": true
      }
    ]
  },
  "nodes": {
    "travel_entry": {
      "stitches": [
        {
          "id": "s1",
          "text": "Nella sala partenze di Altacima, una fila di allenatori avanza sotto l'orologio. L'impiegato controlla i biglietti e indica il tabellone: «Per attraversare la regione serviranno alcune coincidenze. Se preferisci aspettare, verifica l'ultima corsa»."
        }
      ],
      "choices": [
        {
          "id": "travel_board",
          "text": "Vado al banco partenze.",
          "goto": "departure_board"
        },
        {
          "id": "travel_route",
          "text": "Rileggo la rotta scelta.",
          "goto": "route_callback"
        },
        {
          "id": "travel_wait",
          "text": "Aspetto una finestra successiva.",
          "goto": "wait",
          "timeCostMinutes": 60
        }
      ]
    },
    "departure_board": {
      "stitches": [
        {
          "id": "s1",
          "text": "Sul monitor compaiono la destinazione annotata e le tratte ancora disponibili. Due sportelli chiamano i passeggeri per Solaria e Luminara; nessuno può salire senza presentarsi al controllo."
        }
      ],
      "choices": [
        {
          "id": "depart_solaria",
          "text": "Parto per Solaria.",
          "goto": "solaria_transit",
          "conditions": {
            "path": "world.flags.m6_route_plan",
            "eq": "solaria"
          },
          "timeCostMinutes": 240,
          "effects": [
            {
              "type": "set_flag",
              "key": "m6_travel_started",
              "value": "solaria"
            },
            {
              "type": "set_location",
              "locationId": "interregional_transit"
            }
          ]
        },
        {
          "id": "depart_luminara",
          "text": "Parto per Luminara.",
          "goto": "luminara_transit",
          "conditions": {
            "path": "world.flags.m6_route_plan",
            "eq": "luminara"
          },
          "timeCostMinutes": 300,
          "effects": [
            {
              "type": "set_flag",
              "key": "m6_travel_started",
              "value": "luminara"
            },
            {
              "type": "set_location",
              "locationId": "interregional_transit"
            }
          ]
        },
        {
          "id": "depart_delay",
          "text": "Rimando la partenza senza cambiare piano.",
          "goto": "delay"
        },
        {
          "id": "depart_change",
          "text": "Torno a scegliere la rotta.",
          "goto": "m06-route-selection#route_board",
          "effects": [
            {
              "type": "set_location",
              "locationId": "alt_town"
            }
          ]
        }
      ]
    },
    "solaria_transit": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il convoglio lascia Altacima alle spalle. Fuori dal finestrino si alternano campi, ponti e piccole stazioni; a ogni coincidenza, viaggiatori e Pokémon cambiano carrozza. Il tragitto richiede pazienza, non soltanto un biglietto."
        }
      ],
      "choices": [
        {
          "id": "solaria_customs",
          "text": "Passo il controllo di accesso della rete.",
          "goto": "customs"
        },
        {
          "id": "solaria_delay",
          "text": "Accetto una coincidenza più lenta.",
          "goto": "delay",
          "timeCostMinutes": 60
        }
      ]
    },
    "luminara_transit": {
      "stitches": [
        {
          "id": "s1",
          "text": "La carrozza diretta a Luminara è gremita di allenatori con custodie e zaini da viaggio. Una voce annuncia la prossima coincidenza, mentre la folla si stringe verso le porte."
        }
      ],
      "choices": [
        {
          "id": "luminara_customs",
          "text": "Passo il controllo di accesso della rete.",
          "goto": "customs"
        },
        {
          "id": "luminara_delay",
          "text": "Aspetto la coincidenza successiva.",
          "goto": "delay",
          "timeCostMinutes": 60
        }
      ]
    },
    "customs": {
      "stitches": [
        {
          "id": "s1",
          "text": "Al controllo interregionale, un'agente confronta il biglietto con la licenza. Ti restituisce i documenti e fa cenno di procedere: «Benvenuto. Tieni a portata di mano il titolo di viaggio fino all'uscita»."
        }
      ],
      "choices": [
        {
          "id": "customs_solaria",
          "text": "La tratta è Solaria: completo l'arrivo.",
          "goto": "arrival_solaria",
          "conditions": {
            "path": "world.flags.m6_travel_started",
            "eq": "solaria"
          }
        },
        {
          "id": "customs_luminara",
          "text": "La tratta è Luminara: completo l'arrivo.",
          "goto": "arrival_luminara",
          "conditions": {
            "path": "world.flags.m6_travel_started",
            "eq": "luminara"
          }
        }
      ]
    },
    "delay": {
      "stitches": [
        {
          "id": "s1",
          "text": "Un annuncio segnala un ritardo. Alcuni passeggeri si lamentano; altri cercano nuove coincidenze. Sul tabellone gli orari cambiano, e devi decidere se attendere o tornare allo sportello."
        }
      ],
      "choices": [
        {
          "id": "delay_departures",
          "text": "Torno al banco partenze.",
          "goto": "departure_board"
        },
        {
          "id": "delay_wait",
          "text": "Lascio passare ancora un'ora.",
          "goto": "wait",
          "timeCostMinutes": 60
        }
      ]
    },
    "arrival_solaria": {
      "stitches": [
        {
          "id": "s1",
          "text": "L'aria di Solaria è calda e la piazza davanti alla stazione vibra di voci. Manifesti di incontri imminenti coprono i muri; allenatori sconosciuti confrontano gli orari senza badare alla tua licenza."
        }
      ],
      "choices": [
        {
          "id": "solaria_register",
          "text": "Registro l'arrivo a Solaria.",
          "goto": "arrival_close",
          "effects": [
            {
              "type": "set_flag",
              "key": "m6_first_destination",
              "value": "solaria"
            },
            {
              "type": "set_flag",
              "key": "m6_interregional_travel_complete",
              "value": true
            },
            {
              "type": "set_location",
              "locationId": "solaria_hub"
            }
          ]
        },
        {
          "id": "solaria_red",
          "text": "Osservo chi si sta muovendo nel circuito.",
          "goto": "red_rumor",
          "effects": [
            {
              "type": "set_flag",
              "key": "m6_red_context",
              "value": "solaria"
            }
          ]
        }
      ]
    },
    "arrival_luminara": {
      "stitches": [
        {
          "id": "s1",
          "text": "Luminara ti accoglie con una stazione immensa e corridoi affollati. Sugli schermi si alternano partenze e annunci del circuito Masters. Un gruppo di allenatori corre verso la registrazione."
        }
      ],
      "choices": [
        {
          "id": "luminara_register",
          "text": "Registro l'arrivo a Luminara.",
          "goto": "arrival_close",
          "effects": [
            {
              "type": "set_flag",
              "key": "m6_first_destination",
              "value": "luminara"
            },
            {
              "type": "set_flag",
              "key": "m6_interregional_travel_complete",
              "value": true
            },
            {
              "type": "set_location",
              "locationId": "luminara_hub"
            }
          ]
        },
        {
          "id": "luminara_red",
          "text": "Osservo chi si sta muovendo nel circuito.",
          "goto": "red_rumor",
          "effects": [
            {
              "type": "set_flag",
              "key": "m6_red_context",
              "value": "luminara"
            }
          ]
        }
      ]
    },
    "route_callback": {
      "stitches": [
        {
          "id": "s1",
          "text": "Allo sportello ritrovi la destinazione annotata sul tuo itinerario. «Finché non sali a bordo, possiamo cambiare il biglietto», dice l'impiegato, indicando le alternative."
        }
      ],
      "choices": [
        {
          "id": "route_depart",
          "text": "Procedo al banco partenze.",
          "goto": "departure_board"
        },
        {
          "id": "route_change",
          "text": "Riapro la selezione.",
          "goto": "m06-route-selection#route_board",
          "effects": [
            {
              "type": "set_location",
              "locationId": "alt_town"
            }
          ]
        }
      ]
    },
    "red_rumor": {
      "stitches": [
        {
          "id": "s1",
          "text": "Davanti al monitor dei risultati, due allenatori parlano a bassa voce. «Red era qui l'altro giorno», dice uno. L'altro indica una riga del tabellone: «Non rilascia quasi mai interviste, ma guarda dove continua a comparire»."
        }
      ],
      "choices": [
        {
          "id": "red_note",
          "text": "Registro solo l'informazione pubblica.",
          "goto": "arrival_close",
          "effects": [
            {
              "type": "set_flag",
              "key": "red_rumor_heard",
              "value": true
            }
          ]
        },
        {
          "id": "red_ignore",
          "text": "Ignoro il nome e continuo con il mio arrivo.",
          "goto": "arrival_close"
        }
      ]
    },
    "arrival_close": {
      "stitches": [
        {
          "id": "s1",
          "text": "Oltre le porte della stazione, il circuito ti aspetta. Puoi seguire le notizie su Red oppure prendere tempo per conoscere la città e i suoi allenatori."
        }
      ],
      "choices": [
        {
          "id": "close_red",
          "text": "Cerco un contesto plausibile per incontrare Red.",
          "goto": "m06-red-enters#red_entry"
        },
        {
          "id": "close_route",
          "text": "Gestisco un eventuale ritorno o una nuova partenza.",
          "goto": "return_board"
        }
      ]
    },
    "return_board": {
      "stitches": [
        {
          "id": "s1",
          "text": "Alla biglietteria trovi già nuovi orari di ritorno. Alcune coincidenze richiedono un'attesa lunga; l'impiegato ti invita a controllare bene prima di partire."
        }
      ],
      "choices": [
        {
          "id": "return_departure",
          "text": "Torno al banco partenze.",
          "goto": "departure_board"
        },
        {
          "id": "return_close",
          "text": "Chiudo il riepilogo del viaggio.",
          "goto": "arrival_close"
        }
      ]
    },
    "wait": {
      "stitches": [
        {
          "id": "s1",
          "text": "Un'ora dopo, l'orologio segna un nuovo orario e il tabellone è cambiato. Qualcuno è partito, altri sono arrivati. Il tuo biglietto è ancora sul banco."
        }
      ],
      "choices": [
        {
          "id": "wait_board",
          "text": "Ritorno al banco partenze.",
          "goto": "departure_board"
        },
        {
          "id": "wait_route",
          "text": "Rivedo la rotta persistente.",
          "goto": "route_callback"
        }
      ]
    }
  }
}
