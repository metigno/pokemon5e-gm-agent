{
  "schemaVersion": 1,
  "id": "m11-other-sf",
  "moduleId": "M11",
  "title": "M11_04 — Other SF",
  "locationId": "world_knockout_hall",
  "entryNodeId": "other_sf_entry",
  "conditions": {
    "all": [
      {
        "path": "world.flags.m11_world_sf_complete",
        "eq": true
      },
      {
        "path": "world.flags.world_sf_resolved",
        "eq": true
      },
      {
        "path": "competition.world.top4Locked",
        "eq": true
      }
    ]
  },
  "nodes": {
    "other_sf_entry": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il risultato del player è definitivo. Ora E5 chiude l'altra semifinale senza proteggere Rei, amici o rivali."
        }
      ],
      "choices": [
        {
          "id": "other_sf_entry_next",
          "text": "Proseguo verso Resolve Guard.",
          "goto": "resolve_guard"
        },
        {
          "id": "other_sf_entry_alt",
          "text": "Confronto questo punto con Player Result.",
          "goto": "player_result"
        },
        {
          "id": "other_sf_entry_deep",
          "text": "Approfondisco Other Match.",
          "goto": "other_match"
        }
      ]
    },
    "resolve_guard": {
      "stitches": [
        {
          "id": "s1",
          "text": "La seconda semifinale viene risolta una sola volta con il resolver deterministico del Mondiale; il match del player non viene rigiocato."
        }
      ],
      "choices": [
        {
          "id": "resolve_now",
          "text": "Risolvo l'altra semifinale e locko i due finalisti.",
          "goto": "finalists_rules",
          "conditions": {
            "path": "competition.world.knockout.sfResolved",
            "ne": true
          },
          "effects": [
            {
              "type": "competition_world_sf_resolve",
              "eventId": "WORLD_SF_RESOLVE"
            }
          ]
        },
        {
          "id": "resolve_existing",
          "text": "Le semifinali sono già chiuse: leggo i finalisti persistenti.",
          "goto": "finalists_rules",
          "conditions": {
            "path": "competition.world.knockout.sfResolved",
            "eq": true
          }
        },
        {
          "id": "resolve_audit",
          "text": "Prima audito il risultato del player.",
          "goto": "player_result"
        }
      ]
    },
    "player_result": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il vincitore reale della semifinale del player occupa il primo slot disponibile della finale."
        }
      ],
      "choices": [
        {
          "id": "player_result_next",
          "text": "Proseguo verso Other Match.",
          "goto": "other_match"
        },
        {
          "id": "player_result_alt",
          "text": "Confronto questo punto con Determinism.",
          "goto": "determinism"
        }
      ]
    },
    "other_match": {
      "stitches": [
        {
          "id": "s1",
          "text": "L'altra coppia del Top4 conserva il proprio matchId e produce un solo vincitore."
        }
      ],
      "choices": [
        {
          "id": "other_match_next",
          "text": "Proseguo verso Determinism.",
          "goto": "determinism"
        },
        {
          "id": "other_match_alt",
          "text": "Confronto questo punto con Rei Outcome.",
          "goto": "rei_outcome"
        }
      ]
    },
    "determinism": {
      "stitches": [
        {
          "id": "s1",
          "text": "La risoluzione off-screen usa il seed già persistente della stessa edizione, quindi save/reload non cambia il vincitore."
        }
      ],
      "choices": [
        {
          "id": "determinism_next",
          "text": "Proseguo verso Rei Outcome.",
          "goto": "rei_outcome"
        },
        {
          "id": "determinism_alt",
          "text": "Confronto questo punto con Finalists Rules.",
          "goto": "finalists_rules"
        }
      ]
    },
    "rei_outcome": {
      "stitches": [
        {
          "id": "s1",
          "text": "Se Rei è nell'altra semifinale può vincere o perdere come chiunque altro."
        }
      ],
      "choices": [
        {
          "id": "rei_outcome_next",
          "text": "Proseguo verso Finalists Rules.",
          "goto": "finalists_rules"
        },
        {
          "id": "rei_outcome_alt",
          "text": "Confronto questo punto con Final Pairing.",
          "goto": "final_pairing"
        }
      ]
    },
    "finalists_rules": {
      "stitches": [
        {
          "id": "s1",
          "text": "La finale richiede esattamente due partecipanti unici, entrambi vincitori di una semifinale."
        }
      ],
      "choices": [
        {
          "id": "finalists_rules_next",
          "text": "Proseguo verso Final Pairing.",
          "goto": "final_pairing"
        },
        {
          "id": "finalists_rules_alt",
          "text": "Confronto questo punto con Player Finalist.",
          "goto": "player_finalist"
        }
      ]
    },
    "final_pairing": {
      "stitches": [
        {
          "id": "s1",
          "text": "WORLD_FINAL_1 nasce dai due vincitori reali; nessun testo sceglie l'avversario preferito."
        }
      ],
      "choices": [
        {
          "id": "final_pairing_next",
          "text": "Proseguo verso Player Finalist.",
          "goto": "player_finalist"
        },
        {
          "id": "final_pairing_alt",
          "text": "Confronto questo punto con Eliminated State.",
          "goto": "eliminated_state"
        }
      ]
    },
    "player_finalist": {
      "stitches": [
        {
          "id": "s1",
          "text": "Se il player ha vinto WORLD_SF, playerFinalOpponent indica l'altro finalista reale."
        }
      ],
      "choices": [
        {
          "id": "player_finalist_next",
          "text": "Proseguo verso Eliminated State.",
          "goto": "eliminated_state"
        },
        {
          "id": "player_finalist_alt",
          "text": "Confronto questo punto con History Audit.",
          "goto": "history_audit"
        }
      ]
    },
    "eliminated_state": {
      "stitches": [
        {
          "id": "s1",
          "text": "Se il player ha perso WORLD_SF, la finale esiste senza di lui e la sua carriera proseguirà verso WORLD_EXIT dopo i beat obbligatori."
        }
      ],
      "choices": [
        {
          "id": "eliminated_state_next",
          "text": "Proseguo verso History Audit.",
          "goto": "history_audit"
        },
        {
          "id": "eliminated_state_alt",
          "text": "Confronto questo punto con Persistence.",
          "goto": "persistence"
        }
      ]
    },
    "history_audit": {
      "stitches": [
        {
          "id": "s1",
          "text": "La history conserva il match del player e non inventa un record per la semifinale simulata."
        }
      ],
      "choices": [
        {
          "id": "history_audit_next",
          "text": "Proseguo verso Persistence.",
          "goto": "persistence"
        },
        {
          "id": "history_audit_alt",
          "text": "Confronto questo punto con Idempotence.",
          "goto": "idempotence"
        }
      ]
    },
    "persistence": {
      "stitches": [
        {
          "id": "s1",
          "text": "Top4, risultati SF, finalisti e finalMatch devono sopravvivere a save/reload."
        }
      ],
      "choices": [
        {
          "id": "persistence_next",
          "text": "Proseguo verso Idempotence.",
          "goto": "idempotence"
        },
        {
          "id": "persistence_alt",
          "text": "Confronto questo punto con Commit.",
          "goto": "commit"
        }
      ]
    },
    "idempotence": {
      "stitches": [
        {
          "id": "s1",
          "text": "Rientrare nel resolver dopo la chiusura deve restituire lo stesso bracket finale."
        }
      ],
      "choices": [
        {
          "id": "idempotence_next",
          "text": "Proseguo verso Commit.",
          "goto": "commit"
        },
        {
          "id": "idempotence_alt",
          "text": "Confronto questo punto con Complete.",
          "goto": "complete"
        }
      ]
    },
    "commit": {
      "stitches": [
        {
          "id": "s1",
          "text": "M11_04 chiude il primo ciclo lasciando una finale reale oppure una eliminazione reale."
        }
      ],
      "choices": [
        {
          "id": "commit_now",
          "text": "Chiudo M11_04 e il primo ciclo.",
          "goto": "complete",
          "effects": [
            {
              "type": "set_flag",
              "key": "m11_other_sf_complete",
              "value": true
            },
            {
              "type": "set_flag",
              "key": "m11_cycle1_complete",
              "value": true
            }
          ]
        },
        {
          "id": "commit_review",
          "text": "Rivedo il pairing della finale.",
          "goto": "final_pairing"
        }
      ]
    },
    "complete": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il ciclo M11_00–M11_04 è completo: nessun campione è ancora dichiarato prima di WORLD_FINAL."
        }
      ],
      "choices": [
        {
          "id": "complete_friend",
          "text": "Passo a FRIEND_BEAT_11 senza cambiare il bracket.",
          "goto": "m11-friend-beat-11#friend_entry"
        },
        {
          "id": "complete_alt",
          "text": "Confronto questo punto con Other Sf Entry.",
          "goto": "other_sf_entry"
        }
      ]
    },
    "review": {
      "stitches": [
        {
          "id": "s1",
          "text": "Da qui si può soltanto rileggere il Final Four già risolto, non rigenerarlo."
        }
      ],
      "choices": [
        {
          "id": "review_next",
          "text": "Proseguo verso Other Sf Entry.",
          "goto": "other_sf_entry"
        },
        {
          "id": "review_alt",
          "text": "Confronto questo punto con Resolve Guard.",
          "goto": "resolve_guard"
        }
      ]
    }
  }
}
