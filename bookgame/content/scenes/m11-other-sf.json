{
  "schemaVersion": 1,
  "id": "m11-other-sf",
  "moduleId": "M11",
  "title": "M11_04 — Other SF",
  "locationId": "world_knockout_hall",
  "entryNodeId": "other_sf_entry",
  "conditions": {
    "all": [
      {
        "path": "world.flags.m11_world_sf_complete",
        "eq": true
      },
      {
        "path": "world.flags.world_sf_resolved",
        "eq": true
      },
      {
        "path": "competition.world.top4Locked",
        "eq": true
      }
    ]
  },
  "nodes": {
    "other_sf_entry": {
      "stitches": [
        {
          "id": "s1",
          "text": "Dopo la tua semifinale, il Mondiale continua sull'altro campo. Due allenatori devono ancora guadagnarsi il posto nell'ultima partita."
        }
      ],
      "choices": [
        {
          "id": "other_sf_entry_next",
          "text": "Proseguo verso Resolve Guard.",
          "goto": "resolve_guard"
        },
        {
          "id": "other_sf_entry_alt",
          "text": "Confronto questo punto con Player Result.",
          "goto": "player_result"
        },
        {
          "id": "other_sf_entry_deep",
          "text": "Approfondisco Other Match.",
          "goto": "other_match"
        }
      ]
    },
    "resolve_guard": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il risultato dell'altra semifinale arriva attraverso il tabellone ufficiale. Non viene disputata di nuovo soltanto perché torni a guardarlo."
        }
      ],
      "choices": [
        {
          "id": "resolve_now",
          "text": "Risolvo l'altra semifinale e locko i due finalisti.",
          "goto": "finalists_rules",
          "conditions": {
            "path": "competition.world.knockout.sfResolved",
            "ne": true
          },
          "effects": [
            {
              "type": "competition_world_sf_resolve",
              "eventId": "WORLD_SF_RESOLVE"
            }
          ]
        },
        {
          "id": "resolve_existing",
          "text": "Le semifinali sono già chiuse: leggo i finalisti persistenti.",
          "goto": "finalists_rules",
          "conditions": {
            "path": "competition.world.knockout.sfResolved",
            "eq": true
          }
        },
        {
          "id": "resolve_audit",
          "text": "Prima audito il risultato del player.",
          "goto": "player_result"
        }
      ]
    },
    "player_result": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il vincitore della tua semifinale è già tra i finalisti. L'esito è stato deciso sul campo."
        }
      ],
      "choices": [
        {
          "id": "player_result_next",
          "text": "Proseguo verso Other Match.",
          "goto": "other_match"
        },
        {
          "id": "player_result_alt",
          "text": "Confronto questo punto con Determinism.",
          "goto": "determinism"
        }
      ]
    },
    "other_match": {
      "stitches": [
        {
          "id": "s1",
          "text": "Dall'altra parte del tabellone c'è una coppia di allenatori con il proprio percorso. Soltanto uno potrà avanzare."
        }
      ],
      "choices": [
        {
          "id": "other_match_next",
          "text": "Proseguo verso Determinism.",
          "goto": "determinism"
        },
        {
          "id": "other_match_alt",
          "text": "Confronto questo punto con Rei Outcome.",
          "goto": "rei_outcome"
        }
      ]
    },
    "determinism": {
      "stitches": [
        {
          "id": "s1",
          "text": "Gli addetti riportano il risultato ufficiale dell'altra partita. Consultarlo una seconda volta non cambia chi ha vinto."
        }
      ],
      "choices": [
        {
          "id": "determinism_next",
          "text": "Proseguo verso Rei Outcome.",
          "goto": "rei_outcome"
        },
        {
          "id": "determinism_alt",
          "text": "Confronto questo punto con Finalists Rules.",
          "goto": "finalists_rules"
        }
      ]
    },
    "rei_outcome": {
      "stitches": [
        {
          "id": "s1",
          "text": "Se Rei giocava sull'altro campo, può aver vinto oppure perso. Il suo nome non obbliga l'arbitro a promuoverlo."
        }
      ],
      "choices": [
        {
          "id": "rei_outcome_next",
          "text": "Proseguo verso Finalists Rules.",
          "goto": "finalists_rules"
        },
        {
          "id": "rei_outcome_alt",
          "text": "Confronto questo punto con Final Pairing.",
          "goto": "final_pairing"
        }
      ]
    },
    "finalists_rules": {
      "stitches": [
        {
          "id": "s1",
          "text": "Ora il tabellone deve mostrare due finalisti e soltanto due: i vincitori delle semifinali."
        }
      ],
      "choices": [
        {
          "id": "finalists_rules_next",
          "text": "Proseguo verso Final Pairing.",
          "goto": "final_pairing"
        },
        {
          "id": "finalists_rules_alt",
          "text": "Confronto questo punto con Player Finalist.",
          "goto": "player_finalist"
        }
      ]
    },
    "final_pairing": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il programma della finale si completa con il nome di chi ha realmente vinto l'altra sfida."
        }
      ],
      "choices": [
        {
          "id": "final_pairing_next",
          "text": "Proseguo verso Player Finalist.",
          "goto": "player_finalist"
        },
        {
          "id": "final_pairing_alt",
          "text": "Confronto questo punto con Eliminated State.",
          "goto": "eliminated_state"
        }
      ]
    },
    "player_finalist": {
      "stitches": [
        {
          "id": "s1",
          "text": "Se hai vinto la semifinale, leggi finalmente il nome dell'avversario che ti aspetta."
        }
      ],
      "choices": [
        {
          "id": "player_finalist_next",
          "text": "Proseguo verso Eliminated State.",
          "goto": "eliminated_state"
        },
        {
          "id": "player_finalist_alt",
          "text": "Confronto questo punto con History Audit.",
          "goto": "history_audit"
        }
      ]
    },
    "eliminated_state": {
      "stitches": [
        {
          "id": "s1",
          "text": "Se hai perso, la finale si giocherà senza di te. Puoi seguire il risultato; non puoi riprendere il tuo posto sul terreno."
        }
      ],
      "choices": [
        {
          "id": "eliminated_state_next",
          "text": "Proseguo verso History Audit.",
          "goto": "history_audit"
        },
        {
          "id": "eliminated_state_alt",
          "text": "Confronto questo punto con Persistence.",
          "goto": "persistence"
        }
      ]
    },
    "history_audit": {
      "stitches": [
        {
          "id": "s1",
          "text": "Sul registro compare il tuo incontro, insieme al risultato dell'altra semifinale sotto i nomi di chi l'ha giocata."
        }
      ],
      "choices": [
        {
          "id": "history_audit_next",
          "text": "Proseguo verso Persistence.",
          "goto": "persistence"
        },
        {
          "id": "history_audit_alt",
          "text": "Confronto questo punto con Idempotence.",
          "goto": "idempotence"
        }
      ]
    },
    "persistence": {
      "stitches": [
        {
          "id": "s1",
          "text": "I tabelloni rimangono affissi e i risultati già firmati non vengono rimpiazzati durante la notte."
        }
      ],
      "choices": [
        {
          "id": "persistence_next",
          "text": "Proseguo verso Idempotence.",
          "goto": "idempotence"
        },
        {
          "id": "persistence_alt",
          "text": "Confronto questo punto con passaggio conclusivo.",
          "goto": "commit"
        }
      ]
    },
    "idempotence": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il giorno dopo il nome del finalista è ancora quello annunciato. Nessuna nuova estrazione modifica la sfida."
        }
      ],
      "choices": [
        {
          "id": "idempotence_next",
          "text": "Proseguo verso passaggio conclusivo.",
          "goto": "commit"
        },
        {
          "id": "idempotence_alt",
          "text": "Confronto questo punto con Complete.",
          "goto": "complete"
        }
      ]
    },
    "commit": {
      "stitches": [
        {
          "id": "s1",
          "text": "Le semifinali sono concluse. Chi è ancora in gara si prepara all'ultima partita; gli altri cercano la strada verso casa."
        }
      ],
      "choices": [
        {
          "id": "commit_now",
          "text": "Chiudo M11_04 e il primo ciclo.",
          "goto": "complete",
          "effects": [
            {
              "type": "set_flag",
              "key": "m11_other_sf_complete",
              "value": true
            },
            {
              "type": "set_flag",
              "key": "m11_cycle1_complete",
              "value": true
            }
          ]
        },
        {
          "id": "commit_review",
          "text": "Rivedo il pairing della finale.",
          "goto": "final_pairing"
        }
      ]
    },
    "complete": {
      "stitches": [
        {
          "id": "s1",
          "text": "La finale ora ha due nomi. Nessuno è già campione prima che si giochi."
        }
      ],
      "choices": [
        {
          "id": "complete_friend",
          "text": "Passo a FRIEND_BEAT_11 senza cambiare il bracket.",
          "goto": "m11-friend-beat-11#friend_entry"
        },
        {
          "id": "complete_alt",
          "text": "Rivedo il Final Four già risolto.",
          "goto": "review"
        }
      ]
    },
    "review": {
      "stitches": [
        {
          "id": "s1",
          "text": "Puoi tornare a osservare gli incontri passati. I loro vincitori sono già stati decisi."
        }
      ],
      "choices": [
        {
          "id": "review_next",
          "text": "Proseguo verso Other Sf Entry.",
          "goto": "other_sf_entry"
        },
        {
          "id": "review_alt",
          "text": "Confronto questo punto con Resolve Guard.",
          "goto": "resolve_guard"
        }
      ]
    }
  }
}
