{
  "schemaVersion": 1,
  "id": "m06-masters-circuit",
  "moduleId": "M06",
  "title": "M6_04 — Masters Circuit",
  "locationId": "interregional_masters_hall",
  "entryNodeId": "masters_entry",
  "conditions": {
    "all": [
      {
        "path": "world.flags.m5_complete",
        "eq": true
      },
      {
        "path": "world.flags.m06_unlocked",
        "eq": true
      },
      {
        "path": "world.flags.m6_active",
        "eq": true
      },
      {
        "path": "competition.rank",
        "eq": "A"
      }
    ]
  },
  "nodes": {
    "masters_entry": {
      "stitches": [
        {
          "id": "s1",
          "text": "All'ingresso del Masters, una fila di allenatori mostra la licenza al personale. L'addetta controlla il tuo grado A e ti lascia passare. «Qui non bastano i risultati della tua regione. Ogni incontro ricomincia da zero»."
        }
      ],
      "choices": [
        {
          "id": "masters_hub",
          "text": "Entro nell'area Masters.",
          "goto": "circuit_hub"
        },
        {
          "id": "masters_points",
          "text": "Rivedo cosa viene registrato dal circuito.",
          "goto": "points_info"
        },
        {
          "id": "masters_defer",
          "text": "Rimando l'evento e torno al viaggio.",
          "goto": "route_link"
        }
      ]
    },
    "circuit_hub": {
      "stitches": [
        {
          "id": "s1",
          "text": "L'atrio del circuito si divide fra bacheche, sportelli e un'area di preparazione. Sul grande monitor scorrono nomi e orari; gli allenatori studiano gli avversari o aspettano il proprio turno."
        }
      ],
      "choices": [
        {
          "id": "hub_event",
          "text": "Scelgo la finestra Masters disponibile.",
          "goto": "event_select"
        },
        {
          "id": "hub_opponent",
          "text": "Leggo il profilo pubblico dell'avversario.",
          "goto": "opponent"
        },
        {
          "id": "hub_prep",
          "text": "Mi fermo a studiare la squadra.",
          "goto": "prep"
        },
        {
          "id": "hub_leave",
          "text": "Esco senza consumare il match.",
          "goto": "route_link"
        }
      ]
    },
    "points_info": {
      "stitches": [
        {
          "id": "s1",
          "text": "Sul monitor della classifica, ogni risultato compare accanto alla data dell'incontro. Un arbitro indica il tabellone: «I punti arrivano dalle gare ufficiali, non dalle iscrizioni»."
        }
      ],
      "choices": [
        {
          "id": "points_event",
          "text": "Passo alla finestra disponibile.",
          "goto": "event_select"
        },
        {
          "id": "points_back",
          "text": "Torno all'area Masters.",
          "goto": "circuit_hub"
        }
      ]
    },
    "event_select": {
      "stitches": [
        {
          "id": "s1",
          "text": "Lo sportello annuncia la prossima finestra Masters. Sul cartellone compare un avversario già registrato; l'arbitro ricorda che soltanto il combattimento stabilirà il risultato."
        }
      ],
      "choices": [
        {
          "id": "event_register",
          "text": "Vado al desk di registrazione.",
          "goto": "register"
        },
        {
          "id": "event_opponent",
          "text": "Controllo prima il roster pubblico.",
          "goto": "opponent"
        }
      ]
    },
    "prep": {
      "stitches": [
        {
          "id": "s1",
          "text": "Nell'area di riscaldamento, alcuni allenatori provano cambi e coperture. Puoi dedicare qualche minuto a ragionare sulla pressione offensiva oppure sulla tenuta della squadra, senza sostituire l'allenamento vero."
        }
      ],
      "choices": [
        {
          "id": "prep_pressure",
          "text": "Mi concentro su pressione e condizioni.",
          "goto": "match_confirm",
          "effects": [
            {
              "type": "set_flag",
              "key": "m6_masters_prep_focus",
              "value": "pressure"
            }
          ]
        },
        {
          "id": "prep_switch",
          "text": "Rivedo cambi e coperture.",
          "goto": "match_confirm",
          "effects": [
            {
              "type": "set_flag",
              "key": "m6_masters_prep_focus",
              "value": "switch_depth"
            }
          ]
        }
      ]
    },
    "opponent": {
      "stitches": [
        {
          "id": "s1",
          "text": "Sul profilo pubblico di Kira Novak compaiono cinque Pokémon: Pidgeot, Raichu, Gyarados, Arcanine e Venusaur. Non c'è alcuna indicazione su chi scenderà in campo per primo."
        }
      ],
      "choices": [
        {
          "id": "opponent_register",
          "text": "Procedo alla registrazione.",
          "goto": "register"
        },
        {
          "id": "opponent_prep",
          "text": "Torno alla preparazione.",
          "goto": "prep"
        }
      ]
    },
    "register": {
      "stitches": [
        {
          "id": "s1",
          "text": "L'addetta verifica la tua iscrizione e sposta una scheda nella colonna degli incontri in programma. «Quando sarai pronto, presentati all'arbitro»."
        }
      ],
      "choices": [
        {
          "id": "register_match",
          "text": "Confermo la registrazione.",
          "goto": "match_confirm",
          "conditions": {
            "path": "world.flags.m6_masters_registered",
            "ne": true
          },
          "effects": [
            {
              "type": "set_flag",
              "key": "m6_masters_registered",
              "value": true
            }
          ]
        },
        {
          "id": "register_back",
          "text": "Torno all'area Masters.",
          "goto": "circuit_hub"
        }
      ]
    },
    "match_confirm": {
      "stitches": [
        {
          "id": "s1",
          "text": "L'arbitro controlla i partecipanti e il numero di Pokémon ammessi. «La gara comincia soltanto quando entrambi sarete pronti. Puoi ancora attendere»."
        }
      ],
      "choices": [
        {
          "id": "confirm_fight",
          "text": "Passo al combattimento.",
          "goto": "match_handoff",
          "conditions": {
            "all": [
              {
                "path": "world.flags.m6_masters_registered",
                "eq": true
              },
              {
                "path": "player.roster.length",
                "gte": 5
              },
              {
                "path": "world.flags.m6_masters_result",
                "exists": false
              }
            ]
          }
        },
        {
          "id": "confirm_back",
          "text": "Non combatto ancora.",
          "goto": "circuit_hub"
        }
      ]
    },
    "match_handoff": {
      "stitches": [
        {
          "id": "mh1",
          "text": "L'arbitro alza il braccio e chiama i due allenatori ai lati del campo. Il brusio degli spalti si abbassa mentre prepari la prima Poké Ball."
        }
      ],
      "choices": [
        {
          "id": "fight_masters_round",
          "text": "Combatto il Masters Circuit match.",
          "combat": {
            "encounterId": "M6_MASTERS_CIRCUIT_MATCH_01",
            "opponentRegistered": true,
            "competition": {
              "type": "official_match",
              "matchId": "M6_MASTERS_CIRCUIT_MATCH_01",
              "format": "Singles",
              "officialRosterSize": 5,
              "difficulty": "ELITE",
              "opponentTrainerId": "INT_MASTERS_KIRA_NOVAK"
            },
            "returnNodes": {
              "win": "match_win",
              "lose": "match_loss"
            },
            "opponentTrainerId": "INT_MASTERS_KIRA_NOVAK",
            "opponent": {
              "species": "Pidgeot",
              "level": 14,
              "abilityId": "keen-eye",
              "trainerId": "INT_MASTERS_KIRA_NOVAK"
            },
            "opponentBench": [
              {
                "species": "Raichu",
                "level": 14,
                "abilityId": "static",
                "trainerId": "INT_MASTERS_KIRA_NOVAK"
              },
              {
                "species": "Gyarados",
                "level": 14,
                "abilityId": "intimidate",
                "trainerId": "INT_MASTERS_KIRA_NOVAK"
              },
              {
                "species": "Arcanine",
                "level": 14,
                "abilityId": "intimidate",
                "trainerId": "INT_MASTERS_KIRA_NOVAK"
              },
              {
                "species": "Venusaur",
                "level": 14,
                "abilityId": "overgrow",
                "trainerId": "INT_MASTERS_KIRA_NOVAK"
              }
            ],
            "goto": "match_handoff"
          }
        }
      ]
    },
    "match_win": {
      "stitches": [
        {
          "id": "s1",
          "text": "L'arbitro segnala la fine dell'incontro a tuo favore. Kira richiama il suo ultimo Pokémon; sul tabellone compare il risultato ufficiale, mentre il pubblico applaude."
        }
      ],
      "choices": [
        {
          "id": "win_record",
          "text": "Rileggo il referto della vittoria.",
          "goto": "result_review",
          "effects": [
            {
              "type": "set_flag",
              "key": "m6_masters_result",
              "value": "win"
            },
            {
              "type": "set_flag",
              "key": "m6_masters_event_complete",
              "value": true
            }
          ]
        },
        {
          "id": "win_close",
          "text": "Chiudo subito la finestra con il risultato reale.",
          "goto": "circuit_close",
          "effects": [
            {
              "type": "set_flag",
              "key": "m6_masters_result",
              "value": "win"
            },
            {
              "type": "set_flag",
              "key": "m6_masters_event_complete",
              "value": true
            }
          ]
        }
      ]
    },
    "match_loss": {
      "stitches": [
        {
          "id": "s1",
          "text": "L'arbitro dichiara concluso l'incontro. Kira richiama il suo ultimo Pokémon e il tabellone registra la tua sconfitta. Il circuito prosegue con il match successivo."
        }
      ],
      "choices": [
        {
          "id": "loss_record",
          "text": "Rileggo il referto della sconfitta.",
          "goto": "result_review",
          "effects": [
            {
              "type": "set_flag",
              "key": "m6_masters_result",
              "value": "loss"
            },
            {
              "type": "set_flag",
              "key": "m6_masters_event_complete",
              "value": true
            }
          ]
        },
        {
          "id": "loss_close",
          "text": "Chiudo la finestra con il risultato reale.",
          "goto": "circuit_close",
          "effects": [
            {
              "type": "set_flag",
              "key": "m6_masters_result",
              "value": "loss"
            },
            {
              "type": "set_flag",
              "key": "m6_masters_event_complete",
              "value": true
            }
          ]
        }
      ]
    },
    "result_review": {
      "stitches": [
        {
          "id": "s1",
          "text": "Al banco risultati, un'impiegata verifica il referto appena arrivato dall'arena. «Lo troverai nella classifica aggiornata», dice, indicando il monitor."
        }
      ],
      "choices": [
        {
          "id": "result_close",
          "text": "Chiudo l'evento Masters.",
          "goto": "circuit_close"
        },
        {
          "id": "result_points",
          "text": "Rileggo la separazione dai punti narrativi.",
          "goto": "points_info"
        }
      ]
    },
    "circuit_close": {
      "stitches": [
        {
          "id": "s1",
          "text": "La finestra Masters si chiude alle tue spalle. Nell'atrio si preparano già altri incontri, e tra le voci degli allenatori circolano notizie sui partecipanti arrivati da lontano."
        }
      ],
      "choices": [
        {
          "id": "close_record",
          "text": "Il segnale Hidden Trajectories è disponibile: passo all'aggiornamento sui Five.",
          "goto": "m06-hidden-trajectories#trajectory_entry",
          "effects": [
            {
              "type": "set_flag",
              "key": "m6_masters_circuit_visited",
              "value": true
            }
          ],
          "conditions": {
            "path": "world.flags.a6_hidden_trajectories_available",
            "eq": true
          }
        },
        {
          "id": "close_hub",
          "text": "Resto nell'area Masters.",
          "goto": "circuit_hub"
        }
      ]
    },
    "route_link": {
      "stitches": [
        {
          "id": "rl1",
          "text": "Fuori dall'arena, le indicazioni riportano verso la stazione e le altre sedi del circuito. Puoi tornare sui tuoi passi prima di scegliere il prossimo impegno."
        }
      ],
      "choices": [
        {
          "id": "route_return",
          "text": "Torno al riepilogo del viaggio.",
          "goto": "m06-interregional-travel#arrival_close"
        }
      ]
    }
  }
}
