    "route_meaning": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il significato del beat cambia con WORLD_EXIT, ma campione, eliminato e Worlds Missed restano percorsi egualmente validi."
        }
      ],
      "choices": [
        {
          "id": "continue",
          "text": "Proseguo.",
          "goto": "commitment"
        },
        {
          "id": "review",
          "text": "Confronto questo punto con un altro aspetto della chiusura.",
          "goto": "complete"
        }
      ]
    },
    "commitment": {
      "stitches": [
        {
          "id": "s1",
          "text": "FRIEND_BEAT_12 si chiude soltanto quando primary contact, friend_ids, tipo e risultato sono persistenti."
        }
      ],
      "choices": [
        {
          "id": "commit_friend_beat",
          "text": "Chiudo FRIEND_BEAT_12 mantenendo aperto il futuro.",
          "goto": "complete",
          "conditions": {
            "all": [
              {
                "path": "world.flags.friend_beat_12_friend_id",
                "exists": true
              },
              {
                "path": "world.flags.friend_beat_12_friend_ids",
                "exists": true
              },
              {
                "path": "world.flags.friend_beat_12_type",
                "exists": true
              },
              {
                "path": "world.flags.friend_beat_12_result",
                "exists": true
              }
            ]
          },
          "effects": [
            {
              "type": "set_flag",
              "key": "friend_beat_12_complete",
              "value": true
            },
            {
              "type": "set_flag",
              "key": "m12_friend_beat_12_complete",
              "value": true
            }
          ]
        },
        {
          "id": "commit_review",
          "text": "Rileggo il record del gruppo prima di chiudere.",
          "goto": "group_record"
        }
      ]
    },
    "complete": {
      "stitches": [
        {
          "id": "s1",
          "text": "La chiusura relazionale è registrata. Gli amici continuano a esistere nel mondo dopo la main story."
        }
      ],
      "choices": [
        {
          "id": "to_postgame",
          "text": "Passo agli hook del postgame.",
          "goto": "m12-postgame-hooks#postgame_entry"
