        {
          "id": "review_friend_beat",
          "text": "Rileggo il significato della chiusura relazionale.",
          "goto": "route_meaning"
        }
      ]
    },
    "handoff": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il prossimo passo non è un altro boss: sono gli hook del postgame e le possibilità rimaste aperte nel save."
        }
      ],
      "choices": [
        {
          "id": "to_postgame",
          "text": "Apro gli hook rimasti nel save.",
          "goto": "m12-postgame-hooks#postgame_entry"
        },
        {
          "id": "review_open_future",
          "text": "Rileggo perché il futuro resta aperto.",
