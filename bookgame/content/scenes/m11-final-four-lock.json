{
  "schemaVersion": 1,
  "id": "m11-final-four-lock",
  "moduleId": "M11",
  "title": "M11_00 — Final Four Lock",
  "locationId": "world_knockout_hall",
  "entryNodeId": "final_four_entry",
  "conditions": {
    "all": [
      {
        "path": "world.flags.m10_complete",
        "eq": true
      },
      {
        "path": "world.flags.m11_unlocked",
        "eq": true
      },
      {
        "path": "world.flags.world_qf_won",
        "eq": true
      },
      {
        "path": "competition.world.top4Locked",
        "eq": true
      },
      {
        "path": "competition.world.knockout.qfResolved",
        "eq": true
      },
      {
        "path": "competition.world.knockout.playerAdvancedToSf",
        "eq": true
      }
    ]
  },
  "nodes": {
    "final_four_entry": {
      "stitches": [
        {
          "id": "s1",
          "text": "I quattro semifinalisti sono già sul grande tabellone. Ogni nome è arrivato qui vincendo un quarto di finale; le coppie non cambiano per rendere la storia più semplice."
        }
      ],
      "choices": [
        {
          "id": "final_four_entry_next",
          "text": "Proseguo verso Top4 Audit.",
          "goto": "top4_audit"
        },
        {
          "id": "final_four_entry_alt",
          "text": "Confronto questo punto con Lock Guard.",
          "goto": "lock_guard"
        },
        {
          "id": "final_four_entry_deep",
          "text": "Approfondisco Bracket Integrity.",
          "goto": "bracket_integrity"
        }
      ]
    },
    "top4_audit": {
      "stitches": [
        {
          "id": "s1",
          "text": "Controlli i quattro nomi e i due incontri. Il tuo compare in una sola semifinale, accanto all'avversario che dovrai davvero affrontare."
        }
      ],
      "choices": [
        {
          "id": "top4_audit_next",
          "text": "Proseguo verso Lock Guard.",
          "goto": "lock_guard"
        },
        {
          "id": "top4_audit_alt",
          "text": "Confronto questo punto con Bracket Integrity.",
          "goto": "bracket_integrity"
        },
        {
          "id": "top4_audit_deep",
          "text": "Approfondisco Player Slot.",
          "goto": "player_slot"
        }
      ]
    },
    "lock_guard": {
      "stitches": [
        {
          "id": "s1",
          "text": "Un addetto confronta gli accrediti con il tabellone dei quarti. Nessuno può prendere il posto di un semifinalista soltanto perché è più famoso."
        }
      ],
      "choices": [
        {
          "id": "lock_now",
          "text": "Apro WORLD_SF sul Top4 reale.",
          "goto": "lock_committed",
          "conditions": {
            "path": "competition.world.knockout.sfOpened",
            "ne": true
          },
          "effects": [
            {
              "type": "set_flag",
              "key": "m11_active",
              "value": true
            },
            {
              "type": "competition_world_sf_open",
              "eventId": "WORLD_SF"
            },
            {
              "type": "set_flag",
              "key": "m11_final_four_lock_complete",
              "value": true
            }
          ]
        },
        {
          "id": "lock_existing",
          "text": "WORLD_SF è già aperto: rileggo il lock persistente.",
          "goto": "lock_committed",
          "conditions": {
            "path": "competition.world.knockout.sfOpened",
            "eq": true
          },
          "effects": [
            {
              "type": "set_flag",
              "key": "m11_final_four_lock_complete",
              "value": true
            }
          ]
        },
        {
          "id": "lock_review",
          "text": "Prima rifaccio l'audit del Top4.",
          "goto": "top4_audit"
        }
      ]
    },
    "bracket_integrity": {
      "stitches": [
        {
          "id": "s1",
          "text": "Amici, rivali e campioni conosciuti occupano soltanto i posti guadagnati sul campo. Chi è stato eliminato segue il torneo da fuori."
        }
      ],
      "choices": [
        {
          "id": "bracket_integrity_next",
          "text": "Proseguo verso Player Slot.",
          "goto": "player_slot"
        },
        {
          "id": "bracket_integrity_alt",
          "text": "Confronto questo punto con Opponent Card.",
          "goto": "opponent_card"
        }
      ]
    },
    "player_slot": {
      "stitches": [
        {
          "id": "s1",
          "text": "La segnaletica indica il tuo campo e l'orario dell'incontro. La tua semifinale è fissata."
        }
      ],
      "choices": [
        {
          "id": "player_slot_next",
          "text": "Proseguo verso Opponent Card.",
          "goto": "opponent_card"
        },
        {
          "id": "player_slot_alt",
          "text": "Confronto questo punto con Rei Status.",
          "goto": "rei_status"
        }
      ]
    },
    "opponent_card": {
      "stitches": [
        {
          "id": "s1",
          "text": "Sul cartellone leggi il nome di {{competition.world.knockout.playerSfOpponent.name}}. Il materiale pubblico racconta alcune sue partite, non le decisioni che prenderà contro di te."
        }
      ],
      "choices": [
        {
          "id": "opponent_card_next",
          "text": "Proseguo verso Rei Status.",
          "goto": "rei_status"
        },
        {
          "id": "opponent_card_alt",
          "text": "Confronto questo punto con Friend Status.",
          "goto": "friend_status"
        }
      ]
    },
    "rei_status": {
      "stitches": [
        {
          "id": "s1",
          "text": "Cerchi Rei fra i quattro nomi. Se non c'è, ha già perso; se compare, deve ancora guadagnarsi la finale come tutti."
        }
      ],
      "choices": [
        {
          "id": "rei_status_next",
          "text": "Proseguo verso Friend Status.",
          "goto": "friend_status"
        },
        {
          "id": "rei_status_alt",
          "text": "Confronto questo punto con Schedule.",
          "goto": "schedule"
        }
      ]
    },
    "friend_status": {
      "stitches": [
        {
          "id": "s1",
          "text": "Cerchi anche gli amici. Qualcuno potrebbe essere qui, qualcuno fuori: una rivalità nata anni fa non sostituisce gli incontri previsti."
        }
      ],
      "choices": [
        {
          "id": "friend_status_next",
          "text": "Proseguo verso Schedule.",
          "goto": "schedule"
        },
        {
          "id": "friend_status_alt",
          "text": "Confronto questo punto con Persistence.",
          "goto": "persistence"
        }
      ]
    },
    "schedule": {
      "stitches": [
        {
          "id": "s1",
          "text": "Nei corridoi incroci allenatori e staff occupati. Non puoi contare di incontrare chiunque tu voglia prima di scendere in campo."
        }
      ],
      "choices": [
        {
          "id": "schedule_next",
          "text": "Proseguo verso Persistence.",
          "goto": "persistence"
        },
        {
          "id": "schedule_alt",
          "text": "Confronto questo punto con Lock Committed.",
          "goto": "lock_committed"
        }
      ]
    },
    "persistence": {
      "stitches": [
        {
          "id": "s1",
          "text": "Rivedi le condizioni della squadra dopo i quarti. I Pokémon non tornano in forma soltanto perché siete arrivati fra gli ultimi quattro."
        }
      ],
      "choices": [
        {
          "id": "persistence_next",
          "text": "Proseguo verso Lock Committed.",
          "goto": "lock_committed"
        },
        {
          "id": "persistence_alt",
          "text": "Confronto questo punto con Handoff.",
          "goto": "handoff"
        }
      ]
    },
    "lock_committed": {
      "stitches": [
        {
          "id": "s1",
          "text": "Gli addetti affiggono la versione definitiva degli incontri. La tua semifinale sarà contro {{competition.world.knockout.playerSfOpponent.name}}."
        }
      ],
      "choices": [
        {
          "id": "lock_committed_next",
          "text": "Proseguo verso Handoff.",
          "goto": "handoff"
        },
        {
          "id": "lock_committed_alt",
          "text": "Confronto questo punto con Complete.",
          "goto": "complete"
        }
      ]
    },
    "handoff": {
      "stitches": [
        {
          "id": "s1",
          "text": "Lasci il tabellone e ti dirigi verso la preparazione. Se incontrerai Rei, sarà lungo il suo percorso reale."
        }
      ],
      "choices": [
        {
          "id": "handoff_rei",
          "text": "Passo al thread di Rei.",
          "goto": "m11-rei-thread#rei_entry"
        },
        {
          "id": "handoff_review",
          "text": "Rileggo il bracket aperto.",
          "goto": "lock_committed"
        }
      ]
    },
    "complete": {
      "stitches": [
        {
          "id": "s1",
          "text": "Le due semifinali sono fissate. La prossima pagina verrà scritta sul campo."
        }
      ],
      "choices": [
        {
          "id": "complete_next",
          "text": "Proseguo verso Final Four Entry.",
          "goto": "final_four_entry"
        },
        {
          "id": "complete_alt",
          "text": "Confronto questo punto con Top4 Audit.",
          "goto": "top4_audit"
        }
      ]
    }
  }
}
