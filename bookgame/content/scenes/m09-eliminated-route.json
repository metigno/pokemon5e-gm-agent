{
  "schemaVersion": 1,
  "id": "m09-eliminated-route",
  "moduleId": "M09",
  "title": "M9_09 — Eliminated Route",
  "locationId": "world_village",
  "entryNodeId": "eliminated_entry",
  "conditions": {
    "all": [
      {
        "path": "world.flags.m9_group_resolution_complete",
        "eq": true
      },
      {
        "path": "competition.world.groupStage.resolved",
        "eq": true
      },
      {
        "path": "competition.world.groupStage.advanced",
        "eq": false
      },
      {
        "path": "world.flags.friend_beat_09_complete",
        "eq": true
      }
    ]
  },
  "nodes": {
    "eliminated_entry": {
      "stitches": [
        {
          "id": "s1",
          "text": "La classifica definitiva ti lascia fuori dai primi due del Gruppo {{competition.world.playerGroup}}. Gli ottavi si giocheranno senza di te."
        }
      ],
      "choices": [
        {
          "id": "entry_result",
          "text": "Guardo il risultato senza riscriverlo.",
          "goto": "result"
        },
        {
          "id": "entry_team",
          "text": "Controllo cosa resta alla squadra.",
          "goto": "team_state"
        },
        {
          "id": "entry_exit",
          "text": "Capisco cosa si apre dopo l'eliminazione.",
          "goto": "exit_policy"
        }
      ]
    },
    "result": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il tuo piazzamento è {{competition.world.groupStage.finalPosition}}. Le tre partite, i punti e gli eventuali spareggi rimangono sul tabellone."
        }
      ],
      "choices": [
        {
          "id": "result_emotion",
          "text": "Lascio spazio alla reazione personale.",
          "goto": "emotion"
        },
        {
          "id": "result_media",
          "text": "Affronto il lato pubblico dell'eliminazione.",
          "goto": "media"
        }
      ]
    },
    "emotion": {
      "stitches": [
        {
          "id": "s1",
          "text": "Puoi fissare la classifica, allontanarti subito o cercare qualcuno con cui parlare. Nessuna reazione viene decisa per te."
        }
      ],
      "choices": [
        {
          "id": "emotion_friends",
          "text": "Penso agli amici ancora dentro o fuori.",
          "goto": "friends"
        },
        {
          "id": "emotion_exit",
          "text": "Torno a ciò che viene dopo.",
          "goto": "exit_policy"
        }
      ]
    },
    "media": {
      "stitches": [
        {
          "id": "s1",
          "text": "Un cronista vuole un commento sull'eliminazione. Le sue domande non hanno il potere di spostarti fra i qualificati."
        }
      ],
      "choices": [
        {
          "id": "media_team",
          "text": "Proteggo prima lo stato della squadra.",
          "goto": "team_state"
        },
        {
          "id": "media_friends",
          "text": "Ricollego il risultato alle relazioni.",
          "goto": "friends"
        },
        {
          "id": "media_exit",
          "text": "Chiudo il rumore e penso al ritorno.",
          "goto": "exit_policy"
        }
      ]
    },
    "team_state": {
      "stitches": [
        {
          "id": "s1",
          "text": "Tre incontri hanno lasciato la squadra nelle condizioni che conosci. Prima del ritorno dovrai fare i conti anche con quelle conseguenze."
        }
      ],
      "choices": [
        {
          "id": "team_kaia",
          "text": "Rileggo il filo con Kaia senza trasformarla in colpevole.",
          "goto": "kaia"
        },
        {
          "id": "team_exit",
          "text": "Passo alla policy di uscita.",
          "goto": "exit_policy"
        }
      ]
    },
    "friends": {
      "stitches": [
        {
          "id": "s1",
          "text": "Gli amici ancora in gara continueranno senza aspettarti. Quelli usciti possono avere voglia di parlare, oppure no."
        }
      ],
      "choices": [
        {
          "id": "friends_kaia",
          "text": "Penso anche al percorso di Kaia.",
          "goto": "kaia"
        },
        {
          "id": "friends_exit",
          "text": "Passo a ciò che la mia eliminazione sblocca.",
          "goto": "exit_policy"
        }
      ]
    },
    "kaia": {
      "stitches": [
        {
          "id": "s1",
          "text": "Cerchi Kaia fra i risultati. Può essere passata oppure essere stata eliminata: conta la sua classifica, non il ruolo che ha avuto nella tua storia."
        }
      ],
      "choices": [
        {
          "id": "kaia_friends",
          "text": "Torno al filo degli amici.",
          "goto": "friends"
        },
        {
          "id": "kaia_exit",
          "text": "Passo alla route post-World.",
          "goto": "exit_policy"
        }
      ]
    },
    "exit_policy": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il torneo competitivo finisce per te, ma il viaggio continua. Potrai tornare ad Asteria e ritrovare le questioni lasciate aperte."
        }
      ],
      "choices": [
        {
          "id": "exit_handoff",
          "text": "Preparo l'handoff post-World.",
          "goto": "m12_handoff"
        },
        {
          "id": "exit_review",
          "text": "Prima rileggo il risultato finale.",
          "goto": "result"
        }
      ]
    },
    "m12_handoff": {
      "stitches": [
        {
          "id": "s1",
          "text": "Gli addetti ti indicano il percorso di uscita dal torneo e le partenze per Asteria. Là ti attende un mondo che è cambiato anche mentre eri qui."
        }
      ],
      "choices": [
        {
          "id": "handoff_commit",
          "text": "Registro l'handoff verso M12.",
          "goto": "commit"
        },
        {
          "id": "handoff_team",
          "text": "Controllo ancora la squadra prima di chiudere M9.",
          "goto": "team_state"
        }
      ]
    },
    "commit": {
      "stitches": [
        {
          "id": "s1",
          "text": "Riconsegni il pass per le fasi a eliminazione diretta. Nessuna firma cancella la posizione appena ottenuta."
        }
      ],
      "choices": [
        {
          "id": "commit_now",
          "text": "Chiudo M9 come eliminato.",
          "goto": "eliminated_complete",
          "effects": [
            {
              "type": "set_flag",
              "key": "m12_unlocked",
              "value": true
            },
            {
              "type": "set_flag",
              "key": "m9_eliminated_route_complete",
              "value": true
            },
            {
              "type": "set_flag",
              "key": "m9_complete",
              "value": true
            }
          ]
        },
        {
          "id": "commit_review",
          "text": "Prima rileggo la policy di uscita.",
          "goto": "exit_policy"
        },
        {
          "id": "commit_friends",
          "text": "Prima chiudo il filo relazionale.",
          "goto": "friends"
        }
      ]
    },
    "eliminated_complete": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il tuo gruppo è concluso e gli ottavi sono già riservati agli altri sedici. Per te comincia il viaggio di ritorno."
        }
      ],
      "choices": [
        {
          "id": "complete_review",
          "text": "Rileggo il riepilogo prima di lasciare il torneo.",
          "goto": "review"
        },
        {
          "id": "complete_hold",
          "text": "Resto nel Village senza modificare il risultato.",
          "goto": "hold"
        }
      ]
    },
    "review": {
      "stitches": [
        {
          "id": "s1",
          "text": "Puoi rivedere i tre referti, la classifica e le conversazioni avute al Village. Le sconfitte restano parte della tua carriera."
        }
      ],
      "choices": [
        {
          "id": "review_result",
          "text": "Rivedo la posizione finale.",
          "goto": "result"
        },
        {
          "id": "review_hold",
          "text": "Chiudo il riepilogo.",
          "goto": "hold"
        }
      ]
    },
    "hold": {
      "stitches": [
        {
          "id": "s1",
          "text": "Nessun incontro di consolazione è obbligatorio. Puoi lasciare lo stadio senza dover fingere che ci sia ancora una partita da giocare."
        }
      ],
      "choices": [
        {
          "id": "hold_review",
          "text": "Riapro il riepilogo se voglio controllare lo stato.",
          "goto": "review"
        },
        {
          "id": "hold_team",
          "text": "Controllo ancora la squadra persistente.",
          "goto": "team_state"
        }
      ]
    }
  }
}
