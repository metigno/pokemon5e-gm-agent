{
  "schemaVersion": 1,
  "id": "m11-rei-thread",
  "moduleId": "M11",
  "title": "M11_01 — Rei Thread",
  "locationId": "world_knockout_hall",
  "entryNodeId": "rei_entry",
  "conditions": {
    "all": [
      {
        "path": "world.flags.m11_final_four_lock_complete",
        "eq": true
      },
      {
        "path": "competition.world.knockout.sfOpened",
        "eq": true
      }
    ]
  },
  "nodes": {
    "rei_entry": {
      "stitches": [
        {
          "id": "s1",
          "text": "Rei compare fra i nomi che il pubblico segue con maggiore attenzione. Non cerca di occupare il centro della scena: osserva i combattimenti e controlla il comportamento dei propri Pokémon prima di parlare."
        }
      ],
      "choices": [
        {
          "id": "rei_entry_next",
          "text": "Proseguo verso Rei Status.",
          "goto": "rei_status"
        },
        {
          "id": "rei_entry_alt",
          "text": "Confronto questo punto con Schedule Gate.",
          "goto": "schedule_gate"
        },
        {
          "id": "rei_entry_deep",
          "text": "Approfondisco Public Context.",
          "goto": "public_context"
        }
      ]
    },
    "rei_status": {
      "stitches": [
        {
          "id": "s1",
          "text": "Alcuni cartelloni mostrano chi ha raggiunto le semifinali; altri riportano chi è già stato eliminato. Per sapere dove sia arrivato Rei basta consultare il tabellone, non ascoltare le leggende sul suo passato."
        }
      ],
      "choices": [
        {
          "id": "rei_status_next",
          "text": "Proseguo verso Schedule Gate.",
          "goto": "schedule_gate"
        },
        {
          "id": "rei_status_alt",
          "text": "Confronto questo punto con Public Context.",
          "goto": "public_context"
        },
        {
          "id": "rei_status_deep",
          "text": "Approfondisco Roster Read.",
          "goto": "roster_read"
        }
      ]
    },
    "schedule_gate": {
      "stitches": [
        {
          "id": "s1",
          "text": "Se Rei è ancora nel torneo e vi trovate nello stesso settore, puoi provare a scambiare due parole. Altrimenti rimangono le notizie pubbliche e la possibilità di lasciarlo ai suoi impegni."
        }
      ],
      "choices": [
        {
          "id": "schedule_meet",
          "text": "Rei è davvero qui: mi avvicino.",
          "goto": "conversation",
          "conditions": {
            "all": [
              {
                "path": "competition.world.knockout.reiInTop4",
                "eq": true
              },
              {
                "path": "npcs.Rei.schedule.present",
                "eq": true
              },
              {
                "path": "npcs.Rei.schedule.locationId",
                "eq": "world_knockout_hall"
              },
              {
                "path": "world.locationId",
                "eq": "world_knockout_hall"
              }
            ]
          },
          "effects": [
            {
              "type": "npc_state_set",
              "npcId": "Rei",
              "key": "introduced",
              "value": true
            },
            {
              "type": "npc_relationship_adjust",
              "npcId": "Rei",
              "delta": 1
            }
          ]
        },
        {
          "id": "schedule_public",
          "text": "Non forzo l'incontro: seguo il contesto pubblico.",
          "goto": "public_context"
        },
        {
          "id": "schedule_bracket",
          "text": "Prima controllo il suo posto nel bracket.",
          "goto": "bracket_truth"
        }
      ]
    },
    "public_context": {
      "stitches": [
        {
          "id": "s1",
          "text": "Le cronache ricordano il Samurott di Hisui e gli scambi rapidi che Rei usa per aprirsi spazio. Nessun articolo, però, svela in anticipo tutte le scelte che farà domani."
        }
      ],
      "choices": [
        {
          "id": "public_context_next",
          "text": "Proseguo verso Roster Read.",
          "goto": "roster_read"
        },
        {
          "id": "public_context_alt",
          "text": "Confronto questo punto con Relationship.",
          "goto": "relationship"
        },
        {
          "id": "public_context_deep",
          "text": "Approfondisco Pressure.",
          "goto": "pressure"
        }
      ]
    },
    "roster_read": {
      "stitches": [
        {
          "id": "s1",
          "text": "Rei non ha cambiato i propri compagni soltanto per incrociare il tuo cammino. Li conosce da tempo; osservandoli, capisci quanto gli interessi farli agire insieme senza sprecare un'apertura."
        }
      ],
      "choices": [
        {
          "id": "roster_read_next",
          "text": "Proseguo verso Relationship.",
          "goto": "relationship"
        },
        {
          "id": "roster_read_alt",
          "text": "Confronto questo punto con Pressure.",
          "goto": "pressure"
        }
      ]
    },
    "relationship": {
      "stitches": [
        {
          "id": "s1",
          "text": "Rei ascolta la tua osservazione prima di rispondere. Se avete già parlato, può ricordare il tono del vostro ultimo incontro; non ti promette favori sul campo."
        }
      ],
      "choices": [
        {
          "id": "relationship_next",
          "text": "Proseguo verso Pressure.",
          "goto": "pressure"
        },
        {
          "id": "relationship_alt",
          "text": "Confronto questo punto con Bracket Truth.",
          "goto": "bracket_truth"
        }
      ]
    },
    "pressure": {
      "stitches": [
        {
          "id": "s1",
          "text": "Davanti all'arena Rei resta pratico. «Quando cambia il terreno, cambia il modo di entrarci.» Non si concede una posa eroica: torna subito a controllare i propri Pokémon."
        }
      ],
      "choices": [
        {
          "id": "pressure_next",
          "text": "Proseguo verso Bracket Truth.",
          "goto": "bracket_truth"
        },
        {
          "id": "pressure_alt",
          "text": "Confronto questo punto con No Plot Armor.",
          "goto": "no_plot_armor"
        }
      ]
    },
    "bracket_truth": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il tabellone mostra in quale semifinale è inserito Rei, se è ancora in gara. Potreste affrontarvi, ritrovarvi in un'altra fase oppure non combattere affatto."
        }
      ],
      "choices": [
        {
          "id": "bracket_truth_next",
          "text": "Proseguo verso No Plot Armor.",
          "goto": "no_plot_armor"
        },
        {
          "id": "bracket_truth_alt",
          "text": "Confronto questo punto con Prior Callback.",
          "goto": "prior_callback"
        }
      ]
    },
    "no_plot_armor": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il nome di Rei attira gli sguardi, non tiene in piedi un Pokémon sconfitto. Qui anche un favorito deve guadagnare ogni turno."
        }
      ],
      "choices": [
        {
          "id": "no_plot_armor_next",
          "text": "Proseguo verso Prior Callback.",
          "goto": "prior_callback"
        },
        {
          "id": "no_plot_armor_alt",
          "text": "Confronto questo punto con Conversation.",
          "goto": "conversation"
        }
      ]
    },
    "prior_callback": {
      "stitches": [
        {
          "id": "s1",
          "text": "Se hai già incontrato Rei, qualche parola può suonare familiare. Non è un modo per cancellare ciò che avete fatto o per fingere un'intimità che non c'è stata."
        }
      ],
      "choices": [
        {
          "id": "prior_callback_next",
          "text": "Proseguo verso Conversation.",
          "goto": "conversation"
        },
        {
          "id": "prior_callback_alt",
          "text": "Confronto questo punto con Remote Context.",
          "goto": "remote_context"
        }
      ]
    },
    "conversation": {
      "stitches": [
        {
          "id": "s1",
          "text": "«Non cerco sempre il colpo più forte», dice Rei, guardando le postazioni. «Mi interessa capire quale mossa mi lascerà giocare anche quella dopo.» Poi aspetta davvero la tua risposta."
        }
      ],
      "choices": [
        {
          "id": "conversation_next",
          "text": "Proseguo verso Remote Context.",
          "goto": "remote_context"
        },
        {
          "id": "conversation_alt",
          "text": "Confronto questo punto con Commit.",
          "goto": "commit"
        }
      ]
    },
    "remote_context": {
      "stitches": [
        {
          "id": "s1",
          "text": "Se non potete incontrarvi, ricevi soltanto le informazioni che circolano fra staff, stampa e pubblico. Rei non compare davanti a te per comodità del racconto."
        }
      ],
      "choices": [
        {
          "id": "remote_context_next",
          "text": "Proseguo verso Commit.",
          "goto": "commit"
        },
        {
          "id": "remote_context_alt",
          "text": "Confronto questo punto con Handoff.",
          "goto": "handoff"
        }
      ]
    },
    "commit": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il contatto termina e Rei torna ai suoi impegni. Nessuna conversazione prende il posto della semifinale."
        }
      ],
      "choices": [
        {
          "id": "commit_now",
          "text": "Chiudo il thread di Rei senza alterare WORLD_SF.",
          "goto": "handoff",
          "effects": [
            {
              "type": "set_flag",
              "key": "m11_rei_thread_complete",
              "value": true
            }
          ]
        },
        {
          "id": "commit_review",
          "text": "Rivedo la verità del bracket.",
          "goto": "bracket_truth"
        }
      ]
    },
    "handoff": {
      "stitches": [
        {
          "id": "s1",
          "text": "Davanti a te resta il prossimo avversario indicato dal tabellone, con le difficoltà che ti sei portato fin qui."
        }
      ],
      "choices": [
        {
          "id": "handoff_prep",
          "text": "Passo alla preparazione della semifinale.",
          "goto": "m11-sf-prep#prep_entry"
        },
        {
          "id": "handoff_rei",
          "text": "Rileggo il thread di Rei.",
          "goto": "complete"
        }
      ]
    },
    "complete": {
      "stitches": [
        {
          "id": "s1",
          "text": "Di Rei rimane ciò che hai potuto davvero vedere o sentire. Il torneo non si ferma per il suo nome."
        }
      ],
      "choices": [
        {
          "id": "complete_next",
          "text": "Proseguo verso Rei Entry.",
          "goto": "rei_entry"
        },
        {
          "id": "complete_alt",
          "text": "Confronto questo punto con Rei Status.",
          "goto": "rei_status"
        }
      ]
    }
  }
}
