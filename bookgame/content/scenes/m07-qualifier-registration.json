{
  "schemaVersion": 1,
  "id": "m07-qualifier-registration",
  "moduleId": "M07",
  "title": "M7_06 — Qualifier Registration",
  "locationId": "meridiana_grand_hall",
  "entryNodeId": "registration_entry",
  "conditions": {
    "all": [
      {
        "path": "world.flags.m6_complete",
        "eq": true
      },
      {
        "path": "world.flags.m07_unlocked",
        "eq": true
      },
      {
        "path": "world.flags.m7_active",
        "eq": true
      },
      {
        "path": "competition.rank",
        "eq": "S"
      },
      {
        "path": "world.flags.friend_beat_07_complete",
        "eq": true
      }
    ]
  },
  "nodes": {
    "registration_entry": {
      "stitches": [
        {
          "id": "s1",
          "text": "Allo sportello del Grand Hall, l'addetta controlla la tua licenza Rank S. Poi indica l'orologio e il modulo con i sei Pokémon da presentare."
        }
      ],
      "choices": [
        {
          "id": "entry_eligibility",
          "text": "Controllo l'eligibility corrente.",
          "goto": "eligibility"
        },
        {
          "id": "entry_rules",
          "text": "Rileggo formato e vincoli.",
          "goto": "rules"
        },
        {
          "id": "entry_defer",
          "text": "Non mi registro ancora.",
          "goto": "defer"
        }
      ]
    },
    "eligibility": {
      "stitches": [
        {
          "id": "s1",
          "text": "Sul banco sono allineati tre documenti: licenza, orario di iscrizione e lista della squadra. «Devono essere tutti in regola», precisa l'addetta."
        }
      ],
      "choices": [
        {
          "id": "eligibility_rank",
          "text": "Verifico il Rank.",
          "goto": "rank_guard"
        },
        {
          "id": "eligibility_roster",
          "text": "Verifico l'Official Six.",
          "goto": "roster_review"
        },
        {
          "id": "eligibility_window",
          "text": "Verifico la finestra del Qualifier.",
          "goto": "schedule_window"
        }
      ]
    },
    "rank_guard": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il lettore riconosce la tua licenza Rank S. L'addetta annuisce, ma prima del timbro deve controllare gli altri documenti."
        }
      ],
      "choices": [
        {
          "id": "rank_roster",
          "text": "Passo al roster.",
          "goto": "roster_review"
        },
        {
          "id": "rank_rules",
          "text": "Torno alle regole.",
          "goto": "rules"
        }
      ]
    },
    "roster_review": {
      "stitches": [
        {
          "id": "s1",
          "text": "L'addetta confronta la lista con i Pokémon disponibili. «Non posso accettare caselle vuote né sostituire chi non può presentarsi.»"
        }
      ],
      "choices": [
        {
          "id": "roster_ready",
          "text": "Ho almeno sei Pokémon: passo alla verifica finale.",
          "goto": "six_ready",
          "conditions": {
            "path": "player.roster.length",
            "gte": 6
          }
        },
        {
          "id": "roster_missing",
          "text": "Non ho ancora sei Pokémon: non posso registrarmi.",
          "goto": "six_not_ready",
          "conditions": {
            "path": "player.roster.length",
            "lt": 6
          }
        },
        {
          "id": "roster_back",
          "text": "Torno all'eligibility.",
          "goto": "eligibility"
        }
      ]
    },
    "six_ready": {
      "stitches": [
        {
          "id": "s1",
          "text": "La lista contiene sei Pokémon. «Dovranno essere disponibili anche quando vi chiameranno in campo», ricorda l'addetta."
        }
      ],
      "choices": [
        {
          "id": "six_desk",
          "text": "Vado al desk di registrazione.",
          "goto": "registration_desk"
        },
        {
          "id": "six_constraints",
          "text": "Prima controllo agenda e obblighi.",
          "goto": "media_constraints"
        }
      ]
    },
    "six_not_ready": {
      "stitches": [
        {
          "id": "s1",
          "text": "L'addetta ti restituisce il modulo. «Torna quando puoi presentare tutti e sei i Pokémon. Non posso fare eccezioni.»"
        }
      ],
      "choices": [
        {
          "id": "missing_prep",
          "text": "Torno alla preparazione professionale.",
          "goto": "m07-pro-preparation#prep_hub"
        },
        {
          "id": "missing_hub",
          "text": "Torno alla piazza di Meridiana.",
          "goto": "m07-meridiana-arrival#city_hub"
        }
      ]
    },
    "schedule_window": {
      "stitches": [
        {
          "id": "s1",
          "text": "Sul monitor scorrono gli orari della finestra di iscrizione. Nessun posto al Mondiale compare ancora accanto al tuo nome."
        }
      ],
      "choices": [
        {
          "id": "window_open",
          "text": "La finestra è aperta: continuo.",
          "goto": "registration_desk",
          "conditions": {
            "path": "world.flags.a7_world_qualifier_available",
            "eq": true
          }
        },
        {
          "id": "window_defer",
          "text": "Non forzo una finestra non disponibile.",
          "goto": "defer"
        }
      ]
    },
    "rules": {
      "stitches": [
        {
          "id": "s1",
          "text": "«Incontri singoli, sei Pokémon per squadra, avversari del circuito Elite», spiega l'addetta. «Il Rank permette di iscriversi, non di saltare gli incontri.»"
        }
      ],
      "choices": [
        {
          "id": "rules_history",
          "text": "Controllo come verrà conservata la history.",
          "goto": "history_guard"
        },
        {
          "id": "rules_eligibility",
          "text": "Torno all'eligibility.",
          "goto": "eligibility"
        }
      ]
    },
    "registration_desk": {
      "stitches": [
        {
          "id": "s1",
          "text": "Dietro il vetro, l'addetta apre la scheda della competizione. «Posso registrarti per questa edizione. Il risultato si deciderà sul campo.»"
        }
      ],
      "choices": [
        {
          "id": "desk_confirm",
          "text": "Procedo alla conferma.",
          "goto": "confirmation",
          "conditions": {
            "all": [
              {
                "path": "world.flags.a7_world_qualifier_available",
                "eq": true
              },
              {
                "path": "player.roster.length",
                "gte": 6
              }
            ]
          }
        },
        {
          "id": "desk_friend",
          "text": "Rivedo il Friend Beat prima di firmare.",
          "goto": "friend_callback"
        },
        {
          "id": "desk_defer",
          "text": "Rimando la firma.",
          "goto": "defer"
        }
      ]
    },
    "confirmation": {
      "stitches": [
        {
          "id": "s1",
          "text": "La penna è pronta accanto al modulo. L'addetta ti lascia il tempo di controllare gli orari prima di chiederti la firma."
        }
      ],
      "choices": [
        {
          "id": "confirm_register",
          "text": "Confermo la registrazione.",
          "goto": "registered",
          "conditions": {
            "path": "world.flags.m7_qualifier_registered",
            "ne": true
          },
          "effects": [
            {
              "type": "set_flag",
              "key": "m7_qualifier_registered",
              "value": true
            },
            {
              "type": "set_flag",
              "key": "m7_qualifier_registration_complete",
              "value": true
            }
          ]
        },
        {
          "id": "confirm_back",
          "text": "Non firmo ancora.",
          "goto": "registration_desk"
        }
      ]
    },
    "registered": {
      "stitches": [
        {
          "id": "s1",
          "text": "L'addetta appone il timbro e ti consegna una ricevuta. Sul tabellone compare la tua iscrizione; le caselle dei risultati sono ancora vuote."
        }
      ],
      "choices": [
        {
          "id": "registered_bracket",
          "text": "Passo al World Qualifier.",
          "goto": "ready_to_bracket"
        },
        {
          "id": "registered_cynthia",
          "text": "Rileggo il benchmark di Cynthia.",
          "goto": "cynthia_callback"
        },
        {
          "id": "registered_rules",
          "text": "Chiudo il desk mantenendo la registrazione persistente.",
          "goto": "close"
        }
      ]
    },
    "defer": {
      "stitches": [
        {
          "id": "s1",
          "text": "«Puoi tornare più tardi», dice l'addetta, indicando l'orario di chiusura. Dietro di te la fila continua ad avanzare."
        }
      ],
      "choices": [
        {
          "id": "defer_hour",
          "text": "Aspetto un'ora e ricontrollo.",
          "goto": "registration_entry",
          "timeCostMinutes": 60
        },
        {
          "id": "defer_hub",
          "text": "Torno alla piazza di Meridiana.",
          "goto": "m07-meridiana-arrival#city_hub"
        }
      ]
    },
    "friend_callback": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il telefono vibra con un messaggio di un amico. L'addetta richiama il prossimo allenatore: ognuno deve presentare i propri documenti."
        }
      ],
      "choices": [
        {
          "id": "friend_desk",
          "text": "Torno al desk.",
          "goto": "registration_desk"
        },
        {
          "id": "friend_history",
          "text": "Rivedo la separazione fra relazioni e history competitiva.",
          "goto": "history_guard"
        }
      ]
    },
    "cynthia_callback": {
      "stitches": [
        {
          "id": "s1",
          "text": "Ripensi al calendario che Cynthia osservava con attenzione. Qui, però, sono i documenti e la disponibilità della squadra a decidere l'accesso."
        }
      ],
      "choices": [
        {
          "id": "cynthia_bracket",
          "text": "Passo alla preparazione del bracket.",
          "goto": "ready_to_bracket"
        },
        {
          "id": "cynthia_desk",
          "text": "Torno al desk.",
          "goto": "registration_desk"
        }
      ]
    },
    "media_constraints": {
      "stitches": [
        {
          "id": "s1",
          "text": "Un agente ti ricorda un'intervista già fissata. L'addetta indica l'orologio: «Le iscrizioni chiudono all'ora segnata, con o senza telecamere.»"
        }
      ],
      "choices": [
        {
          "id": "media_desk",
          "text": "Accetto i vincoli e torno al desk.",
          "goto": "registration_desk"
        },
        {
          "id": "media_hub",
          "text": "Rivedo il distretto media.",
          "goto": "m07-media-sponsor#media_hub"
        }
      ]
    },
    "history_guard": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il tabellone elenca gli incontri ufficiali e gli spazi per i risultati. Per ora, sotto il tuo nome non compare ancora alcun punteggio."
        }
      ],
      "choices": [
        {
          "id": "history_rules",
          "text": "Torno alle regole.",
          "goto": "rules"
        },
        {
          "id": "history_desk",
          "text": "Torno al desk.",
          "goto": "registration_desk"
        }
      ]
    },
    "ready_to_bracket": {
      "stitches": [
        {
          "id": "s1",
          "text": "La ricevuta è nella tua mano. Oltre le porte, gli addetti stanno preparando il tabellone. La qualificazione deve ancora essere conquistata."
        }
      ],
      "choices": [
        {
          "id": "ready_start",
          "text": "Entro nel World Qualifier.",
          "goto": "m07-world-qualifier#qualifier_entry",
          "conditions": {
            "path": "world.flags.m7_qualifier_registered",
            "eq": true
          }
        },
        {
          "id": "ready_review",
          "text": "Rivedo la registrazione.",
          "goto": "registered"
        }
      ]
    },
    "close": {
      "stitches": [
        {
          "id": "s1",
          "text": "Riponi la ricevuta. Quando tornerai allo sportello, la tua iscrizione sarà già presente."
        }
      ],
      "choices": [
        {
          "id": "close_registered",
          "text": "Torno allo stato registrato.",
          "goto": "registered"
        }
      ]
    }
  }
}
