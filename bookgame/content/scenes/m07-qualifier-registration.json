{
  "schemaVersion": 1,
  "id": "m07-qualifier-registration",
  "moduleId": "M07",
  "title": "M7_06 — Qualifier Registration",
  "locationId": "meridiana_grand_hall",
  "entryNodeId": "registration_entry",
  "conditions": {
    "all": [
      {
        "path": "world.flags.m6_complete",
        "eq": true
      },
      {
        "path": "world.flags.m07_unlocked",
        "eq": true
      },
      {
        "path": "world.flags.m7_active",
        "eq": true
      },
      {
        "path": "competition.rank",
        "eq": "S"
      },
      {
        "path": "world.flags.friend_beat_07_complete",
        "eq": true
      }
    ]
  },
  "nodes": {
    "registration_entry": {
      "stitches": [
        {
          "id": "s1",
          "text": "Davanti al banco del Qualifier una fila di allenatori attende l'accredito. La segretaria controlla licenze, iscrizioni e squadre una persona alla volta."
        }
      ],
      "choices": [
        {
          "id": "entry_eligibility",
          "text": "Controllo l'eligibility corrente.",
          "goto": "eligibility"
        },
        {
          "id": "entry_rules",
          "text": "Rileggo formato e vincoli.",
          "goto": "rules"
        },
        {
          "id": "entry_defer",
          "text": "Non mi registro ancora.",
          "goto": "defer"
        }
      ]
    },
    "eligibility": {
      "stitches": [
        {
          "id": "s1",
          "text": "«Rank S, finestra d'iscrizione aperta e sei Pokémon idonei», ripete l'addetta indicando i requisiti. Non basta soddisfarne soltanto uno."
        }
      ],
      "choices": [
        {
          "id": "eligibility_rank",
          "text": "Verifico il Rank.",
          "goto": "rank_guard"
        },
        {
          "id": "eligibility_roster",
          "text": "Verifico l'Official Six.",
          "goto": "roster_review"
        },
        {
          "id": "eligibility_window",
          "text": "Verifico la finestra del Qualifier.",
          "goto": "schedule_window"
        }
      ]
    },
    "rank_guard": {
      "stitches": [
        {
          "id": "s1",
          "text": "La tua tessera Rank S supera il primo controllo. «Adesso vediamo il resto», aggiunge la segretaria."
        }
      ],
      "choices": [
        {
          "id": "rank_roster",
          "text": "Passo al roster.",
          "goto": "roster_review"
        },
        {
          "id": "rank_rules",
          "text": "Torno alle regole.",
          "goto": "rules"
        }
      ]
    },
    "roster_review": {
      "stitches": [
        {
          "id": "s1",
          "text": "Gli addetti contano i Pokémon disponibili. Se ne manca uno, nessun modulo da firmare può sostituirlo."
        }
      ],
      "choices": [
        {
          "id": "roster_ready",
          "text": "Ho almeno sei Pokémon: passo alla verifica finale.",
          "goto": "six_ready",
          "conditions": {
            "path": "player.roster.length",
            "gte": 6
          }
        },
        {
          "id": "roster_missing",
          "text": "Non ho ancora sei Pokémon: non posso registrarmi.",
          "goto": "six_not_ready",
          "conditions": {
            "path": "player.roster.length",
            "lt": 6
          }
        },
        {
          "id": "roster_back",
          "text": "Torno all'eligibility.",
          "goto": "eligibility"
        }
      ]
    },
    "six_ready": {
      "stitches": [
        {
          "id": "s1",
          "text": "Hai sei Pokémon idonei per presentare domanda. Le loro condizioni effettive continueranno a contare quando scenderai in campo."
        }
      ],
      "choices": [
        {
          "id": "six_desk",
          "text": "Vado al desk di registrazione.",
          "goto": "registration_desk"
        },
        {
          "id": "six_constraints",
          "text": "Prima controllo agenda e obblighi.",
          "goto": "media_constraints"
        }
      ]
    },
    "six_not_ready": {
      "stitches": [
        {
          "id": "s1",
          "text": "«Non posso accettare una squadra incompleta.» L'addetta ti indica l'uscita verso la zona preparazione e i servizi disponibili."
        }
      ],
      "choices": [
        {
          "id": "missing_prep",
          "text": "Torno alla preparazione professionale.",
          "goto": "m07-pro-preparation#prep_hub"
        },
        {
          "id": "missing_hub",
          "text": "Torno alla piazza di Meridiana.",
          "goto": "m07-meridiana-arrival#city_hub"
        }
      ]
    },
    "schedule_window": {
      "stitches": [
        {
          "id": "s1",
          "text": "Un orologio sopra lo sportello mostra la scadenza delle registrazioni. Il tempo non rimarrà fermo finché deciderai."
        }
      ],
      "choices": [
        {
          "id": "window_open",
          "text": "La finestra è aperta: continuo.",
          "goto": "registration_desk",
          "conditions": {
            "path": "world.flags.a7_world_qualifier_available",
            "eq": true
          }
        },
        {
          "id": "window_defer",
          "text": "Non forzo una finestra non disponibile.",
          "goto": "defer"
        }
      ]
    },
    "rules": {
      "stitches": [
        {
          "id": "s1",
          "text": "L'ufficiale ti consegna il regolamento: Singles, sei Pokémon registrati, avversari di fascia Elite. Il titolo mondiale si conquista in un'altra sede."
        }
      ],
      "choices": [
        {
          "id": "rules_history",
          "text": "Controllo come verrà conservata la history.",
          "goto": "history_guard"
        },
        {
          "id": "rules_eligibility",
          "text": "Torno all'eligibility.",
          "goto": "eligibility"
        }
      ]
    },
    "registration_desk": {
      "stitches": [
        {
          "id": "s1",
          "text": "La segretaria apre il registro dell'unica selezione a cui puoi iscriverti. «Firmare significa partecipare, non vincere.»"
        }
      ],
      "choices": [
        {
          "id": "desk_confirm",
          "text": "Procedo alla conferma.",
          "goto": "confirmation",
          "conditions": {
            "all": [
              {
                "path": "world.flags.a7_world_qualifier_available",
                "eq": true
              },
              {
                "path": "player.roster.length",
                "gte": 6
              }
            ]
          }
        },
        {
          "id": "desk_friend",
          "text": "Rivedo il Friend Beat prima di firmare.",
          "goto": "friend_callback"
        },
        {
          "id": "desk_defer",
          "text": "Rimando la firma.",
          "goto": "defer"
        }
      ]
    },
    "confirmation": {
      "stitches": [
        {
          "id": "s1",
          "text": "Prima di apporre la firma controlli il nome e l'appuntamento. L'arbitro verificherà ancora la squadra quando inizierà il combattimento."
        }
      ],
      "choices": [
        {
          "id": "confirm_register",
          "text": "Confermo la registrazione.",
          "goto": "registered",
          "conditions": {
            "path": "world.flags.m7_qualifier_registered",
            "ne": true
          },
          "effects": [
            {
              "type": "set_flag",
              "key": "m7_qualifier_registered",
              "value": true
            },
            {
              "type": "set_flag",
              "key": "m7_qualifier_registration_complete",
              "value": true
            }
          ]
        },
        {
          "id": "confirm_back",
          "text": "Non firmo ancora.",
          "goto": "registration_desk"
        }
      ]
    },
    "registered": {
      "stitches": [
        {
          "id": "s1",
          "text": "L'addetta timbra l'accredito. Hai un posto nella selezione; ora devi ancora superare gli avversari."
        }
      ],
      "choices": [
        {
          "id": "registered_bracket",
          "text": "Passo al World Qualifier.",
          "goto": "ready_to_bracket"
        },
        {
          "id": "registered_cynthia",
          "text": "Rileggo il benchmark di Cynthia.",
          "goto": "cynthia_callback"
        },
        {
          "id": "registered_rules",
          "text": "Chiudo il desk mantenendo la registrazione persistente.",
          "goto": "close"
        }
      ]
    },
    "defer": {
      "stitches": [
        {
          "id": "s1",
          "text": "Ti allontani senza completare l'iscrizione. La fila continua a muoversi e la scadenza si avvicina."
        }
      ],
      "choices": [
        {
          "id": "defer_hour",
          "text": "Aspetto un'ora e ricontrollo.",
          "goto": "registration_entry",
          "timeCostMinutes": 60
        },
        {
          "id": "defer_hub",
          "text": "Torno alla piazza di Meridiana.",
          "goto": "m07-meridiana-arrival#city_hub"
        }
      ]
    },
    "friend_callback": {
      "stitches": [
        {
          "id": "s1",
          "text": "Un messaggio di uno degli amici può arrivare mentre aspetti. Il suo incoraggiamento non può prestarti una licenza o un sesto Pokémon."
        }
      ],
      "choices": [
        {
          "id": "friend_desk",
          "text": "Torno al desk.",
          "goto": "registration_desk"
        },
        {
          "id": "friend_history",
          "text": "Rivedo la separazione fra relazioni e history competitiva.",
          "goto": "history_guard"
        }
      ]
    },
    "cynthia_callback": {
      "stitches": [
        {
          "id": "s1",
          "text": "Ripensi al consiglio di Cynthia mentre controlli la squadra. Anche lei dovette imparare a prepararsi, non a saltare i requisiti."
        }
      ],
      "choices": [
        {
          "id": "cynthia_bracket",
          "text": "Passo alla preparazione del bracket.",
          "goto": "ready_to_bracket"
        },
        {
          "id": "cynthia_desk",
          "text": "Torno al desk.",
          "goto": "registration_desk"
        }
      ]
    },
    "media_constraints": {
      "stitches": [
        {
          "id": "s1",
          "text": "Un addetto di uno sponsor ti cerca per un'intervista. Il tuo posto in fila dipende comunque dalle stesse regole degli altri."
        }
      ],
      "choices": [
        {
          "id": "media_desk",
          "text": "Accetto i vincoli e torno al desk.",
          "goto": "registration_desk"
        },
        {
          "id": "media_hub",
          "text": "Rivedo il distretto media.",
          "goto": "m07-media-sponsor#media_hub"
        }
      ]
    },
    "history_guard": {
      "stitches": [
        {
          "id": "s1",
          "text": "La segretaria indica i referti ufficiali. Ogni risultato dovrà essere firmato dagli arbitri, non raccontato prima che esista."
        }
      ],
      "choices": [
        {
          "id": "history_rules",
          "text": "Torno alle regole.",
          "goto": "rules"
        },
        {
          "id": "history_desk",
          "text": "Torno al desk.",
          "goto": "registration_desk"
        }
      ]
    },
    "ready_to_bracket": {
      "stitches": [
        {
          "id": "s1",
          "text": "La registrazione è completata. Davanti a te ci sono due possibili incontri da vincere, non una qualificazione già assegnata."
        }
      ],
      "choices": [
        {
          "id": "ready_start",
          "text": "Entro nel World Qualifier.",
          "goto": "m07-world-qualifier#qualifier_entry",
          "conditions": {
            "path": "world.flags.m7_qualifier_registered",
            "eq": true
          }
        },
        {
          "id": "ready_review",
          "text": "Rivedo la registrazione.",
          "goto": "registered"
        }
      ]
    },
    "close": {
      "stitches": [
        {
          "id": "s1",
          "text": "Ricevi il numero di gara e lasci il banco. Il primo avversario ti attende al momento previsto."
        }
      ],
      "choices": [
        {
          "id": "close_registered",
          "text": "Torno allo stato registrato.",
          "goto": "registered"
        }
      ]
    }
  }
}
