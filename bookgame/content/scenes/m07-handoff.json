{
  "schemaVersion": 1,
  "id": "m07-handoff",
  "moduleId": "M07",
  "title": "M7_00 — Rank S Handoff",
  "locationId": "first_lighthouse_ruins",
  "entryNodeId": "m07_entry",
  "conditions": {
    "all": [
      {
        "path": "world.flags.m6_complete",
        "eq": true
      },
      {
        "path": "world.flags.m07_unlocked",
        "eq": true
      },
      {
        "path": "competition.rank",
        "eq": "S"
      }
    ]
  },
  "nodes": {
    "m07_entry": {
      "stitches": [
        {
          "id": "s1",
          "text": "La licenza Rank S ti apre le porte del circuito professionale. Sul biglietto per Meridiana è stampata la data di partenza; il Mondiale, per ora, è soltanto una possibilità."
        }
      ],
      "choices": [
        {
          "id": "activate_m7",
          "text": "Attivo questa tappa senza cambiare il risultato del cutoff.",
          "goto": "rank_s_band",
          "conditions": {
            "path": "world.flags.m7_active",
            "ne": true
          },
          "effects": [
            {
              "type": "set_flag",
              "key": "m7_active",
              "value": true
            }
          ]
        },
        {
          "id": "review_active_m7",
          "text": "questa tappa è già attivo: rivedo la fascia Candidate Mondiale.",
          "goto": "rank_s_band",
          "conditions": {
            "path": "world.flags.m7_active",
            "eq": true
          }
        }
      ]
    },
    "rank_s_band": {
      "stitches": [
        {
          "id": "s1",
          "text": "Un addetto controlla la tua licenza e ti indica gli sportelli riservati ai professionisti. «Per il Mondiale dovrai comunque passare dalle qualificazioni.»"
        }
      ],
      "choices": [
        {
          "id": "band_candidate",
          "text": "Controllo cosa significa essere Candidate Mondiale.",
          "goto": "candidate_status"
        },
        {
          "id": "band_cutoff",
          "text": "Rivedo lo snapshot del World Cutoff.",
          "goto": "cutoff_state"
        },
        {
          "id": "band_meridiana",
          "text": "Valuto l'accesso a Meridiana.",
          "goto": "meridiana_preview"
        },
        {
          "id": "band_defer",
          "text": "Rimando la partenza e lascio avanzare il mondo.",
          "goto": "defer"
        }
      ]
    },
    "carryover": {
      "stitches": [
        {
          "id": "s1",
          "text": "Prima di partire controlli la squadra, lo zaino e le note degli incontri precedenti. Ogni risultato e ogni fatica del viaggio sono ancora con te."
        }
      ],
      "choices": [
        {
          "id": "carry_callbacks",
          "text": "Controllo i ricordo che possono cambiare il contesto di Meridiana.",
          "goto": "callbacks"
        },
        {
          "id": "carry_back",
          "text": "Torno al quadro Rank S.",
          "goto": "rank_s_band"
        }
      ]
    },
    "cutoff_state": {
      "stitches": [
        {
          "id": "s1",
          "text": "Sul giornale sportivo è pubblicata la classifica alla data di chiusura. Le partite successive non cambiano ciò che era stato deciso allora."
        }
      ],
      "choices": [
        {
          "id": "cutoff_guard",
          "text": "Controllo cosa non concede lo snapshot.",
          "goto": "qualification_guard"
        },
        {
          "id": "cutoff_back",
          "text": "Torno al quadro Rank S.",
          "goto": "rank_s_band"
        }
      ]
    },
    "qualification_guard": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il tuo nome compare fra i professionisti Rank S, non ancora fra i partecipanti al Mondiale. Le due liste sono affisse su bacheche diverse."
        }
      ],
      "choices": [
        {
          "id": "guard_ready",
          "text": "Registro la separazione Rank/qualificazione.",
          "goto": "handoff_ready",
          "effects": [
            {
              "type": "set_flag",
              "key": "m7_rank_qualification_guard_reviewed",
              "value": true
            }
          ]
        },
        {
          "id": "guard_back",
          "text": "Torno allo snapshot.",
          "goto": "cutoff_state"
        }
      ]
    },
    "callbacks": {
      "stitches": [
        {
          "id": "s1",
          "text": "Un messaggio o una vecchia conoscenza possono accompagnare la partenza. Gli incontri con Red, Lance e gli altri allenatori hanno lasciato ricordi diversi, secondo il percorso vissuto."
        }
      ],
      "choices": [
        {
          "id": "callbacks_record",
          "text": "Registro il principio di continuità.",
          "goto": "handoff_ready",
          "effects": [
            {
              "type": "set_flag",
              "key": "m7_prior_callbacks_reviewed",
              "value": true
            }
          ]
        },
        {
          "id": "callbacks_back",
          "text": "Torno allo stato ereditato.",
          "goto": "carryover"
        }
      ]
    },
    "meridiana_preview": {
      "stitches": [
        {
          "id": "s1",
          "text": "La guida di Meridiana mostra il Grand Hall, l'arena, l'università, la clinica sportiva e la stazione internazionale. Il distretto stampa occupa un intero isolato."
        }
      ],
      "choices": [
        {
          "id": "preview_ready",
          "text": "Preparo l'ingresso reale in città.",
          "goto": "handoff_ready"
        },
        {
          "id": "preview_guard",
          "text": "Prima ricontrollo la distinzione fra Rank S e Mondiale.",
          "goto": "qualification_guard"
        }
      ]
    },
    "candidate_status": {
      "stitches": [
        {
          "id": "s1",
          "text": "Sul manifesto della stagione compare la parola «candidati». Il posto al Mondiale sarà deciso dagli incontri, non dal prestigio della licenza."
        }
      ],
      "choices": [
        {
          "id": "candidate_carry",
          "text": "Rivedo lo stato che porto con me.",
          "goto": "carryover"
        },
        {
          "id": "candidate_meridiana",
          "text": "Passo alla preview di Meridiana.",
          "goto": "meridiana_preview"
        }
      ]
    },
    "defer": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il convoglio successivo partirà più tardi. Mentre aspetti, gli altri allenatori continuano a viaggiare e a gareggiare."
        }
      ],
      "choices": [
        {
          "id": "defer_hour",
          "text": "Aspetto un'ora prima di decidere.",
          "goto": "wait_node",
          "timeCostMinutes": 60
        },
        {
          "id": "defer_review",
          "text": "Rivedo subito il quadro Rank S.",
          "goto": "rank_s_band"
        }
      ]
    },
    "wait_node": {
      "stitches": [
        {
          "id": "s1",
          "text": "L'orologio della stazione segna un'ora più tardi. Alcuni passeggeri sono partiti; altri si mettono in fila per il prossimo treno."
        }
      ],
      "choices": [
        {
          "id": "wait_back",
          "text": "Rivaluto la fascia Rank S.",
          "goto": "rank_s_band"
        },
        {
          "id": "wait_preview",
          "text": "Controllo se parto per Meridiana.",
          "goto": "meridiana_preview"
        }
      ]
    },
    "handoff_ready": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il controllore apre il varco per Meridiana. Il viaggio comincia soltanto quando decidi di salire."
        }
      ],
      "choices": [
        {
          "id": "handoff_depart",
          "text": "Parto verso Meridiana.",
          "goto": "m07-meridiana-arrival#arrival_entry"
        },
        {
          "id": "handoff_close",
          "text": "Faccio un ultimo controllo prima della partenza.",
          "goto": "close"
        }
      ]
    },
    "close": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il biglietto viene convalidato. Tutto ciò che hai conquistato fin qui ti accompagna verso la città professionale."
        }
      ],
      "choices": [
        {
          "id": "close_depart",
          "text": "Procedo verso Meridiana.",
          "goto": "m07-meridiana-arrival#arrival_entry"
        },
        {
          "id": "close_back",
          "text": "Torno al riepilogo Rank S.",
          "goto": "rank_s_band"
        }
      ]
    }
  }
}
