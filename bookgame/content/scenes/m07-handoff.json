{
  "schemaVersion": 1,
  "id": "m07-handoff",
  "moduleId": "M07",
  "title": "M7_00 — Rank S Handoff",
  "locationId": "first_lighthouse_ruins",
  "entryNodeId": "m07_entry",
  "conditions": {
    "all": [
      {
        "path": "world.flags.m6_complete",
        "eq": true
      },
      {
        "path": "world.flags.m07_unlocked",
        "eq": true
      },
      {
        "path": "competition.rank",
        "eq": "S"
      }
    ]
  },
  "nodes": {
    "m07_entry": {
      "stitches": [
        {
          "id": "s1",
          "text": "La licenza Rank S ti apre le porte dei circuiti più prestigiosi. Porti con te risultati, Pokémon, contatti e fatiche dell'ultima stagione: nulla viene lasciato alla stazione."
        }
      ],
      "choices": [
        {
          "id": "activate_m7",
          "text": "Attivo M7 senza cambiare il risultato del cutoff.",
          "goto": "rank_s_band",
          "conditions": {
            "path": "world.flags.m7_active",
            "ne": true
          },
          "effects": [
            {
              "type": "set_flag",
              "key": "m7_active",
              "value": true
            }
          ]
        },
        {
          "id": "review_active_m7",
          "text": "M7 è già attivo: rivedo la fascia Candidate Mondiale.",
          "goto": "rank_s_band",
          "conditions": {
            "path": "world.flags.m7_active",
            "eq": true
          }
        }
      ]
    },
    "rank_s_band": {
      "stitches": [
        {
          "id": "s1",
          "text": "La tessera Rank S attira uno sguardo rispettoso al banco informazioni. «Per il Mondiale, però, la qualificazione è un'altra cosa», ti ricorda l'addetto."
        }
      ],
      "choices": [
        {
          "id": "band_candidate",
          "text": "Controllo cosa significa essere Candidate Mondiale.",
          "goto": "candidate_status"
        },
        {
          "id": "band_cutoff",
          "text": "Rivedo lo snapshot del World Cutoff.",
          "goto": "cutoff_state"
        },
        {
          "id": "band_meridiana",
          "text": "Valuto l'accesso a Meridiana.",
          "goto": "meridiana_preview"
        },
        {
          "id": "band_defer",
          "text": "Rimando la partenza e lascio avanzare il mondo.",
          "goto": "defer"
        }
      ]
    },
    "carryover": {
      "stitches": [
        {
          "id": "s1",
          "text": "Sistema l'inventario e controlli la squadra. Gli incontri e i viaggi passati hanno lasciato segni concreti: è da qui che riparti."
        }
      ],
      "choices": [
        {
          "id": "carry_callbacks",
          "text": "Controllo i callback che possono cambiare il contesto di Meridiana.",
          "goto": "callbacks"
        },
        {
          "id": "carry_back",
          "text": "Torno al quadro Rank S.",
          "goto": "rank_s_band"
        }
      ]
    },
    "cutoff_state": {
      "stitches": [
        {
          "id": "s1",
          "text": "Sul terminale è ancora visibile la classifica registrata alla chiusura delle iscrizioni precedenti. La scadenza è passata; non puoi cambiare oggi i risultati di ieri."
        }
      ],
      "choices": [
        {
          "id": "cutoff_guard",
          "text": "Controllo cosa non concede lo snapshot.",
          "goto": "qualification_guard"
        },
        {
          "id": "cutoff_back",
          "text": "Torno al quadro Rank S.",
          "goto": "rank_s_band"
        }
      ]
    },
    "qualification_guard": {
      "stitches": [
        {
          "id": "s1",
          "text": "«Può presentare domanda per il Qualifier», spiega la segretaria, «ma il suo Rank non equivale a un posto già assegnato nel Mondiale.»"
        }
      ],
      "choices": [
        {
          "id": "guard_ready",
          "text": "Registro la separazione Rank/qualificazione.",
          "goto": "handoff_ready",
          "effects": [
            {
              "type": "set_flag",
              "key": "m7_rank_qualification_guard_reviewed",
              "value": true
            }
          ]
        },
        {
          "id": "guard_back",
          "text": "Torno allo snapshot.",
          "goto": "cutoff_state"
        }
      ]
    },
    "callbacks": {
      "stitches": [
        {
          "id": "s1",
          "text": "Ripensi a Red, Lance e agli altri allenatori incontrati. Alcuni consigli o vecchi contrasti potrebbero influenzare le prossime conversazioni, non concederti una vittoria."
        }
      ],
      "choices": [
        {
          "id": "callbacks_record",
          "text": "Registro il principio di continuità.",
          "goto": "handoff_ready",
          "effects": [
            {
              "type": "set_flag",
              "key": "m7_prior_callbacks_reviewed",
              "value": true
            }
          ]
        },
        {
          "id": "callbacks_back",
          "text": "Torno allo stato ereditato.",
          "goto": "carryover"
        }
      ]
    },
    "meridiana_preview": {
      "stitches": [
        {
          "id": "s1",
          "text": "Una pianta della città indica Grand Hall, arena, università, clinica sportiva e stazione internazionale. Vicino ai grandi viali compaiono anche sedi di media e sponsor."
        }
      ],
      "choices": [
        {
          "id": "preview_ready",
          "text": "Preparo l'ingresso reale in città.",
          "goto": "handoff_ready"
        },
        {
          "id": "preview_guard",
          "text": "Prima ricontrollo la distinzione fra Rank S e Mondiale.",
          "goto": "qualification_guard"
        }
      ]
    },
    "candidate_status": {
      "stitches": [
        {
          "id": "s1",
          "text": "Sei un candidato autorizzato a cercare la qualificazione. Il tabellone degli iscritti è ancora diverso da quello dei partecipanti al Mondiale."
        }
      ],
      "choices": [
        {
          "id": "candidate_carry",
          "text": "Rivedo lo stato che porto con me.",
          "goto": "carryover"
        },
        {
          "id": "candidate_meridiana",
          "text": "Passo alla preview di Meridiana.",
          "goto": "meridiana_preview"
        }
      ]
    },
    "defer": {
      "stitches": [
        {
          "id": "s1",
          "text": "Puoi rimandare la partenza, ma la città e gli altri allenatori continueranno con le proprie giornate."
        }
      ],
      "choices": [
        {
          "id": "defer_hour",
          "text": "Aspetto un'ora prima di decidere.",
          "goto": "wait_node",
          "timeCostMinutes": 60
        },
        {
          "id": "defer_review",
          "text": "Rivedo subito il quadro Rank S.",
          "goto": "rank_s_band"
        }
      ]
    },
    "wait_node": {
      "stitches": [
        {
          "id": "s1",
          "text": "Mentre aspetti cambiano i turni e le partenze. Nessuna semplice attesa ti consegna un accredito mondiale."
        }
      ],
      "choices": [
        {
          "id": "wait_back",
          "text": "Rivaluto la fascia Rank S.",
          "goto": "rank_s_band"
        },
        {
          "id": "wait_preview",
          "text": "Controllo se parto per Meridiana.",
          "goto": "meridiana_preview"
        }
      ]
    },
    "handoff_ready": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il biglietto per Meridiana è disponibile. Quando scegli di partire, sarà un viaggio vero, non un passaggio istantaneo oltre gli impegni che hai."
        }
      ],
      "choices": [
        {
          "id": "handoff_depart",
          "text": "Parto verso Meridiana.",
          "goto": "m07-meridiana-arrival#arrival_entry"
        },
        {
          "id": "handoff_close",
          "text": "Faccio un ultimo controllo prima della partenza.",
          "goto": "close"
        }
      ]
    },
    "close": {
      "stitches": [
        {
          "id": "s1",
          "text": "Rimetti la tessera in tasca. Tutto ciò che hai fatto ti accompagna verso Meridiana."
        }
      ],
      "choices": [
        {
          "id": "close_depart",
          "text": "Procedo verso Meridiana.",
          "goto": "m07-meridiana-arrival#arrival_entry"
        },
        {
          "id": "close_back",
          "text": "Torno al riepilogo Rank S.",
          "goto": "rank_s_band"
        }
      ]
    }
  }
}
