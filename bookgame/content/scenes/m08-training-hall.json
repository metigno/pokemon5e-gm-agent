{
  "schemaVersion": 1,
  "id": "m08-training-hall",
  "moduleId": "M08",
  "title": "M8_07 — Training Hall",
  "locationId": "world_training_hall",
  "entryNodeId": "training_entry",
  "conditions": {
    "all": [
      {
        "path": "world.flags.m7_complete",
        "eq": true
      },
      {
        "path": "world.flags.m08_unlocked",
        "eq": true
      },
      {
        "path": "world.flags.world_qualified",
        "eq": true
      },
      {
        "path": "world.flags.m8_active",
        "eq": true
      },
      {
        "path": "world.flags.m8_world_registration_complete",
        "eq": true
      },
      {
        "path": "world.flags.m8_world_village_arrived",
        "eq": true
      },
      {
        "path": "world.flags.friend_beat_08_complete",
        "eq": true
      }
    ]
  },
  "nodes": {
    "training_entry": {
      "stitches": [
        {
          "id": "s1",
          "text": "Nella Training Hall risuonano ordini brevi e passi sul pavimento. Ci sono spazi per esercizi tecnici e un campo libero per uno sparring facoltativo."
        }
      ],
      "choices": [
        {
          "id": "entry_hub",
          "text": "Entro nella Hall e controllo le opzioni.",
          "goto": "training_hub"
        },
        {
          "id": "entry_roster",
          "text": "Prima rivedo il roster reale.",
          "goto": "roster_review"
        },
        {
          "id": "entry_schedule",
          "text": "Controllo quanto tempo ho a disposizione.",
          "goto": "schedule"
        }
      ]
    },
    "training_hub": {
      "stitches": [
        {
          "id": "s1",
          "text": "Puoi osservare esercizi, controllare la squadra o chiedere un incontro. Ogni attività richiede tempo e nessuna regala capacità mai allenate."
        }
      ],
      "choices": [
        {
          "id": "hub_roster",
          "text": "Controllo la squadra disponibile.",
          "goto": "roster_review"
        },
        {
          "id": "hub_drill",
          "text": "Faccio una sessione tecnica controllata.",
          "goto": "technical_drill"
        },
        {
          "id": "hub_spar",
          "text": "Valuto lo sparring 1v1.",
          "goto": "spar_offer"
        },
        {
          "id": "hub_medical",
          "text": "Rivedo la readiness prima di allenarmi.",
          "goto": "medical_readiness"
        }
      ]
    },
    "roster_review": {
      "stitches": [
        {
          "id": "s1",
          "text": "Controlli quali Pokémon hai con te. Per lo sparring uno contro uno dovrai scegliere fra quelli realmente disponibili."
        }
      ],
      "choices": [
        {
          "id": "roster_ready",
          "text": "Con almeno un Pokémon posso usare la Hall.",
          "goto": "training_audit",
          "conditions": {
            "path": "player.roster.length",
            "gte": 1
          }
        },
        {
          "id": "roster_medical",
          "text": "Controllo prima la readiness.",
          "goto": "medical_readiness"
        },
        {
          "id": "roster_hub",
          "text": "Torno alle opzioni.",
          "goto": "training_hub"
        }
      ]
    },
    "medical_readiness": {
      "stitches": [
        {
          "id": "s1",
          "text": "Un tecnico ti chiede se i Pokémon siano pronti a uno sforzo ulteriore. Le ferite e la stanchezza precedenti restano un fattore."
        }
      ],
      "choices": [
        {
          "id": "medical_schedule",
          "text": "Controllo il costo temporale.",
          "goto": "schedule"
        },
        {
          "id": "medical_hub",
          "text": "Torno alle opzioni.",
          "goto": "training_hub"
        }
      ]
    },
    "technical_drill": {
      "stitches": [
        {
          "id": "s1",
          "text": "Dedichi un'ora a esercizi mirati. Un allenamento può aiutarti a capire cosa migliorare; non si traduce automaticamente in poteri nuovi."
        }
      ],
      "choices": [
        {
          "id": "drill_hour",
          "text": "Dedico un'ora alla rifinitura.",
          "goto": "training_audit",
          "timeCostMinutes": 60,
          "effects": [
            {
              "type": "set_flag",
              "key": "m8_training_focus",
              "value": "technical_refinement"
            }
          ]
        },
        {
          "id": "drill_hub",
          "text": "Rinuncio alla sessione e torno all'hub.",
          "goto": "training_hub"
        }
      ]
    },
    "spar_offer": {
      "stitches": [
        {
          "id": "s1",
          "text": "Un allenatore dello staff indica il proprio Lucario di livello 18. «Uno contro uno, soltanto per allenamento. Ti interessa?»"
        }
      ],
      "choices": [
        {
          "id": "spar_accept",
          "text": "Accetto lo sparring 1v1.",
          "combat": {
            "encounterId": "M8_TRAINING_HALL_LUCARIO_SPAR",
            "opponent": {
              "species": "Lucario",
              "form": "Standard",
              "level": 18,
              "trainerId": "WorldHallStaff",
              "motive": "controlled_world_sparring"
            },
            "opponentRegistered": true,
            "goto": "spar_handoff",
            "returnNodes": {
              "win": "spar_win",
              "lose": "spar_loss"
            }
          }
        },
        {
          "id": "spar_decline",
          "text": "Non combatto: proteggo risorse e tempo.",
          "goto": "training_audit",
          "effects": [
            {
              "type": "set_flag",
              "key": "m8_training_spar_result",
              "value": "declined"
            }
          ]
        },
        {
          "id": "spar_info",
          "text": "Controllo prima perché lo sparring non è ufficiale.",
          "goto": "opponent_info"
        }
      ]
    },
    "spar_handoff": {
      "stitches": [
        {
          "id": "s1",
          "text": "Lucario raggiunge la linea del campo. L'arbitro dello staff dà il segnale e lo sparring comincia."
        }
      ],
      "choices": []
    },
    "spar_win": {
      "stitches": [
        {
          "id": "s1",
          "text": "Hai vinto lo sparring. Il tecnico annota il risultato e si congratula; la classifica del Mondiale non cambia."
        }
      ],
      "choices": [
        {
          "id": "win_record",
          "text": "Registro il risultato reale.",
          "goto": "training_audit",
          "effects": [
            {
              "type": "set_flag",
              "key": "m8_training_spar_result",
              "value": "win"
            }
          ]
        },
        {
          "id": "win_friend",
          "text": "Ricollego il momento al Friend Beat appena vissuto.",
          "goto": "friend_callback"
        }
      ]
    },
    "spar_loss": {
      "stitches": [
        {
          "id": "s1",
          "text": "Lucario e il suo allenatore hanno la meglio. Puoi lasciare il campo e continuare la preparazione senza che l'esito diventi una sconfitta mondiale."
        }
      ],
      "choices": [
        {
          "id": "loss_record",
          "text": "Registro la sconfitta reale.",
          "goto": "training_audit",
          "effects": [
            {
              "type": "set_flag",
              "key": "m8_training_spar_result",
              "value": "loss"
            }
          ]
        },
        {
          "id": "loss_medical",
          "text": "Rivedo la readiness dopo il combattimento.",
          "goto": "medical_readiness"
        }
      ]
    },
    "schedule": {
      "stitches": [
        {
          "id": "s1",
          "text": "L'orologio sopra la porta ricorda che media e cerimonia hanno orari fissati. Prolungare una sessione può fartene perdere un'altra."
        }
      ],
      "choices": [
        {
          "id": "schedule_hub",
          "text": "Torno alle opzioni della Hall.",
          "goto": "training_hub"
        },
        {
          "id": "schedule_audit",
          "text": "Passo all'audit di preparazione.",
          "goto": "training_audit"
        }
      ]
    },
    "opponent_info": {
      "stitches": [
        {
          "id": "s1",
          "text": "L'allenatore dello staff richiama Lucario dopo la prova. Non è uno degli avversari sorteggiati per il tuo gruppo."
        }
      ],
      "choices": [
        {
          "id": "opponent_spar",
          "text": "Ora decido se accettare lo sparring.",
          "goto": "spar_offer"
        },
        {
          "id": "opponent_hub",
          "text": "Torno alle opzioni.",
          "goto": "training_hub"
        }
      ]
    },
    "astrid_callback": {
      "stitches": [
        {
          "id": "s1",
          "text": "Se hai parlato con Astrid, potresti ripensare al suo metodo di preparazione. Il consiglio non cambia il verdetto dello sparring."
        }
      ],
      "choices": [
        {
          "id": "astrid_audit",
          "text": "Porto il principio nell'audit.",
          "goto": "training_audit"
        },
        {
          "id": "astrid_hub",
          "text": "Torno alle opzioni.",
          "goto": "training_hub"
        }
      ]
    },
    "friend_callback": {
      "stitches": [
        {
          "id": "s1",
          "text": "Un amico può aver commentato le tue abitudini di allenamento. Non per questo è obbligato a presentarsi per una sfida."
        }
      ],
      "choices": [
        {
          "id": "friend_audit",
          "text": "Torno all'audit.",
          "goto": "training_audit"
        },
        {
          "id": "friend_hub",
          "text": "Torno alle opzioni.",
          "goto": "training_hub"
        }
      ]
    },
    "training_audit": {
      "stitches": [
        {
          "id": "s1",
          "text": "Alla fine controlli le condizioni dei Pokémon e l'orario. Quello che hai fatto qui resta separato dagli incontri ufficiali."
        }
      ],
      "choices": [
        {
          "id": "audit_astrid",
          "text": "Ricollego il principio al confronto con Astrid.",
          "goto": "astrid_callback"
        },
        {
          "id": "audit_close",
          "text": "Chiudo il blocco Training Hall.",
          "goto": "training_close"
        }
      ]
    },
    "training_close": {
      "stitches": [
        {
          "id": "s1",
          "text": "Lasci la sala allenamento. Il prossimo appuntamento pubblico è il Media Day."
        }
      ],
      "choices": [
        {
          "id": "close_media",
          "text": "Passo al Media Day.",
          "goto": "m08-media-day#media_entry",
          "effects": [
            {
              "type": "set_flag",
              "key": "m8_training_hall_complete",
              "value": true
            }
          ]
        },
        {
          "id": "close_hub",
          "text": "Resto nella Training Hall.",
          "goto": "training_hub"
        }
      ]
    }
  }
}
