          "effects": [
            {
              "type": "npc_state_set",
              "npcId": "Archie",
              "key": "smugglingContextShared",
              "value": true
            }
          ]
        },
        {
          "id": "archie_back",
          "text": "Tengo il punto ma decido da solo.",
          "goto": "thread_entry",
          "effects": [
            {
              "type": "npc_state_set",
              "npcId": "Archie",
              "key": "smugglingContextShared",
              "value": true
            }
          ]
        }
      ]
    },
    "archie_outcome": {
      "stitches": [
        {
          "id": "archie_out_1",
          "text": "Archie non celebra l'intercettazione come una vittoria totale. «Hai tolto una strada. Ora il sistema cambia. È lì che vedi se hai capito davvero cosa stavi guardando.»"
        }
      ],
      "choices": [
        {
