            "path": "world.flags.archie_met",
            "eq": true
          },
          "goto": "archie_outcome"
        }
      ]
    },
    "archie_smuggling": {
      "stitches": [
        {
          "id": "archie_1",
          "text": "Archie ascolta la catena e torna sul suo principio: «Se vuoi capire un flusso, guarda dove è costretto a passare. Non dove vorresti che passasse.» Non sceglie per te se segnalare, seguire o lasciare andare."
        }
      ],
      "choices": [
        {
          "id": "archie_customs",
          "text": "Uso il criterio per preparare un rapporto verificabile.",
          "goto": "customs_report",
          "effects": [
            {
              "type": "npc_state_set",
