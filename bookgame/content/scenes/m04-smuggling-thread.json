    "documented_resolution": {
      "stitches": [
        {
          "id": "docres_1",
          "text": "La dogana riceve una catena documentata abbastanza precisa da cambiare controlli e pattugliamenti. Non hai bisogno di vedere ogni arresto perché l'esito resti persistente."
        }
      ],
      "choices": [
        {
          "id": "docres_close",
          "text": "Chiudo la quest con la rotta documentata.",
