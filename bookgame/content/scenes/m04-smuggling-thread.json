    "intervention_result": {
      "stitches": [
        {
          "id": "intervention_result_1",
          "text": "Il controllo trova merce tecnica non dichiarata e documenti ritoccati. Alcuni responsabili operativi vengono identificati, ma il rapporto non pretende che una singola intercettazione cancelli ogni possibile rotta clandestina."
        }
      ],
      "choices": [
        {
          "id": "intervention_record",
          "text": "Registro l'esito concreto e chiudo la quest.",
          "goto": "thread_close",
          "effects": [
            {
              "type": "set_flag",
              "key": "smuggling_customs_evidence",
              "value": "coordinated_intercept_confirmed"
            }
          ]
        },
        {
          "id": "intervention_archie",
          "text": "Chiedo ad Archie cosa cambia quando una rete perde una rotta.",
          "conditions": {
            "path": "world.flags.archie_met",
            "eq": true
          },
          "goto": "archie_outcome"
        }
      ]
