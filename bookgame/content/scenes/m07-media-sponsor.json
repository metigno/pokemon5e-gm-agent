{
  "schemaVersion": 1,
  "id": "m07-media-sponsor",
  "moduleId": "M07",
  "title": "M7_03 — Media & Sponsor",
  "locationId": "meridiana_media_district",
  "entryNodeId": "media_entry",
  "conditions": {
    "all": [
      {
        "path": "world.flags.m6_complete",
        "eq": true
      },
      {
        "path": "world.flags.m07_unlocked",
        "eq": true
      },
      {
        "path": "competition.rank",
        "eq": "S"
      },
      {
        "path": "world.flags.m7_active",
        "eq": true
      },
      {
        "path": "world.flags.m7_meridiana_arrived",
        "eq": true
      },
      {
        "path": "world.flags.cynthia_met",
        "eq": true
      }
    ]
  },
  "nodes": {
    "media_entry": {
      "stitches": [
        {
          "id": "s1",
          "text": "A Meridiana il circuito non vive soltanto sul campo. Nei corridoi ci sono microfoni, inviti alle interviste e contratti da leggere con attenzione."
        }
      ],
      "choices": [
        {
          "id": "entry_hub",
          "text": "Entro nel distretto professionale.",
          "goto": "media_hub"
        },
        {
          "id": "entry_press",
          "text": "Parto dalla sala stampa.",
          "goto": "press_room"
        },
        {
          "id": "entry_sponsor",
          "text": "Parto dal desk sponsor.",
          "goto": "sponsor_desk"
        }
      ]
    },
    "media_hub": {
      "stitches": [
        {
          "id": "s1",
          "text": "Una freccia indica la sala stampa, un'altra conduce agli uffici degli sponsor. Ogni appuntamento occupa parte della giornata."
        }
      ],
      "choices": [
        {
          "id": "hub_sponsor",
          "text": "Valuto una posizione contrattuale.",
          "goto": "sponsor_desk"
        },
        {
          "id": "hub_press",
          "text": "Preparo il rapporto con i media.",
          "goto": "press_room"
        },
        {
          "id": "hub_obligations",
          "text": "Controllo il costo temporale degli impegni.",
          "goto": "obligations"
        }
      ]
    },
    "sponsor_desk": {
      "stitches": [
        {
          "id": "s1",
          "text": "Un responsabile ti presenta tre possibilità: restare indipendente, collaborare con un'attività locale o firmare con un marchio più importante. Prima di decidere puoi leggere gli impegni previsti."
        }
      ],
      "choices": [
        {
          "id": "sponsor_independent",
          "text": "Resto indipendente.",
          "goto": "independent_path"
        },
        {
          "id": "sponsor_local",
          "text": "Valuto un partner locale.",
          "goto": "local_partner"
        },
        {
          "id": "sponsor_major",
          "text": "Valuto un partner maggiore.",
          "goto": "major_partner"
        }
      ]
    },
    "press_room": {
      "stitches": [
        {
          "id": "s1",
          "text": "Un addetto stampa prova a farti domande su sconfitte, squadra e aspettative. «Non devi rispondere a tutto», precisa. «Ma quello che dici verrà ascoltato.»"
        }
      ],
      "choices": [
        {
          "id": "press_train",
          "text": "Faccio una sessione di media training.",
          "goto": "media_training"
        },
        {
          "id": "press_interview",
          "text": "Accetto direttamente una breve intervista.",
          "goto": "interview_choice"
        }
      ]
    },
    "sponsor_terms": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il contratto elenca apparizioni, interviste e scadenze. Leggi con attenzione ciò che il partner si aspetta prima di firmare."
        }
      ],
      "choices": [
        {
          "id": "terms_obligations",
          "text": "Controllo gli obblighi temporali.",
          "goto": "obligations",
          "effects": [
            {
              "type": "set_flag",
              "key": "m7_sponsor_terms_reviewed",
              "value": true
            }
          ]
        },
        {
          "id": "terms_hub",
          "text": "Torno al distretto.",
          "goto": "media_hub"
        }
      ]
    },
    "independent_path": {
      "stitches": [
        {
          "id": "s1",
          "text": "Scegli di non legarti a uno sponsor. Avrai meno appuntamenti imposti, ma la stampa continuerà a seguire i tuoi risultati."
        }
      ],
      "choices": [
        {
          "id": "independent_commit",
          "text": "Confermo l'indipendenza.",
          "goto": "sponsor_terms",
          "effects": [
            {
              "type": "set_flag",
              "key": "m7_sponsor_path",
              "value": "independent"
            }
          ]
        },
        {
          "id": "independent_back",
          "text": "Riapro le opzioni contrattuali.",
          "goto": "sponsor_desk"
        }
      ]
    },
    "local_partner": {
      "stitches": [
        {
          "id": "s1",
          "text": "Un'attività di Meridiana propone apparizioni limitate e una collaborazione vicina al territorio. Non ti promette vittorie né poteri nuovi."
        }
      ],
      "choices": [
        {
          "id": "local_commit",
          "text": "Scelgo il partner locale come postura.",
          "goto": "sponsor_terms",
          "effects": [
            {
              "type": "set_flag",
              "key": "m7_sponsor_path",
              "value": "local_partner"
            }
          ]
        },
        {
          "id": "local_back",
          "text": "Riapro le opzioni contrattuali.",
          "goto": "sponsor_desk"
        }
      ]
    },
    "major_partner": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il rappresentante di un grande marchio mette sul tavolo un calendario fitto di eventi pubblici. Maggiore visibilità significa anche meno ore libere."
        }
      ],
      "choices": [
        {
          "id": "major_commit",
          "text": "Scelgo il partner maggiore come postura.",
          "goto": "sponsor_terms",
          "effects": [
            {
              "type": "set_flag",
              "key": "m7_sponsor_path",
              "value": "major_partner"
            }
          ]
        },
        {
          "id": "major_back",
          "text": "Riapro le opzioni contrattuali.",
          "goto": "sponsor_desk"
        }
      ]
    },
    "media_training": {
      "stitches": [
        {
          "id": "s1",
          "text": "Per mezz'ora un preparatore ti mostra come ascoltare una domanda, riconoscere un'insidia e decidere quanto rivelare. Non può cambiare il tuo carattere per decreto."
        }
      ],
      "choices": [
        {
          "id": "training_interview",
          "text": "Uso la sessione e passo all'intervista.",
          "goto": "interview_choice",
          "timeCostMinutes": 30,
          "effects": [
            {
              "type": "set_flag",
              "key": "m7_media_training_done",
              "value": true
            }
          ]
        },
        {
          "id": "training_hub",
          "text": "Interrompo e torno al distretto.",
          "goto": "media_hub"
        }
      ]
    },
    "interview_choice": {
      "stitches": [
        {
          "id": "s1",
          "text": "Davanti al microfono puoi parlare apertamente delle tue ambizioni oppure proteggere i dettagli che non vuoi rendere pubblici."
        }
      ],
      "choices": [
        {
          "id": "interview_open",
          "text": "Parlo apertamente della corsa al Mondiale.",
          "goto": "obligations",
          "timeCostMinutes": 30,
          "effects": [
            {
              "type": "set_flag",
              "key": "m7_media_style",
              "value": "open"
            }
          ]
        },
        {
          "id": "interview_selective",
          "text": "Mantengo il messaggio essenziale.",
          "goto": "obligations",
          "timeCostMinutes": 30,
          "effects": [
            {
              "type": "set_flag",
              "key": "m7_media_style",
              "value": "selective"
            }
          ]
        }
      ]
    },
    "obligations": {
      "stitches": [
        {
          "id": "s1",
          "text": "Gli impegni segnati sul calendario possono sovrapporsi ad allenamento, riposo e appuntamenti importanti. Dovrai scegliere come usare il tempo."
        }
      ],
      "choices": [
        {
          "id": "obligations_callback",
          "text": "Valuto come la reputazione precedente influenza la lettura pubblica.",
          "goto": "callback"
        },
        {
          "id": "obligations_wait",
          "text": "Lascio passare una finestra prima di chiudere l'agenda.",
          "goto": "wait_window"
        }
      ]
    },
    "callback": {
      "stitches": [
        {
          "id": "s1",
          "text": "Un cronista ricorda una tua vecchia vittoria o sconfitta. Puoi rispondere, correggere un'interpretazione o lasciar cadere la domanda."
        }
      ],
      "choices": [
        {
          "id": "callback_close",
          "text": "Registro il contesto e chiudo il blocco.",
          "goto": "media_close",
          "effects": [
            {
              "type": "set_flag",
              "key": "m7_media_callback_reviewed",
              "value": true
            }
          ]
        },
        {
          "id": "callback_hub",
          "text": "Torno al distretto.",
          "goto": "media_hub"
        }
      ]
    },
    "wait_window": {
      "stitches": [
        {
          "id": "s1",
          "text": "Passa un'ora in sala d'attesa. Le luci degli uffici cambiano e qualcuno esce prima che tu abbia preso una decisione."
        }
      ],
      "choices": [
        {
          "id": "wait_hour",
          "text": "Aspetto un'ora e torno al distretto.",
          "goto": "media_hub",
          "timeCostMinutes": 60
        },
        {
          "id": "wait_close",
          "text": "Chiudo l'agenda senza altra attesa.",
          "goto": "media_close"
        }
      ]
    },
    "media_close": {
      "stitches": [
        {
          "id": "s1",
          "text": "Lasci il distretto con una scelta pubblica alle spalle. Gli appuntamenti che hai accettato ti seguiranno anche durante la preparazione."
        }
      ],
      "choices": [
        {
          "id": "close_prep",
          "text": "Passo alla preparazione professionale.",
          "goto": "m07-pro-preparation#prep_entry",
          "effects": [
            {
              "type": "set_flag",
              "key": "m7_media_sponsor_reviewed",
              "value": true
            }
          ]
        },
        {
          "id": "close_hub",
          "text": "Resto nel distretto media.",
          "goto": "media_hub"
        }
      ]
    }
  }
}
