{
  "schemaVersion": 1,
  "id": "m07-media-sponsor",
  "moduleId": "M07",
  "title": "M7_03 — Media & Sponsor",
  "locationId": "meridiana_media_district",
  "entryNodeId": "media_entry",
  "conditions": {
    "all": [
      {
        "path": "world.flags.m6_complete",
        "eq": true
      },
      {
        "path": "world.flags.m07_unlocked",
        "eq": true
      },
      {
        "path": "competition.rank",
        "eq": "S"
      },
      {
        "path": "world.flags.m7_active",
        "eq": true
      },
      {
        "path": "world.flags.m7_meridiana_arrived",
        "eq": true
      },
      {
        "path": "world.flags.cynthia_met",
        "eq": true
      }
    ]
  },
  "nodes": {
    "media_entry": {
      "stitches": [
        {
          "id": "s1",
          "text": "Appena entri nel distretto, una troupe trascina cavi sul marciapiede e un agente cerca riparo dal rumore per parlare al telefono. Sopra la porta della sala stampa lampeggia l'orario delle prossime interviste."
        }
      ],
      "choices": [
        {
          "id": "entry_hub",
          "text": "Entro nel distretto professionale.",
          "goto": "media_hub"
        },
        {
          "id": "entry_press",
          "text": "Parto dalla sala stampa.",
          "goto": "press_room"
        },
        {
          "id": "entry_sponsor",
          "text": "Parto dal desk sponsor.",
          "goto": "sponsor_desk"
        }
      ]
    },
    "media_hub": {
      "stitches": [
        {
          "id": "s1",
          "text": "Una receptionist ti consegna una pianta del piano. A sinistra ci sono gli uffici degli sponsor; a destra, la sala stampa. Sulla bacheca, gli appuntamenti occupano già buona parte della giornata."
        }
      ],
      "choices": [
        {
          "id": "hub_sponsor",
          "text": "Valuto una posizione contrattuale.",
          "goto": "sponsor_desk"
        },
        {
          "id": "hub_press",
          "text": "Preparo il rapporto con i media.",
          "goto": "press_room"
        },
        {
          "id": "hub_obligations",
          "text": "Controllo il costo temporale degli impegni.",
          "goto": "obligations"
        }
      ]
    },
    "sponsor_desk": {
      "stitches": [
        {
          "id": "s1",
          "text": "La responsabile apre tre cartelline. «Nessun accordo, una collaborazione locale oppure un contratto con più eventi pubblici. Leggi bene gli orari: gli sponsor vogliono vederti anche fuori dall'arena.»"
        }
      ],
      "choices": [
        {
          "id": "sponsor_independent",
          "text": "Resto indipendente.",
          "goto": "independent_path"
        },
        {
          "id": "sponsor_local",
          "text": "Valuto un partner locale.",
          "goto": "local_partner"
        },
        {
          "id": "sponsor_major",
          "text": "Valuto un partner maggiore.",
          "goto": "major_partner"
        }
      ]
    },
    "press_room": {
      "stitches": [
        {
          "id": "s1",
          "text": "Un consulente ti fa accomodare davanti a un microfono spento. «Ti chiederanno delle sconfitte, dei Pokémon che scegli e di cosa pensi del Mondiale. Non devi raccontare tutto, ma devi sapere cosa vuoi dire.»"
        }
      ],
      "choices": [
        {
          "id": "press_train",
          "text": "Faccio una sessione di media training.",
          "goto": "media_training"
        },
        {
          "id": "press_interview",
          "text": "Accetto direttamente una breve intervista.",
          "goto": "interview_choice"
        }
      ]
    },
    "sponsor_terms": {
      "stitches": [
        {
          "id": "s1",
          "text": "La responsabile gira il contratto verso di te e sottolinea gli appuntamenti obbligatori. «Prima di firmare, guarda quali giorni ti chiediamo. Un'intervista non aspetta perché hai deciso di allenarti.»"
        }
      ],
      "choices": [
        {
          "id": "terms_obligations",
          "text": "Controllo gli obblighi temporali.",
          "goto": "obligations",
          "effects": [
            {
              "type": "set_flag",
              "key": "m7_sponsor_terms_reviewed",
              "value": true
            }
          ]
        },
        {
          "id": "terms_hub",
          "text": "Torno al distretto.",
          "goto": "media_hub"
        }
      ]
    },
    "independent_path": {
      "stitches": [
        {
          "id": "s1",
          "text": "«Nessuna firma, allora», dice la responsabile, richiudendo le cartelline. Fuori dall'ufficio, però, una troupe continua a cercare allenatori da intervistare."
        }
      ],
      "choices": [
        {
          "id": "independent_commit",
          "text": "Confermo l'indipendenza.",
          "goto": "sponsor_terms",
          "effects": [
            {
              "type": "set_flag",
              "key": "m7_sponsor_path",
              "value": "independent"
            }
          ]
        },
        {
          "id": "independent_back",
          "text": "Riapro le opzioni contrattuali.",
          "goto": "sponsor_desk"
        }
      ]
    },
    "local_partner": {
      "stitches": [
        {
          "id": "s1",
          "text": "La responsabile ti mostra un calendario con poche apparizioni nella città. «Preferiamo che la gente ti conosca davvero, non che ti veda su ogni schermo.»"
        }
      ],
      "choices": [
        {
          "id": "local_commit",
          "text": "Scelgo il partner locale come postura.",
          "goto": "sponsor_terms",
          "effects": [
            {
              "type": "set_flag",
              "key": "m7_sponsor_path",
              "value": "local_partner"
            }
          ]
        },
        {
          "id": "local_back",
          "text": "Riapro le opzioni contrattuali.",
          "goto": "sponsor_desk"
        }
      ]
    },
    "major_partner": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il contratto più spesso contiene interviste, fotografie e appuntamenti in giorni già affollati. «Più pubblico», dice l'agente, «ma dovrai trovare il tempo per esserci.»"
        }
      ],
      "choices": [
        {
          "id": "major_commit",
          "text": "Scelgo il partner maggiore come postura.",
          "goto": "sponsor_terms",
          "effects": [
            {
              "type": "set_flag",
              "key": "m7_sponsor_path",
              "value": "major_partner"
            }
          ]
        },
        {
          "id": "major_back",
          "text": "Riapro le opzioni contrattuali.",
          "goto": "sponsor_desk"
        }
      ]
    },
    "media_training": {
      "stitches": [
        {
          "id": "s1",
          "text": "Per mezz'ora il consulente ti rivolge domande sempre più incalzanti. Quando una risposta si allunga, alza una mano. «Fermati qui. Lascia che siano loro a chiedere il resto.»"
        }
      ],
      "choices": [
        {
          "id": "training_interview",
          "text": "Uso la sessione e passo all'intervista.",
          "goto": "interview_choice",
          "timeCostMinutes": 30,
          "effects": [
            {
              "type": "set_flag",
              "key": "m7_media_training_done",
              "value": true
            }
          ]
        },
        {
          "id": "training_hub",
          "text": "Interrompo e torno al distretto.",
          "goto": "media_hub"
        }
      ]
    },
    "interview_choice": {
      "stitches": [
        {
          "id": "s1",
          "text": "La luce rossa della telecamera si accende. «Sei arrivato fino al Rank S», dice la giornalista. «Che cosa vuoi dimostrare adesso?» Il microfono resta puntato verso di te."
        }
      ],
      "choices": [
        {
          "id": "interview_open",
          "text": "Parlo apertamente della corsa al Mondiale.",
          "goto": "obligations",
          "timeCostMinutes": 30,
          "effects": [
            {
              "type": "set_flag",
              "key": "m7_media_style",
              "value": "open"
            }
          ]
        },
        {
          "id": "interview_selective",
          "text": "Mantengo il messaggio essenziale.",
          "goto": "obligations",
          "timeCostMinutes": 30,
          "effects": [
            {
              "type": "set_flag",
              "key": "m7_media_style",
              "value": "selective"
            }
          ]
        }
      ]
    },
    "obligations": {
      "stitches": [
        {
          "id": "s1",
          "text": "Sulla tua agenda, gli orari degli sponsor si sovrappongono a quelli della preparazione. Un assistente indica due caselle: «Una delle due dovrà aspettare.»"
        }
      ],
      "choices": [
        {
          "id": "obligations_callback",
          "text": "Valuto come la reputazione precedente influenza la lettura pubblica.",
          "goto": "callback"
        },
        {
          "id": "obligations_wait",
          "text": "Lascio passare una finestra prima di chiudere l'agenda.",
          "goto": "wait_window"
        }
      ]
    },
    "callback": {
      "stitches": [
        {
          "id": "s1",
          "text": "La giornalista sfoglia i risultati pubblicati sul suo tablet. Alcuni nomi le sono familiari; su altri chiede conferma prima di formulare la domanda successiva."
        }
      ],
      "choices": [
        {
          "id": "callback_close",
          "text": "Registro il contesto e chiudo il blocco.",
          "goto": "media_close",
          "effects": [
            {
              "type": "set_flag",
              "key": "m7_media_callback_reviewed",
              "value": true
            }
          ]
        },
        {
          "id": "callback_hub",
          "text": "Torno al distretto.",
          "goto": "media_hub"
        }
      ]
    },
    "wait_window": {
      "stitches": [
        {
          "id": "s1",
          "text": "Passa un'ora. La troupe cambia turno, un agente richiama un appuntamento saltato e sul monitor compare un nuovo ordine delle interviste."
        }
      ],
      "choices": [
        {
          "id": "wait_hour",
          "text": "Aspetto un'ora e torno al distretto.",
          "goto": "media_hub",
          "timeCostMinutes": 60
        },
        {
          "id": "wait_close",
          "text": "Chiudo l'agenda senza altra attesa.",
          "goto": "media_close"
        }
      ]
    },
    "media_close": {
      "stitches": [
        {
          "id": "s1",
          "text": "Lasci la sala stampa con un'agenda più piena o con qualche spazio difeso. Nel corridoio, altri allenatori aspettano il proprio turno davanti alle telecamere."
        }
      ],
      "choices": [
        {
          "id": "close_prep",
          "text": "Passo alla preparazione professionale.",
          "goto": "m07-pro-preparation#prep_entry",
          "effects": [
            {
              "type": "set_flag",
              "key": "m7_media_sponsor_reviewed",
              "value": true
            }
          ]
        },
        {
          "id": "close_hub",
          "text": "Resto nel distretto media.",
          "goto": "media_hub"
        }
      ]
    }
  }
}
