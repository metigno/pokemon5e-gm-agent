  "nodes": {
    "last_chance_entry": {
      "stitches": [
        {
          "id": "s1",
          "text": "L'arena è più silenziosa rispetto al Qualifier. Un unico incontro compare sul tabellone: questa volta non c'è una seconda casella a cui avanzare."
        }
      ],
      "choices": [
        {
          "id": "entry_rules",
          "text": "Rileggo la regola finita.",
          "goto": "rules"
        },
        {
          "id": "entry_eligibility",
          "text": "Controllo che la route sia ancora legale.",
          "goto": "eligibility_guard"
        },
        {
          "id": "entry_prepare",
          "text": "Preparo l'Official Six.",
          "goto": "preparation"
        }
      ]
    },
    "rules": {
      "stitches": [
        {
          "id": "s1",
          "text": "L'arbitro legge il regolamento: «Incontro singolo, sei Pokémon per parte. Una sola partita decide l'ultimo posto disponibile.»"
        }
      ],
      "choices": [
        {
          "id": "rules_prepare",
          "text": "Passo alla preparazione.",
          "goto": "preparation"
        },
        {
          "id": "rules_history",
          "text": "Rivedo perché il Qualifier principale resta nella history.",
          "goto": "history"
        }
      ]
    },
    "eligibility_guard": {
      "stitches": [
        {
          "id": "s1",
          "text": "All'ingresso, l'addetto verifica il foglio d'accesso e la sconfitta già registrata nel percorso principale."
        }
      ],
      "choices": [
        {
          "id": "eligibility_roster",
          "text": "Verifico il roster corrente.",
          "goto": "roster_guard"
        },
        {
          "id": "eligibility_history",
          "text": "Rivedo la storia competitiva prima dell'ultimo tentativo.",
          "goto": "history"
        }
      ]
    },
    "preparation": {
      "stitches": [
        {
          "id": "s1",
          "text": "I tuoi Pokémon arrivano con la fatica e le condizioni accumulate fin qui. Il tempo che resta prima della chiamata è quello segnato sull'orologio."
        }
      ],
      "choices": [
        {
          "id": "prepare_roster",
          "text": "Controllo l'Official Six.",
          "goto": "roster_guard"
        },
        {
          "id": "prepare_opponent",
          "text": "Rileggo ciò che è pubblico dell'avversario.",
          "goto": "opponent_public"
        },
        {
          "id": "prepare_cynthia",
          "text": "Rileggo il principio di Cynthia sul preservare margine.",
          "goto": "cynthia_callback"
        }
      ]
    },
    "roster_guard": {
      "stitches": [
        {
          "id": "s1",
          "text": "L'addetto conta i Pokémon disponibili sulla lista. «Devono essere sei anche per quest'ultimo incontro.»"
        }
      ],
      "choices": [
        {
          "id": "roster_ready",
          "text": "Ho sei Pokémon: passo alla conferma.",
          "goto": "opponent_public",
          "conditions": {
            "path": "player.roster.length",
            "gte": 6
          }
        },
        {
          "id": "roster_missing",
          "text": "Non ho l'Official Six: torno alla preparazione.",
          "goto": "preparation",
          "conditions": {
            "path": "player.roster.length",
            "lt": 6
          }
        },
        {
          "id": "roster_history",
          "text": "Rivedo perché non esistono scorciatoie.",
          "goto": "history"
        }
      ]
    },
    "opponent_public": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il tabellone mostra la squadra iscritta dall'avversaria. Il modo in cui la userà resta una domanda aperta."
        }
      ],
      "choices": [
        {
          "id": "opponent_start",
          "text": "Confermo l'incontro decisivo.",
          "goto": "handoff",
          "conditions": {
            "all": [
              {
                "path": "player.roster.length",
                "gte": 6
              },
              {
                "path": "world.flags.m7_last_chance_match_result",
                "exists": false
              }
            ]
          }
        },
        {
          "id": "opponent_prepare",
          "text": "Non entro ancora: torno alla preparazione.",
          "goto": "preparation"
        }
      ]
    },
    "handoff": {
      "stitches": [
        {
          "id": "s1",
          "text": "L'arbitro richiama i due allenatori sul campo. Il pubblico tace per un istante, poi il segnale d'inizio rompe il silenzio."
        }
      ],
      "choices": [
        {
          "id": "fight_last_chance",
          "text": "Combatto il Last Chance.",
          "combat": {
            "encounterId": "A7_LAST_CHANCE_FINAL",
            "opponentRegistered": true,
            "competition": {
              "type": "official_match",
              "matchId": "A7_LAST_CHANCE_FINAL",
              "format": "Singles",
              "officialRosterSize": 6,
              "difficulty": "ELITE",
              "opponentTrainerId": "LC_FINAL_IRIS_KADE"
            },
            "returnNodes": {
              "win": "win",
              "lose": "loss"
            },
            "opponentTrainerId": "LC_FINAL_IRIS_KADE",
            "opponent": {
              "species": "Metagross",
              "level": 19,
              "abilityId": "clear-body",
              "trainerId": "LC_FINAL_IRIS_KADE"
            },
            "opponentBench": [
              {
                "species": "Rotom-Wash",
                "level": 19,
                "abilityId": "levitate",
                "trainerId": "LC_FINAL_IRIS_KADE"
              },
              {
                "species": "Tyranitar",
                "level": 19,
                "abilityId": "sand-stream",
                "trainerId": "LC_FINAL_IRIS_KADE"
              },
              {
                "species": "Togekiss",
                "level": 19,
                "abilityId": "serene-grace",
                "trainerId": "LC_FINAL_IRIS_KADE"
              },
              {
                "species": "Excadrill",
                "level": 19,
                "abilityId": "mold-breaker",
                "trainerId": "LC_FINAL_IRIS_KADE"
              },
              {
                "species": "Infernape",
                "level": 19,
                "abilityId": "blaze",
                "trainerId": "LC_FINAL_IRIS_KADE"
              }
            ],
            "goto": "handoff"
          }
        }
      ]
    },
    "win": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il segnale finale risuona. Sul monitor compare la tua vittoria nell'ultima occasione; l'arbitro trasmette il risultato al banco."
        }
      ],
      "choices": [
        {
          "id": "win_record",
          "text": "Registro la vittoria Last Chance.",
          "goto": "win_record",
          "effects": [
            {
              "type": "set_flag",
