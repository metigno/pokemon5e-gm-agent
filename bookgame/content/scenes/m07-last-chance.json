              "value": true
            }
          ]
        },
        {
          "id": "win_review",
          "text": "Rileggo la vittoria prima di chiudere.",
          "goto": "history"
        }
      ]
    },
    "loss_record": {
      "stitches": [
        {
          "id": "s1",
          "text": "L'ufficiale chiude il registro. «La partecipazione è conclusa», dice, prima di chiamare il prossimo allenatore."
        }
      ],
      "choices": [
        {
          "id": "loss_commit",
          "text": "Registro il Last Chance perso.",
          "goto": "close",
          "conditions": {
            "path": "world.flags.m7_last_chance_match_result",
