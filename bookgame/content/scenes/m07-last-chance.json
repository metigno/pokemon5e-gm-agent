    "cynthia_callback": {
      "stitches": [
        {
          "id": "s1",
          "text": "Cynthia non trasforma l'ultima possibilità in una garanzia: il suo insegnamento riguarda gestione di risorse e rischio, non plot armor."
        }
      ],
      "choices": [
        {
          "id": "cynthia_prepare",
          "text": "Torno alla preparazione.",
          "goto": "preparation"
