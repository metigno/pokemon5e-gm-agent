    "history": {
      "stitches": [
        {
          "id": "s1",
          "text": "Nel registro sono visibili entrambe le gare che hai giocato. Nessuna delle due può essere cancellata per rendere migliore la storia."
        }
      ],
      "choices": [
        {
          "id": "history_prepare",
          "text": "Torno alla preparazione se il match non è ancora consumato.",
          "goto": "preparation",
          "conditions": {
            "path": "world.flags.m7_last_chance_complete",
