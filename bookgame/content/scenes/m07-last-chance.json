    "cynthia_callback": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il consiglio di Cynthia torna alla mente guardando i Pokémon dopo la partita. Una scelta prudente o aggressiva non cambia retroattivamente il verdetto."
