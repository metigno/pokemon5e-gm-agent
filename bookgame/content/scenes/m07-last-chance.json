    "close": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il Last Chance è ormai risolto una volta sola. Da qui esistono soltanto Before the Lights se qualificato, oppure Worlds Missed dopo una sconfitta."
        }
      ],
      "choices": [
        {
          "id": "close_lights",
