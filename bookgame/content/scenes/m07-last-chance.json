                "species": "Tyranitar",
                "level": 19,
                "abilityId": "sand-stream",
                "trainerId": "LC_FINAL_IRIS_KADE"
              },
              {
                "species": "Togekiss",
                "level": 19,
                "abilityId": "serene-grace",
                "trainerId": "LC_FINAL_IRIS_KADE"
              },
              {
                "species": "Excadrill",
                "level": 19,
                "abilityId": "mold-breaker",
                "trainerId": "LC_FINAL_IRIS_KADE"
              },
              {
                "species": "Infernape",
                "level": 19,
                "abilityId": "blaze",
                "trainerId": "LC_FINAL_IRIS_KADE"
              }
            ],
            "goto": "handoff"
          }
        }
      ]
    },
    "win": {
      "stitches": [
        {
          "id": "s1",
          "text": "L'ultima sfida termina a tuo favore. Il tabellone conferma la vittoria; resta da registrare ufficialmente il nuovo posto conquistato."
