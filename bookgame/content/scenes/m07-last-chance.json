  "nodes": {
    "last_chance_entry": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il Last Chance è una sola occasione separata dal World Qualifier principale. Non cancella la sconfitta precedente e non può essere ripetuto finché arriva una vittoria."
        }
      ],
      "choices": [
        {
          "id": "entry_rules",
          "text": "Rileggo la regola finita.",
          "goto": "rules"
        },
        {
          "id": "entry_eligibility",
          "text": "Controllo che la route sia ancora legale.",
          "goto": "eligibility_guard"
        },
        {
          "id": "entry_prepare",
          "text": "Preparo l'Official Six.",
          "goto": "preparation"
        }
      ]
    },
    "rules": {
      "stitches": [
        {
          "id": "s1",
          "text": "Formato: Singles, Official Six, ELITE, un solo incontro decisivo per questa route. A7_LAST_CHANCE è once=true."
        }
      ],
      "choices": [
        {
          "id": "rules_prepare",
          "text": "Passo alla preparazione.",
          "goto": "preparation"
        },
        {
          "id": "rules_history",
          "text": "Rivedo perché il Qualifier principale resta nella history.",
          "goto": "history"
        }
      ]
    },
    "eligibility_guard": {
      "stitches": [
        {
          "id": "s1",
          "text": "La route esiste solo perché il Qualifier è già risolto, il player non è qualificato e il gate ha consumato una eligibility reale."
        }
      ],
      "choices": [
        {
          "id": "eligibility_roster",
          "text": "Verifico il roster corrente.",
          "goto": "roster_guard"
        },
        {
          "id": "eligibility_history",
          "text": "Rivedo la storia competitiva prima dell'ultimo tentativo.",
          "goto": "history"
        }
      ]
    },
    "preparation": {
      "stitches": [
        {
          "id": "s1",
          "text": "Non esiste reset gratuito prima dell'incontro. Recupero, condizioni, inventario e squadra restano quelli prodotti dai sistemi reali."
        }
      ],
      "choices": [
        {
          "id": "prepare_roster",
          "text": "Controllo l'Official Six.",
          "goto": "roster_guard"
        },
        {
          "id": "prepare_opponent",
          "text": "Rileggo ciò che è pubblico dell'avversario.",
          "goto": "opponent_public"
        },
        {
          "id": "prepare_cynthia",
          "text": "Rileggo il principio di Cynthia sul preservare margine.",
          "goto": "cynthia_callback"
        }
      ]
    },
    "roster_guard": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il Last Chance non crea membri mancanti: servono almeno sei Pokémon nel roster strutturato quando il match parte."
        }
      ],
      "choices": [
        {
          "id": "roster_ready",
          "text": "Ho sei Pokémon: passo alla conferma.",
          "goto": "opponent_public",
          "conditions": {
            "path": "player.roster.length",
            "gte": 6
          }
        },
        {
          "id": "roster_missing",
          "text": "Non ho l'Official Six: torno alla preparazione.",
          "goto": "preparation",
          "conditions": {
            "path": "player.roster.length",
            "lt": 6
          }
        },
        {
          "id": "roster_history",
          "text": "Rivedo perché non esistono scorciatoie.",
          "goto": "history"
        }
      ]
    },
    "opponent_public": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il roster registrato dell'avversaria è pubblico; ordine, mosse e linee decisionali restano coperti dal fog of war."
        }
      ],
      "choices": [
        {
          "id": "opponent_start",
          "text": "Confermo l'incontro decisivo.",
          "goto": "handoff",
          "conditions": {
            "all": [
              {
                "path": "player.roster.length",
                "gte": 6
              },
              {
                "path": "world.flags.m7_last_chance_match_result",
                "exists": false
              }
            ]
          }
        },
        {
          "id": "opponent_prepare",
          "text": "Non entro ancora: torno alla preparazione.",
          "goto": "preparation"
        }
      ]
    },
    "handoff": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il controllo passa a Pokémon 5e/E5. Soltanto l'esito reale di questo match può aprire la qualificazione."
        }
      ],
      "choices": [
        {
          "id": "fight_last_chance",
          "text": "Combatto il Last Chance.",
          "combat": {
            "encounterId": "A7_LAST_CHANCE_FINAL",
            "opponentRegistered": true,
            "competition": {
