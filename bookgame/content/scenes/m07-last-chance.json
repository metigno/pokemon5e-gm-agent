        },
        {
          "id": "loss_review",
          "text": "Rileggo la sconfitta prima di uscire.",
          "goto": "history"
        }
      ]
    },
    "history": {
      "stitches": [
        {
          "id": "s1",
          "text": "Le due pagine restano una accanto all'altra: il Qualifier principale e l'incontro di ultima occasione, ciascuno con il proprio risultato."
        }
      ],
      "choices": [
        {
          "id": "history_prepare",
          "text": "Torno alla preparazione se il match non è ancora consumato.",
          "goto": "preparation",
          "conditions": {
            "path": "world.flags.m7_last_chance_complete",
            "ne": true
          }
        },
        {
          "id": "history_result",
          "text": "Torno al risultato ormai registrato.",
          "goto": "close",
          "conditions": {
            "path": "world.flags.m7_last_chance_complete",
            "eq": true
          }
        }
      ]
    },
    "cynthia_callback": {
      "stitches": [
        {
          "id": "s1",
          "text": "Le parole di Cynthia sul prezzo delle scelte tornano alla mente. Non promettevano una vittoria, soltanto un modo di prepararsi."
        }
      ],
      "choices": [
        {
          "id": "cynthia_prepare",
          "text": "Torno alla preparazione.",
          "goto": "preparation"
        },
        {
          "id": "cynthia_rules",
          "text": "Rileggo la regola finita.",
          "goto": "rules"
        }
      ]
    },
    "close": {
      "stitches": [
        {
          "id": "s1",
          "text": "Le luci dell'arena si abbassano. L'ultima occasione è terminata; il prossimo annuncio dipenderà dal risultato appena ottenuto."
        }
      ],
      "choices": [
        {
          "id": "close_lights",
          "text": "Sono qualificato: passo a Before the Lights.",
          "goto": "m07-before-the-lights#before_entry",
          "conditions": {
            "path": "world.flags.world_qualified",
            "eq": true
          }
        },
        {
          "id": "close_missed",
          "text": "Non sono qualificato: affronto Worlds Missed.",
          "goto": "m07-worlds-missed#missed_entry",
          "conditions": {
            "all": [
              {
                "path": "world.flags.world_qualified",
                "ne": true
              },
              {
                "path": "world.flags.m7_last_chance_result",
