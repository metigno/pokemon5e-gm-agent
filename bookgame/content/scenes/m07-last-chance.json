  "nodes": {
    "last_chance_entry": {
      "stitches": [
        {
          "id": "s1",
          "text": "L'ultimo incontro di qualificazione si disputa in un'arena più silenziosa. La sconfitta precedente è ancora sul registro: questa gara non la cancellerà."
        }
      ],
      "choices": [
        {
          "id": "entry_rules",
          "text": "Rileggo la regola finita.",
          "goto": "rules"
        },
        {
          "id": "entry_eligibility",
          "text": "Controllo che la route sia ancora legale.",
          "goto": "eligibility_guard"
        },
        {
          "id": "entry_prepare",
          "text": "Preparo l'Official Six.",
          "goto": "preparation"
        }
      ]
    },
    "rules": {
      "stitches": [
        {
          "id": "s1",
          "text": "L'arbitro ripete le condizioni: Singles, sei Pokémon ufficiali, un solo incontro decisivo. Non ci sarà un secondo tentativo."
        }
      ],
      "choices": [
        {
          "id": "rules_prepare",
          "text": "Passo alla preparazione.",
          "goto": "preparation"
        },
        {
          "id": "rules_history",
          "text": "Rivedo perché il Qualifier principale resta nella history.",
          "goto": "history"
        }
      ]
    },
    "eligibility_guard": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il tuo nome è stato ammesso perché la prima corsa è terminata e hai ricevuto accesso a questa unica possibilità. Gli addetti controllano il documento all'ingresso."
        }
      ],
      "choices": [
        {
          "id": "eligibility_roster",
          "text": "Verifico il roster corrente.",
          "goto": "roster_guard"
        },
        {
          "id": "eligibility_history",
          "text": "Rivedo la storia competitiva prima dell'ultimo tentativo.",
          "goto": "history"
        }
      ]
    },
    "preparation": {
      "stitches": [
        {
          "id": "s1",
          "text": "Prima dell'incontro puoi controllare i Pokémon e i rifornimenti. Nessuno li rimette in sesto gratuitamente solo perché la posta in gioco è alta."
        }
      ],
      "choices": [
        {
          "id": "prepare_roster",
          "text": "Controllo l'Official Six.",
          "goto": "roster_guard"
        },
        {
          "id": "prepare_opponent",
          "text": "Rileggo ciò che è pubblico dell'avversario.",
          "goto": "opponent_public"
        },
        {
          "id": "prepare_cynthia",
          "text": "Rileggo il principio di Cynthia sul preservare margine.",
          "goto": "cynthia_callback"
        }
      ]
    },
    "roster_guard": {
      "stitches": [
        {
          "id": "s1",
          "text": "La segreteria verifica che tu abbia sei Pokémon idonei. Non può completare la tua squadra con un compagno fittizio."
        }
      ],
      "choices": [
        {
          "id": "roster_ready",
          "text": "Ho sei Pokémon: passo alla conferma.",
          "goto": "opponent_public",
          "conditions": {
            "path": "player.roster.length",
            "gte": 6
          }
        },
        {
          "id": "roster_missing",
          "text": "Non ho l'Official Six: torno alla preparazione.",
          "goto": "preparation",
          "conditions": {
            "path": "player.roster.length",
            "lt": 6
          }
        },
        {
          "id": "roster_history",
          "text": "Rivedo perché non esistono scorciatoie.",
          "goto": "history"
        }
      ]
    },
    "opponent_public": {
      "stitches": [
        {
          "id": "s1",
          "text": "Sul tabellone compare la squadra registrata dell'avversaria. Puoi studiarne le specie, ma non conoscere in anticipo l'ordine o le decisioni della sua allenatrice."
        }
      ],
      "choices": [
        {
          "id": "opponent_start",
          "text": "Confermo l'incontro decisivo.",
          "goto": "handoff",
          "conditions": {
            "all": [
              {
                "path": "player.roster.length",
                "gte": 6
              },
              {
                "path": "world.flags.m7_last_chance_match_result",
                "exists": false
              }
            ]
          }
        },
        {
          "id": "opponent_prepare",
          "text": "Non entro ancora: torno alla preparazione.",
          "goto": "preparation"
        }
      ]
    },
    "handoff": {
      "stitches": [
        {
          "id": "s1",
          "text": "L'arbitro controlla le postazioni e solleva la mano. Il prossimo verdetto dipenderà dal combattimento."
        }
      ],
      "choices": [
        {
          "id": "fight_last_chance",
          "text": "Combatto il Last Chance.",
          "combat": {
            "encounterId": "A7_LAST_CHANCE_FINAL",
            "opponentRegistered": true,
