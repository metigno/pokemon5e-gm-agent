    "history": {
      "stitches": [
        {
          "id": "s1",
          "text": "competition.history conserva sia la corsa principale sia questo incontro. I flag M7 descrivono il ramo, non sostituiscono i record E5."
        }
      ],
      "choices": [
        {
          "id": "history_prepare",
          "text": "Torno alla preparazione se il match non è ancora consumato.",
          "goto": "preparation",
          "conditions": {
            "path": "world.flags.m7_last_chance_complete",
            "ne": true
          }
        },
        {
          "id": "history_result",
          "text": "Torno al risultato ormai registrato.",
          "goto": "close",
          "conditions": {
            "path": "world.flags.m7_last_chance_complete",
