            },
            {
              "type": "set_flag",
              "key": "m7_last_chance_complete",
              "value": true
            }
          ]
        },
        {
          "id": "win_history",
          "text": "Registro la vittoria e rivedo prima la history.",
          "goto": "history",
          "effects": [
            {
              "type": "set_flag",
              "key": "m7_last_chance_match_result",
              "value": "win"
            },
            {
              "type": "set_flag",
              "key": "m7_last_chance_complete",
              "value": true
            }
          ]
        }
      ]
    },
    "loss": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il monitor registra la tua sconfitta. L'avversaria ottiene il posto in palio; non c'è un altro incontro da chiedere."
        }
      ],
      "choices": [
        {
          "id": "loss_record",
          "text": "Registro la sconfitta definitiva.",
          "goto": "loss_record",
          "effects": [
            {
              "type": "set_flag",
              "key": "m7_last_chance_match_result",
              "value": "loss"
            },
            {
              "type": "set_flag",
              "key": "m7_last_chance_complete",
              "value": true
            }
          ]
        },
        {
          "id": "loss_history",
          "text": "Registro la sconfitta e rivedo la history.",
          "goto": "history",
          "effects": [
            {
              "type": "set_flag",
              "key": "m7_last_chance_match_result",
              "value": "loss"
            },
            {
              "type": "set_flag",
              "key": "m7_last_chance_complete",
              "value": true
            }
          ]
        }
      ]
    },
    "win_record": {
      "stitches": [
        {
          "id": "s1",
          "text": "L'ufficiale controlla il risultato e firma la conferma dell'ultimo posto disponibile."
        }
      ],
      "choices": [
        {
          "id": "win_commit",
          "text": "Registro world_qualified dal risultato E5.",
          "goto": "close",
          "conditions": {
            "path": "world.flags.m7_last_chance_match_result",
