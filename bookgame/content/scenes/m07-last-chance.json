            "opponentTrainerId": "LC_FINAL_IRIS_KADE",
            "opponent": {
              "species": "Metagross",
              "level": 17,
              "abilityId": "clear-body",
              "trainerId": "LC_FINAL_IRIS_KADE"
            },
            "opponentBench": [
              {
                "species": "Rotom-Wash",
                "level": 17,
                "abilityId": "levitate",
                "trainerId": "LC_FINAL_IRIS_KADE"
              },
              {
                "species": "Tyranitar",
                "level": 17,
                "abilityId": "sand-stream",
                "trainerId": "LC_FINAL_IRIS_KADE"
              },
              {
                "species": "Togekiss",
                "level": 17,
                "abilityId": "serene-grace",
                "trainerId": "LC_FINAL_IRIS_KADE"
              },
              {
                "species": "Excadrill",
                "level": 17,
                "abilityId": "mold-breaker",
                "trainerId": "LC_FINAL_IRIS_KADE"
              },
              {
                "species": "Infernape",
                "level": 17,
                "abilityId": "blaze",
                "trainerId": "LC_FINAL_IRIS_KADE"
              }
            ],
            "goto": "handoff"
          }
        }
      ]
    },
    "win": {
      "stitches": [
        {
          "id": "s1",
          "text": "La vittoria proviene dal resolver E5. La route può ora essere classificata come qualificante; il risultato principale del Qualifier resta comunque nella history."
        }
      ],
      "choices": [
        {
          "id": "win_record",
