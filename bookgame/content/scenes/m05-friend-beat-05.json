{
  "schemaVersion": 1,
  "id": "m05-friend-beat-05",
  "moduleId": "M05",
  "title": "M5_09 — Friend Beat 05",
  "locationId": "alt_town",
  "entryNodeId": "friend_call",
  "conditions": {
    "all": [
      {
        "path": "world.flags.m4_complete",
        "eq": true
      },
      {
        "path": "world.flags.m05_unlocked",
        "eq": true
      },
      {
        "path": "world.flags.m5_active",
        "eq": true
      },
      {
        "path": "competition.rank",
        "eq": "B"
      },
      {
        "path": "world.flags.five_cross_complete",
        "eq": true
      },
      {
        "path": "world.flags.friend_beat_05_available",
        "eq": true
      },
      {
        "path": "world.flags.friend_beat_05_complete",
        "ne": true
      }
    ]
  },
  "nodes": {
    "friend_call": {
      "stitches": [
        {
          "id": "call_1",
          "text": "Dopo l'incontro comune riesci a ritagliarti un momento con uno degli altri Five. Se è ancora abbastanza vicino vi parlate di persona; se i suoi impegni lo hanno già portato altrove, resta una chiamata tra due percorsi diversi."
        }
      ],
      "choices": [
        {
          "id": "dispatch_luke",
          "text": "Apro il contatto con Luke.",
          "conditions": {
            "path": "world.flags.friend_beat_05_friend_id",
            "eq": "Luke"
          },
          "goto": "luke_contact"
        },
        {
          "id": "dispatch_mattew",
          "text": "Apro il contatto con Mattew.",
          "conditions": {
            "path": "world.flags.friend_beat_05_friend_id",
            "eq": "Mattew"
          },
          "goto": "mattew_contact"
        },
        {
          "id": "dispatch_daniel",
          "text": "Apro il contatto con Daniel.",
          "conditions": {
            "path": "world.flags.friend_beat_05_friend_id",
            "eq": "Daniel"
          },
          "goto": "daniel_contact"
        },
        {
          "id": "dispatch_edward",
          "text": "Apro il contatto con Edward.",
          "conditions": {
            "path": "world.flags.friend_beat_05_friend_id",
            "eq": "Edward"
          },
          "goto": "edward_contact"
        },
        {
          "id": "dispatch_fab",
          "text": "Apro il contatto con Fab.",
          "conditions": {
            "path": "world.flags.friend_beat_05_friend_id",
            "eq": "Fab"
          },
          "goto": "fab_contact"
        }
      ]
    },
    "friend_beat_close": {
      "stitches": [
        {
          "id": "close_1",
          "text": "La conversazione si chiude senza fermare la carriera di nessuno. Vi salutate e ciascuno torna ai propri impegni, con ciò che vi siete detti ancora fresco."
        }
      ],
      "choices": [
        {
          "id": "close_friend_beat_05",
          "text": "Torno ad Altacima.",
          "goto": "m05-altacima#town_hub",
          "effects": [
            {
              "type": "set_flag",
              "key": "friend_beat_05_complete",
              "value": true
            },
            {
              "type": "set_location",
              "locationId": "alt_town"
            }
          ]
        }
      ]
    },
    "luke_contact": {
      "stitches": [
        {
          "id": "luke_c1",
          "text": "Luke è il contatto selezionato. Il tema che emerge è adattamento sotto pressione; modalità e profondità dipendono da ciò che è realmente possibile in questo momento."
        }
      ],
      "choices": [
        {
          "id": "luke_physical",
          "text": "Incontro Luke di persona.",
          "conditions": {
            "path": "world.flags.friend_beat_05_contact_mode",
            "eq": "physical"
          },
          "goto": "luke_physical_node",
          "effects": [
            {
              "type": "set_flag",
              "key": "friend_beat_05_type",
              "value": "physical"
            }
          ]
        },
        {
          "id": "luke_remote",
          "text": "Resto sul contatto remoto con Luke.",
          "conditions": {
            "path": "world.flags.friend_beat_05_contact_mode",
            "eq": "remote"
          },
          "goto": "luke_remote_node",
          "effects": [
            {
              "type": "set_flag",
              "key": "friend_beat_05_type",
              "value": "remote"
            }
          ]
        },
        {
          "id": "luke_context",
          "text": "Gli racconto cosa mi ha insegnato davvero questa salita.",
          "conditions": {
            "any": [
              {
                "path": "world.flags.ancient_mystery_layer_1",
                "exists": true
              },
              {
                "path": "world.flags.interregional_license",
                "eq": true
              },
              {
                "path": "world.flags.lance_met",
                "eq": true
              }
            ]
          },
          "goto": "luke_deep"
        }
      ]
    },
    "luke_physical_node": {
      "stitches": [
        {
          "id": "luke_p1",
          "text": "L'incontro fisico con Luke ha il peso delle pause, dello stato visibile della giornata e del fatto che entrambi dovete ripartire. Non diventa automaticamente uno sparring."
        }
      ],
      "choices": [
        {
          "id": "luke_physical_deep",
          "text": "Tengo il confronto aperto e personale.",
          "goto": "luke_deep",
          "effects": [
            {
              "type": "npc_relationship_adjust",
              "npcId": "Luke",
              "delta": 4
            },
            {
              "type": "set_flag",
              "key": "friend_beat_05_result",
              "value": "luke_deep_physical"
            }
          ]
        },
        {
          "id": "luke_physical_brief",
          "text": "Resto breve ma concreto.",
          "goto": "friend_beat_close",
          "effects": [
            {
              "type": "npc_relationship_adjust",
              "npcId": "Luke",
              "delta": 1
            },
            {
              "type": "set_flag",
              "key": "friend_beat_05_result",
              "value": "luke_brief_physical"
            }
          ]
        }
      ]
    },
    "luke_remote_node": {
      "stitches": [
        {
          "id": "luke_r1",
          "text": "La distanza con Luke resta reale. La chiamata permette di condividere decisioni e risultati, ma non finge che siate nello stesso luogo."
        }
      ],
      "choices": [
        {
          "id": "luke_remote_deep",
          "text": "Resto sulla chiamata abbastanza da andare oltre l'aggiornamento rapido.",
          "timeCostMinutes": 15,
          "goto": "luke_deep",
          "effects": [
            {
              "type": "npc_relationship_adjust",
              "npcId": "Luke",
              "delta": 3
            },
            {
              "type": "set_flag",
              "key": "friend_beat_05_result",
              "value": "luke_deep_remote"
            }
          ]
        },
        {
          "id": "luke_remote_brief",
          "text": "Ci lasciamo un aggiornamento essenziale.",
          "timeCostMinutes": 5,
          "goto": "friend_beat_close",
          "effects": [
            {
              "type": "npc_relationship_adjust",
              "npcId": "Luke",
              "delta": 1
            },
            {
              "type": "set_flag",
              "key": "friend_beat_05_result",
              "value": "luke_brief_remote"
            }
          ]
        }
      ]
    },
    "luke_deep": {
      "stitches": [
        {
          "id": "luke_d1",
          "text": "Con Luke il discorso arriva al punto in cui adattarsi smette di essere improvvisazione e diventa preparazione a più uscite possibili."
        }
      ],
      "choices": [
        {
          "id": "luke_deep_close",
          "text": "Tengo a mente quello che ci siamo detti.",
