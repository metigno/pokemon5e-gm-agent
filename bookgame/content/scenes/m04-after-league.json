{
  "schemaVersion": 1,
  "id": "m04-after-league",
  "moduleId": "M04",
  "title": "M4_14 — Dopo l'Upper Circuit",
  "locationId": "mar_city",
  "entryNodeId": "after_entry",
  "conditions": {
    "all": [
      {
        "path": "world.flags.m3_complete",
        "eq": true
      },
      {
        "path": "world.flags.m04_unlocked",
        "eq": true
      },
      {
        "path": "world.flags.m4_active",
        "eq": true
      },
      {
        "path": "competition.rankOrder",
        "gte": 3
      }
    ]
  },
  "nodes": {
    "after_entry": {
      "stitches": [
        {
          "id": "entry_1",
          "text": "Prima di lasciare Mareasale puoi ricostruire ciò che è davvero successo: l'Upper Regional, la pista logistica, Archie, l'ultimo incontro con uno dei Five e soprattutto il Rank che hai conquistato."
        }
      ],
      "choices": [
        {
          "id": "review_upper",
          "text": "Rivedo il risultato dell'Upper Regional.",
          "conditions": {
            "path": "world.flags.upper_regional_result",
            "exists": true
          },
          "goto": "upper_result"
        },
        {
          "id": "review_smuggling",
          "text": "Rivedo come si è chiusa la pista logistica.",
          "conditions": {
            "path": "world.flags.smuggling_state",
            "exists": true
          },
          "goto": "smuggling_result"
        },
        {
          "id": "review_archie",
          "text": "Rivedo cosa resta del rapporto con Archie.",
          "conditions": {
            "path": "world.flags.archie_met",
            "eq": true
          },
          "goto": "archie_result"
        },
        {
          "id": "review_friend",
          "text": "Ripenso all'ultimo incontro con uno dei Five.",
          "conditions": {
            "path": "world.flags.friend_beat_04_complete",
            "eq": true
          },
          "goto": "friend_result"
        },
        {
          "id": "review_rank",
          "text": "Controllo cosa ha davvero sbloccato il Rank.",
          "goto": "rank_result"
        },
        {
          "id": "audit_exit",
          "text": "Controllo se posso lasciare Mareasale.",
          "goto": "exit_audit"
        }
      ]
    },
    "upper_result": {
      "stitches": [
        {
          "id": "upper_1",
          "text": "Il risultato dell'Upper Regional resta separato dalla promozione. Puoi aver vinto, raggiunto la finale, essere stato eliminato, esserti ritirato, aver concesso un incontro o non esserti iscritto affatto."
        }
      ],
      "choices": [
        {
          "id": "upper_winner",
          "text": "Il risultato è winner: conservo il titolo senza trasformarlo in Rank B.",
          "conditions": {
            "path": "world.flags.upper_regional_result",
            "eq": "winner"
          },
          "goto": "after_entry",
          "effects": [
            {
              "type": "set_flag",
              "key": "m4_upper_reviewed",
              "value": true
            }
          ]
        },
        {
          "id": "upper_finalist",
          "text": "Il risultato è finalist: registro il piazzamento.",
          "conditions": {
            "path": "world.flags.upper_regional_result",
            "eq": "finalist"
          },
          "goto": "after_entry",
          "effects": [
            {
              "type": "set_flag",
              "key": "m4_upper_reviewed",
              "value": true
            }
          ]
        },
        {
          "id": "upper_semifinal",
          "text": "Il risultato è semifinal: registro l'eliminazione.",
          "conditions": {
            "path": "world.flags.upper_regional_result",
            "eq": "semifinal"
          },
          "goto": "after_entry",
          "effects": [
            {
              "type": "set_flag",
              "key": "m4_upper_reviewed",
              "value": true
            }
          ]
        },
        {
          "id": "upper_qf",
          "text": "Il risultato è quarterfinal: registro l'eliminazione.",
          "conditions": {
            "path": "world.flags.upper_regional_result",
            "eq": "quarterfinal"
          },
          "goto": "after_entry",
          "effects": [
            {
              "type": "set_flag",
              "key": "m4_upper_reviewed",
              "value": true
            }
          ]
        },
        {
          "id": "upper_skipped",
          "text": "Non hai partecipato: il torneo è proseguito senza di te.",
          "conditions": {
            "path": "world.flags.upper_regional_result",
            "eq": "skipped"
          },
          "goto": "after_entry",
          "effects": [
            {
              "type": "set_flag",
              "key": "m4_upper_reviewed",
              "value": true
            }
          ]
        },
        {
          "id": "upper_withdrew",
          "text": "Il risultato è withdrew: conservo il ritiro come scelta reale.",
          "conditions": {
            "path": "world.flags.upper_regional_result",
            "eq": "withdrew"
          },
          "goto": "after_entry",
          "effects": [
            {
              "type": "set_flag",
              "key": "m4_upper_reviewed",
              "value": true
            }
          ]
        },
        {
          "id": "upper_forfeit",
          "text": "Ti sei ritirato prima dell'incontro: il ritiro resta tale e non viene trasformato in una lotta mai disputata.",
          "conditions": {
            "path": "world.flags.upper_regional_result",
            "eq": "forfeited"
          },
          "goto": "after_entry",
          "effects": [
            {
              "type": "set_flag",
              "key": "m4_upper_reviewed",
              "value": true
            }
          ]
        }
      ]
    },
    "smuggling_result": {
      "stitches": [
        {
          "id": "smug_1",
          "text": "La costa ricorderà se hai documentato una rotta, aiutato un'intercettazione, attivato monitoraggio, trovato prove insufficienti, ignorato la pista o lasciato che il mondo la risolvesse senza di te."
        }
      ],
      "choices": [
        {
          "id": "smug_record",
          "text": "Conservo l'esito senza riscriverlo.",
          "goto": "after_entry",
          "effects": [
            {
              "type": "set_flag",
              "key": "m4_smuggling_reviewed",
              "value": true
            }
          ]
        }
      ]
    },
    "archie_result": {
      "stitches": [
        {
          "id": "archie_1",
          "text": "Archie non è un trofeo da spuntare. Qualunque rapporto abbiate costruito, riprende la propria strada con le sue convinzioni e può tornare a incrociare la tua in futuro."
        }
      ],
      "choices": [
        {
          "id": "archie_record",
          "text": "Conservo il rapporto così com'è.",
          "goto": "after_entry",
          "effects": [
            {
              "type": "set_flag",
              "key": "m4_archie_reviewed",
              "value": true
            }
          ]
        }
      ]
    },
    "friend_result": {
      "stitches": [
        {
          "id": "friend_1",
          "text": "L'ultimo contatto con uno dei Five ha avuto un volto, un luogo e una conversazione precisa. Non viene ridotto a un generico messaggio di gruppo."
        }
      ],
      "choices": [
        {
          "id": "friend_record",
          "text": "Tengo a mente la conversazione e torno al riepilogo.",
          "goto": "after_entry",
          "effects": [
            {
              "type": "set_flag",
              "key": "m4_friend_reviewed",
              "value": true
            }
          ]
        }
      ]
    },
    "rank_result": {
      "stitches": [
        {
          "id": "rank_1",
          "text": "Se sulla tessera compare Rank B, lo hai ottenuto vincendo il Trial C→B. Titoli, conoscenze o piazzamenti in altre competizioni non possono sostituire quella prova."
        }
      ],
      "choices": [
        {
          "id": "rank_b_note",
          "text": "Controllo le nuove autorizzazioni del Rank B.",
          "conditions": {
            "path": "competition.rank",
            "eq": "B"
          },
          "goto": "after_entry",
          "effects": [
            {
              "type": "set_flag",
              "key": "m4_rank_reviewed",
              "value": true
            }
          ]
        },
        {
          "id": "rank_c_trial",
          "text": "Sono ancora Rank C: torno al Promotion Trial.",
          "conditions": {
            "path": "competition.rank",
            "eq": "C"
          },
          "goto": "m04-trial-registration#trial_info",
          "effects": [
            {
              "type": "set_location",
              "locationId": "mar_city_arena"
            }
          ]
        }
      ]
    },
    "exit_audit": {
      "stitches": [
        {
          "id": "audit_1",
          "text": "Prima della partenza controlli che non restino questioni indispensabili aperte: Rank B ottenuto, incontro con Archie, contatto con uno dei Five, esito dell'Upper Regional e conclusione della pista sul contrabbando."
        }
      ],
      "choices": [
        {
          "id": "complete_m4",
          "text": "È tutto sistemato. Preparo la partenza da Mareasale.",
          "conditions": {
            "all": [
              {
                "path": "competition.rank",
                "eq": "B"
              },
              {
                "path": "world.flags.archie_met",
                "eq": true
              },
              {
                "path": "world.flags.friend_beat_04_complete",
                "eq": true
              },
              {
                "path": "world.flags.upper_regional_result",
                "exists": true
              },
              {
                "path": "world.flags.smuggling_state",
                "exists": true
              }
            ]
          },
          "goto": "module_complete",
          "effects": [
            {
              "type": "set_flag",
              "key": "m4_complete",
              "value": true
            },
            {
              "type": "set_flag",
              "key": "m05_unlocked",
              "value": true
            },
            {
              "type": "set_flag",
              "key": "m4_outcome_complete",
              "value": true
            },
            {
              "type": "trainer_milestone_level",
              "milestoneId": "M04_COMPLETE",
              "level": 12
            }
          ]
        },
        {
          "id": "missing_rank",
          "text": "Manca Rank B: torno al Trial C→B.",
          "conditions": {
            "path": "competition.rank",
            "eq": "C"
          },
          "goto": "m04-trial-registration#trial_info",
          "effects": [
            {
              "type": "set_location",
              "locationId": "mar_city_arena"
            }
          ]
        },
        {
          "id": "missing_archie",
          "text": "Non ho ancora incontrato Archie.",
          "conditions": {
            "path": "world.flags.archie_met",
            "ne": true
          },
          "goto": "m04-archie-enters#deferred_intro",
          "effects": [
            {
              "type": "set_flag",
              "key": "archie_contact_deferred",
              "value": true
            },
            {
              "type": "set_location",
              "locationId": "mar_city_weather"
            }
          ]
        },
        {
          "id": "missing_friend",
          "text": "Prima di partire, devo ancora sentire uno dei miei amici.",
          "conditions": {
            "path": "world.flags.friend_beat_04_complete",
            "ne": true
          },
          "goto": "m04-friend-beat-04#friend_call"
        },
        {
          "id": "missing_upper_registered",
          "text": "L'Upper Regional è registrato ma non risolto.",
          "conditions": {
            "all": [
              {
                "path": "world.flags.upper_regional_result",
                "exists": false
              },
              {
                "path": "world.flags.upper_regional_registration_complete",
                "eq": true
              }
            ]
          },
          "goto": "m04-upper-regional#circuit_board",
          "effects": [
            {
              "type": "set_location",
              "locationId": "mar_city_arena"
            }
          ]
        },
        {
          "id": "missing_upper_unregistered",
          "text": "Devo ancora risolvere la scelta Upper Regional.",
          "conditions": {
            "all": [
              {
                "path": "world.flags.upper_regional_result",
                "exists": false
              },
              {
                "path": "world.flags.upper_regional_registration_complete",
                "ne": true
              }
            ]
          },
          "goto": "m04-league-registration#registration_hall",
          "effects": [
            {
              "type": "set_location",
              "locationId": "mar_city_arena"
            }
          ]
        },
        {
          "id": "missing_smuggling",
          "text": "Prima di partire, devo ancora chiarire come si è conclusa la pista logistica.",
          "conditions": {
            "path": "world.flags.smuggling_state",
            "exists": false
          },
          "goto": "smuggling_missing"
        }
      ]
    },
    "smuggling_missing": {
      "stitches": [
        {
          "id": "smug_missing_1",
          "text": "La pista può essere ancora aperta, non essersi ancora presentata oppure essere vicina a una svolta. Non puoi darle una conclusione soltanto per poter partire."
        }
      ],
      "choices": [
        {
          "id": "smug_thread",
          "text": "Torno alla pista attiva.",
          "conditions": {
            "path": "world.flags.smuggling_thread_available",
            "eq": true
          },
          "goto": "m04-smuggling-thread#thread_entry",
          "effects": [
            {
              "type": "set_location",
              "locationId": "mar_city"
            }
          ]
        },
        {
          "id": "smug_pressure",
          "text": "Torno a raccogliere segnali nel porto.",
          "conditions": {
            "path": "world.flags.smuggling_thread_available",
            "ne": true
          },
          "goto": "m04-port-pressure#pressure_board",
          "effects": [
            {
              "type": "set_location",
              "locationId": "mar_city_cargo"
            }
          ]
        },
        {
          "id": "smug_back",
          "text": "Torno al riepilogo.",
          "goto": "after_entry"
        }
      ]
    },
    "module_complete": {
      "stitches": [
        {
          "id": "complete_1",
          "text": "Con il Rank B sulla tessera e le questioni di Mareasale alle spalle, puoi proseguire. La squadra, ciò che possiedi, i risultati ottenuti e i rapporti costruiti viaggiano con te."
        }
      ],
      "choices": [
        {
          "id": "complete_m5",
          "text": "Parto verso la prossima tappa della carriera.",
          "goto": "m05-handoff#m05_entry",
          "effects": [
            {
              "type": "set_location",
              "locationId": "mar_city"
            }
          ]
        },
        {
          "id": "complete_hub",
          "text": "Resto ancora un po' a Mareasale.",
          "goto": "m04-mareasale-arrival#city_hub",
          "effects": [
            {
              "type": "set_location",
              "locationId": "mar_city"
            }
          ]
        },
        {
          "id": "complete_review",
          "text": "Rileggo il riepilogo prima di partire.",
          "goto": "after_entry"
        }
      ]
    }
  }
}
