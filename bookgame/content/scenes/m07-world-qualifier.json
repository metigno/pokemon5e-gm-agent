        "eq": true
      },
      {
        "path": "world.flags.m7_active",
        "eq": true
      },
      {
        "path": "competition.rank",
        "eq": "S"
      },
      {
        "path": "world.flags.m7_qualifier_registered",
        "eq": true
      }
    ]
  },
  "nodes": {
    "qualifier_entry": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il Qualifier ti mette davanti a due incontri. Devi vincere il primo per raggiungere quello decisivo; una sconfitta interrompe il percorso."
        }
      ],
      "choices": [
        {
          "id": "entry_bracket",
          "text": "Apro la mia lane del bracket.",
          "goto": "bracket"
        },
        {
          "id": "entry_rules",
          "text": "Rileggo il formato ufficiale.",
          "goto": "rules"
        },
        {
          "id": "entry_defer",
          "text": "Non inizio ancora il primo match.",
          "goto": "m07-qualifier-registration#registered"
        }
      ]
    },
    "rules": {
      "stitches": [
        {
          "id": "s1",
          "text": "L'arbitro espone il regolamento: Singles, sei Pokémon ufficiali, un percorso senza ripetizioni dello stesso turno."
        }
      ],
      "choices": [
        {
          "id": "rules_bracket",
          "text": "Torno al bracket.",
          "goto": "bracket"
        },
        {
          "id": "rules_field",
          "text": "Controllo cosa è pubblico del field.",
          "goto": "field"
        }
      ]
    },
    "bracket": {
      "stitches": [
        {
          "id": "s1",
          "text": "Sul tabellone sono segnate due tappe. La seconda resta vuota per te finché non avrai vinto la prima."
        }
      ],
      "choices": [
        {
          "id": "bracket_round1",
          "text": "Preparo il Round 1.",
          "goto": "round1_preview"
        },
        {
          "id": "bracket_field",
          "text": "Rivedo il field pubblico.",
          "goto": "field"
        },
        {
          "id": "bracket_review",
          "text": "Controllo come verranno registrati gli esiti.",
          "goto": "bracket_review"
        }
      ]
    },
    "field": {
      "stitches": [
        {
          "id": "s1",
          "text": "Gli addetti mostrano i roster registrati. Conoscere le specie degli avversari non significa conoscerne le decisioni future."
        }
      ],
      "choices": [
        {
          "id": "field_round1",
          "text": "Torno alla preparazione del Round 1.",
          "goto": "round1_preview"
        },
        {
          "id": "field_rules",
          "text": "Rileggo il formato.",
          "goto": "rules"
        }
      ]
    },
    "round1_preview": {
      "stitches": [
        {
          "id": "s1",
          "text": "Leggi il nome del primo avversario. Prima dell'accesso l'arbitro controllerà che tu possa presentare sei Pokémon."
        }
      ],
      "choices": [
        {
          "id": "round1_roster",
          "text": "Rileggo l'Official Six richiesto.",
          "goto": "round1_confirm"
        },
        {
          "id": "round1_ready",
          "text": "Sono pronto alla conferma.",
          "goto": "round1_confirm"
        },
        {
          "id": "round1_back",
          "text": "Torno al bracket.",
          "goto": "bracket"
        }
      ]
    },
    "round1_confirm": {
      "stitches": [
        {
          "id": "s1",
          "text": "All'ingresso la commissione verifica accredito, squadra e orario. Se il match è già stato disputato non puoi ricominciare soltanto per cambiarne il risultato."
        }
      ],
      "choices": [
        {
          "id": "round1_start",
          "text": "Avvio il Round 1.",
          "goto": "round1_handoff",
          "conditions": {
            "all": [
              {
                "path": "player.roster.length",
                "gte": 6
              },
              {
                "path": "world.flags.m7_qualifier_round1_result",
