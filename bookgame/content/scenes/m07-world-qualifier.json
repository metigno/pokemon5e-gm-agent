{
  "schemaVersion": 1,
  "id": "m07-world-qualifier",
  "moduleId": "M07",
  "title": "M7_07 — World Qualifier",
  "locationId": "meridiana_grand_arena",
  "entryNodeId": "qualifier_entry",
  "conditions": {
    "all": [
      {
        "path": "world.flags.m6_complete",
        "eq": true
