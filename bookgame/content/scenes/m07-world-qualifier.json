      {
        "path": "world.flags.m07_unlocked",
        "eq": true
      },
      {
        "path": "world.flags.m7_active",
        "eq": true
      },
      {
        "path": "competition.rank",
        "eq": "S"
      },
      {
        "path": "world.flags.m7_qualifier_registered",
        "eq": true
      }
    ]
  },
  "nodes": {
    "qualifier_entry": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il World Qualifier usa una lane a due match in questa istanza: vincere il primo apre il match di qualificazione; perdere chiude il percorso principale."
        }
      ],
      "choices": [
        {
          "id": "entry_bracket",
          "text": "Apro la mia lane del bracket.",
          "goto": "bracket"
        },
        {
          "id": "entry_rules",
          "text": "Rileggo il formato ufficiale.",
          "goto": "rules"
        },
        {
          "id": "entry_defer",
          "text": "Non inizio ancora il primo match.",
          "goto": "m07-qualifier-registration#registered"
        }
      ]
    },
    "rules": {
      "stitches": [
        {
          "id": "s1",
          "text": "Entrambi i match sono Singles Official Six ELITE. Non esistono retry interni: una sconfitta passa al risultato e, se previsto, al Last Chance."
        }
      ],
      "choices": [
        {
          "id": "rules_bracket",
          "text": "Torno al bracket.",
          "goto": "bracket"
        },
        {
          "id": "rules_field",
          "text": "Controllo cosa è pubblico del field.",
          "goto": "field"
        }
      ]
    },
    "bracket": {
      "stitches": [
        {
          "id": "s1",
          "text": "La lane mostra Round 1 e Qualifying Match. Il secondo nodo è accessibile solo dopo una vittoria reale nel primo."
        }
      ],
      "choices": [
        {
          "id": "bracket_round1",
          "text": "Preparo il Round 1.",
          "goto": "round1_preview"
        },
        {
          "id": "bracket_field",
          "text": "Rivedo il field pubblico.",
          "goto": "field"
        },
        {
          "id": "bracket_review",
          "text": "Controllo come verranno registrati gli esiti.",
          "goto": "bracket_review"
        }
      ]
    },
    "field": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il roster avversario pubblico è noto, ma ordine, tattiche e decisioni restano coperte. Nessun matchup viene riscritto per favorire la trama."
        }
      ],
      "choices": [
        {
          "id": "field_round1",
          "text": "Torno alla preparazione del Round 1.",
          "goto": "round1_preview"
        },
        {
          "id": "field_rules",
          "text": "Rileggo il formato.",
          "goto": "rules"
        }
      ]
    },
    "round1_preview": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il primo avversario è registrato nel field reale della lane. Il player deve presentarsi con almeno sei Pokémon nel roster corrente."
        }
      ],
      "choices": [
        {
          "id": "round1_roster",
          "text": "Rileggo l'Official Six richiesto.",
          "goto": "round1_confirm"
        },
        {
          "id": "round1_ready",
          "text": "Sono pronto alla conferma.",
          "goto": "round1_confirm"
        },
        {
          "id": "round1_back",
          "text": "Torno al bracket.",
          "goto": "bracket"
        }
      ]
    },
    "round1_confirm": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il match parte soltanto se la registrazione è valida, il roster contiene almeno sei Pokémon e non esiste già un risultato Round 1."
        }
      ],
      "choices": [
        {
          "id": "round1_start",
          "text": "Avvio il Round 1.",
          "goto": "round1_handoff",
          "conditions": {
            "all": [
              {
                "path": "player.roster.length",
