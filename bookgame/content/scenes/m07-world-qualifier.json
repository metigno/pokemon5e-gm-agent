  "nodes": {
    "qualifier_entry": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il tabellone mostra due incontri sulla tua strada. Una linea collega il primo al secondo: soltanto vincendo la sfida iniziale raggiungerai quella decisiva."
        }
      ],
      "choices": [
        {
          "id": "entry_bracket",
          "text": "Controllo il tabellone degli incontri.",
          "goto": "bracket"
        },
        {
          "id": "entry_rules",
          "text": "Rileggo il formato ufficiale.",
          "goto": "rules"
        },
        {
          "id": "entry_defer",
          "text": "Non inizio ancora il primo match.",
          "goto": "m07-qualifier-registration#registered"
        }
      ]
    },
    "rules": {
      "stitches": [
        {
          "id": "s1",
          "text": "L'arbitro riunisce gli allenatori. «Due incontri singoli, sei Pokémon per parte. Chi perde esce da questo percorso. Non ci sono rivincite immediate.»"
        }
      ],
      "choices": [
        {
          "id": "rules_bracket",
          "text": "Torno al tabellone.",
          "goto": "bracket"
        },
        {
          "id": "rules_field",
          "text": "Controllo cosa è pubblico del elenco degli avversari.",
          "goto": "field"
        }
      ]
    },
    "bracket": {
      "stitches": [
        {
          "id": "s1",
          "text": "Sul monitor si illuminano il primo turno e l'incontro di qualificazione. Il secondo spazio attende ancora il nome di chi avanzerà."
        }
      ],
      "choices": [
        {
          "id": "bracket_round1",
          "text": "Preparo il Round 1.",
          "goto": "round1_preview"
        },
        {
          "id": "bracket_field",
          "text": "Rivedo il elenco degli avversari pubblico.",
          "goto": "field"
        },
        {
          "id": "bracket_review",
          "text": "Controllo come verranno registrati gli esiti.",
          "goto": "bracket_review"
        }
      ]
    },
    "field": {
      "stitches": [
        {
          "id": "s1",
          "text": "Accanto al tabellone sono pubblicati i Pokémon iscritti dagli avversari. Nessuno rivela l'ordine di entrata o le tattiche che useranno."
        }
      ],
      "choices": [
        {
          "id": "field_round1",
          "text": "Torno alla preparazione del Round 1.",
          "goto": "round1_preview"
        },
        {
          "id": "field_rules",
          "text": "Rileggo il formato.",
          "goto": "rules"
        }
      ]
    },
    "round1_preview": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il primo avversario attende vicino all'ingresso degli atleti. Un addetto controlla la tua lista di sei Pokémon prima di aprire il passaggio."
        }
      ],
      "choices": [
        {
          "id": "round1_roster",
          "text": "Rileggo l'squadra di sei Pokémon richiesto.",
          "goto": "round1_confirm"
        },
        {
          "id": "round1_ready",
          "text": "Sono pronto alla conferma.",
          "goto": "round1_confirm"
        },
        {
          "id": "round1_back",
          "text": "Torno al tabellone.",
          "goto": "bracket"
        }
      ]
    },
    "round1_confirm": {
      "stitches": [
        {
