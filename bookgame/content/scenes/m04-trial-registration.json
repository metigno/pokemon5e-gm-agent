{
  "schemaVersion": 1,
  "id": "m04-trial-registration",
  "moduleId": "M04",
  "title": "M4_12 — Registrazione Promotion Trial C→B",
  "locationId": "mar_city_arena",
  "entryNodeId": "trial_info",
  "conditions": {
    "all": [
      {
        "path": "world.flags.m3_complete",
        "eq": true
      },
      {
        "path": "world.flags.m04_unlocked",
        "eq": true
      },
      {
        "path": "world.flags.m4_active",
        "eq": true
      },
      {
        "path": "competition.rank",
        "eq": "C"
      },
      {
        "path": "world.flags.a4_rank_trial_c_b_available",
        "eq": true
      }
    ]
  },
  "nodes": {
    "trial_info": {
      "stitches": [
        {
          "id": "info_1",
          "text": "Il Promotion Trial di Mareasale è il gate obbligatorio C→B. L'Upper Regional può averti dato esperienza, risultati o reputazione, ma nessun piazzamento può sostituire questo checkpoint."
        },
        {
          "id": "info_2",
          "text": "L'addetta indica il regolamento: lotta in Singolo, un esaminatore e quattro Pokémon registrati per parte. Una sconfitta lascia invariato il Rank C; sarà possibile iscriversi a un nuovo tentativo."
        }
      ],
      "choices": [
        {
          "id": "go_desk",
          "text": "Vado al banco di registrazione.",
          "goto": "trial_desk"
        },
        {
          "id": "format_review",
          "text": "Rivedo il formato e cosa viene valutato.",
          "goto": "format_review"
        },
        {
          "id": "eligibility_audit",
          "text": "Controllo la mia idoneità al Trial.",
          "goto": "eligibility_audit"
        },
        {
          "id": "registered_status",
          "text": "Controllo la registrazione già attiva.",
          "conditions": {
            "path": "competition.trials.RANK_C_TO_B.registered",
            "eq": true
          },
          "goto": "registered"
        },
        {
          "id": "attempt_history",
          "text": "Rivedo i tentativi precedenti.",
          "conditions": {
            "path": "competition.trials.RANK_C_TO_B.attempts",
            "gte": 1
          },
          "goto": "attempt_history"
        },
        {
          "id": "postpone",
          "text": "Non mi registro adesso.",
          "goto": "postponed"
        }
      ]
    },
    "eligibility_audit": {
      "stitches": [
        {
          "id": "audit_1",
          "text": "L'addetto controlla la tessera e la squadra. «Per il Trial C→B servono Rank C e almeno quattro Pokémon disponibili.»"
        }
      ],
      "choices": [
        {
          "id": "sync_trial_state",
          "text": "Presento tessera e squadra per il controllo.",
          "conditions": {
            "path": "competition.trials.RANK_C_TO_B.available",
            "ne": true
          },
          "goto": "trial_desk",
          "effects": [
            {
              "type": "competition_trial_available",
              "checkpointId": "RANK_C_TO_B",
              "fromRank": "C",
              "toRank": "B",
              "requiredRosterSize": 4,
              "retryable": true
            }
          ]
        },
        {
          "id": "audit_ready",
          "text": "L'idoneità è già stata confermata.",
          "conditions": {
            "path": "competition.trials.RANK_C_TO_B.available",
            "eq": true
          },
          "goto": "trial_desk"
        },
        {
          "id": "audit_back",
          "text": "Torno alle informazioni.",
          "goto": "trial_info"
        }
      ]
    },
    "format_review": {
      "stitches": [
        {
          "id": "format_1",
          "text": "Il tema dell'esame è resource management e adattamento: non basta trovare una linea forte, devi sapere cosa conservare, cosa spendere e quando abbandonare un piano diventato obsoleto."
        }
      ],
      "choices": [
        {
          "id": "format_roster",
          "text": "Chiedo come funziona la registrazione dei quattro Pokémon.",
          "goto": "roster_review"
        },
        {
          "id": "format_examiner",
          "text": "Chiedo il profilo pubblico dell'esaminatrice.",
          "goto": "examiner_review"
        },
        {
          "id": "format_upper",
          "text": "Confronto il Trial con l'Upper Regional.",
          "conditions": {
            "path": "world.flags.upper_regional_result",
            "exists": true
          },
          "goto": "upper_context"
        },
        {
          "id": "format_back",
          "text": "Torno alle informazioni.",
          "goto": "trial_info"
        }
      ]
    },
    "trial_desk": {
      "stitches": [
        {
          "id": "desk_1",
          "text": "Al banco controllano la tessera e i Pokémon realmente disponibili. Titoli e piazzamenti ottenuti altrove non sostituiscono i requisiti del Trial."
        }
      ],
      "choices": [
        {
          "id": "register_now",
          "text": "Registro il roster per il Trial C→B.",
          "conditions": {
            "all": [
              {
                "path": "competition.trials.RANK_C_TO_B.available",
                "eq": true
              },
              {
                "path": "competition.trials.RANK_C_TO_B.registered",
                "ne": true
              },
              {
                "path": "player.roster.length",
                "gte": 4
              }
            ]
          },
          "goto": "registered",
          "effects": [
            {
              "type": "competition_trial_register",
              "checkpointId": "RANK_C_TO_B"
            }
          ]
        },
        {
          "id": "check_roster",
          "text": "Controllo se ho almeno quattro Pokémon.",
          "goto": "roster_review"
        },
        {
          "id": "examiner_info",
          "text": "Chiedo il profilo pubblico dell'esaminatrice.",
          "goto": "examiner_review"
        },
        {
          "id": "resource_prep",
          "text": "Rivedo il tema resource management prima di firmare.",
          "goto": "strategy_review"
        },
        {
          "id": "desk_back",
          "text": "Mi allontano senza registrarmi.",
          "goto": "postponed"
        }
      ]
    },
    "roster_review": {
      "stitches": [
        {
          "id": "roster_1",
          "text": "La scheda mostra i quattro Pokémon previsti per l'incontro. Il controllo non cura, non riordina e non modifica la squadra."
        }
      ],
      "choices": [
        {
          "id": "roster_ok_register",
          "text": "Ho quattro Pokémon: registro.",
          "conditions": {
            "all": [
              {
                "path": "competition.trials.RANK_C_TO_B.available",
                "eq": true
              },
              {
                "path": "competition.trials.RANK_C_TO_B.registered",
                "ne": true
              },
              {
                "path": "player.roster.length",
                "gte": 4
              }
            ]
          },
          "goto": "registered",
          "effects": [
            {
              "type": "competition_trial_register",
              "checkpointId": "RANK_C_TO_B"
            }
          ]
        },
        {
          "id": "roster_short",
          "text": "Non ho ancora quattro Pokémon: torno a prepararmi.",
          "conditions": {
            "path": "player.roster.length",
            "lt": 4
          },
          "goto": "postponed"
        },
        {
          "id": "roster_desk",
          "text": "Torno al banco.",
          "goto": "trial_desk"
        }
      ]
    },
    "examiner_review": {
      "stitches": [
        {
          "id": "examiner_1",
          "text": "Nerea Voss è l'esaminatrice assegnata al Trial C→B. La sua squadra per questa fascia è già registrata e non cambia in base ai tuoi tentativi."
        }
      ],
      "choices": [
        {
          "id": "examiner_strategy",
          "text": "Chiedo cosa può essere detto pubblicamente sul criterio di valutazione.",
          "goto": "strategy_review"
        },
        {
          "id": "examiner_desk",
          "text": "Torno al banco.",
          "goto": "trial_desk"
        }
      ]
    },
    "strategy_review": {
      "stitches": [
        {
          "id": "strategy_1",
          "text": "Non ricevi mosse segrete dell'esaminatrice. Puoi solo decidere quale principio portare nel match: preservare risorse, convertire vantaggi o mantenere un piano B credibile."
        }
      ],
      "choices": [
        {
          "id": "strategy_preserve",
          "text": "Segno la conservazione delle risorse come priorità.",
          "goto": "trial_desk",
          "effects": [
            {
              "type": "set_flag",
              "key": "trial_c_b_prep_focus",
              "value": "preserve_resources"
            }
          ]
        },
        {
          "id": "strategy_convert",
          "text": "Segno la conversione del vantaggio come priorità.",
          "goto": "trial_desk",
          "effects": [
            {
              "type": "set_flag",
              "key": "trial_c_b_prep_focus",
              "value": "convert_advantage"
            }
          ]
        },
        {
          "id": "strategy_adapt",
          "text": "Segno l'adattamento come priorità.",
          "goto": "trial_desk",
          "effects": [
            {
              "type": "set_flag",
              "key": "trial_c_b_prep_focus",
              "value": "adaptation"
            }
          ]
        },
        {
          "id": "strategy_maxie",
          "text": "Ripenso al principio infrastrutturale di Maxie.",
          "conditions": {
            "path": "world.flags.maxie_trial_resource_note",
            "eq": true
          },
          "goto": "maxie_context"
        },
        {
          "id": "strategy_archie",
          "text": "Ripenso al principio di Archie sul movimento e sul margine.",
          "conditions": {
            "path": "world.flags.archie_met",
            "eq": true
          },
          "goto": "archie_context"
        }
      ]
    },
    "maxie_context": {
      "stitches": [
        {
          "id": "maxie_1",
          "text": "Maxie aveva descritto HP, PP, informazioni e switch come infrastruttura: una risorsa spesa deve comprare qualcosa di reale, non solo far sembrare buono un turno."
        }
      ],
      "choices": [
        {
          "id": "maxie_note",
          "text": "Porto quel criterio nel piano.",
          "goto": "trial_desk",
          "effects": [
            {
              "type": "set_flag",
              "key": "trial_c_b_maxie_context_reviewed",
              "value": true
            }
          ]
        }
      ]
    },
    "archie_context": {
      "stitches": [
        {
          "id": "archie_1",
          "text": "Archie aveva insistito sul movimento: un piano che non reagisce al sistema reale smette di essere un piano. Il Trial misura anche quando accetti di cambiare linea."
        }
      ],
      "choices": [
        {
          "id": "archie_note",
          "text": "Porto quel criterio nel piano.",
          "goto": "trial_desk",
          "effects": [
            {
              "type": "set_flag",
              "key": "trial_c_b_archie_context_reviewed",
              "value": true
            }
          ]
        }
      ]
    },
    "upper_context": {
      "stitches": [
        {
          "id": "upper_1",
          "text": "Il tuo piazzamento nel torneo regionale resta nel record del Circuito, ma non modifica l'esame. Nerea userà lo stesso formato previsto per ogni candidato Rank C."
        }
      ],
      "choices": [
        {
          "id": "upper_note",
          "text": "Registro la separazione fra bracket e gate.",
          "goto": "format_review",
          "effects": [
            {
              "type": "set_flag",
              "key": "trial_c_b_upper_context_reviewed",
              "value": true
            }
          ]
        }
      ]
    },
    "registered": {
      "stitches": [
        {
          "id": "registered_1",
          "text": "L'addetto timbra l'iscrizione. Puoi entrare nell'Arena adesso oppure tornare più tardi; lasciare l'edificio non annulla la registrazione."
        }
      ],
      "choices": [
        {
          "id": "enter_trial",
          "text": "Entro nel Promotion Trial C→B.",
          "conditions": {
            "path": "competition.trials.RANK_C_TO_B.registered",
            "eq": true
          },
          "goto": "m04-promotion-trial-c-b#trial_gate_call"
        },
        {
          "id": "registered_prep",
          "text": "Rivedo un'ultima volta il piano.",
          "goto": "strategy_review"
        },
        {
          "id": "registered_examiner",
          "text": "Rivedo il profilo dell'esaminatrice.",
          "goto": "examiner_review"
        },
        {
          "id": "registered_hub",
          "text": "Torno a Mareasale e rientrerò più tardi.",
          "goto": "m04-mareasale-arrival#city_hub",
          "effects": [
            {
              "type": "set_location",
              "locationId": "mar_city"
            }
          ]
        }
      ]
    },
    "attempt_history": {
      "stitches": [
        {
          "id": "attempt_1",
          "text": "Sul registro restano anche gli eventuali tentativi precedenti. Una nuova iscrizione non cancella una sconfitta già avvenuta."
        }
      ],
      "choices": [
        {
          "id": "attempt_desk",
          "text": "Torno al banco.",
          "goto": "trial_desk",
          "effects": [
            {
              "type": "set_flag",
              "key": "trial_c_b_attempt_history_reviewed",
              "value": true
            }
          ]
        },
        {
          "id": "attempt_strategy",
          "text": "Rivedo cosa cambiare nel prossimo tentativo.",
          "goto": "strategy_review",
          "effects": [
            {
              "type": "set_flag",
              "key": "trial_c_b_attempt_history_reviewed",
              "value": true
            }
          ]
        }
      ]
    },
    "postponed": {
      "stitches": [
        {
          "id": "post_1",
          "text": "Finché resti Rank C potrai tornare a iscriverti nelle finestre previste. Rinviare, però, non ferma il porto, gli altri Allenatori o le questioni che hai lasciato aperte."
        }
      ],
      "choices": [
        {
          "id": "post_hub",
          "text": "Torno a Mareasale.",
          "goto": "m04-mareasale-arrival#city_hub",
          "effects": [
            {
              "type": "set_location",
              "locationId": "mar_city"
            }
          ]
        },
        {
          "id": "post_desk",
          "text": "Cambio idea e torno al banco.",
          "goto": "trial_desk"
        }
      ]
    }
  }
}
