{
  "schemaVersion": 1,
  "id": "m06-red-enters",
  "moduleId": "M06",
  "title": "M6_03 — Red Enters",
  "locationId": "interregional_circuit",
  "entryNodeId": "red_entry",
  "conditions": {
    "all": [
      {
        "path": "world.flags.m5_complete",
        "eq": true
      },
      {
        "path": "world.flags.m06_unlocked",
        "eq": true
      },
      {
        "path": "world.flags.m6_active",
        "eq": true
      },
      {
        "path": "competition.rank",
        "eq": "A"
      },
      {
        "path": "world.flags.m6_interregional_travel_complete",
        "eq": true
      }
    ]
  },
  "nodes": {
    "red_entry": {
      "stitches": [
        {
          "id": "s1",
          "text": "Vicino al tabellone Masters, un ragazzo con il berretto rosso segue i risultati senza unirsi alla folla. Un allenatore lo riconosce e rallenta il passo. Red solleva appena gli occhi dal monitor."
        }
      ],
      "choices": [
        {
          "id": "red_introduce",
          "text": "Mi presento.",
          "goto": "first_exchange",
          "conditions": {
            "path": "world.flags.red_met",
            "ne": true
          },
          "effects": [
            {
              "type": "npc_register",
              "npcId": "Red",
              "name": "Red",
              "relationshipScore": 0,
              "state": {
                "introduced": true,
                "context": "interregional_circuit",
                "role": "interregional_anchor"
              }
            },
            {
              "type": "set_flag",
              "key": "red_met",
              "value": true
            }
          ]
        },
        {
          "id": "red_observe",
          "text": "Lo osservo prima di interromperlo.",
          "goto": "observe",
          "conditions": {
            "path": "world.flags.red_met",
            "ne": true
          }
        },
        {
          "id": "red_reengage",
          "text": "Lo saluto e riprendo il discorso.",
          "goto": "reengage",
          "conditions": {
            "path": "world.flags.red_met",
            "eq": true
          }
        }
      ]
    },
    "encounter_context": {
      "stitches": [
        {
          "id": "s1",
          "text": "Red è fermo accanto ai risultati del circuito. Ogni tanto guarda gli allenatori che escono dall'arena, poi torna al tabellone. Non sembra avere fretta di parlare."
        }
      ],
      "choices": [
        {
          "id": "context_solaria",
          "text": "Il primo contesto è Solaria.",
          "goto": "style_read",
          "conditions": {
            "path": "world.flags.m6_first_destination",
            "eq": "solaria"
          }
        },
        {
          "id": "context_luminara",
          "text": "Il primo contesto è Luminara.",
          "goto": "style_read",
          "conditions": {
            "path": "world.flags.m6_first_destination",
            "eq": "luminara"
          }
        },
        {
          "id": "context_rumor",
          "text": "Ricollego l'incontro al rumor pubblico.",
          "goto": "silent_read",
          "conditions": {
            "path": "world.flags.red_rumor_heard",
            "eq": true
          }
        },
        {
          "id": "context_back",
          "text": "Controllo come i rapporti con gli Anchor precedenti entrano nel contesto.",
          "goto": "callback"
        }
      ]
    },
    "observe": {
      "stitches": [
        {
          "id": "s1",
          "text": "Un allenatore sconfitto esce scuotendo la testa. Red segue con lo sguardo il suo avversario, che torna subito a confrontarsi con il proprio Pokémon. Poi abbassa gli occhi sui risultati."
        }
      ],
      "choices": [
        {
          "id": "observe_intro",
          "text": "Ora mi presento.",
          "goto": "first_exchange",
          "effects": [
            {
              "type": "npc_register",
              "npcId": "Red",
              "name": "Red",
              "relationshipScore": 0,
              "state": {
                "introduced": true,
                "context": "observed_first",
                "role": "interregional_anchor"
              }
            },
            {
              "type": "set_flag",
              "key": "red_met",
              "value": true
            },
            {
              "type": "set_flag",
              "key": "red_observed_before_intro",
              "value": true
            }
          ]
        },
        {
          "id": "observe_defer",
          "text": "Me ne vado senza forzare l'incontro.",
          "goto": "defer",
          "effects": [
            {
              "type": "set_flag",
              "key": "red_contact_deferred",
              "value": true
            }
          ]
        }
      ]
    },
    "first_exchange": {
      "stitches": [
        {
          "id": "s1",
          "text": "Red ascolta la tua presentazione e annuisce. «Quando un piano non funziona... cosa cambi?» La domanda arriva senza preamboli; aspetta la tua risposta."
        }
      ],
      "choices": [
        {
          "id": "ask_style",
          "text": "Gli chiedo come legge un avversario nuovo.",
          "goto": "style_read"
        },
        {
          "id": "ask_career",
          "text": "Gli chiedo come affronta una carriera fuori regione.",
          "goto": "career_read"
        }
      ]
    },
    "reengage": {
      "stitches": [
        {
          "id": "s1",
          "text": "Red ti riconosce con un cenno. Indica il tabellone, dove gli incontri sono cambiati dall'ultima volta. «Come sta andando?»"
        }
      ],
      "choices": [
        {
          "id": "reengage_style",
          "text": "Riprendo il discorso sull'adattamento.",
          "goto": "style_read"
        },
        {
          "id": "reengage_route",
          "text": "Parlo della mia prima tratta interregionale.",
          "goto": "route_comment"
        }
      ]
    },
    "style_read": {
      "stitches": [
        {
          "id": "s1",
          "text": "Red osserva per un momento il tuo equipaggiamento. «Non devi cambiare tutto». Fa una pausa. «Solo quello che non funziona»."
        }
      ],
      "choices": [
        {
          "id": "style_agree",
          "text": "Condivido il principio.",
          "goto": "relationship",
          "effects": [
            {
              "type": "npc_relationship_adjust",
              "npcId": "Red",
              "delta": 1
            },
            {
              "type": "set_flag",
              "key": "red_adaptation_common_ground",
              "value": true
            }
          ]
        },
        {
          "id": "style_question",
          "text": "Gli chiedo dove traccia il limite.",
          "goto": "silent_read"
        }
      ]
    },
    "career_read": {
      "stitches": [
        {
          "id": "s1",
          "text": "Red sfiora una Poké Ball alla cintura. «Ho iniziato con Charmander». Guarda l'arena prima di aggiungere: «Siamo cresciuti insieme». Non dice altro."
        }
      ],
      "choices": [
        {
          "id": "career_record",
          "text": "Gli chiedo come ha affrontato i cambiamenti.",
          "goto": "relationship",
          "effects": [
            {
              "type": "set_flag",
              "key": "red_stage_aware_principle_known",
              "value": true
            }
          ]
        },
        {
          "id": "career_back",
          "text": "Torno al primo scambio.",
          "goto": "first_exchange"
        }
      ]
    },
    "relationship": {
      "stitches": [
        {
          "id": "s1",
          "text": "Red ascolta fino in fondo. Alla fine accenna un sorriso quasi impercettibile e ti rivolge un breve cenno, prima di tornare a guardare gli incontri."
        }
      ],
      "choices": [
        {
          "id": "relationship_route",
          "text": "Parlo del circuito interregionale.",
          "goto": "route_comment"
        },
        {
          "id": "relationship_close",
          "text": "Chiudo l'incontro.",
          "goto": "red_close"
        }
      ]
    },
    "silent_read": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il silenzio si allunga. Red non cerca di riempirlo: segue con gli occhi il tabellone e lascia a te la scelta di continuare."
        }
      ],
      "choices": [
        {
          "id": "silent_context",
          "text": "Ricollego il discorso al contesto reale.",
          "goto": "encounter_context"
        },
        {
          "id": "silent_close",
          "text": "Lascio il discorso incompleto.",
          "goto": "red_close"
        }
      ]
    },
    "route_comment": {
      "stitches": [
        {
          "id": "s1",
          "text": "Red indica due risultati sul monitor, uno di Solaria e uno di Luminara. «Avversari diversi. Stesse abitudini, a volte, non bastano»."
        }
      ],
      "choices": [
        {
          "id": "route_note",
          "text": "Prendo nota del suo consiglio.",
          "goto": "red_close",
          "effects": [
            {
              "type": "set_flag",
              "key": "red_interregional_principle_known",
              "value": true
            }
          ]
        },
        {
          "id": "route_style",
          "text": "Torno al tema dell'adattamento.",
          "goto": "style_read"
        }
      ]
    },
    "red_close": {
      "stitches": [
        {
          "id": "s1",
          "text": "Red si sistema il berretto e torna verso l'area riservata agli allenatori. Alle sue spalle il tabellone Masters continua ad aggiornarsi."
        }
      ],
      "choices": [
        {
          "id": "close_masters",
          "text": "Passo al Masters Circuit.",
          "goto": "m06-masters-circuit#masters_entry"
        },
        {
          "id": "close_travel",
          "text": "Torno al riepilogo del viaggio.",
          "goto": "m06-interregional-travel#arrival_close"
        }
      ]
    },
    "defer": {
      "stitches": [
        {
          "id": "s1",
          "text": "Ti allontani senza interromperlo. Red resta presso il tabellone mentre la folla cambia attorno a lui; potresti incrociarlo di nuovo durante il circuito."
        }
      ],
      "choices": [
        {
          "id": "defer_return",
          "text": "Torno al contesto di arrivo.",
          "goto": "m06-interregional-travel#arrival_close"
        },
        {
          "id": "defer_recover",
          "text": "Il contesto è ancora valido: provo a presentarmi.",
          "goto": "first_exchange",
          "conditions": {
            "path": "world.flags.red_met",
            "ne": true
          },
          "effects": [
            {
              "type": "npc_register",
              "npcId": "Red",
              "name": "Red",
              "relationshipScore": 0,
              "state": {
                "introduced": true,
                "context": "deferred_recovery",
                "role": "interregional_anchor"
              }
            },
            {
              "type": "set_flag",
              "key": "red_met",
              "value": true
            },
            {
              "type": "set_flag",
              "key": "red_contact_recovered",
              "value": true
            }
          ]
        }
      ]
    },
    "callback": {
      "stitches": [
        {
          "id": "s1",
          "text": "Quando nomini Lance, Red solleva lo sguardo. Ascolta ciò che hai da raccontare senza dare per scontato come siano andati i tuoi incontri precedenti."
        }
      ],
      "choices": [
        {
          "id": "callback_record",
          "text": "Gli racconto soltanto ciò che è successo.",
          "goto": "red_close",
          "effects": [
            {
              "type": "set_flag",
              "key": "m6_red_anchor_callback_reviewed",
              "value": true
            }
          ]
        },
        {
          "id": "callback_back",
          "text": "Torno al contesto.",
          "goto": "encounter_context"
        }
      ]
    }
  }
}
