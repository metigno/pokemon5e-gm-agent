{
  "schemaVersion": 1,
  "id": "m06-module-outcome",
  "moduleId": "M06",
  "title": "M6_14 — Module Outcome",
  "locationId": "far_ruins",
  "entryNodeId": "outcome_entry",
  "conditions": {
    "all": [
      {
        "path": "world.flags.m5_complete",
        "eq": true
      },
      {
        "path": "world.flags.m06_unlocked",
        "eq": true
      },
      {
        "path": "world.flags.m6_active",
        "eq": true
      },
      {
        "path": "competition.rank",
        "eq": "S"
      },
      {
        "path": "world.flags.red_met",
        "eq": true
      },
      {
        "path": "world.flags.friend_beat_06_complete",
        "eq": true
      },
      {
        "path": "world.flags.ancient_mystery_layer_2",
        "exists": true
      },
      {
        "path": "world.flags.world_cutoff_state",
        "exists": true
      },
      {
        "path": "world.flags.m6_world_cutoff_review_complete",
        "eq": true
      },
      {
        "path": "world.flags.m6_first_lighthouse_return_complete",
        "eq": true
      },
      {
        "path": "world.flags.m6_module_outcome_available",
        "eq": true
      }
    ]
  },
  "nodes": {
    "outcome_entry": {
      "stitches": [
        {
          "id": "s1",
          "text": "Al Primo Faro, ripercorri i documenti e gli incontri accumulati durante il viaggio. La tua licenza, i nomi conosciuti e le tracce antiche raccontano una strada che nessun singolo torneo può riassumere."
        }
      ],
      "choices": [
        {
          "id": "outcome_audit",
          "text": "Eseguo l'audit completo del contratto.",
          "goto": "contract_audit"
        },
        {
          "id": "outcome_people",
          "text": "Rivedo Red e il Friend Beat prima della chiusura.",
          "goto": "red_review"
        },
        {
          "id": "outcome_cutoff",
          "text": "Rivedo il cutoff prima di chiudere.",
          "goto": "cutoff_review"
        }
      ]
    },
    "contract_audit": {
      "stitches": [
        {
          "id": "s1",
          "text": "Un'addetta controlla il fascicolo del tuo percorso. Se manca una tappa necessaria, non la inventa: indica il documento o l'incontro ancora da completare."
        }
      ],
      "choices": [
        {
          "id": "audit_complete",
          "text": "Il contratto è soddisfatto: chiudo M6.",
          "goto": "module_complete",
          "effects": [
            {
              "type": "set_flag",
              "key": "m6_complete",
              "value": true
            },
            {
              "type": "set_flag",
              "key": "m07_unlocked",
              "value": true
            },
            {
              "type": "set_flag",
              "key": "m6_outcome_complete",
              "value": true
            },
            {
              "type": "trainer_milestone_level",
              "milestoneId": "M06_COMPLETE",
              "level": 18
            }
          ]
        },
        {
          "id": "audit_rank",
          "text": "Rivedo il checkpoint A→S.",
          "goto": "rank_review"
        },
        {
          "id": "audit_history",
          "text": "Rivedo la parte competitiva della run.",
          "goto": "competition_review"
        },
        {
          "id": "audit_continuity",
          "text": "Controllo che nulla venga resettato.",
          "goto": "continuity_review"
        }
      ]
    },
    "rank_review": {
      "stitches": [
        {
          "id": "s1",
          "text": "Sulla licenza compare il grado S conquistato al Faro. Accanto, un avviso ricorda che l'accesso al Mondiale richiede ancora le qualificazioni."
        }
      ],
      "choices": [
        {
          "id": "rank_competition",
          "text": "Rivedo lo storico competitivo.",
          "goto": "competition_review"
        },
        {
          "id": "rank_m7",
          "text": "Controllo cosa sblocca realmente M7.",
          "goto": "m7_preview"
        }
      ]
    },
    "red_review": {
      "stitches": [
        {
          "id": "s1",
          "text": "Tra gli appunti conservi il ricordo di Red e delle sue osservazioni. Il prossimo incontro con lui, se avverrà, partirà da ciò che vi siete già detti."
        }
      ],
      "choices": [
        {
          "id": "red_friend",
          "text": "Passo al Friend Beat.",
          "goto": "friend_review"
        },
        {
          "id": "red_contract",
          "text": "Torno all'audit.",
          "goto": "contract_audit"
        }
      ]
    },
    "friend_review": {
      "stitches": [
        {
          "id": "s1",
          "text": "Un messaggio del tuo amico è ancora nella cronologia. Che vi siate visti o sentiti da lontano, quella conversazione rimane parte del viaggio."
        }
      ],
      "choices": [
        {
          "id": "friend_red",
          "text": "Rivedo Red come Anchor.",
          "goto": "red_review"
        },
        {
          "id": "friend_contract",
          "text": "Torno all'audit.",
          "goto": "contract_audit"
        }
      ]
    },
    "cutoff_review": {
      "stitches": [
        {
          "id": "s1",
          "text": "Nel registro stagionale resta scritto il grado che avevi alla scadenza. La data non cambia insieme alla licenza."
        }
      ],
      "choices": [
        {
          "id": "cutoff_ancient",
          "text": "Rivedo il secondo layer del mistero.",
          "goto": "ancient_review"
        },
        {
          "id": "cutoff_contract",
          "text": "Torno all'audit.",
          "goto": "contract_audit"
        }
      ]
    },
    "ancient_review": {
      "stitches": [
        {
          "id": "s1",
          "text": "Le carte del Faro e di Fulgore sono ancora incomplete. Alcuni segni sembrano collegati, ma nessuno ha ancora dimostrato che cosa li abbia prodotti."
        }
      ],
      "choices": [
        {
          "id": "ancient_continuity",
          "text": "Controllo la continuità verso il modulo successivo.",
          "goto": "continuity_review"
        },
        {
          "id": "ancient_contract",
          "text": "Torno all'audit.",
          "goto": "contract_audit"
        }
      ]
    },
    "competition_review": {
      "stitches": [
        {
          "id": "s1",
          "text": "Rileggi i referti Masters, Continental Cup e prova del Faro. Ogni vittoria, sconfitta e piazzamento resta al proprio posto."
        }
      ],
      "choices": [
        {
          "id": "competition_rank",
          "text": "Torno al significato di Rank S.",
          "goto": "rank_review"
        },
        {
          "id": "competition_cutoff",
          "text": "Ricollego lo storico al cutoff.",
          "goto": "cutoff_review"
        }
      ]
    },
    "continuity_review": {
      "stitches": [
        {
          "id": "s1",
          "text": "Prima di ripartire, controlli squadra, scorte e itinerario. I tuoi Pokémon portano con sé le condizioni degli ultimi incontri; gli amici e gli avversari continuano i propri impegni."
        }
      ],
      "choices": [
        {
          "id": "continuity_m7",
          "text": "Controllo il prossimo accesso senza teletrasporto.",
          "goto": "m7_preview"
        },
        {
          "id": "continuity_audit",
          "text": "Torno all'audit finale.",
          "goto": "contract_audit"
        }
      ]
    },
    "m7_preview": {
      "stitches": [
        {
          "id": "s1",
          "text": "Un nuovo avviso indica Meridiana come tappa del percorso dei candidati mondiali. La qualificazione vera e propria ti aspetta ancora, oltre questa città e questi incontri."
        }
      ],
      "choices": [
        {
          "id": "preview_complete",
          "text": "Torno alla chiusura del modulo.",
          "goto": "module_complete",
          "conditions": {
            "path": "world.flags.m6_complete",
            "eq": true
          }
        },
        {
          "id": "preview_audit",
          "text": "Torno all'audit prima di chiudere.",
          "goto": "contract_audit"
        }
      ]
    },
    "module_complete": {
      "stitches": [
        {
          "id": "s1",
          "text": "Dall'altura del Primo Faro osservi le strade che portano lontano. Hai conquistato il grado S, ma il Mondiale è ancora davanti a te. Il viaggio continua."
        }
      ],
      "choices": [
        {
          "id": "complete_handoff",
          "text": "Registro il punto di handoff verso M7.",
          "goto": "handoff"
        }
      ]
    },
    "handoff": {
      "stitches": [
        {
          "id": "s1",
          "text": "Rimani sulle alture del Faro, con il vento che attraversa le rovine. Per raggiungere Meridiana dovrai scegliere una strada e partire davvero."
        }
      ],
      "choices": [
        {
          "id": "handoff_ruins",
          "text": "Resto alle Rovine del Primo Faro con M7 disponibile.",
          "goto": "m06-first-lighthouse-return#ruins_boundary",
          "effects": [
            {
              "type": "set_location",
              "locationId": "far_ruins"
            }
          ]
        }
      ]
    }
  }
}
