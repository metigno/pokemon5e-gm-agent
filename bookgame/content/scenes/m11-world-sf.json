{
  "schemaVersion": 1,
  "id": "m11-world-sf",
  "moduleId": "M11",
  "title": "M11_03 — World SF",
  "locationId": "world_knockout_hall",
  "entryNodeId": "sf_entry",
  "conditions": {
    "all": [
      {
        "path": "world.flags.m11_sf_prep_complete",
        "eq": true
      },
      {
        "path": "competition.world.knockout.sfOpened",
        "eq": true
      },
      {
        "path": "competition.world.knockout.playerAdvancedToSf",
        "eq": true
      },
      {
        "path": "competition.world.knockout.playerSfMatchId",
        "exists": true
      }
    ]
  },
  "nodes": {
    "sf_entry": {
      "stitches": [
        {
          "id": "s1",
          "text": "Quattro allenatori, due campi, una finale. L'arbitro chiama il tuo nome; questa semifinale non concede un secondo tentativo."
        }
      ],
      "choices": [
        {
          "id": "sf_entry_next",
          "text": "Proseguo verso Opponent Card.",
          "goto": "opponent_card"
        },
        {
          "id": "sf_entry_alt",
          "text": "Confronto questo punto con Rules.",
          "goto": "rules"
        },
        {
          "id": "sf_entry_deep",
          "text": "Approfondisco Pressure.",
          "goto": "pressure"
        }
      ]
    },
    "opponent_card": {
      "stitches": [
        {
          "id": "s1",
          "text": "Sul display appare {{competition.world.knockout.playerSfOpponent.name}}. Il suo percorso fino a qui è pubblico; le decisioni che prenderà nei prossimi turni ancora no."
        }
      ],
      "choices": [
        {
          "id": "opponent_card_next",
          "text": "Proseguo verso Rules.",
          "goto": "rules"
        },
        {
          "id": "opponent_card_alt",
          "text": "Confronto questo punto con Pressure.",
          "goto": "pressure"
        },
        {
          "id": "opponent_card_deep",
          "text": "Approfondisco Match Handoff.",
          "goto": "match_handoff"
        }
      ]
    },
    "rules": {
      "stitches": [
        {
          "id": "s1",
          "text": "«Sei Pokémon, incontro singolo, eliminazione diretta», ricorda l'arbitro. Nessun pronostico decide la partita."
        }
      ],
      "choices": [
        {
          "id": "rules_next",
          "text": "Proseguo verso Pressure.",
          "goto": "pressure"
        },
        {
          "id": "rules_alt",
          "text": "Confronto questo punto con Match Handoff.",
          "goto": "match_handoff"
        },
        {
          "id": "rules_deep",
          "text": "Approfondisco Win Return.",
          "goto": "win_return"
        }
      ]
    },
    "pressure": {
      "stitches": [
        {
          "id": "s1",
          "text": "La folla segue ogni gesto mentre i Pokémon si preparano. Fra te e la finale rimane un solo avversario, ma la tensione non altera ciò che ciascuno sa fare."
        }
      ],
      "choices": [
        {
          "id": "pressure_next",
          "text": "Proseguo verso Match Handoff.",
          "goto": "match_handoff"
        },
        {
          "id": "pressure_alt",
          "text": "Confronto questo punto con Win Return.",
          "goto": "win_return"
        },
        {
          "id": "pressure_deep",
          "text": "Approfondisco Loss Return.",
          "goto": "loss_return"
        }
      ]
    },
    "match_handoff": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il segnale d'inizio sta per suonare. Il tuo avversario è già in posizione e il terreno di gioco è libero."
        }
      ],
      "choices": [
        {
          "id": "fight_sf",
          "text": "Combatto la semifinale del Mondiale.",
          "combat": {
            "encounterId": "WORLD_SF_PLAYER",
            "opponentRegistered": true,
            "competition": {
              "type": "official_match",
              "matchId": "WORLD_SF_PLAYER",
              "format": "Singles",
              "officialRosterSize": 6,
              "difficulty": "STORY_THREAT",
              "worldKnockoutRound": "SF"
            },
            "returnNodes": {
              "win": "win_return",
              "lose": "loss_return"
            },
            "goto": "match_handoff"
          },
          "conditions": {
            "path": "world.flags.world_sf_resolved",
            "ne": true
          }
        },
        {
          "id": "handoff_readiness",
          "text": "Non entro ancora: torno alla readiness.",
          "goto": "readiness"
        },
        {
          "id": "handoff_rules",
          "text": "Rileggo le regole prima di entrare.",
          "goto": "rules"
        }
      ]
    },
    "win_return": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il pubblico reagisce alla fine dell'incontro: hai vinto la semifinale. Il tuo nome sale sul tabellone della finale, mentre l'altra sfida deve ancora indicare il secondo partecipante."
        }
      ],
      "choices": [
        {
          "id": "win_record",
          "text": "Registro la chiusura narrativa della mia semifinale.",
          "goto": "result_record",
          "effects": [
            {
              "type": "set_flag",
              "key": "m11_world_sf_complete",
              "value": true
            }
          ]
        },
        {
          "id": "win_resources",
          "text": "Controllo ciò che resta al team.",
          "goto": "resources_after",
          "effects": [
            {
              "type": "set_flag",
              "key": "m11_world_sf_complete",
              "value": true
            }
          ]
        }
      ]
    },
    "loss_return": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il verdetto è netto: la tua corsa al titolo finisce in semifinale. L'arena continua a vivere e la finale si giocherà senza di te."
        }
      ],
      "choices": [
        {
          "id": "loss_record",
          "text": "Registro l'eliminazione nella mia semifinale.",
          "goto": "result_record",
          "effects": [
            {
              "type": "set_flag",
              "key": "m11_world_sf_complete",
              "value": true
            }
          ]
        },
        {
          "id": "loss_resources",
          "text": "Controllo lo stato del team dopo la sconfitta.",
          "goto": "resources_after",
          "effects": [
            {
              "type": "set_flag",
              "key": "m11_world_sf_complete",
              "value": true
            }
          ]
        }
      ]
    },
    "result_record": {
      "stitches": [
        {
          "id": "s1",
          "text": "Un addetto firma il referto del tuo incontro. Vittoria o sconfitta restano registrate con il nome dell'avversario."
        }
      ],
      "choices": [
        {
          "id": "result_record_next",
          "text": "Proseguo verso Resources After.",
          "goto": "resources_after"
        },
        {
          "id": "result_record_alt",
          "text": "Confronto questo punto con History.",
          "goto": "history"
        }
      ]
    },
    "resources_after": {
      "stitches": [
        {
          "id": "s1",
          "text": "I tuoi Pokémon tornano nelle loro Poké Ball con le conseguenze dello scontro. Neppure una vittoria cancella automaticamente la fatica."
        }
      ],
      "choices": [
        {
          "id": "resources_after_next",
          "text": "Proseguo verso History.",
          "goto": "history"
        },
        {
          "id": "resources_after_alt",
          "text": "Confronto questo punto con Bracket Context.",
          "goto": "bracket_context"
        }
      ]
    },
    "history": {
      "stitches": [
        {
          "id": "s1",
          "text": "Sul monitor trovi il tuo incontro e, separatamente, quello disputato dall'altra coppia di semifinalisti."
        }
      ],
      "choices": [
        {
          "id": "history_next",
          "text": "Proseguo verso Bracket Context.",
          "goto": "bracket_context"
        },
        {
          "id": "history_alt",
          "text": "Confronto questo punto con Rei Context.",
          "goto": "rei_context"
        }
      ]
    },
    "bracket_context": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il vincitore della tua semifinale occupa uno dei due posti della finale. L'altro non è ancora un nome garantito."
        }
      ],
      "choices": [
        {
          "id": "bracket_context_next",
          "text": "Proseguo verso Rei Context.",
          "goto": "rei_context"
        },
        {
          "id": "bracket_context_alt",
          "text": "Confronto questo punto con Friend Context.",
          "goto": "friend_context"
        }
      ]
    },
    "rei_context": {
      "stitches": [
        {
          "id": "s1",
          "text": "Se Rei è ancora in gara, anche lui deve affrontare il proprio avversario. Il pubblico può fare pronostici; il risultato non è già scritto."
        }
      ],
      "choices": [
        {
          "id": "rei_context_next",
          "text": "Proseguo verso Friend Context.",
          "goto": "friend_context"
        },
        {
          "id": "rei_context_alt",
          "text": "Confronto questo punto con World Pressure.",
          "goto": "world_pressure"
        }
      ]
    },
    "friend_context": {
      "stitches": [
        {
          "id": "s1",
          "text": "Un amico può trovarsi tra i semifinalisti o essere stato eliminato prima. La vostra storia comune non gli regala un passaggio del turno."
        }
      ],
      "choices": [
        {
          "id": "friend_context_next",
          "text": "Proseguo verso World Pressure.",
          "goto": "world_pressure"
        },
        {
          "id": "friend_context_alt",
          "text": "Confronto questo punto con Single Elimination.",
          "goto": "single_elimination"
        }
      ]
    },
    "world_pressure": {
      "stitches": [
        {
          "id": "s1",
          "text": "Sull'altro campo la competizione prosegue anche se non puoi vederla in diretta."
        }
      ],
      "choices": [
        {
          "id": "world_pressure_next",
          "text": "Proseguo verso Single Elimination.",
          "goto": "single_elimination"
        },
        {
          "id": "world_pressure_alt",
          "text": "Confronto questo punto con Readiness.",
          "goto": "readiness"
        }
      ]
    },
    "single_elimination": {
      "stitches": [
        {
          "id": "s1",
          "text": "Perdere una semifinale significa lasciare la corsa al titolo in questa edizione. Nessun altro incontro cancella il verdetto."
        }
      ],
      "choices": [
        {
          "id": "single_elimination_next",
          "text": "Proseguo verso Readiness.",
          "goto": "readiness"
        },
        {
          "id": "single_elimination_alt",
          "text": "Confronto questo punto con No Reset.",
          "goto": "no_reset"
        }
      ]
    },
    "readiness": {
      "stitches": [
        {
          "id": "s1",
          "text": "L'arbitro controlla l'accredito e i sei Pokémon registrati prima di farti entrare."
        }
      ],
      "choices": [
        {
          "id": "readiness_next",
          "text": "Proseguo verso No Reset.",
          "goto": "no_reset"
        },
        {
          "id": "readiness_alt",
          "text": "Confronto questo punto con Official Record.",
          "goto": "official_record"
        }
      ]
    },
    "no_reset": {
      "stitches": [
        {
          "id": "s1",
          "text": "Dopo la partita devi occuparti davvero della squadra. L'esito sportivo non equivale a una cura."
        }
      ],
      "choices": [
        {
          "id": "no_reset_next",
          "text": "Proseguo verso Official Record.",
          "goto": "official_record"
        },
        {
          "id": "no_reset_alt",
          "text": "Confronto questo punto con Aftermath Gate.",
          "goto": "aftermath_gate"
        }
      ]
    },
    "official_record": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il referto ufficiale stabilisce chi ha vinto. Non spetta alle voci degli spalti decidere il risultato."
        }
      ],
      "choices": [
        {
          "id": "official_record_next",
          "text": "Proseguo verso Aftermath Gate.",
          "goto": "aftermath_gate"
        },
        {
          "id": "official_record_alt",
          "text": "Confronto questo punto con Handoff.",
          "goto": "handoff"
        }
      ]
    },
    "aftermath_gate": {
      "stitches": [
        {
          "id": "s1",
          "text": "Ora si attende l'esito dell'altra semifinale per conoscere il programma della finale."
        }
      ],
      "choices": [
        {
          "id": "aftermath_gate_next",
          "text": "Proseguo verso Handoff.",
          "goto": "handoff"
        },
        {
          "id": "aftermath_gate_alt",
          "text": "Confronto questo punto con Complete.",
          "goto": "complete"
        }
      ]
    },
    "handoff": {
      "stitches": [
        {
          "id": "s1",
          "text": "Esci dal campo mentre gli addetti preparano l'annuncio degli ultimi due contendenti."
        }
      ],
      "choices": [
        {
          "id": "handoff_other",
          "text": "Passo alla risoluzione dell'altra semifinale.",
          "goto": "m11-other-sf#other_sf_entry"
        },
        {
          "id": "handoff_history",
          "text": "Rivedo il record ufficiale.",
          "goto": "official_record"
        }
      ]
    },
    "complete": {
      "stitches": [
        {
          "id": "s1",
          "text": "La tua semifinale è conclusa. Qualunque sia stato il risultato, non puoi rigiocarla."
        }
      ],
      "choices": [
        {
          "id": "complete_next",
          "text": "Proseguo verso Review.",
          "goto": "review"
        },
        {
          "id": "complete_alt",
          "text": "Confronto questo punto con Sf Entry.",
          "goto": "sf_entry"
        }
      ]
    },
    "review": {
      "stitches": [
        {
          "id": "s1",
          "text": "Puoi rivedere il tabellone; la partita appena finita rimane tale."
        }
      ],
      "choices": [
        {
          "id": "review_next",
          "text": "Proseguo verso Sf Entry.",
          "goto": "sf_entry"
        },
        {
          "id": "review_alt",
          "text": "Confronto questo punto con Opponent Card.",
          "goto": "opponent_card"
        }
      ]
    }
  }
}
