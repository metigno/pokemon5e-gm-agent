{
  "schemaVersion": 1,
  "id": "m06-handoff",
  "moduleId": "M06",
  "title": "M6_00 — Rank A Handoff",
  "locationId": "alt_town",
  "entryNodeId": "m06_entry",
  "conditions": {
    "all": [
      {
        "path": "world.flags.m5_complete",
        "eq": true
      },
      {
        "path": "world.flags.m06_unlocked",
        "eq": true
      },
      {
        "path": "competition.rank",
        "eq": "A"
      }
    ]
  },
  "nodes": {
    "m06_entry": {
      "stitches": [
        {
          "id": "s1",
          "text": "Ad Altacima, il timbro della licenza interregionale è ancora fresco. Dietro il vetro dell'ufficio, un addetto fa scorrere i risultati del circuito: ciò che hai conquistato resta agli atti. Sul tabellone, invece, le prossime gare aspettano ancora un nome."
        }
      ],
      "choices": [
        {
          "id": "activate_m6",
          "text": "Presento la licenza allo sportello.",
          "goto": "rank_a_band",
          "conditions": {
            "path": "world.flags.m6_active",
            "ne": true
          },
          "effects": [
            {
              "type": "set_flag",
              "key": "m6_active",
              "value": true
            }
          ]
        },
        {
          "id": "review_active_m6",
          "text": "Ricontrollo le opportunità del grado A.",
          "goto": "rank_a_band",
          "conditions": {
            "path": "world.flags.m6_active",
            "eq": true
          }
        }
      ]
    },
    "rank_a_band": {
      "stitches": [
        {
          "id": "s1",
          "text": "La sala partenze di Altacima è piena di valigie, custodie per Poké Ball e allenatori che discutono davanti agli orari. Il tuo grado A ti apre nuove tratte, ma nessuno qui sembra impressionato da un risultato ottenuto altrove."
        }
      ],
      "choices": [
        {
          "id": "band_routes",
          "text": "Rivedo le tratte interregionali disponibili.",
          "goto": "route_preview"
        },
        {
          "id": "band_masters",
          "text": "Controllo i risultati del Masters.",
          "goto": "masters_state"
        },
        {
          "id": "band_license",
          "text": "Chiedo informazioni sulla licenza.",
          "goto": "license_state"
        },
        {
          "id": "band_wait",
          "text": "Rimango ad Altacima.",
          "goto": "stay_altacima"
        }
      ]
    },
    "carryover": {
      "stitches": [
        {
          "id": "s1",
          "text": "Nella tua documentazione figurano i risultati già registrati, le gare disputate e i contatti raccolti lungo il cammino. L'addetto non aggiunge nulla: ogni casella vuota rimane vuota."
        }
      ],
      "choices": [
        {
          "id": "carry_callbacks",
          "text": "Rivedo i callback utili dei moduli precedenti.",
          "goto": "callbacks"
        },
        {
          "id": "carry_back",
          "text": "Torno alla fascia Rank A.",
          "goto": "rank_a_band"
        }
      ]
    },
    "masters_state": {
      "stitches": [
        {
          "id": "s1",
          "text": "Sul monitor del Masters compaiono soltanto risultati e iscrizioni ufficialmente registrati. Un impiegato indica la colonna delle teste di serie: «Qui contano le gare disputate. Le intenzioni non fanno classifica»."
        }
      ],
      "choices": [
        {
          "id": "masters_record",
          "text": "Prendo nota dei risultati esposti.",
          "goto": "guard_state",
          "effects": [
            {
              "type": "set_flag",
              "key": "m6_masters_carryover_reviewed",
              "value": true
            }
          ]
        },
        {
          "id": "masters_back",
          "text": "Torno alla fascia Rank A.",
          "goto": "rank_a_band"
        }
      ]
    },
    "license_state": {
      "stitches": [
        {
          "id": "s1",
          "text": "L'impiegata passa la licenza sotto il lettore. «Solaria e Luminara sono entrambe raggiungibili. Controlla gli orari: la licenza apre le porte, non ferma i treni»."
        }
      ],
      "choices": [
        {
          "id": "license_routes",
          "text": "Passo alla selezione delle tratte.",
          "goto": "route_preview"
        },
        {
          "id": "license_back",
          "text": "Torno alla fascia Rank A.",
          "goto": "rank_a_band"
        }
      ]
    },
    "callbacks": {
      "stitches": [
        {
          "id": "s1",
          "text": "Tra i nominativi e i luoghi segnati nei tuoi documenti riconosci tracce del viaggio precedente: Ferrox, Mareasale, Fulgore, Lance. Alcuni contatti potrebbero tornare utili; altri non hanno lasciato che un ricordo."
        }
      ],
      "choices": [
        {
          "id": "callbacks_note",
          "text": "Segno i contatti che potrei ritrovare.",
          "goto": "guard_state",
          "effects": [
            {
              "type": "set_flag",
              "key": "m6_prior_callbacks_reviewed",
              "value": true
            }
          ]
        },
        {
          "id": "callbacks_back",
          "text": "Torno al riepilogo dello stato.",
          "goto": "carryover"
        }
      ]
    },
    "route_preview": {
      "stitches": [
        {
          "id": "s1",
          "text": "Sul tabellone lampeggiano due destinazioni: Solaria e Luminara. Una coppia di allenatori discute sui collegamenti; un terzo ripiega la mappa e si allontana. Puoi decidere adesso o aspettare."
        }
      ],
      "choices": [
        {
          "id": "preview_solaria",
          "text": "Valuto Solaria come prima tratta.",
          "goto": "route_commit",
          "effects": [
            {
              "type": "set_flag",
              "key": "m6_route_candidate",
              "value": "solaria"
            }
          ]
        },
        {
          "id": "preview_luminara",
          "text": "Valuto Luminara come prima tratta.",
          "goto": "route_commit",
          "effects": [
            {
              "type": "set_flag",
              "key": "m6_route_candidate",
              "value": "luminara"
            }
          ]
        },
        {
          "id": "preview_carryover",
          "text": "Prima controllo ancora lo stato ereditato.",
          "goto": "carryover"
        }
      ]
    },
    "stay_altacima": {
      "stitches": [
        {
          "id": "s1",
          "text": "Fuori dalla stazione, Altacima prosegue la sua giornata. I negozi aprono, i viaggiatori partono e il tabellone continua ad aggiornarsi anche mentre rimani in città."
        }
      ],
      "choices": [
        {
          "id": "stay_return",
          "text": "Aspetto un'ora prima di rivalutare la fascia Rank A.",
          "goto": "wait_node",
          "timeCostMinutes": 60
        },
        {
          "id": "stay_services",
          "text": "Rientro nell'hub di Altacima.",
          "goto": "m05-altacima#town_hub",
          "effects": [
            {
              "type": "set_location",
              "locationId": "alt_town"
            }
          ]
        }
      ]
    },
    "guard_state": {
      "stitches": [
        {
          "id": "s1",
          "text": "L'addetto ti restituisce i documenti. «Il grado è confermato. Per il resto, saranno i prossimi incontri a parlare». Dietro di lui, il tabellone delle partenze cambia ancora."
        }
      ],
      "choices": [
        {
          "id": "guard_routes",
          "text": "Consulto le partenze.",
          "goto": "route_preview"
        },
        {
          "id": "guard_back",
          "text": "Torno al riepilogo.",
          "goto": "rank_a_band"
        }
      ]
    },
    "route_commit": {
      "stitches": [
        {
          "id": "s1",
          "text": "L'addetto segna la destinazione che stai valutando e ti porge gli orari. «Questo non è ancora un biglietto. Puoi cambiare idea finché non confermi la partenza»."
        }
      ],
      "choices": [
        {
          "id": "commit_route",
          "text": "Vado allo sportello per organizzare il viaggio.",
          "goto": "m06-route-selection#route_entry"
        },
        {
          "id": "commit_back",
          "text": "Cambio idea prima della partenza.",
          "goto": "route_preview"
        }
      ]
    },
    "wait_node": {
      "stitches": [
        {
          "id": "s1",
          "text": "Dopo un'ora, le lancette sopra la biglietteria avanzano e alcune partenze spariscono dal tabellone. Altri viaggiatori prendono il loro posto in fila."
        }
      ],
      "choices": [
        {
          "id": "wait_hour",
          "text": "Aspetto ancora un'ora.",
          "goto": "rank_a_band",
          "timeCostMinutes": 60
        },
        {
          "id": "wait_hub",
          "text": "Torno ai servizi di Altacima.",
          "goto": "m05-altacima#town_hub",
          "effects": [
            {
              "type": "set_location",
              "locationId": "alt_town"
            }
          ]
        }
      ]
    }
  }
}
