{
  "schemaVersion": 1,
  "id": "m07-before-the-lights",
  "moduleId": "M07",
  "title": "M7_11 — Before the Lights",
  "locationId": "meridiana_grand_hall",
  "entryNodeId": "before_entry",
  "conditions": {
    "all": [
      {
        "path": "world.flags.m6_complete",
        "eq": true
      },
      {
        "path": "world.flags.m07_unlocked",
        "eq": true
      },
      {
        "path": "world.flags.m7_active",
        "eq": true
      },
      {
        "path": "competition.rank",
        "eq": "S"
      },
      {
        "path": "world.flags.cynthia_met",
        "eq": true
      },
      {
        "path": "world.flags.friend_beat_07_complete",
        "eq": true
      },
      {
        "path": "world.flags.world_qualified",
        "eq": true
      },
      {
        "path": "world.flags.a7_before_lights_available",
        "eq": true
      }
    ]
  },
  "nodes": {
    "before_entry": {
      "stitches": [
        {
          "id": "s1",
          "text": "Meridiana ha un suono diverso dopo la qualificazione: più telecamere, più persone che ti riconoscono, più domande sulla partenza imminente."
        }
      ],
      "choices": [
        {
          "id": "entry_event",
          "text": "Controllo perché A7_BEFORE_LIGHTS è aperto.",
          "goto": "event_guard"
        },
        {
          "id": "entry_friends",
          "text": "Cerco chi dei Four è davvero disponibile.",
          "goto": "friend_dispatch"
        },
        {
          "id": "entry_team",
          "text": "Controllo ciò che porto con me, senza reset.",
          "goto": "team_state"
        }
      ]
    },
    "event_guard": {
      "stitches": [
        {
          "id": "s1",
          "text": "Sul tabellone delle partenze compare il periodo del Mondiale. L'accredito è confermato, ma il viaggio e la preparazione restano da organizzare."
        }
      ],
      "choices": [
        {
          "id": "event_friends",
          "text": "Passo agli amici disponibili.",
          "goto": "friend_dispatch"
        },
        {
          "id": "event_departure",
          "text": "Rivedo il momento della partenza.",
          "goto": "departure"
        }
      ]
    },
    "friend_dispatch": {
      "stitches": [
        {
          "id": "s1",
          "text": "Controlli i messaggi degli amici. Qualcuno è in viaggio, qualcuno è impegnato; soltanto chi è davvero disponibile può fermarsi a salutarti."
        }
      ],
      "choices": [
        {
          "id": "friend_luke",
          "text": "Parlo con Luke.",
          "goto": "luke",
          "conditions": {
            "all": [
              {
                "path": "player.name",
                "ne": "Luke"
              },
              {
                "path": "npcs.Luke.schedule.present",
                "eq": true
              }
            ]
          }
        },
        {
          "id": "friend_mattew",
          "text": "Parlo con Mattew.",
          "goto": "mattew",
          "conditions": {
            "all": [
              {
                "path": "player.name",
                "ne": "Mattew"
              },
              {
                "path": "npcs.Mattew.schedule.present",
                "eq": true
              }
            ]
          }
        },
        {
          "id": "friend_daniel",
          "text": "Parlo con Daniel.",
          "goto": "daniel",
          "conditions": {
            "all": [
              {
                "path": "player.name",
                "ne": "Daniel"
              },
              {
                "path": "npcs.Daniel.schedule.present",
                "eq": true
              }
            ]
          }
        },
        {
          "id": "friend_edward",
          "text": "Parlo con Edward.",
          "goto": "edward",
          "conditions": {
            "all": [
              {
                "path": "player.name",
                "ne": "Edward"
              },
              {
                "path": "npcs.Edward.schedule.present",
                "eq": true
              }
            ]
          }
        },
        {
          "id": "friend_fab",
          "text": "Parlo con Fab.",
          "goto": "fab",
          "conditions": {
            "all": [
              {
                "path": "player.name",
                "ne": "Fab"
              },
              {
                "path": "npcs.Fab.schedule.present",
                "eq": true
              }
            ]
          }
        }
      ]
    },
    "luke": {
      "stitches": [
        {
          "id": "s1",
          "text": "Luke sorride di traverso. «Adesso non iniziare a cambiare i Pokémon che ti hanno portato fin qui. Semmai trova un modo più cattivo di farli lavorare insieme.»"
        }
      ],
      "choices": [
        {
          "id": "luke_physical",
          "text": "Siamo entrambi al Grand Hall: parliamo di persona.",
          "goto": "callback",
          "conditions": {
            "path": "npcs.Luke.schedule.locationId",
            "eq": "meridiana_grand_hall"
          },
          "effects": [
            {
              "type": "npc_relationship_adjust",
              "npcId": "Luke",
              "delta": 1
            }
          ]
        },
        {
          "id": "luke_remote",
          "text": "Luke è altrove: restiamo sul contatto a distanza.",
          "goto": "callback",
          "conditions": {
            "path": "npcs.Luke.schedule.locationId",
            "ne": "meridiana_grand_hall"
          },
          "effects": [
            {
              "type": "npc_relationship_adjust",
              "npcId": "Luke",
              "delta": 1
            }
          ]
        }
      ]
    },
    "mattew": {
      "stitches": [
        {
          "id": "s1",
          "text": "Mattew incrocia le braccia. «Quando arrivi, guarda come si allenano gli altri. Non per copiarli: per capire cosa fanno meglio di noi.» Poi aggiunge: «E cerca di dormire, ogni tanto.»"
        }
      ],
      "choices": [
        {
          "id": "mattew_physical",
          "text": "Siamo entrambi al Grand Hall: parliamo di persona.",
          "goto": "callback",
          "conditions": {
            "path": "npcs.Mattew.schedule.locationId",
            "eq": "meridiana_grand_hall"
          },
          "effects": [
            {
              "type": "npc_relationship_adjust",
              "npcId": "Mattew",
              "delta": 1
            }
          ]
        },
        {
          "id": "mattew_remote",
          "text": "Mattew è altrove: restiamo sul contatto a distanza.",
          "goto": "callback",
          "conditions": {
            "path": "npcs.Mattew.schedule.locationId",
            "ne": "meridiana_grand_hall"
          },
          "effects": [
            {
              "type": "npc_relationship_adjust",
              "npcId": "Mattew",
              "delta": 1
            }
          ]
        }
      ]
    },
    "daniel": {
      "stitches": [
        {
          "id": "s1",
          "text": "Daniel osserva il programma provvisorio. «Non conosci ancora gli avversari. Evita di fare promesse che dipendono da un sorteggio che nessuno ha visto.»"
        }
      ],
      "choices": [
        {
          "id": "daniel_physical",
          "text": "Siamo entrambi al Grand Hall: parliamo di persona.",
          "goto": "callback",
          "conditions": {
            "path": "npcs.Daniel.schedule.locationId",
            "eq": "meridiana_grand_hall"
          },
          "effects": [
            {
              "type": "npc_relationship_adjust",
              "npcId": "Daniel",
              "delta": 1
            }
          ]
        },
        {
          "id": "daniel_remote",
          "text": "Daniel è altrove: restiamo sul contatto a distanza.",
          "goto": "callback",
          "conditions": {
            "path": "npcs.Daniel.schedule.locationId",
            "ne": "meridiana_grand_hall"
          },
          "effects": [
            {
              "type": "npc_relationship_adjust",
              "npcId": "Daniel",
              "delta": 1
            }
          ]
        }
      ]
    },
    "edward": {
      "stitches": [
        {
          "id": "s1",
          "text": "Edward si sistema la giacca e sorride. «Almeno al Mondiale avranno telecamere decenti. Fai vedere cosa sanno fare i tuoi Pokémon, non soltanto la tua faccia.»"
        }
      ],
      "choices": [
        {
          "id": "edward_physical",
          "text": "Siamo entrambi al Grand Hall: parliamo di persona.",
          "goto": "callback",
          "conditions": {
            "path": "npcs.Edward.schedule.locationId",
            "eq": "meridiana_grand_hall"
          },
          "effects": [
            {
              "type": "npc_relationship_adjust",
              "npcId": "Edward",
              "delta": 1
            }
          ]
        },
        {
          "id": "edward_remote",
          "text": "Edward è altrove: restiamo sul contatto a distanza.",
          "goto": "callback",
          "conditions": {
            "path": "npcs.Edward.schedule.locationId",
            "ne": "meridiana_grand_hall"
          },
          "effects": [
            {
              "type": "npc_relationship_adjust",
              "npcId": "Edward",
              "delta": 1
            }
          ]
        }
      ]
    },
    "fab": {
      "stitches": [
        {
          "id": "s1",
          "text": "Fab accarezza il Pokémon accanto a sé. «Goditela, ma ricordati di far riposare la squadra. Il biglietto per il Mondiale non cura nessuno.»"
        }
      ],
      "choices": [
        {
          "id": "fab_physical",
          "text": "Siamo entrambi al Grand Hall: parliamo di persona.",
          "goto": "callback",
          "conditions": {
            "path": "npcs.Fab.schedule.locationId",
            "eq": "meridiana_grand_hall"
          },
          "effects": [
            {
              "type": "npc_relationship_adjust",
              "npcId": "Fab",
              "delta": 1
            }
          ]
        },
        {
          "id": "fab_remote",
          "text": "Fab è altrove: restiamo sul contatto a distanza.",
          "goto": "callback",
          "conditions": {
            "path": "npcs.Fab.schedule.locationId",
            "ne": "meridiana_grand_hall"
          },
          "effects": [
            {
              "type": "npc_relationship_adjust",
              "npcId": "Fab",
              "delta": 1
            }
          ]
        }
      ]
    },
    "cynthia": {
      "stitches": [
        {
          "id": "s1",
          "text": "Cynthia ti incontra per un momento fra due appuntamenti. «La qualificazione è un inizio», dice. «Ora devi capire come arrivare pronto al primo incontro.»"
        }
      ],
      "choices": [
        {
          "id": "cynthia_team",
          "text": "Rileggo con lei la continuità del team.",
          "goto": "team_state"
        },
        {
          "id": "cynthia_departure",
          "text": "Parliamo del salto verso il Mondiale.",
          "goto": "departure"
        }
      ]
    },
    "media": {
      "stitches": [
        {
          "id": "s1",
          "text": "I giornalisti chiedono nomi e pronostici. Il tabellone dei partecipanti, però, non mostra ancora gli abbinamenti."
        }
      ],
      "choices": [
        {
          "id": "media_departure",
          "text": "Chiudo il rumore pubblico e torno alla partenza.",
          "goto": "departure"
        },
        {
          "id": "media_team",
          "text": "Controllo cosa resta realmente mio.",
          "goto": "team_state"
        }
      ]
    },
    "team_state": {
      "stitches": [
        {
          "id": "s1",
          "text": "Riguardi la tua squadra prima di partire. Ogni Pokémon porta con sé la propria esperienza, la propria fatica e le cure eventualmente ancora necessarie."
        }
      ],
      "choices": [
        {
          "id": "team_cynthia",
          "text": "Rileggo questo punto con Cynthia.",
          "goto": "cynthia"
        },
        {
          "id": "team_departure",
          "text": "Sono pronto a guardare la partenza.",
          "goto": "departure"
        }
      ]
    },
    "departure": {
      "stitches": [
        {
          "id": "s1",
          "text": "Alla stazione internazionale, gli addetti preparano le partenze dei prossimi giorni. Il luogo del Mondiale è la prossima destinazione, non ancora il posto in cui ti trovi."
        }
      ],
      "choices": [
        {
          "id": "departure_media",
          "text": "Gestisco l'ultima pressione pubblica.",
          "goto": "media"
        },
        {
          "id": "departure_close",
          "text": "Registro Before the Lights come completo.",
          "goto": "close",
          "effects": [
            {
              "type": "set_flag",
              "key": "m7_before_lights_complete",
              "value": true
            }
          ]
        }
      ]
    },
    "callback": {
      "stitches": [
        {
          "id": "s1",
          "text": "Un ultimo saluto dura pochi minuti, quanto basta per una battuta e una promessa di risentirsi quando gli impegni lo permetteranno."
        }
      ],
      "choices": [
        {
          "id": "callback_friends",
          "text": "Posso vedere se è disponibile anche qualcun altro.",
          "goto": "friend_dispatch"
        },
        {
          "id": "callback_departure",
          "text": "Torno alla partenza.",
          "goto": "departure"
        }
      ]
    },
    "close": {
      "stitches": [
        {
          "id": "s1",
          "text": "Le luci del Grand Hall si spengono una fila alla volta. Il Mondiale si avvicina; prima di partire, resta da chiudere gli ultimi impegni a Meridiana."
        }
      ],
      "choices": [
        {
          "id": "close_outcome",
          "text": "Passo all'outcome di questa tappa.",
          "goto": "m07-module-outcome#outcome_entry"
        }
      ]
    }
  }
}
