{
  "schemaVersion": 1,
  "id": "m07-before-the-lights",
  "moduleId": "M07",
  "title": "M7_11 — Before the Lights",
  "locationId": "meridiana_grand_hall",
  "entryNodeId": "before_entry",
  "conditions": {
    "all": [
      {
        "path": "world.flags.m6_complete",
        "eq": true
      },
      {
        "path": "world.flags.m07_unlocked",
        "eq": true
      },
      {
        "path": "world.flags.m7_active",
        "eq": true
      },
      {
        "path": "competition.rank",
        "eq": "S"
      },
      {
        "path": "world.flags.cynthia_met",
        "eq": true
      },
      {
        "path": "world.flags.friend_beat_07_complete",
        "eq": true
      },
      {
        "path": "world.flags.world_qualified",
        "eq": true
      },
      {
        "path": "world.flags.a7_before_lights_available",
        "eq": true
      }
    ]
  },
  "nodes": {
    "before_entry": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il nome del Mondiale comincia a comparire su ogni bacheca. Fra gli annunci arrivano anche messaggi e saluti da persone che hai conosciuto lungo il circuito."
        }
      ],
      "choices": [
        {
          "id": "entry_event",
          "text": "Controllo perché A7_BEFORE_LIGHTS è aperto.",
          "goto": "event_guard"
        },
        {
          "id": "entry_friends",
          "text": "Cerco chi dei Four è davvero disponibile.",
          "goto": "friend_dispatch"
        },
        {
          "id": "entry_team",
          "text": "Controllo ciò che porto con me, senza reset.",
          "goto": "team_state"
        }
      ]
    },
    "event_guard": {
      "stitches": [
        {
          "id": "s1",
          "text": "La partenza si avvicina. Puoi dedicare quest'ultima finestra a una conversazione, prima di lasciare Meridiana."
        }
      ],
      "choices": [
        {
          "id": "event_friends",
          "text": "Passo agli amici disponibili.",
          "goto": "friend_dispatch"
        },
        {
          "id": "event_departure",
          "text": "Rivedo il momento della partenza.",
          "goto": "departure"
        }
      ]
    },
    "friend_dispatch": {
      "stitches": [
        {
          "id": "s1",
          "text": "Controlli se uno degli amici è abbastanza vicino per vedervi. Altrimenti restano una chiamata o un messaggio: ognuno ha proseguito il proprio viaggio."
        }
      ],
      "choices": [
        {
          "id": "friend_luke",
          "text": "Parlo con Luke.",
          "goto": "luke",
          "conditions": {
            "all": [
              {
                "path": "player.name",
                "ne": "Luke"
              },
              {
                "path": "npcs.Luke.schedule.present",
                "eq": true
              }
            ]
          }
        },
        {
          "id": "friend_mattew",
          "text": "Parlo con Mattew.",
          "goto": "mattew",
          "conditions": {
            "all": [
              {
                "path": "player.name",
                "ne": "Mattew"
              },
              {
                "path": "npcs.Mattew.schedule.present",
                "eq": true
              }
            ]
          }
        },
        {
          "id": "friend_daniel",
          "text": "Parlo con Daniel.",
          "goto": "daniel",
          "conditions": {
            "all": [
              {
                "path": "player.name",
                "ne": "Daniel"
              },
              {
                "path": "npcs.Daniel.schedule.present",
                "eq": true
              }
            ]
          }
        },
        {
          "id": "friend_edward",
          "text": "Parlo con Edward.",
          "goto": "edward",
          "conditions": {
            "all": [
              {
                "path": "player.name",
                "ne": "Edward"
              },
              {
                "path": "npcs.Edward.schedule.present",
                "eq": true
              }
            ]
          }
        },
        {
          "id": "friend_fab",
          "text": "Parlo con Fab.",
          "goto": "fab",
          "conditions": {
            "all": [
              {
                "path": "player.name",
                "ne": "Fab"
              },
              {
                "path": "npcs.Fab.schedule.present",
                "eq": true
              }
            ]
          }
        }
      ]
    },
    "luke": {
      "stitches": [
        {
          "id": "s1",
          "text": "Luke alza un sopracciglio. «Il Mondiale? Bene. Vediamo chi riesce a fermarmi senza pretendere che abbandoni i Pokémon che mi piacciono.»"
        }
      ],
      "choices": [
        {
          "id": "luke_physical",
          "text": "Siamo entrambi al Grand Hall: parliamo di persona.",
          "goto": "callback",
          "conditions": {
            "path": "npcs.Luke.schedule.locationId",
            "eq": "meridiana_grand_hall"
          },
          "effects": [
            {
              "type": "npc_relationship_adjust",
              "npcId": "Luke",
              "delta": 1
            }
          ]
        },
        {
          "id": "luke_remote",
          "text": "Luke è altrove: restiamo sul contatto a distanza.",
          "goto": "callback",
          "conditions": {
            "path": "npcs.Luke.schedule.locationId",
            "ne": "meridiana_grand_hall"
          },
          "effects": [
            {
              "type": "npc_relationship_adjust",
              "npcId": "Luke",
              "delta": 1
            }
          ]
        }
      ]
    },
    "mattew": {
      "stitches": [
        {
          "id": "s1",
          "text": "Mattew chiude l'agenda degli allenamenti. «Non ho intenzione di giudicare il tuo percorso dal mio. Però spero tu sappia finalmente leggere un programma senza chiedere aiuto.»"
        }
      ],
      "choices": [
        {
          "id": "mattew_physical",
          "text": "Siamo entrambi al Grand Hall: parliamo di persona.",
          "goto": "callback",
          "conditions": {
            "path": "npcs.Mattew.schedule.locationId",
            "eq": "meridiana_grand_hall"
          },
          "effects": [
            {
              "type": "npc_relationship_adjust",
              "npcId": "Mattew",
              "delta": 1
            }
          ]
        },
        {
          "id": "mattew_remote",
          "text": "Mattew è altrove: restiamo sul contatto a distanza.",
          "goto": "callback",
          "conditions": {
            "path": "npcs.Mattew.schedule.locationId",
            "ne": "meridiana_grand_hall"
          },
          "effects": [
            {
              "type": "npc_relationship_adjust",
              "npcId": "Mattew",
              "delta": 1
            }
          ]
        }
      ]
    },
    "daniel": {
      "stitches": [
        {
          "id": "s1",
          "text": "Daniel osserva il tabellone ancora incompleto. «Non inventarti gli avversari prima del sorteggio. È un ottimo modo per prendere decisioni su cose che non sai.»"
        }
      ],
      "choices": [
        {
          "id": "daniel_physical",
          "text": "Siamo entrambi al Grand Hall: parliamo di persona.",
          "goto": "callback",
          "conditions": {
            "path": "npcs.Daniel.schedule.locationId",
            "eq": "meridiana_grand_hall"
          },
          "effects": [
            {
              "type": "npc_relationship_adjust",
              "npcId": "Daniel",
              "delta": 1
            }
          ]
        },
        {
          "id": "daniel_remote",
          "text": "Daniel è altrove: restiamo sul contatto a distanza.",
          "goto": "callback",
          "conditions": {
            "path": "npcs.Daniel.schedule.locationId",
            "ne": "meridiana_grand_hall"
          },
          "effects": [
            {
              "type": "npc_relationship_adjust",
              "npcId": "Daniel",
              "delta": 1
            }
          ]
        }
      ]
    },
    "edward": {
      "stitches": [
        {
          "id": "s1",
          "text": "Edward controlla Totodile, poi sorride. «Puoi pure diventare famoso, ma voglio vedere almeno un bel colpo. Altrimenti che ti abbiamo lasciato partire a fare?»"
        }
      ],
      "choices": [
        {
          "id": "edward_physical",
          "text": "Siamo entrambi al Grand Hall: parliamo di persona.",
          "goto": "callback",
          "conditions": {
            "path": "npcs.Edward.schedule.locationId",
            "eq": "meridiana_grand_hall"
          },
          "effects": [
            {
              "type": "npc_relationship_adjust",
              "npcId": "Edward",
              "delta": 1
            }
          ]
        },
        {
          "id": "edward_remote",
          "text": "Edward è altrove: restiamo sul contatto a distanza.",
          "goto": "callback",
          "conditions": {
            "path": "npcs.Edward.schedule.locationId",
            "ne": "meridiana_grand_hall"
          },
          "effects": [
            {
              "type": "npc_relationship_adjust",
              "npcId": "Edward",
              "delta": 1
            }
          ]
        }
      ]
    },
    "fab": {
      "stitches": [
        {
          "id": "s1",
          "text": "Fab controlla Koffing, che tenta di curiosare fra i bagagli. «Un consiglio: dormi e mangia qualcosa. E nascondi bene le tue cose, almeno se c'è lui nei paraggi.»"
        }
      ],
      "choices": [
        {
          "id": "fab_physical",
          "text": "Siamo entrambi al Grand Hall: parliamo di persona.",
          "goto": "callback",
          "conditions": {
            "path": "npcs.Fab.schedule.locationId",
            "eq": "meridiana_grand_hall"
          },
          "effects": [
            {
              "type": "npc_relationship_adjust",
              "npcId": "Fab",
              "delta": 1
            }
          ]
        },
        {
          "id": "fab_remote",
          "text": "Fab è altrove: restiamo sul contatto a distanza.",
          "goto": "callback",
          "conditions": {
            "path": "npcs.Fab.schedule.locationId",
            "ne": "meridiana_grand_hall"
          },
          "effects": [
            {
              "type": "npc_relationship_adjust",
              "npcId": "Fab",
              "delta": 1
            }
          ]
        }
      ]
    },
    "cynthia": {
      "stitches": [
        {
          "id": "s1",
          "text": "Se Cynthia è raggiungibile, il suo saluto è misurato. «Il Mondiale non annulla ciò che hai imparato qui. Ricordati che dopo un incontro ne arriva un altro.»"
        }
      ],
      "choices": [
        {
          "id": "cynthia_team",
          "text": "Rileggo con lei la continuità del team.",
          "goto": "team_state"
        },
        {
          "id": "cynthia_departure",
          "text": "Parliamo del salto verso il Mondiale.",
          "goto": "departure"
        }
      ]
    },
    "media": {
      "stitches": [
        {
          "id": "s1",
          "text": "Le telecamere si affollano vicino agli accrediti. Puoi decidere quanto parlare: nessuna intervista ha il potere di giocare le partite al posto tuo."
        }
      ],
      "choices": [
        {
          "id": "media_departure",
          "text": "Chiudo il rumore pubblico e torno alla partenza.",
          "goto": "departure"
        },
        {
          "id": "media_team",
          "text": "Controllo cosa resta realmente mio.",
          "goto": "team_state"
        }
      ]
    },
    "team_state": {
      "stitches": [
        {
          "id": "s1",
          "text": "Prima di partire controlli i tuoi Pokémon e le risorse disponibili. Nessuna cerimonia elimina la stanchezza degli incontri già affrontati."
        }
      ],
      "choices": [
        {
          "id": "team_cynthia",
          "text": "Rileggo questo punto con Cynthia.",
          "goto": "cynthia"
        },
        {
          "id": "team_departure",
          "text": "Sono pronto a guardare la partenza.",
          "goto": "departure"
        }
      ]
    },
    "departure": {
      "stitches": [
        {
          "id": "s1",
          "text": "Al banco partenze compare la sede mondiale. Il viaggio richiederà ancora tempo; Meridiana rimane alle tue spalle soltanto quando scegli di partire."
        }
      ],
      "choices": [
        {
          "id": "departure_media",
          "text": "Gestisco l'ultima pressione pubblica.",
          "goto": "media"
        },
        {
          "id": "departure_close",
          "text": "Registro Before the Lights come completo.",
          "goto": "close",
          "effects": [
            {
              "type": "set_flag",
              "key": "m7_before_lights_complete",
              "value": true
            }
          ]
        }
      ]
    },
    "callback": {
      "stitches": [
        {
          "id": "s1",
          "text": "Un saluto può restare impresso più a lungo di una fotografia. Le parole dette qui contano nei rapporti, non nei risultati futuri."
        }
      ],
      "choices": [
        {
          "id": "callback_friends",
          "text": "Posso vedere se è disponibile anche qualcun altro.",
          "goto": "friend_dispatch"
        },
        {
          "id": "callback_departure",
          "text": "Torno alla partenza.",
          "goto": "departure"
        }
      ]
    },
    "close": {
      "stitches": [
        {
          "id": "s1",
          "text": "Le ultime luci del Grand Hall si accendono. L'appuntamento mondiale è davanti a te, ma il viaggio non è ancora cominciato."
        }
      ],
      "choices": [
        {
          "id": "close_outcome",
          "text": "Passo all'outcome di M7.",
          "goto": "m07-module-outcome#outcome_entry"
        }
      ]
    }
  }
}
