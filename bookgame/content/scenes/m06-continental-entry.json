{
  "schemaVersion": 1,
  "id": "m06-continental-entry",
  "moduleId": "M06",
  "title": "M6_07 — Continental Entry",
  "locationId": "interregional_continental_hall",
  "entryNodeId": "continental_entry",
  "conditions": {
    "all": [
      {
        "path": "world.flags.m5_complete",
        "eq": true
      },
      {
        "path": "world.flags.m06_unlocked",
        "eq": true
      },
      {
        "path": "world.flags.m6_active",
        "eq": true
      },
      {
        "path": "competition.rank",
        "eq": "A"
      },
      {
        "path": "world.flags.friend_beat_06_complete",
        "eq": true
      }
    ]
  },
  "nodes": {
    "continental_entry": {
      "stitches": [
        {
          "id": "s1",
          "text": "Davanti allo sportello della Continental Cup, gli allenatori aspettano sotto una grande insegna. L'addetta controlla la tua licenza di grado A. «Puoi chiedere l'iscrizione, ma devo prima verificare i risultati richiesti dal torneo»."
        }
      ],
      "choices": [
        {
          "id": "entry_eligibility",
          "text": "Verifico se la finestra è davvero aperta.",
          "goto": "eligibility"
        },
        {
          "id": "entry_rules",
          "text": "Rileggo la separazione fra Cup e Rank S.",
          "goto": "rules"
        },
        {
          "id": "entry_defer",
          "text": "Rimando senza iscrivermi.",
          "goto": "defer"
        }
      ]
    },
    "eligibility": {
      "stitches": [
        {
          "id": "s1",
          "text": "L'addetta consulta il registro Masters e confronta il tuo nome con i requisiti esposti. «La licenza da sola non basta. Serve anche una qualificazione valida», spiega, senza anticipare il responso."
        }
      ],
      "choices": [
        {
          "id": "eligible_register",
          "text": "La finestra è aperta: vado al banco.",
          "goto": "registration",
          "conditions": {
            "path": "world.flags.a6_continental_available",
            "eq": true
          }
        },
        {
          "id": "eligible_wait",
          "text": "La finestra non è ancora utile: torno al calendario.",
          "goto": "calendar"
        }
      ]
    },
    "rules": {
      "stitches": [
        {
          "id": "s1",
          "text": "Un arbitro indica il regolamento affisso accanto all'ingresso. «Questa coppa assegna un titolo e un piazzamento. La promozione al grado S si ottiene in una prova diversa, al Faro»."
        }
      ],
      "choices": [
        {
          "id": "rules_eligibility",
          "text": "Torno all'eligibility.",
          "goto": "eligibility"
        },
        {
          "id": "rules_calendar",
          "text": "Controllo il calendario.",
          "goto": "calendar"
        }
      ]
    },
    "calendar": {
      "stitches": [
        {
          "id": "s1",
          "text": "Sul calendario sono segnate le giornate della coppa, insieme ad altri appuntamenti del circuito. L'addetta avverte: «Puoi aspettare, ma le iscrizioni non resteranno aperte per sempre»."
        }
      ],
      "choices": [
        {
          "id": "calendar_register",
          "text": "Se disponibile, procedo alla registrazione.",
          "goto": "registration",
          "conditions": {
            "path": "world.flags.a6_continental_available",
            "eq": true
          }
        },
        {
          "id": "calendar_decline",
          "text": "Rinuncio alla Cup per questa finestra.",
          "goto": "decline"
        }
      ]
    },
    "registration": {
      "stitches": [
        {
          "id": "s1",
          "text": "Al banco ti porgono il modulo d'iscrizione. L'addetta ricontrolla il nominativo e indica l'area dove, prima dell'incontro, verrà verificata la squadra ammessa."
        }
      ],
      "choices": [
        {
          "id": "register_now",
          "text": "Confermo l'iscrizione alla Continental Cup.",
          "goto": "registered",
          "conditions": {
            "path": "world.flags.continental_registration_complete",
            "ne": true
          },
          "effects": [
            {
              "type": "set_flag",
              "key": "continental_registration_complete",
              "value": true
            },
            {
              "type": "set_flag",
              "key": "continental_registration_status",
              "value": "registered"
            },
            {
              "type": "set_location",
              "locationId": "interregional_continental_hall"
            }
          ]
        },
        {
          "id": "register_status",
          "text": "La registrazione esiste già: ne controllo lo stato.",
          "goto": "registered",
          "conditions": {
            "path": "world.flags.continental_registration_complete",
            "eq": true
          }
        },
        {
          "id": "register_back",
          "text": "Non firmo ancora.",
          "goto": "defer"
        }
      ]
    },
    "registered": {
      "stitches": [
        {
          "id": "s1",
          "text": "L'addetta appone un timbro sul modulo. «Iscrizione confermata. Gli accoppiamenti saranno quelli del tabellone ufficiale». Dietro di lei, altri allenatori attendono il proprio turno."
        }
      ],
      "choices": [
        {
          "id": "registered_prep",
          "text": "Definisco un focus senza bonus invisibili.",
          "goto": "prep"
        },
        {
          "id": "registered_enter",
          "text": "Entro nel bracket reale della Cup.",
          "goto": "m06-continental-cup#cup_entry"
        }
      ]
    },
    "prep": {
      "stitches": [
        {
          "id": "s1",
          "text": "Nell'area riservata, un allenatore ripassa appunti mentre un altro controlla le Poké Ball. Hai tempo per studiare il formato e decidere come affrontare gli avversari."
        }
      ],
      "choices": [
        {
          "id": "prep_information",
          "text": "Focus: informazioni pubbliche e fog of war.",
          "goto": "opponent",
          "effects": [
            {
              "type": "set_flag",
              "key": "continental_prep_focus",
              "value": "information"
            }
          ]
        },
        {
          "id": "prep_resources",
          "text": "Focus: gestione risorse fra round.",
          "goto": "registered",
          "effects": [
            {
              "type": "set_flag",
              "key": "continental_prep_focus",
              "value": "resources"
            }
          ]
        }
      ]
    },
    "opponent": {
      "stitches": [
        {
          "id": "s1",
          "text": "Sul tabellone compaiono gli iscritti alla Continental Cup. I nomi sono quelli degli allenatori qualificati; gli abbinamenti seguono il sorteggio esposto dagli organizzatori."
        }
      ],
      "choices": [
        {
          "id": "opponent_rules",
          "text": "Rileggo le regole di avanzamento.",
          "goto": "rules"
        },
        {
          "id": "opponent_registered",
          "text": "Torno allo stato di registrazione.",
          "goto": "registered"
        }
      ]
    },
    "defer": {
      "stitches": [
        {
          "id": "s1",
          "text": "Ti sposti fuori dalla fila senza consegnare il modulo. Gli sportelli restano aperti per il momento, ma il calendario continua ad avanzare."
        }
      ],
      "choices": [
        {
          "id": "defer_masters",
          "text": "Torno al Masters Circuit.",
          "goto": "route"
        },
        {
          "id": "defer_return",
          "text": "Riconsidero la Continental Cup.",
          "goto": "continental_entry"
        }
      ]
    },
    "decline": {
      "stitches": [
        {
          "id": "s1",
          "text": "Restituisci il modulo non compilato. L'addetta prende nota della rinuncia e chiama il prossimo allenatore. La coppa andrà avanti anche senza di te."
        }
      ],
      "choices": [
        {
          "id": "decline_confirm",
          "text": "Confermo che salto questa Continental Cup.",
          "goto": "close",
          "effects": [
            {
              "type": "set_flag",
              "key": "continental_registration_status",
              "value": "declined"
            },
            {
              "type": "set_flag",
              "key": "continental_result",
              "value": "skipped"
            },
            {
              "type": "set_flag",
              "key": "continental_complete",
              "value": true
            }
          ]
        },
        {
          "id": "decline_cancel",
          "text": "No, voglio solo rimandare.",
          "goto": "defer"
        }
      ]
    },
    "close": {
      "stitches": [
        {
          "id": "s1",
          "text": "All'uscita trovi due cartelli distinti: uno indica la Continental Cup, l'altro la prova di promozione al Faro. Nessuno dei due sostituisce l'altro."
        }
      ],
      "choices": [
        {
          "id": "close_cup",
          "text": "Sono registrato: apro il bracket.",
          "goto": "m06-continental-cup#cup_entry",
          "conditions": {
            "path": "world.flags.continental_registration_complete",
            "eq": true
          }
        },
        {
          "id": "close_ancient",
          "text": "Ho saltato la Cup: proseguo verso il secondo layer del mistero.",
          "goto": "m06-ancient-layer-two#layer_entry",
          "conditions": {
            "path": "world.flags.continental_result",
            "eq": "skipped"
          }
        }
      ]
    },
    "route": {
      "stitches": [
        {
          "id": "s1",
          "text": "Dalla piazza puoi tornare all'arena Masters. Gli annunci della Continental Cup continuano a risuonare dagli altoparlanti, ma non sei obbligato a entrare subito."
        }
      ],
      "choices": [
        {
          "id": "route_masters",
          "text": "Torno al Masters Circuit.",
          "goto": "m06-masters-circuit#circuit_hub"
        }
      ]
    }
  }
}
