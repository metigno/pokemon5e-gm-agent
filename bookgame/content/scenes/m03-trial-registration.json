{
  "schemaVersion": 1,
  "id": "m03-trial-registration",
  "moduleId": "M03",
  "title": "M3_12 — Registrazione Trial D→C",
  "locationId": "fer_city_arena",
  "entryNodeId": "trial_info",
  "conditions": {
    "all": [
      {
        "path": "world.flags.m2_complete",
        "eq": true
      },
      {
        "path": "world.flags.m03_unlocked",
        "eq": true
      },
      {
        "path": "world.flags.m3_active",
        "eq": true
      },
      {
        "path": "competition.rank",
        "eq": "D"
      },
      {
        "path": "world.flags.a3_rank_trial_d_c_available",
        "eq": true
      }
    ]
  },
  "nodes": {
    "trial_info": {
      "stitches": [
        {
          "id": "info_1",
          "text": "Il Promotion Trial D→C si svolge all'Officina Arena di Ferravia. È il gate reale verso Rank C: Singles, roster ufficiale da tre, una sola esaminatrice, vittoria obbligatoria, retry consentito."
        }
      ],
      "choices": [
        {
          "id": "go_desk",
          "text": "Vado al banco di registrazione.",
          "goto": "trial_desk"
        },
        {
          "id": "format_info",
          "text": "Chiedo come viene valutato il Trial.",
          "goto": "format_review"
        },
        {
          "id": "registered_status",
          "text": "Controllo una registrazione già attiva.",
          "conditions": {
            "path": "competition.trials.RANK_D_TO_C.registered",
            "eq": true
          },
          "goto": "registered"
        },
        {
          "id": "postpone",
          "text": "Non sono pronto. Torno più tardi.",
          "goto": "postponed"
        },
        {
          "id": "audit_eligibility",
          "text": "Verifico come il gioco determina davvero l'idoneità.",
          "goto": "eligibility_audit"
        },
        {
          "id": "review_attempt_history",
          "text": "Rivedo eventuali tentativi precedenti.",
          "conditions": {
            "path": "competition.trials.RANK_D_TO_C.attempts",
            "gte": 1
          },
          "goto": "attempt_history"
        }
      ]
    },
    "format_review": {
      "stitches": [
        {
          "id": "format_1",
          "text": "L'identità del checkpoint è tempo, resistenze, coperture e switch. Non c'è level scaling invisibile: l'esaminatore usa il roster fissato per questa fascia."
        }
      ],
      "choices": [
        {
          "id": "format_to_desk",
          "text": "Vado al banco.",
          "goto": "trial_desk"
        },
        {
          "id": "format_roster",
          "text": "Controllo prima il mio roster reale.",
          "goto": "roster_review"
        },
        {
          "id": "format_back",
          "text": "Torno alle informazioni generali.",
          "goto": "trial_info"
        }
      ]
    },
    "trial_desk": {
      "stitches": [
        {
          "id": "desk_1",
          "text": "L'addetto passa la tessera nel lettore, poi conta i Pokémon disponibili. «Rank D confermato. Per iscriverti devi poterne dichiarare almeno tre.»"
        }
      ],
      "choices": [
        {
          "id": "register_now",
          "text": "Registro il roster per il Trial D→C.",
          "conditions": {
            "all": [
              {
                "path": "competition.trials.RANK_D_TO_C.available",
                "eq": true
              },
              {
                "path": "competition.trials.RANK_D_TO_C.registered",
                "ne": true
              },
              {
                "path": "player.roster.length",
                "gte": 3
              }
            ]
          },
          "goto": "registered",
          "effects": [
            {
              "type": "competition_trial_register",
              "checkpointId": "RANK_D_TO_C"
            }
          ]
        },
        {
          "id": "check_roster",
          "text": "Controllo l'idoneità del roster.",
          "goto": "roster_review"
        },
        {
          "id": "examiner_info",
          "text": "Chiedo il profilo pubblico dell'esaminatrice.",
          "goto": "examiner_review"
        },
        {
          "id": "leave_desk",
          "text": "Mi allontano senza registrarmi.",
          "goto": "postponed"
        }
      ]
    },
    "roster_review": {
      "stitches": [
        {
          "id": "roster_1",
          "text": "Servono almeno tre Pokémon reali nel roster. Il Trial non presta membri e non usa copie narrative della squadra."
        }
      ],
      "choices": [
        {
          "id": "roster_ok_register",
          "text": "Ho almeno tre Pokémon: registro.",
          "conditions": {
            "all": [
              {
                "path": "competition.trials.RANK_D_TO_C.available",
                "eq": true
              },
              {
                "path": "competition.trials.RANK_D_TO_C.registered",
                "ne": true
              },
              {
                "path": "player.roster.length",
                "gte": 3
              }
            ]
          },
          "goto": "registered",
          "effects": [
            {
              "type": "competition_trial_register",
              "checkpointId": "RANK_D_TO_C"
            }
          ]
        },
        {
          "id": "roster_short",
          "text": "Non ho ancora tre Pokémon: torno a prepararmi.",
          "conditions": {
            "path": "player.roster.length",
            "lt": 3
          },
          "goto": "postponed"
        },
        {
          "id": "roster_back",
          "text": "Torno al banco.",
          "goto": "trial_desk"
        }
      ]
    },
    "examiner_review": {
      "stitches": [
        {
          "id": "examiner_1",
          "text": "L'esaminatrice di fascia usa un profilo tecnico stabile: controllo del tempo e punizione dei cambi prevedibili. Il registro pubblico non rivela mosse o risorse correnti."
        }
      ],
      "choices": [
        {
          "id": "examiner_strategy",
          "text": "Chiedo quale abilità generale viene valutata di più.",
          "goto": "strategy_review"
        },
        {
          "id": "examiner_desk",
          "text": "Torno al banco.",
          "goto": "trial_desk"
        },
        {
          "id": "examiner_postpone",
          "text": "Mi preparo ancora prima di registrarmi.",
          "goto": "postponed"
        }
      ]
    },
    "strategy_review": {
      "stitches": [
        {
          "id": "strategy_1",
          "text": "Il consiglio è volutamente generale: non perdere tempo in cambi senza scopo, proteggi le resistenze che ti servono e non costruire la linea di gioco su informazioni che il tuo Trainer non possiede."
        }
      ],
      "choices": [
        {
          "id": "strategy_desk",
          "text": "Ora registro.",
          "goto": "trial_desk"
        },
        {
          "id": "strategy_roster",
          "text": "Rivedo il roster.",
          "goto": "roster_review"
        },
        {
          "id": "strategy_postpone",
          "text": "Torno più tardi.",
          "goto": "postponed"
        },
        {
          "id": "plan_coverage",
          "text": "Ragiono sulla copertura dei tre slot ufficiali.",
          "goto": "coverage_plan"
        },
        {
          "id": "plan_switch",
          "text": "Ragiono sulla disciplina degli switch.",
          "goto": "switch_plan"
        },
        {
          "id": "plan_tempo",
          "text": "Ragiono sulla gestione del tempo.",
          "goto": "tempo_plan"
        },
        {
          "id": "use_cup_context",
          "text": "Uso l'esperienza della Regional Cup come riferimento.",
          "conditions": {
            "path": "world.flags.regional_cup_result",
            "exists": true
          },
          "goto": "cup_context"
        },
        {
          "id": "check_post_rescue_condition",
          "text": "Controllo lo stato reale della squadra dopo Ferrox.",
          "conditions": {
            "path": "world.flags.ferrox_rescue_state",
            "exists": true
          },
          "goto": "rescue_condition_check"
        }
      ]
    },
    "registered": {
      "stitches": [
        {
          "id": "registered_1",
          "text": "L'addetto timbra il modulo e ti restituisce la ricevuta. «Registrazione confermata. Tre Pokémon dichiarati; il Rank resta D finché non vinci il Trial.»"
        }
      ],
      "choices": [
        {
          "id": "enter_trial",
          "text": "Entro nel Promotion Trial D→C.",
          "conditions": {
            "all": [
              {
                "path": "competition.rank",
                "eq": "D"
              },
              {
                "path": "competition.trials.RANK_D_TO_C.registered",
                "eq": true
              }
            ]
          },
          "goto": "m03-promotion-trial-d-c#trial_gate_call"
        },
        {
          "id": "prep_first",
          "text": "Rivedo ancora la preparazione.",
          "goto": "registered_prep"
        },
        {
          "id": "return_later",
          "text": "La registrazione resta valida; torno a Ferravia.",
          "goto": "m03-ferravia-arrival#city_hub",
          "effects": [
            {
              "type": "set_location",
              "locationId": "fer_city"
            }
          ]
        },
        {
          "id": "audit_registration",
          "text": "Controllo i dati della registrazione.",
          "goto": "registration_audit"
        }
      ]
    },
    "registered_prep": {
      "stitches": [
        {
          "id": "prep_1",
          "text": "Prepararti non cambia il roster registrato in un duplicato narrativo. Stai soltanto decidendo se entrare adesso o più tardi."
        }
      ],
      "choices": [
        {
          "id": "prep_enter",
          "text": "Sono pronto: entro nel Trial.",
          "conditions": {
            "path": "competition.trials.RANK_D_TO_C.registered",
            "eq": true
          },
          "goto": "m03-promotion-trial-d-c#trial_gate_call"
        },
        {
          "id": "prep_back",
          "text": "Torno alla conferma di registrazione.",
          "goto": "registered"
        },
        {
          "id": "prep_hub",
          "text": "Torno al centro di Ferravia.",
          "goto": "m03-ferravia-arrival#city_hub",
          "effects": [
            {
              "type": "set_location",
              "locationId": "fer_city"
            }
          ]
        }
      ]
    },
    "postponed": {
      "stitches": [
        {
          "id": "postpone_1",
          "text": "Lasci il banco senza iniziare il Trial. L'iscrizione resta disponibile e nessun tentativo viene segnato finché non entri in campo."
        }
      ],
      "choices": [
        {
          "id": "postpone_hub",
          "text": "Torno a Ferravia.",
          "goto": "m03-ferravia-arrival#city_hub",
          "effects": [
            {
              "type": "set_location",
              "locationId": "fer_city"
            }
          ]
        },
        {
          "id": "postpone_desk",
          "text": "Cambio idea e torno al banco.",
          "goto": "trial_desk"
        }
      ]
    },
    "eligibility_audit": {
      "stitches": [
        {
          "id": "elig_1",
          "text": "L'addetto ricontrolla tessera, autorizzazione e squadra. «Rank D, accesso al Trial e almeno tre Pokémon disponibili: sono questi i requisiti.»"
        }
      ],
      "choices": [
        {
          "id": "elig_to_roster",
          "text": "Controllo il roster reale.",
          "goto": "roster_review"
        },
        {
          "id": "elig_to_desk",
          "text": "Vado al banco con i requisiti chiari.",
          "goto": "trial_desk"
        },
        {
          "id": "elig_back",
          "text": "Torno alle informazioni.",
          "goto": "trial_info"
        }
      ]
    },
    "coverage_plan": {
      "stitches": [
        {
          "id": "coverage_1",
          "text": "La copertura non significa indovinare l'avversario. Significa evitare che tutti e tre i membri ufficiali dipendano dallo stesso tipo di risposta."
        }
      ],
      "choices": [
        {
          "id": "coverage_note",
          "text": "Registro una priorità di copertura equilibrata.",
          "goto": "strategy_review",
          "effects": [
            {
              "type": "set_flag",
              "key": "trial_d_c_prep_focus",
              "value": "coverage"
            }
          ]
        },
        {
          "id": "coverage_switch",
          "text": "Preferisco costruire il piano attorno agli switch.",
          "goto": "switch_plan"
        }
      ]
    },
    "switch_plan": {
      "stitches": [
        {
          "id": "switch_1",
          "text": "Il checkpoint valuta gli switch perché ogni cambio costa tempo e posizione. L'obiettivo è avere un motivo per cambiare, non cambiare per inerzia."
        }
      ],
      "choices": [
        {
          "id": "switch_note",
          "text": "Registro la disciplina sugli switch come focus.",
          "goto": "strategy_review",
          "effects": [
            {
              "type": "set_flag",
              "key": "trial_d_c_prep_focus",
              "value": "switch_discipline"
            }
          ]
        },
        {
          "id": "switch_tempo",
          "text": "Collego gli switch alla gestione del tempo.",
          "goto": "tempo_plan"
        }
      ]
    },
    "tempo_plan": {
      "stitches": [
        {
          "id": "tempo_1",
          "text": "Il tempo è una risorsa del match: turni, finestre di pressione e capacità di non cedere iniziativa. La scena non assegna bonus; registra soltanto il tuo piano."
        }
      ],
      "choices": [
        {
          "id": "tempo_note",
          "text": "Registro la gestione del tempo come focus.",
          "goto": "strategy_review",
          "effects": [
            {
              "type": "set_flag",
              "key": "trial_d_c_prep_focus",
              "value": "tempo"
            }
          ]
        },
        {
          "id": "tempo_back",
          "text": "Torno alla strategia generale.",
          "goto": "strategy_review"
        }
      ]
    },
    "cup_context": {
      "stitches": [
        {
          "id": "cup_context_1",
          "text": "Se hai disputato la Regional Cup, puoi usare quei match come esperienza reale. Il Trial non importa vittorie o sconfitte come bonus automatici."
        }
      ],
      "choices": [
        {
          "id": "cup_context_record",
          "text": "Uso la Cup come riferimento tattico, non come vantaggio numerico.",
          "goto": "strategy_review",
          "effects": [
            {
              "type": "set_flag",
              "key": "trial_d_c_cup_context_reviewed",
              "value": true
            }
          ]
        },
        {
          "id": "cup_context_back",
          "text": "Torno alla preparazione senza usarla.",
          "goto": "strategy_review"
        }
      ]
    },
    "rescue_condition_check": {
      "stitches": [
        {
          "id": "rescue_condition_1",
          "text": "Prima di confermare, controlli la squadra dopo gli eventi di Ferrox. L'iscrizione non cura ferite, non recupera energie e non rimuove condizioni."
        }
      ],
      "choices": [
        {
          "id": "rescue_condition_note",
          "text": "Accetto lo stato reale e pianifico attorno ad esso.",
          "goto": "strategy_review",
          "effects": [
            {
              "type": "set_flag",
              "key": "trial_d_c_condition_reviewed",
              "value": true
            }
          ]
        },
        {
          "id": "rescue_condition_hub",
          "text": "Preferisco tornare a Ferravia prima di registrarmi.",
          "goto": "postponed"
        }
      ]
    },
    "registration_audit": {
      "stitches": [
        {
          "id": "audit_1",
          "text": "La registrazione confermata mostra checkpoint, rank di partenza, rank obiettivo, roster richiesto e retryability. Non memorizza una copia alternativa della squadra."
        }
      ],
      "choices": [
        {
          "id": "audit_enter",
          "text": "I dati sono corretti: entro nel Trial.",
          "conditions": {
            "path": "competition.trials.RANK_D_TO_C.registered",
            "eq": true
          },
          "goto": "m03-promotion-trial-d-c#trial_gate_call"
        },
        {
          "id": "audit_prep",
          "text": "Rivedo ancora il piano.",
          "goto": "registered_prep"
        },
        {
          "id": "audit_hub",
          "text": "Torno in città mantenendo la registrazione.",
          "goto": "m03-ferravia-arrival#city_hub",
          "effects": [
            {
              "type": "set_location",
              "locationId": "fer_city"
            }
          ]
        }
      ]
    },
    "attempt_history": {
      "stitches": [
        {
          "id": "attempt_history_1",
          "text": "Sul registro compare anche il tentativo precedente, se ne hai già disputato uno. Una sconfitta resta nello storico, ma non modifica le regole del nuovo incontro."
        }
      ],
      "choices": [
        {
          "id": "attempt_history_desk",
          "text": "Torno al banco con il tentativo precedente in mente.",
          "goto": "trial_desk",
          "effects": [
            {
              "type": "set_flag",
              "key": "trial_d_c_attempt_history_reviewed",
              "value": true
            }
          ]
        },
        {
          "id": "attempt_history_strategy",
          "text": "Uso il tentativo precedente solo come informazione tattica.",
          "goto": "strategy_review",
          "effects": [
            {
              "type": "set_flag",
              "key": "trial_d_c_attempt_history_reviewed",
              "value": true
            }
          ]
        }
      ]
    }
  }
}
