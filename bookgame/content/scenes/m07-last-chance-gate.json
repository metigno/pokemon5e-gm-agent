{
  "schemaVersion": 1,
  "id": "m07-last-chance-gate",
  "moduleId": "M07",
  "title": "M7_09 — Last Chance Gate",
  "locationId": "meridiana_grand_hall",
  "entryNodeId": "gate_entry",
  "conditions": {
    "all": [
      {
        "path": "world.flags.m6_complete",
        "eq": true
      },
      {
        "path": "world.flags.m07_unlocked",
        "eq": true
      },
      {
        "path": "world.flags.m7_active",
        "eq": true
      },
      {
        "path": "competition.rank",
        "eq": "S"
      },
      {
        "path": "world.flags.m7_qualifier_result_resolved",
        "eq": true
      }
    ]
  },
  "nodes": {
    "gate_entry": {
      "stitches": [
        {
          "id": "s1",
          "text": "Al banco qualificazioni trovi un avviso sulle ultime possibilità di accesso al Mondiale. Non tutti gli allenatori possono presentarsi: dipende dal percorso già compiuto."
        }
      ],
      "choices": [
        {
          "id": "entry_qualified",
          "text": "Sono già qualificato: verifico il bypass.",
          "goto": "qualified_bypass",
          "conditions": {
            "path": "world.flags.world_qualified",
            "eq": true
          }
        },
        {
          "id": "entry_eligibility",
          "text": "Non sono qualificato: controllo l'eligibility.",
          "goto": "eligibility",
          "conditions": {
            "path": "world.flags.world_qualified",
            "ne": true
          }
        },
        {
          "id": "entry_history",
          "text": "Rivedo il risultato del Qualifier.",
          "goto": "qualifier_history"
        }
      ]
    },
    "qualified_bypass": {
      "stitches": [
        {
          "id": "s1",
          "text": "«Lei è già qualificato», dice l'addetta. «Non può occupare un posto nella selezione riservata agli esclusi.»"
        }
      ],
      "choices": [
        {
          "id": "qualified_record",
          "text": "Registro il bypass.",
          "goto": "close",
          "effects": [
            {
              "type": "set_flag",
              "key": "m7_last_chance_gate_complete",
              "value": true
            },
            {
              "type": "set_flag",
              "key": "m7_last_chance_route_ready",
              "value": false
            },
            {
              "type": "set_flag",
              "key": "worlds_departure_imminent",
              "value": true
            }
          ]
        },
        {
          "id": "qualified_history",
          "text": "Rivedo la history.",
          "goto": "qualifier_history"
        }
      ]
    },
    "eligibility": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il personale controlla la tua registrazione e l'elenco degli ammessi all'ultima selezione. Senza entrambi non c'è alcuna iscrizione da firmare."
        }
      ],
      "choices": [
        {
          "id": "eligibility_open",
          "text": "Il Last Chance è disponibile.",
          "goto": "available",
          "conditions": {
            "all": [
              {
                "path": "world.flags.last_chance_eligible",
                "eq": true
              },
              {
                "path": "world.flags.a7_last_chance_available",
                "eq": true
              }
            ]
          }
        },
        {
          "id": "eligibility_closed",
          "text": "Non esiste una route legale disponibile.",
          "goto": "unavailable",
          "conditions": {
            "any": [
              {
                "path": "world.flags.last_chance_eligible",
                "ne": true
              },
              {
                "path": "world.flags.a7_last_chance_available",
                "ne": true
              }
            ]
          }
        },
        {
          "id": "eligibility_rule",
          "text": "Rileggo perché il retry non è infinito.",
          "goto": "finite_rule"
        }
      ]
    },
    "available": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il tuo nome compare nell'elenco dei convocati. Avrai una sola occasione, separata dagli incontri che hai già perso."
        }
      ],
      "choices": [
        {
          "id": "available_rule",
          "text": "Rivedo la regola di unicità.",
          "goto": "finite_rule"
        },
        {
          "id": "available_context",
          "text": "Controllo amici e Cynthia prima di decidere.",
          "goto": "friend_context"
        },
        {
          "id": "available_open",
          "text": "Apro formalmente la route Last Chance.",
          "goto": "gate_open"
        }
      ]
    },
    "unavailable": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il tuo nome non è nella lista. Il banco non può inventare un'altra gara per aggirare la chiusura delle iscrizioni."
        }
      ],
      "choices": [
        {
          "id": "unavailable_close",
          "text": "Chiudo il gate come non disponibile.",
          "goto": "gate_closed"
        },
        {
          "id": "unavailable_history",
          "text": "Rivedo il Qualifier.",
          "goto": "qualifier_history"
        }
      ]
    },
    "finite_rule": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il regolamento è affisso accanto allo sportello: un unico tentativo, senza ripetizioni a oltranza."
        }
      ],
      "choices": [
        {
          "id": "finite_available",
          "text": "Torno allo stato dell'accesso.",
          "goto": "eligibility"
        },
        {
          "id": "finite_history",
          "text": "Rivedo il motivo per cui sono qui.",
          "goto": "qualifier_history"
        }
      ]
    },
    "qualifier_history": {
      "stitches": [
        {
          "id": "s1",
          "text": "Nel registro rimane la sconfitta precedente. Una nuova possibilità non elimina la partita già giocata."
        }
      ],
      "choices": [
        {
          "id": "history_eligibility",
          "text": "Torno al controllo eligibility.",
          "goto": "eligibility",
          "conditions": {
            "path": "world.flags.world_qualified",
            "ne": true
          }
        },
        {
          "id": "history_qualified",
          "text": "Torno al bypass qualificato.",
          "goto": "qualified_bypass",
          "conditions": {
            "path": "world.flags.world_qualified",
            "eq": true
          }
        }
      ]
    },
    "friend_context": {
      "stitches": [
        {
          "id": "s1",
          "text": "Se hai parlato con uno degli amici, le sue parole possono pesare mentre guardi l'ultima iscrizione possibile."
        }
      ],
      "choices": [
        {
          "id": "friend_cynthia",
          "text": "Rileggo anche il benchmark di Cynthia.",
          "goto": "cynthia_context"
        },
        {
          "id": "friend_open",
          "text": "Torno all'apertura della route.",
          "goto": "available"
        }
      ]
    },
    "cynthia_context": {
      "stitches": [
        {
          "id": "s1",
          "text": "Ti torna in mente il consiglio di Cynthia: non sacrificare tutte le risorse per la fretta di riscattarti."
        }
      ],
      "choices": [
        {
          "id": "cynthia_schedule",
          "text": "Controllo se conviene entrare subito o proteggere il tempo.",
          "goto": "schedule"
        }
      ]
    },
    "schedule": {
      "stitches": [
        {
          "id": "s1",
          "text": "Un orologio mostra quanto resta della finestra d'iscrizione. Aspettare può essere una scelta, ma non allunga il termine."
        }
      ],
      "choices": [
        {
          "id": "schedule_wait",
          "text": "Aspetto un'ora e ricontrollo.",
          "goto": "defer",
          "timeCostMinutes": 60
        },
        {
          "id": "schedule_open",
          "text": "Entro nella route senza altra attesa.",
          "goto": "gate_open"
        }
      ]
    },
    "defer": {
      "stitches": [
        {
          "id": "s1",
          "text": "Ti allontani dal banco senza firmare. Quando tornerai, dovrai controllare se le iscrizioni sono ancora aperte."
        }
      ],
      "choices": [
        {
          "id": "defer_check",
          "text": "Ricontrollo l'eligibility.",
          "goto": "eligibility"
        },
        {
          "id": "defer_hub",
          "text": "Torno temporaneamente alla piazza.",
          "goto": "m07-meridiana-arrival#city_hub"
        }
      ]
    },
    "gate_open": {
      "stitches": [
        {
          "id": "s1",
          "text": "L'addetto segna il tuo nome fra i partecipanti ammessi. Il combattimento decisivo deve ancora essere affrontato."
        }
      ],
      "choices": [
        {
          "id": "open_record",
          "text": "Registro la route pronta.",
          "goto": "close",
          "effects": [
            {
              "type": "set_flag",
              "key": "m7_last_chance_route_ready",
              "value": true
            },
            {
              "type": "set_flag",
              "key": "m7_last_chance_gate_complete",
              "value": true
            }
          ]
        },
        {
          "id": "open_back",
          "text": "Rivedo il gate prima di confermare.",
          "goto": "available"
        }
      ]
    },
    "gate_closed": {
      "stitches": [
        {
          "id": "s1",
          "text": "Le iscrizioni non sono accessibili per il tuo percorso. Dovrai continuare la carriera senza questa ulteriore prova."
        }
      ],
      "choices": [
        {
          "id": "closed_record",
          "text": "Registro il gate chiuso.",
          "goto": "close",
          "effects": [
            {
              "type": "set_flag",
              "key": "m7_last_chance_route_ready",
              "value": false
            },
            {
              "type": "set_flag",
              "key": "m7_last_chance_gate_complete",
              "value": true
            }
          ]
        },
        {
          "id": "closed_history",
          "text": "Rivedo la history.",
          "goto": "qualifier_history"
        }
      ]
    },
    "close": {
      "stitches": [
        {
          "id": "s1",
          "text": "Lasci lo sportello sapendo se hai ancora una partita da disputare oppure se la stagione mondiale è già sfuggita."
        }
      ],
      "choices": [
        {
          "id": "close_qualified",
          "text": "Sono qualificato: passo a Before the Lights.",
          "goto": "m07-before-the-lights#before_entry",
          "conditions": {
            "path": "world.flags.world_qualified",
            "eq": true
          }
        },
        {
          "id": "close_last_chance",
          "text": "La route Last Chance è pronta: la consumo adesso.",
          "goto": "m07-last-chance#last_chance_entry",
          "conditions": {
            "all": [
              {
                "path": "world.flags.world_qualified",
                "ne": true
              },
              {
                "path": "world.flags.m7_last_chance_route_ready",
                "eq": true
              }
            ]
          }
        },
        {
          "id": "close_worlds_missed",
          "text": "Non esiste una route qualificante residua: affronto Worlds Missed.",
          "goto": "m07-worlds-missed#missed_entry",
          "conditions": {
            "all": [
              {
                "path": "world.flags.world_qualified",
                "ne": true
              },
              {
                "path": "world.flags.m7_last_chance_gate_complete",
                "eq": true
              },
              {
                "path": "world.flags.m7_last_chance_route_ready",
                "eq": false
              }
            ]
          }
        }
      ]
    }
  }
}
