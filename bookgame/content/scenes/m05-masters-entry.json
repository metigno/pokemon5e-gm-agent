{
  "schemaVersion": 1,
  "id": "m05-masters-entry",
  "moduleId": "M05",
  "title": "M5_13 — Masters Circuit Entry",
  "locationId": "alt_town_crest",
  "entryNodeId": "masters_entry",
  "conditions": {
    "all": [
      {
        "path": "world.flags.m4_complete",
        "eq": true
      },
      {
        "path": "world.flags.m05_unlocked",
        "eq": true
      },
      {
        "path": "world.flags.m5_active",
        "eq": true
      },
      {
        "path": "competition.rankOrder",
        "gte": 5
      },
      {
        "path": "world.flags.a5_masters_entry_available",
        "eq": true
      }
    ]
  },
  "nodes": {
    "masters_entry": {
      "stitches": [
        {
          "id": "me1",
          "text": "Con il Rank A, alla Sala della Cresta puoi finalmente chiedere l'accesso al circuito Masters. Il calendario indica gli incontri che stabiliranno da quale posizione inizierai."
        }
      ],
      "choices": [
        {
          "id": "entry_rules",
          "text": "Leggo cosa conta e cosa non conta il Masters Entry.",
          "goto": "entry_rules"
        },
        {
          "id": "entry_eligibility",
          "text": "Verifico perché la finestra è aperta.",
          "goto": "eligibility_review"
        },
        {
          "id": "entry_register",
          "text": "Vado al banco di ingresso.",
          "goto": "registration_desk"
        },
        {
          "id": "entry_defer",
          "text": "Non entro ancora nel Masters Circuit.",
          "goto": "deferred"
        }
      ]
    },
    "entry_rules": {
      "stitches": [
        {
          "id": "er1",
          "text": "Il Masters Entry è un match ufficiale di seeding. Vittoria e sconfitta restano reali e influenzano la fascia iniziale; nessun esito apre aree geografiche o sostituisce il futuro Trial A→S."
        }
      ],
      "choices": [
        {
          "id": "rules_seeding",
          "text": "Approfondisco come viene usato il risultato.",
          "goto": "seeding_explainer"
        },
        {
          "id": "rules_opponent",
          "text": "Leggo il profilo pubblico dell'avversaria.",
          "goto": "opponent_preview"
        },
        {
          "id": "rules_register",
          "text": "Procedo con l'ingresso.",
          "goto": "registration_desk"
        }
      ]
    },
    "eligibility_review": {
      "stitches": [
        {
          "id": "el1",
          "text": "L'addetto controlla il Rank A e gli altri requisiti d'ingresso. Il posto si apre soltanto se hai raggiunto il livello previsto oppure possiedi un invito valido."
        }
      ],
      "choices": [
        {
          "id": "eligibility_desk",
          "text": "La finestra è valida: vado al banco.",
          "goto": "registration_desk"
        },
        {
          "id": "eligibility_rules",
          "text": "Rileggo la separazione fra Masters e Rank.",
          "goto": "entry_rules"
        }
      ]
    },
    "registration_desk": {
      "stitches": [
        {
          "id": "rd1",
          "text": "L'addetta verifica la tua tessera e indica la finestra d'iscrizione ancora aperta. Sul tabellone non compare alcun risultato: gli incontri devono ancora disputarsi."
        }
      ],
      "choices": [
        {
          "id": "register_masters",
          "text": "Confermo l'ingresso al match di seeding.",
          "conditions": {
            "all": [
              {
                "path": "world.flags.masters_entry_registration_complete",
                "ne": true
              },
              {
                "path": "world.flags.masters_entry_result",
                "exists": false
              }
            ]
          },
          "goto": "registered",
          "effects": [
            {
              "type": "set_flag",
              "key": "masters_entry_registration_complete",
              "value": true
            }
          ]
        },
        {
          "id": "registration_preview",
          "text": "Prima rivedo l'avversaria.",
          "goto": "opponent_preview"
        },
        {
          "id": "registration_defer",
          "text": "Rimando senza consumare la finestra.",
          "goto": "deferred"
        }
      ]
    },
    "registered": {
      "stitches": [
        {
          "id": "rg1",
          "text": "L'iscrizione viene registrata. Il prossimo incontro servirà a determinare la tua posizione iniziale nel circuito Masters."
        }
      ],
      "choices": [
        {
          "id": "registered_prep",
          "text": "Scelgo un focus di preparazione senza bonus invisibili.",
          "goto": "prep_focus"
        },
        {
          "id": "registered_opponent",
          "text": "Rileggo il roster pubblico.",
          "goto": "opponent_preview"
        },
        {
          "id": "registered_match",
          "text": "Passo alla conferma del match.",
          "goto": "match_confirm"
        }
      ]
    },
    "seeding_explainer": {
      "stitches": [
        {
          "id": "se1",
          "text": "Una vittoria assegna una fascia di ingresso più favorevole; una sconfitta lascia una fascia aperta più bassa. Entrambe permettono alla carriera di proseguire e nessuna cambia Rank A."
        }
      ],
      "choices": [
        {
          "id": "seeding_register",
          "text": "Accetto il sistema e mi registro.",
          "goto": "registration_desk"
        },
        {
          "id": "seeding_rules",
          "text": "Torno alle regole generali.",
          "goto": "entry_rules"
        }
      ]
    },
    "opponent_preview": {
      "stitches": [
        {
          "id": "op1",
          "text": "Mara Venn usa un Official Five fisso per il seeding: Mareanie, Mimikyu, Carvanha, Staryu e Growlithe. Il roster è pubblico; ordine e decisioni restano coperti dal fog of war."
        }
      ],
      "choices": [
        {
          "id": "opponent_prep",
          "text": "Costruisco un focus contro un roster così vario.",
          "goto": "prep_focus"
        },
        {
          "id": "opponent_register",
          "text": "Torno al banco.",
          "goto": "registration_desk"
        }
      ]
    },
    "prep_focus": {
      "stitches": [
        {
          "id": "pf1",
          "text": "Osservi il campo e scegli su cosa concentrare l'attenzione: l'apertura dell'avversario, il ritmo degli scambi o le possibilità di rimonta."
        }
      ],
      "choices": [
        {
          "id": "prep_status",
          "text": "Focus: gestire status e pressione residua.",
          "goto": "match_confirm",
          "effects": [
            {
              "type": "set_flag",
              "key": "masters_entry_prep_focus",
              "value": "status_pressure"
            }
          ]
        },
        {
          "id": "prep_switch",
          "text": "Focus: preservare opzioni di switch e coperture.",
          "goto": "match_confirm",
          "effects": [
            {
              "type": "set_flag",
              "key": "masters_entry_prep_focus",
              "value": "switch_depth"
            }
          ]
        },
        {
          "id": "prep_information",
          "text": "Focus: usare solo informazioni pubbliche e reagire al resto.",
          "goto": "match_confirm",
          "effects": [
            {
              "type": "set_flag",
              "key": "masters_entry_prep_focus",
              "value": "information"
            }
          ]
        }
      ]
    },
    "match_confirm": {
      "stitches": [
        {
          "id": "mc1",
          "text": "Il giudice conferma che si tratta di un incontro ufficiale. Quando entrerai in campo, vittoria o sconfitta saranno determinate dalla lotta."
        }
      ],
      "choices": [
        {
          "id": "match_start",
          "text": "Inizio il Masters seeding match.",
          "conditions": {
            "all": [
              {
                "path": "world.flags.masters_entry_registration_complete",
                "eq": true
              },
              {
                "path": "world.flags.masters_entry_result",
                "exists": false
              },
              {
                "path": "player.roster.length",
                "gte": 5
              }
            ]
          },
          "goto": "match_handoff"
        },
        {
          "id": "match_back",
          "text": "Non parto ancora.",
          "goto": "registered"
        }
      ]
    },
    "match_handoff": {
      "stitches": [
        {
          "id": "mh1",
          "text": "Le squadre prendono posizione. Il giudice controlla le registrazioni e dà il segnale d'inizio."
        }
      ],
      "choices": [
        {
          "id": "fight_masters_entry",
          "text": "Combatto il Masters Entry match.",
          "combat": {
            "encounterId": "A5_MASTERS_ENTRY_MATCH",
            "opponentRegistered": true,
            "competition": {
              "type": "official_match",
              "matchId": "A5_MASTERS_ENTRY_MATCH",
              "format": "Singles",
              "officialRosterSize": 5,
              "difficulty": "ELITE",
              "opponentTrainerId": "ALT_MASTERS_MARA_VENN"
            },
            "returnNodes": {
              "win": "match_win",
              "lose": "match_loss"
            },
            "opponentTrainerId": "ALT_MASTERS_MARA_VENN",
            "opponent": {
              "species": "Mareanie",
              "level": 14,
              "abilityId": "merciless",
              "trainerId": "ALT_MASTERS_MARA_VENN"
            },
            "opponentBench": [
              {
                "species": "Mimikyu",
                "level": 14,
                "abilityId": "disguise",
                "trainerId": "ALT_MASTERS_MARA_VENN"
              },
              {
                "species": "Carvanha",
                "level": 14,
                "abilityId": "rough-skin",
                "trainerId": "ALT_MASTERS_MARA_VENN"
              },
              {
                "species": "Staryu",
                "level": 14,
                "abilityId": "natural-cure",
                "trainerId": "ALT_MASTERS_MARA_VENN"
              },
              {
                "species": "Growlithe",
                "level": 14,
                "abilityId": "intimidate",
                "trainerId": "ALT_MASTERS_MARA_VENN"
              }
            ],
            "goto": "match_handoff"
          }
        }
      ]
    },
    "match_win": {
      "stitches": [
        {
          "id": "mw1",
          "text": "Il tabellone registra la vittoria. Il Rank A non cambia; il risultato ti assegna una posizione iniziale più favorevole nel circuito Masters."
        }
      ],
      "choices": [
        {
          "id": "win_seed",
          "text": "Registro il seeding derivato dalla vittoria.",
          "goto": "seeding_high",
          "effects": [
            {
              "type": "set_flag",
              "key": "masters_entry_result",
              "value": "win"
            },
            {
              "type": "set_flag",
              "key": "masters_entry_complete",
              "value": true
            }
          ]
        },
        {
          "id": "win_review",
          "text": "Rivedo prima cosa significa il risultato.",
          "goto": "result_review",
          "effects": [
            {
              "type": "set_flag",
              "key": "masters_entry_result",
              "value": "win"
            },
            {
              "type": "set_flag",
              "key": "masters_entry_complete",
              "value": true
            }
          ]
        }
      ]
    },
    "match_loss": {
      "stitches": [
        {
          "id": "ml1",
          "text": "Il tabellone registra la sconfitta. Conservi il Rank A e resti nel percorso Masters, ma partirai da una posizione meno favorevole."
        }
      ],
      "choices": [
        {
          "id": "loss_seed",
          "text": "Registro il seeding derivato dalla sconfitta.",
          "goto": "seeding_open",
          "effects": [
            {
              "type": "set_flag",
              "key": "masters_entry_result",
              "value": "loss"
            },
            {
              "type": "set_flag",
              "key": "masters_entry_complete",
              "value": true
            }
          ]
        },
        {
          "id": "loss_review",
          "text": "Rivedo il risultato senza riscriverlo.",
          "goto": "result_review",
          "effects": [
            {
              "type": "set_flag",
              "key": "masters_entry_result",
              "value": "loss"
            },
            {
              "type": "set_flag",
              "key": "masters_entry_complete",
              "value": true
            }
          ]
        }
      ]
    },
    "seeding_high": {
      "stitches": [
        {
          "id": "sh1",
          "text": "Sul tabellone il tuo nome sale nella fascia alta del prossimo sorteggio Masters. Alcuni allenatori controllano subito i possibili abbinamenti."
        }
      ],
      "choices": [
        {
          "id": "high_record",
          "text": "Registro la fascia alta.",
          "goto": "masters_close",
          "effects": [
            {
              "type": "set_flag",
              "key": "masters_seed_band",
              "value": "high_entry"
            }
          ]
        },
        {
          "id": "high_review",
          "text": "Rileggo il rapporto fra seed e Rank.",
          "goto": "result_review"
        }
      ]
    },
    "seeding_open": {
      "stitches": [
        {
          "id": "so1",
          "text": "La sconfitta assegna una fascia Masters aperta. La carriera prosegue con un percorso meno favorevole ma reale; nessun rematch automatico viene inventato."
        }
      ],
      "choices": [
        {
          "id": "open_record",
          "text": "Registro la fascia aperta.",
          "goto": "masters_close",
          "effects": [
            {
              "type": "set_flag",
              "key": "masters_seed_band",
              "value": "open_entry"
            }
          ]
        },
        {
          "id": "open_review",
          "text": "Rileggo il rapporto fra seed e Rank.",
          "goto": "result_review"
        }
      ]
    },
    "result_review": {
      "stitches": [
        {
          "id": "rv1",
          "text": "Il Masters Entry misura il punto da cui entrerai nel circuito successivo. Il futuro A→S resta dietro il suo checkpoint e non viene toccato da questo match."
        }
      ],
      "choices": [
        {
          "id": "review_win",
          "text": "Il risultato è una vittoria: applico il seed corrispondente.",
          "conditions": {
            "path": "world.flags.masters_entry_result",
            "eq": "win"
          },
          "goto": "seeding_high"
        },
        {
          "id": "review_loss",
          "text": "Il risultato è una sconfitta: applico il seed corrispondente.",
          "conditions": {
            "path": "world.flags.masters_entry_result",
            "eq": "loss"
          },
          "goto": "seeding_open"
        }
      ]
    },
    "deferred": {
      "stitches": [
        {
          "id": "df1",
          "text": "Puoi rimandare l'incontro. Il diritto d'accesso resta valido finché la finestra prevista rimane aperta."
        }
      ],
      "choices": [
        {
          "id": "defer_hub",
          "text": "Torno ad Altacima lasciando la finestra Masters disponibile.",
          "goto": "m05-altacima#town_hub",
          "effects": [
            {
              "type": "set_location",
              "locationId": "alt_town"
            }
          ]
        },
        {
          "id": "defer_outcome",
          "text": "Per ora non disputo l'incontro e torno ad Altacima.",
          "conditions": {
            "path": "world.flags.m5_module_outcome_available",
            "eq": true
          },
          "goto": "m05-module-outcome#outcome_entry"
        }
      ]
    },
    "masters_close": {
      "stitches": [
        {
          "id": "cl1",
          "text": "La tua posizione di partenza nel circuito Masters è fissata. Fuori dall'arena, però, restano la montagna, i viaggi appena aperti e le persone incontrate lungo la strada."
        }
      ],
      "choices": [
        {
          "id": "close_outcome",
          "text": "Torno ad Altacima e faccio il punto sul viaggio.",
          "goto": "module_outcome_link"
        },
        {
          "id": "close_hub",
          "text": "Torno ad Altacima prima del riepilogo.",
          "goto": "m05-altacima#town_hub",
          "effects": [
            {
              "type": "set_location",
              "locationId": "alt_town"
            }
          ]
        }
      ]
    },
    "module_outcome_link": {
      "stitches": [
        {
          "id": "mo1",
          "text": "Con i requisiti principali ormai raggiunti puoi fare il punto prima di lasciare Altacima. Se manca ancora qualcosa di indispensabile, dovrai occupartene prima della partenza."
        }
      ],
      "choices": [
        {
          "id": "outcome_enter",
          "text": "Controllo se posso proseguire il viaggio.",
          "goto": "m05-module-outcome#outcome_entry"
        }
      ]
    }
  }
}
