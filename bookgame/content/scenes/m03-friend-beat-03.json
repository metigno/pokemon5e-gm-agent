    "luke_contact": {
      "stitches": [
        {
          "id": "luke_root_text",
          "text": "Luke ti chiama con rumore di strada alle spalle. «Oh, finalmente. Dimmi che il Rank D non ti ha già fatto diventare una persona seria.»"
        }
      ],
      "choices": [
        {
          "id": "luke_meet_physical",
          "text": "Ci incontriamo di persona a Ferravia.",
          "conditions": {
            "path": "world.flags.friend_beat_03_contact_mode",
