    "luke_rescue": {
      "stitches": [
        {
          "id": "luke_rescue_text",
          "text": "Quando racconti Ferrox, Luke smette di scherzare abbastanza da seguire la sequenza: cosa avevi visto, quando sei entrato e perché a un certo punto hai continuato oppure ti sei fermato. «La parte difficile non è entrare. È capire quando la testardaggine sta ancora servendo a qualcosa.»"
        }
      ],
      "choices": [
        {
          "id": "luke_rescue_honest",
          "text": "Racconto anche quello che ancora non so su come sia finita.",
          "goto": "friend_beat_close",
          "effects": [
            {
              "type": "npc_relationship_adjust",
