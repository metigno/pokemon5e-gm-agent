    "luke_physical": {
      "stitches": [
        {
          "id": "luke_physical_text",
          "text": "Luke ti squadra appena arrivi. «Allora? Tutta questa storia di gallerie ti ha insegnato a scegliere i rischi o continui a buttarti contro tutto quello che ti guarda male?» Fa una pausa. «Non rispondere. So già che potrei fare la stessa cosa.»"
        }
      ],
      "choices": [
        {
          "id": "luke_physical_deep",
          "text": "Gli racconto una scelta recente che mi ha fatto cambiare idea.",
          "goto": "luke_personal_result",
          "effects": [
            {
              "type": "npc_relationship_adjust",
              "npcId": "Luke",
              "delta": 4
            },
            {
              "type": "set_flag",
              "key": "friend_beat_03_result",
              "value": "personal_exchange"
            }
          ]
        },
        {
          "id": "luke_physical_brief",
          "text": "Tengo l'incontro breve e concreto.",
          "goto": "friend_beat_close",
          "effects": [
            {
              "type": "npc_relationship_adjust",
              "npcId": "Luke",
              "delta": 1
