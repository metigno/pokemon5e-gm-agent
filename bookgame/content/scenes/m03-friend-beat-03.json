          "goto": "luke_competition",
          "effects": [
            {
              "type": "set_flag",
              "key": "friend_beat_03_type",
              "value": "competition_exchange"
            }
          ]
        }
      ]
    },
    "luke_physical": {
      "stitches": [
        {
          "id": "luke_physical_text",
          "text": "Luke parla soprattutto di distanza e scelta delle rotte. Non ti chiede se stai 'vincendo' M3; vuole sapere se hai iniziato a distinguere il rischio reale dal rumore del mondo. Essere nello stesso posto cambia il ritmo della conversazione: potete leggere reazioni e silenzi senza ridurre tutto a un messaggio."
        }
      ],
      "choices": [
        {
          "id": "luke_physical_deep",
          "text": "Gli racconto una scelta di M3 che mi ha fatto cambiare idea.",
          "goto": "luke_personal_result",
          "effects": [
            {
              "type": "npc_relationship_adjust",
              "npcId": "Luke",
              "delta": 4
            },
            {
              "type": "set_flag",
              "key": "friend_beat_03_result",
              "value": "personal_exchange"
            }
          ]
        },
        {
          "id": "luke_physical_brief",
          "text": "Tengo l'incontro breve e concreto.",
          "goto": "friend_beat_close",
          "effects": [
            {
              "type": "npc_relationship_adjust",
              "npcId": "Luke",
              "delta": 1
            },
            {
              "type": "set_flag",
              "key": "friend_beat_03_result",
              "value": "brief_physical"
            }
          ]
        }
      ]
    },
    "luke_remote": {
      "stitches": [
        {
          "id": "luke_remote_text",
          "text": "Luke parla soprattutto di distanza e scelta delle rotte. Non ti chiede se stai 'vincendo' M3; vuole sapere se hai iniziato a distinguere il rischio reale dal rumore del mondo. La distanza resta reale: non potete trasformare la chiamata in un incontro fisico se la schedule non lo permette."
