            {
              "type": "set_flag",
              "key": "friend_beat_03_result",
              "value": "competition_acknowledged"
            }
          ]
        }
      ]
    },
    "luke_personal_result": {
      "stitches": [
        {
          "id": "luke_personal_result_text",
          "text": "Luke ti prende in giro ancora una volta prima di salutarvi. Quando la comunicazione si chiude, la conversazione resta tra voi senza bisogno di premi o annunci."
