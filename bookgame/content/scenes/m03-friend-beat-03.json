{
  "schemaVersion": 1,
  "id": "m03-friend-beat-03",
  "moduleId": "M03",
  "title": "M3_08 — One of the Five Calls",
  "locationId": "fer_city",
  "entryNodeId": "friend_call",
  "conditions": {
    "all": [
      {
        "path": "world.flags.m2_complete",
