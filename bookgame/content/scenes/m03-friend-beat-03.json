  "nodes": {
    "friend_call": {
      "stitches": [
        {
          "id": "friend_call_1",
          "text": "Uno degli altri Five ti contatta mentre Ferravia continua a muoversi intorno a te. Il nome non viene scelto per comodità narrativa: è quello fissato dall'evento A3_FRIEND_CALL usando stato e disponibilità persistenti."
        }
      ],
      "choices": [
        {
          "id": "dispatch_luke",
          "text": "Apro il contatto con Luke.",
          "conditions": {
            "path": "world.flags.friend_beat_03_friend_id",
            "eq": "Luke"
          },
          "goto": "luke_contact"
        },
        {
          "id": "dispatch_mattew",
          "text": "Apro il contatto con Mattew.",
          "conditions": {
            "path": "world.flags.friend_beat_03_friend_id",
            "eq": "Mattew"
          },
          "goto": "mattew_contact"
        },
        {
          "id": "dispatch_daniel",
          "text": "Apro il contatto con Daniel.",
          "conditions": {
            "path": "world.flags.friend_beat_03_friend_id",
            "eq": "Daniel"
          },
          "goto": "daniel_contact"
        },
        {
          "id": "dispatch_edward",
          "text": "Apro il contatto con Edward.",
          "conditions": {
            "path": "world.flags.friend_beat_03_friend_id",
            "eq": "Edward"
          },
          "goto": "edward_contact"
        },
        {
          "id": "dispatch_fab",
          "text": "Apro il contatto con Fab.",
          "conditions": {
            "path": "world.flags.friend_beat_03_friend_id",
            "eq": "Fab"
          },
          "goto": "fab_contact"
        }
      ]
    },
    "luke_contact": {
      "stitches": [
        {
          "id": "luke_root_text",
          "text": "Luke chiama da una tratta più lunga del circuito. Il suo percorso non si è riavvolto per incontrarti: se è a Ferravia, lo è perché la schedule lo permette; altrimenti il contatto resta remoto."
        }
      ],
      "choices": [
        {
          "id": "luke_meet_physical",
          "text": "Ci incontriamo di persona a Ferravia.",
          "conditions": {
            "path": "world.flags.friend_beat_03_contact_mode",
            "eq": "physical"
          },
          "goto": "luke_physical",
          "effects": [
            {
              "type": "set_flag",
              "key": "friend_beat_03_type",
              "value": "physical_meeting"
            }
          ]
        },
        {
          "id": "luke_answer_remote",
          "text": "Rispondo e resto sul contatto remoto.",
          "conditions": {
            "path": "world.flags.friend_beat_03_contact_mode",
            "eq": "remote"
          },
          "goto": "luke_remote",
          "effects": [
            {
              "type": "set_flag",
              "key": "friend_beat_03_type",
              "value": "remote_call"
            }
          ]
        },
        {
          "id": "luke_rescue_context",
          "text": "Gli racconto cosa è successo a Ferrox.",
          "conditions": {
            "path": "world.flags.ferrox_rescue_state",
            "exists": true
          },
          "goto": "luke_rescue",
          "effects": [
            {
              "type": "set_flag",
              "key": "friend_beat_03_type",
              "value": "rescue_debrief"
            }
          ]
        },
        {
          "id": "luke_competition_context",
          "text": "Parliamo del prossimo gradino competitivo.",
          "conditions": {
            "path": "world.flags.a3_rank_trial_d_c_available",
            "eq": true
