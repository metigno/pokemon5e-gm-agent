  "nodes": {
    "friend_call": {
      "stitches": [
        {
          "id": "friend_call_1",
          "text": "Uno degli altri Five ti contatta mentre Ferravia continua a muoversi intorno a te. È quello che, tra viaggi e impegni del Circuito, riesce davvero a raggiungerti in questo momento."
        }
      ],
      "choices": [
        {
          "id": "dispatch_luke",
          "text": "Apro il contatto con Luke.",
          "conditions": {
            "path": "world.flags.friend_beat_03_friend_id",
            "eq": "Luke"
          },
          "goto": "luke_contact"
        },
        {
          "id": "dispatch_mattew",
          "text": "Apro il contatto con Mattew.",
          "conditions": {
            "path": "world.flags.friend_beat_03_friend_id",
            "eq": "Mattew"
          },
          "goto": "mattew_contact"
        },
        {
          "id": "dispatch_daniel",
          "text": "Apro il contatto con Daniel.",
          "conditions": {
            "path": "world.flags.friend_beat_03_friend_id",
            "eq": "Daniel"
          },
          "goto": "daniel_contact"
        },
        {
          "id": "dispatch_edward",
          "text": "Apro il contatto con Edward.",
          "conditions": {
            "path": "world.flags.friend_beat_03_friend_id",
            "eq": "Edward"
          },
          "goto": "edward_contact"
        },
        {
          "id": "dispatch_fab",
          "text": "Apro il contatto con Fab.",
          "conditions": {
            "path": "world.flags.friend_beat_03_friend_id",
            "eq": "Fab"
          },
          "goto": "fab_contact"
        }
      ]
    },
    "luke_contact": {
      "stitches": [
        {
          "id": "luke_root_text",
          "text": "Luke chiama da una tratta più lunga del circuito. Dietro di lui si sente il vento e un Growlithe che reclama attenzione. «Hai visto? C'è gente che ti vende un itinerario come se fosse l'unico modo di vincere. Io mi tengo il mio.»"
        }
      ],
      "choices": [
        {
          "id": "luke_meet_physical",
          "text": "Ci incontriamo di persona a Ferravia.",
          "conditions": {
            "path": "world.flags.friend_beat_03_contact_mode",
            "eq": "physical"
          },
          "goto": "luke_physical",
          "effects": [
            {
              "type": "set_flag",
              "key": "friend_beat_03_type",
              "value": "physical_meeting"
            }
          ]
        },
        {
          "id": "luke_answer_remote",
          "text": "Rispondo e resto sul contatto remoto.",
          "conditions": {
            "path": "world.flags.friend_beat_03_contact_mode",
            "eq": "remote"
          },
          "goto": "luke_remote",
          "effects": [
            {
              "type": "set_flag",
              "key": "friend_beat_03_type",
              "value": "remote_call"
            }
          ]
        },
        {
          "id": "luke_rescue_context",
          "text": "Gli racconto cosa è successo a Ferrox.",
          "conditions": {
            "path": "world.flags.ferrox_rescue_state",
            "exists": true
          },
          "goto": "luke_rescue",
          "effects": [
            {
              "type": "set_flag",
              "key": "friend_beat_03_type",
              "value": "rescue_debrief"
            }
          ]
        },
        {
          "id": "luke_competition_context",
          "text": "Parliamo del prossimo gradino competitivo.",
          "conditions": {
            "path": "world.flags.a3_rank_trial_d_c_available",
            "eq": true
          },
          "goto": "luke_competition",
          "effects": [
            {
              "type": "set_flag",
              "key": "friend_beat_03_type",
              "value": "competition_exchange"
            }
          ]
        }
      ]
    },
    "luke_physical": {
      "stitches": [
        {
          "id": "luke_physical_text",
          "text": "Luke guarda per un momento la strada alle tue spalle. «Allora? Hai capito quali rischi sono veri o stai ancora litigando con ogni cartello che incontri?» Il tono è quello di sempre: provocatorio abbastanza da farti capire che la domanda gli interessa davvero."
        }
      ],
      "choices": [
        {
          "id": "luke_physical_deep",
          "text": "Gli racconto una scelta recente che mi ha fatto cambiare idea.",
          "goto": "luke_personal_result",
          "effects": [
            {
              "type": "npc_relationship_adjust",
              "npcId": "Luke",
              "delta": 4
            },
            {
              "type": "set_flag",
              "key": "friend_beat_03_result",
              "value": "personal_exchange"
            }
          ]
        },
        {
          "id": "luke_physical_brief",
          "text": "Tengo l'incontro breve e concreto.",
          "goto": "friend_beat_close",
          "effects": [
            {
              "type": "npc_relationship_adjust",
              "npcId": "Luke",
              "delta": 1
            },
            {
              "type": "set_flag",
              "key": "friend_beat_03_result",
              "value": "brief_physical"
            }
          ]
        }
      ]
    },
    "luke_remote": {
      "stitches": [
        {
          "id": "luke_remote_text",
          "text": "La voce di Luke arriva tra rumore di strada e una protesta rivolta a qualcuno fuori campo. «Dimmi solo che hai imparato a distinguere un rischio vero da uno che fa scena.» Poi aggiunge, quasi subito: «E no, non vale rispondere 'li affronto tutti'. Quella è la mia risposta.»"
        }
      ],
      "choices": [
        {
          "id": "luke_remote_engage",
          "text": "Resto sulla chiamata e approfondisco.",
          "timeCostMinutes": 15,
          "goto": "luke_personal_result",
          "effects": [
            {
              "type": "npc_relationship_adjust",
              "npcId": "Luke",
              "delta": 3
            },
            {
              "type": "set_flag",
              "key": "friend_beat_03_result",
              "value": "remote_exchange"
            }
          ]
        },
        {
          "id": "luke_remote_brief",
          "text": "Rispondo in modo breve e ci aggiorniamo più avanti.",
          "goto": "friend_beat_close",
          "effects": [
            {
              "type": "npc_relationship_adjust",
              "npcId": "Luke",
              "delta": 1
            },
            {
              "type": "set_flag",
              "key": "friend_beat_03_result",
              "value": "remote_brief"
            }
          ]
        }
      ]
    },
    "luke_rescue": {
      "stitches": [
        {
          "id": "luke_rescue_text",
          "text": "Quando racconti Ferrox, Luke torna sulla sequenza: cosa sapevi prima, quando hai deciso di entrare, quando hai smesso. Per lui il punto è se il percorso ha cambiato la tua lettura del rischio."
        }
      ],
      "choices": [
        {
          "id": "luke_rescue_honest",
          "text": "Descrivo anche ciò che non so ancora dell'outcome.",
          "goto": "friend_beat_close",
          "effects": [
            {
              "type": "npc_relationship_adjust",
              "npcId": "Luke",
              "delta": 4
            },
            {
              "type": "set_flag",
              "key": "friend_beat_03_result",
              "value": "rescue_honest_debrief"
            },
            {
              "type": "npc_state_set",
              "npcId": "Luke",
              "key": "knowsFerroxRescueContext",
              "value": true
            }
          ]
        },
        {
          "id": "luke_rescue_focus",
          "text": "Mi concentro soltanto sulla decisione che ho preso.",
          "goto": "friend_beat_close",
          "effects": [
            {
              "type": "npc_relationship_adjust",
              "npcId": "Luke",
              "delta": 2
            },
            {
              "type": "set_flag",
              "key": "friend_beat_03_result",
              "value": "rescue_choice_discussed"
            }
          ]
        }
      ]
    },
    "luke_competition": {
      "stitches": [
        {
          "id": "luke_competition_text",
          "text": "Sul circuito è pragmatico: salire di Rank apre strade, ma non rende automaticamente migliore ogni decisione fatta per arrivarci."
        }
      ],
      "choices": [
        {
          "id": "luke_competition_compare",
          "text": "Confrontiamo come stiamo preparando il prossimo step.",
          "timeCostMinutes": 10,
          "goto": "friend_beat_close",
