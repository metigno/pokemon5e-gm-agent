        },
        {
          "id": "luke_remote_brief",
          "text": "Rispondo in modo breve e ci aggiorniamo più avanti.",
          "goto": "friend_beat_close",
          "effects": [
            {
              "type": "npc_relationship_adjust",
              "npcId": "Luke",
              "delta": 1
