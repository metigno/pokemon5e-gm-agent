{
  "schemaVersion": 1,
  "id": "m08-medical-control",
  "moduleId": "M08",
  "title": "M8_02 — Medical Control",
  "locationId": "world_medical_center",
  "entryNodeId": "medical_entry",
  "conditions": {
    "all": [
      {
        "path": "world.flags.m7_complete",
        "eq": true
      },
      {
        "path": "world.flags.m08_unlocked",
        "eq": true
      },
      {
        "path": "world.flags.world_qualified",
        "eq": true
      },
      {
        "path": "world.flags.m7_before_lights_complete",
        "eq": true
      },
      {
        "path": "world.flags.m8_active",
        "eq": true
      },
      {
        "path": "world.flags.m8_world_arrived",
        "eq": true
      },
      {
        "path": "world.flags.m8_accreditation_complete",
        "eq": true
      }
    ]
  },
  "nodes": {
    "medical_entry": {
      "stitches": [
        {
          "id": "s1",
          "text": "Nella clinica del Village un'infermiera ti accoglie davanti a una fila di box per i Pokémon. «Vediamo come è arrivata la squadra», dice aprendo la scheda."
        }
      ],
      "choices": [
        {
          "id": "entry_exam",
          "text": "Inizio il controllo.",
          "goto": "medical_hub",
          "conditions": {
            "path": "world.flags.m8_medical_control_complete",
            "ne": true
          }
        },
        {
          "id": "entry_review",
          "text": "Il controllo è già registrato: rivedo il referto organizzativo.",
          "goto": "medical_hub",
          "conditions": {
            "path": "world.flags.m8_medical_control_complete",
            "eq": true
          }
        },
        {
          "id": "entry_roster",
          "text": "Controllo subito quale roster viene letto.",
          "goto": "roster_status"
        }
      ]
    },
    "medical_hub": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il medico osserva i compagni presenti, le loro condizioni e gli intervalli di recupero disponibili prima delle gare."
        }
      ],
      "choices": [
        {
          "id": "hub_roster",
          "text": "Verifico il roster presente.",
          "goto": "roster_status"
        },
        {
          "id": "hub_health",
          "text": "Rivedo HP, condizioni e infortuni come stato persistente.",
          "goto": "hp_status"
        },
        {
          "id": "hub_schedule",
          "text": "Controllo il costo temporale del controllo.",
          "goto": "schedule_cost"
        }
      ]
    },
    "roster_status": {
      "stitches": [
        {
          "id": "s1",
          "text": "Conti insieme al personale i Pokémon effettivamente con te. La visita non può procurarti un compagno in più."
        }
      ],
      "choices": [
        {
          "id": "roster_six",
          "text": "Con almeno sei Pokémon posso proseguire verso la registrazione dopo il controllo.",
          "goto": "clearance",
          "conditions": {
            "path": "player.roster.length",
            "gte": 6
          }
        },
        {
          "id": "roster_short",
          "text": "Con meno di sei Pokémon registro soltanto che la squadra è incompleta.",
          "goto": "recovery_info",
          "conditions": {
            "path": "player.roster.length",
            "lt": 6
          }
        },
        {
          "id": "roster_hub",
          "text": "Torno al desk medico.",
          "goto": "medical_hub"
        }
      ]
    },
    "hp_status": {
      "stitches": [
        {
          "id": "s1",
          "text": "L'infermiera valuta quanto i Pokémon siano provati e quanti sforzi possano ancora sostenere. Un controllo non restituisce automaticamente energie."
        }
      ],
      "choices": [
        {
          "id": "hp_conditions",
          "text": "Rivedo condizioni e status.",
          "goto": "conditions_status"
        },
        {
          "id": "hp_injuries",
          "text": "Rivedo gli infortuni persistenti.",
          "goto": "injury_status"
        }
      ]
    },
    "conditions_status": {
      "stitches": [
        {
          "id": "s1",
          "text": "Se un Pokémon presenta una condizione che richiede attenzione, il personale la annota senza fingere che scompaia sul posto."
        }
      ],
      "choices": [
        {
          "id": "conditions_recovery",
          "text": "Passo alle opzioni di recupero reale.",
          "goto": "recovery_info"
        },
        {
          "id": "conditions_health",
          "text": "Torno allo stato salute.",
          "goto": "hp_status"
        }
      ]
    },
    "injury_status": {
      "stitches": [
        {
          "id": "s1",
          "text": "Le ferite precedenti restano da trattare con procedure appropriate. La visita serve a conoscerle, non a dichiararle inesistenti."
        }
      ],
      "choices": [
        {
          "id": "injury_recovery",
          "text": "Valuto il piano di recupero.",
          "goto": "recovery_info"
        },
        {
          "id": "injury_health",
          "text": "Torno allo stato salute.",
          "goto": "hp_status"
        }
      ]
    },
    "recovery_info": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il medico propone riposo o cure realmente disponibili e ne indica tempi e costi. La decisione deve tenere conto del calendario."
        }
      ],
      "choices": [
        {
          "id": "recovery_schedule",
          "text": "Controllo il tempo disponibile.",
          "goto": "schedule_cost"
        },
        {
          "id": "recovery_audit",
          "text": "Passo all'audit del controllo.",
          "goto": "audit"
        }
      ]
    },
    "schedule_cost": {
      "stitches": [
        {
          "id": "s1",
          "text": "Mentre aspetti il proprio turno, il tempo passa. Altri atleti lasciano la clinica diretti ai loro appuntamenti."
        }
      ],
      "choices": [
        {
          "id": "schedule_exam",
          "text": "Completo trenta minuti di valutazione.",
          "goto": "audit",
          "timeCostMinutes": 30,
          "effects": [
            {
              "type": "set_flag",
              "key": "m8_medical_exam_time_spent",
              "value": true
            }
          ]
        },
        {
          "id": "schedule_hub",
          "text": "Rimando l'esame e torno al desk.",
          "goto": "medical_hub"
        }
      ]
    },
    "clearance": {
      "stitches": [
        {
          "id": "s1",
          "text": "«Avere sei Pokémon non significa che siano tutti riposati», avverte il medico. «Dovrete considerarne le condizioni quando arriverà la gara.»"
        }
      ],
      "choices": [
        {
          "id": "clearance_audit",
          "text": "Passo all'audit senza modificare salute.",
          "goto": "audit"
        },
        {
          "id": "clearance_roster",
          "text": "Torno al roster.",
          "goto": "roster_status"
        }
      ]
    },
    "medical_callback": {
      "stitches": [
        {
          "id": "s1",
          "text": "Se hai già disputato incontri duri, puoi raccontarlo al medico. La reputazione sportiva non sostituisce un esame."
        }
      ],
      "choices": [
        {
          "id": "callback_audit",
          "text": "Torno all'audit.",
          "goto": "audit"
        },
        {
          "id": "callback_hub",
          "text": "Torno al desk medico.",
          "goto": "medical_hub"
        }
      ]
    },
    "defer": {
      "stitches": [
        {
          "id": "s1",
          "text": "Interrompi la procedura senza dichiararla conclusa. La registrazione alle gare dovrà attendere il controllo richiesto."
        }
      ],
      "choices": [
        {
          "id": "defer_hour",
          "text": "Aspetto un'ora prima di riprendere.",
          "goto": "medical_hub",
          "timeCostMinutes": 60
        },
        {
          "id": "defer_audit",
          "text": "Riprendo dall'audit.",
          "goto": "audit"
        }
      ]
    },
    "audit": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il medico ricontrolla le annotazioni: numero di Pokémon, eventuali ferite, indicazioni di recupero e prossimi appuntamenti."
        }
      ],
      "choices": [
        {
          "id": "audit_callback",
          "text": "Controllo come il contesto precedente modifica la lettura.",
          "goto": "medical_callback"
        },
        {
          "id": "audit_commit",
          "text": "Chiudo il controllo medico.",
          "goto": "commit"
        }
      ]
    },
    "commit": {
      "stitches": [
        {
          "id": "s1",
          "text": "La visita termina con la firma del personale sanitario. Non equivale a un trattamento eseguito."
        }
      ],
      "choices": [
        {
          "id": "commit_now",
          "text": "Registro il controllo medico come completato.",
          "goto": "complete",
          "effects": [
            {
              "type": "set_flag",
              "key": "m8_medical_control_complete",
              "value": true
            },
            {
              "type": "set_location",
              "locationId": "world_medical_center"
            }
          ]
        },
        {
          "id": "commit_defer",
          "text": "Non chiudo ancora il controllo.",
          "goto": "defer"
        }
      ]
    },
    "complete": {
      "stitches": [
        {
          "id": "s1",
          "text": "Con il controllo medico completato puoi presentarti al banco iscrizioni del Mondiale."
        }
      ],
      "choices": [
        {
          "id": "complete_registration",
          "text": "Passo alla registrazione.",
          "goto": "m08-registration#registration_entry"
        },
        {
          "id": "complete_review",
          "text": "Rivedo il referto organizzativo.",
          "goto": "medical_hub"
        }
      ]
    }
  }
}
