  "nodes": {
    "dispatch": {
      "stitches": [
        {
          "id": "roads_split",
          "text": "Le prime giornate insieme non si trasformano in una squadra fissa. Messaggi, turni, allenamenti e partenze mostrano che i Five hanno iniziato a costruire calendari diversi."
        },
        {
          "id": "offscreen_is_real",
          "text": "Leggi gli ultimi aggiornamenti sul telefono: uno è già partito, un altro ha trovato lavoro, un altro pensa alla prossima prova. Nessuno resta fermo per aspettarti."
        }
      ],
      "choices": [
        {
          "id": "focus_luke",
          "text": "Leggo l'aggiornamento su Luke.",
          "conditions": {
            "path": "world.flags.m1_five_roads_focus_friend_id",
            "eq": "Luke"
          },
          "goto": "luke"
        },
        {
          "id": "focus_mattew",
          "text": "Leggo l'aggiornamento su Mattew.",
          "conditions": {
            "path": "world.flags.m1_five_roads_focus_friend_id",
            "eq": "Mattew"
          },
          "goto": "mattew"
        },
        {
          "id": "focus_daniel",
          "text": "Leggo l'aggiornamento su Daniel.",
          "conditions": {
            "path": "world.flags.m1_five_roads_focus_friend_id",
            "eq": "Daniel"
          },
          "goto": "daniel"
        },
        {
          "id": "focus_edward",
          "text": "Leggo l'aggiornamento su Edward.",
          "conditions": {
            "path": "world.flags.m1_five_roads_focus_friend_id",
            "eq": "Edward"
          },
          "goto": "edward"
        },
        {
          "id": "focus_fab",
          "text": "Leggo l'aggiornamento su Fab.",
          "conditions": {
            "path": "world.flags.m1_five_roads_focus_friend_id",
            "eq": "Fab"
          },
          "goto": "fab"
        }
      ]
    },
    "luke": {
      "stitches": [
        {
          "id": "luke_diverges",
          "text": "Luke non resta nel circuito corto tra Ginestre e Valedarsena. Ha scelto tappe più lunghe verso est, con Growlithe già impaziente di muoversi."
        },
        {
          "id": "luke_persistence",
          "text": "«Non aspettatemi per fare le cose facili», scrive. «E non vendete i vostri Pokémon preferiti per qualche consiglio idiota.»"
        },
        {
          "id": "luke_others_move",
          "text": "Anche gli altri amici hanno aggiornato il proprio programma. Il loro viaggio non si ferma dove finisce il tuo."
        }
      ],
      "choices": [
        {
          "id": "acknowledge",
          "text": "Segno l'aggiornamento e torno al mio percorso.",
          "goto": "m01-valedarsena-first-arrival#city_hub",
          "effects": [
            {
              "type": "set_flag",
              "key": "m1_five_roads_seen",
              "value": true
            },
            {
              "type": "set_location",
              "locationId": "valedarsena_city"
            }
          ]
        },
        {
          "id": "keep_moving",
          "text": "Non inseguo nessuno: continuo per conto mio.",
          "goto": "m01-valedarsena-first-arrival#city_hub",
