{
  "schemaVersion": 1,
  "moduleId": "M01",
  "id": "m01-five-roads",
  "title": "Cinque strade",
  "locationId": "valedarsena_city",
  "entryNodeId": "dispatch",
  "conditions": {
    "path": "events.A1_FIVE_ROADS.status",
    "eq": "resolved"
