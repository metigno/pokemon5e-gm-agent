{
  "schemaVersion": 1,
  "id": "m10-qf-aftermath",
  "moduleId": "M10",
  "title": "M10_08 — QF Aftermath",
  "locationId": "world_knockout_hall",
  "entryNodeId": "aftermath_entry",
  "conditions": {
    "all": [
      {
        "path": "world.flags.m10_world_qf_complete",
        "eq": true
      },
      {
        "path": "world.flags.world_qf_resolved",
        "eq": true
      },
      {
        "path": "competition.world.top8Locked",
        "eq": true
      }
    ]
  },
  "nodes": {
    "aftermath_entry": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il tuo quarto è terminato. Negli altri tre incontri si decide chi completerà il gruppo dei semifinalisti."
        }
      ],
      "choices": [
        {
          "id": "entry_resolve",
          "text": "Risolvo strutturalmente il round.",
          "goto": "resolve_guard"
        },
        {
          "id": "entry_history",
          "text": "Audito il mio record.",
          "goto": "history_audit"
        },
        {
          "id": "entry_world",
          "text": "Controllo cosa deve contenere il Top4.",
          "goto": "top4_rules"
        }
      ]
    },
    "resolve_guard": {
      "stitches": [
        {
          "id": "s1",
          "text": "La commissione raccoglie i referti dei quarti senza riaprire quello del tuo campo."
        }
      ],
      "choices": [
        {
          "id": "resolve_now",
          "text": "Risolvo gli altri QF e locko il Top4.",
          "goto": "round_resolved",
          "conditions": {
            "path": "competition.world.knockout.qfResolved",
            "ne": true
          },
          "effects": [
            {
              "type": "competition_world_qf_resolve",
              "eventId": "WORLD_QF_RESOLVE"
            }
          ]
        },
        {
          "id": "resolve_existing",
          "text": "Il QF round è già chiuso: leggo il Top4 persistente.",
          "goto": "round_resolved",
          "conditions": {
            "path": "competition.world.knockout.qfResolved",
            "eq": true
          }
        },
        {
          "id": "resolve_audit",
          "text": "Prima rivedo l'integrità.",
          "goto": "history_audit"
        }
      ]
    },
    "history_audit": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il tuo incontro è registrato sotto i vostri due nomi. Gli altri tre avranno vincitori e sconfitti propri."
        }
      ],
      "choices": [
        {
          "id": "history_rules",
          "text": "Controllo la regola Top4.",
          "goto": "top4_rules"
        },
        {
          "id": "history_resolve",
          "text": "Torno al resolve guard.",
          "goto": "resolve_guard"
        }
      ]
    },
    "top4_rules": {
      "stitches": [
        {
          "id": "s1",
          "text": "Soltanto i quattro vincitori raggiungono le semifinali. Se hai perso, il tuo avversario prende il posto che hai mancato."
        }
      ],
      "choices": [
        {
          "id": "top4_friend",
          "text": "Controllo gli amici.",
          "goto": "friend_visibility"
        },
        {
          "id": "top4_anchor",
          "text": "Controllo gli Anchor.",
          "goto": "anchor_visibility"
        }
      ]
    },
    "round_resolved": {
      "stitches": [
        {
          "id": "s1",
          "text": "Sul tabellone rimangono quattro nomi e due incontri. Le semifinali cominciano a diventare concrete."
        }
      ],
      "choices": [
        {
          "id": "resolved_top4",
          "text": "Apro il riepilogo Top4.",
          "goto": "top4_summary"
        },
        {
          "id": "resolved_outcome",
          "text": "Leggo il significato del mio risultato.",
          "goto": "player_outcome"
        }
      ]
    },
    "player_outcome": {
      "stitches": [
        {
          "id": "s1",
          "text": "Se hai vinto puoi prepararti per il Final Four. Se hai perso, il titolo mondiale non è più una possibilità in questa edizione."
        }
      ],
      "choices": [
        {
          "id": "outcome_sf",
          "text": "Controllo il pairing SF se sono ancora dentro.",
          "goto": "sf_preview"
        },
        {
          "id": "outcome_friend",
          "text": "Controllo chi è sopravvissuto.",
          "goto": "friend_visibility"
        }
      ]
    },
    "top4_summary": {
      "stitches": [
        {
          "id": "s1",
          "text": "La bacheca del Final Four contiene quattro semifinalisti ufficiali. I risultati non cambiano a ogni nuova consultazione."
        }
      ],
      "choices": [
        {
          "id": "summary_sf",
          "text": "Vedo il pairing SF del player.",
          "goto": "sf_preview"
        },
        {
          "id": "summary_anchor",
          "text": "Controllo gli Anchor senza plot armor.",
          "goto": "anchor_visibility"
        },
        {
          "id": "summary_commit",
          "text": "Porto il round verso la chiusura.",
          "goto": "commit"
        }
      ]
    },
    "sf_preview": {
      "stitches": [
        {
          "id": "s1",
          "text": "Se sei fra i quattro puoi leggere il tuo prossimo avversario. Altrimenti le semifinali riguardano gli allenatori rimasti."
        }
      ],
      "choices": [
        {
          "id": "sf_pressure",
          "text": "Ragiono sulla pressione del Final Four.",
          "goto": "future_pressure"
        },
        {
          "id": "sf_commit",
          "text": "Torno alla chiusura.",
          "goto": "commit"
        }
      ]
    },
    "friend_visibility": {
      "stitches": [
        {
          "id": "s1",
          "text": "Un amico può ancora essere fra i quattro oppure essere stato eliminato. La vostra storia comune non vale come passaggio del turno."
        }
      ],
      "choices": [
        {
          "id": "friend_anchor",
          "text": "Confronto la stessa regola con gli Anchor.",
          "goto": "anchor_visibility"
        },
        {
          "id": "friend_commit",
          "text": "Porto lo stato al commit.",
          "goto": "commit"
        }
      ]
    },
    "anchor_visibility": {
      "stitches": [
        {
          "id": "s1",
          "text": "Silas e gli altri nomi famosi non hanno corsie preferenziali. Soltanto chi ha vinto il quarto raggiunge questa fase."
        }
      ],
      "choices": [
        {
          "id": "anchor_top4",
          "text": "Torno al riepilogo.",
          "goto": "top4_summary"
        },
        {
          "id": "anchor_commit",
          "text": "Passo alla chiusura.",
          "goto": "commit"
        }
      ]
    },
    "future_pressure": {
      "stitches": [
        {
          "id": "s1",
          "text": "La finale è ancora lontana di una partita. I semifinalisti dovranno affrontare un'altra sfida con la squadra che hanno davvero preparato."
        }
      ],
      "choices": [
        {
          "id": "pressure_resources",
          "text": "Controllo cosa il team porta avanti.",
          "goto": "resource_persistence"
        },
        {
          "id": "pressure_commit",
          "text": "Chiudo l'aftermath.",
          "goto": "commit"
        }
      ]
    },
    "resource_persistence": {
      "stitches": [
        {
          "id": "s1",
          "text": "I Pokémon conservano le condizioni in cui sono usciti dal quarto. Non ricevono cure solo perché altrove si disputa un'altra gara."
        }
      ],
      "choices": [
        {
          "id": "resources_top4",
          "text": "Torno al Top4.",
          "goto": "top4_summary"
        },
        {
          "id": "resources_commit",
          "text": "Procedo alla chiusura.",
          "goto": "commit"
        }
      ]
    },
    "commit": {
      "stitches": [
        {
          "id": "s1",
          "text": "La commissione firma il programma delle semifinali e lo espone al pubblico."
        }
      ],
      "choices": [
        {
          "id": "commit_now",
          "text": "Chiudo M10_08.",
          "goto": "complete",
          "effects": [
            {
              "type": "set_flag",
              "key": "m10_qf_aftermath_complete",
              "value": true
            }
          ]
        },
        {
          "id": "commit_review",
          "text": "Rivedo il Top4.",
          "goto": "top4_summary"
        }
      ]
    },
    "complete": {
      "stitches": [
        {
          "id": "s1",
          "text": "I quarti sono finiti. Il prossimo passo sarà prendere atto della tua posizione e, se sei passato, preparare il Final Four."
        }
      ],
      "choices": [
        {
          "id": "complete_outcome",
          "text": "Passo al Module Outcome.",
          "goto": "handoff"
        },
        {
          "id": "complete_summary",
          "text": "Rileggo il Top4.",
          "goto": "top4_summary"
        }
      ]
    },
    "handoff": {
      "stitches": [
        {
          "id": "s1",
          "text": "Lasci l'area referti. La strada verso le semifinali esiste solo per chi ha vinto il proprio incontro."
        }
      ],
      "choices": [
        {
          "id": "handoff_outcome",
          "text": "Apro il Module Outcome.",
          "goto": "m10-module-outcome#outcome_entry"
        },
        {
          "id": "handoff_player",
          "text": "Rileggo la conseguenza del mio QF.",
          "goto": "player_outcome"
        }
      ]
    }
  }
}
