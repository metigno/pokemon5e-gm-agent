{
  "schemaVersion": 1,
  "id": "m08-media-day",
  "moduleId": "M08",
  "title": "M8_08 — Media Day",
  "locationId": "world_media_center",
  "entryNodeId": "media_entry",
  "conditions": {
    "all": [
      {
        "path": "world.flags.m7_complete",
        "eq": true
      },
      {
        "path": "world.flags.m08_unlocked",
        "eq": true
      },
      {
        "path": "world.flags.world_qualified",
        "eq": true
      },
      {
        "path": "world.flags.m8_active",
        "eq": true
      },
      {
        "path": "world.flags.m8_world_registration_complete",
        "eq": true
      },
      {
        "path": "world.flags.m8_world_village_arrived",
        "eq": true
      },
      {
        "path": "world.flags.m8_training_hall_complete",
        "eq": true
      }
    ]
  },
  "nodes": {
    "media_entry": {
      "stitches": [
        {
          "id": "s1",
          "text": "Nella sala stampa del Mondiale una fila di telecamere punta verso il banco degli atleti. Gli addetti ti indicano dove sederti."
        }
      ],
      "choices": [
        {
          "id": "entry_hub",
          "text": "Entro nel Media Day.",
          "goto": "media_hub"
        },
        {
          "id": "entry_brief",
          "text": "Controllo prima il formato delle interviste.",
          "goto": "briefing"
        },
        {
          "id": "entry_callbacks",
          "text": "Rivedo come sponsor e reputazione precedente pesano sul contesto.",
          "goto": "callbacks"
        }
      ]
    },
    "media_hub": {
      "stitches": [
        {
          "id": "s1",
          "text": "Puoi scegliere quanto parlare, con quale tono e per quanto tempo. Le domande sono pubbliche; le risposte appartengono a te."
        }
      ],
      "choices": [
        {
          "id": "hub_interview",
          "text": "Scelgo come affrontare l'intervista principale.",
          "goto": "interview_choice"
        },
        {
          "id": "hub_callbacks",
          "text": "Controllo i callback precedenti.",
          "goto": "callbacks"
        },
        {
          "id": "hub_wait",
          "text": "Rimando una finestra e lascio passare tempo.",
          "goto": "wait_window"
        }
      ]
    },
    "briefing": {
      "stitches": [
        {
          "id": "s1",
          "text": "Un giornalista chiede del percorso di qualificazione e delle tue aspettative. Non può ancora farti domande su un gruppo che non è stato sorteggiato."
        }
      ],
      "choices": [
        {
          "id": "brief_interview",
          "text": "Passo all'intervista.",
          "goto": "interview_choice"
        },
        {
          "id": "brief_guard",
          "text": "Controllo il guardrail reputazione/risultato.",
          "goto": "reputation_guard"
        }
      ]
    },
    "interview_choice": {
      "stitches": [
        {
          "id": "s1",
          "text": "Davanti ai microfoni puoi essere aperto, prudente oppure dichiaratamente competitivo. Nessuna scelta ti impone un sentimento che non hai espresso."
        }
      ],
      "choices": [
        {
          "id": "interview_open",
          "text": "Rispondo in modo aperto.",
          "goto": "open_style"
        },
        {
          "id": "interview_guarded",
          "text": "Mantengo un profilo prudente.",
          "goto": "guarded_style"
        },
        {
          "id": "interview_competitive",
          "text": "Accetto il tono competitivo senza promettere risultati.",
          "goto": "competitive_style"
        }
      ]
    },
    "open_style": {
      "stitches": [
        {
          "id": "s1",
          "text": "Rispondi con chiarezza sui tuoi obiettivi e sulla preparazione, limitandoti alle informazioni che possiedi davvero."
        }
      ],
      "choices": [
        {
          "id": "open_record",
          "text": "Registro lo stile pubblico aperto.",
          "goto": "reputation_guard",
          "effects": [
            {
              "type": "set_flag",
              "key": "m8_media_style",
              "value": "open"
            }
          ]
        },
        {
          "id": "open_astrid",
          "text": "Rispondo a una domanda sulla campionessa in carica.",
          "goto": "astrid_question"
        }
      ]
    },
    "guarded_style": {
      "stitches": [
        {
          "id": "s1",
          "text": "Scegli poche parole e mantieni riservati i dettagli che non vuoi condividere. Il giornalista insiste, ma puoi chiudere la risposta."
        }
      ],
      "choices": [
        {
          "id": "guarded_record",
          "text": "Registro lo stile pubblico prudente.",
          "goto": "reputation_guard",
          "effects": [
            {
              "type": "set_flag",
              "key": "m8_media_style",
              "value": "guarded"
            }
          ]
        },
        {
          "id": "guarded_friend",
          "text": "Rispondo a una domanda sugli amici.",
          "goto": "friend_question"
        }
      ]
    },
    "competitive_style": {
      "stitches": [
        {
          "id": "s1",
          "text": "Accetti una provocazione sulla forza dei rivali. Puoi mostrare fiducia senza dichiarare già vinta una partita che non è cominciata."
        }
      ],
      "choices": [
        {
          "id": "competitive_record",
          "text": "Registro lo stile competitivo.",
          "goto": "reputation_guard",
          "effects": [
            {
              "type": "set_flag",
              "key": "m8_media_style",
              "value": "competitive"
            }
          ]
        },
        {
          "id": "competitive_sponsor",
          "text": "Gestisco una domanda sugli sponsor.",
          "goto": "sponsor_question"
        }
      ]
    },
    "callbacks": {
      "stitches": [
        {
          "id": "s1",
          "text": "Qualcuno ricorda un'intervista o un risultato precedente. Il modo in cui rispondi può influenzare l'attenzione dei presenti."
        }
      ],
      "choices": [
        {
          "id": "callbacks_interview",
          "text": "Porto il contesto nell'intervista.",
          "goto": "interview_choice"
        },
        {
          "id": "callbacks_guard",
          "text": "Rivedo il guardrail reputazione/risultato.",
          "goto": "reputation_guard"
        }
      ]
    },
    "astrid_question": {
      "stitches": [
        {
          "id": "s1",
          "text": "«Come giudica Astrid Vahl, la campionessa in carica?» Puoi riconoscerne il valore senza fingere che sia già la tua avversaria."
        }
      ],
      "choices": [
        {
          "id": "astrid_guard",
          "text": "Registro una risposta rispettosa del field reale.",
          "goto": "reputation_guard",
          "effects": [
            {
              "type": "set_flag",
              "key": "m8_media_astrid_answered",
              "value": true
            }
          ]
        },
        {
          "id": "astrid_hub",
          "text": "Torno al Media Day.",
          "goto": "media_hub"
        }
      ]
    },
    "friend_question": {
      "stitches": [
        {
          "id": "s1",
          "text": "«Qualcuno dei suoi vecchi amici sarà al Mondiale?» Puoi parlare dei rapporti che conoscete, senza assegnare a nessuno qualificazioni inventate."
        }
      ],
      "choices": [
        {
          "id": "friend_guard",
          "text": "Mantengo separate le nostre traiettorie.",
          "goto": "reputation_guard",
          "effects": [
            {
              "type": "set_flag",
              "key": "m8_media_friend_answered",
              "value": true
            }
          ]
        },
        {
          "id": "friend_hub",
          "text": "Torno al Media Day.",
          "goto": "media_hub"
        }
      ]
    },
    "sponsor_question": {
      "stitches": [
        {
          "id": "s1",
          "text": "Un giornalista nota il nome dello sponsor, se ne hai uno. Gli impegni contrattuali non garantiscono favori nelle gare."
        }
      ],
      "choices": [
        {
          "id": "sponsor_guard",
          "text": "Mantengo separati sponsor e competizione.",
          "goto": "reputation_guard",
          "effects": [
            {
              "type": "set_flag",
              "key": "m8_media_sponsor_answered",
              "value": true
            }
          ]
        },
        {
          "id": "sponsor_hub",
          "text": "Torno al Media Day.",
          "goto": "media_hub"
        }
      ]
    },
    "wait_window": {
      "stitches": [
        {
          "id": "s1",
          "text": "Rimani un'ora fra interviste e attese. Il personale accompagna nuovi atleti mentre gli altri tornano ad allenarsi."
        }
      ],
      "choices": [
        {
          "id": "wait_hour",
          "text": "Aspetto un'ora e torno al Media Day.",
          "goto": "media_hub",
          "timeCostMinutes": 60
        },
        {
          "id": "wait_commit",
          "text": "Chiudo la finestra senza altra attesa.",
          "goto": "media_commit"
        }
      ]
    },
    "reputation_guard": {
      "stitches": [
        {
          "id": "s1",
          "text": "La stampa potrà ricordare ciò che dici. Non è però il suo compito decidere la tua squadra o il risultato delle partite."
        }
      ],
      "choices": [
        {
          "id": "guard_commit",
          "text": "Passo alla chiusura del Media Day.",
          "goto": "media_commit"
        },
        {
          "id": "guard_hub",
          "text": "Torno alle opzioni di intervista.",
          "goto": "media_hub"
        }
      ]
    },
    "media_commit": {
      "stitches": [
        {
          "id": "s1",
          "text": "L'addetto chiude la sessione e registra che hai partecipato. Le tue risposte restano quelle date davanti ai microfoni."
        }
      ],
      "choices": [
        {
          "id": "commit_now",
          "text": "Chiudo il Media Day.",
          "goto": "media_close",
          "effects": [
            {
              "type": "set_flag",
              "key": "m8_media_day_complete",
              "value": true
            }
          ]
        },
        {
          "id": "commit_review",
          "text": "Rivedo ancora il tono pubblico.",
          "goto": "interview_choice"
        }
      ]
    },
    "media_close": {
      "stitches": [
        {
          "id": "s1",
          "text": "Lasci la sala stampa e torni verso gli atleti. Prima del sorteggio resta la cerimonia d'apertura."
        }
      ],
      "choices": [
        {
          "id": "close_ceremony",
          "text": "Passo alla cerimonia d'apertura.",
          "goto": "m08-opening-ceremony#ceremony_entry"
        }
      ]
    }
  }
}
