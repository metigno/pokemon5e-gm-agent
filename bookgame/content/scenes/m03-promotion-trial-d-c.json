{
  "schemaVersion": 1,
  "id": "m03-promotion-trial-d-c",
  "moduleId": "M03",
  "title": "M3_13 — Promotion Trial D→C",
  "locationId": "fer_city_arena",
  "entryNodeId": "trial_gate_call",
  "conditions": {
    "all": [
      {
        "path": "world.flags.m2_complete",
        "eq": true
      },
      {
        "path": "world.flags.m03_unlocked",
        "eq": true
      },
      {
        "path": "world.flags.m3_active",
        "eq": true
      },
      {
        "path": "competition.rank",
        "eq": "D"
      },
      {
        "path": "competition.trials.RANK_D_TO_C.registered",
        "eq": true
      }
    ]
  },
  "nodes": {
    "trial_gate_call": {
      "stitches": [
        {
          "id": "gate_1",
          "text": "L'area laterale dell'Officina Arena viene chiusa al pubblico e il giudice chiama il tuo nome. Dall'altro lato del campo l'esaminatrice è già in posizione. Una sconfitta oggi significa uscire ancora con il Rank D."
        }
      ],
      "choices": [
        {
          "id": "briefing",
          "text": "Ascolto il briefing finale dell'esaminatrice.",
          "goto": "examiner_briefing"
        },
        {
          "id": "withdraw",
          "text": "Non inizio ancora. Torno alla registrazione.",
          "goto": "m03-trial-registration#registered"
        },
        {
          "id": "confirm_rules",
          "text": "Prima del briefing controllo le regole ufficiali.",
          "goto": "rules_confirmation"
        }
      ]
    },
    "examiner_briefing": {
      "stitches": [
        {
          "id": "brief_1",
          "text": "«Tre Pokémon. Singles.» L'esaminatrice aggancia le capsule alla cintura. «Non mi interessa un piano perfetto sulla carta. Voglio vedere cosa fai quando devi proteggere un vantaggio, cambiare senza regalare il ritmo e trovare una risposta quando la prima non basta.»"
        }
      ],
      "choices": [
        {
          "id": "begin_trial",
          "text": "Confermo il roster e inizio il Trial D→C.",
          "combat": {
            "encounterId": "A3_RANK_TRIAL_D_C",
            "opponentRegistered": true,
            "competition": {
              "type": "promotion_trial",
              "matchId": "A3_RANK_TRIAL_D_C",
              "checkpointId": "RANK_D_TO_C",
              "fromRank": "D",
              "toRank": "C",
              "format": "Singles",
              "officialRosterSize": 3,
              "difficulty": "HARD",
              "retryable": true,
              "opponentTrainerId": "FER_GATE_D_C_EXAMINER"
            },
            "returnNodes": {
              "win": "m03-trial-result#trial_win",
              "lose": "m03-trial-result#trial_loss"
            },
            "opponentTrainerId": "FER_GATE_D_C_EXAMINER",
            "opponent": {
              "species": "Sableye",
              "level": 8,
              "abilityId": "keen-eye",
              "trainerId": "FER_GATE_D_C_EXAMINER"
            },
            "opponentBench": [
              {
                "species": "Roselia",
                "level": 8,
                "abilityId": "natural-cure",
                "trainerId": "FER_GATE_D_C_EXAMINER"
              },
              {
                "species": "Growlithe",
                "level": 8,
                "abilityId": "intimidate",
                "trainerId": "FER_GATE_D_C_EXAMINER"
              }
            ],
            "goto": "examiner_briefing"
          }
        },
        {
          "id": "brief_withdraw",
          "text": "Non parto ancora. Torno al banco.",
          "goto": "m03-trial-registration#registered"
        },
        {
          "id": "review_gate_identity",
          "text": "Rileggo i criteri osservati dall'esaminatrice.",
          "goto": "identity_review"
        },
        {
          "id": "check_readiness",
          "text": "Controllo ancora una volta la squadra prima di iniziare.",
          "goto": "readiness_check"
        }
      ]
    },
    "trial_combat_handoff": {
      "text": "L'esaminatore prende posizione dall'altro lato del campo. Il giudice controlla le squadre registrate e dà il segnale d'inizio.",
      "choices": []
    },
    "rules_confirmation": {
      "stitches": [
        {
          "id": "rules_1",
          "text": "Il giudice conferma il regolamento: Singles, tre Pokémon registrati, un solo incontro e vittoria necessaria per la promozione. La squadra dell'esaminatrice è registrata all'Arena."
        }
      ],
      "choices": [
        {
          "id": "rules_field",
          "text": "Controllo il campo prima di confermare.",
          "goto": "field_read"
        },
        {
          "id": "rules_ready",
          "text": "Le regole sono chiare: torno al briefing.",
          "goto": "examiner_briefing"
        }
      ]
    },
    "field_read": {
      "stitches": [
        {
          "id": "field_1",
          "text": "Il campo è un rettangolo ampio, segnato da linee bianche sul pavimento dell'Officina Arena. Non ci sono ostacoli fissi; entrambi i lati hanno spazio libero dietro la propria linea per richiamare e mandare in campo i Pokémon."
        }
      ],
      "choices": [
        {
          "id": "field_plan",
          "text": "Osservo le distanze e torno a prepararmi.",
          "goto": "readiness_check",
          "effects": [
            {
              "type": "set_flag",
              "key": "trial_d_c_field_reviewed",
              "value": true
            }
          ]
        },
        {
          "id": "field_back",
          "text": "Torno al briefing.",
          "goto": "examiner_briefing"
        }
      ]
    },
    "readiness_check": {
      "stitches": [
        {
          "id": "ready_1",
          "text": "Prima della chiamata definitiva controlli ancora una volta la squadra. I Pokémon portano con sé le condizioni con cui sei arrivato all'Arena; se non vuoi affrontare il Trial così, puoi rinviare."
        }
      ],
      "choices": [
        {
          "id": "ready_accept",
          "text": "La squadra può affrontare il Trial: torno al briefing.",
          "goto": "examiner_briefing",
          "effects": [
            {
              "type": "set_flag",
              "key": "trial_d_c_readiness_confirmed",
              "value": true
            }
          ]
        },
        {
          "id": "ready_withdraw",
          "text": "Non parto in queste condizioni: torno alla registrazione.",
          "goto": "m03-trial-registration#registered"
        }
      ]
    },
    "identity_review": {
      "stitches": [
        {
          "id": "identity_1",
          "text": "Sul foglio dell'Arena i criteri sono gli stessi annunciati al banco: gestione del ritmo, uso delle resistenze, copertura della squadra e qualità dei cambi. L'esaminatrice affronta ogni candidato con la squadra assegnata a questa fascia."
        }
      ],
      "choices": [
        {
          "id": "identity_focus",
          "text": "Tengo a mente questi criteri e torno dall'esaminatrice.",
          "goto": "examiner_briefing",
          "effects": [
            {
              "type": "set_flag",
              "key": "trial_d_c_identity_reviewed",
              "value": true
            }
          ]
        },
        {
          "id": "identity_rules",
          "text": "Riascolto le regole ufficiali.",
          "goto": "rules_confirmation"
        }
      ]
    }
  }
}
