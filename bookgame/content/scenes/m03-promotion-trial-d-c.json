  "nodes": {
    "trial_gate_call": {
      "stitches": [
        {
          "id": "gate_1",
          "text": "All'Officina Arena chiudono l'area laterale e chiamano il tuo nome. L'esaminatrice aspetta sulla linea opposta: una sconfitta lascerà la tua licenza al Rank D, ma non ti impedirà di prepararti per un nuovo tentativo."
        }
      ],
      "choices": [
        {
          "id": "briefing",
          "text": "Ascolto il briefing finale dell'esaminatrice.",
          "goto": "examiner_briefing"
        },
        {
          "id": "withdraw",
          "text": "Non inizio ancora. Torno alla registrazione.",
          "goto": "m03-trial-registration#registered"
        },
        {
          "id": "confirm_rules",
          "text": "Prima del briefing controllo le regole ufficiali.",
          "goto": "rules_confirmation"
        }
      ]
    },
    "examiner_briefing": {
      "stitches": [
        {
          "id": "brief_1",
          "text": "«Tre Pokémon. Singles.» L'esaminatrice indica il campo. «Voglio vedere come gestisci il tempo, le resistenze e i cambi. Non sacrificare tutto il piano per il primo colpo spettacolare.» I suoi Pokémon sono quelli registrati per questa prova."
        }
      ],
      "choices": [
        {
          "id": "begin_trial",
          "text": "Confermo il roster e inizio il Trial D→C.",
          "combat": {
            "encounterId": "A3_RANK_TRIAL_D_C",
            "opponentRegistered": true,
            "competition": {
              "type": "promotion_trial",
              "matchId": "A3_RANK_TRIAL_D_C",
              "checkpointId": "RANK_D_TO_C",
              "fromRank": "D",
              "toRank": "C",
              "format": "Singles",
              "officialRosterSize": 3,
              "difficulty": "HARD",
              "retryable": true,
              "opponentTrainerId": "FER_GATE_D_C_EXAMINER"
            },
            "returnNodes": {
              "win": "m03-trial-result#trial_win",
              "lose": "m03-trial-result#trial_loss"
            },
            "opponentTrainerId": "FER_GATE_D_C_EXAMINER",
            "opponent": {
              "species": "Sableye",
              "level": 8,
              "abilityId": "keen-eye",
              "trainerId": "FER_GATE_D_C_EXAMINER"
            },
            "opponentBench": [
              {
                "species": "Roselia",
                "level": 8,
                "abilityId": "natural-cure",
                "trainerId": "FER_GATE_D_C_EXAMINER"
              },
              {
                "species": "Growlithe",
                "level": 8,
                "abilityId": "intimidate",
                "trainerId": "FER_GATE_D_C_EXAMINER"
              }
            ],
            "goto": "examiner_briefing"
          }
        },
        {
          "id": "brief_withdraw",
          "text": "Non parto ancora. Torno al banco.",
          "goto": "m03-trial-registration#registered"
        },
        {
          "id": "review_gate_identity",
          "text": "Rileggo cosa questo checkpoint sta davvero valutando.",
          "goto": "identity_review"
        },
        {
          "id": "check_readiness",
          "text": "Controllo se voglio iniziare con lo stato reale attuale.",
          "goto": "readiness_check"
        }
      ]
    },
    "trial_combat_handoff": {
      "text": "L'esaminatore prende posizione dall'altro lato del campo. Il giudice controlla le squadre registrate e dà il segnale d'inizio.",
      "choices": []
    },
    "rules_confirmation": {
      "stitches": [
        {
          "id": "rules_1",
          "text": "Il giudice conferma: Singles, tre Pokémon registrati, un solo incontro, vittoria necessaria. Pokémon dell'esaminatrice registrati e quindi non catturabili."
        }
      ],
      "choices": [
        {
          "id": "rules_field",
          "text": "Controllo il campo prima di confermare.",
          "goto": "field_read"
        },
        {
          "id": "rules_ready",
          "text": "Le regole sono chiare: torno al briefing.",
          "goto": "examiner_briefing"
        }
      ]
    },
    "field_read": {
      "stitches": [
        {
          "id": "field_1",
          "text": "L'Officina Arena lascia spazio sufficiente per muoversi e cambiare Pokémon. L'arbitro ne indica i confini prima dell'inizio, senza introdurre ostacoli inattesi."
        }
      ],
      "choices": [
        {
          "id": "field_plan",
          "text": "Tengo conto dello spazio senza inventare bonus.",
          "goto": "readiness_check",
          "effects": [
            {
              "type": "set_flag",
              "key": "trial_d_c_field_reviewed",
              "value": true
            }
          ]
        },
        {
          "id": "field_back",
          "text": "Torno al briefing.",
          "goto": "examiner_briefing"
        }
      ]
    },
    "readiness_check": {
      "stitches": [
        {
          "id": "ready_1",
          "text": "Puoi entrare con la squadra nelle condizioni attuali oppure rinviare. L'accesso alla prova non guarisce i Pokémon e non restituisce le risorse già spese."
        }
      ],
      "choices": [
        {
          "id": "ready_accept",
          "text": "Accetto lo stato reale e torno al briefing.",
          "goto": "examiner_briefing",
          "effects": [
            {
              "type": "set_flag",
              "key": "trial_d_c_readiness_confirmed",
              "value": true
            }
          ]
        },
        {
          "id": "ready_withdraw",
          "text": "Non parto in queste condizioni: torno alla registrazione.",
          "goto": "m03-trial-registration#registered"
        }
      ]
    },
    "identity_review": {
      "stitches": [
        {
          "id": "identity_1",
          "text": "L'esaminatrice controlla di nuovo il proprio elenco di Pokémon. «Una prova sulla gestione degli scambi e del tempo», spiega. «Non cambio squadra perché mi piace di più la tua.»"
        }
      ],
      "choices": [
        {
          "id": "identity_focus",
          "text": "Confermo il mio focus di preparazione.",
          "goto": "examiner_briefing",
          "effects": [
            {
              "type": "set_flag",
              "key": "trial_d_c_identity_reviewed",
              "value": true
            }
          ]
        },
        {
          "id": "identity_rules",
          "text": "Riascolto le regole ufficiali.",
          "goto": "rules_confirmation"
        }
      ]
    }
  }
