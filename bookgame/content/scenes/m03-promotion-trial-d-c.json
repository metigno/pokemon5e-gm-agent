    "examiner_briefing": {
      "stitches": [
        {
          "id": "brief_1",
          "text": "«Tre Pokémon. Singles. Voglio vedere se sai usare tempo, resistenze, coperture e switch senza bruciare il piano al primo turno.» Il roster dell'esaminatrice è quello fissato per il checkpoint; nessun scaling segue il tuo livello."
        }
      ],
      "choices": [
        {
          "id": "begin_trial",
          "text": "Confermo il roster e inizio il Trial D→C.",
          "combat": {
            "encounterId": "A3_RANK_TRIAL_D_C",
            "opponentRegistered": true,
            "competition": {
              "type": "promotion_trial",
              "matchId": "A3_RANK_TRIAL_D_C",
              "checkpointId": "RANK_D_TO_C",
              "fromRank": "D",
              "toRank": "C",
              "format": "Singles",
              "officialRosterSize": 3,
              "difficulty": "HARD",
              "retryable": true,
              "opponentTrainerId": "FER_GATE_D_C_EXAMINER"
