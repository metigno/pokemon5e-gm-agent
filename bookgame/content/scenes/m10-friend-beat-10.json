{
  "schemaVersion": 1,
  "id": "m10-friend-beat-10",
  "moduleId": "M10",
  "title": "M10_05 — Friend Beat 10",
  "locationId": "world_knockout_hall",
  "entryNodeId": "friend_entry",
  "conditions": {
    "all": [
      {
        "path": "world.flags.m10_r16_aftermath_complete",
        "eq": true
      },
      {
        "path": "competition.world.knockout.r16Resolved",
        "eq": true
      },
      {
        "path": "competition.world.top8Locked",
        "eq": true
      }
    ]
  },
  "nodes": {
    "friend_entry": {
      "stitches": [
        {
          "id": "s1",
          "text": "Dopo gli ottavi cerchi un volto conosciuto fra i nomi dei qualificati e degli eliminati. Qualcuno degli amici può ancora correre verso la coppa; qualcun altro deve guardare da fuori."
        }
      ],
      "choices": [
        {
          "id": "entry_select",
          "text": "Seleziono il Friend Beat dalla situazione World reale.",
          "goto": "selector"
        },
        {
          "id": "entry_world",
          "text": "Prima controllo cosa significa essere ancora in corsa.",
          "goto": "friend_world_state"
        },
        {
          "id": "entry_previous",
          "text": "Rileggo l'ultimo contatto prima di scegliere.",
          "goto": "previous_callback"
        }
      ]
    },
    "selector": {
      "stitches": [
        {
          "id": "s1",
          "text": "Sul telefono compare {{world.flags.friend_beat_10_friend_id}}. È difficile parlare di un torneo così grande senza ricordare chi eri prima di entrarci."
        }
      ],
      "choices": [
        {
          "id": "select_now",
          "text": "Locko il Friend Beat 10.",
          "goto": "selected",
          "conditions": {
            "path": "world.flags.friend_beat_10_available",
            "ne": true
          },
          "effects": [
            {
              "type": "friend_beat_world_select",
              "previousFriendFlag": "friend_beat_09_friend_id",
              "outputPrefix": "friend_beat_10",
              "stage": "knockout"
            }
          ]
        },
        {
          "id": "select_existing",
          "text": "Il Friend Beat è già lockato: uso la selezione persistente.",
          "goto": "selected",
          "conditions": {
            "path": "world.flags.friend_beat_10_available",
            "eq": true
          }
        }
      ]
    },
    "selected": {
      "stitches": [
        {
          "id": "s1",
          "text": "{{world.flags.friend_beat_10_friend_id}} risponde da dove lo hanno portato gli incontri. Se è ancora in gara, ha una partita da preparare; altrimenti può commentare senza fingere di avere un posto nel tabellone."
        }
      ],
      "choices": [
        {
          "id": "selected_physical",
          "text": "Il contatto è fisicamente disponibile: lo raggiungo.",
          "goto": "schedule_gate",
          "conditions": {
            "path": "world.flags.friend_beat_10_contact_mode",
            "eq": "physical"
          }
        },
        {
          "id": "selected_remote",
          "text": "Non siamo nello stesso posto: uso il contatto remoto.",
          "goto": "remote_contact",
          "conditions": {
            "path": "world.flags.friend_beat_10_contact_mode",
            "eq": "remote"
          }
        }
      ]
    },
    "context": {
      "stitches": [
        {
          "id": "s1",
          "text": "Parlate di quanto è accaduto agli ottavi. I risultati vi riguardano in modo diverso e non avete bisogno di nascondervelo."
        }
      ],
      "choices": [
        {
          "id": "context_top8",
          "text": "Controllo il caso dell'amico ancora nel Top8.",
          "goto": "top8_context"
        },
        {
          "id": "context_elim",
          "text": "Controllo il caso dell'amico eliminato.",
          "goto": "eliminated_context"
        }
      ]
    },
    "top8_context": {
      "stitches": [
        {
          "id": "s1",
          "text": "Se l'amico è fra gli otto rimasti, puoi congratularti senza promettergli un altro turno. Il prossimo avversario non gli farà sconti."
        }
      ],
      "choices": [
        {
          "id": "top8_qf",
          "text": "Verifico il caso in cui sia proprio il mio prossimo avversario.",
          "goto": "qf_opponent_context"
        },
        {
          "id": "top8_pressure",
          "text": "Parlo della pressione del knockout.",
          "goto": "pressure"
        }
      ]
    },
    "eliminated_context": {
      "stitches": [
        {
          "id": "s1",
          "text": "Se l'amico è stato eliminato, la conversazione non può riportarlo in gara. Può scherzarci sopra, essere amareggiato o chiederti cosa farai tu."
        }
      ],
      "choices": [
        {
          "id": "elim_result",
          "text": "Rileggo la regola di indipendenza dei risultati.",
          "goto": "result_independence"
        },
        {
          "id": "elim_contact",
          "text": "Passo al tipo di contatto disponibile.",
          "goto": "schedule_gate"
        }
      ]
    },
    "qf_opponent_context": {
      "stitches": [
        {
          "id": "s1",
          "text": "Se il tabellone vi oppone nei quarti, un sorriso basta a far tornare la vecchia rivalità. «Non aspettarti che ti regali niente» è una frase che entrambi conoscete."
        }
      ],
      "choices": [
        {
          "id": "qf_pressure",
          "text": "Affronto il peso di un quarto contro un amico.",
          "goto": "pressure"
        },
        {
          "id": "qf_independence",
          "text": "Confermo che il risultato resterà indipendente.",
          "goto": "result_independence"
        }
      ]
    },
    "schedule_gate": {
      "stitches": [
        {
          "id": "s1",
          "text": "Controlli dove si trova: una stretta di mano richiede che siate davvero nello stesso luogo."
        }
      ],
      "choices": [
        {
          "id": "schedule_physical",
          "text": "Siamo nello stesso venue: apro il contatto reale.",
          "goto": "physical_contact",
          "conditions": {
            "path": "world.flags.friend_beat_10_contact_mode",
            "eq": "physical"
          }
        },
        {
          "id": "schedule_remote",
          "text": "Il contatto è remoto: non teletrasporto nessuno.",
          "goto": "remote_contact",
          "conditions": {
            "path": "world.flags.friend_beat_10_contact_mode",
            "eq": "remote"
          }
        }
      ]
    },
    "physical_contact": {
      "stitches": [
        {
          "id": "s1",
          "text": "Vi ritrovate in un corridoio abbastanza tranquillo da parlare senza telecamere. Il tono è quello degli amici che hanno imparato a sfidarsi."
        }
      ],
      "choices": [
        {
          "id": "physical_mattew",
          "text": "Parlo con Mattew.",
          "goto": "contact_after",
          "conditions": {
            "path": "world.flags.friend_beat_10_friend_id",
            "eq": "Mattew"
          },
          "effects": [
            {
              "type": "npc_relationship_adjust",
              "npcId": "Mattew",
              "delta": 1
            },
            {
              "type": "set_flag",
              "key": "friend_beat_10_type",
              "value": "physical_knockout_contact"
            },
            {
              "type": "set_flag",
              "key": "friend_beat_10_result",
              "value": "supportive_exchange"
            }
          ]
        },
        {
          "id": "physical_daniel",
          "text": "Parlo con Daniel.",
          "goto": "contact_after",
          "conditions": {
            "path": "world.flags.friend_beat_10_friend_id",
            "eq": "Daniel"
          },
          "effects": [
            {
              "type": "npc_relationship_adjust",
              "npcId": "Daniel",
              "delta": 1
            },
            {
              "type": "set_flag",
              "key": "friend_beat_10_type",
              "value": "physical_knockout_contact"
            },
            {
              "type": "set_flag",
              "key": "friend_beat_10_result",
              "value": "supportive_exchange"
            }
          ]
        },
        {
          "id": "physical_edward",
          "text": "Parlo con Edward.",
          "goto": "contact_after",
          "conditions": {
            "path": "world.flags.friend_beat_10_friend_id",
            "eq": "Edward"
          },
          "effects": [
            {
              "type": "npc_relationship_adjust",
              "npcId": "Edward",
              "delta": 1
            },
            {
              "type": "set_flag",
              "key": "friend_beat_10_type",
              "value": "physical_knockout_contact"
            },
            {
              "type": "set_flag",
              "key": "friend_beat_10_result",
              "value": "supportive_exchange"
            }
          ]
        },
        {
          "id": "physical_fab",
          "text": "Parlo con Fab.",
          "goto": "contact_after",
          "conditions": {
            "path": "world.flags.friend_beat_10_friend_id",
            "eq": "Fab"
          },
          "effects": [
            {
              "type": "npc_relationship_adjust",
              "npcId": "Fab",
              "delta": 1
            },
            {
              "type": "set_flag",
              "key": "friend_beat_10_type",
              "value": "physical_knockout_contact"
            },
            {
              "type": "set_flag",
              "key": "friend_beat_10_result",
              "value": "supportive_exchange"
            }
          ]
        }
      ]
    },
    "remote_contact": {
      "stitches": [
        {
          "id": "s1",
          "text": "La chiamata arriva da lontano. Non è la stessa cosa che guardarsi negli occhi, ma una battuta riesce comunque a trovare il bersaglio."
        }
      ],
      "choices": [
        {
          "id": "remote_accept",
          "text": "Accetto il contatto remoto e proseguo.",
          "goto": "contact_after",
          "effects": [
            {
              "type": "set_flag",
              "key": "friend_beat_10_type",
              "value": "remote_knockout_contact"
            },
            {
              "type": "set_flag",
              "key": "friend_beat_10_result",
              "value": "remote_support"
            }
          ]
        },
        {
          "id": "remote_context",
          "text": "Prima rileggo il contesto competitivo dell'amico.",
          "goto": "context"
        }
      ]
    },
    "contact_after": {
      "stitches": [
        {
          "id": "s1",
          "text": "Quando vi salutate, la squadra rimane nelle condizioni lasciate dagli ottavi e il programma del torneo non è cambiato."
        }
      ],
      "choices": [
        {
          "id": "after_team",
          "text": "Parlo di cosa mi resta nella squadra.",
          "goto": "team_state"
        },
        {
          "id": "after_route",
          "text": "Parlo di cosa significa restare o uscire dal World.",
          "goto": "route_meaning"
        }
      ]
    },
    "previous_callback": {
      "stitches": [
        {
          "id": "s1",
          "text": "Una vecchia provocazione ritorna proprio al momento giusto. Non tutte le tensioni sono scomparse dal vostro ultimo incontro."
        }
      ],
      "choices": [
        {
          "id": "previous_select",
          "text": "Torno alla selezione del contatto attuale.",
          "goto": "selector"
        },
        {
          "id": "previous_relationship",
          "text": "Rileggo il valore della relazione persistente.",
          "goto": "relationship"
        }
      ]
    },
    "relationship": {
      "stitches": [
        {
          "id": "s1",
          "text": "La fiducia rende alcune parole più semplici da dire; un attrito irrisolto, invece, si sente anche senza alzare la voce."
        }
      ],
      "choices": [
        {
          "id": "relationship_contact",
          "text": "Torno al contatto reale.",
          "goto": "selected"
        },
        {
          "id": "relationship_independence",
          "text": "Controllo ancora la separazione dai risultati.",
          "goto": "result_independence"
        }
      ]
    },
    "team_state": {
      "stitches": [
        {
          "id": "s1",
          "text": "Ti fermi a guardare i Pokémon. Il contatto con un amico non ha riparato automaticamente la fatica delle partite."
        }
      ],
      "choices": [
        {
          "id": "team_pressure",
          "text": "Ragiono sulla pressione delle risorse residue.",
          "goto": "pressure"
        },
        {
          "id": "team_commit",
          "text": "Porto il contatto alla chiusura.",
          "goto": "commitment"
        }
      ]
    },
    "friend_world_state": {
      "stitches": [
        {
          "id": "s1",
          "text": "Fra gli amici c'è chi è ancora in corsa e chi ha già dovuto fermarsi. Le loro strade non seguono tutte la tua."
        }
      ],
      "choices": [
        {
          "id": "world_context",
          "text": "Apro la classificazione del contesto.",
          "goto": "context"
        },
        {
          "id": "world_select",
          "text": "Passo alla selezione E4.",
          "goto": "selector"
        }
      ]
    },
    "pressure": {
      "stitches": [
        {
          "id": "s1",
          "text": "A questo punto un amico può diventare il prossimo avversario. Sul campo sarete rivali, senza dover smettere di essere amici."
        }
      ],
      "choices": [
        {
          "id": "pressure_independence",
          "text": "Rileggo l'indipendenza del risultato.",
          "goto": "result_independence"
        },
        {
          "id": "pressure_commit",
          "text": "Chiudo il confronto.",
          "goto": "commitment"
        }
      ]
    },
    "result_independence": {
      "stitches": [
        {
          "id": "s1",
          "text": "Nessuna parola detta qui assegna una vittoria. Se vi incontrerete in gara, parleranno le vostre scelte."
        }
      ],
      "choices": [
        {
          "id": "independence_route",
          "text": "Passo alla conseguenza reale del mio R16.",
          "goto": "route_meaning"
        },
        {
          "id": "independence_commit",
          "text": "Procedo verso la chiusura.",
          "goto": "commitment"
        }
      ]
    },
    "route_meaning": {
      "stitches": [
        {
          "id": "s1",
          "text": "Se sei ancora dentro, torni alla preparazione dei quarti. Se hai perso, ti prepari a lasciare il torneo."
        }
      ],
      "choices": [
        {
          "id": "route_team",
          "text": "Rileggo le risorse con cui proseguo o esco.",
          "goto": "team_state"
        },
        {
          "id": "route_commit",
          "text": "Porto il Friend Beat al commit.",
          "goto": "commitment"
        }
      ]
    },
    "commitment": {
      "stitches": [
        {
          "id": "s1",
          "text": "Prima di chiudere promettete soltanto di risentirvi quando sarà possibile. I vostri calendari non sono più quelli delle prime strade."
        }
      ],
      "choices": [
        {
          "id": "commit_now",
          "text": "Chiudo FRIEND_BEAT_10.",
          "goto": "branch_gate",
          "effects": [
            {
              "type": "set_flag",
              "key": "friend_beat_10_complete",
              "value": true
            },
            {
              "type": "set_flag",
              "key": "m10_friend_beat_10_complete",
              "value": true
            }
          ],
          "conditions": {
            "all": [
              {
                "path": "world.flags.friend_beat_10_friend_id",
                "exists": true
              },
              {
                "path": "world.flags.friend_beat_10_type",
                "exists": true
              },
              {
                "path": "world.flags.friend_beat_10_result",
                "exists": true
              }
            ]
          }
        },
        {
          "id": "commit_audit",
          "text": "Prima controllo lo stato scritto.",
          "goto": "audit"
        }
      ]
    },
    "branch_gate": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il cartello indica il percorso dei qualificati e quello di chi ha terminato il torneo. Il risultato decide quale strada è tua."
        }
      ],
      "choices": [
        {
          "id": "branch_qf",
          "text": "Sono nel Top8: passo alla QF Prep.",
          "goto": "m10-qf-prep#prep_entry",
          "conditions": {
            "path": "world.flags.world_r16_won",
            "eq": true
          }
        },
        {
          "id": "branch_exit",
          "text": "Sono eliminato: passo direttamente al Module Outcome.",
          "goto": "m10-module-outcome#outcome_entry",
          "conditions": {
            "path": "world.flags.world_eliminated",
            "eq": true
          }
        },
        {
          "id": "branch_audit",
          "text": "Rileggo il Friend Beat prima di uscire.",
          "goto": "audit"
        }
      ]
    },
    "complete": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il contatto finisce, ma non il rapporto. Il tuo prossimo passo dipende dalla partita che hai davvero giocato."
        }
      ],
      "choices": [
        {
          "id": "complete_branch",
          "text": "Applico la rotta competitiva reale.",
          "goto": "branch_gate"
        },
        {
          "id": "complete_world",
          "text": "Rivedo lo stato World dell'amico.",
          "goto": "friend_world_state"
        }
      ]
    },
    "audit": {
      "stitches": [
        {
          "id": "s1",
          "text": "Controlli l'ultimo messaggio. Il nome e le parole dell'amico restano lì, insieme a ciò che vi siete detti."
        }
      ],
      "choices": [
        {
          "id": "audit_complete",
          "text": "Torno alla chiusura del Friend Beat.",
          "goto": "complete"
        },
        {
          "id": "audit_context",
          "text": "Rivedo il contesto selezionato.",
          "goto": "context"
        }
      ]
    }
  }
}
