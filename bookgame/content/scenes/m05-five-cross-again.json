{
  "schemaVersion": 1,
  "id": "m05-five-cross-again",
  "moduleId": "M05",
  "title": "M5_08 — Five Roads Cross Again",
  "locationId": "alt_town",
  "entryNodeId": "reunion_entry",
  "conditions": {
    "all": [
      {
        "path": "world.flags.m4_complete",
        "eq": true
      },
      {
        "path": "world.flags.m05_unlocked",
        "eq": true
      },
      {
        "path": "world.flags.m5_active",
        "eq": true
      },
      {
        "path": "competition.rank",
        "eq": "B"
      },
      {
        "path": "world.flags.a5_five_cross_available",
        "eq": true
      }
    ]
  },
  "nodes": {
    "reunion_entry": {
      "stitches": [
        {
          "id": "e1",
          "text": "Ad Altacima ritrovi notizie degli altri quattro amici. Alcuni potrebbero essere abbastanza vicini da incontrarti in piazza; altri rispondono soltanto fra un viaggio e l'altro. Per una volta i vostri percorsi si sfiorano di nuovo."
        }
      ],
      "choices": [
        {
          "id": "entry_presence",
          "text": "Controllo chi è realmente presente.",
          "goto": "presence_board"
        },
        {
          "id": "entry_shared",
          "text": "Apro il canale comune per chi è lontano.",
          "goto": "shared_table"
        }
      ]
    },
    "presence_board": {
      "stitches": [
        {
          "id": "p1",
          "text": "Davanti alla bacheca del Circuito confronti orari, messaggi e partenze. C'è chi può raggiungerti prima di sera e chi è già lontano, con soltanto qualche minuto per rispondere."
        }
      ],
      "choices": [
        {
          "id": "presence_luke",
          "text": "Cerco Luke tra gli allenatori arrivati ad Altacima.",
          "conditions": {
            "all": [
              {
                "path": "player.name",
                "ne": "Luke"
              },
              {
                "path": "npcs.Luke.schedule.present",
                "eq": true
              },
              {
                "path": "npcs.Luke.schedule.locationId",
                "in": [
                  "alt_town",
                  "ful_plateau"
                ]
              }
            ]
          },
          "goto": "luke_update"
        },
        {
          "id": "presence_mattew",
          "text": "Cerco Mattew vicino alla bacheca delle gare.",
          "conditions": {
            "all": [
              {
                "path": "player.name",
                "ne": "Mattew"
              },
              {
                "path": "npcs.Mattew.schedule.present",
                "eq": true
              },
              {
                "path": "npcs.Mattew.schedule.locationId",
                "in": [
                  "alt_town",
                  "ful_plateau"
                ]
              }
            ]
          },
          "goto": "mattew_update"
        },
        {
          "id": "presence_daniel",
          "text": "Cerco Daniel tra gli iscritti di oggi.",
          "conditions": {
            "all": [
              {
                "path": "player.name",
                "ne": "Daniel"
              },
              {
                "path": "npcs.Daniel.schedule.present",
                "eq": true
              },
              {
                "path": "npcs.Daniel.schedule.locationId",
                "in": [
                  "alt_town",
                  "ful_plateau"
                ]
              }
            ]
          },
          "goto": "daniel_update"
        },
        {
          "id": "presence_edward",
          "text": "Cerco Edward nella piazza del Circuito.",
          "conditions": {
            "all": [
              {
                "path": "player.name",
                "ne": "Edward"
              },
              {
                "path": "npcs.Edward.schedule.present",
                "eq": true
              },
              {
                "path": "npcs.Edward.schedule.locationId",
                "in": [
                  "alt_town",
                  "ful_plateau"
                ]
              }
            ]
          },
          "goto": "edward_update"
        },
        {
          "id": "presence_fab",
          "text": "Cerco Fab prima che riparta.",
          "conditions": {
            "all": [
              {
                "path": "player.name",
                "ne": "Fab"
              },
              {
                "path": "npcs.Fab.schedule.present",
                "eq": true
              },
              {
                "path": "npcs.Fab.schedule.locationId",
                "in": [
                  "alt_town",
                  "ful_plateau"
                ]
              }
            ]
          },
          "goto": "fab_update"
        },
        {
          "id": "presence_remote",
          "text": "Per chi è lontano uso il canale comune invece di forzare un incontro.",
          "goto": "shared_table"
        }
      ]
    },
    "luke_update": {
      "stitches": [
        {
          "id": "l1",
          "text": "Luke non ha perso il vizio di difendere i Pokémon a cui si è affezionato. «Cambiare squadra ogni volta che perdi? Troppo facile.» Poi aggiunge, quasi a sfidarti, che preferisce trovare un modo per far funzionare anche l'abbinamento più difficile."
        }
      ],
      "choices": [
        {
          "id": "luke_compare",
          "text": "Confronto con Luke come stiamo gestendo Rank B.",
          "goto": "career_compare",
          "effects": [
            {
              "type": "npc_state_set",
              "npcId": "Luke",
              "key": "fiveCross05Seen",
              "value": true
            }
          ]
        },
        {
          "id": "luke_shared",
          "text": "Lo porto nella conversazione comune.",
          "goto": "shared_table",
          "effects": [
            {
              "type": "npc_state_set",
              "npcId": "Luke",
              "key": "fiveCross05Seen",
              "value": true
            }
          ]
        }
      ]
    },
    "mattew_update": {
      "stitches": [
        {
          "id": "m1",
          "text": "Mattew ha il taccuino pieno di appunti. «Non basta dire che avevi un piano. Devi sapere perché ha smesso di funzionare.» Ti mostra una sequenza di turni, poi aspetta che tu trovi l'errore."
        }
      ],
      "choices": [
        {
          "id": "mattew_compare",
          "text": "Confronto con Mattew i nostri metodi di preparazione.",
          "goto": "career_compare",
          "effects": [
            {
              "type": "npc_state_set",
              "npcId": "Mattew",
              "key": "fiveCross05Seen",
              "value": true
            }
          ]
        },
        {
          "id": "mattew_shared",
          "text": "Lo porto nella conversazione comune.",
          "goto": "shared_table",
          "effects": [
            {
              "type": "npc_state_set",
              "npcId": "Mattew",
              "key": "fiveCross05Seen",
              "value": true
            }
          ]
        }
      ]
    },
    "daniel_update": {
      "stitches": [
        {
          "id": "d1",
          "text": "Daniel ascolta prima di rispondere. Quando qualcuno minimizza una scelta discutibile, si irrigidisce: «Il risultato non cancella il modo in cui ci sei arrivato.» Poi racconta quanto gli sia costato restare fedele a quella regola."
        }
      ],
      "choices": [
        {
          "id": "daniel_compare",
          "text": "Confrontiamo il costo delle nostre scelte.",
          "goto": "career_compare",
          "effects": [
            {
              "type": "npc_state_set",
              "npcId": "Daniel",
              "key": "fiveCross05Seen",
              "value": true
            }
          ]
        },
        {
          "id": "daniel_shared",
          "text": "Lo porto nella conversazione comune.",
          "goto": "shared_table",
          "effects": [
            {
              "type": "npc_state_set",
              "npcId": "Daniel",
              "key": "fiveCross05Seen",
              "value": true
            }
          ]
        }
      ]
    },
    "edward_update": {
      "stitches": [
        {
          "id": "ed1",
          "text": "Edward arriva con la sicurezza di chi sa farsi notare. «Se devo vincere, almeno che sia una bella vittoria.» Sorride, ma dietro la battuta ci sono settimane di allenamento e sconfitte che non racconta volentieri."
        }
      ],
      "choices": [
        {
          "id": "edward_compare",
          "text": "Confrontiamo come gestiamo continuità e fatica.",
          "goto": "career_compare",
          "effects": [
            {
              "type": "npc_state_set",
              "npcId": "Edward",
              "key": "fiveCross05Seen",
              "value": true
            }
          ]
        },
        {
          "id": "edward_shared",
          "text": "Lo porto nella conversazione comune.",
          "goto": "shared_table",
          "effects": [
            {
              "type": "npc_state_set",
              "npcId": "Edward",
              "key": "fiveCross05Seen",
              "value": true
            }
          ]
        }
      ]
    },
    "fab_update": {
      "stitches": [
        {
          "id": "f1",
          "text": "Fab comincia a raccontare di un Pokémon incontrato fuori sentiero e finisce per descrivere mezz'ora passata a osservarlo. «Non l'ho catturato. Stava bene dov'era.» Poi cambia argomento con una battuta."
        }
      ],
      "choices": [
        {
          "id": "fab_compare",
          "text": "Confrontiamo cosa abbiamo imparato fuori dalle arene.",
          "goto": "career_compare",
          "effects": [
            {
              "type": "npc_state_set",
              "npcId": "Fab",
              "key": "fiveCross05Seen",
              "value": true
            }
          ]
        },
        {
          "id": "fab_shared",
          "text": "Lo porto nella conversazione comune.",
          "goto": "shared_table",
          "effects": [
            {
              "type": "npc_state_set",
              "npcId": "Fab",
              "key": "fiveCross05Seen",
              "value": true
            }
          ]
        }
      ]
    },
    "shared_table": {
      "stitches": [
        {
          "id": "s1",
          "text": "Chi riesce a esserci si stringe attorno a un tavolo; dagli altri arrivano messaggi e chiamate brevi, interrotte dal rumore dei viaggi. Le prese in giro ripartono quasi subito, come se vi foste lasciati ieri."
        }
      ],
      "choices": [
        {
          "id": "shared_career",
          "text": "Confrontiamo dove ci sta portando il circuito.",
          "goto": "career_compare"
        },
        {
          "id": "shared_lance",
          "text": "Parlo del modo in cui Lance legge rischio e margine.",
          "conditions": {
            "path": "world.flags.lance_met",
            "eq": true
          },
          "goto": "lance_overlap"
        },
        {
          "id": "shared_trace",
          "text": "Accenno alla traccia anomala di Fulgore senza inventare risposte.",
          "conditions": {
            "path": "world.flags.ancient_mystery_layer_1",
            "exists": true
          },
          "goto": "ancient_context"
        }
      ]
    },
    "career_compare": {
      "stitches": [
        {
          "id": "c1",
          "text": "Confrontate i risultati senza riuscire a stabilire chi abbia avuto il percorso più difficile. Ognuno ricorda una vittoria, una sconfitta e almeno una scelta che gli altri non avrebbero fatto."
        }
      ],
      "choices": [
        {
          "id": "career_license",
          "text": "Confrontiamo cosa cambia con la rete interregionale.",
          "conditions": {
            "path": "world.flags.interregional_license",
            "eq": true
          },
          "goto": "license_context"
        },
        {
          "id": "career_schedule",
          "text": "Guardiamo dove ci porteranno i prossimi impegni.",
          "goto": "schedule_split"
        }
      ]
    },
    "lance_overlap": {
      "stitches": [
        {
          "id": "lo1",
          "text": "Il tema di Lance produce reazioni diverse: c'è chi privilegia preparazione, chi adattamento, chi continuità. La scena non decide quale filosofia sia corretta."
        }
      ],
      "choices": [
        {
          "id": "lance_keep",
          "text": "Tengo la discussione sul rischio concreto.",
          "goto": "schedule_split",
          "effects": [
            {
              "type": "set_flag",
              "key": "five_cross_lance_context",
              "value": true
            }
          ]
        },
        {
          "id": "lance_back",
          "text": "Torno al quadro generale.",
          "goto": "shared_table"
        }
      ]
    },
    "ancient_context": {
      "stitches": [
        {
          "id": "a1",
          "text": "Quando racconti dei segni trovati in quota, le battute si interrompono per un momento. Ognuno propone una spiegazione diversa, ma nessuno sa ancora dire che cosa li abbia lasciati."
        }
      ],
      "choices": [
        {
          "id": "ancient_record",
          "text": "Condivido soltanto ciò che ho visto, senza trarre conclusioni.",
          "goto": "schedule_split",
          "effects": [
            {
              "type": "set_flag",
              "key": "five_cross_trace_shared",
              "value": true
            }
          ]
        },
        {
          "id": "ancient_back",
          "text": "Non insisto sul mistero e torno alla reunion.",
          "goto": "shared_table"
        }
      ]
    },
    "license_context": {
      "stitches": [
        {
          "id": "li1",
          "text": "La licenza interregionale rende più probabile incrociarsi in eventi lontani, ma non sincronizza automaticamente calendari o Rank."
        }
      ],
      "choices": [
        {
          "id": "license_record",
          "text": "Parliamo di quando potremmo incrociarci di nuovo.",
          "goto": "schedule_split",
          "effects": [
            {
              "type": "set_flag",
              "key": "five_cross_interregional_context",
              "value": true
            }
          ]
        },
        {
          "id": "license_back",
          "text": "Torniamo alle traiettorie attuali.",
          "goto": "career_compare"
        }
      ]
    },
    "schedule_split": {
      "stitches": [
        {
          "id": "ss1",
          "text": "Quando confrontate gli impegni, emerge la stessa realtà di sempre: dopo questa finestra tornerete a separarvi. Proprio per questo c'è spazio per un confronto personale con uno solo degli altri Five."
        }
      ],
      "choices": [
        {
          "id": "schedule_personal",
          "text": "Saluto il gruppo e cerco un momento per parlare con uno di loro.",
          "goto": "friend_beat_gate",
          "effects": [
            {
              "type": "set_flag",
              "key": "five_cross_complete",
              "value": true
            },
            {
              "type": "set_flag",
              "key": "five_cross_reunion_result",
              "value": "causal_reunion"
            }
          ]
        }
      ]
    },
    "friend_beat_gate": {
      "stitches": [
        {
          "id": "fg1",
          "text": "Fra saluti frettolosi e orari di partenza, trovi un momento per parlare con uno degli amici che puoi davvero raggiungere. Gli altri hanno già un treno, un allenamento o una chiamata da chiudere."
        }
      ],
      "choices": [
        {
          "id": "friend_gate_continue",
          "text": "Provo a contattare uno degli amici.",
          "conditions": {
            "path": "world.flags.friend_beat_05_available",
            "eq": true
          },
          "goto": "m05-friend-beat-05#friend_call"
        },
        {
          "id": "friend_gate_close",
          "text": "Non riesco a raggiungerli ora: torno alla piazza.",
          "conditions": {
            "path": "world.flags.friend_beat_05_available",
            "ne": true
          },
          "goto": "reunion_close"
        }
      ]
    },
    "reunion_close": {
      "stitches": [
        {
          "id": "rc1",
          "text": "La piazza si svuota poco alla volta. Qualcuno riparte, qualcuno spegne la chiamata promettendo di risentirsi. Restano una battuta non finita e la sensazione che il prossimo incontro non sarà così semplice da organizzare."
        }
      ],
      "choices": [
        {
          "id": "reunion_hub",
          "text": "Torno alla piazza.",
          "goto": "m05-altacima#town_hub",
          "effects": [
            {
              "type": "set_flag",
              "key": "five_cross_complete",
              "value": true
            },
            {
              "type": "set_location",
              "locationId": "alt_town"
            }
          ]
        }
      ]
    }
  }
}
