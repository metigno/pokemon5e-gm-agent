{
  "schemaVersion": 1,
  "id": "m07-meridiana-arrival",
  "moduleId": "M07",
  "title": "M7_01 — Meridiana Arrival",
  "locationId": "meridiana_city",
  "entryNodeId": "arrival_entry",
  "conditions": {
    "all": [
      {
        "path": "world.flags.m6_complete",
        "eq": true
      },
      {
        "path": "world.flags.m07_unlocked",
        "eq": true
      },
      {
        "path": "competition.rank",
        "eq": "S"
      },
      {
        "path": "world.flags.m7_active",
        "eq": true
      }
    ]
  },
  "nodes": {
    "arrival_entry": {
      "stitches": [
        {
          "id": "s1",
          "text": "Meridiana si apre intorno al Grand Hall, una facciata di vetro attraversata dal continuo movimento di allenatori. Attorno si distribuiscono arena, università, clinica sportiva e stazione internazionale."
        }
      ],
      "choices": [
        {
          "id": "arrival_register",
          "text": "Registro l'arrivo reale a Meridiana.",
          "goto": "city_hub",
          "effects": [
            {
              "type": "set_flag",
              "key": "meridiana_discovered",
              "value": true
            },
            {
              "type": "set_flag",
              "key": "m7_meridiana_arrived",
              "value": true
            },
            {
              "type": "set_location",
              "locationId": "meridiana_city"
            }
          ]
        },
        {
          "id": "arrival_hall",
          "text": "Entro prima nel Grand Hall.",
          "goto": "grand_hall"
        },
        {
          "id": "arrival_scan",
          "text": "Osservo servizi e flussi prima di muovermi.",
          "goto": "services_review"
        }
      ]
    },
    "grand_hall": {
      "stitches": [
        {
          "id": "s1",
          "text": "Nel Grand Hall il personale gestisce licenze e accrediti. Sulle pareti ci sono programmi e classifiche, non il trono di un campione da sfidare."
        }
      ],
      "choices": [
        {
          "id": "hall_hub",
          "text": "Esco nella piazza professionale.",
          "goto": "city_hub",
          "effects": [
            {
              "type": "set_location",
              "locationId": "meridiana_city"
            }
          ]
        },
        {
          "id": "hall_arena",
          "text": "Controllo il settore arena.",
          "goto": "arena"
        },
        {
          "id": "hall_station",
          "text": "Controllo i collegamenti internazionali.",
          "goto": "station"
        }
      ]
    },
    "city_hub": {
      "stitches": [
        {
          "id": "s1",
          "text": "Dalla piazza partono strade verso servizi medici, uffici e laboratori. Ogni visita richiede tempo e alcune prestazioni vanno prenotate."
        }
      ],
      "choices": [
        {
          "id": "hub_medical",
          "text": "Vado alla medicina sportiva.",
          "goto": "medical_sports"
        },
        {
          "id": "hub_university",
          "text": "Vado all'università tecnica.",
          "goto": "university"
        },
        {
          "id": "hub_sponsor",
          "text": "Attraverso il distretto sponsor/media.",
          "goto": "sponsor_district"
        }
      ]
    },
    "medical_sports": {
      "stitches": [
        {
          "id": "s1",
          "text": "Alla clinica un'infermiera ti chiede delle condizioni della squadra prima di indicare servizi e disponibilità. Nessuno promette una guarigione senza visita."
        }
      ],
      "choices": [
        {
          "id": "medical_info",
          "text": "Chiedo come viene valutata la readiness professionale.",
          "goto": "medical_info"
        },
        {
          "id": "medical_back",
          "text": "Torno alla piazza.",
          "goto": "city_hub",
          "effects": [
            {
              "type": "set_location",
              "locationId": "meridiana_city"
            }
          ]
        }
      ]
    },
    "medical_info": {
      "stitches": [
        {
          "id": "s1",
          "text": "«Conta il tempo fra una gara e l'altra», spiega un medico. «E conta come sono arrivati qui i tuoi Pokémon, non soltanto il nome sulla licenza.»"
        }
      ],
      "choices": [
        {
          "id": "medical_note",
          "text": "Registro l'informazione senza ricevere cure gratuite.",
          "goto": "city_hub",
          "effects": [
            {
              "type": "set_flag",
              "key": "m7_medical_guidance_known",
              "value": true
            },
            {
              "type": "set_location",
              "locationId": "meridiana_city"
            }
          ]
        },
        {
          "id": "medical_services",
          "text": "Confronto gli altri servizi disponibili.",
          "goto": "services_review"
        }
      ]
    },
    "station": {
      "stitches": [
        {
          "id": "s1",
          "text": "I tabelloni della stazione elencano collegamenti internazionali e orari precisi. Un viaggio richiede un biglietto e un posto reale."
        }
      ],
      "choices": [
        {
          "id": "station_note",
          "text": "Registro la funzione della stazione.",
          "goto": "services_review",
          "effects": [
            {
              "type": "set_flag",
              "key": "m7_station_reviewed",
              "value": true
            }
          ]
        },
        {
          "id": "station_back",
          "text": "Torno al Grand Hall.",
          "goto": "grand_hall"
        }
      ]
    },
    "university": {
      "stitches": [
        {
          "id": "s1",
          "text": "All'università si discutono tattiche, fisiologia e registrazioni di incontri. Studiare può aiutarti a scegliere, ma non trasforma da solo la squadra."
        }
      ],
      "choices": [
        {
          "id": "university_note",
          "text": "Registro il servizio tecnico.",
          "goto": "services_review",
          "effects": [
            {
              "type": "set_flag",
              "key": "m7_university_known",
              "value": true
            }
          ]
        },
        {
          "id": "university_back",
          "text": "Torno alla piazza.",
          "goto": "city_hub"
        }
      ]
    },
    "arena": {
      "stitches": [
        {
          "id": "s1",
          "text": "Nella grande arena si alternano allenamenti e partite ufficiali. Per entrare in campo serve la registrazione prevista per ogni evento."
        }
      ],
      "choices": [
        {
          "id": "arena_rumor",
          "text": "Ascolto chi viene indicato come benchmark del circuito.",
          "goto": "cynthia_hint"
        },
        {
          "id": "arena_back",
          "text": "Torno al Grand Hall.",
          "goto": "grand_hall"
        }
      ]
    },
    "sponsor_district": {
      "stitches": [
        {
          "id": "s1",
          "text": "Negli uffici degli sponsor si parla di contratti, presenza pubblica e obblighi. Una firma può occupare il tuo tempo anche quando preferiresti allenarti."
        }
      ],
      "choices": [
        {
          "id": "sponsor_media",
          "text": "Osservo la zona stampa.",
          "goto": "media_row"
        },
        {
          "id": "sponsor_back",
          "text": "Torno alla piazza.",
          "goto": "city_hub"
        }
      ]
    },
    "media_row": {
      "stitches": [
        {
          "id": "s1",
          "text": "Le telecamere seguono gli atleti nei corridoi degli accrediti. Una domanda insistente può costarti attenzione, non cambiare di nascosto i tuoi Pokémon."
        }
      ],
      "choices": [
        {
          "id": "media_review",
          "text": "Valuto come i servizi si intrecciano.",
          "goto": "services_review"
        },
        {
          "id": "media_wait",
          "text": "Resto in zona abbastanza da vedere cambiare i turni.",
          "goto": "wait_plaza"
        }
      ]
    },
    "services_review": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il Grand Hall raccoglie opportunità diverse. Il tempo che dedichi a una visita non sarà disponibile per tutte le altre."
        }
      ],
      "choices": [
        {
          "id": "services_cynthia",
          "text": "Seguo il nome che ricorre fra arena e Grand Hall.",
          "goto": "cynthia_hint"
        },
        {
          "id": "services_hub",
          "text": "Torno alla piazza.",
          "goto": "city_hub"
        }
      ]
    },
    "wait_plaza": {
      "stitches": [
        {
          "id": "s1",
          "text": "Passi un'ora nella piazza osservando i viaggiatori. Alcuni uffici cambiano turno e altri allenatori si allontanano per i propri impegni."
        }
      ],
      "choices": [
        {
          "id": "wait_hour",
          "text": "Lascio passare un'altra ora e torno all'hub.",
          "goto": "city_hub",
          "timeCostMinutes": 60,
          "effects": [
            {
              "type": "set_location",
              "locationId": "meridiana_city"
            }
          ]
        },
        {
          "id": "wait_close",
          "text": "Chiudo il primo orientamento.",
          "goto": "arrival_close"
        }
      ]
    },
    "cynthia_hint": {
      "stitches": [
        {
          "id": "s1",
          "text": "Nei discorsi dei preparatori torna il nome di Cynthia. Non per qualche privilegio segreto, ma per la cura con cui conserva risorse e lucidità fra incontri ravvicinati."
        }
      ],
      "choices": [
        {
          "id": "hint_follow",
          "text": "Cerco un incontro plausibile nel circuito.",
          "goto": "arrival_close",
          "effects": [
            {
              "type": "set_flag",
              "key": "cynthia_meridiana_hint",
              "value": true
            }
          ]
        },
        {
          "id": "hint_arena",
          "text": "Torno al settore arena.",
          "goto": "arena"
        }
      ]
    },
    "arrival_close": {
      "stitches": [
        {
          "id": "s1",
          "text": "Ora sai orientarti a Meridiana. Se vuoi cercare Cynthia, dovrai farlo quando i suoi impegni la porteranno davvero in un luogo raggiungibile."
        }
      ],
      "choices": [
        {
          "id": "close_cynthia",
          "text": "Passo al contesto in cui può comparire Cynthia.",
          "goto": "m07-cynthia-enters#cynthia_entry"
        },
        {
          "id": "close_hub",
          "text": "Resto libero nella piazza di Meridiana.",
          "goto": "city_hub"
        }
      ]
    }
  }
}
