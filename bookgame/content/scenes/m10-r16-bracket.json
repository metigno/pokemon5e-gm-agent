{
  "schemaVersion": 1,
  "id": "m10-r16-bracket",
  "moduleId": "M10",
  "title": "M10_00 — R16 Bracket",
  "locationId": "world_knockout_hall",
  "entryNodeId": "bracket_entry",
  "conditions": {
    "all": [
      {
        "path": "world.flags.m9_complete",
        "eq": true
      },
      {
        "path": "world.flags.m10_unlocked",
        "eq": true
      },
      {
        "path": "world.flags.world_group_advanced",
        "eq": true
      },
      {
        "path": "competition.world.top16Locked",
        "eq": true
      },
      {
        "path": "competition.world.groupStage.resolved",
        "eq": true
      }
    ]
  },
  "nodes": {
    "bracket_entry": {
      "stitches": [
        {
          "id": "s1",
          "text": "Le classifiche dei gironi sono state archiviate. Sul tabellone si preparano gli otto incontri degli ottavi, con i sedici allenatori rimasti."
        }
      ],
      "choices": [
        {
          "id": "entry_rules",
          "text": "Controllo le regole dell'eliminazione diretta.",
          "goto": "bracket_rules"
        },
        {
          "id": "entry_source",
          "text": "Verifico da dove arrivano gli incroci.",
          "goto": "pairing_source"
        },
        {
          "id": "entry_top16",
          "text": "Audito i sedici qualificati prima del lock.",
          "goto": "top16_audit"
        }
      ]
    },
    "bracket_rules": {
      "stitches": [
        {
          "id": "s1",
          "text": "Un ufficiale ricorda che ogni incontro sarà a eliminazione diretta. Chi perde non potrà chiedere un'altra partita nello stesso turno."
        }
      ],
      "choices": [
        {
          "id": "rules_pairing",
          "text": "Studio la logica degli incroci.",
          "goto": "adjacent_groups"
        },
        {
          "id": "rules_integrity",
          "text": "Controllo i vincoli di integrità.",
          "goto": "integrity"
        }
      ]
    },
    "pairing_source": {
      "stitches": [
        {
          "id": "s1",
          "text": "Gli incroci dipendono dalle posizioni guadagnate nei gironi. Nessuno può scegliere un avversario più comodo."
        }
      ],
      "choices": [
        {
          "id": "source_groups",
          "text": "Vedo come si incrociano i gruppi adiacenti.",
          "goto": "adjacent_groups"
        },
        {
          "id": "source_player",
          "text": "Cerco il mio slot nel bracket.",
          "goto": "player_slot"
        }
      ]
    },
    "top16_audit": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il personale controlla che ognuno dei sedici qualificati abbia gruppo e piazzamento verificabili."
        }
      ],
      "choices": [
        {
          "id": "audit_player",
          "text": "Controllo che il player compaia una sola volta.",
          "goto": "player_slot"
        },
        {
          "id": "audit_integrity",
          "text": "Passo all'audit finale.",
          "goto": "integrity"
        }
      ]
    },
    "adjacent_groups": {
      "stitches": [
        {
          "id": "s1",
          "text": "La bacheca illustra il sistema degli incroci: il primo del Gruppo A affronta il secondo del B, e così via per le altre coppie di gruppi."
        }
      ],
      "choices": [
        {
          "id": "groups_slot",
          "text": "Applico lo schema al mio slot reale.",
          "goto": "player_slot"
        },
        {
          "id": "groups_schedule",
          "text": "Guardo l'ordine operativo degli ottavi.",
          "goto": "schedule"
        }
      ]
    },
    "player_slot": {
      "stitches": [
        {
          "id": "s1",
          "text": "Cerchi il tuo nome fra gli otto incontri. Occupa un solo spazio, accanto al prossimo avversario."
        }
      ],
      "choices": [
        {
          "id": "slot_opponent",
          "text": "Apro la scheda dell'avversario derivato.",
          "goto": "opponent_card"
        },
        {
          "id": "slot_friend",
          "text": "Controllo la policy sugli amici ancora vivi.",
          "goto": "friend_policy"
        }
      ]
    },
    "opponent_card": {
      "stitches": [
        {
          "id": "s1",
          "text": "L'addetto prepara la scheda del tuo incontro dopo che gli incroci sono stati confermati. Soltanto allora il nome diventa ufficiale."
        }
      ],
      "choices": [
        {
          "id": "opponent_callback",
          "text": "Controllo eventuali precedenti senza cambiare pairing.",
          "goto": "callback"
        },
        {
          "id": "opponent_commit",
          "text": "Vado verso il passaggio conclusivo del bracket.",
          "goto": "commit_guard"
        }
      ]
    },
    "callback": {
      "stitches": [
        {
          "id": "s1",
          "text": "Un vecchio amico o rivale può reagire quando il tabellone vi avvicina. Il sistema di incroci non cambia per il vostro rapporto."
        }
      ],
      "choices": [
        {
          "id": "callback_friend",
          "text": "Rileggo il caso di un amico.",
          "goto": "friend_policy"
        },
        {
          "id": "callback_anchor",
          "text": "Rileggo il caso di un Anchor.",
          "goto": "anchor_policy"
        }
      ]
    },
    "friend_policy": {
      "stitches": [
        {
          "id": "s1",
          "text": "Se un amico è ancora fra i sedici, ha un posto conquistato sul campo. Vi affronterete soltanto se le classifiche hanno creato davvero quella coppia."
        }
      ],
      "choices": [
        {
          "id": "friend_anchor",
          "text": "Controllo anche gli Anchor.",
          "goto": "anchor_policy"
        },
        {
          "id": "friend_schedule",
          "text": "Passo alla timeline degli ottavi.",
          "goto": "schedule"
        }
      ]
    },
    "anchor_policy": {
      "stitches": [
        {
          "id": "s1",
          "text": "Cerchi Silas, Rei, Astrid e Kaia. Possono essere presenti o assenti secondo il loro risultato nei gironi, non per la fama."
        }
      ],
      "choices": [
        {
          "id": "anchor_schedule",
          "text": "Controllo la plausibilità del venue.",
          "goto": "schedule"
        },
        {
          "id": "anchor_integrity",
          "text": "Verifico che non esista plot armor nel lock.",
          "goto": "integrity"
        }
      ]
    },
    "schedule": {
      "stitches": [
        {
          "id": "s1",
          "text": "Gli otto incontri ricevono orari precisi. Puoi aspettare e prepararti, ma il tuo posto sul tabellone non cambia."
        }
      ],
      "choices": [
        {
          "id": "schedule_integrity",
          "text": "Controllo cosa resta immutabile.",
          "goto": "integrity"
        },
        {
          "id": "schedule_commit",
          "text": "Passo al passaggio conclusivo.",
          "goto": "commit_guard"
        }
      ]
    },
    "integrity": {
      "stitches": [
        {
          "id": "s1",
          "text": "La commissione confronta elenco e classifica prima di affiggere il programma. Non deve comparire due volte lo stesso allenatore."
        }
      ],
      "choices": [
        {
          "id": "integrity_source",
          "text": "Rivedo la source of truth.",
          "goto": "pairing_source"
        },
        {
          "id": "integrity_commit",
          "text": "Procedo al passaggio conclusivo.",
          "goto": "commit_guard"
        }
      ]
    },
    "commit_guard": {
      "stitches": [
        {
          "id": "s1",
          "text": "Con i documenti verificati, l'organizzazione può rendere definitivi gli otto accoppiamenti. Nessuna partita viene giocata durante questa operazione."
        }
      ],
      "choices": [
        {
          "id": "commit_open",
          "text": "Locko il bracket R16 da E5.",
          "goto": "bracket_locked",
          "conditions": {
            "path": "competition.world.knockout.opened",
            "ne": true
          },
          "effects": [
            {
              "type": "set_flag",
              "key": "m10_active",
              "value": true
            },
            {
              "type": "competition_world_r16_open",
              "eventId": "WORLD_R16"
            },
            {
              "type": "set_flag",
              "key": "m10_r16_bracket_complete",
              "value": true
            }
          ]
        },
        {
          "id": "commit_existing",
          "text": "Il bracket è già lockato: leggo lo conseguenze delle scelte.",
          "goto": "bracket_locked",
          "conditions": {
            "path": "competition.world.knockout.opened",
            "eq": true
          },
          "effects": [
            {
              "type": "set_flag",
              "key": "m10_r16_bracket_complete",
              "value": true
            }
          ]
        },
        {
          "id": "commit_review",
          "text": "Prima rivedo l'audit Top16.",
          "goto": "top16_audit"
        }
      ]
    },
    "bracket_locked": {
      "stitches": [
        {
          "id": "s1",
          "text": "Gli ottavi sono annunciati. Il tuo avversario sarà {{competition.world.knockout.playerR16Opponent.name}}."
        }
      ],
      "choices": [
        {
          "id": "locked_handoff",
          "text": "Passo al thread di Silas senza cambiare il bracket.",
          "goto": "handoff"
        },
        {
          "id": "locked_opponent",
          "text": "Rileggo la scheda dell'avversario reale.",
          "goto": "opponent_card"
        }
      ]
    },
    "handoff": {
      "stitches": [
        {
          "id": "s1",
          "text": "Lasci il tabellone. Potresti incrociare Silas nei corridoi, ma soltanto se è ancora in gara e si trova davvero nel complesso."
        }
      ],
      "choices": [
        {
          "id": "handoff_silas",
          "text": "Apro il thread di Silas.",
          "goto": "m10-silas-thread#silas_entry"
        },
        {
          "id": "handoff_review",
          "text": "Rivedo il bracket lockato.",
          "goto": "bracket_locked"
        }
      ]
    }
  }
}
