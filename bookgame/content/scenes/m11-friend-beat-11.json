{
  "schemaVersion": 1,
  "id": "m11-friend-beat-11",
  "moduleId": "M11",
  "title": "M11_05 — Friend Beat 11",
  "locationId": "world_knockout_hall",
  "entryNodeId": "friend_entry",
  "conditions": {
    "all": [
      {
        "path": "world.flags.m11_other_sf_complete",
        "eq": true
      },
      {
        "path": "competition.world.knockout.sfResolved",
        "eq": true
      },
      {
        "path": "competition.world.knockout.finalistsLocked",
        "eq": true
      }
    ]
  },
  "nodes": {
    "friend_entry": {
      "stitches": [
        {
          "id": "s1",
          "text": "Dopo le semifinali controlli il telefono. Tra messaggi, risultati e voci del torneo c'è una persona che conosci da prima dei grandi stadi. Non sai ancora se riuscirete a vedervi oppure a parlarvi soltanto a distanza."
        }
      ],
      "choices": [
        {
          "id": "friend_entry_next",
          "text": "Proseguo.",
          "goto": "selector"
        },
        {
          "id": "friend_entry_alt",
          "text": "Approfondisco.",
          "goto": "selected"
        }
      ]
    },
    "selector": {
      "stitches": [
        {
          "id": "s1",
          "text": "Sul display compare un nome familiare: un amico di lunga data. La vostra ultima conversazione è ancora lì, sopra il nuovo messaggio. Le vostre carriere non sono arrivate necessariamente allo stesso punto."
        }
      ],
      "choices": [
        {
          "id": "select_now",
          "text": "Locko FRIEND_BEAT_11 dalla situazione reale.",
          "goto": "selected",
          "conditions": {
            "path": "world.flags.friend_beat_11_available",
            "ne": true
          },
          "effects": [
            {
              "type": "friend_beat_world_select",
              "previousFriendFlag": "friend_beat_10_friend_id",
              "outputPrefix": "friend_beat_11",
              "stage": "final_four"
            }
          ]
        },
        {
          "id": "select_existing",
          "text": "Uso la selezione persistente.",
          "goto": "selected",
          "conditions": {
            "path": "world.flags.friend_beat_11_available",
            "eq": true
          }
        }
      ]
    },
    "selected": {
      "stitches": [
        {
          "id": "s1",
          "text": "un amico di lunga data ti raggiunge attraverso il canale possibile in questo momento. Non è una convocazione per una fotografia: uno di voi potrebbe avere ancora una finale davanti e l'altro no."
        }
      ],
      "choices": [
        {
          "id": "selected_physical",
          "text": "Seguendo lo schedule reale, lo raggiungo.",
          "goto": "schedule_gate",
          "conditions": {
            "path": "world.flags.friend_beat_11_contact_mode",
            "eq": "physical"
          }
        },
        {
          "id": "selected_remote",
          "text": "Uso il contatto remoto.",
          "goto": "remote_contact",
          "conditions": {
            "path": "world.flags.friend_beat_11_contact_mode",
            "eq": "remote"
          }
        }
      ]
    },
    "context": {
      "stitches": [
        {
          "id": "s1",
          "text": "Le prime parole non riguardano i premi. C'è chi ha ancora un avversario da affrontare e chi deve fare i conti con un'eliminazione; l'amicizia non cancella la differenza."
        }
      ],
      "choices": [
        {
          "id": "context_next",
          "text": "Proseguo.",
          "goto": "finalist_context"
        },
        {
          "id": "context_alt",
          "text": "Approfondisco.",
          "goto": "eliminated_context"
        }
      ]
    },
    "finalist_context": {
      "stitches": [
        {
          "id": "s1",
          "text": "Un amico che è arrivato in finale non ha bisogno che tu lo chiami predestinato. Ti basta ripensare a quanto ha rischiato per essere ancora lì."
        }
      ],
      "choices": [
        {
          "id": "finalist_context_next",
          "text": "Proseguo.",
          "goto": "eliminated_context"
        },
        {
          "id": "finalist_context_alt",
          "text": "Approfondisco.",
          "goto": "final_opponent_context"
        }
      ]
    },
    "eliminated_context": {
      "stitches": [
        {
          "id": "s1",
          "text": "Se l'amico è stato eliminato, la sua voce non finge che il torneo sia andato diversamente. Può scherzarci sopra o preferire una risposta asciutta; il verdetto resta sul tabellone."
        }
      ],
      "choices": [
        {
          "id": "eliminated_context_next",
          "text": "Proseguo.",
          "goto": "final_opponent_context"
        },
        {
          "id": "eliminated_context_alt",
          "text": "Approfondisco.",
          "goto": "schedule_gate"
        }
      ]
    },
    "final_opponent_context": {
      "stitches": [
        {
          "id": "s1",
          "text": "Se dovrete affrontarvi nella finale, potete ancora prendervi in giro come ai tempi delle prime strade. Nessuno dei due, però, potrà chiedere all'altro di regalare un turno."
        }
      ],
      "choices": [
        {
          "id": "final_opponent_context_next",
          "text": "Proseguo.",
          "goto": "schedule_gate"
        },
        {
          "id": "final_opponent_context_alt",
          "text": "Approfondisco.",
          "goto": "physical_contact"
        }
      ]
    },
    "schedule_gate": {
      "stitches": [
        {
          "id": "s1",
          "text": "Controlli dove si trova davvero l'amico. Se è lontano, non puoi trasformare un messaggio in una stretta di mano."
        }
      ],
      "choices": [
        {
          "id": "schedule_physical",
          "text": "Apro il contatto fisico reale.",
          "goto": "physical_contact",
          "conditions": {
            "path": "world.flags.friend_beat_11_contact_mode",
            "eq": "physical"
          }
        },
        {
          "id": "schedule_remote",
          "text": "Resto sul contatto remoto.",
          "goto": "remote_contact",
          "conditions": {
            "path": "world.flags.friend_beat_11_contact_mode",
            "eq": "remote"
          }
        }
      ]
    },
    "physical_contact": {
      "stitches": [
        {
          "id": "s1",
          "text": "Lo incontri in un punto di passaggio, lontano dalle telecamere. La presenza dell'altro rende più facili le battute e più difficili certe domande."
        }
      ],
      "choices": [
        {
          "id": "physical_luke",
          "text": "Parlo con Luke.",
          "goto": "contact_after",
          "conditions": {
            "path": "world.flags.friend_beat_11_friend_id",
            "eq": "Luke"
          },
          "effects": [
            {
              "type": "npc_relationship_adjust",
              "npcId": "Luke",
              "delta": 1
            },
            {
              "type": "set_flag",
              "key": "friend_beat_11_type",
              "value": "physical_final_four_contact"
            },
            {
              "type": "set_flag",
              "key": "friend_beat_11_result",
              "value": "direct_exchange"
            }
          ]
        },
        {
          "id": "physical_mattew",
          "text": "Parlo con Mattew.",
          "goto": "contact_after",
          "conditions": {
            "path": "world.flags.friend_beat_11_friend_id",
            "eq": "Mattew"
          },
          "effects": [
            {
              "type": "npc_relationship_adjust",
              "npcId": "Mattew",
              "delta": 1
            },
            {
              "type": "set_flag",
              "key": "friend_beat_11_type",
              "value": "physical_final_four_contact"
            },
            {
              "type": "set_flag",
              "key": "friend_beat_11_result",
              "value": "direct_exchange"
            }
          ]
        },
        {
          "id": "physical_daniel",
          "text": "Parlo con Daniel.",
          "goto": "contact_after",
          "conditions": {
            "path": "world.flags.friend_beat_11_friend_id",
            "eq": "Daniel"
          },
          "effects": [
            {
              "type": "npc_relationship_adjust",
              "npcId": "Daniel",
              "delta": 1
            },
            {
              "type": "set_flag",
              "key": "friend_beat_11_type",
              "value": "physical_final_four_contact"
            },
            {
              "type": "set_flag",
              "key": "friend_beat_11_result",
              "value": "direct_exchange"
            }
          ]
        },
        {
          "id": "physical_edward",
          "text": "Parlo con Edward.",
          "goto": "contact_after",
          "conditions": {
            "path": "world.flags.friend_beat_11_friend_id",
            "eq": "Edward"
          },
          "effects": [
            {
              "type": "npc_relationship_adjust",
              "npcId": "Edward",
              "delta": 1
            },
            {
              "type": "set_flag",
              "key": "friend_beat_11_type",
              "value": "physical_final_four_contact"
            },
            {
              "type": "set_flag",
              "key": "friend_beat_11_result",
              "value": "direct_exchange"
            }
          ]
        },
        {
          "id": "physical_fab",
          "text": "Parlo con Fab.",
          "goto": "contact_after",
          "conditions": {
            "path": "world.flags.friend_beat_11_friend_id",
            "eq": "Fab"
          },
          "effects": [
            {
              "type": "npc_relationship_adjust",
              "npcId": "Fab",
              "delta": 1
            },
            {
              "type": "set_flag",
              "key": "friend_beat_11_type",
              "value": "physical_final_four_contact"
            },
            {
              "type": "set_flag",
              "key": "friend_beat_11_result",
              "value": "direct_exchange"
            }
          ]
        }
      ]
    },
    "remote_contact": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il collegamento ha un lieve ritardo. Ogni tanto dietro la voce senti i rumori di un altro luogo: non siete stati insieme per tutto questo viaggio."
        }
      ],
      "choices": [
        {
          "id": "remote_accept",
          "text": "Accetto il contatto remoto.",
          "goto": "contact_after",
          "effects": [
            {
              "type": "set_flag",
              "key": "friend_beat_11_type",
              "value": "remote_final_four_contact"
            },
            {
              "type": "set_flag",
              "key": "friend_beat_11_result",
              "value": "remote_exchange"
            }
          ]
        },
        {
          "id": "remote_context",
          "text": "Rileggo il contesto competitivo.",
          "goto": "context"
        }
      ]
    },
    "contact_after": {
      "stitches": [
        {
          "id": "s1",
          "text": "Quando il contatto si chiude, tornano i rumori del torneo. La conversazione non cancella né la fatica dei Pokémon né quanto è successo sul campo."
        }
      ],
      "choices": [
        {
          "id": "contact_after_next",
          "text": "Proseguo.",
          "goto": "previous_callback"
        },
        {
          "id": "contact_after_alt",
          "text": "Approfondisco.",
          "goto": "relationship"
        }
      ]
    },
    "previous_callback": {
      "stitches": [
        {
          "id": "s1",
          "text": "Vi ricordate un dettaglio dell'ultima volta che vi siete parlati. Può bastare un'allusione per riconoscere gli anni trascorsi senza doverli riassumere."
        }
      ],
      "choices": [
        {
          "id": "previous_callback_next",
          "text": "Proseguo.",
          "goto": "relationship"
        },
        {
          "id": "previous_callback_alt",
          "text": "Approfondisco.",
          "goto": "team_state"
        }
      ]
    },
    "relationship": {
      "stitches": [
        {
          "id": "s1",
          "text": "Se c'è fiducia, certe provocazioni suonano come una forma di incoraggiamento. Se qualcosa è rimasto irrisolto, le stesse parole possono pesare in modo diverso."
        }
      ],
      "choices": [
        {
          "id": "relationship_next",
          "text": "Proseguo.",
          "goto": "team_state"
        },
        {
          "id": "relationship_alt",
          "text": "Approfondisco.",
          "goto": "pressure"
        }
      ]
    },
    "team_state": {
      "stitches": [
        {
          "id": "s1",
          "text": "Accanto a te i Pokémon aspettano. Anche loro hanno affrontato la semifinale; una telefonata non restituisce le energie spese."
        }
      ],
      "choices": [
        {
          "id": "team_state_next",
          "text": "Proseguo.",
          "goto": "pressure"
        },
        {
          "id": "team_state_alt",
          "text": "Approfondisco.",
          "goto": "result_independence"
        }
      ]
    },
    "pressure": {
      "stitches": [
        {
          "id": "s1",
          "text": "L'amico ti conosce abbastanza da non scambiare una provocazione per una dichiarazione di guerra. Sarete amici anche se uno dei due dovrà fermarsi qui."
        }
      ],
      "choices": [
        {
          "id": "pressure_next",
          "text": "Proseguo.",
          "goto": "result_independence"
        },
        {
          "id": "pressure_alt",
          "text": "Approfondisco.",
          "goto": "route_meaning"
        }
      ]
    },
    "result_independence": {
      "stitches": [
        {
          "id": "s1",
          "text": "Le parole finiscono; la finale si giocherà sul campo, non durante questa chiamata."
        }
      ],
      "choices": [
        {
          "id": "result_independence_next",
          "text": "Proseguo.",
          "goto": "route_meaning"
        },
        {
          "id": "result_independence_alt",
          "text": "Approfondisco.",
          "goto": "commitment"
        }
      ]
    },
    "route_meaning": {
      "stitches": [
        {
          "id": "s1",
          "text": "Se ti aspetta ancora la finale, puoi tornare alla preparazione. Se sei stato eliminato, puoi seguire il torneo senza fingere di esserne ancora parte."
        }
      ],
      "choices": [
        {
          "id": "route_meaning_next",
          "text": "Proseguo.",
          "goto": "commitment"
        },
        {
          "id": "route_meaning_alt",
          "text": "Approfondisco.",
          "goto": "branch_gate"
        }
      ]
    },
    "commitment": {
      "stitches": [
        {
          "id": "s1",
          "text": "Prima di salutarvi chiarite quando potrete sentirvi di nuovo. Non promettete di essere nello stesso posto se le vostre strade non lo consentono."
        }
      ],
      "choices": [
        {
          "id": "commit_now",
          "text": "Chiudo FRIEND_BEAT_11.",
          "goto": "complete",
          "effects": [
            {
              "type": "set_flag",
              "key": "friend_beat_11_complete",
              "value": true
            },
            {
              "type": "set_flag",
              "key": "m11_friend_beat_11_complete",
              "value": true
            }
          ],
          "conditions": {
            "all": [
              {
                "path": "world.flags.friend_beat_11_friend_id",
                "exists": true
              },
              {
                "path": "world.flags.friend_beat_11_contact_mode",
                "exists": true
              },
              {
                "path": "world.flags.friend_beat_11_type",
                "exists": true
              },
              {
                "path": "world.flags.friend_beat_11_result",
                "exists": true
              }
            ]
          }
        },
        {
          "id": "commit_review",
          "text": "Rivedo il significato del percorso.",
          "goto": "route_meaning"
        }
      ]
    },
    "branch_gate": {
      "stitches": [
        {
          "id": "s1",
          "text": "Finito il contatto, la segnaletica conduce i finalisti alla preparazione dell'ultima partita e gli altri verso le uscite del torneo."
        }
      ],
      "choices": [
        {
          "id": "branch_final",
          "text": "Sono finalista: passo alla preparazione.",
          "goto": "m11-final-prep#prep_entry",
          "conditions": {
            "all": [
              {
                "path": "competition.world.knockout.playerAdvancedToFinal",
                "eq": true
              },
              {
                "path": "world.flags.world_eliminated",
                "ne": true
              }
            ]
          }
        },
        {
          "id": "branch_exit",
          "text": "Sono eliminato: passo all'esito.",
          "goto": "m11-championship-outcome#outcome_entry",
          "conditions": {
            "path": "world.flags.world_eliminated",
            "eq": true
          }
        },
        {
          "id": "branch_review",
          "text": "Rileggo lo stato.",
          "goto": "context"
        }
      ]
    },
    "complete": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il telefono torna silenzioso. Il risultato resta quello reale, ma tra voi c'è ancora qualcosa da raccontare."
        }
      ],
      "choices": [
        {
          "id": "complete_route",
          "text": "Passo al ramo successivo.",
          "goto": "branch_gate"
        },
        {
          "id": "complete_review",
          "text": "Rileggo l'indipendenza dei risultati.",
          "goto": "result_independence"
        }
      ]
    }
  }
}
