{
  "schemaVersion": 1,
  "id": "m12-return-asteria",
  "moduleId": "M12",
  "title": "M12_01 — Return Asteria",
  "locationId": "world_village",
  "entryNodeId": "return_entry",
  "conditions": {
    "path": "world.flags.m12_world_exit_branch_complete",
    "eq": true
  },
  "nodes": {
    "return_entry": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il viaggio di ritorno comincia dove si è fermata la tua stagione. Fuori dalla stazione gli allenatori continuano ad andare e venire, ognuno con la propria destinazione."
        }
      ],
      "choices": [
        {
          "id": "continue",
          "text": "Proseguo seguendo questo filo.",
          "goto": "departure"
        },
        {
          "id": "review",
          "text": "Rileggo il passaggio collegato.",
          "goto": "departure"
        },
        {
          "id": "context_1",
          "text": "Confronto questo dettaglio con un altro pezzo del percorso.",
          "goto": "transit_clock"
        }
      ]
    },
    "departure": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il tabellone delle partenze cambia mentre controlli biglietti e bagagli. Per tornare a casa servono trasferimenti e attese vere."
        }
      ],
      "choices": [
        {
          "id": "continue",
          "text": "Proseguo seguendo questo filo.",
          "goto": "transit_clock"
        },
        {
          "id": "review",
          "text": "Rileggo il passaggio collegato.",
          "goto": "return_entry"
        }
      ]
    },
    "transit_clock": {
      "stitches": [
        {
          "id": "s1",
          "text": "Dal finestrino scorrono strade e campi. Il tempo passa anche per chi non viaggia con te: qualcuno termina un turno, qualcun altro parte."
        }
      ],
      "choices": [
        {
          "id": "travel_standard",
          "text": "Affronto il viaggio senza saltare il tempo.",
          "goto": "public_attention",
          "timeCostMinutes": 120
        },
        {
          "id": "travel_quiet",
          "text": "Viaggio in silenzio, lasciando comunque scorrere il calendario.",
          "goto": "team_persistence",
          "timeCostMinutes": 120
        }
      ]
    },
    "public_attention": {
      "stitches": [
        {
          "id": "s1",
          "text": "Fra i passeggeri c'è chi riconosce il tuo volto e chi è troppo occupato per accorgersene. Il tuo risultato non racconta tutto ciò che sanno di te."
        }
      ],
      "choices": [
        {
          "id": "rep_champion",
          "text": "Accetto la visibilità da campione senza cancellare le reputazioni locali.",
          "goto": "team_persistence",
          "conditions": {
            "path": "world.flags.m12_world_exit_route",
            "eq": "world_champion"
          },
          "effects": [
            {
              "type": "set_flag",
              "key": "m12_return_reputation_context",
              "value": "world_champion"
            }
          ]
        },
        {
          "id": "rep_eliminated",
          "text": "Accetto la lettura pubblica della mia eliminazione reale.",
          "goto": "team_persistence",
          "conditions": {
            "path": "world.flags.m12_world_exit_route",
            "eq": "world_eliminated"
          },
          "effects": [
            {
              "type": "set_flag",
              "key": "m12_return_reputation_context",
              "value": "world_eliminated"
            }
          ]
        },
        {
          "id": "rep_missed",
          "text": "Accetto che il Mondiale mancato sia parte della mia stagione, non tutta la mia identità.",
          "goto": "team_persistence",
          "conditions": {
            "path": "world.flags.m12_world_exit_route",
            "eq": "worlds_missed"
          },
          "effects": [
            {
              "type": "set_flag",
              "key": "m12_return_reputation_context",
              "value": "worlds_missed"
            }
          ]
        }
      ]
    },
    "champion_reputation": {
      "stitches": [
        {
          "id": "s1",
          "text": "Alcuni viaggiatori guardano la coppa e ti chiedono della finale. Non sai se, arrivato a casa, gli stessi applausi ti aspettino da chi ricorda altri episodi della tua carriera."
        }
      ],
      "choices": [
        {
          "id": "continue",
          "text": "Proseguo seguendo questo filo.",
          "goto": "eliminated_reputation"
        },
        {
          "id": "review",
          "text": "Rileggo il passaggio collegato.",
          "goto": "public_attention"
        }
      ]
    },
    "eliminated_reputation": {
      "stitches": [
        {
          "id": "s1",
          "text": "Qualcuno cita la partita che ti ha eliminato; altri ricordano piuttosto quanto lontano eri arrivato. Nessuna opinione modifica il risultato."
        }
      ],
      "choices": [
        {
          "id": "continue",
          "text": "Proseguo seguendo questo filo.",
          "goto": "missed_reputation"
        },
        {
          "id": "review",
          "text": "Rileggo il passaggio collegato.",
          "goto": "champion_reputation"
        }
      ]
    },
    "missed_reputation": {
      "stitches": [
        {
          "id": "s1",
          "text": "Sei tornato senza aver giocato il Mondiale. Chi ti conosce come allenatore può avere domande sul perché; i rapporti nati prima della qualificazione non scompaiono."
        }
      ],
      "choices": [
        {
          "id": "continue",
          "text": "Proseguo seguendo questo filo.",
          "goto": "team_persistence"
        },
        {
          "id": "review",
          "text": "Rileggo il passaggio collegato.",
          "goto": "eliminated_reputation"
        }
      ]
    },
    "team_persistence": {
      "stitches": [
        {
          "id": "s1",
          "text": "Nello scompartimento sistemi le Poké Ball con attenzione. Il viaggio da solo non cura una ferita né restituisce le energie consumate in battaglia."
        }
      ],
      "choices": [
        {
          "id": "continue",
          "text": "Proseguo seguendo questo filo.",
          "goto": "world_history"
        },
        {
          "id": "review",
          "text": "Rileggo il passaggio collegato.",
          "goto": "missed_reputation"
        }
      ]
    },
    "world_history": {
      "stitches": [
        {
          "id": "s1",
          "text": "Un notiziario ripropone le immagini dell'ultima edizione mondiale. Il campione rimane quello annunciato sul campo, che tu abbia partecipato o no."
        }
      ],
      "choices": [
        {
          "id": "continue",
          "text": "Proseguo seguendo questo filo.",
          "goto": "horizon"
        },
        {
          "id": "review",
          "text": "Rileggo il passaggio collegato.",
          "goto": "team_persistence"
        }
      ]
    },
    "horizon": {
      "stitches": [
        {
          "id": "s1",
          "text": "Le prime indicazioni per Asteria appaiono lungo la strada. Riconosci i paesaggi, ma non sai ancora che cosa sia cambiato durante la tua assenza."
        }
      ],
      "choices": [
        {
          "id": "continue",
          "text": "Proseguo seguendo questo filo.",
          "goto": "landing"
        },
        {
          "id": "review",
          "text": "Rileggo il passaggio collegato.",
          "goto": "world_history"
        }
      ]
    },
    "landing": {
      "stitches": [
        {
          "id": "s1",
          "text": "Quando arrivi a Valedarsena, il viavai della città ti accoglie senza fermarsi. Da qui puoi ripercorrere luoghi già conosciuti."
        }
      ],
      "choices": [
        {
          "id": "continue",
          "text": "Proseguo seguendo questo filo.",
          "goto": "commit"
        },
        {
          "id": "review",
          "text": "Rileggo il passaggio collegato.",
          "goto": "horizon"
        }
      ]
    },
    "commit": {
      "stitches": [
        {
          "id": "s1",
          "text": "L'addetto controlla il titolo di viaggio e ti lascia passare. Metti piede ad Asteria con la stessa squadra con cui sei partito."
        }
      ],
      "choices": [
        {
          "id": "commit_return",
          "text": "Registro il ritorno ad Asteria.",
          "goto": "return_complete",
          "conditions": {
            "path": "world.flags.m12_return_asteria_complete",
            "ne": true
          },
          "effects": [
            {
              "type": "set_flag",
              "key": "m12_return_asteria_complete",
              "value": true
            },
            {
              "type": "set_location",
              "locationId": "valedarsena_city"
            }
          ]
        },
        {
          "id": "commit_existing",
          "text": "Il ritorno è già registrato.",
          "goto": "return_complete",
          "conditions": {
            "path": "world.flags.m12_return_asteria_complete",
            "eq": true
          }
        }
      ]
    },
    "return_complete": {
      "stitches": [
        {
          "id": "s1",
          "text": "Sei di nuovo a Valedarsena. Il prossimo incontro non sarà una cerimonia: sarà con il mondo che hai lasciato andare avanti."
        }
      ],
      "choices": [
        {
          "id": "to_valedarsena",
          "text": "Entro nei callback di Valedarsena.",
          "goto": "m12-valedarsena-callbacks#callback_entry"
        },
        {
          "id": "review_world_exit",
          "text": "Ripenso a come si è concluso il mio Mondiale.",
          "goto": "world_history"
        }
      ]
    }
  }
}
