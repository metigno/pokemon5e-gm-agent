{
  "schemaVersion": 1,
  "id": "m06-world-cutoff",
  "moduleId": "M06",
  "title": "M6_13 — World Ranking Cutoff",
  "locationId": "far_ruins_gate",
  "entryNodeId": "cutoff_entry",
  "conditions": {
    "all": [
      {
        "path": "world.flags.m5_complete",
        "eq": true
      },
      {
        "path": "world.flags.m06_unlocked",
        "eq": true
      },
      {
        "path": "world.flags.m6_active",
        "eq": true
      },
      {
        "path": "competition.rankOrder",
        "gte": 5
      }
    ]
  },
  "nodes": {
    "cutoff_entry": {
      "stitches": [
        {
          "id": "s1",
          "text": "Nella sala del circuito, il tabellone mondiale mostra la data di chiusura della stagione. Allo scadere, gli addetti archiviano la classifica così com'è: nessun incontro può essere riscritto dopo."
        }
      ],
      "choices": [
        {
          "id": "cutoff_rules",
          "text": "Rileggo cosa viene congelato.",
          "goto": "cutoff_rules"
        },
        {
          "id": "cutoff_status",
          "text": "Il cutoff è già scattato: controllo lo stato.",
          "goto": "current_status",
          "conditions": {
            "path": "world.flags.world_cutoff_state",
            "exists": true
          }
        },
        {
          "id": "cutoff_pending",
          "text": "La deadline non è ancora scattata: controllo cosa posso fare.",
          "goto": "pending",
          "conditions": {
            "path": "world.flags.world_cutoff_state",
            "exists": false
          }
        }
      ]
    },
    "cutoff_rules": {
      "stitches": [
        {
          "id": "s1",
          "text": "Un avviso ufficiale chiarisce che la chiusura fotografa il grado raggiunto entro il termine. Non assegna promozioni né posti automatici al Mondiale."
        }
      ],
      "choices": [
        {
          "id": "rules_status",
          "text": "Controllo il mio stato congelato.",
          "goto": "current_status",
          "conditions": {
            "path": "world.flags.world_cutoff_state",
            "exists": true
          }
        },
        {
          "id": "rules_history",
          "text": "Rivedo i risultati che restano nello storico.",
          "goto": "history_review"
        },
        {
          "id": "rules_season",
          "text": "Rivedo cosa significa per la stagione.",
          "goto": "season_context"
        }
      ]
    },
    "current_status": {
      "stitches": [
        {
          "id": "s1",
          "text": "L'impiegata apre il registro stagionale e controlla quale grado risultava sulla tua licenza alla scadenza. Quella data rimane accanto al tuo nome."
        }
      ],
      "choices": [
        {
          "id": "status_s",
          "text": "Il cutoff mi ha trovato già Rank S.",
          "goto": "rank_s_state",
          "conditions": {
            "path": "world.flags.world_cutoff_state",
            "eq": "rank_s_at_cutoff"
          }
        },
        {
          "id": "status_a",
          "text": "Il cutoff mi ha trovato ancora Rank A.",
          "goto": "rank_a_state",
          "conditions": {
            "path": "world.flags.world_cutoff_state",
            "eq": "rank_a_at_cutoff"
          }
        },
        {
          "id": "status_history",
          "text": "Controllo la history senza cambiarla.",
          "goto": "history_review"
        }
      ]
    },
    "before_cutoff": {
      "stitches": [
        {
          "id": "s1",
          "text": "Nel registro risulti già di grado S alla chiusura della stagione. Puoi affrontare il percorso dei candidati mondiali, ma la qualificazione è ancora da conquistare."
        }
      ],
      "choices": [
        {
          "id": "before_freeze",
          "text": "Registro la lettura del cutoff.",
          "goto": "freeze_confirm"
        },
        {
          "id": "before_continental",
          "text": "Rivedo la Continental come risultato separato.",
          "goto": "continental_review"
        }
      ]
    },
    "after_cutoff": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il registro mostra che alla scadenza avevi ancora il grado A. Anche se la tua licenza cambia più tardi, quella pagina della stagione non verrà riscritta."
        }
      ],
      "choices": [
        {
          "id": "after_freeze",
          "text": "Registro la lettura tardiva del cutoff.",
          "goto": "freeze_confirm"
        },
        {
          "id": "after_masters",
          "text": "Rivedo i Masters come contesto separato.",
          "goto": "masters_review"
        }
      ]
    },
    "rank_s_state": {
      "stitches": [
        {
          "id": "s1",
          "text": "Accanto al tuo nome compare il grado S, con una data anteriore alla chiusura. L'impiegata conferma il dato e richiude il registro."
        }
      ],
      "choices": [
        {
          "id": "rank_s_before",
          "text": "Passo alla conseguenza stagionale.",
          "goto": "before_cutoff"
        },
        {
          "id": "rank_s_friend",
          "text": "Rivedo il Friend Beat che accompagna questa fase.",
          "goto": "friend_review"
        }
      ]
    },
    "rank_a_state": {
      "stitches": [
        {
          "id": "s1",
          "text": "Accanto al tuo nome compare il grado A alla data di chiusura. L'impiegata indica la riga: «Questo era il tuo grado quel giorno»."
        }
      ],
      "choices": [
        {
          "id": "rank_a_after",
          "text": "Passo alla conseguenza stagionale.",
          "goto": "after_cutoff"
        },
        {
          "id": "rank_a_red",
          "text": "Rivedo il confronto con Red.",
          "goto": "red_review"
        }
      ]
    },
    "history_review": {
      "stitches": [
        {
          "id": "s1",
          "text": "I referti Masters, Continental Cup e Faro sono raccolti in fascicoli separati. Puoi rileggerli, ma i risultati rimangono quelli pronunciati dagli arbitri."
        }
      ],
      "choices": [
        {
          "id": "history_masters",
          "text": "Rivedo il Masters Circuit.",
          "goto": "masters_review"
        },
        {
          "id": "history_continental",
          "text": "Rivedo la Continental Cup.",
          "goto": "continental_review"
        }
      ]
    },
    "masters_review": {
      "stitches": [
        {
          "id": "s1",
          "text": "Sul registro Masters trovi l'incontro e il relativo risultato ufficiale. La scadenza stagionale non ne cambia il referto."
        }
      ],
      "choices": [
        {
          "id": "masters_friend",
          "text": "Passo al contesto personale.",
          "goto": "friend_review"
        },
        {
          "id": "masters_history",
          "text": "Torno allo storico complessivo.",
          "goto": "history_review"
        }
      ]
    },
    "continental_review": {
      "stitches": [
        {
          "id": "s1",
          "text": "La bacheca Continental conserva il tuo piazzamento effettivo, qualunque sia stato. Il titolo del torneo non sostituisce la prova del Faro."
        }
      ],
      "choices": [
        {
          "id": "continental_red",
          "text": "Rivedo il principio di adattamento di Red.",
          "goto": "red_review"
        },
        {
          "id": "continental_history",
          "text": "Torno allo storico complessivo.",
          "goto": "history_review"
        }
      ]
    },
    "friend_review": {
      "stitches": [
        {
          "id": "s1",
          "text": "Fra i messaggi conservati trovi anche l'ultimo scambio con un amico. È parte della tua storia, non della classifica mondiale."
        }
      ],
      "choices": [
        {
          "id": "friend_ancient",
          "text": "Ricollego la stagione al secondo layer del mistero.",
          "goto": "ancient_review"
        },
        {
          "id": "friend_red",
          "text": "Rivedo Red come Anchor del modulo.",
          "goto": "red_review"
        }
      ]
    },
    "red_review": {
      "stitches": [
        {
          "id": "s1",
          "text": "Ripensi a Red e alle poche parole scambiate vicino al tabellone. Nessun nome famoso può cambiare la data o il grado riportati sul registro."
        }
      ],
      "choices": [
        {
          "id": "red_ancient",
          "text": "Passo al thread antico.",
          "goto": "ancient_review"
        },
        {
          "id": "red_season",
          "text": "Torno al significato stagionale.",
          "goto": "season_context"
        }
      ]
    },
    "ancient_review": {
      "stitches": [
        {
          "id": "s1",
          "text": "Oltre le finestre si distingue la sagoma del Faro. Le domande sulle sue tracce antiche rimangono aperte, lontane dai conteggi della classifica."
        }
      ],
      "choices": [
        {
          "id": "ancient_season",
          "text": "Torno al significato stagionale.",
          "goto": "season_context"
        },
        {
          "id": "ancient_freeze",
          "text": "Sono pronto a registrare il review del cutoff.",
          "goto": "freeze_confirm"
        }
      ]
    },
    "freeze_confirm": {
      "stitches": [
        {
          "id": "s1",
          "text": "L'impiegata ti mostra il registro ormai chiuso. «Puoi consultarlo, ma non modificarlo. La stagione è stata archiviata»."
        }
      ],
      "choices": [
        {
          "id": "freeze_record",
          "text": "Registro il review del cutoff.",
          "goto": "freeze_record",
          "conditions": {
            "path": "world.flags.world_cutoff_state",
            "exists": true
          }
        },
        {
          "id": "freeze_rules",
          "text": "Rileggo le regole prima di chiudere.",
          "goto": "cutoff_rules"
        },
        {
          "id": "freeze_season",
          "text": "Rivedo le conseguenze stagionali.",
          "goto": "season_context"
        }
      ]
    },
    "freeze_record": {
      "stitches": [
        {
          "id": "s1",
          "text": "La pagina della stagione viene riposta nell'archivio. Il grado segnato alla scadenza resta quello che era."
        }
      ],
      "choices": [
        {
          "id": "record_gate",
          "text": "Verifico il gate di chiusura M6.",
          "goto": "module_gate",
          "effects": [
            {
              "type": "set_flag",
              "key": "m6_world_cutoff_review_complete",
              "value": true
            }
          ]
        },
        {
          "id": "record_status",
          "text": "Rileggo il record congelato.",
          "goto": "current_status"
        }
      ]
    },
    "pending": {
      "stitches": [
        {
          "id": "s1",
          "text": "L'orologio non ha ancora raggiunto la chiusura. Puoi aspettare che arrivi il termine oppure dedicarti agli impegni ancora aperti."
        }
      ],
      "choices": [
        {
          "id": "pending_wait",
          "text": "Aspetto sei ore e ricontrollo.",
          "goto": "cutoff_entry",
          "timeCostMinutes": 360
        },
        {
          "id": "pending_return",
          "text": "Torno alle Rovine senza forzare la deadline.",
          "goto": "m06-first-lighthouse-return#ruins_boundary"
        }
      ]
    },
    "season_context": {
      "stitches": [
        {
          "id": "s1",
          "text": "Le pagine della stagione vengono ordinate per data. Quando arriveranno le nuove qualificazioni, conterà anche ciò che avevi raggiunto prima di questa chiusura."
        }
      ],
      "choices": [
        {
          "id": "season_freeze",
          "text": "Torno alla registrazione del review.",
          "goto": "freeze_confirm"
        },
        {
          "id": "season_rules",
          "text": "Rileggo la regola di freeze.",
          "goto": "cutoff_rules"
        }
      ]
    },
    "module_gate": {
      "stitches": [
        {
          "id": "s1",
          "text": "L'addetta controlla i documenti del tuo percorso: licenza S, incontro con Red, notizie degli amici, indizi del Faro e registro stagionale. Se manca qualcosa, ti indica dove tornare."
        }
      ],
      "choices": [
        {
          "id": "gate_close",
          "text": "Tutti i requisiti sono presenti: passo all'outcome.",
          "goto": "close",
          "conditions": {
            "all": [
              {
                "path": "competition.rank",
                "eq": "S"
              },
              {
                "path": "world.flags.red_met",
                "eq": true
              },
              {
                "path": "world.flags.friend_beat_06_complete",
                "eq": true
              },
              {
                "path": "world.flags.ancient_mystery_layer_2",
                "exists": true
              },
              {
                "path": "world.flags.m6_world_cutoff_review_complete",
                "eq": true
              }
            ]
          }
        },
        {
          "id": "gate_status",
          "text": "Rivedo lo stato del cutoff.",
          "goto": "current_status"
        }
      ]
    },
    "close": {
      "stitches": [
        {
          "id": "s1",
          "text": "Esci dall'ufficio mentre gli addetti spengono i monitor della stagione conclusa. Davanti a te restano le gare future, non un modo per cambiare quelle passate."
        }
      ],
      "choices": [
        {
          "id": "close_outcome",
          "text": "Passo al riepilogo finale di M6.",
          "goto": "m06-module-outcome#outcome_entry"
        },
        {
          "id": "close_ruins",
          "text": "Resto al Primo Faro prima di chiudere.",
          "goto": "m06-first-lighthouse-return#ruins_boundary"
        }
      ]
    }
  }
}
