{
  "schemaVersion": 1,
  "id": "m11-championship-outcome",
  "moduleId": "M11",
  "title": "M11_08 — Championship Outcome",
  "locationId": "world_knockout_hall",
  "entryNodeId": "outcome_entry",
  "conditions": {
    "all": [
      {
        "path": "world.flags.m11_friend_beat_11_complete",
        "eq": true
      },
      {
        "any": [
          {
            "all": [
              {
                "path": "competition.world.knockout.playerAdvancedToFinal",
                "eq": true
              },
              {
                "path": "competition.world.knockout.finalResolved",
                "eq": true
              },
              {
                "path": "world.flags.m11_world_final_complete",
                "eq": true
              }
            ]
          },
          {
            "all": [
              {
                "path": "competition.world.knockout.playerAdvancedToFinal",
                "ne": true
              },
              {
                "path": "world.flags.world_eliminated",
                "eq": true
              }
            ]
          }
        ]
      }
    ]
  },
  "nodes": {
    "outcome_entry": {
      "stitches": [
        {
          "id": "s1",
          "text": "Dopo l'ultima partita, il personale prepara tre percorsi diversi: chi ha vinto la coppa, chi ha perso la finale e chi ha visto sfumare il sogno in semifinale. Il tuo è quello scritto dai risultati, non dalle aspettative."
        }
      ],
      "choices": [
        {
          "id": "entry_resolve",
          "text": "Controllo la risoluzione della finale.",
          "goto": "final_resolution"
        },
        {
          "id": "entry_champion",
          "text": "Audito il ramo campione.",
          "goto": "champion_audit"
        },
        {
          "id": "entry_exit",
          "text": "Ripercorro la fine del mio percorso mondiale.",
          "goto": "world_exit_rules"
        }
      ]
    },
    "final_resolution": {
      "stitches": [
        {
          "id": "s1",
          "text": "Se la tua corsa è terminata in semifinale, l'arena non si è fermata con te. Gli altri due finalisti disputano comunque il loro incontro; il nome del campione arriverà dal campo."
        }
      ],
      "choices": [
        {
          "id": "resolve_offscreen",
          "text": "E5 risolve la finale senza il player.",
          "goto": "sf_eliminated_audit",
          "conditions": {
            "all": [
              {
                "path": "competition.world.knockout.playerAdvancedToFinal",
                "ne": true
              },
              {
                "path": "competition.world.knockout.finalResolved",
                "ne": true
              }
            ]
          },
          "effects": [
            {
              "type": "competition_world_final_resolve",
              "eventId": "WORLD_FINAL_RESOLVE"
            }
          ]
        },
        {
          "id": "resolve_existing",
          "text": "La finale è già risolta.",
          "goto": "history",
          "conditions": {
            "path": "competition.world.knockout.finalResolved",
            "eq": true
          }
        }
      ]
    },
    "champion_audit": {
      "stitches": [
        {
          "id": "s1",
          "text": "Se hai vinto la finale, il tuo nome compare nell'albo d'oro di questa edizione. Il titolo deriva dall'ultima partita, non dai pronostici o dagli applausi."
        }
      ],
      "choices": [
        {
          "id": "champion_audit_next",
          "text": "Proseguo.",
          "goto": "runnerup_audit"
        },
        {
          "id": "champion_audit_alt",
          "text": "Approfondisco.",
          "goto": "sf_eliminated_audit"
        }
      ]
    },
    "runnerup_audit": {
      "stitches": [
        {
          "id": "s1",
          "text": "Se hai disputato la finale e l'hai persa, il tabellone ti registra come secondo classificato. Alcuni ricorderanno il percorso fino a qui, altri parleranno dell'ultimo incontro: nessuna reazione modifica il verdetto."
        }
      ],
      "choices": [
        {
          "id": "runnerup_audit_next",
          "text": "Proseguo.",
          "goto": "sf_eliminated_audit"
        },
        {
          "id": "runnerup_audit_alt",
          "text": "Approfondisco.",
          "goto": "history"
        }
      ]
    },
    "sf_eliminated_audit": {
      "stitches": [
        {
          "id": "s1",
          "text": "Se la tua corsa si è fermata in semifinale, puoi seguire la finale soltanto da fuori. Gli altri allenatori continueranno senza reinserirti nel tabellone."
        }
      ],
      "choices": [
        {
          "id": "sf_eliminated_audit_next",
          "text": "Proseguo.",
          "goto": "history"
        },
        {
          "id": "sf_eliminated_audit_alt",
          "text": "Approfondisco.",
          "goto": "friend_closure"
        }
      ]
    },
    "history": {
      "stitches": [
        {
          "id": "s1",
          "text": "Sfogli il riepilogo ufficiale: gli incontri a cui hai partecipato portano il tuo nome. Le altre partite appartengono a chi le ha giocate."
        }
      ],
      "choices": [
        {
          "id": "history_next",
          "text": "Proseguo.",
          "goto": "friend_closure"
        },
        {
          "id": "history_alt",
          "text": "Approfondisco.",
          "goto": "resource_state"
        }
      ]
    },
    "friend_closure": {
      "stitches": [
        {
          "id": "s1",
          "text": "Prima di partire rimane un ultimo contatto con gli amici. Non tutti hanno avuto lo stesso cammino e non tutti possono trovarsi qui: ciò che vi direte deve fare i conti con entrambe le cose."
        }
      ],
      "choices": [
        {
          "id": "friend_closure_next",
          "text": "Proseguo.",
          "goto": "resource_state"
        },
        {
          "id": "friend_closure_alt",
          "text": "Approfondisco.",
          "goto": "world_exit_rules"
        }
      ]
    },
    "resource_state": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il personale offre indicazioni sui servizi disponibili, ma non promette di cancellare con una cerimonia la fatica dei Pokémon."
        }
      ],
      "choices": [
        {
          "id": "resource_state_next",
          "text": "Proseguo.",
          "goto": "world_exit_rules"
        },
        {
          "id": "resource_state_alt",
          "text": "Approfondisco.",
          "goto": "champion_route"
        }
      ]
    },
    "world_exit_rules": {
      "stitches": [
        {
          "id": "s1",
          "text": "Solo dopo che il torneo ha un campione ufficiale l'organizzazione apre i passaggi per il rientro degli allenatori."
        }
      ],
      "choices": [
        {
          "id": "world_exit_rules_next",
          "text": "Proseguo.",
          "goto": "champion_route"
        },
        {
          "id": "world_exit_rules_alt",
          "text": "Approfondisco.",
          "goto": "runnerup_route"
        }
      ]
    },
    "champion_route": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il campione di questa edizione vede il proprio nome inciso sulla coppa. Se quel nome è il tuo, le reazioni degli spalti e delle persone incontrate lungo la carriera non devono per forza essere uguali."
        }
      ],
      "choices": [
        {
          "id": "champion_route_next",
          "text": "Proseguo.",
          "goto": "runnerup_route"
        },
        {
          "id": "champion_route_alt",
          "text": "Approfondisco.",
          "goto": "sf_eliminated_route"
        }
      ]
    },
    "runnerup_route": {
      "stitches": [
        {
          "id": "s1",
          "text": "Chi termina al secondo posto sale sul podio senza il titolo. Se è il tuo piazzamento, puoi decidere cosa portare con te di questa notte, senza cambiare il risultato."
        }
      ],
      "choices": [
        {
          "id": "runnerup_route_next",
          "text": "Proseguo.",
          "goto": "sf_eliminated_route"
        },
        {
          "id": "runnerup_route_alt",
          "text": "Approfondisco.",
          "goto": "commit_guard"
        }
      ]
    },
    "sf_eliminated_route": {
      "stitches": [
        {
          "id": "s1",
          "text": "Chi è uscito in semifinale apprende comunque il nome del nuovo campione. Se è il tuo caso, la notizia non cancella la partita in cui sei stato eliminato."
        }
      ],
      "choices": [
        {
          "id": "sf_eliminated_route_next",
          "text": "Proseguo.",
          "goto": "commit_guard"
        },
        {
          "id": "sf_eliminated_route_alt",
          "text": "Approfondisco.",
          "goto": "committed"
        }
      ]
    },
    "commit_guard": {
      "stitches": [
        {
          "id": "s1",
          "text": "L'addetto consegna i documenti per lasciare il torneo. I risultati sono già firmati; il viaggio di ritorno non li cambierà."
        }
      ],
      "choices": [
        {
          "id": "commit_champion",
          "text": "Chiudo M11 come World Champion.",
          "goto": "committed",
          "conditions": {
            "all": [
              {
                "path": "competition.world.knockout.finalResolved",
                "eq": true
              },
              {
                "path": "competition.world.knockout.playerWonFinal",
                "eq": true
              }
            ]
          },
          "effects": [
            {
              "type": "set_flag",
              "key": "m11_outcome_route",
              "value": "world_champion"
            },
            {
              "type": "set_flag",
              "key": "m11_complete",
              "value": true
            },
            {
              "type": "set_flag",
              "key": "m11_championship_outcome_complete",
              "value": true
            },
            {
              "type": "set_flag",
              "key": "world_exit_available",
              "value": true
            },
            {
              "type": "set_flag",
              "key": "m12_unlocked",
              "value": true
            }
          ]
        },
        {
          "id": "commit_runnerup",
          "text": "Chiudo M11 come World runner-up.",
          "goto": "committed",
          "conditions": {
            "all": [
              {
                "path": "competition.world.knockout.finalResolved",
                "eq": true
              },
              {
                "path": "competition.world.knockout.playerAdvancedToFinal",
                "eq": true
              },
              {
                "path": "competition.world.knockout.playerWonFinal",
                "eq": false
              }
            ]
          },
          "effects": [
            {
              "type": "set_flag",
              "key": "m11_outcome_route",
              "value": "world_runner_up"
            },
            {
              "type": "set_flag",
              "key": "m11_complete",
              "value": true
            },
            {
              "type": "set_flag",
              "key": "m11_championship_outcome_complete",
              "value": true
            },
            {
              "type": "set_flag",
              "key": "world_exit_available",
              "value": true
            },
            {
              "type": "set_flag",
              "key": "m12_unlocked",
              "value": true
            }
          ]
        },
        {
          "id": "commit_sf_elim",
          "text": "Chiudo M11 dopo l'eliminazione in semifinale.",
          "goto": "committed",
          "conditions": {
            "all": [
              {
                "path": "competition.world.knockout.finalResolved",
                "eq": true
              },
              {
                "path": "competition.world.knockout.playerAdvancedToFinal",
                "ne": true
              }
            ]
          },
          "effects": [
            {
              "type": "set_flag",
              "key": "m11_outcome_route",
              "value": "sf_eliminated"
            },
            {
              "type": "set_flag",
              "key": "m11_complete",
              "value": true
            },
            {
              "type": "set_flag",
              "key": "m11_championship_outcome_complete",
              "value": true
            },
            {
              "type": "set_flag",
              "key": "world_exit_available",
              "value": true
            },
            {
              "type": "set_flag",
              "key": "m12_unlocked",
              "value": true
            }
          ]
        }
      ]
    },
    "committed": {
      "stitches": [
        {
          "id": "s1",
          "text": "Le classifiche vengono archiviate e il nome del nuovo campione entra nell'albo ufficiale. Per te si apre la strada verso Asteria."
        }
      ],
      "choices": [
        {
          "id": "committed_next",
          "text": "Proseguo.",
          "goto": "handoff"
        },
        {
          "id": "committed_alt",
          "text": "Approfondisco.",
          "goto": "complete"
        }
      ]
    },
    "handoff": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il rumore dell'arena rimane alle spalle. Parti con la stessa squadra, gli stessi legami e tutte le conseguenze del cammino fatto."
        }
      ],
      "choices": [
        {
          "id": "handoff_m12",
          "text": "Inizio il viaggio di ritorno.",
          "goto": "m12-world-exit-branch#world_exit_entry"
        },
        {
          "id": "handoff_history",
          "text": "Rileggo la history.",
          "goto": "history"
        }
      ]
    },
    "complete": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il Mondiale ha un vincitore. Che il titolo sia tuo o di qualcun altro, questa stagione ha cambiato la tua storia."
        }
      ],
      "choices": [
        {
          "id": "complete_next",
          "text": "Proseguo.",
          "goto": "outcome_entry"
        },
        {
          "id": "complete_alt",
          "text": "Approfondisco.",
          "goto": "final_resolution"
        }
      ]
    }
  }
}
