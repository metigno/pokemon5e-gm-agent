{
  "schemaVersion": 1,
  "id": "m06-route-selection",
  "moduleId": "M06",
  "title": "M6_01 — Route Selection",
  "locationId": "alt_town",
  "entryNodeId": "route_entry",
  "conditions": {
    "all": [
      {
        "path": "world.flags.m5_complete",
        "eq": true
      },
      {
        "path": "world.flags.m06_unlocked",
        "eq": true
      },
      {
        "path": "world.flags.m6_active",
        "eq": true
      },
      {
        "path": "competition.rank",
        "eq": "A"
      }
    ]
  },
  "nodes": {
    "route_entry": {
      "stitches": [
        {
          "id": "s1",
          "text": "Davanti al terminale di Altacima, le partenze scorrono in righe luminose. Un addetto richiama i viaggiatori: «Controllate gli orari prima di mettervi in fila. Una destinazione sul tabellone non significa che il prossimo mezzo sia ancora disponibile»."
        }
      ],
      "choices": [
        {
          "id": "entry_board",
          "text": "Apro il tabellone delle tratte.",
          "goto": "route_board"
        },
        {
          "id": "entry_timetable",
          "text": "Controllo prima tempi e finestre.",
          "goto": "timetable"
        },
        {
          "id": "entry_defer",
          "text": "Per ora lascio perdere la partenza.",
          "goto": "defer"
        }
      ]
    },
    "route_board": {
      "stitches": [
        {
          "id": "s1",
          "text": "Due nomi risaltano sul tabellone: Solaria e Luminara. Accanto a ciascuno compaiono collegamenti e orari diversi. Dietro di te, un allenatore piega la mappa mentre un altro discute con la biglietteria."
        }
      ],
      "choices": [
        {
          "id": "board_solaria",
          "text": "Scelgo Solaria come prima destinazione.",
          "goto": "solaria_plan"
        },
        {
          "id": "board_luminara",
          "text": "Scelgo Luminara come prima destinazione.",
          "goto": "luminara_plan"
        },
        {
          "id": "board_open",
          "text": "Confronto entrambe le tratte prima di scegliere.",
          "goto": "neutral_plan"
        },
        {
          "id": "board_callbacks",
          "text": "Cerco nomi e contatti che conosco.",
          "goto": "callbacks"
        }
      ]
    },
    "solaria_plan": {
      "stitches": [
        {
          "id": "s1",
          "text": "Un manifesto di Solaria mostra un'arena circondata da spalti affollati. Un viaggiatore indica le gare segnate in rosso: «Là arrivano allenatori da ogni parte. Ti accorgi in fretta se il tuo modo di combattere funziona anche fuori casa»."
        }
      ],
      "choices": [
        {
          "id": "solaria_confirm",
          "text": "Registro Solaria come piano corrente.",
          "goto": "confirm",
          "effects": [
            {
              "type": "set_flag",
              "key": "m6_route_plan",
              "value": "solaria"
            }
          ]
        },
        {
          "id": "solaria_back",
          "text": "Torno al tabellone.",
          "goto": "route_board"
        }
      ]
    },
    "luminara_plan": {
      "stitches": [
        {
          "id": "s1",
          "text": "La colonna di Luminara è fitta di coincidenze e appuntamenti Masters. Una donna con la giacca del circuito scorre gli orari: «Se perdi il collegamento, potresti perdere anche la registrazione. Scegli con attenzione»."
        }
      ],
      "choices": [
        {
          "id": "luminara_confirm",
          "text": "Registro Luminara come piano corrente.",
          "goto": "confirm",
          "effects": [
            {
              "type": "set_flag",
              "key": "m6_route_plan",
              "value": "luminara"
            }
          ]
        },
        {
          "id": "luminara_back",
          "text": "Torno al tabellone.",
          "goto": "route_board"
        }
      ]
    },
    "neutral_plan": {
      "stitches": [
        {
          "id": "s1",
          "text": "Tieni entrambe le destinazioni davanti a te. Sul tabellone, intanto, un orario cambia: aspettare ti lascia più tempo per decidere, ma non trattiene le partenze."
        }
      ],
      "choices": [
        {
          "id": "neutral_timetable",
          "text": "Confronto gli orari.",
          "goto": "timetable"
        },
        {
          "id": "neutral_back",
          "text": "Torno al tabellone.",
          "goto": "route_board"
        }
      ]
    },
    "timetable": {
      "stitches": [
        {
          "id": "s1",
          "text": "L'orologio sopra il banco avanza mentre confronti le coincidenze. Un annuncio copre per un istante il brusio della sala; alcune partenze sono vicine, altre lasciano più margine per prepararsi."
        }
      ],
      "choices": [
        {
          "id": "time_compare",
          "text": "Confronto il rischio di perdere una finestra.",
          "goto": "risk_review"
        },
        {
          "id": "time_wait",
          "text": "Aspetto un'ora e ricontrollo.",
          "goto": "wait",
          "timeCostMinutes": 60
        }
      ]
    },
    "risk_review": {
      "stitches": [
        {
          "id": "s1",
          "text": "Una tratta più rapida potrebbe lasciarti meno tempo per organizzarti; una più comoda potrebbe farti arrivare dopo una scadenza. Gli orari sono davanti a te. La decisione resta tua."
        }
      ],
      "choices": [
        {
          "id": "risk_board",
          "text": "Torno al tabellone con questi vincoli.",
          "goto": "route_board"
        },
        {
          "id": "risk_defer",
          "text": "Rimando il viaggio.",
          "goto": "defer"
        }
      ]
    },
    "defer": {
      "stitches": [
        {
          "id": "s1",
          "text": "Ti allontani dallo sportello senza acquistare il biglietto. La sala continua a muoversi: partenze annunciate, allenatori in fila e nuove gare segnate sui monitor."
        }
      ],
      "choices": [
        {
          "id": "defer_hub",
          "text": "Rientro ad Altacima.",
          "goto": "m05-altacima#town_hub",
          "effects": [
            {
              "type": "set_location",
              "locationId": "alt_town"
            }
          ]
        },
        {
          "id": "defer_board",
          "text": "Riapro il tabellone.",
          "goto": "route_board"
        }
      ]
    },
    "callbacks": {
      "stitches": [
        {
          "id": "s1",
          "text": "Tra gli avvisi trovi nomi di organizzatori e contatti già incontrati durante il viaggio. Alcuni potrebbero riconoscerti, ma le condizioni di viaggio esposte allo sportello restano le stesse."
        }
      ],
      "choices": [
        {
          "id": "callbacks_record",
          "text": "Prendo nota dei contatti utili.",
          "goto": "route_board",
          "effects": [
            {
              "type": "set_flag",
              "key": "m6_route_callbacks_reviewed",
              "value": true
            }
          ]
        },
        {
          "id": "callbacks_back",
          "text": "Torno all'ingresso.",
          "goto": "route_entry"
        }
      ]
    },
    "confirm": {
      "stitches": [
        {
          "id": "s1",
          "text": "L'addetto annota la destinazione scelta. «Bene. Ora controlliamo la partenza vera e propria». Il tabellone resta acceso alle sue spalle."
        }
      ],
      "choices": [
        {
          "id": "confirm_depart",
          "text": "Mi presento per organizzare la partenza.",
          "goto": "m06-interregional-travel#travel_entry",
          "effects": [
            {
              "type": "set_flag",
              "key": "m6_route_selection_complete",
              "value": true
            }
          ]
        },
        {
          "id": "confirm_change",
          "text": "Chiedo di rivedere la destinazione.",
          "goto": "back_link"
        }
      ]
    },
    "close": {
      "stitches": [
        {
          "id": "s1",
          "text": "La biglietteria non richiede di visitare ogni città del circuito. Hai davanti un itinerario possibile; gli altri continueranno a esistere anche senza una tua visita."
        }
      ],
      "choices": [
        {
          "id": "close_depart",
          "text": "Mi avvio alla partenza.",
          "goto": "m06-interregional-travel#travel_entry"
        },
        {
          "id": "close_handoff",
          "text": "Torno al riepilogo M6.",
          "goto": "m06-handoff#rank_a_band"
        }
      ]
    },
    "back_link": {
      "stitches": [
        {
          "id": "s1",
          "text": "L'addetto lascia il modulo sul banco. «Non ho ancora emesso il biglietto. Se vuoi cambiare destinazione, questo è il momento»."
        }
      ],
      "choices": [
        {
          "id": "back_board",
          "text": "Riapro il tabellone.",
          "goto": "route_board"
        },
        {
          "id": "back_handoff",
          "text": "Torno al riepilogo Rank A.",
          "goto": "m06-handoff#rank_a_band"
        }
      ]
    },
    "wait": {
      "stitches": [
        {
          "id": "s1",
          "text": "Quando torni al tabellone, alcune righe sono cambiate. Il personale annuncia nuove coincidenze e chiama i passeggeri in attesa."
        }
      ],
      "choices": [
        {
          "id": "wait_board",
          "text": "Controllo di nuovo le tratte.",
          "goto": "route_board"
        },
        {
          "id": "wait_close",
          "text": "Tengo il piano e passo alla chiusura.",
          "goto": "close"
        }
      ]
    }
  }
}
