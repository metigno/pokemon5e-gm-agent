{
  "schemaVersion": 1,
  "id": "m11-sf-prep",
  "moduleId": "M11",
  "title": "M11_02 — SF Prep",
  "locationId": "world_knockout_hall",
  "entryNodeId": "prep_entry",
  "conditions": {
    "all": [
      {
        "path": "world.flags.m11_rei_thread_complete",
        "eq": true
      },
      {
        "path": "competition.world.knockout.sfOpened",
        "eq": true
      }
    ]
  },
  "nodes": {
    "prep_entry": {
      "stitches": [
        {
          "id": "s1",
          "text": "Dopo i quarti trovi un momento per sistemare la squadra. Le sfide già affrontate si sentono nelle condizioni dei Pokémon."
        }
      ],
      "choices": [
        {
          "id": "prep_entry_next",
          "text": "Proseguo verso Time Budget.",
          "goto": "time_budget"
        },
        {
          "id": "prep_entry_alt",
          "text": "Confronto questo punto con Resource State.",
          "goto": "resource_state"
        },
        {
          "id": "prep_entry_deep",
          "text": "Approfondisco Tactical Plan.",
          "goto": "tactical_plan"
        }
      ]
    },
    "time_budget": {
      "stitches": [
        {
          "id": "s1",
          "text": "L'orologio si avvicina all'ora della semifinale. Gli addetti e gli altri allenatori non interrompono la propria giornata mentre ti prepari."
        }
      ],
      "choices": [
        {
          "id": "time_short",
          "text": "Dedico 15 minuti alla revisione tattica.",
          "goto": "tactical_plan",
          "timeCostMinutes": 15
        },
        {
          "id": "time_long",
          "text": "Dedico 30 minuti al controllo del roster e delle risorse.",
          "goto": "roster_state",
          "timeCostMinutes": 30
        },
        {
          "id": "time_now",
          "text": "Non consumo altro tempo: accetto lo stato corrente.",
          "goto": "risk"
        }
      ]
    },
    "resource_state": {
      "stitches": [
        {
          "id": "s1",
          "text": "Controlli le Poké Ball, l'inventario e le condizioni di chi combatterà. Non tutte le risorse consumate sono recuperabili in pochi minuti."
        }
      ],
      "choices": [
        {
          "id": "resource_state_next",
          "text": "Proseguo verso Tactical Plan.",
          "goto": "tactical_plan"
        },
        {
          "id": "resource_state_alt",
          "text": "Confronto questo punto con Roster State.",
          "goto": "roster_state"
        },
        {
          "id": "resource_state_deep",
          "text": "Approfondisco Medical Policy.",
          "goto": "medical_policy"
        }
      ]
    },
    "tactical_plan": {
      "stitches": [
        {
          "id": "s1",
          "text": "Rileggi ciò che sai dell'avversario e consideri le possibili risposte. Una nuova idea non sostituisce l'allenamento necessario a realizzarla."
        }
      ],
      "choices": [
        {
          "id": "tactical_plan_next",
          "text": "Proseguo verso Roster State.",
          "goto": "roster_state"
        },
        {
          "id": "tactical_plan_alt",
          "text": "Confronto questo punto con Medical Policy.",
          "goto": "medical_policy"
        }
      ]
    },
    "roster_state": {
      "stitches": [
        {
          "id": "s1",
          "text": "I sei Pokémon ufficiali devono rispettare ancora le regole della competizione. Ogni eventuale cambio richiede una procedura valida."
        }
      ],
      "choices": [
        {
          "id": "roster_state_next",
          "text": "Proseguo verso Medical Policy.",
          "goto": "medical_policy"
        },
        {
          "id": "roster_state_alt",
          "text": "Confronto questo punto con Service Window.",
          "goto": "service_window"
        }
      ]
    },
    "medical_policy": {
      "stitches": [
        {
          "id": "s1",
          "text": "Per curare qualcuno devi raggiungere un servizio disponibile e rispettarne costi e tempi. Il prestigio della semifinale non è una medicina."
        }
      ],
      "choices": [
        {
          "id": "medical_policy_next",
          "text": "Proseguo verso Service Window.",
          "goto": "service_window"
        },
        {
          "id": "medical_policy_alt",
          "text": "Confronto questo punto con Risk.",
          "goto": "risk"
        }
      ]
    },
    "service_window": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il personale controlla l'orario dei servizi. Prima di affidare un Pokémon alle cure devi sapere quanto manca alla partita."
        }
      ],
      "choices": [
        {
          "id": "service_window_next",
          "text": "Proseguo verso Risk.",
          "goto": "risk"
        },
        {
          "id": "service_window_alt",
          "text": "Confronto questo punto con Opponent Readiness.",
          "goto": "opponent_readiness"
        }
      ]
    },
    "risk": {
      "stitches": [
        {
          "id": "s1",
          "text": "Puoi partire subito e conservare tempo. La scelta comporta entrare con le condizioni attuali della tua squadra."
        }
      ],
      "choices": [
        {
          "id": "risk_next",
          "text": "Proseguo verso Opponent Readiness.",
          "goto": "opponent_readiness"
        },
        {
          "id": "risk_alt",
          "text": "Confronto questo punto con Save State.",
          "goto": "save_state"
        }
      ]
    },
    "opponent_readiness": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il nome sul cartellone non cambia: {{competition.world.knockout.playerSfOpponent.name}} si sta preparando per affrontarti."
        }
      ],
      "choices": [
        {
          "id": "opponent_readiness_next",
          "text": "Proseguo verso Save State.",
          "goto": "save_state"
        },
        {
          "id": "opponent_readiness_alt",
          "text": "Confronto le informazioni disponibili, inclusi gli eventuali indizi personali, prima del commit.",
          "goto": "commit",
          "effects": [
            {
              "type": "set_flag",
              "key": "legendary_m11_optional_evidence_review",
              "value": true
            }
          ]
        }
      ]
    },
    "save_state": {
      "stitches": [
        {
          "id": "s1",
          "text": "Tornando agli appunti ritrovi lo stesso avversario e la squadra nello stato lasciato dalle decisioni prese finora."
        }
      ],
      "choices": [
        {
          "id": "save_state_next",
          "text": "Proseguo verso Commit.",
          "goto": "commit"
        },
        {
          "id": "save_state_alt",
          "text": "Confronto questo punto con Handoff.",
          "goto": "handoff"
        }
      ]
    },
    "commit": {
      "stitches": [
        {
          "id": "s1",
          "text": "Gli addetti confermano la tua presenza e indicano il percorso per raggiungere il campo."
        }
      ],
      "choices": [
        {
          "id": "commit_now",
          "text": "Confermo la readiness senza reset.",
          "goto": "handoff",
          "effects": [
            {
              "type": "set_flag",
              "key": "m11_sf_prep_complete",
              "value": true
            }
          ]
        },
        {
          "id": "commit_review",
          "text": "Rivedo lo stato delle risorse.",
          "goto": "resource_state"
        }
      ]
    },
    "handoff": {
      "stitches": [
        {
          "id": "s1",
          "text": "Al di là della porta ti aspettano un arbitro, un avversario reale e una partita da giocare."
        }
      ],
      "choices": [
        {
          "id": "handoff_match",
          "text": "Entro nella semifinale ufficiale.",
          "goto": "m11-world-sf#sf_entry"
        },
        {
          "id": "handoff_review",
          "text": "Rivedo il piano tattico.",
          "goto": "complete"
        }
      ]
    },
    "complete": {
      "stitches": [
        {
          "id": "s1",
          "text": "La preparazione è terminata. Non resta che decidere quando presentarti al richiamo."
        }
      ],
      "choices": [
        {
          "id": "complete_next",
          "text": "Proseguo verso Prep Entry.",
          "goto": "prep_entry"
        },
        {
          "id": "complete_alt",
          "text": "Confronto questo punto con Time Budget.",
          "goto": "time_budget"
        }
      ]
    }
  }
}
