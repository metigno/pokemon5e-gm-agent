{
  "schemaVersion": 1,
  "id": "m09-friend-beat-09",
  "moduleId": "M09",
  "title": "M9_05 — Friend Beat 09",
  "locationId": "world_village",
  "entryNodeId": "friend_entry",
  "conditions": {
    "all": [
      {
        "path": "world.flags.m9_matchday_two_complete",
        "eq": true
      },
      {
        "path": "world.flags.friend_beat_09_available",
        "eq": true
      }
    ]
  },
  "nodes": {
    "friend_entry": {
      "stitches": [
        {
          "id": "s1",
          "text": "Fra una giornata del girone e l'altra, il telefono vibra. È uno dei nomi che ti accompagnano da molto prima del Mondiale."
        }
      ],
      "choices": [
        {
          "id": "entry_contact",
          "text": "Apro il contatto selezionato.",
          "goto": "dispatch"
        },
        {
          "id": "entry_callback",
          "text": "Rivedo perché questo amico è stato scelto.",
          "goto": "callback"
        },
        {
          "id": "entry_wait",
          "text": "Posso ritardare il contatto senza congelare il torneo.",
          "goto": "wait_contact"
        }
      ]
    },
    "dispatch": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il contatto arriva da {{world.flags.friend_beat_09_friend_id}}. Potrebbe essere un prossimo avversario, uno già affrontato o un amico che segue il torneo da fuori."
        }
      ],
      "choices": [
        {
          "id": "dispatch_luke",
          "text": "Contatto Luke.",
          "goto": "luke_contact",
          "conditions": {
            "path": "world.flags.friend_beat_09_friend_id",
            "eq": "Luke"
          }
        },
        {
          "id": "dispatch_mattew",
          "text": "Contatto Mattew.",
          "goto": "mattew_contact",
          "conditions": {
            "path": "world.flags.friend_beat_09_friend_id",
            "eq": "Mattew"
          }
        },
        {
          "id": "dispatch_daniel",
          "text": "Contatto Daniel.",
          "goto": "daniel_contact",
          "conditions": {
            "path": "world.flags.friend_beat_09_friend_id",
            "eq": "Daniel"
          }
        },
        {
          "id": "dispatch_edward",
          "text": "Contatto Edward.",
          "goto": "edward_contact",
          "conditions": {
            "path": "world.flags.friend_beat_09_friend_id",
            "eq": "Edward"
          }
        },
        {
          "id": "dispatch_fab",
          "text": "Contatto Fab.",
          "goto": "fab_contact",
          "conditions": {
            "path": "world.flags.friend_beat_09_friend_id",
            "eq": "Fab"
          }
        }
      ]
    },
    "luke_contact": {
      "stitches": [
        {
          "id": "s1",
          "text": "Luke non perde tempo. «Mi hai visto combattere? No, non voglio sapere cosa ne pensano i commentatori. Guarda i miei Pokémon e dimmi se qualcuno di loro aveva voglia di fermarsi.»"
        }
      ],
      "choices": [
        {
          "id": "luke_context",
          "text": "Porto la conversazione nel contesto reale del bracket.",
          "goto": "context_dispatch",
          "effects": [
            {
              "type": "npc_relationship_adjust",
              "npcId": "Luke",
              "delta": 1
            }
          ]
        }
      ]
    },
    "mattew_contact": {
      "stitches": [
        {
          "id": "s1",
          "text": "Mattew fa scorrere una pagina piena di annotazioni. «Tre partite non sono tre occasioni per fare lo stesso errore.» Poi sorride: «Anche se tu probabilmente ci riusciresti.»"
        }
      ],
      "choices": [
        {
          "id": "mattew_context",
          "text": "Porto la conversazione nel contesto reale del bracket.",
          "goto": "context_dispatch",
          "effects": [
            {
              "type": "npc_relationship_adjust",
              "npcId": "Mattew",
              "delta": 1
            }
          ]
        }
      ]
    },
    "daniel_contact": {
      "stitches": [
        {
          "id": "s1",
          "text": "Daniel ha già ricontrollato gli orari. «Non basarti sulle voci del Village», dice. «E, qualunque cosa succeda, evita di scambiare una cattiva decisione per un cattivo carattere.»"
        }
      ],
      "choices": [
        {
          "id": "daniel_context",
          "text": "Porto la conversazione nel contesto reale del bracket.",
          "goto": "context_dispatch",
          "effects": [
            {
              "type": "npc_relationship_adjust",
              "npcId": "Daniel",
              "delta": 1
            }
          ]
        }
      ]
    },
    "edward_contact": {
      "stitches": [
        {
          "id": "s1",
          "text": "«Hai visto che facce sugli spalti?» ride Edward. «Vale quasi il prezzo del viaggio. Certo, preferirei che guardassero un bel KO dei miei, ma non sono schizzinoso.»"
        }
      ],
      "choices": [
        {
          "id": "edward_context",
          "text": "Porto la conversazione nel contesto reale del bracket.",
          "goto": "context_dispatch",
          "effects": [
            {
              "type": "npc_relationship_adjust",
              "npcId": "Edward",
              "delta": 1
            }
          ]
        }
      ]
    },
    "fab_contact": {
      "stitches": [
        {
          "id": "s1",
          "text": "Fab guarda il proprio Pokémon fuori dall'inquadratura. «Koffing non sa quanti punti ci servono. Secondo me è più rilassato per quello.» Poi ti chiede come stanno davvero i tuoi."
        }
      ],
      "choices": [
        {
          "id": "fab_context",
          "text": "Porto la conversazione nel contesto reale del bracket.",
          "goto": "context_dispatch",
          "effects": [
            {
              "type": "npc_relationship_adjust",
              "npcId": "Fab",
              "delta": 1
            }
          ]
        }
      ]
    },
    "context_dispatch": {
      "stitches": [
        {
          "id": "s1",
          "text": "Parlate sapendo che i calendari esistono già: un incontro fra amici si gioca soltanto quando è previsto dal tabellone."
        }
      ],
      "choices": [
        {
          "id": "context_next",
          "text": "Siamo nello stesso gruppo e il nostro match è ancora davanti.",
          "goto": "same_group_next",
          "conditions": {
            "path": "world.flags.friend_beat_09_context",
            "eq": "same_group_next_match"
          }
        },
        {
          "id": "context_played",
          "text": "Siamo nello stesso gruppo e il match ufficiale è già stato giocato.",
          "goto": "same_group_played",
          "conditions": {
            "path": "world.flags.friend_beat_09_context",
            "eq": "same_group_match_resolved"
          }
        },
        {
          "id": "context_other",
          "text": "Siamo entrambi qualificati ma in gruppi diversi.",
          "goto": "other_group",
          "conditions": {
            "path": "world.flags.friend_beat_09_context",
            "eq": "qualified_other_group"
          }
        },
        {
          "id": "context_external",
          "text": "L'amico non è nel field: il contatto resta esterno alla competizione.",
          "goto": "external",
          "conditions": {
            "path": "world.flags.friend_beat_09_context",
            "eq": "external_contact"
          }
        }
      ]
    },
    "same_group_next": {
      "stitches": [
        {
          "id": "s1",
          "text": "Se vi affronterete nell'ultima giornata, le battute diventano più appuntite. La sfida ufficiale, però, deve ancora arrivare."
        }
      ],
      "choices": [
        {
          "id": "next_physical",
          "text": "Parliamo di persona prima del match.",
          "goto": "physical_context",
          "conditions": {
            "path": "world.flags.friend_beat_09_contact_mode",
            "eq": "physical"
          },
          "effects": [
            {
              "type": "set_flag",
              "key": "friend_beat_09_type",
              "value": "same_group_pre_match_physical"
            }
          ]
        },
        {
          "id": "next_remote",
          "text": "Parliamo a distanza prima del match.",
          "goto": "remote_context",
          "conditions": {
            "path": "world.flags.friend_beat_09_contact_mode",
            "eq": "remote"
          },
          "effects": [
            {
              "type": "set_flag",
              "key": "friend_beat_09_type",
              "value": "same_group_pre_match_remote"
            }
          ]
        },
        {
          "id": "next_pressure",
          "text": "Restiamo sul fatto che domani uno dei due dovrà togliere punti all'altro.",
          "goto": "pressure"
        }
      ]
    },
    "same_group_played": {
      "stitches": [
        {
          "id": "s1",
          "text": "Se vi siete già affrontati, nessuno dei due può cambiare il risultato con una rivincita improvvisata nel corridoio."
        }
      ],
      "choices": [
        {
          "id": "played_physical",
          "text": "Parliamo di persona dopo il match.",
          "goto": "physical_context",
          "conditions": {
            "path": "world.flags.friend_beat_09_contact_mode",
            "eq": "physical"
          },
          "effects": [
            {
              "type": "set_flag",
              "key": "friend_beat_09_type",
              "value": "same_group_post_match_physical"
            }
          ]
        },
        {
          "id": "played_remote",
          "text": "Parliamo a distanza dopo il match.",
          "goto": "remote_context",
          "conditions": {
            "path": "world.flags.friend_beat_09_contact_mode",
            "eq": "remote"
          },
          "effects": [
            {
              "type": "set_flag",
              "key": "friend_beat_09_type",
              "value": "same_group_post_match_remote"
            }
          ]
        },
        {
          "id": "played_pressure",
          "text": "Parliamo di cosa significa continuare dopo esserci già tolti punti.",
          "goto": "pressure"
        }
      ]
    },
    "other_group": {
      "stitches": [
        {
          "id": "s1",
          "text": "Siete nello stesso torneo ma in gruppi diversi. Potete confrontare impressioni, non inventare una partita aggiuntiva."
        }
      ],
      "choices": [
        {
          "id": "other_physical",
          "text": "Ci incontriamo davvero nel Village.",
          "goto": "physical_context",
          "conditions": {
            "path": "world.flags.friend_beat_09_contact_mode",
            "eq": "physical"
          },
          "effects": [
            {
              "type": "set_flag",
              "key": "friend_beat_09_type",
              "value": "other_group_physical"
            }
          ]
        },
        {
          "id": "other_remote",
          "text": "Ci sentiamo senza spostare nessuno.",
          "goto": "remote_context",
          "conditions": {
            "path": "world.flags.friend_beat_09_contact_mode",
            "eq": "remote"
          },
          "effects": [
            {
              "type": "set_flag",
              "key": "friend_beat_09_type",
              "value": "other_group_remote"
            }
          ]
        }
      ]
    },
    "external": {
      "stitches": [
        {
          "id": "s1",
          "text": "L'amico segue la corsa mondiale da fuori. La sua assenza dal tabellone non cancella la voglia di parlare con te."
        }
      ],
      "choices": [
        {
          "id": "external_physical",
          "text": "È davvero qui come presenza esterna: parliamo di persona.",
          "goto": "physical_context",
          "conditions": {
            "path": "world.flags.friend_beat_09_contact_mode",
            "eq": "physical"
          },
          "effects": [
            {
              "type": "set_flag",
              "key": "friend_beat_09_type",
              "value": "external_physical"
            }
          ]
        },
        {
          "id": "external_remote",
          "text": "Restiamo in contatto a distanza.",
          "goto": "remote_context",
          "conditions": {
            "path": "world.flags.friend_beat_09_contact_mode",
            "eq": "remote"
          },
          "effects": [
            {
              "type": "set_flag",
              "key": "friend_beat_09_type",
              "value": "external_remote"
            }
          ]
        }
      ]
    },
    "physical_context": {
      "stitches": [
        {
          "id": "s1",
          "text": "Se vi vedete di persona, il Village vi concede un angolo tranquillo per qualche minuto. Gli altri allenatori continuano a passare."
        }
      ],
      "choices": [
        {
          "id": "physical_pressure",
          "text": "Parliamo della pressione della terza giornata.",
          "goto": "pressure"
        },
        {
          "id": "physical_relationship",
          "text": "Parliamo di cosa il Mondiale sta facendo al rapporto.",
          "goto": "relationship"
        },
        {
          "id": "physical_callback",
          "text": "Ricollego il momento ai Friend Beat precedenti.",
          "goto": "callback"
        }
      ]
    },
    "remote_context": {
      "stitches": [
        {
          "id": "s1",
          "text": "La voce arriva con un lieve ritardo. L'amico è altrove, impegnato nel proprio percorso."
        }
      ],
      "choices": [
        {
          "id": "remote_pressure",
          "text": "Parliamo della pressione della terza giornata.",
          "goto": "pressure"
        },
        {
          "id": "remote_relationship",
          "text": "Parliamo di come restare amici con carriere separate.",
          "goto": "relationship"
        },
        {
          "id": "remote_callback",
          "text": "Ricollego il momento ai Friend Beat precedenti.",
          "goto": "callback"
        }
      ]
    },
    "pressure": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il terzo incontro pesa diversamente a seconda dei risultati precedenti. Nessuna battuta può spostare i punti già guadagnati."
        }
      ],
      "choices": [
        {
          "id": "pressure_relationship",
          "text": "Rispondo sul piano personale.",
          "goto": "relationship"
        },
        {
          "id": "pressure_record",
          "text": "Tengo il confronto breve e lo registro.",
          "goto": "result_record"
        }
      ]
    },
    "relationship": {
      "stitches": [
        {
          "id": "s1",
          "text": "Ciò che dici può avvicinarvi o urtarvi. Il vostro rapporto ha memoria, anche quando la classifica non vi riguarda entrambi."
        }
      ],
      "choices": [
        {
          "id": "relationship_callback",
          "text": "Rileggo il percorso condiviso.",
          "goto": "callback"
        },
        {
          "id": "relationship_record",
          "text": "Chiudo il momento e lo registro.",
          "goto": "result_record"
        }
      ]
    },
    "callback": {
      "stitches": [
        {
          "id": "s1",
          "text": "Un episodio della conversazione precedente ritorna in forma di scherzo. Non siete diventati estranei soltanto perché vi siete separati."
        }
      ],
      "choices": [
        {
          "id": "callback_contact",
          "text": "Torno al contatto corrente.",
          "goto": "dispatch"
        },
        {
          "id": "callback_record",
          "text": "Chiudo il callback e registro il beat.",
          "goto": "result_record"
        }
      ]
    },
    "wait_contact": {
      "stitches": [
        {
          "id": "s1",
          "text": "Se rimandi, l'ora passa e gli impegni dell'amico non smettono di esistere."
        }
      ],
      "choices": [
        {
          "id": "wait_hour",
          "text": "Aspetto un'ora.",
          "goto": "dispatch",
          "timeCostMinutes": 60
        },
        {
          "id": "wait_now",
          "text": "Non aspetto oltre.",
          "goto": "dispatch"
        }
      ]
    },
    "result_record": {
      "stitches": [
        {
          "id": "s1",
          "text": "La chiamata si conclude. Sul tabellone le partite sono ancora quelle fissate dal sorteggio."
        }
      ],
      "choices": [
        {
          "id": "record_complete",
          "text": "Segno FRIEND_BEAT_09 come completato.",
          "goto": "friend_close",
          "effects": [
            {
              "type": "set_flag",
              "key": "friend_beat_09_complete",
              "value": true
            }
          ]
        }
      ]
    },
    "friend_close": {
      "stitches": [
        {
          "id": "s1",
          "text": "Rimane da affrontare l'ultima giornata del girone. La voce dell'amico non sostituirà quella dell'arbitro."
        }
      ],
      "choices": [
        {
          "id": "close_interday",
          "text": "Passo all'Interday 2.",
          "goto": "m09-interday-two#interday_entry"
        }
      ]
    }
  }
}
