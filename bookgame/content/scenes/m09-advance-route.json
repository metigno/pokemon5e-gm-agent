{
  "schemaVersion": 1,
  "id": "m09-advance-route",
  "moduleId": "M09",
  "title": "M9_10 — Advance Route",
  "locationId": "world_village",
  "entryNodeId": "advance_entry",
  "conditions": {
    "all": [
      {
        "path": "world.flags.m9_group_resolution_complete",
        "eq": true
      },
      {
        "path": "world.flags.m9_advance_route_available",
        "eq": true
      },
      {
        "path": "competition.world.groupStage.resolved",
        "eq": true
      },
      {
        "path": "competition.world.groupStage.advanced",
        "eq": true
      },
      {
        "path": "competition.world.top16Locked",
        "eq": true
      },
      {
        "path": "competition.world.top16.length",
        "eq": 16
      },
      {
        "path": "world.flags.friend_beat_09_complete",
        "eq": true
      }
    ]
  },
  "nodes": {
    "advance_entry": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il tuo nome compare fra i sedici qualificati. Hai superato i gironi grazie ai risultati ottenuti sul campo; ora ti aspetta l'eliminazione diretta."
        }
      ],
      "choices": [
        {
          "id": "entry_result",
          "text": "Rileggo il piazzamento finale del gruppo.",
          "goto": "group_result"
        },
        {
          "id": "entry_top16",
          "text": "Controllo il Top16 reale.",
          "goto": "top16"
        },
        {
          "id": "entry_handoff",
          "text": "Controllo cosa M10 riceverà davvero.",
          "goto": "handoff_policy"
        }
      ]
    },
    "group_result": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il registro conserva il tuo piazzamento: {{competition.world.groupStage.finalPosition}}. Le gare del gruppo non verranno disputate una seconda volta."
        }
      ],
      "choices": [
        {
          "id": "result_top16",
          "text": "Passo ai sedici qualificati.",
          "goto": "top16"
        }
      ]
    },
    "top16": {
      "stitches": [
        {
          "id": "s1",
          "text": "La bacheca degli ottavi contiene sedici allenatori. Chi era famoso ma non si è qualificato non compare fra loro."
        }
      ],
      "choices": [
        {
          "id": "top16_friends",
          "text": "Controllo il significato per amici e Anchor.",
          "goto": "friend_anchor"
        },
        {
          "id": "top16_bracket",
          "text": "Verifico quando verrà creato l'incrocio degli ottavi.",
          "goto": "bracket_boundary"
        },
        {
          "id": "top16_handoff",
          "text": "Passo alla policy di handoff.",
          "goto": "handoff_policy"
        }
      ]
    },
    "friend_anchor": {
      "stitches": [
        {
          "id": "s1",
          "text": "Cerchi gli amici e i nomi conosciuti. Chi è ancora dentro avrà un'altra partita; chi è uscito non rientrerà per incontrarti."
        }
      ],
      "choices": [
        {
          "id": "friends_top16",
          "text": "Torno al field dei sedici.",
          "goto": "top16"
        },
        {
          "id": "friends_callback",
          "text": "Conservo il Friend Beat senza trasformarlo in pairing.",
          "goto": "continuity"
        }
      ]
    },
    "bracket_boundary": {
      "stitches": [
        {
          "id": "s1",
          "text": "Gli ufficiali stanno preparando gli incroci degli ottavi. Per ora sai di essere fra i sedici, non ancora contro chi giocherai."
        }
      ],
      "choices": [
        {
          "id": "bracket_handoff",
          "text": "Passo al contratto M10.",
          "goto": "handoff_policy"
        }
      ]
    },
    "team_state": {
      "stitches": [
        {
          "id": "s1",
          "text": "Controlli la squadra dopo le tre giornate. Le ferite e le risorse consumate restano da affrontare prima della prossima sfida."
        }
      ],
      "choices": [
        {
          "id": "team_world",
          "text": "Guardo cosa continua nel mondo mentre avanzo.",
          "goto": "living_world"
        },
        {
          "id": "team_handoff",
          "text": "Accetto lo stato persistente e passo all'handoff.",
          "goto": "handoff_policy"
        }
      ]
    },
    "living_world": {
      "stitches": [
        {
          "id": "s1",
          "text": "Gli altri qualificati prendono possesso delle loro aree di preparazione. Nessuno resta fermo finché decidi come festeggiare."
        }
      ],
      "choices": [
        {
          "id": "world_top16",
          "text": "Ritorno al Top16.",
          "goto": "top16"
        },
        {
          "id": "world_continuity",
          "text": "Conservo relazioni e callback verso M10.",
          "goto": "continuity"
        }
      ]
    },
    "continuity": {
      "stitches": [
        {
          "id": "s1",
          "text": "Kaia, gli amici e gli altri allenatori proseguono le proprie giornate secondo quanto hanno conquistato. I rapporti precedenti non cambiano i risultati."
        }
      ],
      "choices": [
        {
          "id": "continuity_friends",
          "text": "Rileggo il loro stato competitivo.",
          "goto": "friend_anchor"
        },
        {
          "id": "continuity_handoff",
          "text": "Passo al contratto di uscita.",
          "goto": "handoff_policy"
        }
      ]
    },
    "handoff_policy": {
      "stitches": [
        {
          "id": "s1",
          "text": "Prima di lasciare il girone, ricontrolli classifica, squadra e ultime conversazioni. Tutto ciò ti accompagnerà agli ottavi."
        }
      ],
      "choices": [
        {
          "id": "handoff_check",
          "text": "Verifico il contratto completo.",
          "goto": "exit_check"
        },
        {
          "id": "handoff_bracket",
          "text": "Rileggo perché l'avversario R16 appartiene a M10.",
          "goto": "bracket_boundary"
        },
        {
          "id": "handoff_team",
          "text": "Controllo ancora la squadra.",
          "goto": "team_state"
        }
      ]
    },
    "exit_check": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il personale aggiorna il tuo accredito e ti indica l'area destinata ai sedici rimasti."
        }
      ],
      "choices": [
        {
          "id": "check_commit",
          "text": "Sono pronto a chiudere il modulo.",
          "goto": "commit"
        },
        {
          "id": "check_top16",
          "text": "Prima rivedo il Top16.",
          "goto": "top16"
        }
      ]
    },
    "commit": {
      "stitches": [
        {
          "id": "s1",
          "text": "Ricevi la comunicazione ufficiale del passaggio del turno. La posizione nel girone rimane quella registrata."
        }
      ],
      "choices": [
        {
          "id": "commit_now",
          "text": "Chiudo M9 e sblocco M10.",
          "goto": "advance_complete",
          "effects": [
            {
              "type": "set_flag",
              "key": "m10_unlocked",
              "value": true
            },
            {
              "type": "set_flag",
              "key": "m9_advance_route_complete",
              "value": true
            },
            {
              "type": "set_flag",
              "key": "m9_complete",
              "value": true
            }
          ]
        },
        {
          "id": "commit_review",
          "text": "Prima ricontrollo il contratto.",
          "goto": "exit_check"
        },
        {
          "id": "commit_continuity",
          "text": "Prima ricontrollo cosa persiste.",
          "goto": "continuity"
        }
      ]
    },
    "advance_complete": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il girone è alle spalle. Il prossimo appuntamento è la formazione del tabellone degli ottavi."
        }
      ],
      "choices": [
        {
          "id": "complete_summary",
          "text": "Rileggo il riepilogo finale.",
          "goto": "summary"
        },
        {
          "id": "complete_m10",
          "text": "Apro il bracket degli ottavi.",
          "goto": "m10-r16-bracket#bracket_entry"
        },
        {
          "id": "complete_hold",
          "text": "Resto nel Village con lo stato attuale.",
          "goto": "hold"
        }
      ]
    },
    "summary": {
      "stitches": [
        {
          "id": "s1",
          "text": "Conservi il programma delle tre giornate, i risultati e i contatti avuti nel Village. La qualificazione agli ottavi è un altro capitolo dello stesso percorso."
        }
      ],
      "choices": [
        {
          "id": "summary_result",
          "text": "Rivedo il piazzamento.",
          "goto": "group_result"
        },
        {
          "id": "summary_hold",
          "text": "Chiudo il riepilogo senza modificare lo stato.",
          "goto": "hold"
        }
      ]
    },
    "hold": {
      "stitches": [
        {
          "id": "s1",
          "text": "La bacheca dei sedici è completa. Non appare una quarta partita del girone: aspetti soltanto l'annuncio del primo avversario a eliminazione diretta."
        }
      ],
      "choices": [
        {
          "id": "hold_summary",
          "text": "Riapro il riepilogo se voglio verificare lo stato.",
          "goto": "summary"
        },
        {
          "id": "hold_team",
          "text": "Controllo la squadra persistente.",
          "goto": "team_state"
        }
      ]
    }
  }
}
