{
  "schemaVersion": 1,
  "id": "m07-module-outcome",
  "moduleId": "M07",
  "title": "M7_13 — Module Outcome",
  "locationId": "meridiana_city",
  "entryNodeId": "outcome_entry",
  "conditions": {
    "all": [
      {
        "path": "world.flags.m6_complete",
        "eq": true
      },
      {
        "path": "world.flags.m07_unlocked",
        "eq": true
      },
      {
        "path": "world.flags.m7_active",
        "eq": true
      },
      {
        "path": "competition.rank",
        "eq": "S"
      },
      {
        "path": "world.flags.cynthia_met",
        "eq": true
      },
      {
        "path": "world.flags.friend_beat_07_complete",
        "eq": true
      },
      {
        "path": "world.flags.m7_qualifier_result_resolved",
        "eq": true
      },
      {
        "any": [
          {
            "all": [
              {
                "path": "world.flags.world_qualified",
                "eq": true
              },
              {
                "path": "world.flags.m7_before_lights_complete",
                "eq": true
              }
            ]
          },
          {
            "all": [
              {
                "path": "world.flags.worlds_missed",
                "eq": true
              },
              {
                "path": "world.flags.m7_worlds_missed_resolved",
                "eq": true
              }
            ]
          }
        ]
      }
    ]
  },
  "nodes": {
    "outcome_entry": {
      "stitches": [
        {
          "id": "s1",
          "text": "Prima di lasciare Meridiana rivedi i momenti che hanno segnato la stagione: l'incontro con Cynthia, un contatto con gli amici e le partite delle qualificazioni."
        }
      ],
      "choices": [
        {
          "id": "entry_contract",
          "text": "Eseguo l'audit dell'exit contract.",
          "goto": "contract"
        },
        {
          "id": "entry_continuity",
          "text": "Controllo cosa resta persistente.",
          "goto": "continuity"
        },
        {
          "id": "entry_complete",
          "text": "M7 è già chiuso: rivedo il punto di handoff.",
          "goto": "complete",
          "conditions": {
            "path": "world.flags.m7_complete",
            "eq": true
          }
        }
      ]
    },
    "contract": {
      "stitches": [
        {
          "id": "s1",
          "text": "Sul tuo dossier devono risultare gli incontri e i verdetti di questa stagione. Non puoi lasciare una gara in sospeso e poi immaginarne il risultato."
        }
      ],
      "choices": [
        {
          "id": "contract_cynthia",
          "text": "Controllo Cynthia.",
          "goto": "cynthia"
        },
        {
          "id": "contract_friend",
          "text": "Controllo FRIEND_BEAT_07.",
          "goto": "friend"
        },
        {
          "id": "contract_qualifier",
          "text": "Controllo la storia del Qualifier.",
          "goto": "qualifier"
        }
      ]
    },
    "cynthia": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il ricordo di Cynthia resta legato alla conversazione che avete davvero avuto, non a un incontro che il pubblico si aspettava."
        }
      ],
      "choices": [
        {
          "id": "cynthia_contract",
          "text": "Torno all'audit.",
          "goto": "contract"
        },
        {
          "id": "cynthia_continuity",
          "text": "Rivedo la continuità dell'Anchor.",
          "goto": "continuity"
        }
      ]
    },
    "friend": {
      "stitches": [
        {
          "id": "s1",
          "text": "I messaggi degli amici sono ancora sul telefono. Ognuno ha seguito la propria strada, anche quando le vostre si sono incrociate."
        }
      ],
      "choices": [
        {
          "id": "friend_contract",
          "text": "Torno all'audit.",
          "goto": "contract"
        },
        {
          "id": "friend_continuity",
          "text": "Rivedo come il rapporto prosegue.",
          "goto": "continuity"
        }
      ]
    },
    "qualifier": {
      "stitches": [
        {
          "id": "s1",
          "text": "I referti del Qualifier e dell'eventuale ultima selezione sono archiviati separatamente. Ogni incontro conserva il risultato che hai ottenuto."
        }
      ],
      "choices": [
        {
          "id": "qualifier_route",
          "text": "Classifico il ramo di uscita.",
          "goto": "unlock_guard"
        },
        {
          "id": "qualifier_contract",
          "text": "Torno all'audit.",
          "goto": "contract"
        }
      ]
    },
    "qualified_route": {
      "stitches": [
        {
          "id": "s1",
          "text": "Se ti sei qualificato, l'ufficio partenze consegna l'accredito per la sede mondiale. Il viaggio successivo ti porterà al Village."
        }
      ],
      "choices": [
        {
          "id": "qualified_commit",
          "text": "Applico l'unlock M8.",
          "goto": "commit_qualified"
        },
        {
          "id": "qualified_review",
          "text": "Rivedo la continuità prima di chiudere.",
          "goto": "continuity"
        }
      ]
    },
    "missed_route": {
      "stitches": [
        {
          "id": "s1",
          "text": "Se non ti sei qualificato, non esiste un pass per il Village. Ti attende invece il ritorno ad Asteria, con la tua carriera ancora aperta."
        }
      ],
      "choices": [
        {
          "id": "missed_commit",
          "text": "Applico l'unlock M12.",
          "goto": "commit_missed"
        },
        {
          "id": "missed_review",
          "text": "Rivedo la continuità prima di chiudere.",
          "goto": "continuity"
        }
      ]
    },
    "continuity": {
      "stitches": [
        {
          "id": "s1",
          "text": "Controlli i bagagli e la squadra: livelli, ferite, denaro, oggetti, relazioni e risultati non svaniscono quando cambia la destinazione."
        }
      ],
      "choices": [
        {
          "id": "continuity_route",
          "text": "Torno alla classificazione dell'uscita.",
          "goto": "unlock_guard"
        },
        {
          "id": "continuity_contract",
          "text": "Torno all'audit del contract.",
          "goto": "contract"
        }
      ]
    },
    "unlock_guard": {
      "stitches": [
        {
          "id": "s1",
          "text": "Al banco controllano un solo documento: l'esito della qualificazione. È quello, non la fama, a determinare la prossima partenza."
        }
      ],
      "choices": [
        {
          "id": "guard_qualified",
          "text": "La run è qualificata.",
          "goto": "qualified_route",
          "conditions": {
            "all": [
              {
                "path": "world.flags.world_qualified",
                "eq": true
              },
              {
                "path": "world.flags.worlds_missed",
                "ne": true
              }
            ]
          }
        },
        {
          "id": "guard_missed",
          "text": "La run ha mancato il Mondiale.",
          "goto": "missed_route",
          "conditions": {
            "all": [
              {
                "path": "world.flags.worlds_missed",
                "eq": true
              },
              {
                "path": "world.flags.world_qualified",
                "ne": true
              }
            ]
          }
        }
      ]
    },
    "commit_qualified": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il personale timbra l'accredito mondiale e ti consegna le informazioni di viaggio. Il torneo è davanti a te."
        }
      ],
      "choices": [
        {
          "id": "commit_q_now",
          "text": "Chiudo M7 sul ramo qualificato.",
          "goto": "complete",
          "effects": [
            {
              "type": "set_flag",
              "key": "m08_unlocked",
              "value": true
            },
            {
              "type": "set_flag",
              "key": "m7_complete",
              "value": true
            },
            {
              "type": "set_flag",
              "key": "m7_outcome",
              "value": "world_qualified"
            }
          ]
        },
        {
          "id": "commit_q_review",
          "text": "Rivedo il ramo prima di chiudere.",
          "goto": "qualified_route"
        }
      ]
    },
    "commit_missed": {
      "stitches": [
        {
          "id": "s1",
          "text": "L'addetta archivia la mancata qualificazione e ti restituisce i documenti. La prossima tratta sarà verso Asteria."
        }
      ],
      "choices": [
        {
          "id": "commit_m_now",
          "text": "Chiudo M7 sul ramo Worlds Missed.",
          "goto": "complete",
          "effects": [
            {
              "type": "set_flag",
              "key": "m12_unlocked",
              "value": true
            },
            {
              "type": "set_flag",
              "key": "m7_complete",
              "value": true
            },
            {
              "type": "set_flag",
              "key": "m7_outcome",
              "value": "worlds_missed"
            }
          ]
        },
        {
          "id": "commit_m_review",
          "text": "Rivedo il ramo prima di chiudere.",
          "goto": "missed_route"
        }
      ]
    },
    "complete": {
      "stitches": [
        {
          "id": "s1",
          "text": "Meridiana rimane alle tue spalle. Parti per il Mondiale oppure torni al resto della tua vita da allenatore, secondo ciò che è successo davvero."
        }
      ],
      "choices": [
        {
          "id": "complete_q",
          "text": "Proseguo verso il Mondiale con M8 sbloccato.",
          "goto": "m08-world-arrival#world_entry",
          "conditions": {
            "path": "world.flags.m08_unlocked",
            "eq": true
          }
        },
        {
          "id": "complete_m",
          "text": "Entro in M12 / WORLD_EXIT con Worlds Missed registrato.",
          "goto": "m12-world-exit-branch#world_exit_entry",
          "conditions": {
            "path": "world.flags.m12_unlocked",
            "eq": true
          }
        }
      ]
    }
  }
}
