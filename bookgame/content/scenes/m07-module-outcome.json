{
  "schemaVersion": 1,
  "id": "m07-module-outcome",
  "moduleId": "M07",
  "title": "M7_13 — Module Outcome",
  "locationId": "meridiana_city",
  "entryNodeId": "outcome_entry",
  "conditions": {
    "all": [
      {
        "path": "world.flags.m6_complete",
        "eq": true
      },
      {
        "path": "world.flags.m07_unlocked",
        "eq": true
      },
      {
        "path": "world.flags.m7_active",
        "eq": true
      },
      {
        "path": "competition.rank",
        "eq": "S"
      },
      {
        "path": "world.flags.cynthia_met",
        "eq": true
      },
      {
        "path": "world.flags.friend_beat_07_complete",
        "eq": true
      },
      {
        "path": "world.flags.m7_qualifier_result_resolved",
        "eq": true
      },
      {
        "any": [
          {
            "path": "world.flags.world_qualified",
            "eq": true
          },
          {
            "path": "world.flags.worlds_missed",
            "eq": true
          }
        ]
      }
    ]
  },
  "nodes": {
    "outcome_entry": {
      "stitches": [
        {
          "id": "s1",
          "text": "M7 chiude soltanto dopo Cynthia, FRIEND_BEAT_07 e una risoluzione reale della corsa al Mondiale. Il ramo successivo dipende dallo stato competitivo, non da una scelta cosmetica."
        }
      ],
      "choices": [
        {
          "id": "entry_contract",
          "text": "Eseguo l'audit dell'exit contract.",
          "goto": "contract"
        },
        {
          "id": "entry_continuity",
          "text": "Controllo cosa resta persistente.",
          "goto": "continuity"
        },
        {
          "id": "entry_complete",
          "text": "M7 è già chiuso: rivedo il punto di handoff.",
          "goto": "complete",
          "conditions": {
            "path": "world.flags.m7_complete",
            "eq": true
          }
        }
      ]
    },
    "contract": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il contract richiede Anchor, Friend Beat, qualifier history e uno fra world_qualified o worlds_missed. Non può esistere un terzo esito implicito."
        }
      ],
      "choices": [
        {
          "id": "contract_cynthia",
          "text": "Controllo Cynthia.",
          "goto": "cynthia"
        },
        {
          "id": "contract_friend",
          "text": "Controllo FRIEND_BEAT_07.",
          "goto": "friend"
        },
        {
          "id": "contract_qualifier",
          "text": "Controllo la storia del Qualifier.",
          "goto": "qualifier"
        }
      ]
    },
    "cynthia": {
      "stitches": [
        {
          "id": "s1",
          "text": "Cynthia è stata realmente incontrata e rimane nello stato NPC persistente."
        }
      ],
      "choices": [
        {
          "id": "cynthia_contract",
          "text": "Torno all'audit.",
          "goto": "contract"
        },
        {
          "id": "cynthia_continuity",
          "text": "Rivedo la continuità dell'Anchor.",
          "goto": "continuity"
        }
      ]
    },
    "friend": {
      "stitches": [
        {
          "id": "s1",
          "text": "FRIEND_BEAT_07 conserva amico, modalità e conseguenze senza sincronizzare le carriere."
        }
      ],
      "choices": [
        {
          "id": "friend_contract",
          "text": "Torno all'audit.",
          "goto": "contract"
        },
        {
          "id": "friend_continuity",
          "text": "Rivedo come il rapporto prosegue.",
          "goto": "continuity"
        }
      ]
    },
    "qualifier": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il Qualifier e, se usato, il Last Chance restano nella competition.history. M7 non crea un risultato parallelo."
        }
      ],
      "choices": [
        {
          "id": "qualifier_route",
          "text": "Classifico il ramo di uscita.",
          "goto": "unlock_guard"
        },
        {
          "id": "qualifier_contract",
          "text": "Torno all'audit.",
          "goto": "contract"
        }
      ]
    },
    "qualified_route": {
      "stitches": [
        {
          "id": "s1",
          "text": "world_qualified=true apre M8 — Il Mondo nello Stesso Posto. Worlds Missed non viene scritto su questa route."
        }
      ],
      "choices": [
        {
          "id": "qualified_commit",
          "text": "Applico l'unlock M8.",
          "goto": "commit_qualified"
        },
        {
          "id": "qualified_review",
          "text": "Rivedo la continuità prima di chiudere.",
          "goto": "continuity"
        }
      ]
    },
    "missed_route": {
      "stitches": [
        {
          "id": "s1",
          "text": "worlds_missed=true salta il torneo come partecipante e apre M12 — Dopo il Mondo. M8 non viene sbloccato."
        }
      ],
      "choices": [
        {
          "id": "missed_commit",
          "text": "Applico l'unlock M12.",
          "goto": "commit_missed"
        },
        {
          "id": "missed_review",
          "text": "Rivedo la continuità prima di chiudere.",
          "goto": "continuity"
        }
      ]
    },
    "continuity": {
      "stitches": [
        {
          "id": "s1",
          "text": "Roster, Pokémon, EXP, condizioni, inventario, denaro, relazioni, schedule, Rank e history non vengono resettati al confine M7."
        }
      ],
      "choices": [
        {
          "id": "continuity_route",
          "text": "Torno alla classificazione dell'uscita.",
          "goto": "unlock_guard"
        },
        {
          "id": "continuity_contract",
          "text": "Torno all'audit del contract.",
          "goto": "contract"
        }
      ]
    },
    "unlock_guard": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il router legge soltanto lo stato già risolto: qualificato verso M8, mancato Mondiale verso M12."
        }
      ],
      "choices": [
        {
          "id": "guard_qualified",
          "text": "La run è qualificata.",
          "goto": "qualified_route",
          "conditions": {
            "all": [
              {
                "path": "world.flags.world_qualified",
                "eq": true
              },
              {
                "path": "world.flags.worlds_missed",
                "ne": true
              }
            ]
          }
        },
        {
          "id": "guard_missed",
          "text": "La run ha mancato il Mondiale.",
          "goto": "missed_route",
          "conditions": {
            "all": [
              {
                "path": "world.flags.worlds_missed",
                "eq": true
              },
              {
                "path": "world.flags.world_qualified",
                "ne": true
              }
            ]
          }
        }
      ]
    },
    "commit_qualified": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il commit non modifica il risultato: registra M7 completo e rende M8 accessibile."
        }
      ],
      "choices": [
        {
          "id": "commit_q_now",
          "text": "Chiudo M7 sul ramo qualificato.",
          "goto": "complete",
          "effects": [
            {
              "type": "set_flag",
              "key": "m08_unlocked",
              "value": true
            },
            {
              "type": "set_flag",
              "key": "m7_complete",
              "value": true
            },
            {
              "type": "set_flag",
              "key": "m7_outcome",
              "value": "world_qualified"
            }
          ]
        },
        {
          "id": "commit_q_review",
          "text": "Rivedo il ramo prima di chiudere.",
          "goto": "qualified_route"
        }
      ]
    },
    "commit_missed": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il commit conserva la mancata qualificazione e rende accessibile il ramo WORLD_EXIT/M12."
        }
      ],
      "choices": [
        {
          "id": "commit_m_now",
          "text": "Chiudo M7 sul ramo Worlds Missed.",
          "goto": "complete",
          "effects": [
            {
              "type": "set_flag",
              "key": "m12_unlocked",
              "value": true
            },
            {
              "type": "set_flag",
              "key": "m7_complete",
              "value": true
            },
            {
              "type": "set_flag",
              "key": "m7_outcome",
              "value": "worlds_missed"
            }
          ]
        },
        {
          "id": "commit_m_review",
          "text": "Rivedo il ramo prima di chiudere.",
          "goto": "missed_route"
        }
      ]
    },
    "complete": {
      "stitches": [
        {
          "id": "s1",
          "text": "M7 — Sotto i Riflettori è formalmente completo. Il prossimo modulo è conseguenza diretta del risultato salvato."
        }
      ],
      "choices": [
        {
          "id": "complete_q",
          "text": "Resto a Meridiana con M8 sbloccato.",
          "goto": "m07-meridiana-arrival#city_hub",
          "conditions": {
            "path": "world.flags.m08_unlocked",
            "eq": true
          }
        },
        {
          "id": "complete_m",
          "text": "Resto a Meridiana con M12 sbloccato.",
          "goto": "m07-meridiana-arrival#city_hub",
          "conditions": {
            "path": "world.flags.m12_unlocked",
            "eq": true
          }
        }
      ]
    }
  }
}
