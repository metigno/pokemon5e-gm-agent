{
  "schemaVersion": 1,
  "id": "m07-module-outcome",
  "moduleId": "M07",
  "title": "M7_13 — Module Outcome",
  "locationId": "meridiana_city",
  "entryNodeId": "outcome_entry",
  "conditions": {
    "all": [
      {
        "path": "world.flags.m6_complete",
        "eq": true
      },
      {
        "path": "world.flags.m07_unlocked",
        "eq": true
      },
      {
        "path": "world.flags.m7_active",
        "eq": true
      },
      {
        "path": "competition.rank",
        "eq": "S"
      },
      {
        "path": "world.flags.cynthia_met",
        "eq": true
      },
      {
        "path": "world.flags.friend_beat_07_complete",
        "eq": true
      },
      {
        "path": "world.flags.m7_qualifier_result_resolved",
        "eq": true
      },
      {
        "any": [
          {
            "all": [
              {
                "path": "world.flags.world_qualified",
                "eq": true
              },
              {
                "path": "world.flags.m7_before_lights_complete",
                "eq": true
              }
            ]
          },
          {
            "all": [
              {
                "path": "world.flags.worlds_missed",
                "eq": true
              },
              {
                "path": "world.flags.m7_worlds_missed_resolved",
                "eq": true
              }
            ]
          }
        ]
      }
    ]
  },
  "nodes": {
    "outcome_entry": {
      "stitches": [
        {
          "id": "s1",
          "text": "Prima di lasciare Meridiana, riguardi gli incontri disputati e le persone che hai incontrato. Il prossimo viaggio dipende dal risultato ufficiale."
        }
      ],
      "choices": [
        {
          "id": "entry_contract",
          "text": "Eseguo l'audit dell'exit contract.",
          "goto": "contract"
        },
        {
          "id": "entry_continuity",
          "text": "Controllo cosa resta persistente.",
          "goto": "continuity"
        },
        {
          "id": "entry_complete",
          "text": "questa tappa è già chiuso: rivedo il punto di handoff.",
          "goto": "complete",
          "conditions": {
            "path": "world.flags.m7_complete",
            "eq": true
          }
        }
      ]
    },
    "contract": {
      "stitches": [
        {
          "id": "s1",
          "text": "Sul banco sono raccolti la conferma dell'incontro con Cynthia, le notizie degli amici e il registro delle gare concluse. L'addetto controlla che la pratica sia completa."
        }
      ],
      "choices": [
        {
          "id": "contract_cynthia",
          "text": "Controllo Cynthia.",
          "goto": "cynthia"
        },
        {
          "id": "contract_friend",
          "text": "Rileggo l'ultimo messaggio del mio amico.",
          "goto": "friend"
        },
        {
          "id": "contract_qualifier",
          "text": "Controllo la storia del Qualifier.",
          "goto": "qualifier"
        }
      ]
    },
    "cynthia": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il nome di Cynthia resta nei tuoi contatti. La sua carriera prosegue secondo il proprio calendario, indipendentemente dal tuo prossimo viaggio."
        }
      ],
      "choices": [
        {
          "id": "cynthia_contract",
          "text": "Torno all'audit.",
          "goto": "contract"
        },
        {
          "id": "cynthia_continuity",
          "text": "Rivedo la continuità dell'Anchor.",
          "goto": "continuity"
        }
      ]
    },
    "friend": {
      "stitches": [
        {
          "id": "s1",
          "text": "Sul telefono resta la conversazione con il tuo amico. Avete parlato davvero, anche se ora potreste prendere strade diverse."
        }
      ],
      "choices": [
        {
          "id": "friend_contract",
          "text": "Torno all'audit.",
          "goto": "contract"
        },
        {
          "id": "friend_continuity",
          "text": "Rivedo come il rapporto prosegue.",
          "goto": "continuity"
        }
      ]
    },
    "qualifier": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il registro conserva ogni incontro del Qualifier e, se disputato, dell'ultima occasione. I risultati sono già firmati."
        }
      ],
      "choices": [
        {
          "id": "qualifier_route",
          "text": "Classifico il ramo di uscita.",
          "goto": "unlock_guard"
        },
        {
          "id": "qualifier_contract",
          "text": "Torno all'audit.",
          "goto": "contract"
        }
      ]
    },
    "qualified_route": {
      "stitches": [
        {
          "id": "s1",
          "text": "La conferma del posto al Mondiale è pronta. L'addetto indica il banco degli accrediti internazionali e il programma della partenza."
        }
      ],
      "choices": [
        {
          "id": "qualified_commit",
          "text": "Confermo la partenza per il Mondiale.",
          "goto": "commit_qualified"
        },
        {
          "id": "qualified_review",
          "text": "Rivedo la continuità prima di chiudere.",
          "goto": "continuity"
        }
      ]
    },
    "missed_route": {
      "stitches": [
        {
          "id": "s1",
          "text": "L'elenco dei qualificati è definitivo e non comprende il tuo nome. L'addetto indica le destinazioni di ritorno e gli impegni ancora aperti."
        }
      ],
      "choices": [
        {
          "id": "missed_commit",
          "text": "Applico l'unlock M12.",
          "goto": "commit_missed"
        },
        {
          "id": "missed_review",
          "text": "Rivedo la continuità prima di chiudere.",
          "goto": "continuity"
        }
      ]
    },
    "continuity": {
      "stitches": [
        {
          "id": "s1",
          "text": "Controlli lo zaino e richiami la squadra. Nessun oggetto, ferita, esperienza o legame sparisce perché stai lasciando la città."
        }
      ],
      "choices": [
        {
          "id": "continuity_route",
          "text": "Torno alla classificazione dell'uscita.",
          "goto": "unlock_guard"
        },
        {
          "id": "continuity_contract",
          "text": "Torno all'audit del contract.",
          "goto": "contract"
        }
      ]
    },
    "unlock_guard": {
      "stitches": [
        {
          "id": "s1",
          "text": "L'addetto legge il risultato ufficiale e ti indirizza verso il banco appropriato. Non ti chiede di scegliere quale esito preferisci."
        }
      ],
      "choices": [
        {
          "id": "guard_qualified",
          "text": "La run è qualificata.",
          "goto": "qualified_route",
          "conditions": {
            "all": [
              {
                "path": "world.flags.world_qualified",
                "eq": true
              },
              {
                "path": "world.flags.worlds_missed",
                "ne": true
              }
            ]
          }
        },
        {
          "id": "guard_missed",
          "text": "La run ha mancato il Mondiale.",
          "goto": "missed_route",
          "conditions": {
            "all": [
              {
                "path": "world.flags.worlds_missed",
                "eq": true
              },
              {
                "path": "world.flags.world_qualified",
                "ne": true
              }
            ]
          }
        }
      ]
    },
    "commit_qualified": {
      "stitches": [
        {
          "id": "s1",
          "text": "L'ufficiale chiude la pratica di Meridiana e ti consegna le indicazioni per raggiungere la sede mondiale."
        }
      ],
      "choices": [
        {
          "id": "commit_q_now",
          "text": "Chiudo questa tappa sul ramo qualificato.",
          "goto": "complete",
          "effects": [
            {
              "type": "set_flag",
              "key": "m08_unlocked",
              "value": true
            },
            {
              "type": "set_flag",
              "key": "m7_complete",
              "value": true
            },
            {
              "type": "set_flag",
              "key": "m7_outcome",
              "value": "world_qualified"
            }
          ]
        },
        {
          "id": "commit_q_review",
          "text": "Rivedo il ramo prima di chiudere.",
          "goto": "qualified_route"
        }
      ]
    },
    "commit_missed": {
      "stitches": [
        {
          "id": "s1",
          "text": "L'ufficiale chiude la pratica di Meridiana. La tua carriera continua lungo le strade che restano aperte."
        }
      ],
      "choices": [
        {
          "id": "commit_m_now",
          "text": "Chiudo questa tappa sul ramo Worlds Missed.",
          "goto": "complete",
          "effects": [
            {
              "type": "set_flag",
              "key": "m12_unlocked",
              "value": true
            },
            {
              "type": "set_flag",
              "key": "m7_complete",
              "value": true
            },
            {
              "type": "set_flag",
              "key": "m7_outcome",
              "value": "worlds_missed"
            }
          ]
        },
        {
          "id": "commit_m_review",
          "text": "Rivedo il ramo prima di chiudere.",
          "goto": "missed_route"
        }
      ]
    },
    "complete": {
      "stitches": [
        {
          "id": "s1",
          "text": "Le porte del Grand Hall si richiudono alle tue spalle. Meridiana resta al lavoro, mentre tu riparti con il risultato che hai ottenuto."
        }
      ],
      "choices": [
        {
          "id": "complete_q",
          "text": "Parto per il Mondiale.",
          "goto": "m08-world-arrival#world_entry",
          "conditions": {
            "path": "world.flags.m08_unlocked",
            "eq": true
          }
        },
        {
          "id": "complete_m",
          "text": "Riprendo il viaggio dopo la mancata qualificazione.",
          "goto": "m12-world-exit-branch#world_exit_entry",
          "conditions": {
            "path": "world.flags.m12_unlocked",
            "eq": true
          }
        }
      ]
    }
  }
}
