{
  "schemaVersion": 1,
  "id": "m09-groups-open",
  "moduleId": "M09",
  "title": "M9_00 — Groups Open",
  "locationId": "world_village",
  "entryNodeId": "groups_entry",
  "conditions": {
    "all": [
      {
        "path": "world.flags.m8_complete",
        "eq": true
      },
      {
        "path": "world.flags.m09_unlocked",
        "eq": true
      },
      {
        "path": "world.flags.world_qualified",
        "eq": true
      },
      {
        "path": "competition.world.drawComplete",
        "eq": true
      },
      {
        "path": "competition.world.fieldLocked",
        "eq": true
      },
      {
        "path": "competition.world.playerOpponents.length",
        "eq": 3
      }
    ]
  },
  "nodes": {
    "groups_entry": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il Gruppo {{competition.world.playerGroup}} ha finalmente un calendario. Le prime partite si avvicinano e le sale del Village cominciano a svuotarsi per gli allenamenti."
        }
      ],
      "choices": [
        {
          "id": "entry_group",
          "text": "Rivedo i quattro partecipanti del gruppo.",
          "goto": "group_identity"
        },
        {
          "id": "entry_calendar",
          "text": "Controllo l'ordine delle tre giornate.",
          "goto": "calendar"
        },
        {
          "id": "entry_authority",
          "text": "Verifico chi possiede risultati e classifica.",
          "goto": "group_rules"
        }
      ]
    },
    "group_identity": {
      "stitches": [
        {
          "id": "s1",
          "text": "Sul tabellone leggi il tuo nome accanto a {{competition.world.playerOpponents.0.name}}, {{competition.world.playerOpponents.1.name}} e {{competition.world.playerOpponents.2.name}}."
        }
      ],
      "choices": [
        {
          "id": "group_first",
          "text": "Analizzo il primo avversario sorteggiato.",
          "goto": "opponent_one"
        },
        {
          "id": "group_second",
          "text": "Analizzo il secondo avversario sorteggiato.",
          "goto": "opponent_two"
        },
        {
          "id": "group_third",
          "text": "Analizzo il terzo avversario sorteggiato.",
          "goto": "opponent_three"
        }
      ]
    },
    "group_rules": {
      "stitches": [
        {
          "id": "s1",
          "text": "Un ufficiale spiega il girone: ogni allenatore affronterà gli altri tre; punti e risultati diretti determineranno il passaggio del turno."
        }
      ],
      "choices": [
        {
          "id": "rules_calendar",
          "text": "Passo al calendario ufficiale.",
          "goto": "calendar"
        },
        {
          "id": "rules_standings",
          "text": "Controllo come nasce la classifica.",
          "goto": "standings_zero"
        }
      ]
    },
    "calendar": {
      "stitches": [
        {
          "id": "s1",
          "text": "Le giornate sono fissate. Prima {{competition.world.playerOpponents.0.name}}, poi {{competition.world.playerOpponents.1.name}} e infine {{competition.world.playerOpponents.2.name}}."
        }
      ],
      "choices": [
        {
          "id": "calendar_first",
          "text": "Apro la scheda del Matchday 1.",
          "goto": "opponent_one"
        },
        {
          "id": "calendar_world",
          "text": "Controllo cosa succede fuori dal mio match.",
          "goto": "world_continues"
        }
      ]
    },
    "opponent_one": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il primo incontro sarà contro {{competition.world.playerOpponents.0.name}}. Non puoi conoscerne già l'esito."
        }
      ],
      "choices": [
        {
          "id": "one_second",
          "text": "Confronto il secondo avversario.",
          "goto": "opponent_two"
        },
        {
          "id": "one_commit",
          "text": "Preparo il lock operativo dei gruppi.",
          "goto": "open_commit"
        }
      ]
    },
    "opponent_two": {
      "stitches": [
        {
          "id": "s1",
          "text": "Alla seconda giornata affronterai {{competition.world.playerOpponents.1.name}}. Il risultato della prima resterà valido."
        }
      ],
      "choices": [
        {
          "id": "two_third",
          "text": "Passo al terzo avversario.",
          "goto": "opponent_three"
        },
        {
          "id": "two_calendar",
          "text": "Torno all'ordine delle giornate.",
          "goto": "calendar"
        }
      ]
    },
    "opponent_three": {
      "stitches": [
        {
          "id": "s1",
          "text": "La terza partita è prevista contro {{competition.world.playerOpponents.2.name}}. Allora saprai quanto hanno pesato i due giorni precedenti."
        }
      ],
      "choices": [
        {
          "id": "three_standings",
          "text": "Controllo la classifica iniziale.",
          "goto": "standings_zero"
        },
        {
          "id": "three_group",
          "text": "Torno alla composizione del gruppo.",
          "goto": "group_identity"
        }
      ]
    },
    "standings_zero": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il tabellone mostra tutti a zero punti. Le prime posizioni sono soltanto l'ordine di visualizzazione, non una classifica guadagnata."
        }
      ],
      "choices": [
        {
          "id": "standings_world",
          "text": "Guardo gli altri match che proseguiranno off-screen.",
          "goto": "world_continues"
        },
        {
          "id": "standings_commit",
          "text": "Passo al commit E5 di WORLD_GROUPS.",
          "goto": "open_commit"
        }
      ]
    },
    "world_continues": {
      "stitches": [
        {
          "id": "s1",
          "text": "Anche gli altri due allenatori del gruppo si preparano al proprio incontro. Quando scenderai in campo, loro non rimarranno fermi a guardarti."
        }
      ],
      "choices": [
        {
          "id": "world_rules",
          "text": "Rivedo l'autorità E5.",
          "goto": "group_rules"
        },
        {
          "id": "world_commit",
          "text": "Sono pronto ad aprire formalmente il girone.",
          "goto": "open_commit"
        }
      ]
    },
    "open_commit": {
      "stitches": [
        {
          "id": "s1",
          "text": "L'addetto pubblica orari e avversari. Nessuna partita è stata ancora disputata: sul tabellone restano caselle vuote."
        }
      ],
      "choices": [
        {
          "id": "open_now",
          "text": "Apro WORLD_GROUPS con il draw già lockato.",
          "goto": "groups_open",
          "conditions": {
            "path": "competition.world.groupStage.opened",
            "ne": true
          },
          "effects": [
            {
              "type": "set_flag",
              "key": "m9_active",
              "value": true
            },
            {
              "type": "competition_world_groups_open",
              "eventId": "WORLD_GROUPS"
            },
            {
              "type": "set_flag",
              "key": "m9_groups_open_complete",
              "value": true
            }
          ]
        },
        {
          "id": "open_existing",
          "text": "WORLD_GROUPS è già aperto: rileggo lo stato persistente.",
          "goto": "groups_open",
          "conditions": {
            "path": "competition.world.groupStage.opened",
            "eq": true
          }
        },
        {
          "id": "open_review",
          "text": "Prima rivedo il calendario.",
          "goto": "calendar"
        }
      ]
    },
    "groups_open": {
      "stitches": [
        {
          "id": "s1",
          "text": "L'apertura del girone è ufficiale. La prima giornata ti porterà contro {{competition.world.playerOpponents.0.name}}."
        }
      ],
      "choices": [
        {
          "id": "open_matchday",
          "text": "Vado alla preparazione del Matchday 1.",
          "goto": "m09-matchday-one#matchday_entry"
        },
        {
          "id": "open_table",
          "text": "Rileggo la situazione iniziale.",
          "goto": "standings_zero"
        }
      ]
    }
  }
}
