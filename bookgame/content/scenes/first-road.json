    "arrival": {
      "text": "La strada lascia Valedarsena e si stringe tra muretti bassi e ginestre. Poco avanti, un giovane Houndour sta bevendo da una pozzanghera ai margini del sentiero. Ha già percepito la tua presenza: non attacca, ma irrigidisce le zampe e ti segue con gli occhi.",
      "choices": [
        {
          "id": "observe",
          "text": "Resto a distanza e osservo il suo comportamento.",
          "goto": "observed"
        },
        {
          "id": "approach",
          "text": "Mi abbasso e provo ad avvicinarmi senza minacciarlo.",
          "check": {
            "ability": "WIS",
            "skill": "Animal Handling",
            "dc": 12
          },
          "outcomes": {
