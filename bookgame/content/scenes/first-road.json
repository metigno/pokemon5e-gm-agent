    "combat_handoff": {
      "text": "Il momento passa dalla scena narrativa al risolutore Pokémon 5e. Il Bookgame conserva il contesto, ma non decide danni, HP, condizioni o risultato del combattimento.",
      "choices": []
    },
    "combat_win": {
      "text": "Lo scontro si chiude a tuo favore. Houndour cerca una via di fuga invece di continuare a rischiare ferite inutili. Il sentiero torna silenzioso.",
      "choices": [
        {
          "id": "continue",
          "text": "Continuo verso l'interno.",
          "goto": "road_continue"
        }
      ]
    },
    "combat_loss": {
      "text": "Sei costretto a cedere terreno. Houndour non insegue oltre il necessario: mantiene la distanza che voleva e lascia che tu ti ritiri.",
      "choices": [
        {
          "id": "retreat",
          "text": "Mi allontano e riprendo fiato.",
          "goto": "road_continue"
        }
      ]
    },
    "houndour_fled": {
      "text": "Houndour trova un varco tra le ginestre e scompare sul pendio. Non hai vinto né perso: l'animale ha semplicemente scelto di uscire dalla situazione.",
      "choices": [
        {
          "id": "continue",
          "text": "Riprendo il cammino.",
          "goto": "road_continue"
        }
      ]
    },
    "road_continue": {
      "text": "Lasci alle spalle la pozzanghera e continui lungo il sentiero. Il vertical slice termina qui, ma lo stato della scena è già parte del salvataggio.",
