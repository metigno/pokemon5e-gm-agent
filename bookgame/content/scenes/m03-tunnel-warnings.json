{
  "schemaVersion": 1,
  "id": "m03-tunnel-warnings",
  "moduleId": "M03",
  "title": "M3_05 — Avvisi nelle Gallerie",
  "locationId": "ferrox_access",
  "entryNodeId": "warning_board",
  "conditions": {
    "all": [
      {
        "path": "world.flags.m2_complete",
        "eq": true
      },
      {
        "path": "world.flags.m03_unlocked",
        "eq": true
      },
      {
        "path": "world.flags.m3_active",
        "eq": true
      },
      {
        "path": "world.flags.ferravia_discovered",
        "eq": true
      },
      {
        "path": "competition.rank",
        "eq": "D"
      }
    ]
  },
  "nodes": {
    "warning_board": {
      "stitches": [
        {
          "id": "warning_board_1",
          "text": "L'accesso tecnico alle Gallerie Ferrox è separato dalla stazione passeggeri da una recinzione bassa e da un gabbiotto di controllo. Non c'è un allarme in corso: ci sono cartelli, registri e operai che entrano e escono seguendo turni normali."
        },
        {
          "id": "warning_board_2",
          "text": "Tre avvisi attirano l'attenzione: una revisione programmata delle paratie laterali, una nota sulla ventilazione del ramo vecchio e un richiamo a usare la cartografia aggiornata. Presi da soli sembrano normale manutenzione; date e luoghi diranno se hanno qualcosa in comune."
        }
      ],
      "choices": [
        {
          "id": "inspect_notice",
          "text": "Leggo con attenzione gli avvisi e le date di revisione. (CT Investigation)",
          "timeCostMinutes": 10,
          "check": {
            "ability": "INT",
            "skill": "Investigation",
            "dc": 12
          },
          "outcomes": {
            "success": {
              "goto": "notice_clear",
              "effects": [
                {
                  "type": "set_flag",
                  "key": "ferrox_warning_notice_specific",
                  "value": true
                }
              ]
            },
            "failure": {
              "goto": "notice_partial",
              "effects": [
                {
                  "type": "set_flag",
                  "key": "ferrox_warning_notice_partial",
                  "value": true
                }
              ]
            }
          }
        },
        {
          "id": "ask_worker",
          "text": "Chiedo a un addetto cosa è cambiato davvero nelle ultime settimane.",
          "timeCostMinutes": 10,
          "goto": "worker_gate"
        },
        {
          "id": "walk_permitted_route",
          "text": "Percorro il tratto visitabile e osservo supporti, rumori e flussi d'aria. (CT Perception)",
          "timeCostMinutes": 15,
          "check": {
            "ability": "WIS",
            "skill": "Perception",
            "dc": 12
          },
          "outcomes": {
            "success": {
              "goto": "structural_signal",
              "effects": [
                {
                  "type": "set_flag",
                  "key": "ferrox_warning_structural_signal",
                  "value": true
                }
              ]
            },
            "failure": {
              "goto": "route_unclear",
              "effects": [
                {
                  "type": "set_flag",
                  "key": "ferrox_warning_route_checked",
                  "value": true
                }
              ]
            }
          }
        },
        {
          "id": "compare_old_maps",
          "text": "Confronto gli avvisi con le vecchie mappe che ho studiato.",
          "timeCostMinutes": 10,
          "conditions": {
            "path": "world.flags.old_maps_read",
            "eq": true
          },
          "goto": "old_map_context",
          "effects": [
            {
              "type": "set_flag",
              "key": "ferrox_warning_old_map_linked",
              "value": true
            }
          ]
        },
        {
          "id": "compare_survey",
          "text": "Confronto gli avvisi con il rapporto di sopralluogo.",
          "timeCostMinutes": 10,
          "conditions": {
            "path": "world.flags.ferrox_survey_report_read",
            "eq": true
          },
          "goto": "survey_context",
          "effects": [
            {
              "type": "set_flag",
              "key": "ferrox_warning_survey_linked",
              "value": true
            }
          ]
        },
        {
          "id": "ask_steven",
          "text": "Chiedo a Steven se questi segnali cambiano la sua lettura tecnica.",
          "timeCostMinutes": 10,
          "conditions": {
            "all": [
              {
                "path": "world.flags.steven_met",
                "eq": true
              },
              {
                "path": "world.flags.ferrox_warning_steven_context",
                "ne": true
              }
            ]
          },
          "goto": "steven_context",
          "effects": [
            {
              "type": "set_flag",
              "key": "ferrox_warning_steven_context",
              "value": true
            }
          ]
        },
        {
          "id": "synthesize_now",
          "text": "Mi fermo e decido quanto peso dare ai segnali raccolti.",
          "goto": "warning_synthesis"
        }
      ]
    },
    "notice_clear": {
      "stitches": [
        {
          "id": "notice_clear_1",
          "text": "Le date non mostrano violazioni formali, ma due revisioni sono state rinviate entro i margini consentiti. Il ramo vecchio è ancora aperto per servizio tecnico e la nota sulla ventilazione è più recente della planimetria esposta."
        }
      ],
      "choices": [
        {
          "id": "notice_to_board",
          "text": "Torno agli altri segnali.",
          "goto": "warning_board"
        },
        {
          "id": "notice_to_synthesis",
          "text": "Tengo conto delle date e provo a tirare le somme.",
          "goto": "warning_synthesis"
        }
      ]
    },
    "notice_partial": {
      "stitches": [
        {
          "id": "notice_partial_1",
          "text": "Le sigle e le revisioni non bastano a distinguere una normale manutenzione da qualcosa di insolito. Puoi solo stabilire che i controlli esistono e vengono registrati."
        }
      ],
      "choices": [
        {
          "id": "partial_to_board",
          "text": "Cerco un'altra fonte.",
          "goto": "warning_board"
        },
        {
          "id": "partial_to_synthesis",
          "text": "Valuto comunque il poco che ho.",
          "goto": "warning_synthesis"
        }
      ]
    },
    "worker_gate": {
      "stitches": [
        {
          "id": "worker_gate_1",
          "text": "L'addetto ti squadra per un momento prima di rispondere. «I dettagli dei lavori restano alle squadre tecniche. Il ramo vecchio, però, lo usiamo ancora per la manutenzione. E quando aumenta la produzione, le finestre tra un intervento e l'altro diventano più strette.»"
        }
      ],
      "choices": [
        {
          "id": "worker_persuade",
          "text": "Gli chiedo un esempio concreto, senza chiedergli di violare procedure. (CT Persuasion)",
          "timeCostMinutes": 10,
          "check": {
            "ability": "CHA",
            "skill": "Persuasion",
            "dc": 12
          },
          "outcomes": {
            "success": {
              "goto": "worker_open",
              "effects": [
                {
                  "type": "set_flag",
                  "key": "ferrox_warning_worker_specific",
                  "value": true
                }
              ]
            },
            "failure": {
              "goto": "worker_guarded",
              "effects": [
                {
                  "type": "set_flag",
                  "key": "ferrox_warning_worker_guarded",
                  "value": true
                }
              ]
            }
          }
        },
        {
          "id": "worker_general",
          "text": "Mi basta sapere se il ritmo di lavoro è cambiato.",
          "goto": "worker_general",
          "effects": [
            {
              "type": "set_flag",
              "key": "ferrox_warning_worker_general",
              "value": true
            }
          ]
        },
        {
          "id": "worker_back",
          "text": "Non insisto e torno agli avvisi.",
          "goto": "warning_board"
        }
      ]
    },
    "worker_open": {
      "stitches": [
        {
          "id": "worker_open_1",
          "text": "«Due volte questo mese abbiamo trovato polvere fine dove prima non arrivava. Niente crolli, niente feriti. Abbiamo chiuso il tratto, controllato, riaperto. Il problema è che ogni controllo mangia ore e quelle ore poi mancano altrove.»"
        }
      ],
      "choices": [
        {
          "id": "worker_open_board",
          "text": "Lo ringrazio e confronto il dato con il resto.",
          "goto": "warning_board"
        },
        {
          "id": "worker_open_synthesis",
          "text": "Tengo a mente il cambiamento e provo a tirare le somme.",
          "goto": "warning_synthesis"
        }
      ]
    },
    "worker_guarded": {
      "stitches": [
        {
          "id": "worker_guarded_1",
          "text": "L'addetto scuote la testa, senza ostilità. «Più di questo non posso dirti. Se ci fosse un'emergenza, quel cancello sarebbe chiuso.» Poi torna al registro."
        }
      ],
      "choices": [
        {
          "id": "guarded_board",
          "text": "Cerco altre fonti.",
          "goto": "warning_board"
        },
        {
          "id": "guarded_synthesis",
          "text": "Valuto ciò che so senza riempire i vuoti.",
          "goto": "warning_synthesis"
        }
      ]
    },
    "worker_general": {
      "stitches": [
        {
          "id": "worker_general_1",
          "text": "«Più carichi, più passaggi. I turni non sono diventati più lunghi; dentro le stesse ore ci passa più roba.»"
        }
      ],
      "choices": [
        {
          "id": "general_board",
          "text": "Torno agli altri segnali.",
          "goto": "warning_board"
        },
        {
          "id": "general_synthesis",
          "text": "Aggiungo il dato alla valutazione.",
          "goto": "warning_synthesis"
        }
      ]
    },
    "structural_signal": {
      "stitches": [
        {
          "id": "structural_signal_1",
          "text": "Quando passa un convoglio, sotto le scarpe senti una vibrazione corta e regolare. Qualche secondo dopo una sottile linea di polvere cade da una giunzione alta e si disperde nel flusso d'aria. La struttura resta ferma, ma il dettaglio è reale."
        }
      ],
      "choices": [
        {
          "id": "structural_board",
          "text": "Torno al gabbiotto e confronto il segnale.",
          "goto": "warning_board"
        },
        {
          "id": "structural_synthesis",
          "text": "Tengo conto di ciò che ho visto e provo a tirare le somme.",
          "goto": "warning_synthesis"
        }
      ]
    },
    "route_unclear": {
      "stitches": [
        {
          "id": "route_unclear_1",
          "text": "Ventilatori, ruote, voci e metallo si sovrappongono. Provi a isolare un ritmo o una vibrazione, ma il rumore della galleria inghiotte ogni riferimento affidabile."
        }
      ],
      "choices": [
        {
          "id": "unclear_board",
          "text": "Cerco un'altra fonte.",
          "goto": "warning_board"
        },
        {
          "id": "unclear_synthesis",
          "text": "Valuto il quadro senza questo elemento.",
          "goto": "warning_synthesis"
        }
      ]
    },
    "old_map_context": {
      "stitches": [
        {
          "id": "old_map_context_1",
          "text": "Sulla vecchia planimetria il ramo indicato dagli avvisi passa accanto a una cavità che nelle carte moderne è ridotta a poche linee. Le due versioni non si contraddicono, ma quella vecchia mostra più terreno attorno alle paratie."
        }
      ],
      "choices": [
        {
          "id": "old_map_board",
          "text": "Torno agli altri segnali.",
          "goto": "warning_board"
        },
        {
          "id": "old_map_synthesis",
          "text": "Uso il confronto cartografico nella valutazione.",
          "goto": "warning_synthesis"
        }
      ]
    },
    "survey_context": {
      "stitches": [
        {
          "id": "survey_context_1",
          "text": "Nel rapporto che hai letto, le pareti leggere di separazione comparivano già tra gli elementi da controllare più spesso. Gli avvisi appesi oggi riguardano proprio quelle verifiche."
        }
      ],
      "choices": [
        {
          "id": "survey_board",
          "text": "Torno agli altri segnali.",
          "goto": "warning_board"
        },
        {
          "id": "survey_synthesis",
          "text": "Registro la continuità tra rapporto e avvisi.",
          "goto": "warning_synthesis"
        }
      ]
    },
    "steven_context": {
      "stitches": [
        {
          "id": "steven_context_1",
          "text": "Steven prende il foglio e confronta le date. «Un rinvio, da solo, non dice molto.» Tocca prima la planimetria, poi la nota sulla ventilazione. «Io guarderei dove si incontrano le cose: vecchie cavità, carichi più frequenti, segnali che ricompaiono nello stesso punto. È lì che una coincidenza smette di essere interessante e diventa qualcosa da controllare.»"
        }
      ],
      "choices": [
        {
          "id": "steven_board",
          "text": "Torno agli altri segnali.",
          "goto": "warning_board"
        },
        {
          "id": "steven_synthesis",
          "text": "Tengo conto della lettura di Steven insieme agli altri elementi.",
          "goto": "warning_synthesis"
        }
      ]
    },
    "warning_synthesis": {
      "stitches": [
        {
          "id": "warning_synthesis_1",
          "text": "Rimetti in ordine ciò che hai raccolto: date, testimonianze, mappe, rumori e polvere. Alcuni elementi possono sostenersi a vicenda; altri restano semplici possibilità. Devi decidere quanto seriamente prendere il quadro senza aggiungere ciò che non hai visto."
        }
      ],
      "choices": [
        {
          "id": "record_converging_warnings",
          "text": "Per me i segnali convergono: c'è un rischio tecnico concreto da non ignorare.",
          "conditions": {
            "any": [
              {
                "all": [
                  {
                    "path": "world.flags.ferrox_warning_structural_signal",
                    "eq": true
                  },
                  {
                    "any": [
                      {
                        "path": "world.flags.ferrox_warning_notice_specific",
                        "eq": true
                      },
                      {
                        "path": "world.flags.ferrox_warning_worker_specific",
                        "eq": true
                      },
                      {
                        "path": "world.flags.ferrox_warning_old_map_linked",
                        "eq": true
                      },
                      {
                        "path": "world.flags.ferrox_warning_survey_linked",
                        "eq": true
                      },
                      {
                        "path": "world.flags.ferrox_warning_steven_context",
                        "eq": true
                      }
                    ]
                  }
                ]
              },
              {
                "all": [
                  {
                    "path": "world.flags.ferrox_warning_notice_specific",
                    "eq": true
                  },
                  {
                    "path": "world.flags.ferrox_warning_worker_specific",
                    "eq": true
                  }
                ]
              }
            ]
          },
          "goto": "warning_close",
          "effects": [
            {
              "type": "set_flag",
              "key": "ferrox_warning_quality",
              "value": "strong"
            },
            {
              "type": "set_flag",
              "key": "tunnel_warnings_complete",
              "value": true
            }
          ]
        },
        {
          "id": "record_partial_warning",
          "text": "C'è abbastanza per restare vigile, ma non per parlare di emergenza.",
          "conditions": {
            "all": [
              {
                "any": [
                  {
                    "path": "world.flags.ferrox_warning_notice_specific",
                    "eq": true
                  },
                  {
                    "path": "world.flags.ferrox_warning_notice_partial",
                    "eq": true
                  },
                  {
                    "path": "world.flags.ferrox_warning_worker_specific",
                    "eq": true
                  },
                  {
                    "path": "world.flags.ferrox_warning_worker_general",
                    "eq": true
                  },
                  {
                    "path": "world.flags.ferrox_warning_structural_signal",
                    "eq": true
                  },
                  {
                    "path": "world.flags.ferrox_warning_old_map_linked",
                    "eq": true
                  },
                  {
                    "path": "world.flags.ferrox_warning_survey_linked",
                    "eq": true
                  },
                  {
                    "path": "world.flags.ferrox_warning_steven_context",
                    "eq": true
                  }
                ]
              },
              {
                "not": {
                  "any": [
                    {
                      "all": [
                        {
                          "path": "world.flags.ferrox_warning_structural_signal",
                          "eq": true
                        },
                        {
                          "any": [
                            {
                              "path": "world.flags.ferrox_warning_notice_specific",
                              "eq": true
                            },
                            {
                              "path": "world.flags.ferrox_warning_worker_specific",
                              "eq": true
                            },
                            {
                              "path": "world.flags.ferrox_warning_old_map_linked",
                              "eq": true
                            },
                            {
                              "path": "world.flags.ferrox_warning_survey_linked",
                              "eq": true
                            },
                            {
                              "path": "world.flags.ferrox_warning_steven_context",
                              "eq": true
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "all": [
                        {
                          "path": "world.flags.ferrox_warning_notice_specific",
                          "eq": true
                        },
                        {
                          "path": "world.flags.ferrox_warning_worker_specific",
                          "eq": true
                        }
                      ]
                    }
                  ]
                }
              }
            ]
          },
          "goto": "warning_close",
          "effects": [
            {
              "type": "set_flag",
              "key": "ferrox_warning_quality",
              "value": "partial"
            },
            {
              "type": "set_flag",
              "key": "tunnel_warnings_complete",
              "value": true
            }
          ]
        },
        {
          "id": "record_low_confidence",
          "text": "Non ho abbastanza elementi per sostenere che ci sia un problema.",
          "conditions": {
            "not": {
              "any": [
                {
                  "path": "world.flags.ferrox_warning_notice_specific",
                  "eq": true
                },
                {
                  "path": "world.flags.ferrox_warning_notice_partial",
                  "eq": true
                },
                {
                  "path": "world.flags.ferrox_warning_worker_specific",
                  "eq": true
                },
                {
                  "path": "world.flags.ferrox_warning_worker_general",
                  "eq": true
                },
                {
                  "path": "world.flags.ferrox_warning_structural_signal",
                  "eq": true
                },
                {
                  "path": "world.flags.ferrox_warning_old_map_linked",
                  "eq": true
                },
                {
                  "path": "world.flags.ferrox_warning_survey_linked",
                  "eq": true
                },
                {
                  "path": "world.flags.ferrox_warning_steven_context",
                  "eq": true
                }
              ]
            }
          },
          "goto": "warning_close",
          "effects": [
            {
              "type": "set_flag",
              "key": "ferrox_warning_quality",
              "value": "low"
            },
            {
              "type": "set_flag",
              "key": "tunnel_warnings_complete",
              "value": true
            }
          ]
        },
        {
          "id": "keep_investigating",
          "text": "Non chiudo ancora la valutazione; torno alle fonti.",
          "goto": "warning_board"
        }
      ]
    },
    "warning_close": {
      "stitches": [
        {
          "id": "warning_close_1",
          "text": "Lasci il gabbiotto con la tua valutazione e niente di più. Dietro la recinzione i turni continuano: cancelli che si aprono, convogli che passano, squadre che entrano nel ramo tecnico."
        }
      ],
      "choices": [
        {
          "id": "open_incident_alert",
          "text": "Un allarme arriva da Ferrox. Apro subito il dispaccio.",
          "conditions": {
            "path": "world.flags.a3_ferrox_incident_available",
            "eq": true
          },
          "goto": "m03-ferrox-incident#incident_alert",
          "effects": [
            {
              "type": "set_location",
              "locationId": "fer_city_dispatch"
            }
          ]
        },
        {
          "id": "back_to_ferravia",
          "text": "Torno a Ferravia e mantengo il quadro in mente.",
          "goto": "m03-ferravia-arrival#city_hub",
          "effects": [
            {
              "type": "set_location",
              "locationId": "fer_city"
            }
          ]
        }
      ]
    }
  }
}
