{
  "schemaVersion": 1,
  "id": "m08-accreditation",
  "moduleId": "M08",
  "title": "M8_01 — Accreditation",
  "locationId": "world_accreditation_center",
  "entryNodeId": "accreditation_entry",
  "conditions": {
    "all": [
      {
        "path": "world.flags.m7_complete",
        "eq": true
      },
      {
        "path": "world.flags.m08_unlocked",
        "eq": true
      },
      {
        "path": "world.flags.world_qualified",
        "eq": true
      },
      {
        "path": "world.flags.m7_before_lights_complete",
        "eq": true
      },
      {
        "path": "world.flags.m8_active",
        "eq": true
      },
      {
        "path": "world.flags.m8_world_arrived",
        "eq": true
      }
    ]
  },
  "nodes": {
    "accreditation_entry": {
      "stitches": [
        {
          "id": "s1",
          "text": "Nel centro accrediti una funzionaria verifica il documento di qualificazione e il tuo nome sul registro. Alle sue spalle si accumulano pass e mappe del complesso."
        }
      ],
      "choices": [
        {
          "id": "entry_start",
          "text": "Inizio l'accredito.",
          "goto": "accredit_hub",
          "conditions": {
            "path": "world.flags.m8_accreditation_complete",
            "ne": true
          }
        },
        {
          "id": "entry_review",
          "text": "L'accredito è già completo: rivedo credenziali e accessi.",
          "goto": "accredit_hub",
          "conditions": {
            "path": "world.flags.m8_accreditation_complete",
            "eq": true
          }
        },
        {
          "id": "entry_timeline",
          "text": "Controllo subito la timeline del torneo.",
          "goto": "timeline"
        }
      ]
    },
    "accredit_hub": {
      "stitches": [
        {
          "id": "s1",
          "text": "L'addetta controlla identità, aree autorizzate e calendario degli obblighi. Sono tre passaggi distinti da completare con calma."
        }
      ],
      "choices": [
        {
          "id": "hub_identity",
          "text": "Verifico l'identità competitiva.",
          "goto": "identity"
        },
        {
          "id": "hub_access",
          "text": "Controllo le zone accessibili.",
          "goto": "access"
        },
        {
          "id": "hub_timeline",
          "text": "Controllo la timeline.",
          "goto": "timeline"
        }
      ]
    },
    "identity": {
      "stitches": [
        {
          "id": "s1",
          "text": "Mostri il documento usato durante le qualificazioni. Il nome deve coincidere con quello che ha conquistato il posto."
        }
      ],
      "choices": [
        {
          "id": "identity_callbacks",
          "text": "Controllo i callback della carriera.",
          "goto": "callbacks"
        },
        {
          "id": "identity_hub",
          "text": "Torno al desk principale.",
          "goto": "accredit_hub"
        }
      ]
    },
    "access": {
      "stitches": [
        {
          "id": "s1",
          "text": "Sul pass compaiono simboli per Village, allenamento, clinica, stampa e campo gara. Ogni ingresso ha controlli propri."
        }
      ],
      "choices": [
        {
          "id": "access_zones",
          "text": "Esamino la mappa delle zone.",
          "goto": "zones"
        },
        {
          "id": "access_security",
          "text": "Rivedo il protocollo di sicurezza.",
          "goto": "security_protocol"
        }
      ]
    },
    "timeline": {
      "stitches": [
        {
          "id": "s1",
          "text": "La funzionaria indica gli appuntamenti nell'ordine previsto: salute della squadra, iscrizione, media, cerimonia e sorteggio."
        }
      ],
      "choices": [
        {
          "id": "timeline_medical",
          "text": "Controllo l'accesso medico.",
          "goto": "medical_access"
        },
        {
          "id": "timeline_training",
          "text": "Controllo l'accesso training.",
          "goto": "training_access"
        },
        {
          "id": "timeline_wait",
          "text": "Valuto cosa succede se rimando.",
          "goto": "wait_window"
        }
      ]
    },
    "zones": {
      "stitches": [
        {
          "id": "s1",
          "text": "Da una finestra vedi due corridoi vicini. Uno è riservato agli atleti, l'altro allo staff: il fatto che siano accanto non li rende intercambiabili."
        }
      ],
      "choices": [
        {
          "id": "zones_media",
          "text": "Controllo la zona media.",
          "goto": "media_rules"
        },
        {
          "id": "zones_hub",
          "text": "Torno al desk accrediti.",
          "goto": "accredit_hub"
        }
      ]
    },
    "media_rules": {
      "stitches": [
        {
          "id": "s1",
          "text": "«Le interviste sono facoltative nei limiti del programma», ricorda l'addetta. «Ma nessun giornalista può decidere i vostri avversari.»"
        }
      ],
      "choices": [
        {
          "id": "media_timeline",
          "text": "Torno alla timeline.",
          "goto": "timeline"
        },
        {
          "id": "media_zones",
          "text": "Torno alla mappa delle zone.",
          "goto": "zones"
        }
      ]
    },
    "training_access": {
      "stitches": [
        {
          "id": "s1",
          "text": "La sala allenamento avrà orari dedicati. Quando la userai, i Pokémon dovranno lavorare nelle condizioni in cui si trovano davvero."
        }
      ],
      "choices": [
        {
          "id": "training_timeline",
          "text": "Torno alla timeline.",
          "goto": "timeline"
        },
        {
          "id": "training_access_back",
          "text": "Torno alle regole di accesso.",
          "goto": "access"
        }
      ]
    },
    "medical_access": {
      "stitches": [
        {
          "id": "s1",
          "text": "La visita medica è una verifica obbligatoria. «Non la confonda con una cura», precisa la funzionaria."
        }
      ],
      "choices": [
        {
          "id": "medical_commit",
          "text": "Segno il controllo medico come prossimo gate.",
          "goto": "commit"
        },
        {
          "id": "medical_timeline",
          "text": "Torno alla timeline.",
          "goto": "timeline"
        }
      ]
    },
    "security_protocol": {
      "stitches": [
        {
          "id": "s1",
          "text": "Un addetto alla sicurezza indica sul pass gli accessi consentiti. Per entrare in un'area riservata occorre l'autorizzazione prevista."
        }
      ],
      "choices": [
        {
          "id": "security_access",
          "text": "Torno agli accessi.",
          "goto": "access"
        },
        {
          "id": "security_callbacks",
          "text": "Rivedo i callback di reputazione senza bypass.",
          "goto": "callbacks"
        }
      ]
    },
    "callbacks": {
      "stitches": [
        {
          "id": "s1",
          "text": "Qualche membro dello staff può riconoscere il tuo nome dai risultati precedenti. Le credenziali, però, sono le stesse previste dal regolamento."
        }
      ],
      "choices": [
        {
          "id": "callbacks_commit",
          "text": "Porto il contesto al commit di accredito.",
          "goto": "commit"
        },
        {
          "id": "callbacks_hub",
          "text": "Torno al desk.",
          "goto": "accredit_hub"
        }
      ]
    },
    "wait_window": {
      "stitches": [
        {
          "id": "s1",
          "text": "Aspetti un'ora in fila. Un altro gruppo passa al banco e alcune persone corrono verso il prossimo appuntamento."
        }
      ],
      "choices": [
        {
          "id": "wait_hour",
          "text": "Aspetto un'ora e torno alla timeline.",
          "goto": "timeline",
          "timeCostMinutes": 60
        },
        {
          "id": "wait_hub",
          "text": "Torno subito al desk.",
          "goto": "accredit_hub"
        }
      ]
    },
    "commit": {
      "stitches": [
        {
          "id": "s1",
          "text": "La funzionaria ricontrolla la tessera e la consegna. Gli accessi ora sono chiari, ma le gare non sono ancora state sorteggiate."
        }
      ],
      "choices": [
        {
          "id": "commit_now",
          "text": "Confermo le credenziali del partecipante.",
          "goto": "complete",
          "effects": [
            {
              "type": "set_flag",
              "key": "m8_accreditation_complete",
              "value": true
            },
            {
              "type": "set_flag",
              "key": "m8_access_timeline_known",
              "value": true
            },
            {
              "type": "set_location",
              "locationId": "world_accreditation_center"
            }
          ]
        },
        {
          "id": "commit_review",
          "text": "Rivedo ancora il desk.",
          "goto": "accredit_hub"
        }
      ]
    },
    "complete": {
      "stitches": [
        {
          "id": "s1",
          "text": "Hai il pass del complesso. Il prossimo controllo riguarda i Pokémon che porterai in gara."
        }
      ],
      "choices": [
        {
          "id": "complete_medical",
          "text": "Passo al controllo medico.",
          "goto": "m08-medical-control#medical_entry"
        },
        {
          "id": "complete_review",
          "text": "Resto al centro accrediti.",
          "goto": "accredit_hub"
        }
      ]
    }
  }
}
