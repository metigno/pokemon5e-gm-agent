  "nodes": {
    "hunt_entry": {
      "stitches": [
        {
          "id": "s1",
          "text": "Fra il primo e il secondo Matchday trovi soltanto gli indizi che hai davvero raccolto. Nessun Leggendario compare per il prestigio del Mondiale: ogni pista ha un luogo reale, un viaggio e un rischio. Le tue partite non attendono."
        }
      ],
      "choices": [
        {
          "id": "review_personal_lead",
          "text": "Controllo se la mia indagine ha una traccia concreta da seguire.",
          "goto": "hunt_leads",
          "timeCostMinutes": 10
        },
        {
          "id": "return_to_interday",
          "text": "Torno alla preparazione del Matchday 2.",
          "goto": "m09-interday-one#resource_guard"
        }
      ]
    },
    "hunt_leads": {
      "stitches": [
        {
          "id": "s1",
          "text": "Se la pista è completa e il tuo livello è sufficiente, puoi organizzare un viaggio e rischiare un incontro Pokémon 5e. Altrimenti le informazioni rimangono nel diario; nessun Leggendario viene assegnato."
        }
      ],
