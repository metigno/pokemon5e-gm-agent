    "luke_approach": {
      "stitches": [
        {
          "id": "s1",
          "text": "La pista conduce a un antico osservatorio oltre Meridiana. Kyurem e Zekrom hanno già scelto volontariamente l'Absofusione mediante un DNA Splicer custodito in loco. Non ne possiedi uno e il drago non ti deve nulla."
        }
      ],
      "choices": [
        {
          "id": "challenge_luke",
          "text": "Affronto black-kyurem con la squadra reale; la cattura non è garantita.",
