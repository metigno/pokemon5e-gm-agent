{
  "schemaVersion": 1,
  "id": "m11-final-prep",
  "moduleId": "M11",
  "title": "M11_06 — Final Prep",
  "locationId": "world_knockout_hall",
  "entryNodeId": "prep_entry",
  "conditions": {
    "all": [
      {
        "path": "world.flags.m11_friend_beat_11_complete",
        "eq": true
      },
      {
        "path": "competition.world.knockout.playerAdvancedToFinal",
        "eq": true
      },
      {
        "path": "competition.world.knockout.finalistsLocked",
        "eq": true
      },
      {
        "path": "competition.world.knockout.finalResolved",
        "ne": true
      },
      {
        "path": "competition.world.knockout.playerFinalMatchId",
        "exists": true
      }
    ]
  },
  "nodes": {
    "prep_entry": {
      "stitches": [
        {
          "id": "s1",
          "text": "Manca poco alla finale. Cerchi un angolo tranquillo per controllare i Pokémon e raccogliere gli appunti lasciati dalla semifinale."
        }
      ],
      "choices": [
        {
          "id": "prep_entry_next",
          "text": "Proseguo.",
          "goto": "resource_state"
        },
        {
          "id": "prep_entry_alt",
          "text": "Approfondisco.",
          "goto": "time_budget"
        },
        {
          "id": "prep_entry_detail_0",
          "text": "Esamino un'altra conseguenza.",
          "goto": "opponent_card"
        }
      ]
    },
    "resource_state": {
      "stitches": [
        {
          "id": "s1",
          "text": "Le risorse non si sono ricostituite durante la notte per un colpo di fortuna. Devi fare i conti con le condizioni reali di ogni compagno."
        }
      ],
      "choices": [
        {
          "id": "resource_state_next",
          "text": "Proseguo.",
          "goto": "time_budget"
        },
        {
          "id": "resource_state_alt",
          "text": "Approfondisco.",
          "goto": "opponent_card"
        },
        {
          "id": "resource_state_detail_1",
          "text": "Esamino un'altra conseguenza.",
          "goto": "tactical_plan"
        }
      ]
    },
    "time_budget": {
      "stitches": [
        {
          "id": "s1",
          "text": "Ogni pausa sottrae minuti alla preparazione. Fuori, staff e allenatori continuano a muoversi."
        }
      ],
      "choices": [
        {
          "id": "time_short",
          "text": "Dedico 15 minuti alla tattica.",
          "goto": "tactical_plan",
          "timeCostMinutes": 15
        },
        {
          "id": "time_long",
          "text": "Dedico 30 minuti al roster.",
          "goto": "roster_state",
          "timeCostMinutes": 30
        },
        {
          "id": "time_now",
          "text": "Entro senza altro tempo.",
          "goto": "risk"
        }
      ]
    },
    "opponent_card": {
      "stitches": [
        {
          "id": "s1",
          "text": "La scheda dell'altro finalista contiene soltanto informazioni rese pubbliche. Il suo nome non cambia quando torni a consultarla."
        }
      ],
      "choices": [
        {
          "id": "opponent_card_next",
          "text": "Proseguo.",
          "goto": "tactical_plan"
        },
        {
          "id": "opponent_card_alt",
          "text": "Approfondisco.",
          "goto": "roster_state"
        }
      ]
    },
    "tactical_plan": {
      "stitches": [
        {
          "id": "s1",
          "text": "Puoi rivedere abbinamenti e priorità, ma il piano migliore non aggiunge mosse che i tuoi Pokémon non conoscono."
        }
      ],
      "choices": [
        {
          "id": "tactical_plan_next",
          "text": "Proseguo.",
          "goto": "roster_state"
        },
        {
          "id": "tactical_plan_alt",
          "text": "Approfondisco.",
          "goto": "medical_policy"
        }
      ]
    },
    "roster_state": {
      "stitches": [
        {
          "id": "s1",
          "text": "Controlli che i sei scelti possano davvero scendere in campo. Non basta desiderare una squadra diversa per averla già preparata."
        }
      ],
      "choices": [
        {
          "id": "roster_state_next",
          "text": "Proseguo.",
          "goto": "medical_policy"
        },
        {
          "id": "roster_state_alt",
          "text": "Approfondisco.",
          "goto": "service_window"
        }
      ]
    },
    "medical_policy": {
      "stitches": [
        {
          "id": "s1",
          "text": "I servizi medici offrono soltanto gli interventi disponibili con i loro tempi e costi effettivi."
        }
      ],
      "choices": [
        {
          "id": "medical_policy_next",
          "text": "Proseguo.",
          "goto": "service_window"
        },
        {
          "id": "medical_policy_alt",
          "text": "Approfondisco.",
          "goto": "risk"
        }
      ]
    },
    "service_window": {
      "stitches": [
        {
          "id": "s1",
          "text": "L'orologio ricorda quanto manca al richiamo degli arbitri. Usare un servizio può essere utile, ma non ferma la giornata."
        }
      ],
      "choices": [
        {
          "id": "service_window_next",
          "text": "Proseguo.",
          "goto": "risk"
        },
        {
          "id": "service_window_alt",
          "text": "Approfondisco.",
          "goto": "save_state"
        }
      ]
    },
    "risk": {
      "stitches": [
        {
          "id": "s1",
          "text": "Puoi presentarti subito, accettando le condizioni in cui si trova la squadra. Nessun addetto deciderà al posto tuo."
        }
      ],
      "choices": [
        {
          "id": "risk_next",
          "text": "Proseguo.",
          "goto": "save_state"
        },
        {
          "id": "risk_alt",
          "text": "Approfondisco.",
          "goto": "readiness"
        }
      ]
    },
    "save_state": {
      "stitches": [
        {
          "id": "s1",
          "text": "Rileggi il programma: avversario e orario sono gli stessi. Le decisioni prese fin qui rimangono parte della tua preparazione."
        }
      ],
      "choices": [
        {
          "id": "save_state_next",
          "text": "Proseguo.",
          "goto": "readiness"
        },
        {
          "id": "save_state_alt",
          "text": "Approfondisco.",
          "goto": "handoff"
        }
      ]
    },
    "readiness": {
      "stitches": [
        {
          "id": "s1",
          "text": "L'arbitro attende la conferma dei finalisti. Il tuo nome è sulla lista della partita decisiva."
        }
      ],
      "choices": [
        {
          "id": "ready_commit",
          "text": "Confermo la readiness.",
          "goto": "handoff",
          "effects": [
            {
              "type": "set_flag",
              "key": "m11_final_prep_complete",
              "value": true
            }
          ]
        },
        {
          "id": "ready_review",
          "text": "Rivedo le risorse.",
          "goto": "resource_state"
        }
      ]
    },
    "handoff": {
      "stitches": [
        {
          "id": "s1",
          "text": "L'ingresso all'arena è illuminato. Oltre le porte ci sono un avversario e un titolo da conquistare, non una vittoria promessa."
        }
      ],
      "choices": [
        {
          "id": "handoff_final",
          "text": "Entro nella finale ufficiale.",
          "goto": "m11-world-final#final_entry"
        },
        {
          "id": "handoff_complete",
          "text": "Registro la preparazione.",
          "goto": "complete"
        }
      ]
    },
    "complete": {
      "stitches": [
        {
          "id": "s1",
          "text": "La preparazione è finita quando scegli di presentarti. Il resto lo diranno i tuoi Pokémon."
        }
      ],
      "choices": [
        {
          "id": "complete_next",
          "text": "Proseguo.",
          "goto": "prep_entry"
        },
        {
          "id": "complete_alt",
          "text": "Approfondisco.",
          "goto": "resource_state"
        }
      ]
    }
  }
}
