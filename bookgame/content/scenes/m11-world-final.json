{
  "schemaVersion": 1,
  "id": "m11-world-final",
  "moduleId": "M11",
  "title": "M11_07 — World Final",
  "locationId": "world_knockout_hall",
  "entryNodeId": "final_entry",
  "conditions": {
    "all": [
      {
        "path": "world.flags.m11_final_prep_complete",
        "eq": true
      },
      {
        "path": "competition.world.knockout.playerAdvancedToFinal",
        "eq": true
      },
      {
        "path": "competition.world.knockout.finalistsLocked",
        "eq": true
      },
      {
        "path": "competition.world.knockout.playerFinalMatchId",
        "exists": true
      }
    ]
  },
  "nodes": {
    "final_entry": {
      "stitches": [
        {
          "id": "s1",
          "text": "Le porte dell'arena si aprono sull'ultima sfida del Mondiale. Dall'altra parte attende chi ha vinto l'altra semifinale: nessun pronostico, a questo punto, vale più del cammino percorso fin qui."
        }
      ],
      "choices": [
        {
          "id": "final_entry_next",
          "text": "Proseguo.",
          "goto": "opponent_card"
        },
        {
          "id": "final_entry_alt",
          "text": "Approfondisco.",
          "goto": "rules"
        },
        {
          "id": "final_entry_detail_0",
          "text": "Esamino un'altra conseguenza.",
          "goto": "pressure"
        }
      ]
    },
    "opponent_card": {
      "stitches": [
        {
          "id": "s1",
          "text": "Sul grande schermo compare il nome dell'altro finalista, seguito dalle sue precedenti partite. Puoi studiare ciò che è stato reso pubblico; il resto dovrai scoprirlo sul campo."
        }
      ],
      "choices": [
        {
          "id": "opponent_card_next",
          "text": "Proseguo.",
          "goto": "rules"
        },
        {
          "id": "opponent_card_alt",
          "text": "Approfondisco.",
          "goto": "pressure"
        },
        {
          "id": "opponent_card_detail_1",
          "text": "Esamino un'altra conseguenza.",
          "goto": "history_before"
        }
      ]
    },
    "rules": {
      "stitches": [
        {
          "id": "s1",
          "text": "L'arbitro indica le postazioni. «Sei Pokémon registrati, incontro singolo. Vincitore e sconfitto saranno decisi qui, davanti a tutti.»"
        }
      ],
      "choices": [
        {
          "id": "rules_next",
          "text": "Proseguo.",
          "goto": "pressure"
        },
        {
          "id": "rules_alt",
          "text": "Approfondisco.",
          "goto": "history_before"
        },
        {
          "id": "rules_detail_2",
          "text": "Esamino un'altra conseguenza.",
          "goto": "resources_before"
        }
      ]
    },
    "pressure": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il brusio degli spalti si abbassa appena ti avvicini alla linea. I Pokémon avvertono la tensione dei loro allenatori, ma sul terreno valgono ancora gli stessi movimenti, le stesse scelte e gli stessi rischi."
        }
      ],
      "choices": [
        {
          "id": "pressure_next",
          "text": "Proseguo.",
          "goto": "history_before"
        },
        {
          "id": "pressure_alt",
          "text": "Approfondisco.",
          "goto": "resources_before"
        },
        {
          "id": "pressure_detail_3",
          "text": "Esamino un'altra conseguenza.",
          "goto": "readiness"
        }
      ]
    },
    "history_before": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il tabellone ripercorre il torneo appena trascorso. Nessuno di quei risultati scompare; questa è l'unica finale che giocherai oggi."
        }
      ],
      "choices": [
        {
          "id": "history_before_next",
          "text": "Proseguo.",
          "goto": "resources_before"
        },
        {
          "id": "history_before_alt",
          "text": "Approfondisco.",
          "goto": "readiness"
        }
      ]
    },
    "resources_before": {
      "stitches": [
        {
          "id": "s1",
          "text": "Davanti alla postazione controlli la squadra. Ci sono stanchezze, ferite e risorse consumate nelle sfide precedenti: i tuoi compagni arrivano fin qui con te, non riposati per magia."
        }
      ],
      "choices": [
        {
          "id": "resources_before_next",
          "text": "Proseguo.",
          "goto": "readiness"
        },
        {
          "id": "resources_before_alt",
          "text": "Approfondisco.",
          "goto": "match_handoff"
        }
      ]
    },
    "readiness": {
      "stitches": [
        {
          "id": "s1",
          "text": "L'addetto confronta i sei nominativi con il registro. Soltanto quando tutto è in ordine fa cenno all'arbitro di attendere la tua conferma."
        }
      ],
      "choices": [
        {
          "id": "readiness_next",
          "text": "Proseguo.",
          "goto": "match_handoff"
        },
        {
          "id": "readiness_alt",
          "text": "Approfondisco.",
          "goto": "win_return"
        }
      ]
    },
    "match_handoff": {
      "stitches": [
        {
          "id": "s1",
          "text": "L'arbitro solleva una mano. L'altro allenatore è già al suo posto: il prossimo suono sarà il segnale d'inizio."
        }
      ],
      "choices": [
        {
          "id": "fight_final",
          "text": "Combatto la finale del Mondiale.",
          "combat": {
            "encounterId": "WORLD_FINAL_PLAYER",
            "opponentRegistered": true,
            "competition": {
              "type": "official_match",
              "matchId": "WORLD_FINAL_PLAYER",
              "format": "Singles",
              "officialRosterSize": 6,
              "difficulty": "STORY_THREAT",
              "worldKnockoutRound": "FINAL"
            },
            "returnNodes": {
              "win": "win_return",
              "lose": "loss_return"
            },
            "goto": "match_handoff"
          },
          "conditions": {
            "path": "world.flags.world_final_resolved",
            "ne": true
          }
        },
        {
          "id": "handoff_readiness",
          "text": "Torno alla readiness.",
          "goto": "readiness"
        }
      ]
    },
    "win_return": {
      "stitches": [
        {
          "id": "s1",
          "text": "Al termine della partita l'arbitro conferma il verdetto. Se hai vinto, il tuo nome compare sotto la parola «Campione» e la coppa ti attende sul palco. Se non hai vinto, il titolo appartiene all'altro finalista. I Pokémon e il percorso che ti hanno portato fin qui restano reali in entrambi i casi."
        }
      ],
      "choices": [
        {
          "id": "win_record",
          "text": "Registro la vittoria mondiale.",
          "goto": "result_record",
          "effects": [
            {
              "type": "set_flag",
              "key": "m11_world_final_complete",
              "value": true
            }
          ]
        },
        {
          "id": "win_resources",
          "text": "Controllo la squadra.",
          "goto": "resources_after",
          "effects": [
            {
              "type": "set_flag",
              "key": "m11_world_final_complete",
              "value": true
            }
          ]
        }
      ]
    },
    "loss_return": {
      "stitches": [
        {
          "id": "s1",
          "text": "Se il verdetto è una sconfitta, l'arbitro assegna il titolo all'altro finalista e il suo nome attraversa gli altoparlanti. La tua presenza in finale rimane parte del torneo, senza diventare una vittoria mai ottenuta."
        }
      ],
      "choices": [
        {
          "id": "loss_record",
          "text": "Registro la sconfitta in finale.",
          "goto": "result_record",
          "effects": [
            {
              "type": "set_flag",
              "key": "m11_world_final_complete",
              "value": true
            }
          ]
        },
        {
          "id": "loss_resources",
          "text": "Controllo la squadra.",
          "goto": "resources_after",
          "effects": [
            {
              "type": "set_flag",
              "key": "m11_world_final_complete",
              "value": true
            }
          ]
        }
      ]
    },
    "result_record": {
      "stitches": [
        {
          "id": "s1",
          "text": "Un funzionario ti mostra il referto già firmato: avversario, risultato e piazzamento. Non chiede una seconda versione della partita."
        }
      ],
      "choices": [
        {
          "id": "result_record_next",
          "text": "Proseguo.",
          "goto": "champion_meaning"
        },
        {
          "id": "result_record_alt",
          "text": "Approfondisco.",
          "goto": "runnerup_meaning"
        }
      ]
    },
    "champion_meaning": {
      "stitches": [
        {
          "id": "s1",
          "text": "Per chi ha conquistato la coppa, il titolo non rende improvvisamente semplici le strade percorse e i rapporti costruiti. Il modo in cui gli altri accolgono la vittoria dipende da ciò che conoscono del campione."
        }
      ],
      "choices": [
        {
          "id": "champion_meaning_next",
          "text": "Proseguo.",
          "goto": "runnerup_meaning"
        },
        {
          "id": "champion_meaning_alt",
          "text": "Approfondisco.",
          "goto": "resources_after"
        }
      ]
    },
    "runnerup_meaning": {
      "stitches": [
        {
          "id": "s1",
          "text": "Per chi ha perso l'ultima partita, la medaglia del secondo posto conserva il peso di un percorso autentico. La finale non cambia risultato perché qualcuno avrebbe desiderato un finale diverso."
        }
      ],
      "choices": [
        {
          "id": "runnerup_meaning_next",
          "text": "Proseguo.",
          "goto": "resources_after"
        },
        {
          "id": "runnerup_meaning_alt",
          "text": "Approfondisco.",
          "goto": "history_after"
        }
      ]
    },
    "resources_after": {
      "stitches": [
        {
          "id": "s1",
          "text": "I tuoi Pokémon tornano accanto a te come sono usciti dal combattimento. Prima delle fotografie, delle domande e dei saluti, puoi guardarli uno per uno."
        }
      ],
      "choices": [
        {
          "id": "resources_after_next",
          "text": "Proseguo.",
          "goto": "history_after"
        },
        {
          "id": "resources_after_alt",
          "text": "Approfondisco.",
          "goto": "friend_context"
        }
      ]
    },
    "history_after": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il tabellone aggiorna l'albo d'oro e il referto finale. Le partite precedenti restano registrate, comprese quelle che avresti preferito giocare diversamente."
        }
      ],
      "choices": [
        {
          "id": "history_after_next",
          "text": "Proseguo.",
          "goto": "friend_context"
        },
        {
          "id": "history_after_alt",
          "text": "Approfondisco.",
          "goto": "rei_context"
        }
      ]
    },
    "friend_context": {
      "stitches": [
        {
          "id": "s1",
          "text": "Se dall'altra parte del campo c'era un amico, l'arbitro non cambia il verdetto per la vostra storia comune. Il modo in cui vi guarderete dopo, invece, appartiene soltanto a voi."
        }
      ],
      "choices": [
        {
          "id": "friend_context_next",
          "text": "Proseguo.",
          "goto": "rei_context"
        },
        {
          "id": "friend_context_alt",
          "text": "Approfondisco.",
          "goto": "single_elimination"
        }
      ]
    },
    "rei_context": {
      "stitches": [
        {
          "id": "s1",
          "text": "Fra i nomi del torneo c'è anche Rei. Il suo passato non decide chi alzerà questa coppa: contano gli incontri che ha davvero vinto, oppure perso, lungo il percorso."
        }
      ],
      "choices": [
        {
          "id": "rei_context_next",
          "text": "Proseguo.",
          "goto": "single_elimination"
        },
        {
          "id": "rei_context_alt",
          "text": "Approfondisco.",
          "goto": "official_record"
        }
      ]
    },
    "single_elimination": {
      "stitches": [
        {
          "id": "s1",
          "text": "Gli addetti cominciano a preparare la premiazione. Non c'è un secondo fischio d'inizio che permetta di cancellare la partita appena conclusa."
        }
      ],
      "choices": [
        {
          "id": "single_elimination_next",
          "text": "Proseguo.",
          "goto": "official_record"
        },
        {
          "id": "single_elimination_alt",
          "text": "Approfondisco.",
          "goto": "outcome_gate"
        }
      ]
    },
    "official_record": {
      "stitches": [
        {
          "id": "s1",
          "text": "Sul registro del torneo, il nome del campione coincide con quello del vincitore annunciato dall'arbitro. Non c'è spazio per un titolo assegnato per simpatia."
        }
      ],
      "choices": [
        {
          "id": "official_record_next",
          "text": "Proseguo.",
          "goto": "outcome_gate"
        },
        {
          "id": "official_record_alt",
          "text": "Approfondisco.",
          "goto": "handoff"
        }
      ]
    },
    "outcome_gate": {
      "stitches": [
        {
          "id": "s1",
          "text": "Il risultato è definitivo. Ora arrivano le reazioni, i saluti e le domande a cui nessuna strategia di gara sa rispondere."
        }
      ],
      "choices": [
        {
          "id": "outcome_gate_next",
          "text": "Proseguo.",
          "goto": "handoff"
        },
        {
          "id": "outcome_gate_alt",
          "text": "Approfondisco.",
          "goto": "complete"
        }
      ]
    },
    "handoff": {
      "stitches": [
        {
          "id": "s1",
          "text": "Lasci il terreno di gioco seguendo il percorso riservato ai finalisti. La serata proseguirà; la tua carriera non si esaurisce in questo corridoio."
        }
      ],
      "choices": [
        {
          "id": "handoff_outcome",
          "text": "Passo al Championship Outcome.",
          "goto": "m11-championship-outcome#outcome_entry"
        },
        {
          "id": "handoff_history",
          "text": "Rivedo il record.",
          "goto": "history_after"
        }
      ]
    },
    "complete": {
      "stitches": [
        {
          "id": "s1",
          "text": "Le porte dell'arena si richiudono alle tue spalle. La finale è finita, mentre il resto del mondo continua."
        }
      ],
      "choices": [
        {
          "id": "complete_next",
          "text": "Proseguo.",
          "goto": "final_entry"
        },
        {
          "id": "complete_alt",
          "text": "Approfondisco.",
          "goto": "opponent_card"
        }
      ]
    }
  }
}
