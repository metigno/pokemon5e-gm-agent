{
  "schemaVersion": 1,
  "id": "m03-regional-cup",
  "moduleId": "M03",
  "title": "M3_10 — Regional Cup",
  "locationId": "fer_city_arena",
  "entryNodeId": "cup_board",
  "conditions": {
    "all": [
      {
        "path": "world.flags.m2_complete",
        "eq": true
      },
      {
        "path": "world.flags.m03_unlocked",
        "eq": true
      },
      {
        "path": "world.flags.m3_active",
        "eq": true
      },
      {
        "path": "world.flags.a3_regional_cup_available",
        "eq": true
      },
      {
        "path": "world.flags.regional_cup_complete",
        "ne": true
      },
      {
        "path": "competition.rankOrder",
        "gte": 2
      }
    ]
  },
  "nodes": {
    "cup_board": {
      "stitches": [
        {
          "id": "cup_board_1",
          "text": "La Regional Cup di Ferravia occupa l'Officina Arena per una giornata. È un torneo opzionale: prestigio e risultati contano, ma non sostituiscono il Promotion Trial D→C."
        },
        {
          "id": "cup_board_2",
          "text": "Il tabellone è a eliminazione diretta. Ogni match è ufficiale e usa il roster reale; perdere chiude la tua corsa senza modificare il Rank."
        }
      ],
      "choices": [
        {
          "id": "cup_info",
          "text": "Leggo formato, orari e regole prima di decidere.",
          "goto": "cup_info"
        },
        {
          "id": "cup_register",
          "text": "Mi iscrivo alla Regional Cup.",
          "conditions": {
            "path": "world.flags.regional_cup_registered",
            "ne": true
          },
          "goto": "cup_registration",
          "effects": [
            {
              "type": "set_flag",
              "key": "regional_cup_registered",
              "value": true
            }
          ]
        },
        {
          "id": "cup_decline",
          "text": "Non partecipo alla Regional Cup.",
          "conditions": {
            "path": "world.flags.regional_cup_registered",
            "ne": true
          },
          "goto": "cup_declined"
        },
        {
          "id": "cup_resume",
          "text": "Sono già iscritto: torno al tabellone.",
          "conditions": {
            "path": "world.flags.regional_cup_registered",
            "eq": true
          },
          "goto": "quarterfinal_announce"
        },
        {
          "id": "cup_bracket",
          "text": "Studio il tabellone pubblico e la struttura del torneo.",
          "goto": "bracket_overview"
        }
      ]
    },
    "cup_info": {
      "stitches": [
        {
          "id": "cup_info_1",
          "text": "Formato Singles, tre Pokémon ufficiali per match. Quarti, semifinale e finale se continui a vincere. I Pokémon avversari sono registrati: non sono catturabili."
        },
        {
          "id": "cup_info_2",
          "text": "Il torneo registra ogni risultato nella storia competitiva. Non esiste un percorso narrativo che trasformi una sconfitta in vittoria."
        }
      ],
      "choices": [
        {
          "id": "register_after_info",
          "text": "Mi iscrivo sapendo cosa comporta.",
          "goto": "cup_registration",
          "effects": [
            {
              "type": "set_flag",
              "key": "regional_cup_registered",
              "value": true
            }
          ]
        },
        {
          "id": "decline_after_info",
          "text": "Non è la mia priorità.",
          "goto": "cup_declined"
        },
        {
          "id": "back_board",
          "text": "Torno al tabellone.",
          "goto": "cup_board"
        }
      ]
    },
    "cup_registration": {
      "stitches": [
        {
          "id": "cup_reg_1",
          "text": "L'addetto inserisce il tuo nome nel tabellone e controlla la squadra con cui ti presenti. Da questo momento sei ufficialmente iscritto alla Coppa Regionale."
        }
      ],
      "choices": [
        {
          "id": "check_roster",
          "text": "Controllo se ho almeno tre Pokémon disponibili nel roster.",
          "goto": "cup_roster_check"
        },
        {
          "id": "to_qf",
          "text": "Vado ai quarti di finale.",
          "conditions": {
            "path": "player.roster.length",
            "gte": 3
          },
          "goto": "quarterfinal_announce"
        },
        {
          "id": "withdraw_early",
          "text": "Ritiro l'iscrizione prima del primo match.",
          "goto": "cup_withdrawn",
          "effects": [
            {
              "type": "set_flag",
              "key": "regional_cup_withdrew",
              "value": true
            }
          ]
        }
      ]
    },
    "cup_roster_check": {
      "stitches": [
        {
          "id": "cup_roster_1",
          "text": "La Cup non crea Pokémon per renderti eleggibile. Servono almeno tre membri reali nel roster per iniziare un match ufficiale a tre."
        }
      ],
      "choices": [
        {
          "id": "roster_ok",
          "text": "Il roster è sufficiente: vado ai quarti.",
          "conditions": {
            "path": "player.roster.length",
            "gte": 3
          },
          "goto": "quarterfinal_announce"
        },
        {
          "id": "roster_short",
          "text": "Non ho ancora tre Pokémon: torno a prepararmi.",
          "conditions": {
            "path": "player.roster.length",
            "lt": 3
          },
          "goto": "cup_pause"
        },
        {
          "id": "roster_back",
          "text": "Torno alla registrazione.",
          "goto": "cup_registration"
        }
      ]
    },
    "cup_pause": {
      "stitches": [
        {
          "id": "cup_pause_1",
          "text": "La finestra della Cup resta una scelta del calendario. Non ricevi membri temporanei né bypass di roster."
        }
      ],
      "choices": [
        {
          "id": "pause_hub",
          "text": "Torno a Ferravia.",
          "goto": "m03-ferravia-arrival#city_hub",
          "effects": [
            {
              "type": "set_location",
              "locationId": "fer_city"
            }
          ]
        },
        {
          "id": "pause_withdraw",
          "text": "Ritiro formalmente l'iscrizione.",
          "goto": "cup_withdrawn",
          "effects": [
            {
              "type": "set_flag",
              "key": "regional_cup_withdrew",
              "value": true
            }
          ]
        }
      ]
    },
    "quarterfinal_announce": {
      "stitches": [
        {
          "id": "qf_1",
          "text": "Quarti di finale. L'avversaria registrata è Mira Doss, trainer regionale con un approccio ordinato alle resistenze. Il profilo pubblico non rivela mosse o HP nascosti."
        }
      ],
      "choices": [
        {
          "id": "qf_scout",
          "text": "Studio soltanto le informazioni pubbliche disponibili.",
          "goto": "quarterfinal_scout"
        },
        {
          "id": "qf_start",
          "text": "Entro nel match dei quarti.",
          "goto": "quarterfinal_handoff"
        },
        {
          "id": "qf_forfeit",
          "text": "Non mi presento: forfait e torneo finito.",
          "goto": "cup_forfeit"
        },
        {
          "id": "qf_plan_choice",
          "text": "Fisso una priorità tattica prima di entrare.",
          "goto": "qf_plan"
        }
      ]
    },
    "quarterfinal_scout": {
      "stitches": [
        {
          "id": "qf_scout_1",
          "text": "Il registro mostra risultati recenti e preferenza per cambi prudenti. È scouting pubblico, non conoscenza delle mosse correnti."
        }
