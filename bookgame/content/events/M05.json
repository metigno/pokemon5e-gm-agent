    {
      "id": "A5_RANK_TRIAL_B_A",
      "once": true,
      "trigger": {
        "all": [
          {
            "path": "competition.rank",
            "eq": "B"
          },
          {
            "any": [
              {
                "path": "player.trainerLevel",
                "gte": 11
              },
              {
                "path": "world.flags.rank_trial_B_A_available",
                "eq": true
              }
            ]
          }
        ]
      },
      "outcomes": [
        {
          "id": "trial_window",
          "effects": [
            {
              "type": "set_flag",
              "key": "a5_rank_trial_b_a_available",
              "value": true
            },
            {
              "type": "competition_trial_available",
              "checkpointId": "RANK_B_TO_A",
              "fromRank": "B",
              "toRank": "A",
              "requiredRosterSize": 5,
              "retryable": true
            }
          ]
        }
      ]
    },
