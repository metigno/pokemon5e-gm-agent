{
  "schemaVersion": 1,
  "moduleId": "M05",
  "events": [
    {
      "id": "A5_INTERREGIONAL",
      "once": true,
      "trigger": {
        "all": [
          {
            "path": "competition.rankOrder",
            "gte": 4
          },
          {
            "any": [
              {
                "path": "player.trainerLevel",
                "gte": 11
              },
              {
                "path": "world.flags.interregional_schedule_open",
                "eq": true
              }
            ]
          }
        ]
      },
      "outcomes": [
        {
          "id": "license_window",
          "effects": [
            {
              "type": "set_flag",
              "key": "a5_interregional_available",
              "value": true
            }
          ]
        }
      ]
    },
