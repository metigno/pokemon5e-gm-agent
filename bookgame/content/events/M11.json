{
  "schemaVersion": 1,
  "moduleId": "M11",
  "events": [
    {
      "id": "M11_REI_FINAL_FOUR_SCHEDULE",
      "once": true,
      "trigger": {
        "all": [
          {
            "path": "world.flags.m11_final_four_lock_complete",
            "eq": true
          },
          {
            "path": "competition.world.knockout.reiInTop4",
            "eq": true
          },
          {
            "path": "world.flags.m11_rei_available",
            "ne": true
          }
        ]
      },
      "outcomes": [
        {
          "id": "rei_final_four_venue",
