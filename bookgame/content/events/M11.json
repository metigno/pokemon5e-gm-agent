              "name": "Rei",
              "relationshipScore": 0,
              "state": {
                "role": "world_final_four_anchor",
                "introduced": false,
                "competitiveProtection": false,
                "module": "M11",
                "worldTop4": true
              }
            },
            {
              "type": "npc_schedule_set",
              "npcId": "Rei",
              "scheduleId": "m11_world_sf",
              "locationId": "world_knockout_hall",
              "availability": "available",
              "activity": "sf_preparation"
            },
            {
              "type": "set_flag",
              "key": "m11_rei_available",
              "value": true
            }
          ]
        }
      ]
    }
  ]
}
