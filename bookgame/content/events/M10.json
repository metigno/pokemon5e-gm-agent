              "relationshipScore": 0,
              "state": {
                "role": "world_r16_anchor",
                "introduced": false,
                "competitiveProtection": false,
                "module": "M10",
                "worldTop16": true
              }
            },
            {
              "type": "npc_schedule_set",
              "npcId": "SilasCrowe",
              "scheduleId": "m10_world_r16",
              "locationId": "world_knockout_hall",
