{
  "schemaVersion": 1,
  "moduleId": "M03",
  "events": [
    {
      "id": "M3_FERROX_INCIDENT",
      "once": true,
      "trigger": {
        "path": "world.flags.tunnel_warnings_complete",
        "eq": true
      },
      "outcomes": [
        {
          "id": "incident_opens",
          "effects": [
            {
              "type": "set_flag",
              "key": "a3_ferrox_incident_available",
              "value": true
            },
            {
              "type": "set_flag",
              "key": "ferrox_incident_started",
              "value": true
            },
            {
              "type": "quest_start",
              "questId": "M3_FERROX_RESCUE",
              "title": "Emergenza alle Gallerie Ferrox",
              "objective": "Raggiungi il perimetro Ferrox e contribuisci al soccorso prima che la finestra operativa si chiuda.",
              "deadlineMinutes": 240,
              "onDeadline": {
                "status": "failed",
                "resolution": "rescue_window_missed",
                "resolvedBy": "world"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "M3_FERROX_DEADLINE_OUTCOME",
      "once": true,
      "trigger": {
        "path": "quests.M3_FERROX_RESCUE.status",
        "eq": "failed"
      },
      "outcomes": [
        {
          "id": "player_declined",
          "when": {
            "path": "quests.M3_FERROX_RESCUE.resolution",
            "eq": "player_declined"
          },
          "effects": [
            {
              "type": "set_flag",
              "key": "ferrox_rescue_state",
              "value": "declined"
            },
            {
              "type": "set_flag",
              "key": "ferrox_rescue_outcome_available",
              "value": true
            }
          ]
        },
        {
          "id": "window_missed",
          "effects": [
            {
              "type": "set_flag",
              "key": "ferrox_rescue_state",
              "value": "missed"
            },
            {
              "type": "set_flag",
              "key": "ferrox_rescue_outcome_available",
              "value": true
            }
          ]
        }
      ]
    },
