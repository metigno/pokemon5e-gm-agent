{
  "schemaVersion": 1,
  "moduleId": "M04",
  "events": [
    {
      "id": "A4_LEAGUE_REG",
      "once": true,
      "trigger": {
        "any": [
          {
            "path": "competition.rankOrder",
            "gte": 3
          },
          {
            "path": "player.trainerLevel",
            "gte": 9
          }
        ]
      },
      "outcomes": [
        {
          "id": "registration_window",
          "effects": [
            {
              "type": "set_flag",
              "key": "a4_league_reg_available",
              "value": true
            }
          ]
        }
      ]
    },
    {
      "id": "A4_MAJOR_NAME",
      "once": true,
      "trigger": {
        "any": [
          {
            "path": "competition.rankOrder",
            "gte": 3
          },
          {
            "path": "player.trainerLevel",
            "gte": 9
          }
        ]
      },
      "outcomes": [
        {
          "id": "major_name_window",
          "effects": [
            {
              "type": "set_flag",
              "key": "a4_major_name_available",
              "value": true
            }
          ]
        }
      ]
    },
    {
      "id": "A4_RANK_TRIAL_C_B",
      "once": true,
      "trigger": {
        "all": [
          {
            "path": "competition.rank",
            "eq": "C"
          },
          {
            "any": [
              {
                "path": "player.trainerLevel",
                "gte": 9
              },
              {
                "path": "world.flags.rank_trial_C_B_available",
                "eq": true
              }
            ]
          }
        ]
      },
      "outcomes": [
        {
          "id": "trial_window",
          "effects": [
            {
              "type": "set_flag",
              "key": "a4_rank_trial_c_b_available",
              "value": true
            },
            {
              "type": "competition_trial_available",
              "checkpointId": "RANK_C_TO_B",
              "fromRank": "C",
              "toRank": "B",
              "requiredRosterSize": 4,
              "retryable": true
            }
          ]
        }
      ]
    },
    {
      "id": "A4_REGIONAL_LEAGUE",
      "once": true,
      "trigger": {
        "all": [
          {
            "path": "competition.rankOrder",
            "gte": 3
          },
          {
            "any": [
              {
                "path": "world.flags.upper_regional_registration_complete",
                "eq": true
              },
              {
                "path": "player.trainerLevel",
                "gte": 10
              }
            ]
          }
        ]
      },
      "outcomes": [
        {
          "id": "upper_regional_window",
          "effects": [
            {
              "type": "set_flag",
              "key": "a4_regional_league_available",
              "value": true
            }
          ]
        }
      ]
    },
    {
      "id": "A4_AFTER_LEAGUE",
      "once": true,
      "trigger": {
        "any": [
          {
            "path": "world.flags.upper_regional_result",
            "exists": true
          },
          {
            "path": "competition.rankOrder",
            "gte": 4
          }
        ]
      },
      "outcomes": [
        {
          "id": "after_league_window",
          "effects": [
            {
              "type": "set_flag",
              "key": "a4_after_league_available",
              "value": true
            }
          ]
        }
      ]
    },
    {
      "id": "M4_SMUGGLING_WINDOW",
      "once": true,
      "trigger": {
        "all": [
          {
            "path": "world.flags.port_pressure_complete",
            "eq": true
          },
          {
            "path": "world.flags.smuggling_state",
            "exists": false
          }
        ]
      },
      "outcomes": [
        {
          "id": "smuggling_window_opens",
          "effects": [
            {
              "type": "set_flag",
              "key": "smuggling_thread_available",
              "value": true
            },
            {
              "type": "quest_start",
              "questId": "M4_SMUGGLING_THREAD",
              "title": "Movimenti fuori registro",
              "objective": "Decidi se verificare, segnalare o ignorare le anomalie logistiche prima che la rete cambi rotta.",
              "deadlineMinutes": 1440,
              "onDeadline": {
                "status": "failed",
                "resolution": "network_shifted_without_player",
                "resolvedBy": "world"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "M4_SMUGGLING_DEADLINE_OUTCOME",
      "once": true,
      "trigger": {
        "path": "quests.M4_SMUGGLING_THREAD.status",
        "eq": "failed"
      },
      "outcomes": [
        {
          "id": "player_ignored",
          "when": {
            "path": "quests.M4_SMUGGLING_THREAD.resolution",
            "eq": "player_ignored"
          },
          "effects": [
            {
              "type": "set_flag",
              "key": "smuggling_state",
              "value": "ignored"
            },
            {
              "type": "set_flag",
              "key": "smuggling_thread_resolved",
              "value": true
            }
          ]
        },
        {
          "id": "network_shifted",
          "effects": [
            {
              "type": "set_flag",
              "key": "smuggling_state",
              "value": "resolved_without_player"
            },
            {
              "type": "set_flag",
              "key": "smuggling_thread_resolved",
              "value": true
            }
          ]
        }
      ]
    },
    {
