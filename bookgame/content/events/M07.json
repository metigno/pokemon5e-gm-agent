    {
      "id": "A7_LAST_CHANCE",
      "once": true,
      "trigger": {
        "all": [
          {
            "path": "world.flags.m7_qualifier_result_resolved",
            "eq": true
          },
          {
            "path": "world.flags.world_qualified",
            "ne": true
          },
          {
            "path": "world.flags.last_chance_eligible",
            "eq": true
          }
        ]
      },
      "outcomes": [
        {
          "id": "last_chance_window",
          "effects": [
            {
              "type": "set_flag",
              "key": "a7_last_chance_available",
              "value": true
            }
          ]
        }
      ]
    },
    {
      "id": "A7_BEFORE_LIGHTS",
      "once": true,
      "trigger": {
        "all": [
          {
            "path": "world.flags.world_qualified",
            "eq": true
          },
          {
            "any": [
              {
                "path": "player.trainerLevel",
                "gte": 18
              },
              {
                "path": "world.flags.worlds_departure_imminent",
                "eq": true
              }
            ]
          }
        ]
      },
      "outcomes": [
        {
          "id": "before_lights_window",
          "effects": [
            {
              "type": "set_flag",
              "key": "a7_before_lights_available",
              "value": true
            }
          ]
        }
      ]
