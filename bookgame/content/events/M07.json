{
  "schemaVersion": 1,
  "moduleId": "M07",
  "events": [
    {
      "id": "A7_WORLD_QUALIFIER",
      "once": false,
      "trigger": {
        "all": [
          {
            "path": "world.flags.m7_active",
            "eq": true
          },
          {
            "path": "competition.rank",
            "eq": "S"
          },
          {
            "path": "world.flags.m7_pro_preparation_complete",
            "eq": true
          },
          {
            "path": "world.flags.world_qualified",
            "ne": true
          },
          {
            "path": "world.flags.m7_qualifier_result_resolved",
            "ne": true
          }
        ]
      },
      "outcomes": [
        {
          "id": "qualifier_window_open",
          "effects": [
            {
              "type": "set_flag",
              "key": "a7_world_qualifier_available",
              "value": true
            }
          ]
        }
      ]
    },
