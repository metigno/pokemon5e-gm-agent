              {
                "path": "world.flags.friend_beat_06_friend_id",
                "ne": "Luke"
              },
              {
                "path": "npcs.Luke.schedule.present",
                "eq": true
              },
              {
                "any": [
                  {
                    "all": [
                      {
                        "path": "world.locationId",
                        "eq": "meridiana_city"
                      },
                      {
                        "path": "npcs.Luke.schedule.locationId",
                        "eq": "meridiana_city"
                      }
                    ]
