    {
      "id": "A6_HIDDEN_TRAJECTORIES",
      "once": true,
      "trigger": {
        "all": [
          {
            "path": "world.flags.m6_active",
            "eq": true
          },
          {
            "any": [
              {
                "path": "player.trainerLevel",
                "gte": 15
