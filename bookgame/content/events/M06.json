            "all": [
              {
                "path": "player.name",
                "ne": "Luke"
              },
              {
                "path": "world.flags.friend_beat_05_friend_id",
                "ne": "Luke"
              }
            ]
          },
          "effects": [
            {
              "type": "set_flag",
