    {
      "id": "M8_ASTRID_ARRIVAL",
      "once": true,
      "trigger": {
        "all": [
          {
            "path": "world.flags.m8_world_village_orientation_complete",
            "eq": true
          },
          {
            "path": "world.flags.m8_astrid_available",
            "ne": true
          }
        ]
      },
      "outcomes": [
        {
          "id": "astrid_world_village",
          "effects": [
            {
              "type": "npc_register",
              "npcId": "AstridVahl",
              "name": "Astrid Vahl",
              "relationshipScore": 0,
              "state": {
                "role": "reigning_world_champion_anchor",
                "introduced": false,
                "competitiveProtection": false,
                "module": "M08"
              }
            },
            {
              "type": "npc_schedule_set",
              "npcId": "AstridVahl",
              "scheduleId": "m8_world_village_anchor",
              "locationId": "world_village",
              "availability": "available",
              "activity": "world_preparation"
            },
            {
              "type": "set_flag",
              "key": "m8_astrid_available",
              "value": true
            }
          ]
        }
      ]
    },
