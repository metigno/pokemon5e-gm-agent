{
  "schemaVersion": 1,
  "moduleId": "M01",
  "events": [
    {
      "id": "A1_FIRST_ROAD",
      "once": true,
      "trigger": {
        "all": [
          {
            "path": "world.flags.free_roam",
            "eq": true
          },
          {
            "path": "world.locationId",
            "eq": "asteria_ginestre"
          }
        ]
      },
      "outcomes": [
        {
          "id": "road_open",
          "effects": [
            {
              "type": "set_flag",
              "key": "m1_first_road_seen",
              "value": true
            }
          ]
        }
      ]
    },
    {
      "id": "A1_WORLD_MOVES",
      "once": true,
      "trigger": {
        "all": [
          {
            "not": {
              "path": "world.flags.m1_world_pressure_state",
              "exists": true
            }
          },
          {
            "any": [
              {
                "path": "world.day",
                "gte": 3
              },
              {
                "path": "world.flags.first_settlement_reached",
                "eq": true
              }
            ]
          }
        ]
      },
      "outcomes": [
        {
          "id": "pressure_already_noticed",
          "when": {
            "path": "world.flags.m1_world_pressure_known",
            "eq": true
          },
          "effects": [
            {
              "type": "set_flag",
              "key": "m1_world_pressure_state",
              "value": "pressure_noticed"
            }
          ]
        },
        {
          "id": "pressure_unnoticed",
          "effects": [
            {
              "type": "set_flag",
              "key": "m1_world_pressure_state",
              "value": "pressure_unnoticed"
            }
          ]
        }
      ]
    },
    {
      "id": "A1_JOB_BOARD_LOGISTICS_REPOST",
      "once": true,
      "trigger": {
        "all": [
          {
            "path": "quests.M1_VALE_LOGISTICS_01.status",
            "eq": "expired"
          },
          {
            "path": "quests.M1_VALE_LOGISTICS_02.status",
            "exists": false
          }
        ]
      },
      "outcomes": [
        {
          "id": "reposted_shorter_route",
          "effects": [
            {
              "type": "quest_offer",
              "questId": "M1_VALE_LOGISTICS_02",
              "title": "Consegna ai magazzini — ripubblicata",
              "objective": "Porta il collo dal deposito intermedio ai magazzini fluviali.",
              "expiresInMinutes": 360,
              "onExpire": {
                "status": "expired",
                "resolution": "repost_expired",
                "resolvedBy": "world"
              }
            },
            {
              "type": "set_flag",
              "key": "m1_logistics_reposted",
              "value": true
            }
          ]
        }
      ]
    },
    {
      "id": "A1_WORLD_PRESSURE_NOTICE",
      "once": true,
      "trigger": {
        "all": [
          {
            "path": "world.flags.m1_world_pressure_known",
            "eq": true
          },
          {
            "path": "world.flags.m1_world_pressure_state",
            "eq": "pressure_unnoticed"
          }
        ]
      },
      "outcomes": [
        {
          "id": "noticed_from_evidence",
          "effects": [
            {
              "type": "set_flag",
              "key": "m1_world_pressure_state",
              "value": "pressure_noticed"
            }
          ]
        }
      ]
    },
    {
      "id": "A1_WORLD_PRESSURE_FARM_PARTIAL",
      "once": true,
      "trigger": {
        "all": [
          {
            "path": "world.flags.m1_farm_helped",
            "eq": true
          },
          {
            "path": "world.flags.m1_world_pressure_state",
            "in": [
              "pressure_noticed",
              "pressure_investigated"
            ]
          }
        ]
      },
      "outcomes": [
        {
          "id": "farm_local_mitigation",
          "effects": [
            {
              "type": "set_flag",
              "key": "m1_world_pressure_local_action",
              "value": true
            },
            {
              "type": "set_flag",
              "key": "m1_world_pressure_state",
              "value": "pressure_partially_resolved"
            }
          ]
        }
      ]
    },
    {
      "id": "A1_WORLD_PRESSURE_IGNORED",
      "once": true,
      "trigger": {
        "all": [
          {
            "path": "world.day",
            "gte": 5
          },
          {
            "path": "world.flags.m1_world_pressure_state",
            "in": [
              "pressure_unnoticed",
              "pressure_noticed",
              "pressure_investigated"
            ]
          },
          {
            "path": "world.flags.m1_world_pressure_local_action",
            "ne": true
          }
        ]
      },
      "outcomes": [
        {
          "id": "player_did_not_intervene",
          "effects": [
            {
              "type": "set_flag",
              "key": "m1_world_pressure_state",
              "value": "pressure_ignored"
            },
            {
              "type": "set_flag",
              "key": "m1_world_pressure_ignored",
              "value": true
            }
          ]
        }
      ]
    },
    {
      "id": "A1_WORLD_PRESSURE_OFFSCREEN",
      "once": true,
      "trigger": {
        "all": [
          {
            "path": "world.day",
            "gte": 7
          },
          {
            "path": "world.flags.m1_world_pressure_state",
            "eq": "pressure_ignored"
          }
        ]
      },
      "outcomes": [
        {
          "id": "rangers_and_workers_resolve_local_pressure",
          "effects": [
            {
              "type": "set_flag",
              "key": "m1_world_pressure_state",
              "value": "pressure_resolved_offscreen"
            },
            {
              "type": "set_flag",
              "key": "m1_world_pressure_offscreen_response",
              "value": true
            }
          ]
        }
      ]
    },
    {
      "id": "A1_BLUE_CIRCUIT_START",
      "once": true,
      "trigger": {
        "all": [
          {
            "path": "events.A1_WORLD_MOVES.status",
            "eq": "resolved"
          },
          {
            "path": "events.A1_BLUE_CIRCUIT_START.status",
            "exists": false
          }
        ]
      },
      "outcomes": [
        {
          "id": "arena_program",
          "effects": [
            {
              "type": "set_flag",
              "key": "m1_blue_circuit_started",
              "value": true
            },
            {
              "type": "set_flag",
              "key": "blue_current_schedule",
              "value": "arena"
            },
            {
              "type": "npc_state_set",
              "npcId": "Blue",
              "key": "currentSchedule",
              "value": "arena"
            },
            {
              "type": "npc_schedule_set",
              "npcId": "Blue",
              "scheduleId": "blue_m1_arena",
              "locationId": "valedarsena_arena",
              "availability": "available",
              "activity": "rookie_circuit_observation"
            }
          ]
        }
      ]
    },
    {
      "id": "A1_BLUE_CIRCUIT_DAY2",
      "once": true,
      "trigger": {
        "all": [
          {
            "path": "events.A1_BLUE_CIRCUIT_START.status",
            "eq": "resolved"
          },
          {
            "path": "world.day",
            "gte": 2
          }
        ]
      },
      "outcomes": [
        {
          "id": "center_program",
          "effects": [
            {
              "type": "set_flag",
              "key": "blue_current_schedule",
              "value": "center"
            },
            {
              "type": "npc_state_set",
              "npcId": "Blue",
              "key": "currentSchedule",
              "value": "center"
            },
            {
              "type": "npc_schedule_set",
              "npcId": "Blue",
              "scheduleId": "blue_m1_center",
              "locationId": "valedarsena_center",
              "availability": "available",
              "activity": "pokemon_recovery_and_planning"
            }
          ]
        }
      ]
    },
    {
      "id": "A1_BLUE_CIRCUIT_DAY3",
      "once": true,
      "trigger": {
        "all": [
          {
            "path": "events.A1_BLUE_CIRCUIT_DAY2.status",
            "eq": "resolved"
          },
          {
            "path": "world.day",
            "gte": 3
          }
        ]
      },
      "outcomes": [
        {
          "id": "field_program",
          "effects": [
            {
              "type": "set_flag",
              "key": "blue_current_schedule",
              "value": "field"
            },
            {
              "type": "npc_state_set",
              "npcId": "Blue",
              "key": "currentSchedule",
              "value": "field"
            },
            {
              "type": "npc_schedule_set",
              "npcId": "Blue",
              "scheduleId": "blue_m1_field",
              "locationId": "valedarsena_warehouses",
              "availability": "available",
              "activity": "rookie_field_job"
            }
          ]
        }
      ]
    },
    {
      "id": "A1_BLUE_CIRCUIT_DAY4",
      "once": true,
      "trigger": {
        "all": [
          {
            "path": "events.A1_BLUE_CIRCUIT_DAY3.status",
            "eq": "resolved"
          },
          {
            "path": "world.day",
            "gte": 4
          }
        ]
      },
      "outcomes": [
        {
          "id": "shop_program",
          "effects": [
            {
              "type": "set_flag",
              "key": "blue_current_schedule",
              "value": "trainer_shop"
            },
            {
              "type": "npc_state_set",
              "npcId": "Blue",
              "key": "currentSchedule",
              "value": "trainer_shop"
            },
            {
              "type": "npc_schedule_set",
              "npcId": "Blue",
              "scheduleId": "blue_m1_shop",
              "locationId": "valedarsena_trainer_shop",
              "availability": "available",
              "activity": "rookie_equipment_planning"
            }
          ]
        }
      ]
    }
  ]
}
