{
  "schemaVersion": 1,
  "moduleId": "M01",
  "events": [
    {
      "id": "A1_FIRST_ROAD",
      "once": true,
      "trigger": {
        "all": [
          {
            "path": "world.flags.free_roam",
            "eq": true
          },
          {
            "path": "world.locationId",
            "eq": "asteria_ginestre"
          }
        ]
      },
      "outcomes": [
        {
          "id": "road_open",
          "effects": [
            {
              "type": "set_flag",
              "key": "m1_first_road_seen",
              "value": true
            }
          ]
        }
      ]
    },
    {
      "id": "A1_WORLD_MOVES",
      "once": true,
      "trigger": {
        "any": [
          {
            "path": "world.day",
            "gte": 3
          },
          {
            "path": "world.flags.first_settlement_reached",
            "eq": true
          }
        ]
      },
      "outcomes": [
        {
          "id": "pressure_already_noticed",
          "when": {
            "path": "world.flags.m1_world_pressure_known",
            "eq": true
          },
          "effects": [
            {
              "type": "set_flag",
              "key": "m1_world_pressure_state",
              "value": "pressure_noticed"
            }
          ]
        },
        {
          "id": "pressure_unnoticed",
          "effects": [
            {
              "type": "set_flag",
              "key": "m1_world_pressure_state",
              "value": "pressure_unnoticed"
            }
          ]
        }
      ]
    },
    {
      "id": "A1_JOB_BOARD_LOGISTICS_REPOST",
      "once": true,
      "trigger": {
        "all": [
          {
            "path": "quests.M1_VALE_LOGISTICS_01.status",
            "eq": "expired"
          },
          {
            "path": "quests.M1_VALE_LOGISTICS_02.status",
            "exists": false
          }
        ]
      },
      "outcomes": [
        {
          "id": "reposted_shorter_route",
          "effects": [
            {
              "type": "quest_offer",
              "questId": "M1_VALE_LOGISTICS_02",
              "title": "Consegna ai magazzini — ripubblicata",
              "objective": "Porta il collo dal deposito intermedio ai magazzini fluviali.",
              "expiresInMinutes": 360,
              "onExpire": {
                "status": "expired",
                "resolution": "repost_expired",
                "resolvedBy": "world"
              }
            },
            {
              "type": "set_flag",
              "key": "m1_logistics_reposted",
              "value": true
            }
          ]
        }
      ]
    }
  ]
}
