  "global_rules": {
    "final_roster_is_future_target": true,
    "resolve_actual_pokemon5e_evolution_requirements": true,
    "no_free_evolution": true,
    "no_free_mega_gmax_alpha_legendary": true,
    "persist_first_instantiated_state": true,
    "never_delevel_on_reencounter": true,
    "veteran_low_level_encounter_modes": [
      "SOCIAL",
      "MENTOR",
      "REGULATED",
      "OVERMATCH"
    ],
    "early_career_mode": "Use the strongest legally reached pre-evolution/current form, not the mature 2060 form."
  },
  "explicit_examples": {
    "lucas": {
      "mature_target": "Torterra",
      "rule": "If encountered earlier in his career, walk backward through the real Torterra evolution line and use the legal current stage. Do not grant Torterra solely because it is his 2060 ace."
    },
    "campione_di_borrius": {
      "mature_target": "Shiny Mega Metagross",
      "rule": "An early-career version may use the same shiny individual earlier in the Beldum line when legal. Mega status is a separate late unlock."
    }
  },
